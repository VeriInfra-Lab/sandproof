[Unit]
Description=Reclaim explicitly retired disposable Sandproof CI artifacts
ConditionPathIsDirectory=/var/lib/sandproof-ci/retention

[Service]
Type=exec
WorkingDirectory=/opt/sandproof-ci/control
ExecStart=/usr/bin/python3 -m tools.ci_retention --root /var/lib/sandproof-ci/retention collect --apply
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=256M
MemorySwapMax=0
TasksMax=8
RuntimeMaxSec=300
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sandproof-ci/retention

