[Unit]
Description=Sandproof ordinary CI GitHub App runner replenishment
After=network-online.target sandproof-ci-proxy.service
Wants=network-online.target
Requires=sandproof-ci-proxy.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sandproof-ci/ci_runner_supervisor.py
LoadCredential=app-key:/etc/sandproof-ci/app-key.pem
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sandproof-ci
MemoryMax=256M
TasksMax=32
LogRateLimitIntervalSec=60
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
