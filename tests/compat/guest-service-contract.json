      "status": 200,
      "content_type": "application/connect+json",
      "end_stream": {
        "error": {
          "code": "resource_exhausted",
          "message": "command registration capacity exceeded"
        }
      },
      "scope": "Rust's explicit finite writer capacity; not an assertion that fixed Go refuses under the same load. Gated worker cleanup remains owned."
    }
