},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"sandproof_stage1_protocol_extract","contents":"#![forbid(unsafe_code)]\n\n//! Only transparent calls to actual production protocol methods.\nuse sandproof_protocol::internal::{InternalError, NodeIdentity};\nuse sandproof_protocol::lifecycle::{\n    CaptureBinding, CaptureId, ContentDigest, LifecycleRequest, ManifestError, SnapshotManifest,\n    ValidationError, VmCompatibility,\n};\n\npub fn request_validate(\n    request: &LifecycleRequest,\n    expected: &NodeIdentity,\n) -> Result<(), ValidationError> {\n    request.validate(expected)\n}\n\npub fn replay_matches(request: &LifecycleRequest, original: &LifecycleRequest) -> bool {\n    request.replay_matches(original)\n}\n\n/// The production deletion rule used by the original SQLite transaction.\npub fn renewal_rule(\n    request: &sandproof_protocol::lifecycle::AcceptedLifecycleIntent,\n    applied_end: Option<i64>,\n    previous_end: Option<i64>,\n    local_operation: Option<sandbox_controller_core::OperationId>,\n    checkpoint: &sandproof_protocol::lifecycle::RenewalConfirmation,\n    current_version: u64,\n    source_pinned: bool,\n) -> bool {\n    sandproof_controller_service::lifecycle_renewal::can_discard_confirmed_sdk(\n        request, applied_end, previous_end, local_operation, checkpoint, current_version, source_pinned,\n    )\n}\n\npub fn manifest_validate(\n    manifest: &SnapshotManifest,\n    expected: &CaptureBinding,\n    profile: &VmCompatibility,\n) -> Result<u64, ManifestError> {\n    manifest.validate(expected, profile)\n}\n\npub fn capture_from_u64(value: u64) -> Result<CaptureId, InternalError> {\n    CaptureId::try_from(value)\n}\n\npub fn capture_value(value: CaptureId) -> u64 {\n    value.get()\n}\n\npub fn capture_next(value: CaptureId) -> Result<CaptureId, InternalError> {\n    value.checked_next()\n}\n\npub fn digest_roundtrip(value: [u8; 32]) -> [u8; 32] {\n    ContentDigest::from_sha256(value).into_bytes()\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/home/zn/u333-5tuoxof8/std-mutex-source/sandbox-protocol/src/lifecycle/request.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":10,"name":{"Local":"/home/zn/u333-5tuoxof8/std-mutex-source/sandbox-protocol/src/lifecycle.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":11,"name":{"Local":"/home/zn/u333-5tuoxof8/std-mutex-source/sandbox-protocol/src/lib.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":12,"name":{"Local":"/home/zn/u333-5tuoxof8/std-mutex-source/sandbox-protocol/src/internal.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/home/zn/