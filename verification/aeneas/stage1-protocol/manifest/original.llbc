Id, InternalError> {\n    value.checked_next()\n}\n\npub fn digest_roundtrip(value: [u8; 32]) -> [u8; 32] {\n    ContentDigest::from_sha256(value).into_bytes()\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/home/zn/u333-5tuoxof8/std-mutex-source/sandbox-protocol/src/lifecycle/manifest.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":10,"name":{"Local":"/home/zn/u333-5tuoxof8/std-mutex-source/sandbox-protocol/src/lifecycle.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":11,"name":{"Local":"/home/zn/u333-5tuoxof8/std-mutex-source/sandbox-protocol/src/lib.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":16,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":17,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"a