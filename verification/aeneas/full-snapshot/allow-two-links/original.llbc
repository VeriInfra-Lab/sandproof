e":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"sandbox-runtime/src/lib.rs"},"crate_name":"sandbox_runtime","contents":"#![forbid(unsafe_code)]\n\n//! Host-only Firecracker/jailer operations. This crate does not publish a\n//! sandbox lifecycle state or grant a user permission to execute in the VM.\n\npub mod egress;\n\n#[cfg(target_os = \"linux\")]\nmod child_process;\n#[cfg(target_os = \"linux\")]\npub use child_process::{HelperLimits, OwnedChild};\n\n#[cfg(target_os = \"linux\")]\nmod uplink;\n\n#[cfg(target_os = \"linux\")]\npub use uplink::UplinkState;\n\n#[cfg(target_os = \"linux\")]\nmod linux;\n\n#[cfg(target_os = \"linux\")]\npub use linux::{\n    CLAIM_RECORD_NAMES, CapturedFullSnapshot, ConsolePolicy, FullCaptureLimits, HostResources,\n    JailObservation, MAX_CLAIM_RECORD_BYTES, MAX_HELPER_MARKER_BYTES, Observation,\n    PausedOriginalVm, PublishedFullCapture, RetirementManifest, Runtime, RuntimeConfig,\n    RuntimeError, RuntimeHelperGate, RuntimeHelperGuard, RuntimeHostSlot, RuntimeObservationConfig,\n    RuntimePhysicalObserver, RuntimeProcessIdentity, RuntimeRouteSnapshot, RuntimeRouteState,\n    SnapshotLayout, VmState, check_trusted_path, check_trusted_path_for_owner,\n};\n\n#[cfg(target_os = \"linux\")]\npub mod snapshot_store;\n\n#[cfg(target_os = \"linux\")]\nmod snapshot_policy;\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"sandbox-runtime/src/snapshot_policy.rs"},"crate_name":"sandbox_runtime","contents":"//! Pure acceptance guard used by the real original-FD copy path.\n//! Fields are one Metadata observation of the same already-open descriptor;\n//! this guard does not acquire a descriptor or establish writer exclusion.\n\n#[derive(Clone, Copy, Debug)]\npub(crate) struct SnapshotFileFacts {\n    pub owner: u32,\n    pub mode: u32,\n    pub regular: bool,\n    pub links: u64,\n    pub length: u64,\n}\n\npub(crate) fn accepts(facts: SnapshotFileFacts, expected_owner: u32, max_length: u64) -> bool {\n    // Keep the exact Unix group/other mask visible to review and extraction.\n    let group_other_permissions = facts.mode & 0o077;\n    facts.regular\n        && facts.owner == expected_owner\n        && group_other_permissions == 0\n        && facts.links <= 2\n        && facts.length > 0\n        && facts.length <= max_length\n}\n"},{"id":6,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constra