{"charon_version":"0.1.254","translated":{"crate_name":"sandbox_runtime","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::child_process::_::stop_and_reap"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["sandbox_runtime"],"opaque":["std::io","alloc::io","std::process","std::time","std::thread","crate::child_process::reaper","crate::child_process::observation_io"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/zn/actual-caller-no-expect/original.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":true,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"sandbox-runtime/src/lib.rs"},"crate_name":"sandbox_runtime","contents":"#![forbid(unsafe_code)]\n\n//! Host-only Firecracker/jailer operations. This crate does not publish a\n//! sandbox lifecycle state or grant a user permission to execute in the VM.\n\npub mod egress;\n\n#[cfg(target_os = \"linux\")]\nmod child_process;\n#[cfg(target_os = \"linux\")]\npub use child_process::{HelperLimits, OwnedChild};\n\n#[cfg(target_os = \"linux\")]\nmod uplink;\n\n#[cfg(target_os = \"linux\")]\npub use uplink::UplinkState;\n\n#[cfg(target_os = \"linux\")]\nmod linux;\n\n#[cfg(target_os = \"linux\")]\npub use linux::{\n    CLAIM_RECORD_NAMES, ConsolePolicy, HostResources, JailObservation, MAX_CLAIM_RECORD_BYTES,\n    MAX_HELPER_MARKER_BYTES, Observation, RetirementManifest, Runtime, RuntimeConfig, RuntimeError,\n    RuntimeHelperGate, RuntimeHelperGuard, RuntimeHostSlot, RuntimeObservationConfig,\n    RuntimePhysicalObserver, RuntimeProcessIdentity, RuntimeRouteSnapshot, RuntimeRouteState,\n    VmState, check_trusted_path, check_trusted_path_for_owner,\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"sandbox-runtime/src/child_process.rs"},"crate_name":"sandbox_runtime","contents":"//! Bounded host-helper exchange; guest commands use a separate streaming path.\nuse rustix::{\n    event::{PollFd, PollFlags, Timespec, poll},\n    fs::{OFlags, fcntl_getfl, fcntl_setfl},\n};\nuse std::{\n    io::{self, Read, Write},\n    ops::{Deref, DerefMut},\n    os::fd::AsFd,\n    process::{Child, Command, Output},\n    time::{Duration, Instant},\n};\n\nmod reaper;\nmod observation_core;\nmod observation_io;\nuse reaper::Slot;\n\n/// Trusted operation policy, not a client-selected guest command budget.\n#[derive(Clone, Copy, Debug)]\npub struct HelperLimits {\n    pub timeout: Duration,\n    pub input_bytes: usize,\n    pub stdout_bytes: usize,\n    pub stderr_bytes: usize,\n}\nimpl HelperLimits {\n    /// Network configuration/observation and bounded envd control requests.\n    pub const CONTROL: Self = Self {\n        timeout: Duration::from_secs(10),\n        input_bytes: 1024 * 1024,\n        stdout_bytes: 2 * 1024 * 1024,\n        stderr_bytes: 16 * 1024,\n    };\n    /// Small fixed-format metadata such as a token digest.\n    pub const METADATA: Self = Self {\n        timeout: Duration::from_secs(3),\n        input_bytes: 64 * 1024,\n        stdout_bytes: 1024,\n        stderr_bytes: 4096,\n    };\n}\nconst REAP_GRACE: Duration = Duration::from_secs(2);\nconst POLL_SLICE: Duration = Duration::from_millis(10);\nconst CHUNK_BYTES: usize = 8192;\n\n/// Exact unreaped child plus a pre-spawn admission slot. Unknown exits move to\n/// one fixed reaper and keep their slot; Drop never performs an unbounded wait.\n/// Persisted async relays retain their separate ownership protocol.\npub struct OwnedChild {\n    child: Option<Child>,\n    slot: Option<Slot>,\n}\nimpl OwnedChild {\n    /// Admit before spawning; a full helper budget cannot launch a child.\n    /// # Errors\n    /// Returns admission, reaper-start or process-launch failures.\n    pub fn spawn(command: &mut Command) -> io::Result<Self> {\n        let slot = Slot::acquire()?;\n        Ok(Self {\n            child: Some(command.spawn()?),\n            slot: Some(slot),\n        })\n    }\n    #[cfg(test)]\n    pub(crate) fn new(child: Child) -> Self {\n        Self {\n            child: Some(child),\n            slot: Some(Slot::acquire().unwrap()),\n        }\n    }\n    /// Transfer stop/reap responsibility to a separately bounded lifetime owner.\n    /// # Panics\n    /// Panics if this child has already been handed to the unknown-exit reaper.\n    #[must_use]\n    pub fn into_child(mut self) -> Child {\n        self.child.take().expect(\"owned child\")\n    }\n\n    fn stop_and_reap(&mut self) -> io::Result<std::process::ExitStatus> {\n        let mut io = observation_io::system();\n        observation_core::stop(&mut self.child, &mut self.slot, &mut io)\n    }\n    /// Simultaneously write finite input and drain both outputs. The deadline\n    /// includes blocked input, output EOF and process-exit observation.\n    /// # Errors\n    /// Budget, protocol, pipe and exit failures are never successful truncation.\n    pub fn exchange(&mut self, input: &[u8], limits: HelperLimits) -> io::Result<Output> {\n        self.exchange_until(input, limits, |_| false)\n    }\n    /// Observe a bounded protocol prefix, then stop/reap only the host helper.\n    /// Used for detached envd Start: it must not terminate the guest command.\n    /// Returned status can be signalled; the caller validates the actual frame.\n    /// # Errors\n    /// As for exchange; unconfirmed helper exit never returns a valid prefix.\n    pub fn exchange_until(\n        &mut self,\n        input: &[u8],\n        limits: HelperLimits,\n        complete: impl Fn(&[u8]) -> bool,\n    ) -> io::Result<Output> {\n        let result = self.pump(input, limits, complete);\n        if result.is_err() && self.child.is_some() {\n            let _ = self.stop_and_reap();\n        }\n        result\n    }\n    /// Drain a host helper using the standard control-operation policy.\n    /// # Errors\n    /// Returns bounded exchange errors after bounded stop/reap handling.\n    pub fn wait_output(&mut self) -> io::Result<Output> {\n        self.exchange(&[], HelperLimits::CONTROL)\n    }\n\n    fn pump(\n        &mut self,\n        input: &[u8],\n        limits: HelperLimits,\n        complete: impl Fn(&[u8]) -> bool,\n    ) -> io::Result<Output> {\n        let deadline = Instant::now()\n            .checked_add(limits.timeout)\n            .filter(|_| !limits.timeout.is_zero())\n            .ok_or_else(|| {\n                io::Error::new(io::ErrorKind::InvalidInput, \"invalid helper deadline\")\n            })?;\n        if input.len() > limits.input_bytes {\n            return Err(io::Error::new(\n                io::ErrorKind::InvalidInput,\n                \"host helper input exceeds budget\",\n            ));\n        }\n        let mut stdin = self.stdin.take();\n        let mut stdout = self.stdout.take();\n        let mut stderr = self.stderr.take();\n        if !input.is_empty() && stdin.is_none() {\n            return Err(io::Error::new(\n                io::ErrorKind::BrokenPipe,\n                \"host helper stdin unavailable\",\n            ));\n        }\n        if let Some(pipe) = &stdin {\n            nonblocking(pipe)?;\n        }\n        if let Some(pipe) = &stdout {\n            nonblocking(pipe)?;\n        }\n        if let Some(pipe) = &stderr {\n            nonblocking(pipe)?;\n        }\n        let mut written: usize = 0;\n        let mut out = Vec::new();\n        let mut err = Vec::new();\n        loop {\n            if Instant::now() >= deadline {\n                return Err(io::Error::new(\n                    io::ErrorKind::TimedOut,\n                    \"host helper exchange timed out\",\n                ));\n            }\n            if written == input.len() {\n                stdin.take();\n            }\n            wait_readiness(stdin.as_ref(), stdout.as_ref(), stderr.as_ref(), deadline)?;\n            if let Some(pipe) = &mut stdin {\n                let end = input.len().min(written.saturating_add(CHUNK_BYTES));\n                match pipe.write(&input[written..end]) {\n                    Ok(0) => return Err(io::ErrorKind::WriteZero.into()),\n                    Ok(n) => written += n,\n                    Err(error)\n                        if matches!(\n                            error.kind(),\n                            io::ErrorKind::WouldBlock | io::ErrorKind::Interrupted\n                        ) => {}\n                    Err(error) => return Err(error),\n                }\n            }\n            drain_chunk(&mut stdout, &mut out, limits.stdout_bytes)?;\n            drain_chunk(&mut stderr, &mut err, limits.stderr_bytes)?;\n            if written == input.len() && complete(&out) {\n                let status = self.stop_and_reap()?;\n                return Ok(Output {\n                    status,\n                    stdout: out,\n                    stderr: err,\n                });\n            }\n            if let Some(status) = self.try_wait()?\n                && stdout.is_none()\n                && stderr.is_none()\n            {\n                if written != input.len() {\n                    return Err(io::Error::new(\n                        io::ErrorKind::BrokenPipe,\n                        \"helper exited before accepting input\",\n                    ));\n                }\n                return Ok(Output {\n                    status,\n                    stdout: out,\n                    stderr: err,\n                });\n            }\n        }\n    }\n}\nfn wait_readiness(\n    stdin: Option<&impl AsFd>,\n    stdout: Option<&impl AsFd>,\n    stderr: Option<&impl AsFd>,\n    deadline: Instant,\n) -> io::Result<()> {\n    let mut fds = Vec::with_capacity(3);\n    if let Some(pipe) = stdin {\n        fds.push(PollFd::new(pipe, PollFlags::OUT));\n    }\n    if let Some(pipe) = stdout {\n        fds.push(PollFd::new(pipe, PollFlags::IN));\n    }\n    if let Some(pipe) = stderr {\n        fds.push(PollFd::new(pipe, PollFlags::IN));\n    }\n    let slice = deadline\n        .saturating_duration_since(Instant::now())\n        .min(POLL_SLICE);\n    let timeout = Timespec {\n        tv_sec: 0,\n        tv_nsec: i64::try_from(slice.as_nanos()).expect(\"short poll slice\"),\n    };\n    match poll(&mut fds, Some(&timeout)) {\n        Ok(_) | Err(rustix::io::Errno::INTR) => Ok(()),\n        Err(error) => Err(error.into()),\n    }\n}\nfn nonblocking(pipe: &impl AsFd) -> io::Result<()> {\n    fcntl_setfl(pipe, fcntl_getfl(pipe)? | OFlags::NONBLOCK)?;\n    Ok(())\n}\nfn drain_chunk(pipe: &mut Option<impl Read>, bytes: &mut Vec<u8>, limit: usize) -> io::Result<()> {\n    if let Some(reader) = pipe {\n        let mut chunk = [0; CHUNK_BYTES];\n        match reader.read(&mut chunk) {\n            Ok(0) => {\n                pipe.take();\n            }\n            Ok(n) => {\n                if n > limit.saturating_sub(bytes.len()) {\n                    return Err(io::Error::new(\n                        io::ErrorKind::FileTooLarge,\n                        \"host helper output exceeds budget\",\n                    ));\n                }\n                bytes.extend_from_slice(&chunk[..n]);\n            }\n            Err(error)\n                if matches!(\n                    error.kind(),\n                    io::ErrorKind::WouldBlock | io::ErrorKind::Interrupted\n                ) => {}\n            Err(error) => return Err(error),\n        }\n    }\n    Ok(())\n}\nimpl Deref for OwnedChild {\n    type Target = Child;\n    fn deref(&self) -> &Child {\n        self.child.as_ref().expect(\"owned child\")\n    }\n}\nimpl DerefMut for OwnedChild {\n    fn deref_mut(&mut self) -> &mut Child {\n        self.child.as_mut().expect(\"owned child\")\n    }\n}\nimpl Drop for OwnedChild {\n    fn drop(&mut self) {\n        if self.child.is_some() {\n            let _ = self.stop_and_reap();\n        }\n    }\n}\n#[cfg(test)]\nmod tests;\n"},{"id":6,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/std/src/process.rs"},"crate_name":"std","contents":null},{"id":12,"name":{"Local":"/rustc/library/std/src/lib.rs"},"crate_name":"std","contents":null},{"id":13,"name":{"Local":"sandbox-runtime/src/child_process/reaper.rs"},"crate_name":"sandbox_runtime","contents":"//! Fixed ownership queue: waiting for exit never creates another OS thread.\nuse std::{\n    io,\n    process::Child,\n    sync::{\n        Arc, Condvar, Mutex, OnceLock,\n        atomic::{AtomicUsize, Ordering},\n    },\n    thread,\n    time::Duration,\n};\nconst MAX_HELPERS: usize = 64;\nstruct Reaper {\n    active: AtomicUsize,\n    pending: Mutex<Vec<(Child, Slot)>>,\n    wake: Condvar,\n}\npub(super) struct Slot(Arc<Reaper>);\nimpl Slot {\n    pub fn acquire() -> io::Result<Self> {\n        static REAPER: OnceLock<Result<Arc<Reaper>, io::Error>> = OnceLock::new();\n        let reaper = REAPER\n            .get_or_init(|| {\n                let reaper = Arc::new(Reaper {\n                    active: AtomicUsize::new(0),\n                    pending: Mutex::new(Vec::with_capacity(MAX_HELPERS)),\n                    wake: Condvar::new(),\n                });\n                let worker = Arc::clone(&reaper);\n                thread::Builder::new()\n                    .name(\"host-helper-reaper\".into())\n                    .spawn(move || worker.run())?;\n                Ok(reaper)\n            })\n            .as_ref()\n            .map_err(|error| io::Error::new(error.kind(), \"cannot start host helper reaper\"))?;\n        Self::reserve(reaper)\n    }\n    fn reserve(reaper: &Arc<Reaper>) -> io::Result<Self> {\n        reaper\n            .active\n            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| {\n                (n < MAX_HELPERS).then(|| n + 1)\n            })\n            .map_err(|_| {\n                io::Error::new(io::ErrorKind::WouldBlock, \"host helper capacity exhausted\")\n            })?;\n        Ok(Self(Arc::clone(reaper)))\n    }\n    pub fn retain(self, child: Child) {\n        let reaper = Arc::clone(&self.0);\n        // Every entry owns a pre-spawn slot, so length is at most MAX_HELPERS.\n        reaper.pending.lock().unwrap().push((child, self));\n        reaper.wake.notify_one();\n    }\n}\nimpl Drop for Slot {\n    fn drop(&mut self) {\n        self.0.active.fetch_sub(1, Ordering::AcqRel);\n    }\n}\nimpl Reaper {\n    fn reap_ready(pending: &mut Vec<(Child, Slot)>) {\n        let mut i = 0;\n        while i < pending.len() {\n            if matches!(pending[i].0.try_wait(), Ok(Some(_))) {\n                pending.swap_remove(i);\n            } else {\n                i += 1;\n            }\n        }\n    }\n    fn run(&self) {\n        let mut pending = self.pending.lock().unwrap();\n        loop {\n            Self::reap_ready(&mut pending);\n            if pending.is_empty() {\n                pending = self.wake.wait(pending).unwrap();\n            } else {\n                pending = self\n                    .wake\n                    .wait_timeout(pending, Duration::from_millis(10))\n                    .unwrap()\n                    .0;\n            }\n        }\n    }\n}\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::process::{Command, Stdio};\n    #[test]\n    fn unknown_child_retains_capacity_until_exact_exit_is_reaped() {\n        let _serial = crate::linux::PROCESS_TEST_LOCK.lock().unwrap();\n        let reaper = Arc::new(Reaper {\n            active: AtomicUsize::new(0),\n            pending: Mutex::new(Vec::with_capacity(MAX_HELPERS)),\n            wake: Condvar::new(),\n        });\n        let mut slots: Vec<_> = (0..MAX_HELPERS)\n            .map(|_| Slot::reserve(&reaper).unwrap())\n            .collect();\n        assert!(Slot::reserve(&reaper).is_err());\n        let child = Command::new(\"/bin/sh\")\n            .args([\"-c\", \"IFS= read -r line\"])\n            .stdin(Stdio::piped())\n            .spawn()\n            .unwrap();\n        slots.pop().unwrap().retain(child);\n        let mut pending = reaper.pending.lock().unwrap();\n        Reaper::reap_ready(&mut pending);\n        assert_eq!(pending.len(), 1);\n        assert!(Slot::reserve(&reaper).is_err());\n        pending[0].0.kill().unwrap();\n        pending[0].0.wait().unwrap();\n        Reaper::reap_ready(&mut pending);\n        assert!(pending.is_empty());\n        assert_eq!(reaper.active.load(Ordering::Acquire), MAX_HELPERS - 1);\n        assert!(Slot::reserve(&reaper).is_ok());\n    }\n}\n"},{"id":14,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/io/error.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/io/mod.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"sandbox-runtime/src/child_process/observation_io.rs"},"crate_name":"sandbox_runtime","contents":"//! Mechanical calls for the original objects. Decisions stay in `observation_core`.\nuse super::{POLL_SLICE, REAP_GRACE, observation_core::Operations, reaper::Slot};\nuse std::{\n    io,\n    process::{Child, ExitStatus},\n    time::Instant,\n};\npub(super) struct SystemIo;\nimpl Operations for SystemIo {\n    type Child = Child;\n    type Slot = Slot;\n    type Status = ExitStatus;\n    type Error = io::Error;\n    type Instant = Instant;\n    fn try_wait(&mut self, child: &mut Child) -> io::Result<Option<ExitStatus>> {\n        child.try_wait()\n    }\n    fn kill(&mut self, child: &mut Child) -> io::Result<()> {\n        child.kill()\n    }\n    fn close_pipes(&mut self, child: &mut Child) {\n        drop(child.stdin.take());\n        drop(child.stdout.take());\n        drop(child.stderr.take());\n    }\n    fn now(&mut self) -> Instant {\n        Instant::now()\n    }\n    fn add_grace(&mut self, now: Instant) -> Instant {\n        now + REAP_GRACE\n    }\n    fn pause(&mut self) {\n        std::thread::sleep(POLL_SLICE);\n    }\n    fn retain(&mut self, slot: Slot, child: Child) {\n        slot.retain(child);\n    }\n    fn unknown_exit(&mut self) -> io::Error {\n        io::Error::new(io::ErrorKind::TimedOut, \"host helper exit remains unknown\")\n    }\n}\n\n/// Construct only the empty mechanical adapter; no OS operation occurs here.\n#[must_use]\npub(super) fn system() -> SystemIo {\n    SystemIo\n}\n"},{"id":18,"name":{"Local":"sandbox-runtime/src/child_process/observation_core.rs"},"crate_name":"sandbox_runtime","contents":"//! Original stop/reap control flow with explicit mutable OS observations.\n//! This is called by the isolated `OwnedChild` candidate, not a replacement VM.\npub(super) trait Operations {\n    type Child;\n    type Slot;\n    type Status;\n    type Error;\n    type Instant: Copy + PartialOrd;\n    fn try_wait(&mut self, child: &mut Self::Child) -> Result<Option<Self::Status>, Self::Error>;\n    fn kill(&mut self, child: &mut Self::Child) -> Result<(), Self::Error>;\n    fn close_pipes(&mut self, child: &mut Self::Child);\n    fn now(&mut self) -> Self::Instant;\n    fn add_grace(&mut self, now: Self::Instant) -> Self::Instant;\n    fn pause(&mut self);\n    fn retain(&mut self, slot: Self::Slot, child: Self::Child);\n    fn unknown_exit(&mut self) -> Self::Error;\n}\n\npub(super) fn stop<I: Operations>(\n    owned_child: &mut Option<I::Child>,\n    owned_slot: &mut Option<I::Slot>,\n    io: &mut I,\n) -> Result<I::Status, I::Error> {\n    let Some(child) = owned_child else {\n        panic!(\"owned child\");\n    };\n    if let Ok(Some(status)) = io.try_wait(child) {\n        return Ok(status);\n    }\n    let _ = io.kill(child);\n    io.close_pipes(child);\n    let now = io.now();\n    let deadline = io.add_grace(now);\n    loop {\n        if let Ok(Some(status)) = io.try_wait(child) {\n            return Ok(status);\n        }\n        if io.now() >= deadline {\n            let Some(child) = owned_child.take() else {\n                panic!(\"owned child\");\n            };\n            let Some(slot) = owned_slot.take() else {\n                panic!(\"helper admission\");\n            };\n            io.retain(slot, child);\n            return Err(io.unknown_exit());\n        }\n        io.pause();\n    }\n}\n"},{"id":19,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/panic.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/panicking.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":24,"name":{"Local":"/rustc/library/std/src/time.rs"},"crate_name":"std","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array"