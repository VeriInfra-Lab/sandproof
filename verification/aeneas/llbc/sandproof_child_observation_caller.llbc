mply an *exit status* (a value passed to `exit`)."},{"DocComment":""},{"DocComment":" For proper error reporting of failed processes, print the value of `ExitStatus` or"},{"DocComment":" `ExitStatusError` using their implementations of [`Display`](crate::fmt::Display)."},{"DocComment":""},{"DocComment":" # Differences from `ExitCode`"},{"DocComment":""},{"DocComment":" [`ExitCode`] is intended for terminating the currently running process, via"},{"DocComment":" the `Termination` trait, in contrast to `ExitStatus`, which represents the"},{"DocComment":" termination of a child process. These APIs are separate due to platform"},{"DocComment":" compatibility differences and their expected usage; it is not generally"},{"DocComment":" possible to exactly reproduce an `ExitStatus` from a child for the current"},{"DocComment":" process after the fact."},{"DocComment":""},{"DocComment":" [`status`]: Command::status"},{"DocComment":" [`wait`]: Child::wait"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":4},"align":{"guarantee":null,"chosen":4},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["io",0]},{"Ident":["error",0]},{"Ident":["Error",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":87,"col":0},"end":{"line":87,"col":16}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type for I/O operations of the [`Read`][Read], [`Write`][Write], [`Seek`][Seek], and"},{"DocComment":" associated traits."},{"DocComment":""},{"DocComment":" Errors mostly originate from the underlying OS, but custom instances of"},{"DocComment":" `Error` can be created with crafted error messages and a particular value of"},{"DocComment":" [`ErrorKind`]."},{"DocComment":""},{"DocComment":" [Read]: ../../std/io/trait.Read.html"},{"DocComment":" [Write]: crate::io::Write"},{"DocComment":" [Seek]: crate::io::Seek"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":8},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":9,"item_meta":{"name":[{"Ident":["sandbox_runtime",0]},{"Ident":["child_process",0]},{"Ident":["observation_io",0]},{"Ident":["SystemIo",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":8,"col":0},"end":{"line":8,"col":27}},"generated_from_span":null}},"source_text":"pub(super) struct SystemIo;","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Opaque","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":0},"align":{"guarantee":null,"chosen":1},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},null,null,null,{"def_id":13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Arguments",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":716,"col":0},"end":{"line":716,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" This structure represents a safely precompiled version of a format string"},{"DocComment":" and its arguments. This cannot be generated at runtime because it cannot"},{"DocComment":" safely be done, so no constructors are given and the fields are private"},{"DocComment":" to prevent modification."},{"DocComment":""},{"DocComment":" The [`format_args!`] macro will safely create an instance of this structure."},{"DocComment":" The macro validates the format string at compile-time so usage of the"},{"DocComment":" [`write()`] and [`format()`] functions can be safely performed."},{"DocComment":""},{"DocComment":" You can use the `Arguments<'a>` that [`format_args!`] returns in `Debug`"},{"DocComment":" and `Display` contexts as seen below. The example also shows that `Debug`"},{"DocComment":" and `Display` format to the same thing: the interpolated format string"},{"DocComment":" in `format_args!`."},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" let debug = format!(\"{:?}\", format_args!(\"{} foo {:?}\", 1, 2));"},{"DocComment":" let display = format!(\"{}\", format_args!(\"{} foo {:?}\", 1, 2));"},{"DocComment":" assert_eq!(\"1 foo 2\", display);"},{"DocComment":" assert_eq!(display, debug);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`format()`]: ../../std/fmt/fn.format.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"FormatArguments","diagnostic_item":null},"generics":{"regions":[{"index":0,"name":"'a","variance":"Covariant","mutability":"Shared"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":16},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0},{"guarantee":null,"chosen":8}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":14,"item_meta":{"name":[{"Builtin":["Str",0]}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Builtin":"Str"},"kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Value":[12,{"Slice":[{"Value":[13,{"Scalar":{"Integer":{"Unsigned":"U8"}}}]},null]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":null},"align":{"guarantee":null,"chosen":null},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},null,{"def_id":16,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["time",0]},{"Ident":["Instant",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":156,"col":0},"end":{"line":156,"col":18}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A measurement of a monotonically nondecreasing clock."},{"DocComment":" Opaque and useful only with [`Duration`]."},{"DocComment":""},{"DocComment":" Instants are always guaranteed, barring [platform bugs], to be no less than any previously"},{"DocComment":" measured instant when created, and are often useful for tasks such as measuring"},{"DocComment":" benchmarks or timing how long an operation takes."},{"DocComment":""},{"DocComment":" Note, however, that instants are **not** guaranteed to be **steady**. In other"},{"DocComment":" words, each tick of the underlying clock might not be the same length (e.g."},{"DocComment":" some seconds may be longer than others). An instant may jump forwards or"},{"DocComment":" experience time dilation (slow down or speed up), but it will never go"},{"DocComment":" backwards."},{"DocComment":" As part of this non-guarantee it is also not specified whether system suspends count as"},{"DocComment":" elapsed time or not. The behavior varies across platforms and Rust versions."},{"DocComment":""},{"DocComment":" Instants are opaque types that can only be compared to one another. There is"},{"DocComment":" no method to get \"the number of seconds\" from an instant. Instead, it only"},{"DocComment":" allows measuring the duration between two instants (or comparing two"},{"DocComment":" instants)."},{"DocComment":""},{"DocComment":" The size of an `Instant` struct may vary depending on the target operating"},{"DocComment":" system."},{"DocComment":""},{"DocComment":" Example:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::time::{Duration, Instant};"},{"DocComment":" use std::thread::sleep;"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"    let now = Instant::now();"},{"DocComment":""},{"DocComment":"    // we sleep for 2 seconds"},{"DocComment":"    sleep(Duration::new(2, 0));"},{"DocComment":"    // it prints '2'"},{"DocComment":"    println!(\"{}\", now.elapsed().as_secs());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [platform bugs]: Instant#monotonicity"},{"DocComment":""},{"DocComment":" # OS-specific behaviors"},{"DocComment":""},{"DocComment":" An `Instant` is a wrapper around system-specific types and it may behave"},{"DocComment":" differently depending on the underlying operating system. For example,"},{"DocComment":" the following snippet is fine on Linux but panics on macOS:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::time::{Instant, Duration};"},{"DocComment":""},{"DocComment":" let now = Instant::now();"},{"DocComment":" let days_per_10_millennia = 365_2425;"},{"DocComment":" let solar_seconds_per_day = 60 * 60 * 24;"},{"DocComment":" let millennium_in_solar_seconds = 31_556_952_000;"},{"DocComment":" assert_eq!(millennium_in_solar_seconds, days_per_10_millennia * solar_seconds_per_day / 10);"},{"DocComment":""},{"DocComment":" let duration = Duration::new(millennium_in_solar_seconds, 0);"},{"DocComment":" println!(\"{:?}\", now + duration);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For cross-platform code, you can comfortably use durations of up to around one hundred years."},{"DocComment":""},{"DocComment":" # Underlying System calls"},{"DocComment":""},{"DocComment":" The following system calls are [currently] being used by `now()` to find out"},{"DocComment":" the current time:"},{"DocComment":""},{"DocComment":" |  Platform |               System call                                            |"},{"DocComment":" |-----------|----------------------------------------------------------------------|"},{"DocComment":" | SGX       | [`insecure_time` usercall]. More information on [timekeeping in SGX] |"},{"DocComment":" | UNIX      | [clock_gettime] with `CLOCK_MONOTONIC`                               |"},{"DocComment":" | WASI      | [clock_gettime] with `CLOCK_MONOTONIC`                               |"},{"DocComment":" | Darwin    | [clock_gettime] with `CLOCK_UPTIME_RAW`                              |"},{"DocComment":" | VXWorks   | [clock_gettime] with `CLOCK_MONOTONIC`                               |"},{"DocComment":" | SOLID     | `get_tim`                                                            |"},{"DocComment":" | Windows   | [QueryPerformanceCounter]                                            |"},{"DocComment":""},{"DocComment":" [currently]: crate::io#platform-specific-behavior"},{"DocComment":" [QueryPerformanceCounter]: https://docs.microsoft.com/en-us/windows/win32/api/profileapi/nf-profileapi-queryperformancecounter"},{"DocComment":" [`insecure_time` usercall]: https://edp.fortanix.com/docs/api/fortanix_sgx_abi/struct.Usercalls.html#method.insecure_time"},{"DocComment":" [timekeeping in SGX]: https://edp.fortanix.com/docs/concepts/rust-std/#codestdtimecode"},{"DocComment":" [clock_gettime]: https://pubs.opengroup.org/onlinepubs/9799919799/functions/clock_getres.html"},{"DocComment":""},{"DocComment":" **Disclaimer:** These system calls might change over time."},{"DocComment":""},{"DocComment":" > Note: mathematical operations like [`add`] may panic if the underlying"},{"DocComment":" > structure cannot represent the new point in time."},{"DocComment":""},{"DocComment":" [`add`]: Instant::add"},{"DocComment":""},{"DocComment":" ## Monotonicity"},{"DocComment":""},{"DocComment":" On all platforms `Instant` will try to use an OS API that guarantees monotonic behavior"},{"DocComment":" if available, which is the case for all [tier 1] platforms."},{"DocComment":" In practice such guarantees are – under rare circumstances – broken by hardware, virtualization"},{"DocComment":" or operating system bugs. To work around these bugs and platforms not offering monotonic clocks"},{"DocComment":" [`duration_since`], [`elapsed`] and [`sub`](#impl-Sub-for-Instant) saturate to zero. In older"},{"DocComment":" Rust versions this lead to a panic instead. [`checked_duration_since`] can be used to detect and"},{"DocComment":" handle situations where monotonicity is violated, or `Instant`s are subtracted in the wrong order."},{"DocComment":""},{"DocComment":" This workaround obscures programming errors where earlier and later instants are accidentally"},{"DocComment":" swapped. For this reason future Rust versions may reintroduce panics."},{"DocComment":""},{"DocComment":" [tier 1]: https://doc.rust-lang.org/rustc/platform-support.html"},{"DocComment":" [`duration_since`]: Instant::duration_since"},{"DocComment":" [`elapsed`]: Instant::elapsed"},{"DocComment":" [`sub`]: Instant::sub"},{"DocComment":" [`checked_duration_since`]: Instant::checked_duration_since"},{"DocComment":""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":"Instant"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":16},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},null,{"def_id":18,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["Ordering",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":417,"col":0},"end":{"line":417,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An `Ordering` is the result of a comparison between two values."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::cmp::Ordering;"},{"DocComment":""},{"DocComment":" asse