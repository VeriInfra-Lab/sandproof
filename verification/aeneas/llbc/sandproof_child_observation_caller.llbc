ne":null,"rename":null,"public":true},"name":"None","fields":[],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":606,"col":4},"end":{"line":606,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Some value of type `T`."}],"inline":null,"rename":null,"public":true},"name":"Some","fields":[{"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":606,"col":55},"end":{"line":606,"col":56}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Deduplicated":10}}],"discriminant":{"Signed":["Isize","1"]}}]},"layout":[],"ptr_metadata":"None"},{"def_id":4,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["process",0]},{"Ident":["Child",0]}],"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":220,"col":0},"end":{"line":220,"col":16}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Representation of a running or exited child process."},{"DocComment":""},{"DocComment":" This structure is used to represent and manage child processes. A child"},{"DocComment":" process is created via the [`Command`] struct, which configures the"},{"DocComment":" spawning process and can itself be constructed using a builder-style"},{"DocComment":" interface."},{"DocComment":""},{"DocComment":" There is no implementation of [`Drop`] for child processes,"},{"DocComment":" so if you do not ensure the `Child` has exited then it will continue to"},{"DocComment":" run, even after the `Child` handle to the child process has gone out of"},{"DocComment":" scope."},{"DocComment":""},{"DocComment":" Calling [`wait`] (or other functions that wrap around it) will make"},{"DocComment":" the parent process wait until the child has actually exited before"},{"DocComment":" continuing."},{"DocComment":""},{"DocComment":" # Warning"},{"DocComment":""},{"DocComment":" On some systems, calling [`wait`] or similar is necessary for the OS to"},{"DocComment":" release resources. A process that terminated but has not been waited on is"},{"DocComment":" still around as a \"zombie\". Leaving too many zombies around may exhaust"},{"DocComment":" global resources (for example process IDs)."},{"DocComment":""},{"DocComment":" The standard library does *not* automatically wait on child processes (not"},{"DocComment":" even if the `Child` is dropped), it is up to the application developer to do"},{"DocComment":" so. As a consequence, dropping `Child` handles without waiting on them first"},{"DocComment":" is not recommended in long-running applications."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" use std::process::Command;"},{"DocComment":""},{"DocComment":" let mut child = Command::new(\"/bin/cat\")"},{"DocComment":"     .arg(\"file.txt\")"},{"DocComment":"     .spawn()"},{"DocComment":"     .expect(\"child should spawn\");"},{"DocComment":""},{"DocComment":" let ecode = child.wait().expect(\"child should be running\");"},{"DocComment":""},{"DocComment":" assert!(ecode.success());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`wait`]: Child::wait"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":"Child"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":28},"align":{"guarantee":null,"chosen":4},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0},{"guarantee":null,"chosen":16},{"guarantee":null,"chosen":20},{"guarantee":null,"chosen":24}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":5,"item_meta":{"name":[{"Ident":["sandbox_runtime",0]},{"Ident":["child_process",0]},{"Ident":["reaper",0]},{"Ident":["Slot",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":18,"col":0},"end":{"line":18,"col":36}},"generated_from_span":null}},"source_text":"pub(super) struct Slot(Arc<Reaper>);","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Opaque","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":8},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":558,"col":0},"end":{"line":558,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Result` is a type that represents either success ([`Ok`]) or failure ([`Err`])."},{"DocComment":""},{"DocComment":" See the [module documentation](self) for details."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Result"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"E","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":562,"col":4}