ame":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["drop",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":1045,"col":0},"end":{"line":1047,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Disposes of a value."},{"DocComment":""},{"DocComment":" This effectively does nothing for types which implement `Copy`, e.g."},{"DocComment":" integers. Such values are copied and _then_ moved into the function, so the"},{"DocComment":" value persists after this function call."},{"DocComment":""},{"DocComment":" This function is not magic; it is literally defined as"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" pub fn drop<T>(_x: T) {}"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `_x` is moved into the function, it is automatically [dropped][drop] before"},{"DocComment":" the function returns."},{"DocComment":""},{"DocComment":" [drop]: Drop"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = vec![1, 2, 3];"},{"DocComment":""},{"DocComment":" drop(v); // explicitly drop the vector"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since [`RefCell`] enforces the borrow rules at runtime, `drop` can"},{"DocComment":" release a [`RefCell`] borrow:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::cell::RefCell;"},{"DocComment":""},{"DocComment":" let x = RefCell::new(1);"},{"DocComment":""},{"DocComment":" let mut mutable_borrow = x.borrow_mut();"},{"DocComment":" *mutable_borrow = 1;"},{"DocComment":""},{"DocComment":" drop(mutable_borrow); // relinquish the mutable borrow on this slot"},{"DocComment":""},{"DocComment":" let borrow = x.borrow();"},{"DocComment":" println!(\"{}\", *borrow);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Integers and other types implementing [`Copy`] are unaffected by `drop`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dropping_copy_types)]"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Foo(u8);"},{"DocComment":""},{"DocComment":" let x = 1;"},{"DocComment":" let y = Foo(2);"},{"DocComment":" drop(x); // a copy of `x` is moved and dropped"},{"DocComment":" drop(y); // a copy of `y` is moved and dropped"},{"DocComment":""},{"DocComment":" println!(\"x: {}, y: {}\", x, y.0); // still available"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`RefCell`]: crate::cell::RefCell"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"mem_drop"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[122,{"data":{"file_id":17,"beg":{"line":1047,"col":7},"end":{"line":1047,"col":23}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":5}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5}],"output":{"Deduplicated":40}},"src":"Normal","body":"Opaque"},null,{"def_id":24,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]},{"Impl":{"Trait":6}},{"Builtin":["DropGlue",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":558,"col":0},"end":{"line":558,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"E","variance":"Covariant"}],"const_generics":[],"trait_clause