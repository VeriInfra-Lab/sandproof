"DocComment":""},{"DocComment":" `Ipv4Addr` provides a [`FromStr`] implementation. The four octets are in decimal"},{"DocComment":" notation, divided by `.` (this is called \"dot-decimal notation\")."},{"DocComment":" Notably, octal numbers (which are indicated with a leading `0`) and hexadecimal numbers (which"},{"DocComment":" are indicated with a leading `0x`) are not allowed per [IETF RFC 6943]."},{"DocComment":""},{"DocComment":" [IETF RFC 6943]: https://tools.ietf.org/html/rfc6943#section-3.1.1"},{"DocComment":" [`FromStr`]: crate::str::FromStr"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::net::Ipv4Addr;"},{"DocComment":""},{"DocComment":" let localhost = Ipv4Addr::new(127, 0, 0, 1);"},{"DocComment":" assert_eq!(\"127.0.0.1\".parse(), Ok(localhost));"},{"DocComment":" assert_eq!(localhost.is_loopback(), true);"},{"DocComment":" assert!(\"012.004.002.000\".parse::<Ipv4Addr>().is_err()); // all octets are in octal"},{"DocComment":" assert!(\"0000000.0.0.0\".parse::<Ipv4Addr>().is_err()); // first octet is a zero in octal"},{"DocComment":" assert!(\"0xcb.0x0.0x71.0x00\".parse::<Ipv4Addr>().is_err()); // all octets are in hex"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Ipv4Addr"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":4},"align":{"guarantee":null,"chosen":1},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident