{"charon_version":"0.1.254","translated":{"crate_name":"sandproof_network_extract","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::cidr_contains","crate::protected_ipv4","crate::destination_allowed","crate::parse_ipv4_bits","crate::egress","crate::ingress","crate::clone_world","crate::initial_world","crate::runtime_crash","crate::runtime_recover","crate::slot_transition","crate::controller_input","crate::runtime","crate::create"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["sandbox_controller_core"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"../aeneas/llbc/sandproof_network.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":true,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"sandproof_network_extract","contents":"//! Real production calls, not a second network algorithm.\nuse sandbox_controller_core::auxiliary::{AuxiliaryDecision, AuxiliaryReject};\nuse sandbox_controller_core::maintenance::slots::{HostSlotRecord, SlotInput, SlotReject};\nuse sandbox_controller_core::recovery_monitor::{RuntimeDecision, RuntimeReject};\nuse sandbox_controller_core::{\n    Actor, Endpoint, Ipv4Cidr, NetSlotId, NetworkPolicy, SandboxId, VmId, World,\n};\n\npub fn cidr_contains(cidr: &Ipv4Cidr, address: u32) -> bool {\n    cidr.contains(address)\n}\n\npub fn protected_ipv4(address: u32) -> bool {\n    sandbox_controller_core::platform_protected_ipv4(address)\n}\n\npub fn destination_allowed(policy: &NetworkPolicy, destination: &Endpoint) -> bool {\n    policy.destination_allowed(destination)\n}\n\npub fn parse_ipv4_bits(value: &str) -> Option<u32> {\n    match value.parse::<std::net::Ipv4Addr>() {\n        Ok(address) => Some(u32::from(address)),\n        Err(_) => None,\n    }\n}\n\npub fn egress(\n    world: &World,\n    sandbox: SandboxId,\n    vm: VmId,\n    slot: NetSlotId,\n    destination: Endpoint,\n) -> Result<AuxiliaryDecision, AuxiliaryReject> {\n    sandbox_controller_core::auxiliary::handle_egress(world, sandbox, vm, slot, destination)\n}\n\npub fn ingress(\n    world: &World,\n    actor: Actor,\n    sandbox: SandboxId,\n    vm: VmId,\n    slot: NetSlotId,\n) -> Result<AuxiliaryDecision, AuxiliaryReject> {\n    sandbox_controller_core::auxiliary::handle_ingress(world, actor, sandbox, vm, slot)\n}\n\npub fn clone_world(world: &World) -> World {\n    world.clone()\n}\n\npub fn initial_world() -> World {\n    sandbox_controller_core::initial_world()\n}\n\npub fn runtime_crash(world: &World) -> Result<RuntimeDecision, RuntimeReject> {\n    sandbox_controller_core::recovery_monitor::handle_controller_crash(world)\n}\n\npub fn runtime_recover(world: &World) -> Result<RuntimeDecision, RuntimeReject> {\n    sandbox_controller_core::recovery_monitor::handle_controller_recover(world)\n}\n\npub fn slot_transition(\n    previous: Option<HostSlotRecord>,\n    input: SlotInput,\n) -> Result<HostSlotRecord, SlotReject> {\n    sandbox_controller_core::maintenance::slots::reduce_slot(previous, input)\n}\n\n/// Preserve the real public input type in the shared current-state extraction.\n/// This is a representation boundary, not a second controller dispatcher.\npub fn controller_input(\n    input: sandbox_controller_core::ControllerInput,\n) -> sandbox_controller_core::ControllerInput {\n    input\n}\n\npub fn runtime(\n    world: &World,\n    input: sandbox_controller_core::recovery_monitor::RuntimeInput,\n) -> Result<RuntimeDecision, RuntimeReject> {\n    sandbox_controller_core::recovery_monitor::handle_runtime(world, input)\n}\n\n/// The production creation handler, including its ordered admission checks.\npub fn create(\n    world: &World,\n    input: sandbox_controller_core::request::CreateRequest,\n) -> Result<sandbox_controller_core::request::Decision, sandbox_controller_core::request::Reject> {\n    sandbox_controller_core::request::handle_create(world, input)\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":