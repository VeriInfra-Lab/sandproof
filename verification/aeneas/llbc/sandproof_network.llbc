nteger":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"sandproof_network_extract","contents":"//! Real production calls, not a second network algorithm.\nuse sandbox_controller_core::auxiliary::{AuxiliaryDecision, AuxiliaryReject};\nuse sandbox_controller_core::{\n    Actor, Endpoint, Ipv4Cidr, NetSlotId, NetworkPolicy, SandboxId, VmId, World,\n};\n\npub fn cidr_contains(cidr: &Ipv4Cidr, address: u32) -> bool {\n    cidr.contains(address)\n}\n\npub fn protected_ipv4(address: u32) -> bool {\n    sandbox_controller_core::platform_protected_ipv4(address)\n}\n\npub fn destination_allowed(policy: &NetworkPolicy, destination: &Endpoint) -> bool {\n    policy.destination_allowed(destination)\n}\n\npub fn parse_ipv4_bits(value: &str) -> Option<u32> {\n    match value.parse::<std::net::Ipv4Addr>() {\n        Ok(address) => Some(u32::from(address)),\n        Err(_) => None,\n    }\n}\n\npub fn egress(\n    world: &World,\n    sandbox: SandboxId,\n    vm: VmId,\n    slot: NetSlotId,\n    destination: Endpoint,\n) -> Result<AuxiliaryDecision, AuxiliaryReject> {\n    sandbox_controller_core::auxiliary::handle_egress(world, sandbox, vm, slot, destination)\n}\n\npub fn ingress(\n    world: &World,\n    actor: Actor,\n    sandbox: SandboxId,\n    vm: VmId,\n    slot: NetSlotId,\n) -> Result<AuxiliaryDecision, AuxiliaryReject> {\n    sandbox_controller_core::auxiliary::handle_ingress(world, actor, sandbox, vm, slot)\n}\n\npub fn clone_world(world: &World) -> World {\n    world.clone()\n}\n\npub fn initial_world() -> World {\n    sandbox_controller_core::initial_world()\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Virtual":"./controller-core/src/model.rs"},"crate_name":"sandbox_controller_core","contents":null},{"id":10,"name":{"Virtual":"./controller-core/src/lib.rs"},"crate_name":"sandbox_controller_core","contents":null},{"id":11,"name":{"Virtual":"./controller-core/src/network.rs"},"crate_name":"sandbox_controller_core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/net/ip_addr.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/net/mod.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/net/parser.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/str/mod.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/str/traits.rs"},"crate_name":"core","contents":null},