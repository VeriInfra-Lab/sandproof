ttr_info":{"attributes":[{"DocComment":" Converts from `&Option<T>` to `Option<&T>`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Calculates the length of an <code>Option<[String]></code> as an <code>Option<[usize]></code>"},{"DocComment":" without moving the [`String`]. The [`map`] method takes the `self` argument by value,"},{"DocComment":" consuming the original, so this technique uses `as_ref` to first take an `Option` to a"},{"DocComment":" reference to the value inside the original."},{"DocComment":""},{"DocComment":" [`map`]: Option::map"},{"DocComment":" [String]: ../../std/string/struct.String.html \"String\""},{"DocComment":" [`String`]: ../../std/string/struct.String.html \"String\""},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let text: Option<String> = Some(\"Hello, world!\".to_string());"},{"DocComment":" // First, cast `Option<String>` to `Option<&String>` with `as_ref`,"},{"DocComment":" // then consume *that* with `map`, leaving `text` on the stack."},{"DocComment":" let text_length: Option<usize> = text.as_ref().map(|s| s.len());"},{"DocComment":" println!(\"still can print text: {text:?}\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":34},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":402}],"output":{"Deduplicated":206}},"src":"Normal","body":"Opaque"},{"def_id":218,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["str",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":27},"kind":"InherentImplBlock"}}},{"Ident":["len",0]}],"span":{"Untagged":{"data":{"file_id":48,"beg":{"line":155,"col":4},"end":{"line":155,"col":36}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the length of `self`."},{"DocComment":""},{"DocComment":" This length is in bytes, not [`char`]s or graphemes. In other words,"},{"DocComment":" it might not be what a human considers the length of the string."},{"DocComment":""},{"DocComment":" [`char`]: prim@char"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let len = \"foo\".len();"},{"DocComment":" assert_eq!(3, len);"},{"DocComment":""},{"DocComment":" assert_eq!(\"ƒoo\".len(), 4); // fancy f!"},{"DocComment":" assert_eq!(\"ƒoo\".chars().count(), 3);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"str_len"},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":38}],"output":{"Deduplicated":0}},"src":"Normal","body":"Opaque"},{"def_id":219,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["str",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":27},"kind":"InherentImplBlock"}}},{"Ident":["split_at_checked",0]}],"span":{"Untagged":{"data":{"file_id":48,"beg":{"line":941,"col":4},"end":{"line":941,"col":76}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Divides one string slice into two at an index."},{"DocComment":""},{"DocComment":" The argument, `mid`, should be a valid byte offset from the start of the"},{"DocComment":" string. It must also be on the boundary of a UTF-8 code point. The"},{"DocComment":" method returns `None` if that’s not the case."},{"DocComment":""},{"DocComment":" The two slices returned go from the start of the string slice to `mid`,"},{"DocComment":" and from `mid` to the end of the string slice."},{"DocComment":""},{"DocComment":" To get mutable string slices instead, see the [`split_at_mut_checked`]"},{"DocComment":" method."},{"DocComment":""},{"DocComment":" [`split_at_mut_checked`]: str::split_at_mut_checked"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = \"Per Martin-Löf\";"},{"DocComment":""},{"DocComment":" let (first, last) = s.split_at_checked(3).unwrap();"},{"DocComment":" assert_eq!(\"Per\", first);"},{"DocComment":" assert_eq!(\" Martin-Löf\", last);"},{"DocComment":""},{"DocComment":" assert_eq!(None, s.split_at_checked(13));  // Inside “ö”"},{"DocComment":" assert_eq!(None, s.split_at_checked(16));  // Beyond the string length"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":38},{"Deduplicated":0}],"output":{"Value":[406,{"Adt":{"id":19,"generics":{"regions":[],"types":[{"Value":[407,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":38},{"Deduplicated":38}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":"Normal","body":"Opaque"},{"def_id":220,"item_meta":{"name":[{"Ident":["core",0]},{"Ident