 types (such as [`i8::from_str_radix`])"},{"DocComment":" and is used as the error type in their [`FromStr`] implementations."},{"DocComment":""},{"DocComment":" [`FromStr`]: crate::str::FromStr"},{"DocComment":""},{"DocComment":" # Potential causes"},{"DocComment":""},{"DocComment":" Among other causes, `ParseIntError` can be thrown because of leading or trailing whitespace"},{"DocComment":" in the string e.g., when it is obtained from the standard input."},{"DocComment":" Using the [`str::trim()`] method ensures that no whitespace remains before parsing."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" if let Err(e) = i32::from_str_radix(\"a12\", 10) {"},{"DocComment":"     println!(\"Failed conversion to i32: {e}\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":1},"align":{"guarantee":null,"chosen":1},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":63,"item_meta":{"name":[{"Ident":["sandproof_protocol",0]},{"Ident":["ResourceRef",0]}],"span":{"Untagged":{"data":{"file_id":19,"beg":{"line":194,"col":0},"end":{"line":194,"col":22}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The host-specific ID must be checked against the actual object before use."},{"Unknown":{"path":"serde","args":"deny_unknown_fields"}}],"inline":null,"rename":null,"public":true},"is_local":