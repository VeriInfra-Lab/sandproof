:true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"../aeneas/llbc/sandproof_foundations.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":true,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"sandproof_foundations_extract","contents":"#![forbid(unsafe_code)]\n\n//! Free roots avoid the fixed frontend's associated-method root discovery gap.\n//! There is deliberately no copy of a production algorithm in this crate.\npub mod json;\npub mod json_ids;\npub mod numeric;\npub mod receipts;\nuse sandproof_protocol::WorkOutcome;\nuse sandproof_protocol::internal::lifecycle::{CreateBinding, Resources};\nuse sandproof_protocol::internal::{ControlIdentity, InternalError, PositiveCounter};\nuse sandproof_protocol::{\n    ClientRequestId, ContractError, DeploymentId, LogicalActionId, NodeId, OperationId, ResourceId,\n    SandboxId, TenantId,\n};\n\npub fn counter_from_u64(value: u64) -> Result<PositiveCounter, InternalError> {\n    PositiveCounter::try_from(value)\n}\n\npub fn counter_next(value: PositiveCounter) -> Result<PositiveCounter, InternalError> {\n    value.checked_next()\n}\n\npub fn counter_value(value: PositiveCounter) -> u64 {\n    value.get()\n}\n\npub fn counter_into_u64(value: PositiveCounter) -> u64 {\n    u64::from(value)\n}\n\npub fn internal_error_text(value: InternalError) -> String {\n    value.to_string()\n}\n\npub fn lane_current(lane: &sandproof_center_core::RetentionLane) -> Option<PositiveCounter> {\n    lane.current()\n}\n\npub fn store_get_copy(store: &sandbox_controller_core::Store<u64, u64>, key: u64) -> Option<u64> {\n    store.get_copy(&key)\n}\n\npub fn store_put(store: &mut sandbox_controller_core::Store<u64, u64>, key: u64, value: u64) {\n    store.put(key, value);\n}\n\npub fn store_retain_above(store: &mut sandbox_controller_core::Store<u64, u64>, floor: u64) {\n    store.retain(|_, value| *value > floor);\n}\n\npub fn option_is_none_or(value: Option<u64>, floor: u64) -> bool {\n    value.is_none_or(|value| value > floor)\n}\n\npub fn resource_add(left: Resources, right: Resources) -> Option<Resources> {\n    left.checked_add(right)\n}\n\npub fn resource_positive(value: Resources) -> bool {\n    value.positive()\n}\n\npub fn resource_fits(value: Resources, limit: Resources) -> bool {\n    value.fits(limit)\n}\n\npub fn resource_values(value: Resources) -> [u64; 4] {\n    value.values()\n}\n\npub fn create_binding_valid(value: &CreateBinding) -> bool {\n    value.is_valid()\n}\n\npub fn identity_response(\n    actual: &ControlIdentity,\n    expected: &ControlIdentity,\n) -> Result<(), InternalError> {\n    actual.validate_response(expected)\n}\n\npub fn retry_hint(outcome: &WorkOutcome<u64>) -> bool {\n    outcome.permits_new_attempt()\n}\n\npub fn outcome_observation(outcome: &WorkOutcome<u64>) -> Option<&u64> {\n    outcome.observation()\n}\n\npub fn allocated_number(value: &str, prefix: &str, highwater: u64) -> Option<u64> {\n    sandproof_protocol::parse_allocated_number(value, prefix, highwater)\n}\npub fn center_allocated_number(value: &str, prefix: &str, highwater: u64) -> Option<u64> {\n    sandproof_center_core::parse_allocated_number(value, prefix, highwater)\n}\n\npub fn tenant_from_string(value: String) -> Result<TenantId, ContractError> {\n    TenantId::try_from(value)\n}\npub fn tenant_from_str(value: &str) -> Result<TenantId, ContractError> {\n    TenantId::try_from(value)\n}\npub fn tenant_value(value: &TenantId) -> &str {\n    value.as_str()\n}\npub fn tenant_into_string(value: TenantId) -> String {\n    value.into()\n}\npub fn sandbox_from_string(value: String) -> Result<SandboxId, ContractError> {\n    SandboxId::try_from(value)\n}\npub fn sandbox_from_str(value: &str) -> Result<SandboxId, ContractError> {\n    SandboxId::try_from(value)\n}\npub fn sandbox_value(value: &SandboxId) -> &str {\n    value.as_str()\n}\npub fn sandbox_into_string(value: SandboxId) -> String {\n    value.into()\n}\npub fn operation_from_string(value: String) -> Result<OperationId, ContractError> {\n    OperationId::try_from(value)\n}\npub fn operation_from_str(value: &str) -> Result<OperationId, ContractError> {\n    OperationId::try_from(value)\n}\npub fn operation_value(value: &OperationId) -> &str {\n    value.as_str()\n}\npub fn operation_into_string(value: OperationId) -> String {\n    value.into()\n}\npub fn logical_action_from_string(value: String) -> Result<LogicalActionId, ContractError> {\n    LogicalActionId::try_from(value)\n}\npub fn logical_action_from_str(value: &str) -> Result<LogicalActionId, ContractError> {\n    LogicalActionId::try_from(value)\n}\npub fn logical_action_value(value: &LogicalActionId) -> &str {\n    value.as_str()\n}\npub fn logical_action_into_string(value: LogicalActionId) -> String {\n    value.into()\n}\npub fn resource_from_string(value: String) -> Result<ResourceId, ContractError> {\n    ResourceId::try_from(value)\n}\npub fn resource_from_str(value: &str) -> Result<ResourceId, ContractError> {\n    ResourceId::try_from(value)\n}\npub fn resource_value(value: &ResourceId) -> &str {\n    value.as_str()\n}\npub fn resource_into_string(value: ResourceId) -> String {\n    value.into()\n}\npub fn client_request_from_string(value: String) -> Result<ClientRequestId, ContractError> {\n    ClientRequestId::try_from(value)\n}\npub fn client_request_from_str(value: &str) -> Result<ClientRequestId, ContractError> {\n    ClientRequestId::try_from(value)\n}\npub fn client_request_value(value: &ClientRequestId) -> &str {\n    value.as_str()\n}\npub fn client_request_into_string(value: ClientRequestId) -> String {\n    value.into()\n}\npub fn deployment_from_string(value: String) -> Result<DeploymentId, ContractError> {\n    DeploymentId::try_from(value)\n}\npub fn deployment_from_str(value: &str) -> Result<DeploymentId, ContractError> {\n    DeploymentId::try_from(value)\n}\npub fn deployment_value(value: &DeploymentId) -> &str {\n    value.as_str()\n}\npub fn deployment_into_string(value: DeploymentId) -> String {\n    value.into()\n}\npub fn node_from_string(value: String) -> Result<NodeId, ContractError> {\n    NodeId::try_from(value)\n}\npub fn node_from_str(value: &str) -> Result<NodeId, ContractError> {\n    NodeId::try_from(value)\n}\npub fn node_value(value: &NodeId) -> &str {\n    value.as_str()\n}\npub fn node_into_string(value: NodeId) -> String {\n    value.into()\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/serde_core-1.0.228/src/de/mod.rs"},"crate_name":"serde_core","contents":null},{"id":6,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/serde_core-1.0.228/src/crate_root.rs"},"crate_name":"serde_core","contents":null},{"id":7,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/serde_core-1.0.228/src/lib.rs"},"crate_name":"serde_core","contents":null},{"id":8,"name":{"Local":"src/json_ids.rs"},"crate_name":"sandproof_foundations_extract","contents":"#![forbid(unsafe_code)]\n\n//! Direct calls to the production Deserialize implementations; no validator copy.\nuse serde::{Deserialize, Deserializer};\n\npub fn tenant_decode<'de, D: Deserializer<'de>>(\n    input: D,\n) -> Result<sandproof_protocol::TenantId, D::Error> {\n    sandproof_protocol::TenantId::deserialize(input)\n}\n\npub fn sandbox_decode<'de, D: Deserializer<'de>>(\n    input: D,\n) -> Result<sandproof_protocol::SandboxId, D::Error> {\n    sandproof_protocol::SandboxId::deserialize(input)\n}\n\npub fn operation_decode<'de, D: Deserializer<'de>>(\n    input: D,\n) -> Result<sandproof_protocol::OperationId, D::Error> {\n    sandproof_protocol::OperationId::deserialize(input)\n}\n\npub fn logical_action_decode<'de, D: Deserializer<'de>>(\n    input: D,\n) -> Result<sandproof_protocol::LogicalActionId, D::Error> {\n    sandproof_protocol::LogicalActionId::deserialize(input)\n}\n\npub fn resource_decode<'de, D: Deserializer<'de>>(\n    input: D,\n) -> Result<sandproof_protocol::ResourceId, D::Error> {\n    sandproof_protocol::ResourceId::deserialize(input)\n}\n\npub fn client_request_decode<'de, D: Deserializer<'de>>(\n    input: D,\n) -> Result<sandproof_protocol::ClientRequestId, D::Error> {\n    sandproof_protocol::ClientRequestId::deserialize(input)\n}\n\npub fn deployment_decode<'de, D: Deserializer<'de>>(\n    input: D,\n) -> Result<sandproof_protocol::DeploymentId, D::Error> {\n    sandproof_protocol::DeploymentId::deserialize(input)\n}\n\npub fn node_decode<'de, D: Deserializer<'de>>(\n    input: D,\n) -> Result<sandproof_protocol::NodeId, D::Error> {\n    sandproof_protocol::NodeId::deserialize(input)\n}\n\npub fn string_primitive<'de, D: Deserializer<'de>>(input: D) -> Result<String, D::Error> {\n    String::deserialize(input)\n}\n\n#[cfg(test)]\nmod tests {\n    macro_rules! identifier_cases {\n        ($module:ident, $identity:ident) => {\n            mod $module {\n                use sandproof_protocol::$identity;\n\n                #[test]\n                fn successful_decode_is_valid() {\n                    let mut inputs = vec![\n                        \"\".to_owned(), \"id.A-1_\".to_owned(), \"-\".to_owned(),\n                        \"_\".to_owned(), \".\".to_owned(), \"a b\".to_owned(),\n                        \"a/b\".to_owned(), \"line\\nx\".to_owned(), \"中文\".to_owned(),\n                        \"é\".to_owned(), \"\\0\".to_owned(), \"a:b\".to_owned(),\n                        \"a@b\".to_owned(),\n                    ];\n                    inputs.push(\"a\".repeat(128));\n                    inputs.push(\"a\".repeat(129));\n                    for text in inputs {\n                        let json = serde_json::to_string(&text).unwrap();\n                        let borrowed = serde_json::from_str::<$identity>(&json);\n                        let bytes = serde_json::from_slice::<$identity>(json.as_bytes());\n                        let owned = serde_json::from_value::<$identity>(\n                            serde_json::Value::String(text.clone()));\n                        for result in [borrowed, bytes, owned] {\n                            if let Ok(value) = result {\n                                let actual = value.as_str();\n                                assert!(\n                                    !actual.is_empty() && actual.len() <= 128 &&\n                                        actual.bytes().all(|b| b.is_ascii_alphanumeric() ||\n                                            matches!(b, b'-' | b'_' | b'.')),\n                                    \"successful decode violated opaque identifier contract: {text:?}\"\n                                );\n                                assert_eq!(actual, text,\n                                    \"successful decode changed the original string\");\n                            }\n                        }\n                    }\n                }\n\n                #[test]\n                fn accepts_exact_values_and_escaped_text() {\n                    for text in [\"id.A-1_\".to_owned(), \"a\".repeat(128)] {\n                        let json = serde_json::to_string(&text).unwrap();\n                        assert_eq!(serde_json::from_str::<$identity>(&json).unwrap().as_str(), text);\n                        assert_eq!(serde_json::from_slice::<$identity>(json.as_bytes())\n                            .unwrap().as_str(), text);\n                        assert_eq!(serde_json::from_value::<$identity>(\n                            serde_json::Value::String(text.clone())).unwrap().as_str(), text);\n                    }\n                    assert_eq!(serde_json::from_str::<$identity>(r#\"\"id\\u002eA-1_\"\"#)\n                        .unwrap().as_str(), \"id.A-1_\");\n                }\n\n                #[test]\n                fn original_error_and_first_rejection() {\n                    let invalid = serde_json::from_slice::<$identity>(br#\"\"\" x\"#).unwrap_err();\n                    assert_eq!(invalid.to_string(), \"invalid opaque identifier\");\n                    assert_eq!(invalid.classify(), serde_json::error::Category::Data);\n                    assert_eq!((invalid.line(), invalid.column()), (0, 0));\n                    let trailing = serde_json::from_slice::<$identity>(br#\"\"good\" x\"#).unwrap_err();\n                    assert_eq!(trailing.to_string(), \"trailing characters at line 1 column 8\");\n                    assert_eq!(trailing.classify(), serde_json::error::Category::Syntax);\n                    for input in [\"42\", \"null\", \"true\", \"[]\", \"{}\"] {\n                        let error = serde_json::from_str::<$identity>(input).unwrap_err();\n                        assert!(error.to_string().contains(\"expected a string\"), \"{error}\");\n                        assert_eq!(error.classify(), serde_json::error::Category::Data);\n                    }\n                }\n            }\n        };\n    }\n    identifier_cases!(tenant, TenantId);\n    identifier_cases!(sandbox, SandboxId);\n    identifier_cases!(operation, OperationId);\n    identifier_cases!(logical_action, LogicalActionId);\n    identifier_cases!(resource, ResourceId);\n    identifier_cases!(client_request, ClientRequestId);\n    identifier_cases!(deployment, DeploymentId);\n    identifier_cases!(node, NodeId);\n}\n"},{"id":9,"name":{"Local":"src/json.rs"},"crate_name":"sandproof_foundations_extract","contents":"#![forbid(unsafe_code)]\n\n//! Direct roots for the production JSON counter leaf, not a copied validator.\nuse sandproof_protocol::internal::PositiveCounter;\nuse serde::{Deserialize, Deserializer};\n\npub fn counter_decode<'de, D: Deserializer<'de>>(input: D) -> Result<PositiveCounter, D::Error> {\n    PositiveCounter::deserialize(input)\n}\n\npub fn counter_primitive<'de, D: Deserializer<'de>>(input: D) -> Result<u64, D::Error> {\n    u64::deserialize(input)\n}\n\n// Keeps the real engine error type explicit for the reviewed library view.\npub fn json_error_passthrough(error: serde_json::Error) -> serde_json::Error {\n    error\n}\n\n#[cfg(test)]\nmod tests {\n    use sandproof_protocol::internal::PositiveCounter;\n\n    #[test]\n    fn successful_decode_is_positive() {\n        for input in [\"0\", \"1\", \"18446744073709551615\"] {\n            if let Ok(value) = serde_json::from_str::<PositiveCounter>(input) {\n                assert_ne!(value.get(), 0, \"successful decode returned zero: {input}\");\n            }\n        }\n    }\n\n    #[test]\n    fn nonzero_and_original_error_order() {\n        for (input, expected) in [(\"1\", 1), (\"18446744073709551615\", u64::MAX)] {\n            assert_eq!(\n                serde_json::from_str::<PositiveCounter>(input)\n                    .unwrap()\n                    .get(),\n                expected\n            );\n        }\n        let zero = serde_json::from_slice::<PositiveCounter>(b\"0 x\").unwrap_err();\n        assert_eq!(zero.to_string(), \"invalid or exhausted internal counter\");\n        assert_eq!(zero.classify(), serde_json::error::Category::Data);\n        assert_eq!((zero.line(), zero.column()), (0, 0));\n        let nonzero = serde_json::from_slice::<PositiveCounter>(b\"1 x\").unwrap_err();\n        assert_eq!(\n            nonzero.to_string(),\n            \"trailing characters at line 1 column 3\"\n        );\n        assert_eq!(nonzero.classify(), serde_json::error::Category::Syntax);\n        assert_eq!((nonzero.line(), nonzero.column()), (1, 3));\n    }\n}\n"},{"id":10,"name":{"Local":"src/numeric.rs"},"crate_name":"sandproof_foundations_extract","contents":"//! Free roots call the same numeric helpers used by the product services.\n\npub fn seconds_to_milliseconds(seconds: u64) -> Option<u64> {\n    sandproof_protocol::numeric::seconds_to_milliseconds(seconds)\n}\n\npub fn bytes_to_mebibytes(bytes: u64) -> Option<u32> {\n    sandproof_protocol::numeric::bytes_to_mebibytes(bytes)\n}\n\npub fn available_resource(limit: u64, used: u64, observed: u64) -> u64 {\n    sandproof_protocol::numeric::available_resource(limit, used, observed)\n}\n"},{"id":11,"name":{"Local":"src/receipts.rs"},"crate_name":"sandproof_foundations_extract","contents":"//! Roots for the actual shared action/receipt checks. No protocol algorithm is\n//! copied here, and evidence remains a caller-supplied dictionary.\nuse sandproof_protocol::{\n    ActionIdentity, ContractError, ResourceEvidence, WorkAction, WorkReceipt,\n};\n\npub fn action_version(value: &ActionIdentity) -> Result<(), ContractError> {\n    value.validate_version()\n}\n\npub fn receipt_validate<C, E: ResourceEvidence>(\n    receipt: &WorkReceipt<E>,\n    action: &WorkAction<C>,\n) -> Result<(), ContractError> {\n    receipt.validate_for(action)\n}\n"},{"id":12,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/alloc/src/string.rs"},"crate_name":"alloc","contents":null},{"id":18,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":19,"name":{"Virtual":"./sandbox-protocol/src/lib.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/serde_core-1.0.228/src/de/impls.rs"},"crate_name":"serde_core","contents":null},{"id":22,"name":{"Virtual":"./sandbox-protocol/src/internal.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":23,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/serde_json-1.0.142/src/error.rs"},"crate_na