"},{"DocComment":""},{"DocComment":" # Lifetime"},{"DocComment":""},{"DocComment":" The `'de` lifetime of this trait is the lifetime of data that may be"},{"DocComment":" borrowed by `Self` when deserialized. See the page [Understanding"},{"DocComment":" deserializer lifetimes] for a more detailed explanation of these lifetimes."},{"DocComment":""},{"DocComment":" [Understanding deserializer lifetimes]: https://serde.rs/lifetimes.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[{"index":0,"name":"'de","variance":"Unknown","mutability":"Unknown"}],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[],"types":[{"index":0,"name":"D","variance":"Invariant"},{"index":1,"name":"Clause0_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[1722,{"data":{"file_id":5,"beg":{"line":563,"col":11},"end":{"line":563,"col":28}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":5},{"Deduplicated":6}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"deserialize","item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["Deserialize",0]},{"Ident":["deserialize",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":561,"col":4},"end":{"line":563,"col":29}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Deserialize this value from the given Serde deserializer."},{"DocComment":""},{"DocComment":" See the [Implementing `Deserialize`][impl-deserialize] section of the"},{"DocComment":" manual for more information about how to implement this method."},{"DocComment":""},{"DocComment":" [impl-deserialize]: https://serde.rs/impl-deserialize.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":2}],"output":{"Value":[681,{"Adt":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":34},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":null},"kind":{"TraitMethod":[20,0]}},null],"vtable":null},{"def_id":21,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["TryFrom",0]}],"span":{"Untagged":{"data":{"file_id":35,"beg":{"line":697,"col":0},"end":{"line":697,"col":33}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Simple and safe type conversions that may fail in a controlled"},{"DocComment":" way under some circumstances. It is the reciprocal of [`TryInto`]."},{"DocComment":""},{"DocComment":" This is useful when you are doing a type conversion that may"},{"DocComment":" trivially succeed but may also need special handling."},{"DocComment":" For example, there is no way to convert an [`i64`] into an [`i32`]"},{"DocComment":" using the [`From`] trait, because an [`i64`] may contain a value"},{"DocComment":" that an [`i32`] cannot represent and so the conversion would lose data."},{"DocComment":" This might be handled by truncating the [`i64`] to an [`i32`] or by"},{"DocComment":" simply returning [`i32::MAX`], or by some other method.  The [`From`]"},{"DocComment":" trait is intended for perfect conversions, so the `TryFrom` trait"},{"DocComment":" informs the programmer when a type conversion could go bad and lets"},{"DocComment":" them decide how to handle it."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" - `TryFrom<T> for U` implies [`TryInto`]`<U> for T`"},{"DocComment":" - [`try_from`] is reflexive, which means that `TryFrom<T> for T`"},{"DocComment":" is implemented and cannot fail -- the associated `Error` type for"},{"DocComment":" calling `T::try_from()` on a value of type `T` is [`Infallible`]."},{"DocComment":" When the [`!`] type is stabilized [`Infallible`] and [`!`] will be"},{"DocComment":" equivalent."},{"DocComment":""},{"DocComment":" Prefer using [`TryInto`] over [`TryFrom`] when specifying trait bounds on a generic function"},{"DocComment":" to ensure that types that only implement [`TryInto`] can be used as well."},{"DocComment":""},{"DocComment":" `TryFrom<T>` can be implemented as follows:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct GreaterThanZero(i32);"},{"DocComment":""},{"DocComment":" impl TryFrom<i32> for GreaterThanZero {"},{"DocComment":"     type Error = &'static str;"},{"DocComment":""},{"DocComment":"     fn try_from(value: i32) -> Result<Self, Self::Error> {"},{"DocComment":"         if value <= 0 {"},{"DocComment":"             Err(\"GreaterThanZero only accepts values greater than zero!\")"},{"DocComment":"         } else {"},{"DocComment":"             Ok(GreaterThanZero(value))"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" As described, [`i32`] implements `TryFrom<`[`i64`]`>`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let big_number = 1_000_000_000_000i64;"},{"DocComment":" // Silently truncates `big_number`, requires detecting"},{"DocComment":" // and handling the truncation after the fact."},{"DocComment":" let smaller_number = big_number as i32;"},{"DocComment":" assert_eq!(smaller_number, -727379968);"},{"DocComment":""},{"DocComment":" // Returns an error because `big_number` is too big to"},{"DocComment":" // fit in an `i32`."},{"DocComment":" let try_smaller_number = i32::try_from(big_number);"},{"DocComment":" assert!(try_smaller_number.is_err());"},{"DocComment":""},{"DocComment":" // Returns `Ok(3)`."},{"DocComment":" let try_successful_smaller_number = i32::try_from(3);"},{"DocComment":" assert!(try_successful_smaller_number.is_ok());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`try_from`]: TryFrom::try_from"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"TryFrom"},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"},{"index":2,"name":"Self_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_from","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["TryFrom",0]},{"Ident":["try_from",0]}],"span":{"Untagged":{"data":{"file_id":35,"beg":{"line":705,"col":4},"end":{"line":705,"col":55}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the conversion."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"try_from_fn"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":41}],"output":{"Deduplicated":359}},"default":null},"kind":{"TraitMethod":[21,0]}}],"vtable":null},{"def_id":22,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Ident":["ToString",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":2903,"col":0},"end":{"line":2903,"col":18}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for converting a value to a `String`."},{"DocComment":""},{"DocComment":" This trait is automatically implemented for any type which implements the"},{"DocComment":" [`Display`] trait. As such, `ToString` shouldn't be implemented directly:"},{"DocComment":" [`Display`] should be implemented instead, and you get the `ToString`"},{"DocComment":" implementation for free."},{"DocComment":""},{"DocComment":" [`Display`]: fmt::Display"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"ToString"},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"to_string","item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Ident":["ToString",0]},{"Ident":["to_string",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":2917,"col":4},"end":{"line":2917,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts the given value to a `String`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let i = 5;"},{"DocComment":" let five = String::from(\"5\");"},{"DocComment":""},{"DocComment":" assert_eq!(five, i.to_string());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"to_string_method"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":77}],"output":{"Deduplicated":42}},"default":null},"kind":{"TraitMethod":[22,0]}}],"vtable":{"id":71,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":23,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["str",0]},{"Ident":["traits",0]},{"Ident":["FromStr",0]}],"span":{"Untagged":{"data":{"file_id":49,"beg":{"line":868,"col":0},"end":{"line":868,"col":30}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Parse a value from a string"},{"DocComment":""},{"DocComment":" `FromStr`'s [`from_str`] method is often used implicitly, through"},{"DocComment":" [`str`]'s [`parse`] method. See [`parse`]'s documentation for examples."},{"DocComment":""},{"DocComment":" [`from_str`]: FromStr::from_str"},{"DocComment":" [`parse`]: str::parse"},{"DocComment":""},{"DocComment":" `FromStr` does not have a lifetime parameter, and so you can only parse types"},{"DocComment":" that do not contain a lifetime parameter themselves. In other words, you can"},{"DocComment":" parse an `i32` with `FromStr`, but not a `&i32`. You can parse a struct that"},{"DocComment":" contains an `i32`, but not one that contains an `&i32`."},{"DocComment":""},{"DocComment":" # Input format and round-tripping"},{"DocComment":""},{"DocComment":" The input format expected by a type's `FromStr` implementation depends on the type. Check the"},{"DocComment":" type's documentation for the input formats it knows how to parse. Note that the input format of"},{"DocComment":" a type's `FromStr` implementation might not necessarily accept the output format of its"},{"DocComment":" `Display` implementation, and even if it does, the `Display` implementation may not be lossless"},{"DocComment":" so the round-trip may lose information."},{"DocComment":""},{"DocComment":" However, if a type has a lossless `Display` implementation whose output is meant to be"},{"DocComment":" conveniently machine-parseable and not just meant for human consumption, then the type may wish"},{"DocComment":" to accept the same format in `FromStr`, and document that usage. Having both `Display` and"},{"DocComment":" `FromStr` implementations where the result of `Display` cannot be parsed with `FromStr` may"},{"DocComment":" surprise users."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic implementation of `FromStr` on an example `Point` type:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::str::FromStr;"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq, Eq)]"},{"DocComment":" struct ParsePointError;"},{"DocComment":""},{"DocComment":" impl FromStr for Point {"},{"DocComment":"     type Err = ParsePointError;"},{"DocComment":""},{"DocComment":"     fn from_str(s: &str) -> Result<Self, Self::Err> {"},{"DocComment":"         let (x, y) = s"},{"DocComment":"             .strip_prefix('(')"},{"DocComment":"             .and_then(|s| s.strip_suffix(')'))"},{"DocComment":"             .and_then(|s| s.split_once(','))"},{"DocComment":"             .ok_or(ParsePointError)?;"},{"DocComment":""},{"DocComment":"         let x_fromstr = x.parse::<i32>().map_err(|_| ParsePointError)?;"},{"DocComment":"         let y_fromstr = y.parse::<i32>().map_err(|_| ParsePointError)?;"},{"DocComment":""},{"DocComment":"         Ok(Point { x: x_fromstr, y: y_fromstr })"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let expected = Ok(Point { x: 1, y: 2 });"},{"DocComment":" // Explicit call"},{"DocComment":" assert_eq!(Point::from_str(\"(1,2)\"), expected);"},{"DocComment":" // Implicit calls, through parse"},{"DocComment":" assert_eq!(\"(1,2)\".parse(), expected);"},{"DocComment":" assert_eq!(\"(1,2)\".parse::<Point>(), expected);"},{"DocComment":" // Invalid input string"},{"DocComment":" assert!(Point::from_str(\"(1 2)\").is_err());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Err","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"from_str","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["str",0]},{"Ident":["traits",0]},{"Ident":["FromStr",0]},{"Ident":["from_str",0]}],"span":{"Untagged":{"data":{"file_id":49,"beg":{"line":893,"col":4},"end":{"line":893,"col":52}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Parses a string `s` to return a value of this type."},{"DocComment":""},{"DocComment":" If parsing succeeds, return the value inside [`Ok`], otherwise"},{"DocComment":" when the string is ill-formatted return an error specific to the"},{"DocComment":" inside [`Err`]. The error type is specific to the implementation of the trait."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage with [`i32`], a type that implements `FromStr`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::str::FromStr;"},{"DocComment":""},{"DocComment":" let s = \"5\";"},{"DocComment":" let x = i32::from_str(s).unwrap();"},{"DocComment":""},{"DocComment":" assert_eq!(5, x);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"from_str_method"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":671}],"output":{"Deduplicated":357}},"default":null},"kind":{"TraitMethod":[23,0]}}],"vtable":null},{"def_id":24,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["Into",0]}],"span":{"Untagged":{"data":{"file_id":35,"beg":{"line":452,"col":0},"end":{"line":452,"col":30}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A value-to-value conversion that consumes the input value. The"},{"DocComment":" opposite of [`From`]."},{"DocComment":""},{"DocComment":" One should avoid implementing [`Into`] and implement [`From`] instead."},{"DocComment":" Implementing [`From`] automatically provides one with an implementation of [`Into`]"},{"DocComment":" thanks to the blanket implementation in the standard library."},{"DocComment":""},{"DocComment":" Prefer using [`Into`] over [`From`] when specifying trait bounds on a generic function"},{"DocComment":" to ensure that types that only implement [`Into`] can be used as well."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. If the conversion can fail, use [`TryInto`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" - [`From`]`<T> for U` implies `Into<U> for T`"},{"DocComment":" - [`Into`] is reflexive, which means that `Into<T> for T` is implemented"},{"DocComment":""},{"DocComment":" # Implementing [`Into`] for conversions to external types in old versions of Rust"},{"DocComment":""},{"DocComment":" Prior to Rust 1.41, if the destination type was not part of the current crate"},{"DocComment":" then you couldn't implement [`From`] directly."},{"DocComment":" For example, take this code:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(non_local_definitions)]"},{"DocComment":" struct Wrapper<T>(Vec<T>);"},{"DocComment":" impl<T> From<Wrapper<T>> for Vec<T> {"},{"DocComment":"     fn from(w: Wrapper<T>) -> Vec<T> {"},{"DocComment":"         w.0"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":" This will fail to compile in older versions of the language because Rust's orphaning rules"},{"DocComment":" used to be a little bit more strict. To bypass this, you could implement [`Into`] directly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Wrapper<T>(Vec<T>);"},{"DocComment":" impl<T> Into<Vec<T>> for Wrapper<T> {"},{"DocComment":"     fn into(self) -> Vec<T> {"},{"DocComment":"         self.0"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It is important to understand that [`Into`] does not provide a [`From`] implementation"},{"DocComment":" (as [`From`] does with [`Into`]). Therefore, you should always try to implement [`From`]"},{"DocComment":" and then fall back to [`Into`] if [`From`] can't be implemented."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" [`String`] implements [`Into`]`<`[`Vec`]`<`[`u8`]`>>`:"},{"DocComment":""},{"DocComment":" In order to express that we want a generic function to take all arguments that can be"},{"DocComment":" converted to a specified type `T`, we can use a trait bound of [`Into`]`<T>`."},{"DocComment":" For example: The function `is_hello` takes all arguments that can be converted into a"},{"DocComment":" [`Vec`]`<`[`u8`]`>`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn is_hello<T: Into<Vec<u8>>>(s: T) {"},{"DocComment":"    let bytes = b\"hello\".to_vec();"},{"DocComment":"    assert_eq!(bytes, s.into());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let s = \"hello\".to_string();"},{"DocComment":" is_hello(s);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`Vec`]: ../../std/vec/struct.Vec.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Into"},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"into","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["Into",0]},{"Ident":["into",0]}],"span":{"Untagged":{"data":{"file_id":35,"beg":{"line":456,"col":4},"end":{"line":456,"col":23}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts this type into the (usually inferred) input type."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":34}],"output":{"Deduplicated":41}},"default":null},"kind":{"TraitMethod":[24,0]}}],"vtable":null},{"def_id":25,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]}],"span":{"Untagged":{"data":{"file_id":25,"beg":{"line":1053,"col":0},"end":{"line":1053,"col":29}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `?` formatting."},{"DocComment":""},{"DocComment":" `Debug` should format the output in a programmer-facing, debugging context."},{"DocComment":""},{"DocComment":" Generally speaking, you should just `derive` a `Debug` implementation."},{"DocComment":""},{"DocComment":" When used with the alternate format specifier `#?`, the output is pretty-printed."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]` if all fields implement `Debug`. When"},{"DocComment":" `derive`d for structs, it will use the name of the `struct`, then `{`, then a"},{"DocComment":" comma-separated list of each field's name and `Debug` value, then `}`. For"},{"DocComment":" `enum`s, it will use the name of the variant and, if applicable, `(`, then the"},{"DocComment":" `Debug` values of the fields, then `)`."},{"DocComment":""},{"DocComment":" # Stability"},{"DocComment":""},{"DocComment":" Derived `Debug` formats are not stable, and so may change with future Rust"},{"DocComment":" versions. Additionally, `Debug` implementations of types provided by the"},{"DocComment":" standard library (`std`, `core`, `alloc`, etc.) are not stable, and"},{"DocComment":" may also change with future Rust versions."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Deriving an implementation:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Manually implementing:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_struct(\"Point\")"},{"DocComment":"          .field(\"x\", &self.x)"},{"DocComment":"          .field(\"y\", &self.y)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are a number of helper methods on the [`Formatter`] struct to help you with manual"},{"DocComment":" implementations, such as [`debug_struct`]."},{"DocComment":""},{"DocComment":" [`debug_struct`]: Formatter::debug_struct"},{"DocComment":""},{"DocComment":" Types that do not wish to use the standard suite of debug representations"},{"DocComment":" provided by the `Formatter` trait (`debug_struct`, `debug_tuple`,"},{"DocComment":" `debug_list`, `debug_set`, `debug_map`) can do something totally custom by"},{"DocComment":" manually writing an arbitrary representation to the `Formatter`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use std::fmt;"},{"DocComment":" # struct Point {"},{"DocComment":" #     x: i32,"},{"DocComment":" #     y: i32,"},{"DocComment":" # }"},{"DocComment":" #"},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Point [{} {}]\", self.x, self.y)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Debug` implementations using either `derive` or the debug builder API"},{"DocComment":" on [`Formatter`] support pretty-printing using the alternate flag: `{:#?}`."},{"DocComment":""},{"DocComment":" Pretty-printing with `#?`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" let expected = \"The origin is: Point {"},{"DocComment":"     x: 0,"},{"DocComment":"     y: 0,"},{"DocComment":" }\";"},{"DocComment":" assert_eq!(format!(\"The origin is: {origin:#?}\"), expected);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Debug"},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]},{"Ident":["fmt",0]}],"span":{"Untagged":{"data":{"file_id":25,"beg":{"line":1084,"col":4},"end":{"line":1084,"col":51}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Position {"},{"DocComment":"     longitude: f32,"},{"DocComment":"     latitude: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Position {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_tuple(\"\")"},{"DocComment":"          .field(&self.longitude)"},{"DocComment":"          .field(&self.latitude)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let position = Position { longitude: 1.987, latitude: 2.983 };"},{"DocComment":" assert_eq!(format!(\"{position:?}\"), \"(1.987, 2.983)\");"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"{position:#?}\"), \"("},{"DocComment":"     1.987,"},{"DocComment":"     2.983,"},{"DocComment":" )\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":77},{"Deduplicated":668}],"output":{"Deduplicated":366}},"default":null},"kind":{"TraitMethod":[25,0]}}],"vtable":{"id":76,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":26,"item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["DeserializeSeed",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":803,"col":0},"end":{"line":803,"col":37}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `DeserializeSeed` is the stateful form of the `Deserialize` trait. If you"},{"DocComment":" ever find yourself looking for a way to pass data into a `Deserialize` impl,"},{"DocComment":" this trait is the way to do it."},{"DocComment":""},{"DocComment":" As one example of stateful deserialization consider deserializing a JSON"},{"DocComment":" array into an existing buffer. Using the `Deserialize` trait we could"},{"DocComment":" deserialize a JSON array into a `Vec<T>` but it would be a freshly allocated"},{"DocComment":" `Vec<T>`; there is no way for `Deserialize` to reuse a previously allocated"},{"DocComment":" buffer. Using `DeserializeSeed` instead makes this possible as in the"},{"DocComment":" example code below."},{"DocComment":""},{"DocComment":" The canonical API for stateless deserialization looks like this:"},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" # use serde::Deserialize;"},{"DocComment":" #"},{"DocComment":" # enum Error {}"},{"DocComment":" #"},{"DocComment":" fn func<'de, T: Deserialize<'de>>() -> Result<T, Error>"},{"DocComment":" # {"},{"DocComment":" #     unimplemented!()"},{"DocComment":" # }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Adjusting an API like this to support stateful deserialization is a matter"},{"DocComment":" of accepting a seed as input:"},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" # use serde::de::DeserializeSeed;"},{"DocComment":" #"},{"DocComment":" # enum Error {}"},{"DocComment":" #"},{"DocComment":" fn func_seed<'de, T: DeserializeSeed<'de>>(seed: T) -> Result<T::Value, Error>"},{"DocComment":" # {"},{"DocComment":" #     let _ = seed;"},{"DocComment":" #     unimplemented!()"},{"DocComment":" # }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In practice the majority of deserialization is stateless. An API expecting a"},{"DocComment":" seed can be appeased by passing `std::marker::PhantomData` as a seed in the"},{"DocComment":" case of stateless deserialization."},{"DocComment":""},{"DocComment":" # Lifetime"},{"DocComment":""},{"DocComment":" The `'de` lifetime of this trait is the lifetime of data that may be"},{"DocComment":" borrowed by `Self::Value` when deserialized. See the page [Understanding"},{"DocComment":" deserializer lifetimes] for a more detailed explanation of these lifetimes."},{"DocComment":""},{"DocComment":" [Understanding deserializer lifetimes]: https://serde.rs/lifetimes.html"},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" Suppose we have JSON that looks like `[[1, 2], [3, 4, 5], [6]]` and we need"},{"DocComment":" to deserialize it into a flat representation like `vec![1, 2, 3, 4, 5, 6]`."},{"DocComment":" Allocating a brand new `Vec<T>` for each subarray would be slow. Instead we"},{"DocComment":" would like to allocate a single `Vec<T>` and then deserialize each subarray"},{"DocComment":" into it. This requires stateful deserialization using the `DeserializeSeed`"},{"DocComment":" trait."},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" use serde::de::{Deserialize, DeserializeSeed, Deserializer, SeqAccess, Visitor};"},{"DocComment":" use std::fmt;"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":""},{"DocComment":" // A DeserializeSeed implementation that uses stateful deserialization to"},{"DocComment":" // append array elements onto the end of an existing vector. The preexisting"},{"DocComment":" // state (\"seed\") in this case is the Vec<T>. The `deserialize` method of"},{"DocComment":" // `ExtendVec` will be traversing the inner arrays of the JSON input and"},{"DocComment":" // appending each integer into the existing Vec."},{"DocComment":" struct ExtendVec<'a, T: 'a>(&'a mut Vec<T>);"},{"DocComment":""},{"DocComment":" impl<'de, 'a, T> DeserializeSeed<'de> for ExtendVec<'a, T>"},{"DocComment":" where"},{"DocComment":"     T: Deserialize<'de>,"},{"DocComment":" {"},{"DocComment":"     // The return type of the `deserialize` method. This implementation"},{"DocComment":"     // appends onto an existing vector but does not create any new data"},{"DocComment":"     // structure, so the return type is ()."},{"DocComment":"     type Value = ();"},{"DocComment":""},{"DocComment":"     fn deserialize<D>(self, deserializer: D) -> Result<Self::Value, D::Error>"},{"DocComment":"     where"},{"DocComment":"         D: Deserializer<'de>,"},{"DocComment":"     {"},{"DocComment":"         // Visitor implementation that will walk an inner array of the JSON"},{"DocComment":"         // input."},{"DocComment":"         struct ExtendVecVisitor<'a, T: 'a>(&'a mut Vec<T>);"},{"DocComment":""},{"DocComment":"         impl<'de, 'a, T> Visitor<'de> for ExtendVecVisitor<'a, T>"},{"DocComment":"         where"},{"DocComment":"             T: Deserialize<'de>,"},{"DocComment":"         {"},{"DocComment":"             type Value = ();"},{"DocComment":""},{"DocComment":"             fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {"},{"DocComment":"                 write!(formatter, \"an array of integers\")"},{"DocComment":"             }"},{"DocComment":""},{"DocComment":"             fn visit_seq<A>(self, mut seq: A) -> Result<(), A::Error>"},{"DocComment":"             where"},{"DocComment":"                 A: SeqAccess<'de>,"},{"DocComment":"             {"},{"DocComment":"                 // Decrease the number of reallocations if there are many elements"},{"DocComment":"                 if let Some(size_hint) = seq.size_hint() {"},{"DocComment":"                     self.0.reserve(size_hint);"},{"DocComment":"                 }"},{"DocComment":""},{"DocComment":"                 // Visit each element in the inner array and push it onto"},{"DocComment":"                 // the existing vector."},{"DocComment":"                 while let Some(elem) = seq.next_element()? {"},{"DocComment":"                     self.0.push(elem);"},{"DocComment":"                 }"},{"DocComment":"                 Ok(())"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":""},{"DocComment":"         deserializer.deserialize_seq(ExtendVecVisitor(self.0))"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Visitor implementation that will walk the outer array of the JSON input."},{"DocComment":" struct FlattenedVecVisitor<T>(PhantomData<T>);"},{"DocComment":""},{"DocComment":" impl<'de, T> Visitor<'de> for FlattenedVecVisitor<T>"},{"DocComment":" where"},{"DocComment":"     T: Deserialize<'de>,"},{"DocComment":" {"},{"DocComment":"     // This Visitor constructs a single Vec<T> to hold the flattened"},{"DocComment":"     // contents of the inner arrays."},{"DocComment":"     type Value = Vec<T>;"},{"DocComment":""},{"DocComment":"     fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {"},{"DocComment":"         write!(formatter, \"an array of arrays\")"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     fn visit_seq<A>(self, mut seq: A) -> Result<Vec<T>, A::Error>"},{"DocComment":"     where"},{"DocComment":"         A: SeqAccess<'de>,"},{"DocComment":"     {"},{"DocComment":"         // Create a single Vec to hold the flattened contents."},{"DocComment":"         let mut vec = Vec::new();"},{"DocComment":""},{"DocComment":"         // Each iteration through this loop is one inner array."},{"DocComment":"         while let Some(()) = seq.next_element_seed(ExtendVec(&mut vec))? {"},{"DocComment":"             // Nothing to do; inner array has been appended into `vec`."},{"DocComment":"         }"},{"DocComment":""},{"DocComment":"         // Return the finished vec."},{"DocComment":"         Ok(vec)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" # fn example<'de, D>(deserializer: D) -> Result<(), D::Error>"},{"DocComment":" # where"},{"DocComment":" #     D: Deserializer<'de>,"},{"DocComment":" # {"},{"DocComment":" let visitor = FlattenedVecVisitor(PhantomData);"},{"DocComment":" let flattened: Vec<u64> = deserializer.deserialize_seq(visitor)?;"},{"DocComment":" #     Ok(())"},{"DocComment":" # }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[{"index":0,"name":"'de","variance":"Unknown","mutability":"Unknown"}],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Value","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[{"index":0,"name":"D","variance":"Invariant"},{"index":1,"name":"Clause0_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[1723,{"data":{"file_id":5,"beg":{"line":811,"col":11},"end":{"line":811,"col":28}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":5},{"Deduplicated":6}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"deserialize","item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["DeserializeSeed",0]},{"Ident":["deserialize",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":809,"col":4},"end":{"line":811,"col":29}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Equivalent to the more common `Deserialize::deserialize` method, except"},{"DocComment":" with some initial piece of data (the seed) passed in."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":34},{"Deduplicated":2}],"output":{"Value":[682,{"Adt":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":41},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":null},"kind":{"TraitMethod":[26,0]}}],"vtable":null},{"def_id":27,"item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["VariantAccess",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":2088,"col":0},"end":{"line":2088,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `VariantAccess` is a visitor that is created by the `Deserializer` and"},{"DocComment":" passed to the `Deserialize` to deserialize the content of a particular enum"},{"DocComment":" variant."},{"DocComment":""},{"DocComment":" # Lifetime"},{"DocComment":""},{"DocComment":" The `'de` lifetime of this trait is the lifetime of data that may be"},{"DocComment":" borrowed by the deserialized enum variant. See the page [Understanding"},{"DocComment":" deserializer lifetimes] for a more detailed explanation of these lifetimes."},{"DocComment":""},{"DocComment":" [Understanding deserializer lifetimes]: https://serde.rs/lifetimes.html"},{"DocComment":""},{"DocComment":" # Example implementation"},{"DocComment":""},{"DocComment":" The [example data format] presented on the website demonstrates an"},{"DocComment":" implementation of `VariantAccess` for a basic JSON data format."},{"DocComment":""},{"DocComment":" [example data format]: https://serde.rs/data-format.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[{"index":0,"name":"'de","variance":"Unknown","mutability":"Unknown"}],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[1724,{"data":{"file_id":5,"beg":{"line":2091,"col":16},"end":{"line":2091,"col":21}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":41}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"unit_variant","item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["VariantAccess",0]},{"Ident":["unit_variant",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":2128,"col":4},"end":{"line":2128,"col":53}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Called when deserializing a variant with no values."},{"DocComment":""},{"DocComment":" If the data contains a different type of variant, the following"},{"DocComment":" `invalid_type` error should be constructed:"},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" # use serde::de::{self, value, DeserializeSeed, Visitor, VariantAccess, Unexpected};"},{"DocComment":" #"},{"DocComment":" # struct X;"},{"DocComment":" #"},{"DocComment":" # impl<'de> VariantAccess<'de> for X {"},{"DocComment":" #     type Error = value::Error;"},{"DocComment":" #"},{"DocComment":" fn unit_variant(self) -> Result<(), Self::Error> {"},{"DocComment":"     // What the data actually contained; suppose it is a tuple variant."},{"DocComment":"     let unexp = Unexpected::TupleVariant;"},{"DocComment":"     Err(de::Error::invalid_type(unexp, &\"unit variant\"))"},{"DocComment":" }"},{"DocComment":" #"},{"DocComment":" #     fn newtype_variant_seed<T>(self, _: T) -> Result<T::Value, Self::Error>"},{"DocComment":" #     where"},{"DocComment":" #         T: DeserializeSeed<'de>,"},{"DocComment":" #     { unimplemented!() }"},{"DocComment":" #"},{"DocComment":" #     fn tuple_variant<V>(self, _: usize, _: V) -> Result<V::Value, Self::Error>"},{"DocComment":" #     where"},{"DocComment":" #         V: Visitor<'de>,"},{"DocComment":" #     { unimplemented!() }"},{"DocComment":" #"},{"DocComment":" #     fn struct_variant<V>(self, _: &[&str], _: V) -> Result<V::Value, Self::Error>"},{"DocComment":" #     where"},{"DocComment":" #         V: Visitor<'de>,"},{"DocComment":" #     { unimplemented!() }"},{"DocComment":" # }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Ru