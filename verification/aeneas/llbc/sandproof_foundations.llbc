ces> {\n    left.checked_add(right)\n}\n\npub fn resource_positive(value: Resources) -> bool {\n    value.positive()\n}\n\npub fn resource_fits(value: Resources, limit: Resources) -> bool {\n    value.fits(limit)\n}\n\npub fn create_binding_valid(value: &CreateBinding) -> bool {\n    value.is_valid()\n}\n\npub fn identity_response(\n    actual: &ControlIdentity,\n    expected: &ControlIdentity,\n) -> Result<(), InternalError> {\n    actual.validate_response(expected)\n}\n\npub fn retry_hint(outcome: &WorkOutcome<u64>) -> bool {\n    outcome.permits_new_attempt()\n}\n\npub fn outcome_observation(outcome: &WorkOutcome<u64>) -> Option<&u64> {\n    outcome.observation()\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Virtual":"./sandbox-protocol/src/internal.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":11,"name":{"Virtual":"./sandbox-protocol/src/lib.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":12,"name":{"Virtual":"./sandbox-center-core/src/model.rs"},"crate_name":"sandproof_center_core","contents":null},{"id":13,"name":{"Virtual":"./sandbox-center-core/src/lib.rs"},"crate_name":