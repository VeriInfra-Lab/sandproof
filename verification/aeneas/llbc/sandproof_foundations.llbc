:false,"inputs":[{"Deduplicated":34},{"Value":[671,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":27},"Shared"]}]}],"output":{"Deduplicated":670}},"default":{"id":12,"generics":{"regions":[{"Var":{"Free":0}},{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":34},{"Deduplicated":2},{"Deduplicated":41}],"const_generics":[],"trait_refs":[{"Deduplicated":92},{"Deduplicated":93}]}}},"kind":{"TraitMethod":[6,15]}},{"params":{"regions":[],"types":[{"index":0,"name":"E","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":13},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":5}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"visit_borrowed_str","item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["Visitor",0]},{"Ident":["visit_borrowed_str",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":1543,"col":4},"end":{"line":1545,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The input contains a string that lives at least as long as the"},{"DocComment":" `Deserializer`."},{"DocComment":""},{"DocComment":" This enables zero-copy deserialization of strings in some formats. For"},{"DocComment":" example JSON input containing the JSON string `\"borrowed\"` can be"},{"DocComment":" deserialized with zero copying into a `&'a str` as long as the input"},{"DocComment":" data outlives `'a`."},{"DocComment":""},{"DocComment":" The default implementation forwards to `visit_str`."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":34},{"Deduplicated":38}],"output":{"Deduplicated":670}},"default":{"id":14,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":34},{"Deduplicated":2},{"Deduplicated":41}],"const_generics":[],"trait_refs":[{"Deduplicated":92},{"Deduplicated":93}]}}},"kind":{"TraitMethod":[6,16]}},{"params":{"regions":[],"types":[{"index":0,"name":"E","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":12},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":5}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"visit_string","item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["Visitor",0]},{"Ident":["visit_string",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":1568,"col":4},"end":{"line":1570,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The input contains a string and ownership of the string is being given"},{"DocComment":" to the `Visitor`."},{"DocComment":""},{"DocComment":" This method allows the `Visitor` to avoid a copy by taking ownership of"},{"DocComment":" a string created by the `Deserializer`. `Deserialize` implementations"},{"DocComment":" that benefit from taking ownership of `String` data should indicate that"},{"DocComment":" to the deserializer by using `Deserializer::deserialize_string` rather"},{"DocComment":" than `Deserializer::deserialize_str`, although not every deserializer"},{"DocComment":" will honor such a request."},{"DocComment":""},{"DocComment":" It is never correct to implement `visit_string` without implementing"},{"DocComment":" `visit_str`. Implement neither, both, or just `visit_str`."},{"DocComment":""},{"DocComment":" The default implementation forwards to `visit_str` and then drops the"},{"DocComment":" `String`."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":34},{"Deduplicated":42}],"output":{"Deduplicated":670}},"default":{"id":13,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":34},{"Deduplicated":2},{"Deduplicated":41}],"const_generics":[],"trait_refs":[{"Deduplicated":92},{"Deduplicated":93}]}}},"kind":{"TraitMethod":[6,17]}},null,null,null,null,null,null,null,null,null,null,null],"vtable":null},{"def_id":7,"item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["Deserializer",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":945,"col":0},"end":{"line":945,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A **data format** that can deserialize any data structure supported by"},{"DocComment":" Serde."},{"DocComment":""},{"DocComment":" The role of this trait is to define the deserialization half of the [Serde"},{"DocComment":" data model], which is a way to categorize every Rust data type into one of"},{"DocComment":" 29 possible types. Each method of the `Deserializer` trait corresponds to one"},{"DocComment":" of the types of the data model."},{"DocComment":""},{"DocComment":" Implementations of `Deserialize` map themselves into this data model by"},{"DocComment":" passing to the `Deserializer` a `Visitor` implementation that can receive"},{"DocComment":" these various types."},{"DocComment":""},{"DocComment":" The types that make up the Serde data model are:"},{"DocComment":""},{"DocComment":"  - **14 primitive types**"},{"DocComment":"    - bool"},{"DocComment":"    - i8, i16, i32, i64, i128"},{"DocComment":"    - u8, u16, u32, u64, u128"},{"DocComment":"    - f32, f64"},{"DocComment":"    - char"},{"DocComment":"  - **string**"},{"DocComment":"    - UTF-8 bytes with a length and no null terminator."},{"DocComment":"    - When serializing, all strings are handled equally. When deserializing,"},{"DocComment":"      there are three flavors of strings: transient, owned, and borrowed."},{"DocComment":"  - **byte array** - \\[u8\\]"},{"DocComment":"    - Similar to strings, during deserialization byte arrays can be"},{"DocComment":"      transient, owned, or borrowed."},{"DocComment":"  - **option**"},{"DocComment":"    - Either none or some value."},{"DocComment":"  - **unit**"},{"DocComment":"    - The type of `()` in Rust. It represents an anonymous value containing"},{"DocComment":"      no data."},{"DocComment":"  - **unit_struct**"},{"DocComment":"    - For example `struct Unit` or `PhantomData<T>`. It represents a named"},{"DocComment":"      value containing no data."},{"DocComment":"  - **unit_variant**"},{"DocComment":"    - For example the `E::A` and `E::B` in `enum E { A, B }`."},{"DocComment":"  - **newtype_struct**"},{"DocComment":"    - For example `struct Millimeters(u8)`."},{"DocComment":"  - **newtype_variant**"},{"DocComment":"    - For example the `E::N` in `enum E { N(u8) }`."},{"DocComment":"  - **seq**"},{"DocComment":"    - A variably sized heterogeneous sequence of values, for example `Vec<T>`"},{"DocComment":"      or `HashSet<T>`. When serializing, the length may or may not be known"},{"DocComment":"      before iterating through all the data. When deserializing, the length"},{"DocComment":"      is determined by looking at the serialized data."},{"DocComment":"  - **tuple**"},{"DocComment":"    - A statically sized heterogeneous sequence of values for which the"},{"DocComment":"      length will be known at deserialization time without looking at the"},{"DocComment":"      serialized data, for example `(u8,)` or `(String, u64, Vec<T>)` or"},{"DocComment":"      `[u64; 10]`."},{"DocComment":"  - **tuple_struct**"},{"DocComment":"    - A named tuple, for example `struct Rgb(u8, u8, u8)`."},{"DocComment":"  - **tuple_variant**"},{"DocComment":"    - For example the `E::T` in `enum E { T(u8, u8) }`."},{"DocComment":"  - **map**"},{"DocComment":"    - A heterogeneous key-value pairing, for example `BTreeMap<K, V>`."},{"DocComment":"  - **struct**"},{"DocComment":"    - A heterogeneous key-value pairing in which the keys are strings and"},{"DocComment":"      will be known at deserialization time without looking at the serialized"},{"DocComment":"      data, for example `struct S { r: u8, g: u8, b: u8 }`."},{"DocComment":"  - **struct_variant**"},{"DocComment":"    - For example the `E::S` in `enum E { S { r: u8, g: u8, b: u8 } }`."},{"DocComment":""},{"DocComment":" The `Deserializer` trait supports two entry point styles which enables"},{"DocComment":" different kinds of deserialization."},{"DocComment":""},{"DocComment":" 1. The `deserialize_any` method. Self-describing data formats like JSON are"},{"DocComment":"    able to look at the serialized data and tell what it represents. For"},{"DocComment":"    example the JSON deserializer may see an opening curly brace (`{`) and"},{"DocComment":"    know that it is seeing a map. If the data format supports"},{"DocComment":"    `Deserializer::deserialize_any`, it will drive the Visitor using whatever"},{"DocComment":"    type it sees in the input. JSON uses this approach when deserializing"},{"DocComment":"    `serde_json::Value` which is an enum that can represent any JSON"},{"DocComment":"    document. Without knowing what is in a JSON document, we can deserialize"},{"DocComment":"    it to `serde_json::Value` by going through"},{"DocComment":"    `Deserializer::deserialize_any`."},{"DocComment":""},{"DocComment":" 2. The various `deserialize_*` methods. Non-self-describing formats like"},{"DocComment":"    Postcard need to be told what is in the input in order to deserialize it."},{"DocComment":"    The `deserialize_*` methods are hints to the deserializer for how to"},{"DocComment":"    interpret the next piece of input. Non-self-describing formats are not"},{"DocComment":"    able to deserialize something like `serde_json::Value` which relies on"},{"DocComment":"    `Deserializer::deserialize_any`."},{"DocComment":""},{"DocComment":" When implementing `Deserialize`, you should avoid relying on"},{"DocComment":" `Deserializer::deserialize_any` unless you need to be told by the"},{"DocComment":" Deserializer what type is in the input. Know that relying on"},{"DocComment":" `Deserializer::deserialize_any` means your data type will be able to"},{"DocComment":" deserialize from self-describing formats only, ruling out Postcard and many"},{"DocComment":" others."},{"DocComment":""},{"DocComment":" [Serde data model]: https://serde.rs/data-model.html"},{"DocComment":""},{"DocComment":" # Lifetime"},{"DocComment":""},{"DocComment":" The `'de` lifetime of this trait is the lifetime of data that may be"},{"DocComment":" borrowed from the input when deserializing. See the page [Understanding"},{"DocComment":" deserializer lifetimes] for a more detailed explanation of these lifetimes."},{"DocComment":""},{"DocComment":" [Understanding deserializer lifetimes]: https://serde.rs/lifetimes.html"},{"DocComment":""},{"DocComment":" # Example implementation"},{"DocComment":""},{"DocComment":" The [example data format] presented on the website contains example code for"},{"DocComment":" a basic JSON `Deserializer`."},{"DocComment":""},{"DocComment":" [example data format]: https://serde.rs/data-format.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[{"index":0,"name":"'de","variance":"Unknown","mutability":"Unknown"}],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[1680,{"data":{"file_id":5,"beg":{"line":948,"col":16},"end":{"line":948,"col":21}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"skip_binder":{"id":4