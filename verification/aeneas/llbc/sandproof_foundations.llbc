ssage should be a noun or noun phrase that completes the sentence \"This"},{"DocComment":" Visitor expects to receive ...\", for example the message could be \"an"},{"DocComment":" integer between 0 and 64\". The message should not be capitalized and should"},{"DocComment":" not end with a period."},{"DocComment":""},{"DocComment":" Within the context of a `Visitor` implementation, the `Visitor` itself"},{"DocComment":" (`&self`) is an implementation of this trait."},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" # use serde::de::{self, Unexpected, Visitor};"},{"DocComment":" # use std::fmt;"},{"DocComment":" #"},{"DocComment":" # struct Example;"},{"DocComment":" #"},{"DocComment":" # impl<'de> Visitor<'de> for Example {"},{"DocComment":" #     type Value = ();"},{"DocComment":" #"},{"DocComment":" #     fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {"},{"DocComment":" #         write!(formatter, \"definitely not a boolean\")"},{"DocComment":" #     }"},{"DocComment":" #"},{"DocComment":" fn visit_bool<E>(self, v: bool) -> Result<Self::Value, E>"},{"DocComment":" where"},{"DocComment":"     E: de::Error,"},{"DocComment":" {"},{"DocComment":"     Err(de::Error::invalid_type(Unexpected::Bool(v), &self))"},{"DocComment":" }"},{"DocComment":" # }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Outside of a `Visitor`, `&\"...\"` can be used."},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" # use serde::de::{self, Unexpected};"},{"DocComment":" #"},{"DocComment":" # fn example<E>() -> Result<(), E>"},{"DocComment":" # where"},{"DocComment":" #     E: de::Error,"},{"DocComment":" # {"},{"DocComment":" #     let v = true;"},{"DocComment":" return Err(de::Error::invalid_type("},{"DocComment":"     Unexpected::Bool(v),"},{"DocComment":"     &\"a negative integer\","},{"DocComment":" ));"},{"DocComment":" # }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Fo