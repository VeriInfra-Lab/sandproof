{"charon_version":"0.1.254","translated":{"crate_name":"sandproof_controller_service","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::application::diagnostics::_::get_mut"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["sandproof_controller_service"],"opaque":["std::sync","tokio","rustix"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"verification/aeneas/llbc/sandproof_std_mutex.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":true,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"controller-service/src/lib.rs"},"crate_name":"sandproof_controller_service","contents":"#![forbid(unsafe_code)]\n\n//! Single-node durable journal and post-commit dispatch boundary.\n//!\n//! `ControllerJournal` delegates lifecycle decisions to the existing pure\n//! core and atomically persists accepted inputs, projections, and actions.\n//! The lower-level `Journal` remains an opaque persistence primitive, not a\n//! second production writer. Physical host claims require a trusted adapter.\n\n#[cfg(test)]\nextern crate self as sandproof_controller_service;\n\npub mod application;\npub use application::BuildWindow;\n#[cfg(feature = \"durable\")]\nmod controller;\n#[cfg(feature = \"durable\")]\nmod dispatch;\nmod host_contract;\n#[cfg(feature = \"durable\")]\nmod journal;\npub mod physical_storage;\npub mod template_registry;\npub mod templates;\n#[cfg(feature = \"durable\")]\nmod workflow;\n\npub use host_contract::{\n    AdmissionError, AdmissionLimits, BoundedHostConfig, ConsolePolicy, CreateNetwork,\n    CreateNetworking, CreateOptions, DEFAULT_STARTUP_TIMEOUT_SECS, DEFAULT_TIMEOUT_SECS,\n    HostEvidence, HostSlotContext, WorkerTransportError,\n};\n\n/// Current original host metadata format when the authenticated inbox is\n/// explicitly provisioned. Older experimental formats are refused, not upgraded.\npub const INTERNAL_INBOX_FORMAT_VERSION: i64 =\n    sandproof_protocol::internal::HOST_STORE_FORMAT_VERSION;\n\n#[cfg(feature = \"durable\")]\npub use controller::{\n    BuildAnchor, BuildRetryConfig, CapacityConfig, CheckpointInfo, CheckpointProgress,\n    ControllerJournal, CreateAdmission, HostReleaseWitness, InternalAdmission, InternalAudit,\n    InternalAuditOperation, InternalCreateResult, InternalInboxConfig, InternalLocalBinding,\n    InternalNativeAudit, InternalRetentionLane, InternalTemplate, InternalWorkState, Lifetime,\n    MaintenanceConfig, RetirementCandidate,\n};\n\n#[cfg(feature = \"durable\")]\npub use dispatch::DispatchResult;\n#[cfg(feature = \"durable\")]\npub use journal::{\n    AcceptedWrite, DispatchState, Journal, RecordedReceipt, StorageSettings, StoredOperation,\n    StoredSandbox,\n};\n#[cfg(feature = \"durable\")]\npub use workflow::{\n    finish_accepted_kill_v1, finish_admitted_create_v1, finish_admitted_create_v1_timed,\n    finish_compensating_create_v1, kill_v1,\n};\n\n#[cfg(feature = \"durable\")]\nuse rusqlite::Error as SqliteError;\nuse sandproof_protocol::ContractError;\nuse std::error::Error;\nuse std::fmt::{self, Display};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CrashPoint {\n    BeforeCommit,\n    AfterCommit,\n    BeforeDispatchClaim,\n    AfterDispatchClaim,\n    AfterWorkerCall,\n    AfterRetirementDelete,\n}\n\n/// Tests inject a process stop at a named boundary. Production uses `NeverCrash`.\npub trait CrashInjector {\n    /// # Errors\n    /// Returns `JournalError::InjectedCrash` when the selected point is hit.\n    fn hit(&mut self, point: CrashPoint) -> Result<(), JournalError>;\n}\n\npub struct NeverCrash;\n\nimpl CrashInjector for NeverCrash {\n    fn hit(&mut self, _point: CrashPoint) -> Result<(), JournalError> {\n        Ok(())\n    }\n}\n\n#[derive(Debug)]\npub enum JournalError {\n    Io(std::io::Error),\n    #[cfg(feature = \"durable\")]\n    Sqlite(SqliteError),\n    #[cfg(feature = \"durable\")]\n    CommitUncertain(SqliteError),\n    Json(serde_json::Error),\n    Contract(ContractError),\n    Conflict,\n    IdentifierExhausted,\n    MaintenanceCapacity,\n    RevisionConflict,\n    ReceiptBeforeDispatch,\n    ConflictingReceipt,\n    UnsupportedStore,\n    CorruptStore,\n    CredentialIndexPoisoned,\n    InjectedCrash(CrashPoint),\n    ControllerRejected(sandbox_controller_core::controller::ControllerReject),\n    ControllerBusy,\n    UnsupportedInput,\n    UnresolvedAction,\n    OperationFailed,\n    InvalidHostEvidence,\n    ObsoleteReceipt,\n}\n\nimpl JournalError {\n    /// A rejected observation or transition belongs to one sandbox. Durable\n    /// storage, replay, and commit errors are deliberately not in this list:\n    /// their scope cannot be established, so recovery must stop globally.\n    #[must_use]\n    pub fn is_local_recovery_failure(&self) -> bool {\n        matches!(\n            self,\n            Self::Contract(_)\n                | Self::ReceiptBeforeDispatch\n                | Self::ConflictingReceipt\n                | Self::ControllerRejected(_)\n                | Self::UnsupportedInput\n                | Self::UnresolvedAction\n                | Self::OperationFailed\n                | Self::InvalidHostEvidence\n                | Self::ObsoleteReceipt\n        )\n    }\n}\n\nimpl Display for JournalError {\n    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n        match self {\n            Self::MaintenanceCapacity => {\n                formatter.write_str(\"configured maintenance capacity exhausted\")\n            }\n            Self::IdentifierExhausted => {\n                formatter.write_str(\"controller identifier space exhausted\")\n            }\n            Self::Io(error) => write!(formatter, \"controller filesystem error: {error}\"),\n            #[cfg(feature = \"durable\")]\n            Self::Sqlite(error) => write!(formatter, \"sqlite journal error: {error}\"),\n            #[cfg(feature = \"durable\")]\n            Self::CommitUncertain(error) => {\n                write!(\n                    formatter,\n                    \"sqlite commit outcome must be reconciled: {error}\"\n                )\n            }\n            Self::Json(error) => write!(formatter, \"journal message error: {error}\"),\n            Self::Contract(error) => write!(formatter, \"protocol contract error: {error}\"),\n            Self::Conflict => formatter.write_str(\"journal identity conflict\"),\n            Self::RevisionConflict => formatter.write_str(\"sandbox revision conflict\"),\n            Self::ReceiptBeforeDispatch => formatter.write_str(\"receipt before dispatch claim\"),\n            Self::ConflictingReceipt => formatter.write_str(\"conflicting receipt for one attempt\"),\n            Self::UnsupportedStore => formatter.write_str(\"unsupported sqlite journal format\"),\n            Self::CorruptStore => formatter.write_str(\"corrupt sqlite journal record\"),\n            Self::CredentialIndexPoisoned => {\n                formatter.write_str(\"data credential index is poisoned\")\n            }\n            Self::InjectedCrash(point) => write!(formatter, \"injected crash at {point:?}\"),\n            Self::ControllerRejected(reason) => {\n                write!(formatter, \"controller rejected: {reason:?}\")\n            }\n            Self::ControllerBusy => formatter.write_str(\"another controller owns this database\"),\n            Self::UnsupportedInput => {\n                formatter.write_str(\"input is not supported at this service boundary\")\n            }\n            Self::OperationFailed => {\n                formatter.write_str(\"accepted operation failed and was compensated\")\n            }\n            Self::UnresolvedAction => {\n                formatter.write_str(\"an earlier worker action must be reconciled first\")\n            }\n            Self::InvalidHostEvidence => {\n                formatter.write_str(\"host evidence does not establish this command result\")\n            }\n            Self::ObsoleteReceipt => {\n                formatter.write_str(\"terminal operation no longer accepts this activation receipt\")\n            }\n        }\n    }\n}\n\nimpl Error for JournalError {\n    fn source(&self) -> Option<&(dyn Error + 'static)> {\n        match self {\n            Self::Io(error) => Some(error),\n            #[cfg(feature = \"durable\")]\n            Self::Sqlite(error) | Self::CommitUncertain(error) => Some(error),\n            Self::Json(error) => Some(error),\n            Self::Contract(error) => Some(error),\n            _ => None,\n        }\n    }\n}\n\nimpl From<std::io::Error> for JournalError {\n    fn from(error: std::io::Error) -> Self {\n        Self::Io(error)\n    }\n}\n\n#[cfg(feature = \"durable\")]\nimpl From<SqliteError> for JournalError {\n    fn from(error: SqliteError) -> Self {\n        Self::Sqlite(error)\n    }\n}\n\nimpl From<serde_json::Error> for JournalError {\n    fn from(error: serde_json::Error) -> Self {\n        Self::Json(error)\n    }\n}\n\nimpl From<ContractError> for JournalError {\n    fn from(error: ContractError) -> Self {\n        Self::Contract(error)\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"controller-service/src/application/diagnostics.rs"},"crate_name":"sandproof_controller_service","contents":"//! Opt-in, thread-local measurement of the existing serial boundary.\n//!\n//! No identifiers, credentials, history or user payloads are retained. This is\n//! a component diagnostic, not a telemetry service or a concurrency policy.\nuse std::{\n    cell::RefCell,\n    ops::{Deref, DerefMut},\n    sync::{Mutex, MutexGuard, PoisonError, mpsc::SyncSender},\n    time::{Duration, Instant},\n};\n\n/// Bounded totals for one synchronous call on one thread, not a histogram.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub struct LockTiming {\n    pub acquisitions: u64,\n    pub wait: Duration,\n    pub held: Duration,\n}\n\n/// Only durations and the caller's ordinary result; never a log of inputs.\npub struct Measurement<T> {\n    pub result: T,\n    pub elapsed: Duration,\n    pub lock: LockTiming,\n    pub host_calls: u64,\n    pub host_elapsed: Duration,\n}\n\nstruct Scope {\n    timing: LockTiming,\n    notice: Option<SyncSender<()>>,\n    host_calls: u64,\n    host_elapsed: Duration,\n}\nthread_local! {\n    static CURRENT: RefCell<Option<Scope>> = const { RefCell::new(None) };\n}\n\nstruct Restore(Option<Scope>);\nimpl Drop for Restore {\n    fn drop(&mut self) {\n        CURRENT.with(|current| *current.borrow_mut() = self.0.take());\n    }\n}\n\n/// Measure a synchronous call. Nested calls have separate totals; the parent\n/// still includes their elapsed time. This does not follow spawned threads.\n/// # Panics\n/// Propagates the operation's panic after restoring the prior diagnostic scope.\npub fn measure<T>(operation: impl FnOnce() -> T) -> Measurement<T> {\n    measure_with_lock_notice(None, operation)\n}\n\n/// As above, with a nonblocking, payload-free notice immediately BEFORE each\n/// lock attempt. A full/disconnected diagnostic channel cannot affect work.\n/// The notice is NOT evidence of acquisition, authorization or dispatch.\n/// # Panics\n/// Propagates the operation's panic; an internally lost scope is an invariant\n/// violation. In either case the prior diagnostic scope is restored.\npub fn measure_with_lock_notice<T>(\n    notice: Option<SyncSender<()>>,\n    operation: impl FnOnce() -> T,\n) -> Measurement<T> {\n    let _restore = Restore(CURRENT.with(|current| {\n        current.replace(Some(Scope {\n            timing: LockTiming::default(),\n            notice,\n            host_calls: 0,\n            host_elapsed: Duration::ZERO,\n        }))\n    }));\n    let started = Instant::now();\n    let result = operation();\n    let elapsed = started.elapsed();\n    let (lock, host_calls, host_elapsed) = CURRENT.with(|current| {\n        let scope = current.borrow();\n        let scope = scope.as_ref().expect(\"active measurement\");\n        (scope.timing, scope.host_calls, scope.host_elapsed)\n    });\n    Measurement {\n        result,\n        elapsed,\n        lock,\n        host_calls,\n        host_elapsed,\n    }\n}\n\n/// Time an explicitly selected synchronous host-port call. No automatic\n/// interception: consumers must state whether the backend is controlled or\n/// real. Nested host calls would double count and must not be instrumented.\npub fn host_call<T>(operation: impl FnOnce() -> T) -> T {\n    struct Sample(Instant);\n    impl Drop for Sample {\n        fn drop(&mut self) {\n            let elapsed = self.0.elapsed();\n            CURRENT.with(|current| {\n                if let Some(scope) = current.borrow_mut().as_mut() {\n                    scope.host_calls = scope.host_calls.saturating_add(1);\n                    scope.host_elapsed = scope.host_elapsed.saturating_add(elapsed);\n                }\n            });\n        }\n    }\n    let _sample = Sample(Instant::now());\n    operation()\n}\n\n/// Same mutex, same acquisition and poison error; no try-lock or second lock.\npub(super) struct SerialMutex<T>(Mutex<T>);\nimpl<T> SerialMutex<T> {\n    pub(super) fn new(value: T) -> Self {\n        Self(Mutex::new(value))\n    }\n\n    pub(super) fn get_mut(&mut self) -> std::sync::LockResult<&mut T> {\n        self.0.get_mut()\n    }\n\n    pub(super) fn lock(&self) -> Result<SerialGuard<'_, T>, PoisonError<MutexGuard<'_, T>>> {\n        let started = CURRENT.with(|current| {\n            let scope = current.borrow();\n            scope.as_ref().map(|scope| {\n                let started = Instant::now();\n                if let Some(notice) = &scope.notice {\n                    let _ = notice.try_send(());\n                }\n                started\n            })\n        });\n        let guard = self.0.lock()?;\n        let acquired = started.map(|started| (started.elapsed(), Instant::now()));\n        Ok(SerialGuard {\n            guard: Some(guard),\n            acquired,\n        })\n    }\n}\n\npub(super) struct SerialGuard<'a, T> {\n    guard: Option<MutexGuard<'a, T>>,\n    acquired: Option<(Duration, Instant)>,\n}\nimpl<T> Deref for SerialGuard<'_, T> {\n    type Target = T;\n    fn deref(&self) -> &T {\n        self.guard.as_ref().expect(\"guard is present until drop\")\n    }\n}\nimpl<T> DerefMut for SerialGuard<'_, T> {\n    fn deref_mut(&mut self) -> &mut T {\n        self.guard.as_mut().expect(\"guard is present until drop\")\n    }\n}\nimpl<T> Drop for SerialGuard<'_, T> {\n    fn drop(&mut self) {\n        let timing = self\n            .acquired\n            .map(|(wait, acquired)| (wait, acquired.elapsed()));\n        // Do not write diagnostics or notify consumers while holding Inner.\n        drop(self.guard.take());\n        if let Some((wait, held)) = timing {\n            CURRENT.with(|current| {\n                if let Some(scope) = current.borrow_mut().as_mut() {\n                    scope.timing.acquisitions = scope.timing.acquisitions.saturating_add(1);\n                    scope.timing.wait = scope.timing.wait.saturating_add(wait);\n                    scope.timing.held = scope.timing.held.saturating_add(held);\n                }\n            });\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn totals_are_bounded_isolated_and_unwinding_preserves_poison() {\n        let mutex = SerialMutex::new(0);\n        let (sender, _) = std::sync::mpsc::sync_channel(0);\n        let first = measure_with_lock_notice(Some(sender), || *mutex.lock().unwrap() += 1);\n        assert_eq!(first.lock.acquisitions, 1);\n        assert_eq!(*mutex.lock().unwrap(), 1);\n        assert_eq!(measure(|| ()).lock, LockTiming::default());\n        let nested = measure(|| measure(|| *mutex.lock().unwrap() += 1));\n        assert_eq!(nested.lock.acquisitions, 0);\n        assert_eq!(nested.result.lock.acquisitions, 1);\n        let panic = std::panic::catch_unwind(|| {\n            measure(|| {\n                let _guard = mutex.lock().unwrap();\n                panic!(\"controlled diagnostic unwind\");\n            })\n        });\n        assert!(panic.is_err());\n        assert!(mutex.lock().is_err());\n        assert_eq!(measure(|| ()).lock, LockTiming::default());\n    }\n}\n"},{"id":6,"name":{"Local":"controller-service/src/application/mod.rs"},"crate_name":"sandproof_controller_service","contents":"//! Application-owned host and data-route contracts: no SDK DTOs or Linux commands.\n//! Lifecycle preserves the original serial decision/effect boundary.\n#[cfg(feature = \"durable\")]\nmod data;\n#[cfg(feature = \"durable\")]\nmod data_drain;\npub mod fault;\n#[cfg(feature = \"host-artifacts\")]\nmod host;\n#[cfg(feature = \"durable\")]\nmod relay_child;\n#[cfg(feature = \"durable\")]\npub use data::{DataAccessPort, DataAuthorization, DataKind, DataTarget};\n#[cfg(feature = \"durable\")]\npub use data_drain::DataLease;\n#[cfg(feature = \"host-artifacts\")]\npub use host::{\n    ControllerHost, DataRelay, HostCapacity, HostSlots, LaunchConfiguration, TemplateArtifacts,\n    WorkEvidence, WorkExecution, WorkRecovery,\n};\n#[cfg(feature = \"durable\")]\npub use relay_child::{RelayReaper, TrackedRelayChild};\n\n/// Business failure categories; transports decide their HTTP representation.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ApplicationError {\n    Invalid,\n    NotFound,\n    Conflict,\n    QuotaExceeded,\n    Busy,\n    OutcomeUnknown,\n    Failed,\n}\n\nmod clock;\n#[cfg(feature = \"durable\")]\nmod coordinator;\n#[cfg(feature = \"contention-diagnostics\")]\npub mod diagnostics;\nmod listing;\nmod models;\npub use clock::{Clock, SystemClock};\n#[cfg(feature = \"durable\")]\npub use coordinator::recovery::can_install_host_slot_binding;\n#[cfg(feature = \"durable\")]\npub use coordinator::{\n    ApplicationConfig, ControllerApplication, DataPermit, ExpiryReport, MaintenanceReport,\n    RecoveryReport,\n};\npub use listing::{InstancePage, ListCursor, ListSelection, Order};\npub use models::*;\n"},{"id":7,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/std/src/sync/poison/mutex.rs"},"crate_name":"std","contents":null},{"id":12,"name":{"Local":"/rustc/library/std/src/sync/poison.rs"},"crate_name":"std","contents":null},{"id":13,"name":{"Local":"/rustc/library/std/src/sync/mod.rs"},"crate_name":"std","contents":null},{"id":14,"name":{"Local":"/rustc/library/std/src/lib.rs"},"crate_name":"std","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array":[{"Value":[2,{"TypeVar":{"Bound":[0,0]}}]},{"Value":[0,[{"Var":{"Bound":[0,0]}},{"Deduplicated":0}]]},null]}]},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1},"kind":"InherentImplBlock"}}},{"Ident":["as_mut_slice",0]}]},{"key":{"Fun":2},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["repeat",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}}]},{"key":{"Fun":3},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}},{"Ident":["index",0]}]},{"key":{"TraitImpl":1},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":1}}]},{"key":{"Fun":4},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":1}},{"Ident":["index",0]}]},{"key":{"TraitImpl":2},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":2}}]},{"key":{"Fun":5},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":2}},{"Ident":["index_mut",0]}]},{"key":{"TraitImpl":3},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":3}}]},{"key":{"Fun":6},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":3}},{"Ident":["index_mut",0]}]},{"key":{"TraitImpl":4},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":4}}]},{"key":{"Fun":7},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":4}},{"Ident":["index",0]}]},{"key":{"Fun":8},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":4}},{"Ident":["index_mut",0]}]},{"key":{"TraitImpl":5},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":5}}]},{"key":{"Fun":9},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":5}},{"Ident":["index",0]}]},{"key":{"Fun":10},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":5}},{"Ident":["index_mut",0]}]},{"key":{"Type":1},"value":[{"Ident":["sandproof_controller_service",0]},{"Ident":["application",0]},{"Ident":["diagnostics",0]},{"Ident":["SerialMutex",0]}]},{"key":{"Fun":11},"value":[{"Ident":["sandproof_controller_service",0]},{"Ident":["application",0]},{"Ident":["diagnostics",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Value":[3,{"Adt":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2}],"const_generics":[],"trait_refs":[]},"builtin":null}}]},"kind":"InherentImplBlock"}}},{"Ident":["get_mut",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["clone",0]},{"Ident":["Clone",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["Index",0]}]},{"key":{"Global":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}},{"Builtin":["VTable",0]}]},{"key":{"TraitDecl":2},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]}]},{"key":{"Global":1},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":1}},{"Builtin":["VTable",0]}]},{"key":{"TraitDecl":3},"value":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]}]},{"key":{"Global":2},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":2}},{"Builtin":["VTable",0]}]},{"key":{"Global":3},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":3}},{"Builtin":["VTable",0]}]},{"key":{"Global":4},"value":[{"Ident":["core",0]},{"Ide