er":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"verification/extract-data-drain/src/lib.rs"},"crate_name":"sandproof_data_drain_extract","contents":"//! Call-through roots for the original process-local drain read methods.\n//! No copied business implementation and no mutation/drop extraction.\n#[path = \"../../../controller-service/src/application/data_drain.rs\"]\npub mod data_drain;\n\npub fn read_drained(lease: &data_drain::DataLease) -> bool {\n    lease.drained()\n}\n\npub fn read_routes_dropped(lease: &data_drain::DataLease) -> bool {\n    lease.routes_dropped()\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"verification/extract-data-drain/src/../../../controller-service/src/application/data_drain.rs"},"crate_name":"sandproof_data_drain_extract","contents":"//! Process-local route pins. A cancellation request is not an exit certificate.\nuse std::sync::{\n    Arc,\n    atomic::{AtomicBool, Ordering},\n};\n\n#[derive(Clone, Debug, Default)]\npub struct DataLease {\n    unknown: Arc<AtomicBool>,\n}\n\nimpl DataLease {\n    /// True only for the coordinator's sole remaining pin and a known exit.\n    /// Call under the management lock after durable authority revocation.\n    #[must_use]\n    pub fn drained(&self) -> bool {\n        self.routes_dropped() && !self.unknown.load(Ordering::Acquire)\n    }\n\n    /// No response or relay lease remains. Unknown exit still requires a\n    /// separate trusted durable host-gate observation before release.\n    #[must_use]\n    pub fn routes_dropped(&self) -> bool {\n        Arc::strong_count(&self.unknown) == 1\n    }\n\n    /// A relay task lost its exit observation. Only restart plus exact host\n    /// reconciliation can recover this conservative process-local blocker.\n    pub fn mark_unknown(&self) {\n        self.unknown.store(true, Ordering::Release);\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn all_pins_must_drop_and_unknown_exit_never_becomes_drained() {\n        let pin = DataLease::default();\n        let response = pin.clone();\n        let relay = pin.clone();\n        assert!(!pin.drained());\n        drop(response);\n        assert!(!pin.drained());\n        drop(relay);\n        assert!(pin.drained());\n        let relay = pin.clone();\n        relay.mark_unknown();\n        drop(relay);\n        assert!(!pin.drained());\n    }\n}\n"},{"id":10,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/alloc/src/sync.rs"},"crate_name":"alloc","contents":null},{"id":13,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"c