iscriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},null,null,{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}],"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":598,"col":0},"end":{"line":598,"col":18}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `Option` type. See [the module level documentation](self) for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Option","diagnostic_item":"Option"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":602,"col":4},"end":{"line":602,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" No value."}],"inline":null,"rename":null,"public":true},"name":"None","fields":[],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":606,"col":4},"end":{"line":606,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Some value of type `T`."}],"inline":null,"rename":null,"public":true},"name":"Some","fields":[{"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":606,"col":55},"end":{"line":606,"col":56}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Deduplicated":7}}],"discriminant":{"Signed":["Isize","1"]}}]},"layout":[],"ptr_metadata":"None"},null,{"def_id":7,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["sync",0]},{"Ident":["Arc",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":274,"col":0},"end":{"line":277,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A thread-safe reference-counting pointer. 'Arc' stands for 'Atomically"},{"DocComment":" Reference Counted'."},{"DocComment":""},{"DocComment":" The type `Arc<T>` provides shared ownership of a value of type `T`,"},{"DocComment":" allocated in the heap. Invoking [`clone`][clone] on `Arc` produces"},{"DocComment":" a new `Arc` instance, which points to the same allocation on the heap as the"},{"DocComment":" source `Arc`, while increasing a reference count. When the last `Arc`"},{"DocComment":" pointer to a given allocation is destroyed, the value stored in that allocation (often"},{"DocComment":" referred to as \"inner value\") is also dropped."},{"DocComment":""},{"DocComment":" Shared references in Rust disallow mutation by default, and `Arc` is no"},{"DocComment":" exception: you cannot generally obtain a mutable reference to something"},{"DocComment":" inside an `Arc`. If you do need to mutate through an `Arc`, you have several options:"},{"DocComment":""},{"DocComment":" 1. Use interior mutability with synchronization primitives like [`Mutex`][mutex],"},{"DocComment":"    [`RwLock`][rwlock], or one of the [`Atomic`][atomic] types."},{"DocComment":""},{"DocComment":" 2. Use clone-on-write semantics with [`Arc::make_mut`] which provides efficient mutation"},{"DocComment":"    without requiring interior mutability. This approach clones the data only when"},{"DocComment":"    needed (when there are multiple references) and can be more efficient when mutations"},{"DocComment":"    are infrequent."},{"DocComment":""},{"DocComment":" 3. Use [`Arc::get_mut`] when you know your `Arc` is not shared (has a reference count of 1),"},{"DocComment":"    which provides direct mutable access to the inner value without any cloning."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let mut data = Arc::new(vec![1, 2, 3]);"},{"DocComment":""},{"DocComment":" // This will clone the vector only if there are other references to it"},{"DocComment":" Arc::make_mut(&mut data).push(4);"},{"DocComment":""},{"DocComment":" assert_eq!(*data, vec![1, 2, 3, 4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" **Note**: This type is only available on platforms that support atomic"},{"DocComment":" loads and stores of pointers, which includes all platforms that support"},{"DocComment":" the `std` crate but not all those which only support [`alloc`](crate)."},{"DocComment":" This may be detected at compile time using `#[cfg(target_has_atomic = \"ptr\")]`."},{"DocComment":""},{"DocComment":" ## Thread Safety"},{"DocComment":""},{"DocComment":" Unlike [`Rc<T>`], `Arc<T>` uses atomic operations for its reference"},{"DocComment":" counting. This means that it is thread-safe. The disadvantage is that"},{"DocComment":" atomic operations are more expensive than ordinary memory accesses. If you"},{"DocComment":" are not sharing reference-counted allocations between threads, consider using"},{"DocComment":" [`Rc<T>`] for lower overhead. [`Rc<T>`] is a safe default, because the"},{"DocComment":" compiler will catch any attempt to send an [`Rc<T>`] between threads."},{"DocComment":" However, a library might choose `Arc<T>` in order to give library consumers"},{"DocComment":" more flexibility."},{"DocComment":""},{"DocComment":" `Arc<T>` will implement [`Send`] and [`Sync`] as long as the `T` implements"},{"DocComment":" [`Send`] and [`Sync`]. Why can't you put a non-thread-safe type `T` in an"},{"DocComment":" `Arc<T>` to make it thread-safe? This may be a bit counter-intuitive at"},{"DocComment":" first: after all, isn't the point of `Arc<T>` thread safety? The key is"},{"DocComment":" this: `Arc<T>` makes it thread safe to have multiple ownership of the same"},{"DocComment":" data, but it  doesn't add thread safety to its data. Consider"},{"DocComment":" <code>Arc<[RefCell\\<T>]></code>. [`RefCell<T>`] isn't [`Sync`], and if `Arc<T>` was always"},{"DocComment":" [`Send`], <code>Arc<[RefCell\\<T>]></code> would be as well. But then we'd have a problem:"},{"DocComment":" [`RefCell<T>`] is not thread safe; it keeps track of the borrowing count using"},{"DocComment":" non-atomic operations."},{"DocComment":""},{"DocComment":" In the end, this means that you may need to pair `Arc<T>` with some sort of"},{"DocComment":" [`std::sync`] type, usually [`Mutex<T>`][mutex]."},{"DocComment":""},{"DocComment":" ## Breaking cycles with `Weak`"},{"DocComment":""},{"DocComment":" The [`downgrade`][downgrade] method can be used to create a non-owning"},{"DocComment":" [`Weak`] pointer. A [`Weak`] pointer can be [`upgrade`][upgrade]d"},{"DocComment":" to an `Arc`, but this will return [`None`] if the value stored in the allocation has"},{"DocComment":" already been dropped. In other words, `Weak` pointers do not keep the value"},{"DocComment":" inside the allocation alive; however, they *do* keep the allocation"},{"DocComment":" (the backing store for the value) alive."},{"DocComment":""},{"DocComment":" A cycle between `Arc` pointers will never be deallocated. For this reason,"},{"DocComment":" [`Weak`] is used to break cycles. For example, a tree could have"},{"DocComment":" strong `Arc` pointers from parent nodes to children, and [`Weak`]"},{"DocComment":" pointers from children back to their parents."},{"DocComment":""},{"DocComment":" # Cloning references"},{"DocComment":""},{"DocComment":" Creating a new reference from an existing reference-counted pointer is done using the"},{"DocComment":" `Clone` trait implemented for [`Arc<T>`][Arc] and [`Weak<T>`][Weak]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" let foo = Arc::new(vec![1.0, 2.0, 3.0]);"},{"DocComment":" // The two syntaxes below are equivalent."},{"DocComment":" let a = foo.clone();"},{"DocComment":" let b = Arc::clone(&foo);"},{"DocComment":" // a, b, and foo are all Arcs that point to the same memory location"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Deref` behavior"},{"DocComment":""},{"DocComment":" `Arc<T>` automatically dereferences to `T` (via the [`Deref`] trait),"},{"DocComment":" so you can call `T`'s methods on a value of type `Arc<T>`. To avoid name"},{"DocComment":" clashes with `T`'s methods, the methods of `Arc<T>` itself are associated"},{"DocComment":" functions, called using [fully qualified syntax]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let my_arc = Arc::new(());"},{"DocComment":" let my_weak = Arc::downgrade(&my_arc);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Arc<T>`'s implementations of traits like `Clone` may also be called using"},{"DocComment":" fully qualified syntax. Some people prefer to use fully qualified syntax,"},{"DocComment":" while others prefer using method-call syntax."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let arc = Arc::new(());"},{"DocComment":" // Method-call syntax"},{"DocComment":" let arc2 = arc.clone();"},{"DocComment":" // Fully qualified syntax"},{"DocComment":" let arc3 = Arc::clone(&arc);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Weak<T>`][Weak] does not auto-dereference to `T`, because the inner value may have"},{"DocComment":" already been dropped."},{"DocComment":""},{"DocComment":" [`Rc<T>`]: crate::rc::Rc"},{"DocComment":" [clone]: Clone::clone"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [atomic]: core::sync::atomic"},{"DocComment":" [downgrade]: Arc::downgrade"},{"DocComment":" [upgrade]: Weak::upgrade"},{"DocComment":" [RefCell\\<T>]: core::cell::RefCell"},{"DocComment":" [`RefCell<T>`]: core::cell::RefCell"},{"DocComment":" [`std::sync`]: ../../std/sync/index.html"},{"DocComment":" [`Arc::clone(&from)`]: Arc::clone"},{"DocComment":" [fully qualified syntax]: https://doc.rust-lang.org/book/ch19-03-advanced-traits.html#fully-qualified-syntax-for-disambiguation-calling-methods-with-the-same-name"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Sharing some immutable data between threads:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let five = Arc::new(5);"},{"DocComment":""},{"DocComment":" for _ in 0..10 {"},{"DocComment":"     let five = Arc::clone(&five);"},{"DocComment":""},{"DocComment":"     thread::spawn(move || {"},{"DocComment":"         println!(\"{five:?}\");"},{"DocComment":"     });"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Sharing a mutable [`AtomicUsize`]:"},{"DocComment":""},{"DocComment":" [`AtomicUsize`]: core::sync::atomic::AtomicUsize \"sync::atomic::AtomicUsize\""},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" use std::sync::atomic::{AtomicUsize, Ordering};"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let val = Arc::new(AtomicUsize::new(5));"},{"DocComment":""},{"DocComment":" for _ in 0..10 {"},{"DocComment":"     let val = Arc::clone(&val);"},{"DocComment":""},{"DocComment":"     thread::spawn(move || {"},{"DocComment":"         let v = val.fetch_add(1, Ordering::Relaxed);"},{"DocComment":"         println!(\"{v:?}\");"},{"DocComment":"     });"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" See the [`rc` documentation][rc_examples] for more examples of reference"},{"DocComment":" counting in general."},{"DocComment":""},{"DocComment":" [rc_examples]: crate::rc#examples"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Arc"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["sync",0]},{"Ident":["atomic",0]},{"Ident":["Atomic",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":385,"col":0},"end":{"line":385,"col":37}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A memory location which can be safely modified from multiple threads."},{"DocComment":""},{"DocComment":" This has the same size and bit validity as the underlying type `T`. However,"},{"DocComment":" the alignment of this type is always equal to its size, even on targets where"},{"DocComment":" `T` has alignment less than its size."},{"DocComment":""},{"DocComment":" For more about the differences between atomic types and non-atomic types as"},{"DocComment":" well as information about the portability of this type, please see the"},{"DocComment":" [module-level documentation]."},{"DocComment":""},{"DocComment":" **Note:** This type is only available on platforms that support atomic loads"},{"DocComment":" and stores of `T`."},{"DocComment":""},{"DocComment":" [module-level documentation]: crate::sync::atomic"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Atomic"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Invariant"},{"index":1,"name":"Clause0_Storage","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":9,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Ident":["Global",0]}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":59,"col":0},"end":{"line":59,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The global memory allocator."},{"DocComment":""},{"DocComment":" This type implements the [`Allocator`] trait by forwarding calls"},{"DocComment":" to the allocator registered with the `#[global_allocator]` attribute"},{"DocComment":" if there is one, or the `std` crate’s default."},{"DocComment":""},{"DocComment":" Note: while this type is unstable, the functionality it provides can be"},{"DocComment":" accessed through the [free functions in `alloc`](self#functions)."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"GlobalAlloc","diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":0},"align":{"guarantee":null,"chosen":1},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["sync",0]},{"Ident":["atomic",0]},{"Ident":["Ordering",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":466,"col":0},"end":{"line":466,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Atomic memory orderings"},{"DocComment":""},{"DocComment":" Memory orderings specify the way atomic operations synchronize memory."},{"DocComment":" In its weakest [`Ordering::Relaxed`], only the memory directly touched by the"},{"DocComment":" operation is synchronized. On the other hand, a store-load pair of [`Ordering::SeqCst`]"},{"DocComment":" operations synchronize other memory while additionally preserving a total order of such"},{"DocComment":" operations across all threads."},{"DocComment":""},{"DocComment":" Rust's memory orderings are [the same as those of"},{"DocComment":" C++20](https://en.cppreference.com/w/cpp/atomic/memory_order)."},{"DocComment":""},{"DocComment":" For more information see the [nomicon]."},{"DocComment":""},{"DocComment":" [nomicon]: ../../../nomicon/atomics.html"},{"Builtin":{"NonExhaustive":{"Untagged":{"data":{"file_id":14,"beg":{"line":464,"col":0},"end":{"line":464,"col":17}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Ordering"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":473,"col":4},"end":{"line":473,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" No ordering constraints, only atomic operations."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_relaxed`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_relaxed`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Relaxed_ordering"}],"inline":null,"rename":null,"public":true},"name":"Relaxed","fields":[],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":488,"col":4},"end":{"line":488,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" When coupled with a store, all previous operations become ordered"},{"DocComment":" before any load of this value with [`Acquire`] (or stronger) ordering."},{"DocComment":" In particular, all previous writes become visible to all threads"},{"DocComment":" that perform an [`Acquire`] (or stronger) load of this value."},{"DocComment":""},{"DocComment":" Notice that using this ordering for an operation that combines loads"},{"DocComment":" and stores leads to a [`Relaxed`] load operation!"},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that can perform a store."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_release`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_release`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"Release","fields":[],"discriminant":{"Signed":["Isize","1"]}},{"id":2,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":503,"col":4},"end":{"line":503,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" When coupled with a load, if the loaded value was written by a store operation with"},{"DocComment":" [`Release`] (or stronger) ordering, then all subsequent operations"},{"DocComment":" become ordered after that store. In particular, all subsequent loads will see data"},{"DocComment":" written before the store."},{"DocComment":""},{"DocComment":" Notice that using this ordering for an operation that combines loads"},{"DocComment":" and stores leads to a [`Relaxed`] store operation!"},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that can perform a load."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_acquire`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_acquire`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"Acquire","fields":[],"discriminant":{"Signed":["Isize","2"]}},{"id":3,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":517,"col":4},"end":{"line":517,"col":10}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Has the effects of both [`Acquire`] and [`Release`] together:"},{"DocComment":" For loads it uses [`Acquire`] ordering. For stores it uses the [`Release`] ordering."},{"DocComment":""},{"DocComment":" Notice that in the case of `compare_and_swap`, it is possible that the operation ends up"},{"DocComment":" not performing any store and hence it has just [`Acquire`] ordering. However,"},{"DocComment":" `AcqRel` will never perform [`Relaxed`] accesses."},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that combine both loads and stores."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_acq_rel`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_acq_rel`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"AcqRel","fields":[],"discriminant":{"Signed":["Isize","3"]}},{"id":4,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":526,"col":4},"end":{"line":526,"col":10}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Like [`Acquire`]/[`Release`]/[`AcqRel`] (for load, store, and load-with-store"},{"DocComment":" operations, respectively) with the additional guarantee that all threads see all"},{"DocComment":" sequentially consistent operations in the same order."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_seq_cst`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_seq_cst`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Sequentially-consistent_ordering"}],"inline":null,"rename":null,"public":true},"name":"SeqCst","fields":[],"discriminant":{"Signed":["Isize","4"]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":1},"align":{"guarantee":null,"chosen":1},"discriminator":{"Branch":{"offset":{"guarantee":null,"chosen":0},"int_ty":{"Unsigned":"U8"},"children":[[{"start":{"Unsigned":["U8","0"]},"end":{"Unsigned":["U8","0"]}},{"Known":0}],[{"start":{"Unsigned":["U8","1"]},"end":{"Unsigned":["U8","1"]}},{"Known":1}],[{"start":{"Unsigned":["U8","2"]},"end":{"Unsigned":["U8