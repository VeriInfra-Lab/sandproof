r":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":15},{"Deduplicated":18},{"Deduplicated":19}],"const_generics":[],"trait_refs":[]}}}}]}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":6,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":7},{"Deduplicated":18},{"Deduplicated":19}],"const_generics":[],"trait_refs":[{"Deduplicated":2}]}},"kind":{"TraitMethod":[3,0]}}],"vtable":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":7},{"Deduplicated":18}],"const_generics":[],"trait_refs":[{"Deduplicated":2}]}}},{"def_id":4,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":4}}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":179,"col":0},"end":{"line":179,"col":46}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The methods `index` and `index_mut` panic if the index is out of bounds."}],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","impl_trait":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":0},{"Deduplicated":15},{"Deduplicated":7}],"const_generics":[],"trait_refs":[]}},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":13,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":7}