omment":""},{"DocComment":" [`Cell`]: core::cell::Cell"},{"DocComment":" [`RefCell`]: core::cell::RefCell"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::BTreeSet;"},{"DocComment":""},{"DocComment":" // Type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `BTreeSet<&str>` in this example)."},{"DocComment":" let mut books = BTreeSet::new();"},{"DocComment":""},{"DocComment":" // Add some books."},{"DocComment":" books.insert(\"A Dance With Dragons\");"},{"DocComment":" books.insert(\"To Kill a Mockingbird\");"},{"DocComment":" books.insert(\"The Odyssey\");"},{"DocComment":" books.insert(\"The Great Gatsby\");"},{"DocComment":""},{"DocComment":" // Check for a specific one."},{"DocComment":" if !books.contains(\"The Winds of Winter\") {"},{"DocComment":"     println!(\"We have {} books, but The Winds of Winter ain't one.\","},{"DocComment":"              books.len());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Remove a book."},{"DocComment":" books.remove(\"The Odyssey\");"},{"DocComment":""},{"DocComment":" // Iterate over everything."},{"DocComment":" for book in &books {"},{"DocComment":"     println!(\"{book}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A `BTreeSet` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::BTreeSet;"},{"DocComment":""},{"DocComment":" let set = BTreeSet::from([1, 2, 3]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"BTreeSet"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque"