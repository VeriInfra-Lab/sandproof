,{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"sandproof_btree_set_binding","contents":"#![forbid(unsafe_code)]\n\n//! Transparent calls to the fixed real standard BTreeSet.\n//! These are API preflights, not replacements for the production validators.\nuse std::collections::BTreeSet;\n\npub fn insert_u64(seen: &mut BTreeSet<u64>, value: u64) -> bool {\n    seen.insert(value)\n}\n\npub fn insert_str<'a>(seen: &mut BTreeSet<&'a str>, value: &'a str) -> bool {\n    seen.insert(value)\n}\n\npub fn insert_lane<'a>(\n    seen: &mut BTreeSet<(&'a str, u16)>,\n    node: &'a str,\n    slot: u16,\n) -> bool {\n    seen.insert((node, slot))\n}\n\npub fn repeat_str<'a>(seen: &mut BTreeSet<&'a str>, value: &'a str) -> (bool, bool) {\n    let first = seen.insert(value);\n    let second = seen.insert(value);\n    (first, second)\n}\n\npub fn new_then_repeat_str(value: &str) -> (bool, bool) {\n    let mut seen = BTreeSet::new();\n    let first = seen.insert(value);\n    let second = seen.insert(value);\n    (first, second)\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/c