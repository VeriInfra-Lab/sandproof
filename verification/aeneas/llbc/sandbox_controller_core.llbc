t_id) {\n        return Err(SchedulerReject::ResourceNotPlanned);\n    }\n    let Some(slot) = world.net_slots.get(&slot_id) else {\n        return Err(SchedulerReject::SlotNotFound);\n    };\n    if slot.sandbox != sandbox || slot.generation != generation {\n        return Err(SchedulerReject::ResourceMismatch);\n    }\n    if slot.active {\n        return Err(SchedulerReject::ResourceNotReady);\n    }\n    if slot.reclaimed {\n        return Err(SchedulerReject::AlreadyReclaimed);\n    }\n    if !not_current_slot_check(world, sandbox, slot_id) {\n        return Err(SchedulerReject::ResourceStillCurrent);\n    }\n\n    let command = Command::CleanupSlot {\n        sandbox,\n        generation,\n        slot: slot_id,\n    };\n    let mut next = world.clone();\n    enqueue(&mut next, command);\n    Ok(Decision {\n        event: Event::ScheduleCleanupSlot {\n            sandbox,\n            generation,\n            slot: slot_id,\n        },\n        next,\n    })\n}","attr_info":{"attributes":[{"DocComment":" Rust implementation of Lean's `Controller.handleScheduleCleanupSlot`."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns the first rejection from Lean's current-plan membership, slot"},{"DocComment":" identity, inactive, unreclaimed, and no-longer-current checks."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":131},{"Deduplicated":20},{"Deduplicated":6},{"Deduplicated":32}],"output":{"Deduplicated":160}},"src":"Normal","body":{"Structured":{"span":{"Value":[2369,{"data":{"file_id":10,"beg":{"line":664,"col":0},"end":{"line":720,"col":1}},"generated