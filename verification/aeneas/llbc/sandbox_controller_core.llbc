{"charon_version":"0.1.254","translated":{"crate_name":"sandbox_controller_core","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::request::handle_create","crate::controller::handle_controller","crate::model::initial_world","crate::request::handle_pause","crate::request::handle_resume","crate::request::handle_kill","crate::request::handle","crate::auxiliary::handle_rpc_timeout","crate::auxiliary::handle_access","crate::effect::handle_effect","crate::scheduler::handle_reserve_startup","crate::scheduler::handle_reserve_pause_snapshot","crate::scheduler::handle_dispatch_prepare","crate::scheduler::handle_schedule_seal_snapshot","crate::scheduler::handle_schedule_commit_snapshot","crate::scheduler::handle_schedule_stop_vm","crate::scheduler::handle_schedule_cleanup_vm","crate::scheduler::handle_schedule_cleanup_slot","crate::scheduler::handle_scheduler","crate::worker::handle_worker","crate::publication::handle_publication","crate::recovery_monitor::handle_runtime","crate::recovery_monitor::view","crate::recovery_monitor::monitor","crate::transition::reserve_startup_resources","crate::transition::reserve_pause_snapshot"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/Users/Admin/Projects/sandbox/verification/aeneas/llbc/sandbox_controller_core.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":true,"preset":"Aeneas"},"target_information":[{"key":"aarch64-apple-darwin","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"controller-core/src/lib.rs"},"crate_name":"sandbox_controller_core","contents":"#![forbid(unsafe_code)]\n\n//! Pure, deterministic sandbox-controller core.\n//!\n//! This crate deliberately performs no I/O.  A successful reduction returns\n//! the complete next durable state and the protocol event which justified it.\n//! Persistence, dispatch, clocks, and platform adapters live outside this\n//! boundary.  The data model mirrors `SandboxModel.Types` and\n//! `SandboxModel.State`; refinement proofs are maintained in Lean.\n\npub mod auxiliary;\npub mod controller;\npub mod effect;\npub mod ids;\npub mod model;\npub mod publication;\npub mod recovery_monitor;\npub mod request;\npub mod scheduler;\npub mod store;\npub(crate) mod transition;\npub mod worker;\n\npub use auxiliary::*;\npub use controller::*;\npub use effect::*;\npub use ids::*;\npub use model::*;\npub use publication::*;\npub use recovery_monitor::*;\npub use request::*;\npub use scheduler::*;\npub use store::Store;\npub use worker::*;\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"controller-core/src/request.rs"},"crate_name":"sandbox_controller_core","contents":"use crate::model::{\n    Actor, EffectId, EffectOrigin, EffectOutcome, EffectStatus, Event, FailureKind, FilePolicyRef,\n    LogicalEffectResult, NetworkPolicy, OperationInput, OperationKind, OperationStatus, Phase,\n    World,\n};\nuse crate::transition::{\n    authorized, begin_compensation, begin_create, begin_kill, begin_pause, begin_resume,\n    operation_key, supersede_ready_check,\n};\nuse crate::{FsId, OperationId, SandboxId, TenantId};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Reject {\n    ControllerDown,\n    SandboxExists,\n    SandboxNotFound,\n    WorkspaceExists,\n    OperationExists,\n    OperationPlanExists,\n    Unauthorized,\n    WrongPhase,\n    Terminal,\n    NoCurrentVm,\n    SnapshotUnavailable,\n    OperationUnavailable,\n    OperationNotCompensable,\n    OperationAlreadyFinal,\n    LedgerMismatch,\n    FailureUnjustified,\n    CounterExhausted,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct Decision {\n    pub event: Event,\n    pub next: World,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct CreateRequest {\n    pub actor: Actor,\n    pub owner: TenantId,\n    pub sandbox: SandboxId,\n    pub workspace: FsId,\n    pub file_policy: FilePolicyRef,\n    pub policy: NetworkPolicy,\n    pub operation: OperationId,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct PauseRequest {\n    pub actor: Actor,\n    pub sandbox: SandboxId,\n    pub operation: OperationId,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct ResumeRequest {\n    pub actor: Actor,\n    pub sandbox: SandboxId,\n    pub operation: OperationId,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct KillRequest {\n    pub actor: Actor,\n    pub sandbox: SandboxId,\n    pub operation: OperationId,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct ReplayRequest {\n    pub actor: Actor,\n    pub sandbox: SandboxId,\n    pub operation: OperationId,\n    pub kind: OperationKind,\n    pub input: OperationInput,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct QueryRequest {\n    pub actor: Actor,\n    pub sandbox: SandboxId,\n    pub operation: OperationId,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct CompensationRequest {\n    pub sandbox: SandboxId,\n    pub failure: FailureKind,\n    pub evidence: Option<EffectId>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum Request {\n    Create(CreateRequest),\n    Pause(PauseRequest),\n    Resume(ResumeRequest),\n    Kill(KillRequest),\n    Replay(ReplayRequest),\n    Query(QueryRequest),\n    Compensate(CompensationRequest),\n}\n\nimpl From<CreateRequest> for Request {\n    fn from(input: CreateRequest) -> Self {\n        Self::Create(input)\n    }\n}\n\nimpl From<PauseRequest> for Request {\n    fn from(input: PauseRequest) -> Self {\n        Self::Pause(input)\n    }\n}\n\nimpl From<ResumeRequest> for Request {\n    fn from(input: ResumeRequest) -> Self {\n        Self::Resume(input)\n    }\n}\n\nimpl From<KillRequest> for Request {\n    fn from(input: KillRequest) -> Self {\n        Self::Kill(input)\n    }\n}\n\nimpl From<ReplayRequest> for Request {\n    fn from(input: ReplayRequest) -> Self {\n        Self::Replay(input)\n    }\n}\n\nimpl From<QueryRequest> for Request {\n    fn from(input: QueryRequest) -> Self {\n        Self::Query(input)\n    }\n}\n\nimpl From<CompensationRequest> for Request {\n    fn from(input: CompensationRequest) -> Self {\n        Self::Compensate(input)\n    }\n}\n\n/// Rust implementation of Lean's `Controller.handleCreate`.\n///\n/// Check order is part of the observable contract: malformed requests receive\n/// the same first rejection as the executable Lean reducer.\n///\n/// # Errors\n///\n/// Returns the first `Reject` produced by the same ordered checks as the Lean\n/// reducer.  Rejection never mutates `world`.\npub fn handle_create(world: &World, input: CreateRequest) -> Result<Decision, Reject> {\n    let CreateRequest {\n        actor,\n        owner,\n        sandbox,\n        workspace,\n        file_policy,\n        policy,\n        operation,\n    } = input;\n    if !world.controller_up {\n        return Err(Reject::ControllerDown);\n    }\n    if world.sandboxes.contains_key(&sandbox) {\n        return Err(Reject::SandboxExists);\n    }\n    if world.filesystems.contains_key(&workspace) {\n        return Err(Reject::WorkspaceExists);\n    }\n    let key = operation_key(sandbox, operation);\n    if world.operations.contains_key(&key) {\n        return Err(Reject::OperationExists);\n    }\n    if world.operation_plans.contains_key(&key) {\n        return Err(Reject::OperationPlanExists);\n    }\n    if !authorized(&actor, owner) {\n        return Err(Reject::Unauthorized);\n    }\n\n    Ok(Decision {\n        event: Event::AcceptCreate {\n            actor,\n            owner,\n            sandbox,\n            workspace,\n            file_policy,\n            policy: policy.clone(),\n            operation,\n        },\n        next: begin_create(\n            world,\n            sandbox,\n            owner,\n            workspace,\n            file_policy,\n            policy,\n            operation,\n        ),\n    })\n}\n\n/// Rust implementation of Lean's `Controller.handlePause`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's ordered admission checks.\npub fn handle_pause(world: &World, input: PauseRequest) -> Result<Decision, Reject> {\n    let PauseRequest {\n        actor,\n        sandbox,\n        operation,\n    } = input;\n    if !world.controller_up {\n        return Err(Reject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(Reject::SandboxNotFound);\n    };\n    if record.phase != Phase::Running {\n        return Err(Reject::WrongPhase);\n    }\n    if record.terminal {\n        return Err(Reject::Terminal);\n    }\n    let Some(vm) = record.current_vm else {\n        return Err(Reject::NoCurrentVm);\n    };\n    let key = operation_key(sandbox, operation);\n    if world.operations.contains_key(&key) {\n        return Err(Reject::OperationExists);\n    }\n    if world.operation_plans.contains_key(&key) {\n        return Err(Reject::OperationPlanExists);\n    }\n    if !authorized(&actor, record.owner) {\n        return Err(Reject::Unauthorized);\n    }\n    if record.epoch == u64::MAX {\n        return Err(Reject::CounterExhausted);\n    }\n    let epoch = record.epoch + 1;\n\n    Ok(Decision {\n        event: Event::AcceptPause {\n            actor,\n            sandbox,\n            operation,\n        },\n        next: begin_pause(world, sandbox, record, operation, vm, epoch),\n    })\n}\n\nfn usable_snapshot_check(\n    world: &World,\n    sandbox: SandboxId,\n    record: &crate::SandboxRecord,\n    source: crate::RestoreSource,\n) -> bool {\n    match world.snapshots.get(&source.snapshot) {\n        Some(snapshot) => {\n            snapshot.owner == record.owner\n                && snapshot.sandbox == sandbox\n                && snapshot.workspace == record.workspace\n                && snapshot.manifest == source.manifest\n                && snapshot.stage == crate::SnapshotStage::Durable\n                && snapshot.immutable\n        }\n        None => false,\n    }\n}\n\n/// Rust implementation of Lean's `Controller.handleResume`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's ordered admission checks.\npub fn handle_resume(world: &World, input: ResumeRequest) -> Result<Decision, Reject> {\n    let ResumeRequest {\n        actor,\n        sandbox,\n        operation,\n    } = input;\n    if !world.controller_up {\n        return Err(Reject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(Reject::SandboxNotFound);\n    };\n    if record.phase != Phase::Paused {\n        return Err(Reject::WrongPhase);\n    }\n    if record.terminal {\n        return Err(Reject::Terminal);\n    }\n    let Some(source) = record.durable_snapshot else {\n        return Err(Reject::SnapshotUnavailable);\n    };\n    if !usable_snapshot_check(world, sandbox, record, source) {\n        return Err(Reject::SnapshotUnavailable);\n    }\n    let key = operation_key(sandbox, operation);\n    if world.operations.contains_key(&key) {\n        return Err(Reject::OperationExists);\n    }\n    if world.operation_plans.contains_key(&key) {\n        return Err(Reject::OperationPlanExists);\n    }\n    if !authorized(&actor, record.owner) {\n        return Err(Reject::Unauthorized);\n    }\n    if record.epoch == u64::MAX || record.generation == u64::MAX {\n        return Err(Reject::CounterExhausted);\n    }\n    let epoch = record.epoch + 1;\n    let generation = record.generation + 1;\n\n    Ok(Decision {\n        event: Event::AcceptResume {\n            actor,\n            sandbox,\n            operation,\n        },\n        next: begin_resume(world, sandbox, record, operation, source, epoch, generation),\n    })\n}\n\n/// Rust implementation of Lean's `Controller.handleKill`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's ordered admission checks.\npub fn handle_kill(world: &World, input: KillRequest) -> Result<Decision, Reject> {\n    let KillRequest {\n        actor,\n        sandbox,\n        operation,\n    } = input;\n    if !world.controller_up {\n        return Err(Reject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(Reject::SandboxNotFound);\n    };\n    if record.phase == Phase::Destroyed {\n        return Err(Reject::Terminal);\n    }\n    if record.terminal {\n        return Err(Reject::Terminal);\n    }\n    if !supersede_ready_check(world, sandbox, record.current_operation) {\n        return Err(Reject::LedgerMismatch);\n    }\n    let key = operation_key(sandbox, operation);\n    if world.operations.contains_key(&key) {\n        return Err(Reject::OperationExists);\n    }\n    if world.operation_plans.contains_key(&key) {\n        return Err(Reject::OperationPlanExists);\n    }\n    if !authorized(&actor, record.owner) {\n        return Err(Reject::Unauthorized);\n    }\n    if record.epoch == u64::MAX {\n        return Err(Reject::CounterExhausted);\n    }\n    let epoch = record.epoch + 1;\n\n    Ok(Decision {\n        event: Event::AcceptKill {\n            actor,\n            sandbox,\n            operation,\n        },\n        next: begin_kill(world, sandbox, record, operation, epoch),\n    })\n}\n\n/// Return a previously persisted operation without creating a new operation\n/// or changing durable state.  This intentionally remains available while the\n/// controller process is marked down, matching Lean's `handleReplay`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's ordered replay checks.\npub fn handle_replay(world: &World, input: ReplayRequest) -> Result<Decision, Reject> {\n    let ReplayRequest {\n        actor,\n        sandbox,\n        operation,\n        kind,\n        input,\n    } = input;\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(Reject::SandboxNotFound);\n    };\n    if !authorized(&actor, record.owner) {\n        return Err(Reject::Unauthorized);\n    }\n    let key = operation_key(sandbox, operation);\n    let Some(ledger) = world.operations.get(&key) else {\n        return Err(Reject::OperationUnavailable);\n    };\n    if ledger.operation.kind != kind {\n        return Err(Reject::LedgerMismatch);\n    }\n    if ledger.input != input {\n        return Err(Reject::LedgerMismatch);\n    }\n\n    Ok(Decision {\n        event: Event::RetryOperation {\n            actor,\n            sandbox,\n            operation,\n            kind,\n            input,\n        },\n        next: world.clone(),\n    })\n}\n\n/// Read an operation ledger row without changing durable state.  Like replay,\n/// query has no controller-up guard in the Lean reducer.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's ordered query checks.\npub fn handle_query(world: &World, input: QueryRequest) -> Result<Decision, Reject> {\n    let QueryRequest {\n        actor,\n        sandbox,\n        operation,\n    } = input;\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(Reject::SandboxNotFound);\n    };\n    if !authorized(&actor, record.owner) {\n        return Err(Reject::Unauthorized);\n    }\n    let key = operation_key(sandbox, operation);\n    let Some(ledger) = world.operations.get(&key) else {\n        return Err(Reject::OperationUnavailable);\n    };\n\n    Ok(Decision {\n        event: Event::QueryOperation {\n            actor,\n            sandbox,\n            operation,\n            status: ledger.operation.status,\n            result: ledger.result,\n        },\n        next: world.clone(),\n    })\n}\n\nfn supplied_compensation_evidence(\n    world: &World,\n    key: crate::OperationKey,\n    epoch: crate::Epoch,\n    failure: FailureKind,\n    evidence: Option<EffectId>,\n) -> bool {\n    let Some(id) = evidence else {\n        return matches!(\n            failure,\n            FailureKind::Cancelled | FailureKind::DeadlineExceeded\n        );\n    };\n    let Some(logical) = world.logical_effects.get(&id.logical) else {\n        return false;\n    };\n\n    logical.origin == EffectOrigin::Operation(key)\n        && id.attempt == logical.current_attempt\n        && logical.result\n            == Some(LogicalEffectResult::Failed {\n                attempt: id.attempt,\n                failure,\n            })\n        && world.effects.get(&id)\n            == Some(&EffectStatus::Acknowledged(EffectOutcome::Failed(failure)))\n        && id.command().sandbox() == key.sandbox\n        && id.command().epoch() == Some(epoch)\n}\n\n/// Start the terminal compensation protocol for the current create, resume,\n/// or pause operation.  Worker-caused compensation requires the finalized\n/// failure of the exact current logical-effect attempt owned by that operation.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's ordered compensation checks.\npub fn handle_compensation(world: &World, input: CompensationRequest) -> Result<Decision, Reject> {\n    let CompensationRequest {\n        sandbox,\n        failure,\n        evidence,\n    } = input;\n    if !world.controller_up {\n        return Err(Reject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(Reject::SandboxNotFound);\n    };\n    if !matches!(record.phase, Phase::Starting | Phase::Pausing) {\n        return Err(Reject::WrongPhase);\n    }\n    if record.terminal {\n        return Err(Reject::Terminal);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(Reject::OperationUnavailable);\n    };\n    if !matches!(\n        operation.kind,\n        OperationKind::Create | OperationKind::Resume | OperationKind::Pause\n    ) {\n        return Err(Reject::OperationNotCompensable);\n    }\n    if !matches!(\n        operation.status,\n        OperationStatus::Pending | OperationStatus::OutcomeUnknown\n    ) {\n        return Err(Reject::OperationAlreadyFinal);\n    }\n    let key = operation_key(sandbox, operation.id);\n    let Some(ledger) = world.operations.get(&key) else {\n        return Err(Reject::OperationUnavailable);\n    };\n    if ledger.sandbox != sandbox || ledger.operation != operation || ledger.result.is_some() {\n        return Err(Reject::LedgerMismatch);\n    }\n    if !supplied_compensation_evidence(world, key, operation.epoch, failure, evidence) {\n        return Err(Reject::FailureUnjustified);\n    }\n\n    Ok(Decision {\n        event: Event::BeginCompensation { sandbox, failure },\n        next: begin_compensation(world, sandbox, record, operation, failure),\n    })\n}\n\n/// Unified executable entry point corresponding to Lean's `Controller.handle`.\n///\n/// # Errors\n///\n/// Returns the first rejection produced by the selected request handler.\npub fn handle(world: &World, input: Request) -> Result<Decision, Reject> {\n    match input {\n        Request::Create(input) => handle_create(world, input),\n        Request::Pause(input) => handle_pause(world, input),\n        Request::Resume(input) => handle_resume(world, input),\n        Request::Kill(input) => handle_kill(world, input),\n        Request::Replay(input) => handle_replay(world, input),\n        Request::Query(input) => handle_query(world, input),\n        Request::Compensate(input) => handle_compensation(world, input),\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{Reject, handle_create, handle_kill, handle_pause, handle_resume};\n    use crate::model::{\n        Actor, Authority, Command, EffectOrigin, EffectStatus, Event, FilePolicyRef,\n        LogicalEffectId, NetworkPolicy, Operation, OperationInput, OperationKind,\n        OperationLedgerRecord, OperationResult, OperationStatus, Phase, RestoreSource,\n        SandboxRecord, Snapshot, SnapshotManifestRef, SnapshotStage, WorkspaceApiAccess, World,\n    };\n    use crate::transition::operation_key;\n    use crate::{\n        FailureKind, FsId, ManifestDigest, OperationId, PolicyDigest, SandboxId, SnapshotId,\n        TenantId, VmId,\n    };\n\n    const OWNER: TenantId = TenantId(7);\n    const SID: SandboxId = SandboxId(11);\n    const WORKSPACE: FsId = FsId(13);\n    const VM: VmId = VmId(23);\n\n    fn sandbox_record(phase: Phase) -> SandboxRecord {\n        SandboxRecord {\n            owner: OWNER,\n            phase,\n            terminal: false,\n            epoch: 5,\n            generation: 3,\n            current_vm: Some(VM),\n            workspace: WORKSPACE,\n            workspace_access: WorkspaceApiAccess::ManagedReadWrite,\n            file_policy: FilePolicyRef {\n                digest: PolicyDigest(17),\n            },\n            durable_snapshot: None,\n            restore_from: None,\n            net_slot: None,\n            policy: NetworkPolicy::DenyAll,\n            desired: Authority::Closed,\n            effective: Authority::Closed,\n            current_operation: None,\n        }\n    }\n\n    fn world_with_record(record: SandboxRecord) -> World {\n        let mut world = World::default();\n        world.sandboxes.put(SID, record);\n        world\n    }\n\n    fn accepted_create() -> super::Decision {\n        handle_create(\n            &World::default(),\n            super::CreateRequest {\n                actor: Actor::Tenant(TenantId(7)),\n                owner: TenantId(7),\n                sandbox: SandboxId(11),\n                workspace: FsId(13),\n                file_policy: FilePolicyRef {\n                    digest: PolicyDigest(17),\n                },\n                policy: NetworkPolicy::DenyAll,\n                operation: OperationId(19),\n            },\n        )\n        .expect(\"valid create must be accepted\")\n    }\n\n    #[test]\n    fn create_atomically_records_intent_plan_and_initial_effect() {\n        let decision = accepted_create();\n        let key = operation_key(SandboxId(11), OperationId(19));\n        let sandbox = decision\n            .next\n            .sandboxes\n            .get(&SandboxId(11))\n            .expect(\"sandbox record\");\n        assert_eq!(sandbox.phase, Phase::Starting);\n        assert_eq!(\n            sandbox.current_operation.expect(\"operation\").status,\n            OperationStatus::Pending\n        );\n\n        let ledger = decision.next.operations.get(&key).expect(\"ledger\");\n        assert_eq!(ledger.sandbox, SandboxId(11));\n        assert_eq!(\n            ledger.input,\n            OperationInput::Create {\n                workspace: FsId(13),\n                network: NetworkPolicy::DenyAll,\n                file_policy: FilePolicyRef {\n                    digest: PolicyDigest(17),\n                },\n            }\n        );\n        let plan = decision.next.operation_plans.get(&key).expect(\"plan\");\n        assert_eq!(plan.key, key);\n        assert_eq!(plan.retry_limit, 3);\n\n        let command = Command::InstallFence {\n            sandbox: SandboxId(11),\n            epoch: 1,\n            terminal: false,\n        };\n        let effect = crate::EffectId::initial(command.clone());\n        assert_eq!(\n            decision.next.effects.get(&effect),\n            Some(&EffectStatus::Committed)\n        );\n        assert!(decision.next.inflight.contains(&effect));\n        let logical = LogicalEffectId { command };\n        assert_eq!(\n            decision\n                .next\n                .logical_effects\n                .get(&logical)\n                .expect(\"logical effect\")\n                .origin,\n            EffectOrigin::Operation(key)\n        );\n    }\n\n    #[test]\n    fn create_rejects_an_actor_from_another_tenant_without_state_change() {\n        let world = World::default();\n        let result = handle_create(\n            &world,\n            super::CreateRequest {\n                actor: Actor::Tenant(TenantId(8)),\n                owner: TenantId(7),\n                sandbox: SandboxId(11),\n                workspace: FsId(13),\n                file_policy: FilePolicyRef {\n                    digest: PolicyDigest(17),\n                },\n                policy: NetworkPolicy::DenyAll,\n                operation: OperationId(19),\n            },\n        );\n        assert_eq!(result, Err(Reject::Unauthorized));\n        assert_eq!(world, World::default());\n    }\n\n    #[test]\n    fn pause_records_intent_and_prepends_fence_and_freeze_attempts() {\n        let world = world_with_record(sandbox_record(Phase::Running));\n        let operation_id = OperationId(29);\n        let decision = handle_pause(\n            &world,\n            super::PauseRequest {\n                actor: Actor::Tenant(OWNER),\n                sandbox: SID,\n                operation: operation_id,\n            },\n        )\n        .expect(\"valid pause must be accepted\");\n\n        assert_eq!(\n            decision.event,\n            Event::AcceptPause {\n                actor: Actor::Tenant(OWNER),\n                sandbox: SID,\n                operation: operation_id,\n            }\n        );\n        let record = decision.next.sandboxes.get(&SID).expect(\"sandbox\");\n        assert_eq!(record.phase, Phase::Pausing);\n        assert_eq!(record.epoch, 6);\n        assert_eq!(record.desired, Authority::Closed);\n        let operation = record.current_operation.expect(\"current operation\");\n        assert_eq!(operation.kind, OperationKind::Pause);\n        assert_eq!(operation.status, OperationStatus::Pending);\n\n        let key = operation_key(SID, operation_id);\n        assert_eq!(\n            decision.next.operations.get(&key).expect(\"ledger\").input,\n            OperationInput::Pause { generation: 3 }\n        );\n        let freeze = crate::EffectId::initial(Command::FreezeVm {\n            sandbox: SID,\n            epoch: 6,\n            generation: 3,\n            vm: VM,\n        });\n        let fence = crate::EffectId::initial(Command::InstallFence {\n            sandbox: SID,\n            epoch: 6,\n            terminal: false,\n        });\n        assert_eq!(\n            decision.next.effect_keys,\n            vec![freeze.clone(), fence.clone()]\n        );\n        assert_eq!(decision.next.inflight, vec![freeze, fence]);\n    }\n\n    #[test]\n    fn pause_rejections_follow_lean_order() {\n        let mut record = sandbox_record(Phase::Starting);\n        record.terminal = true;\n        record.current_vm = None;\n        let world = world_with_record(record);\n        assert_eq!(\n            handle_pause(\n                &world,\n                super::PauseRequest {\n                    actor: Actor::Tenant(TenantId(99)),\n                    sandbox: SID,\n                    operation: OperationId(29),\n                },\n            ),\n            Err(Reject::WrongPhase)\n        );\n\n        let mut record = sandbox_record(Phase::Running);\n        record.terminal = true;\n        record.current_vm = None;\n        let world = world_with_record(record);\n        assert_eq!(\n            handle_pause(\n                &world,\n                super::PauseRequest {\n                    actor: Actor::Tenant(OWNER),\n                    sandbox: SID,\n                    operation: OperationId(29),\n                },\n            ),\n            Err(Reject::Terminal)\n        );\n    }\n\n    fn resumable_world() -> (World, RestoreSource) {\n        let source = RestoreSource {\n            snapshot: SnapshotId(31),\n            manifest: SnapshotManifestRef {\n                digest: ManifestDigest(37),\n            },\n        };\n        let mut record = sandbox_record(Phase::Paused);\n        record.current_vm = None;\n        record.durable_snapshot = Some(source);\n        record.desired = Authority::Paused {\n            sandbox: SID,\n            source,\n        };\n        record.effective = record.desired.clone();\n        let mut world = world_with_record(record);\n        world.snapshots.put(\n            source.snapshot,\n            Snapshot {\n                owner: OWNER,\n                sandbox: SID,\n                source_generation: 3,\n                workspace: WORKSPACE,\n                manifest: source.manifest,\n                stage: SnapshotStage::Durable,\n                immutable: true,\n            },\n        );\n        (world, source)\n    }\n\n    #[test]\n    fn resume_validates_snapshot_and_starts_next_generation() {\n        let (world, source) = resumable_world();\n        let operation_id = OperationId(41);\n        let decision = handle_resume(\n            &world,\n            super::ResumeRequest {\n                actor: Actor::Tenant(OWNER),\n                sandbox: SID,\n                operation: operation_id,\n            },\n        )\n        .expect(\"valid resume must be accepted\");\n\n        assert_eq!(\n            decision.event,\n            Event::AcceptResume {\n                actor: Actor::Tenant(OWNER),\n                sandbox: SID,\n                operation: operation_id,\n            }\n        );\n        let record = decision.next.sandboxes.get(&SID).expect(\"sandbox\");\n        assert_eq!(record.phase, Phase::Starting);\n        assert_eq!(record.epoch, 6);\n        assert_eq!(record.generation, 4);\n        assert_eq!(record.restore_from, Some(source));\n        assert_eq!(record.desired, Authority::Closed);\n        assert_eq!(record.effective, Authority::Closed);\n        let key = operation_key(SID, operation_id);\n        assert_eq!(\n            decision.next.operations.get(&key).expect(\"ledger\").input,\n            OperationInput::Resume { source }\n        );\n        assert_eq!(\n            decision\n                .next\n                .operation_plans\n                .get(&key)\n                .expect(\"plan\")\n                .generation,\n            4\n        );\n    }\n\n    #[test]\n    fn resume_rejects_an_invalid_snapshot_before_duplicate_operation() {\n        let (mut world, source) = resumable_world();\n        let operation_id = OperationId(41);\n        let mut snapshot = *world.snapshots.get(&source.snapshot).expect(\"snapshot\");\n        snapshot.immutable = false;\n        world.snapshots.put(source.snapshot, snapshot);\n        world.operations.put(\n            operation_key(SID, operation_id),\n            OperationLedgerRecord {\n                sandbox: SID,\n                operation: Operation {\n                    id: operation_id,\n                    epoch: 99,\n                    kind: OperationKind::Resume,\n                    status: OperationStatus::Pending,\n                },\n                input: OperationInput::Resume { source },\n                result: None,\n            },\n        );\n        assert_eq!(\n            handle_resume(\n                &world,\n                super::ResumeRequest {\n                    actor: Actor::Tenant(OWNER),\n                    sandbox: SID,\n                    operation: operation_id,\n                },\n            ),\n            Err(Reject::SnapshotUnavailable)\n        );\n    }\n\n    #[test]\n    fn kill_supersedes_unfinished_operation_and_writes_tombstone() {\n        let old_operation = Operation {\n            id: OperationId(43),\n            epoch: 5,\n            kind: OperationKind::Resume,\n            status: OperationStatus::OutcomeUnknown,\n        };\n        let mut record = sandbox_record(Phase::Starting);\n        record.current_operation = Some(old_operation);\n        let mut world = world_with_record(record);\n        let old_key = operation_key(SID, old_operation.id);\n        world.operations.put(\n            old_key,\n            OperationLedgerRecord {\n                sandbox: SID,\n                operation: old_operation,\n                input: OperationInput::Resume {\n                    source: RestoreSource {\n                        snapshot: SnapshotId(47),\n                        manifest: SnapshotManifestRef {\n                            digest: ManifestDigest(53),\n                        },\n                    },\n                },\n                result: None,\n            },\n        );\n        let kill_id = OperationId(59);\n        let decision = handle_kill(\n            &world,\n            super::KillRequest {\n                actor: Actor::SystemController,\n                sandbox: SID,\n                operation: kill_id,\n            },\n        )\n        .expect(\"valid kill must be accepted\");\n\n        let record = decision.next.sandboxes.get(&SID).expect(\"sandbox\");\n        assert_eq!(record.phase, Phase::Revoking);\n        assert!(record.terminal);\n        assert_eq!(record.epoch, 6);\n        assert_eq!(record.desired, Authority::Closed);\n        assert_eq!(record.effective, Authority::Closed);\n        let superseded = decision.next.operations.get(&old_key).expect(\"old ledger\");\n        assert_eq!(\n            superseded.operation.status,\n            OperationStatus::Failed(FailureKind::Cancelled)\n        );\n        assert_eq!(\n            superseded.result,\n            Some(OperationResult::Failed(FailureKind::Cancelled))\n        );\n        let kill_key = operation_key(SID, kill_id);\n        assert_eq!(\n            decision\n                .next\n                .operations\n                .get(&kill_key)\n                .expect(\"kill ledger\")\n                .input,\n            OperationInput::Kill { generation: 3 }\n        );\n        assert!(\n            decision\n                .next\n                .operation_plans\n                .get(&kill_key)\n                .expect(\"kill plan\")\n                .sealed\n        );\n    }\n\n    #[test]\n    fn kill_rejects_ledger_mismatch_before_freshness_and_authorization() {\n        let operation = Operation {\n            id: OperationId(61),\n            epoch: 5,\n            kind: OperationKind::Pause,\n            status: OperationStatus::Pending,\n        };\n        let mut record = sandbox_record(Phase::Pausing);\n        record.current_operation = Some(operation);\n        let mut world = world_with_record(record);\n        let requested = OperationId(67);\n        world.operations.put(\n            operation_key(SID, requested),\n            OperationLedgerRecord {\n                sandbox: SID,\n                operation,\n                input: OperationInput::Pause { generation: 3 },\n                result: None,\n            },\n        );\n        assert_eq!(\n            handle_kill(\n                &world,\n                super::KillRequest {\n                    actor: Actor::Tenant(TenantId(99)),\n                    sandbox: SID,\n                    operation: requested,\n                },\n            ),\n            Err(Reject::LedgerMismatch)\n        );\n    }\n\n    #[test]\n    fn lifecycle_requests_fail_closed_before_machine_counters_wrap() {\n        let mut pause_record = sandbox_record(Phase::Running);\n        pause_record.epoch = u64::MAX;\n        let pause_world = world_with_record(pause_record);\n        assert_eq!(\n            handle_pause(\n                &pause_world,\n                super::PauseRequest {\n                    actor: Actor::Tenant(OWNER),\n                    sandbox: SID,\n                    operation: OperationId(71),\n                },\n            ),\n            Err(Reject::CounterExhausted)\n        );\n\n        let (mut resume_world, _) = resumable_world();\n        let mut resume_record = resume_world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        resume_record.generation = u64::MAX;\n        resume_world.sandboxes.put(SID, resume_record);\n        assert_eq!(\n            handle_resume(\n                &resume_world,\n                super::ResumeRequest {\n                    actor: Actor::Tenant(OWNER),\n                    sandbox: SID,\n                    operation: OperationId(73),\n                },\n            ),\n            Err(Reject::CounterExhausted)\n        );\n\n        let mut kill_record = sandbox_record(Phase::Starting);\n        kill_record.epoch = u64::MAX;\n        let kill_world = world_with_record(kill_record);\n        assert_eq!(\n            handle_kill(\n                &kill_world,\n                super::KillRequest {\n                    actor: Actor::SystemController,\n                    sandbox: SID,\n                    operation: OperationId(79),\n                },\n            ),\n            Err(Reject::CounterExhausted)\n        );\n    }\n}\n\n#[cfg(test)]\nmod operation_ledger_tests {\n    use super::{\n        CompensationRequest, QueryRequest, Reject, ReplayRequest, Request, handle,\n        handle_compensation, handle_query, handle_replay,\n    };\n    use crate::model::{\n        Actor, Authority, Command, EffectId, EffectOrigin, EffectOutcome, EffectStatus, Event,\n        FailureKind, FilePolicyRef, LogicalEffectId, LogicalEffectRecord, LogicalEffectResult,\n        NetworkPolicy, Operation, OperationInput, OperationKind, OperationLedgerRecord,\n        OperationResult, OperationStatus, Phase, SandboxRecord, WorkspaceApiAccess, World,\n    };\n    use crate::transition::operation_key;\n    use crate::{FsId, OperationId, PolicyDigest, SandboxId, TenantId, VmId};\n\n    const OWNER: TenantId = TenantId(101);\n    const OTHER: TenantId = TenantId(102);\n    const SID: SandboxId = SandboxId(103);\n    const OPERATION_ID: OperationId = OperationId(104);\n    const WORKSPACE: FsId = FsId(105);\n    const EPOCH: u64 = 7;\n\n    fn create_input() -> OperationInput {\n        OperationInput::Create {\n            workspace: WORKSPACE,\n            network: NetworkPolicy::DenyAll,\n            file_policy: FilePolicyRef {\n                digest: PolicyDigest(106),\n            },\n        }\n    }\n\n    fn ledger_world(status: OperationStatus) -> World {\n        let operation = Operation {\n            id: OPERATION_ID,\n            epoch: EPOCH,\n            kind: OperationKind::Create,\n            status,\n        };\n        let record = SandboxRecord {\n            owner: OWNER,\n            phase: Phase::Starting,\n            terminal: false,\n            epoch: EPOCH,\n            generation: 3,\n            current_vm: Some(VmId(107)),\n            workspace: WORKSPACE,\n            workspace_access: WorkspaceApiAccess::ManagedReadWrite,\n            file_policy: FilePolicyRef {\n                digest: PolicyDigest(106),\n            },\n            durable_snapshot: None,\n            restore_from: None,\n            net_slot: None,\n            policy: NetworkPolicy::DenyAll,\n            desired: Authority::Closed,\n            effective: Authority::Closed,\n            current_operation: Some(operation),\n        };\n        let mut world = World::default();\n        world.sandboxes.put(SID, record);\n        world.operations.put(\n            operation_key(SID, OPERATION_ID),\n            OperationLedgerRecord {\n                sandbox: SID,\n                operation,\n                input: create_input(),\n                result: None,\n            },\n        );\n        world\n    }\n\n    fn evidence_id(attempt: u64, epoch: u64) -> EffectId {\n        EffectId {\n            logical: LogicalEffectId {\n                command: Command::InstallFence {\n                    sandbox: SID,\n                    epoch,\n                    terminal: false,\n                },\n            },\n            attempt,\n        }\n    }\n\n    fn finalized_failure_world(failure: FailureKind) -> (World, EffectId) {\n        let mut world = ledger_world(OperationStatus::Pending);\n        let id = evidence_id(2, EPOCH);\n        world.logical_effects.put(\n            id.logical.clone(),\n            LogicalEffectRecord {\n                origin: EffectOrigin::Operation(operation_key(SID, OPERATION_ID)),\n                current_attempt: id.attempt,\n                remaining_retries: 0,\n                result: Some(LogicalEffectResult::Failed {\n                    attempt: id.attempt,\n                    failure,\n                }),\n            },\n        );\n        world.effects.put(\n            id.clone(),\n            EffectStatus::Acknowledged(EffectOutcome::Failed(failure)),\n        );\n        (world, id)\n    }\n\n    fn replay_request() -> ReplayRequest {\n        ReplayRequest {\n            actor: Actor::Tenant(OWNER),\n            sandbox: SID,\n            operation: OPERATION_ID,\n            kind: OperationKind::Create,\n            input: create_input(),\n        }\n    }\n\n    #[test]\n    fn replay_is_read_only_while_controller_is_down_and_never_creates_an_operation() {\n        let mut world = ledger_world(OperationStatus::Succeeded);\n        world.controller_up = false;\n        let before = world.clone();\n\n        let decision = handle_replay(&world, replay_request()).expect(\"matching replay\");\n\n        assert_eq!(decision.next, before);\n        assert_eq!(world, before);\n        assert_eq!(\n            decision.event,\n            Event::RetryOperation {\n                actor: Actor::Tenant(OWNER),\n                sandbox: SID,\n                operation: OPERATION_ID,\n                kind: OperationKind::Create,\n                input: create_input(),\n            }\n        );\n        assert_eq!(world.operations.entries().len(), 1);\n    }\n\n    #[test]\n    fn replay_rejections_follow_sandbox_authorization_ledger_kind_input_order() {\n        assert_eq!(\n            handle_replay(&World::default(), replay_request()),\n            Err(Reject::SandboxNotFound)\n        );\n\n        let mut unauthorized = ledger_world(OperationStatus::Pending);\n        unauthorized.operations = crate::Store::default();\n        let mut request = replay_request();\n        request.actor = Actor::Tenant(OTHER);\n        assert_eq!(\n            handle_replay(&unauthorized, request),\n            Err(Reject::Unauthorized)\n        );\n\n        let mut missing = ledger_world(OperationStatus::Pending);\n        missing.operations = crate::Store::default();\n        assert_eq!(\n            handle_replay(&missing, replay_request()),\n            Err(Reject::OperationUnavailable)\n        );\n\n        let mut wrong_kind = replay_request();\n        wrong_kind.kind = OperationKind::Pause;\n        wrong_kind.input = OperationInput::Pause { generation: 3 };\n        assert_eq!(\n            handle_replay(&ledger_world(OperationStatus::Pending), wrong_kind),\n            Err(Reject::LedgerMismatch)\n        );\n\n        let mut wrong_input = replay_request();\n        wrong_input.input = OperationInput::Kill { generation: 3 };\n        assert_eq!(\n            handle_replay(&ledger_world(OperationStatus::Pending), wrong_input),\n            Err(Reject::LedgerMismatch)\n        );\n    }\n\n    #[test]\n    fn query_is_read_only_and_reports_exact_persisted_status_and_result() {\n        let mut world = ledger_world(OperationStatus::Failed(FailureKind::PolicyFailure));\n        let key = operation_key(SID, OPERATION_ID);\n        let mut ledger = world.operations.get(&key).expect(\"ledger\").clone();\n        ledger.result = Some(OperationResult::Failed(FailureKind::PolicyFailure));\n        world.operations.put(key, ledger);\n        world.controller_up = false;\n        let before = world.clone();\n        let request = QueryRequest {\n            actor: Actor::SystemController,\n            sandbox: SID,\n            operation: OPERATION_ID,\n        };\n\n        let decision = handle_query(&world, request).expect(\"persisted query\");\n\n        assert_eq!(decision.next, before);\n        assert_eq!(world, before);\n        assert_eq!(\n            decision.event,\n            Event::QueryOperation {\n                actor: Actor::SystemController,\n                sandbox: SID,\n                operation: OPERATION_ID,\n                status: OperationStatus::Failed(FailureKind::PolicyFailure),\n                result: Some(OperationResult::Failed(FailureKind::PolicyFailure)),\n            }\n        );\n    }\n\n    #[test]\n    fn compensation_accepts_only_the_finalized_current_attempt_for_worker_failure() {\n        let failure = FailureKind::PolicyFailure;\n        let (world, id) = finalized_failure_world(failure);\n\n        let decision = handle_compensation(\n            &world,\n            CompensationRequest {\n                sandbox: SID,\n                failure,\n                evidence: Some(id),\n            },\n        )\n        .expect(\"finalized current failure\");\n\n        assert_eq!(\n            decision.event,\n            Event::BeginCompensation {\n                sandbox: SID,\n                failure\n            }\n        );\n        let record = decision.next.sandboxes.get(&SID).expect(\"sandbox\");\n        assert_eq!(record.phase, Phase::Revoking);\n        assert!(record.terminal);\n        assert_eq!(record.desired, Authority::Closed);\n        assert_eq!(record.effective, Authority::Closed);\n        assert_eq!(\n            record.current_operation.expect(\"operation\").status,\n            OperationStatus::Compensating(failure)\n        );\n        let ledger = decision\n            .next\n            .operations\n            .get(&operation_key(SID, OPERATION_ID))\n            .expect(\"ledger\");\n        assert_eq!(\n            ledger.operation.status,\n            OperationStatus::Compensating(failure)\n        );\n        assert_eq!(ledger.result, None);\n        let fence = EffectId::initial(Command::InstallFence {\n            sandbox: SID,\n            epoch: EPOCH,\n            terminal: true,\n        });\n        assert_eq!(\n            decision.next.effects.get(&fence),\n            Some(&EffectStatus::Committed)\n        );\n        assert!(decision.next.inflight.contains(&fence));\n    }\n\n    #[test]\n    fn controller_owned_cancel_and_deadline_need_no_worker_evidence() {\n        for failure in [FailureKind::Cancelled, FailureKind::DeadlineExceeded] {\n            let world = ledger_world(OperationStatus::OutcomeUnknown);\n            let result = handle_compensation(\n                &world,\n                CompensationRequest {\n                    sandbox: SID,\n                    failure,\n                    evidence: None,\n                },\n            );\n            assert!(result.is_ok(), \"{failure:?} must be locally justified\");\n        }\n\n        let world = ledger_world(OperationStatus::Pending);\n        assert_eq!(\n            handle_compensation(\n                &world,\n                CompensationRequest {\n                    sandbox: SID,\n                    failure: FailureKind::InternalFailure,\n                    evidence: None,\n                },\n            ),\n            Err(Reject::FailureUnjustified)\n        );\n    }\n\n    #[test]\n    fn a_raw_failure_receipt_is_not_finalized_compensation_evidence() {\n        let failure = FailureKind::PolicyFailure;\n        let (mut world, id) = finalized_failure_world(failure);\n        let logical = world.logical_effects.get(&id.logical).expect(\"logical\");\n        world.logical_effects.put(\n            id.logical.clone(),\n            LogicalEffectRecord {\n                result: None,\n                ..*logical\n            },\n        );\n\n        assert_eq!(\n            handle_compensation(\n                &world,\n                CompensationRequest {\n                    sandbox: SID,\n                    failure,\n                    evidence: Some(id),\n                },\n            ),\n            Err(Reject::FailureUnjustified)\n        );\n    }\n\n    #[test]\n    fn stale_attempt_wrong_origin_and_missing_receipt_are_rejected() {\n        let failure = FailureKind::PolicyFailure;\n        let (base, id) = finalized_failure_world(failure);\n\n        let mut stale = base.clone();\n        let stale_id = evidence_id(1, EPOCH);\n        stale.effects.put(\n            stale_id.clone(),\n            EffectStatus::Acknowledged(EffectOutcome::Failed(failure)),\n        );\n        assert_eq!(\n            handle_compensation(\n                &stale,\n                CompensationRequest {\n                    sandbox: SID,\n                    failure,\n                    evidence: Some(stale_id),\n                },\n            ),\n            Err(Reject::FailureUnjustified)\n        );\n\n        let mut wrong_origin = base.clone();\n        let logical = *wrong_origin\n            .logical_effects\n            .get(&id.logical)\n            .expect(\"logical\");\n        wrong_origin.logical_effects.put(\n            id.logical.clone(),\n            LogicalEffectRecord {\n                origin: EffectOrigin::Operation(operation_key(SID, OperationId(999))),\n                ..logical\n            },\n        );\n        assert_eq!(\n            handle_compensation(\n                &wrong_origin,\n                CompensationRequest {\n                    sandbox: SID,\n                    failure,\n                    evidence: Some(id.clone()),\n                },\n            ),\n            Err(Reject::FailureUnjustified)\n        );\n\n        let mut missing_receipt = base.clone();\n        missing_receipt.effects = crate::Store::default();\n        assert_eq!(\n            handle_compensation(\n                &missing_receipt,\n                CompensationRequest {\n                    sandbox: SID,\n                    failure,\n                    evidence: Some(id.clone()),\n                },\n            ),\n            Err(Reject::FailureUnjustified)\n        );\n    }\n\n    #[test]\n    fn successful_result_mismatched_failure_and_wrong_epoch_are_rejected() {\n        let failure = FailureKind::PolicyFailure;\n        let (base, id) = finalized_failure_world(failure);\n\n        let mut succeeded = base.clone();\n        let logical = *succeeded.logical_effects.get(&id.logical).expect(\"logical\");\n        succeeded.logical_effects.put(\n            id.logical.clone(),\n            LogicalEffectRecord {\n                result: Some(LogicalEffectResult::Succeeded {\n                    attempt: id.attempt,\n                    result: crate::ResultDigest(109),\n                }),\n                ..logical\n            },\n        );\n        assert_eq!(\n            handle_compensation(\n                &succeeded,\n                CompensationRequest {\n                    sandbox: SID,\n                    failure,\n                    evidence: Some(id.clone()),\n                },\n            ),\n            Err(Reject::FailureUnjustified)\n        );\n\n        assert_eq!(\n            handle_compensation(\n                &base,\n                CompensationRequest {\n                    sandbox: SID,\n                    failure: FailureKind::StorageFailure,\n                    evidence: Some(id),\n                },\n            ),\n            Err(Reject::FailureUnjustified)\n        );\n\n        let wrong_epoch_id = evidence_id(2, EPOCH + 1);\n        let mut wrong_epoch = ledger_world(OperationStatus::Pending);\n        wrong_epoch.logical_effects.put(\n            wrong_epoch_id.logical.clone(),\n            LogicalEffectRecord {\n                origin: EffectOrigin::Operation(operation_key(SID, OPERATION_ID)),\n                current_attempt: 2,\n                remaining_retries: 0,\n                result: Some(LogicalEffectResult::Failed {\n                    attempt: 2,\n                    failure,\n                }),\n            },\n        );\n        wrong_epoch.effects.put(\n            wrong_epoch_id.clone(),\n            EffectStatus::Acknowledged(EffectOutcome::Failed(failure)),\n        );\n        assert_eq!(\n            handle_compensation(\n                &wrong_epoch,\n                CompensationRequest {\n                    sandbox: SID,\n                    failure,\n                    evidence: Some(wrong_epoch_id),\n                },\n            ),\n            Err(Reject::FailureUnjustified)\n        );\n    }\n\n    #[test]\n    fn compensation_guard_priority_and_unified_dispatch_match_lean() {\n        let down = World {\n            controller_up: false,\n            ..World::default()\n        };\n        assert_eq!(\n            handle_compensation(\n                &down,\n                CompensationRequest {\n                    sandbox: SID,\n                    failure: FailureKind::Cancelled,\n                    evidence: None,\n                },\n            ),\n            Err(Reject::ControllerDown)\n        );\n\n        let mut wrong_phase = ledger_world(OperationStatus::Succeeded);\n        let record = wrong_phase.sandboxes.get(&SID).expect(\"sandbox\");\n        wrong_phase.sandboxes.put(\n            SID,\n            SandboxRecord {\n                phase: Phase::Running,\n                terminal: true,\n                ..record.clone()\n            },\n        );\n        assert_eq!(\n            handle_compensation(\n                &wrong_phase,\n                CompensationRequest {\n                    sandbox: SID,\n                    failure: FailureKind::InternalFailure,\n                    evidence: None,\n                },\n            ),\n            Err(Reject::WrongPhase)\n        );\n\n        let world = ledger_world(OperationStatus::Pending);\n        let decision = handle(\n            &world,\n            Request::Query(QueryRequest {\n                actor: Actor::Tenant(OWNER),\n                sandbox: SID,\n                operation: OPERATION_ID,\n            }),\n        )\n        .expect(\"unified query\");\n        assert_eq!(decision.next, world);\n        assert!(matches!(decision.event, Event::QueryOperation { .. }));\n    }\n}\n"},{"id":6,"name":{"Local":"controller-core/src/controller.rs"},"crate_name":"sandbox_controller_core","contents":"use crate::SandboxId;\nuse crate::auxiliary::{AccessInput, AuxiliaryDecision, AuxiliaryEvent, AuxiliaryReject};\nuse crate::effect::{EffectDecision, EffectInput, EffectReject};\nuse crate::model::{EffectId, Event, World};\nuse crate::publication::{\n    PublicationDecision, PublicationEvent, PublicationInput, PublicationReject,\n};\nuse crate::recovery_monitor::{RuntimeDecision, RuntimeEvent, RuntimeInput, RuntimeReject};\nuse crate::request::{Decision as RequestDecision, Reject as RequestReject, Request};\nuse crate::scheduler::{SchedulerInput, SchedulerReject};\nuse crate::worker::{WorkerDecision, WorkerEvent, WorkerReject};\n\n/// Every state-changing or state-observing input owned by the verified pure\n/// controller boundary.\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum ControllerInput {\n    Request(Request),\n    Effect(EffectInput),\n    Scheduler(SchedulerInput),\n    Worker(EffectId),\n    Publication(PublicationInput),\n    RpcTimeout(SandboxId),\n    Access(AccessInput),\n    Runtime(RuntimeInput),\n}\n\n/// Events from all controller sub-protocols, kept tagged so the public entry\n/// point cannot confuse two domains with similarly shaped payloads.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum ControllerEvent {\n    Protocol(Event),\n    Worker(WorkerEvent),\n    Publication(PublicationEvent),\n    Auxiliary(AuxiliaryEvent),\n    Runtime(RuntimeEvent),\n}\n\n/// Rejections from all controller sub-protocols.  Machine-boundary failures\n/// such as exhausted counters remain visible in their originating domain.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ControllerReject {\n    Request(RequestReject),\n    Effect(EffectReject),\n    Scheduler(SchedulerReject),\n    Worker(WorkerReject),\n    Publication(PublicationReject),\n    Auxiliary(AuxiliaryReject),\n    Runtime(RuntimeReject),\n}\n\n/// A successful pure reduction.  The caller must atomically persist `next`\n/// before dispatching any newly committed effect from it.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct ControllerDecision {\n    pub event: ControllerEvent,\n    pub next: World,\n}\n\nfn protocol_decision(decision: RequestDecision) -> ControllerDecision {\n    ControllerDecision {\n        event: ControllerEvent::Protocol(decision.event),\n        next: decision.next,\n    }\n}\n\nfn effect_decision(decision: EffectDecision) -> ControllerDecision {\n    ControllerDecision {\n        event: ControllerEvent::Protocol(decision.event),\n        next: decision.next,\n    }\n}\n\nfn worker_decision(decision: WorkerDecision) -> ControllerDecision {\n    ControllerDecision {\n        event: ControllerEvent::Worker(decision.event),\n        next: decision.next,\n    }\n}\n\nfn publication_decision(decision: PublicationDecision) -> ControllerDecision {\n    ControllerDecision {\n        event: ControllerEvent::Publication(decision.event),\n        next: decision.next,\n    }\n}\n\nfn auxiliary_decision(decision: AuxiliaryDecision) -> ControllerDecision {\n    ControllerDecision {\n        event: ControllerEvent::Auxiliary(decision.event),\n        next: decision.next,\n    }\n}\n\nfn runtime_decision(decision: RuntimeDecision) -> ControllerDecision {\n    ControllerDecision {\n        event: ControllerEvent::Runtime(decision.event),\n        next: decision.next,\n    }\n}\n\n/// The single public pure-reducer entry point for the sandbox controller.\n///\n/// # Errors\n///\n/// Returns the first ordered rejection of the selected verified sub-handler.\n/// A rejection never returns a successor state.\npub fn handle_controller(\n    world: &World,\n    input: ControllerInput,\n) -> Result<ControllerDecision, ControllerReject> {\n    match input {\n        ControllerInput::Request(request_input) => {\n            match crate::request::handle(world, request_input) {\n                Ok(decision) => Ok(protocol_decision(decision)),\n                Err(reject) => Err(ControllerReject::Request(reject)),\n            }\n        }\n        ControllerInput::Effect(effect_input) => {\n            match crate::effect::handle_effect(world, effect_input) {\n                Ok(decision) => Ok(effect_decision(decision)),\n                Err(reject) => Err(ControllerReject::Effect(reject)),\n            }\n        }\n        ControllerInput::Scheduler(input) => {\n            match crate::scheduler::handle_scheduler(world, input) {\n                Ok(decision) => Ok(protocol_decision(decision)),\n                Err(reject) => Err(ControllerReject::Scheduler(reject)),\n            }\n        }\n        ControllerInput::Worker(effect) => match crate::worker::handle_worker(world, &effect) {\n            Ok(decision) => Ok(worker_decision(decision)),\n            Err(reject) => Err(ControllerReject::Worker(reject)),\n        },\n        ControllerInput::Publication(input) => {\n            match crate::publication::handle_publication(world, input) {\n                Ok(decision) => Ok(publication_decision(decision)),\n                Err(reject) => Err(ControllerReject::Publication(reject)),\n            }\n        }\n        ControllerInput::RpcTimeout(sandbox) => {\n            match crate::auxiliary::handle_rpc_timeout(world, sandbox) {\n                Ok(decision) => Ok(auxiliary_decision(decision)),\n                Err(reject) => Err(ControllerReject::Auxiliary(reject)),\n            }\n        }\n        ControllerInput::Access(input) => match crate::auxiliary::handle_access(world, input) {\n            Ok(decision) => Ok(auxiliary_decision(decision)),\n            Err(reject) => Err(ControllerReject::Auxiliary(reject)),\n        },\n        ControllerInput::Runtime(input) => {\n            match crate::recovery_monitor::handle_runtime(world, input) {\n                Ok(decision) => Ok(runtime_decision(decision)),\n                Err(reject) => Err(ControllerReject::Runtime(reject)),\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{ControllerEvent, ControllerInput, ControllerReject, handle_controller};\n    use crate::model::initial_world;\n    use crate::recovery_monitor::{RuntimeEvent, RuntimeInput, RuntimeReject};\n\n    #[test]\n    fn unified_entry_routes_runtime_success_and_rejection() {\n        let initial = initial_world();\n        let crashed = handle_controller(&initial, ControllerInput::Runtime(RuntimeInput::Crash))\n            .expect(\"an available controller can crash\");\n        assert_eq!(\n            crashed.event,\n            ControllerEvent::Runtime(RuntimeEvent::ControllerCrash)\n        );\n        assert_eq!(\n            handle_controller(&crashed.next, ControllerInput::Runtime(RuntimeInput::Crash)),\n            Err(ControllerReject::Runtime(\n                RuntimeReject::ControllerAlreadyDown\n            ))\n        );\n    }\n}\n"},{"id":7,"name":{"Local":"controller-core/src/model.rs"},"crate_name":"sandbox_controller_core","contents":"use crate::ids::{\n    AttemptNo, Epoch, FsId, Generation, ManifestDigest, NetSlotId, OperationId, PolicyDigest,\n    ResultDigest, SandboxId, SnapshotId, TenantId, VmId,\n};\nuse crate::store::Store;\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum Actor {\n    Tenant(TenantId),\n    SystemController,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum Phase {\n    Starting,\n    Running,\n    Pausing,\n    Paused,\n    Revoking,\n    Destroyed,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum VmStatus {\n    Prepared,\n    Executing,\n    Frozen,\n    Stopped,\n    Reclaimed,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum SnapshotStage {\n    LocalSealed,\n    Durable,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum WorkspaceApiAccess {\n    ManagedReadWrite,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct FilePolicyRef {\n    pub digest: PolicyDigest,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct SnapshotManifestRef {\n    pub digest: ManifestDigest,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct RestoreSource {\n    pub snapshot: SnapshotId,\n    pub manifest: SnapshotManifestRef,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum Protocol {\n    Tcp,\n    Udp,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct Endpoint {\n    pub address: String,\n    pub prefix_length: u64,\n    pub protocol: Protocol,\n    pub port: u64,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum NetworkPolicy {\n    DenyAll,\n    StaticAllowlist(Vec<Endpoint>),\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum OperationInput {\n    Create {\n        workspace: FsId,\n        network: NetworkPolicy,\n        file_policy: FilePolicyRef,\n    },\n    Pause {\n        generation: Generation,\n    },\n    Resume {\n        source: RestoreSource,\n    },\n    Kill {\n        generation: Generation,\n    },\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum FailureKind {\n    Cancelled,\n    DeadlineExceeded,\n    ResourceFailure,\n    PolicyFailure,\n    StorageFailure,\n    InternalFailure,\n}\n\nimpl FailureKind {\n    #[must_use]\n    pub const fn retryable(self) -> bool {\n        match self {\n            Self::Cancelled | Self::PolicyFailure => false,\n            Self::DeadlineExceeded\n            | Self::ResourceFailure\n            | Self::StorageFailure\n            | Self::InternalFailure => true,\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum OperationResult {\n    Running(Generation),\n    Paused(RestoreSource),\n    Destroyed,\n    Failed(FailureKind),\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum OperationKind {\n    Create,\n    Pause,\n    Resume,\n    Kill,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum OperationStatus {\n    Pending,\n    OutcomeUnknown,\n    Compensating(FailureKind),\n    Succeeded,\n    Failed(FailureKind),\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct Operation {\n    pub id: OperationId,\n    pub epoch: Epoch,\n    pub kind: OperationKind,\n    pub status: OperationStatus,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum Authority {\n    Closed,\n    Running {\n        sandbox: SandboxId,\n        generation: Generation,\n        vm: VmId,\n        workspace: FsId,\n        access: WorkspaceApiAccess,\n        slot: NetSlotId,\n        policy: NetworkPolicy,\n    },\n    Paused {\n        sandbox: SandboxId,\n        source: RestoreSource,\n    },\n}\n\nimpl Authority {\n    #[must_use]\n    pub fn without_resume(&self) -> Self {\n        match self {\n            Self::Paused { .. } => Self::Closed,\n            authority => authority.clone(),\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum Command {\n    InstallFence {\n        sandbox: SandboxId,\n        epoch: Epoch,\n        terminal: bool,\n    },\n    PrepareVm {\n        sandbox: SandboxId,\n        epoch: Epoch,\n        generation: Generation,\n        vm: VmId,\n        slot: NetSlotId,\n        source: Option<RestoreSource>,\n    },\n    ConfigureNetwork {\n        sandbox: SandboxId,\n        epoch: Epoch,\n        generation: Generation,\n        vm: VmId,\n        slot: NetSlotId,\n        policy: NetworkPolicy,\n    },\n    ActivateVm {\n        sandbox: SandboxId,\n        epoch: Epoch,\n        generation: Generation,\n        vm: VmId,\n    },\n    FreezeVm {\n        sandbox: SandboxId,\n        epoch: Epoch,\n        generation: Generation,\n        vm: VmId,\n    },\n    ApplyFilePolicy {\n        sandbox: SandboxId,\n        epoch: Epoch,\n        generation: Generation,\n        workspace: FsId,\n        policy: FilePolicyRef,\n    },\n    SealSnapshot {\n        sandbox: SandboxId,\n        epoch: Epoch,\n        generation: Generation,\n        vm: VmId,\n        workspace: FsId,\n        snapshot: SnapshotId,\n        manifest: SnapshotManifestRef,\n    },\n    CommitSnapshot {\n        sandbox: SandboxId,\n        epoch: Epoch,\n        generation: Generation,\n        snapshot: SnapshotId,\n        manifest: SnapshotManifestRef,\n    },\n    StopVm {\n        sandbox: SandboxId,\n        epoch: Epoch,\n        generation: Generation,\n        vm: VmId,\n    },\n    CleanupVm {\n        sandbox: SandboxId,\n        generation: Generation,\n        vm: VmId,\n    },\n    CleanupSlot {\n        sandbox: SandboxId,\n        generation: Generation,\n        slot: NetSlotId,\n    },\n}\n\nimpl Command {\n    #[must_use]\n    pub const fn sandbox(&self) -> SandboxId {\n        match self {\n            Self::InstallFence { sandbox, .. }\n            | Self::PrepareVm { sandbox, .. }\n            | Self::ConfigureNetwork { sandbox, .. }\n            | Self::ActivateVm { sandbox, .. }\n            | Self::FreezeVm { sandbox, .. }\n            | Self::ApplyFilePolicy { sandbox, .. }\n            | Self::SealSnapshot { sandbox, .. }\n            | Self::CommitSnapshot { sandbox, .. }\n            | Self::StopVm { sandbox, .. }\n            | Self::CleanupVm { sandbox, .. }\n            | Self::CleanupSlot { sandbox, .. } => *sandbox,\n        }\n    }\n\n    #[must_use]\n    pub const fn epoch(&self) -> Option<Epoch> {\n        match self {\n            Self::InstallFence { epoch, .. }\n            | Self::PrepareVm { epoch, .. }\n            | Self::ConfigureNetwork { epoch, .. }\n            | Self::ActivateVm { epoch, .. }\n            | Self::FreezeVm { epoch, .. }\n            | Self::ApplyFilePolicy { epoch, .. }\n            | Self::SealSnapshot { epoch, .. }\n            | Self::CommitSnapshot { epoch, .. }\n            | Self::StopVm { epoch, .. } => Some(*epoch),\n            Self::CleanupVm { .. } | Self::CleanupSlot { .. } => None,\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct LogicalEffectId {\n    pub command: Command,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct EffectId {\n    pub logical: LogicalEffectId,\n    pub attempt: AttemptNo,\n}\n\nimpl EffectId {\n    #[must_use]\n    pub fn initial(command: Command) -> Self {\n        Self {\n            logical: LogicalEffectId { command },\n            attempt: 0,\n        }\n    }\n\n    #[must_use]\n    pub const fn command(&self) -> &Command {\n        &self.logical.command\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum EffectOutcome {\n    Succeeded(ResultDigest),\n    Failed(FailureKind),\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum EffectStatus {\n    Committed,\n    Dispatched,\n    OutcomeUnknown,\n    Acknowledged(EffectOutcome),\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct OperationKey {\n    pub sandbox: SandboxId,\n    pub operation: OperationId,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct OperationPlan {\n    pub key: OperationKey,\n    pub epoch: Epoch,\n    pub generation: Generation,\n    pub vm: Option<VmId>,\n    pub slot: Option<NetSlotId>,\n    pub restore_from: Option<RestoreSource>,\n    pub target_snapshot: Option<RestoreSource>,\n    pub stop_vms: Vec<VmId>,\n    pub close_slots: Vec<NetSlotId>,\n    pub retry_limit: u64,\n    pub sealed: bool,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct ResourceIndex {\n    pub vms: Vec<VmId>,\n    pub slots: Vec<NetSlotId>,\n    pub snapshots: Vec<SnapshotId>,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum EffectOrigin {\n    Operation(OperationKey),\n    Maintenance(SandboxId),\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum LogicalEffectResult {\n    Succeeded {\n        attempt: AttemptNo,\n        result: ResultDigest,\n    },\n    Failed {\n        attempt: AttemptNo,\n        failure: FailureKind,\n    },\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct LogicalEffectRecord {\n    pub origin: EffectOrigin,\n    pub current_attempt: AttemptNo,\n    pub remaining_retries: u64,\n    pub result: Option<LogicalEffectResult>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct OperationLedgerRecord {\n    pub sandbox: SandboxId,\n    pub operation: Operation,\n    pub input: OperationInput,\n    pub result: Option<OperationResult>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct SandboxRecord {\n    pub owner: TenantId,\n    pub phase: Phase,\n    pub terminal: bool,\n    pub epoch: Epoch,\n    pub generation: Generation,\n    pub current_vm: Option<VmId>,\n    pub workspace: FsId,\n    pub workspace_access: WorkspaceApiAccess,\n    pub file_policy: FilePolicyRef,\n    pub durable_snapshot: Option<RestoreSource>,\n    pub restore_from: Option<RestoreSource>,\n    pub net_slot: Option<NetSlotId>,\n    pub policy: NetworkPolicy,\n    pub desired: Authority,\n    pub effective: Authority,\n    pub current_operation: Option<Operation>,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct Vm {\n    pub owner: TenantId,\n    pub sandbox: SandboxId,\n    pub generation: Generation,\n    pub status: VmStatus,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct Filesystem {\n    pub owner: TenantId,\n    pub sandbox: SandboxId,\n    pub created_generation: Generation,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct Snapshot {\n    pub owner: TenantId,\n    pub sandbox: SandboxId,\n    pub source_generation: Generation,\n    pub workspace: FsId,\n    pub manifest: SnapshotManifestRef,\n    pub stage: SnapshotStage,\n    pub immutable: bool,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct NetSlot {\n    pub owner: TenantId,\n    pub sandbox: SandboxId,\n    pub generation: Generation,\n    pub vm: VmId,\n    pub policy: NetworkPolicy,\n    pub configured: bool,\n    pub active: bool,\n    pub reclaimed: bool,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct AppliedFilePolicy {\n    pub sandbox: SandboxId,\n    pub generation: Generation,\n    pub workspace: FsId,\n    pub policy: FilePolicyRef,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub struct WorkerFence {\n    pub epoch: Epoch,\n    pub terminal: bool,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum Event {\n    AcceptCreate {\n        actor: Actor,\n        owner: TenantId,\n        sandbox: SandboxId,\n        workspace: FsId,\n        file_policy: FilePolicyRef,\n        policy: NetworkPolicy,\n        operation: OperationId,\n    },\n    AcceptPause {\n        actor: Actor,\n        sandbox: SandboxId,\n        operation: OperationId,\n    },\n    AcceptResume {\n        actor: Actor,\n        sandbox: SandboxId,\n        operation: OperationId,\n    },\n    AcceptKill {\n        actor: Actor,\n        sandbox: SandboxId,\n        operation: OperationId,\n    },\n    RetryOperation {\n        actor: Actor,\n        sandbox: SandboxId,\n        operation: OperationId,\n        kind: OperationKind,\n        input: OperationInput,\n    },\n    QueryOperation {\n        actor: Actor,\n        sandbox: SandboxId,\n        operation: OperationId,\n        status: OperationStatus,\n        result: Option<OperationResult>,\n    },\n    BeginCompensation {\n        sandbox: SandboxId,\n        failure: FailureKind,\n    },\n    ReserveStartupResources {\n        key: OperationKey,\n        vm: VmId,\n        slot: NetSlotId,\n    },\n    ReservePauseSnapshot {\n        key: OperationKey,\n        snapshot: SnapshotId,\n        manifest: SnapshotManifestRef,\n    },\n    DispatchPrepare {\n        sandbox: SandboxId,\n        vm: VmId,\n        slot: NetSlotId,\n        source: Option<RestoreSource>,\n    },\n    ScheduleSealSnapshot {\n        sandbox: SandboxId,\n        snapshot: SnapshotId,\n        manifest: SnapshotManifestRef,\n    },\n    ScheduleCommitSnapshot {\n        sandbox: SandboxId,\n        snapshot: SnapshotId,\n    },\n    ScheduleStopVm {\n        sandbox: SandboxId,\n        generation: Generation,\n        vm: VmId,\n    },\n    ScheduleCleanupVm {\n        sandbox: SandboxId,\n        generation: Generation,\n        vm: VmId,\n    },\n    ScheduleCleanupSlot {\n        sandbox: SandboxId,\n        generation: Generation,\n        slot: NetSlotId,\n    },\n    DispatchEffect(EffectId),\n    AcknowledgeEffect(EffectId, EffectOutcome),\n    EffectTimeout(EffectId),\n    StartNextAttempt(EffectId, EffectId),\n    FinalizeEffectFailure(EffectId, FailureKind),\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct World {\n    pub(crate) sandboxes: Store<SandboxId, SandboxRecord>,\n    pub(crate) vms: Store<VmId, Vm>,\n    pub(crate) filesystems: Store<FsId, Filesystem>,\n    pub(crate) snapshots: Store<SnapshotId, Snapshot>,\n    pub(crate) net_slots: Store<NetSlotId, NetSlot>,\n    pub(crate) applied_file_policies: Store<SandboxId, AppliedFilePolicy>,\n    pub(crate) worker_fences: Store<SandboxId, WorkerFence>,\n    pub(crate) operations: Store<OperationKey, OperationLedgerRecord>,\n    pub(crate) operation_plans: Store<OperationKey, OperationPlan>,\n    pub(crate) resource_indexes: Store<SandboxId, ResourceIndex>,\n    pub(crate) logical_effects: Store<LogicalEffectId, LogicalEffectRecord>,\n    pub(crate) effect_keys: Vec<EffectId>,\n    pub(crate) effects: Store<EffectId, EffectStatus>,\n    pub(crate) next_vm_id: u64,\n    pub(crate) next_slot_id: u64,\n    pub(crate) next_snapshot_id: u64,\n    pub(crate) next_manifest_digest: u64,\n    pub(crate) inflight: Vec<EffectId>,\n    pub(crate) controller_up: bool,\n}\n\nimpl Default for World {\n    fn default() -> Self {\n        Self {\n            sandboxes: Store::default(),\n            vms: Store::default(),\n            filesystems: Store::default(),\n            snapshots: Store::default(),\n            net_slots: Store::default(),\n            applied_file_policies: Store::default(),\n            worker_fences: Store::default(),\n            operations: Store::default(),\n            operation_plans: Store::default(),\n            resource_indexes: Store::default(),\n            logical_effects: Store::default(),\n            effect_keys: Vec::new(),\n            effects: Store::default(),\n            next_vm_id: 0,\n            next_slot_id: 0,\n            next_snapshot_id: 0,\n            next_manifest_digest: 0,\n            inflight: Vec::new(),\n            controller_up: true,\n        }\n    }\n}\n\n/// The only supported construction of a fresh durable controller state.\n///\n/// Keeping this as an explicit function gives the refinement proof a real\n/// executable initialization boundary instead of a hand-written duplicate of\n/// `World::default()`.\n#[must_use]\npub fn initial_world() -> World {\n    World::default()\n}\n\nimpl World {\n    /// Read-only integration views. They do not permit constructing or\n    /// mutating a World outside the controller reducer.\n    #[must_use]\n    pub fn sandbox_record(&self, sandbox: SandboxId) -> Option<&SandboxRecord> {\n        self.sandboxes.get(&sandbox)\n    }\n\n    #[must_use]\n    pub fn operation_record(&self, key: OperationKey) -> Option<&OperationLedgerRecord> {\n        self.operations.get(&key)\n    }\n\n    #[must_use]\n    pub fn operation_records(&self) -> &[(OperationKey, OperationLedgerRecord)] {\n        self.operations.entries()\n    }\n\n    #[must_use]\n    pub fn operation_plan(&self, key: OperationKey) -> Option<&OperationPlan> {\n        self.operation_plans.get(&key)\n    }\n\n    #[must_use]\n    pub fn effect_ids(&self) -> &[EffectId] {\n        &self.effect_keys\n    }\n\n    #[must_use]\n    pub fn effect_status(&self, effect: &EffectId) -> Option<EffectStatus> {\n        self.effects.get_copy(effect)\n    }\n\n    #[must_use]\n    pub fn logical_effect(&self, effect: &LogicalEffectId) -> Option<LogicalEffectRecord> {\n        self.logical_effects.get_copy(effect)\n    }\n\n    #[must_use]\n    pub fn resource_index(&self, sandbox: SandboxId) -> ResourceIndex {\n        self.resource_indexes\n            .get(&sandbox)\n            .cloned()\n            .unwrap_or_default()\n    }\n}\n"},{"id":8,"name":{"Local":"controller-core/src/auxiliary.rs"},"crate_name":"sandbox_controller_core","contents":"use crate::model::{Actor, Authority, Endpoint, OperationStatus, Phase, SandboxRecord, World};\nuse crate::transition::{authorized, mark_operation_outcome_unknown, operation_key};\nuse crate::{Generation, NetSlotId, SandboxId, VmId};\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum AccessInput {\n    Exec(Actor, SandboxId, VmId),\n    FileRead(Actor, SandboxId, Generation),\n    FileWrite(Actor, SandboxId, Generation),\n    Ingress(Actor, SandboxId, VmId, NetSlotId),\n    Egress(SandboxId, VmId, NetSlotId, Endpoint),\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum AuxiliaryEvent {\n    RpcTimeout(SandboxId),\n    Exec(Actor, SandboxId),\n    FileRead(Actor, SandboxId, Generation),\n    FileWrite(Actor, SandboxId, Generation),\n    Ingress(Actor, SandboxId),\n    Egress(SandboxId, Endpoint),\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum AuxiliaryReject {\n    SandboxNotFound,\n    OperationUnavailable,\n    OperationAlreadyFinal,\n    LedgerMismatch,\n    Unauthorized,\n    WrongPhase,\n    WrongGeneration,\n    CapabilityDenied,\n    DestinationDenied,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct AuxiliaryDecision {\n    pub event: AuxiliaryEvent,\n    pub next: World,\n}\n\nfn allows_exec(record: &SandboxRecord, sandbox: SandboxId, vm: VmId) -> bool {\n    match &record.effective {\n        Authority::Running {\n            sandbox: authority_sandbox,\n            generation,\n            vm: authority_vm,\n            ..\n        } => {\n            *authority_sandbox == sandbox && *generation == record.generation && *authority_vm == vm\n        }\n        Authority::Closed | Authority::Paused { .. } => false,\n    }\n}\n\nfn allows_file(record: &SandboxRecord, sandbox: SandboxId, generation: Generation) -> bool {\n    match &record.effective {\n        Authority::Running {\n            sandbox: authority_sandbox,\n            generation: authority_generation,\n            workspace,\n            access,\n            ..\n        } => {\n            *authority_sandbox == sandbox\n                && *authority_generation == generation\n                && *workspace == record.workspace\n                && *access == record.workspace_access\n        }\n        Authority::Closed | Authority::Paused { .. } => false,\n    }\n}\n\nfn allows_network(record: &SandboxRecord, sandbox: SandboxId, vm: VmId, slot: NetSlotId) -> bool {\n    match &record.effective {\n        Authority::Running {\n            sandbox: authority_sandbox,\n            generation,\n            vm: authority_vm,\n            slot: authority_slot,\n            policy,\n            ..\n        } => {\n            *authority_sandbox == sandbox\n                && *generation == record.generation\n                && *authority_vm == vm\n                && *authority_slot == slot\n                && policy == &record.policy\n        }\n        Authority::Closed | Authority::Paused { .. } => false,\n    }\n}\n\nfn destination_allowed(record: &SandboxRecord, destination: &Endpoint) -> bool {\n    match &record.policy {\n        crate::NetworkPolicy::DenyAll => false,\n        crate::NetworkPolicy::StaticAllowlist(endpoints) => {\n            let mut cursor = 0;\n            let mut allowed = false;\n            while cursor < endpoints.len() && !allowed {\n                if &endpoints[cursor] == destination {\n                    allowed = true;\n                }\n                cursor += 1;\n            }\n            allowed\n        }\n    }\n}\n\n/// Record client-side uncertainty without inventing an adapter result.\n///\n/// # Errors\n/// Returns the first failed guard in `AuxController.handleRpcTimeout`.\npub fn handle_rpc_timeout(\n    world: &World,\n    sandbox: SandboxId,\n) -> Result<AuxiliaryDecision, AuxiliaryReject> {\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(AuxiliaryReject::SandboxNotFound);\n    };\n    let Some(operation) = record.current_operation else {\n        return Err(AuxiliaryReject::OperationUnavailable);\n    };\n    if operation.status != OperationStatus::Pending {\n        return Err(AuxiliaryReject::OperationAlreadyFinal);\n    }\n    let key = operation_key(sandbox, operation.id);\n    let Some(ledger) = world.operations.get(&key) else {\n        return Err(AuxiliaryReject::OperationUnavailable);\n    };\n    if ledger.sandbox != sandbox || ledger.operation != operation || ledger.result.is_some() {\n        return Err(AuxiliaryReject::LedgerMismatch);\n    }\n    Ok(AuxiliaryDecision {\n        event: AuxiliaryEvent::RpcTimeout(sandbox),\n        next: mark_operation_outcome_unknown(world, sandbox, record, operation),\n    })\n}\n\n/// Admit an execution capability against the effective authority.\n///\n/// # Errors\n/// Returns sandbox, authorization, then capability errors in model order.\npub fn handle_exec(\n    world: &World,\n    actor: Actor,\n    sandbox: SandboxId,\n    vm: VmId,\n) -> Result<AuxiliaryDecision, AuxiliaryReject> {\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(AuxiliaryReject::SandboxNotFound);\n    };\n    if !authorized(&actor, record.owner) {\n        return Err(AuxiliaryReject::Unauthorized);\n    }\n    if !allows_exec(record, sandbox, vm) {\n        return Err(AuxiliaryReject::CapabilityDenied);\n    }\n    Ok(AuxiliaryDecision {\n        event: AuxiliaryEvent::Exec(actor, sandbox),\n        next: world.clone(),\n    })\n}\n\n/// Admit a read through the managed workspace authority.\n///\n/// # Errors\n/// Returns the first failed model guard.\npub fn handle_file_read(\n    world: &World,\n    actor: Actor,\n    sandbox: SandboxId,\n    generation: Generation,\n) -> Result<AuxiliaryDecision, AuxiliaryReject> {\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(AuxiliaryReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Running {\n        return Err(AuxiliaryReject::WrongPhase);\n    }\n    if generation != record.generation {\n        return Err(AuxiliaryReject::WrongGeneration);\n    }\n    if !authorized(&actor, record.owner) {\n        return Err(AuxiliaryReject::Unauthorized);\n    }\n    if !allows_file(record, sandbox, generation) {\n        return Err(AuxiliaryReject::CapabilityDenied);\n    }\n    Ok(AuxiliaryDecision {\n        event: AuxiliaryEvent::FileRead(actor, sandbox, generation),\n        next: world.clone(),\n    })\n}\n\n/// Admit a write through the managed workspace authority.\n///\n/// # Errors\n/// Returns the first failed model guard.\npub fn handle_file_write(\n    world: &World,\n    actor: Actor,\n    sandbox: SandboxId,\n    generation: Generation,\n) -> Result<AuxiliaryDecision, AuxiliaryReject> {\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(AuxiliaryReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Running {\n        return Err(AuxiliaryReject::WrongPhase);\n    }\n    if generation != record.generation {\n        return Err(AuxiliaryReject::WrongGeneration);\n    }\n    if !authorized(&actor, record.owner) {\n        return Err(AuxiliaryReject::Unauthorized);\n    }\n    if !allows_file(record, sandbox, generation) {\n        return Err(AuxiliaryReject::CapabilityDenied);\n    }\n    Ok(AuxiliaryDecision {\n        event: AuxiliaryEvent::FileWrite(actor, sandbox, generation),\n        next: world.clone(),\n    })\n}\n\n/// Admit ingress through the exact VM/slot authority.\n///\n/// # Errors\n/// Returns sandbox, authorization, then capability errors in model order.\npub fn handle_ingress(\n    world: &World,\n    actor: Actor,\n    sandbox: SandboxId,\n    vm: VmId,\n    slot: NetSlotId,\n) -> Result<AuxiliaryDecision, AuxiliaryReject> {\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(AuxiliaryReject::SandboxNotFound);\n    };\n    if !authorized(&actor, record.owner) {\n        return Err(AuxiliaryReject::Unauthorized);\n    }\n    if !allows_network(record, sandbox, vm, slot) {\n        return Err(AuxiliaryReject::CapabilityDenied);\n    }\n    Ok(AuxiliaryDecision {\n        event: AuxiliaryEvent::Ingress(actor, sandbox),\n        next: world.clone(),\n    })\n}\n\n/// Admit egress only through the exact running authority and a static member.\n///\n/// # Errors\n/// Returns sandbox, capability, then destination errors in model order.\npub fn handle_egress(\n    world: &World,\n    sandbox: SandboxId,\n    vm: VmId,\n    slot: NetSlotId,\n    destination: Endpoint,\n) -> Result<AuxiliaryDecision, AuxiliaryReject> {\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(AuxiliaryReject::SandboxNotFound);\n    };\n    if !allows_network(record, sandbox, vm, slot) {\n        return Err(AuxiliaryReject::CapabilityDenied);\n    }\n    if !destination_allowed(record, &destination) {\n        return Err(AuxiliaryReject::DestinationDenied);\n    }\n    Ok(AuxiliaryDecision {\n        event: AuxiliaryEvent::Egress(sandbox, destination),\n        next: world.clone(),\n    })\n}\n\n/// Execute one capability request through the same split as Lean.\n///\n/// # Errors\n/// Returns the selected handler's first failed guard.\npub fn handle_access(\n    world: &World,\n    input: AccessInput,\n) -> Result<AuxiliaryDecision, AuxiliaryReject> {\n    match input {\n        AccessInput::Exec(actor, sandbox, vm) => handle_exec(world, actor, sandbox, vm),\n        AccessInput::FileRead(actor, sandbox, generation) => {\n            handle_file_read(world, actor, sandbox, generation)\n        }\n        AccessInput::FileWrite(actor, sandbox, generation) => {\n            handle_file_write(world, actor, sandbox, generation)\n        }\n        AccessInput::Ingress(actor, sandbox, vm, slot) => {\n            handle_ingress(world, actor, sandbox, vm, slot)\n        }\n        AccessInput::Egress(sandbox, vm, slot, destination) => {\n            handle_egress(world, sandbox, vm, slot, destination)\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{\n        AccessInput, AuxiliaryEvent, AuxiliaryReject, handle_access, handle_egress,\n        handle_file_read, handle_rpc_timeout,\n    };\n    use crate::model::{\n        Actor, Authority, Endpoint, NetworkPolicy, OperationResult, OperationStatus, Protocol,\n        WorkspaceApiAccess,\n    };\n    use crate::request::{CreateRequest, handle_create};\n    use crate::transition::operation_key;\n    use crate::{\n        FilePolicyRef, FsId, NetSlotId, OperationId, PolicyDigest, SandboxId, TenantId, VmId, World,\n    };\n\n    const OWNER: TenantId = TenantId(1);\n    const SID: SandboxId = SandboxId(2);\n    const VM: VmId = VmId(3);\n    const SLOT: NetSlotId = NetSlotId(4);\n    const OPERATION: OperationId = OperationId(5);\n    const WORKSPACE: FsId = FsId(6);\n\n    fn endpoint(port: u64) -> Endpoint {\n        Endpoint {\n            address: \"203.0.113.1\".to_owned(),\n            prefix_length: 32,\n            protocol: Protocol::Tcp,\n            port,\n        }\n    }\n\n    fn created() -> World {\n        handle_create(\n            &World::default(),\n            CreateRequest {\n                actor: Actor::Tenant(OWNER),\n                owner: OWNER,\n                sandbox: SID,\n                workspace: WORKSPACE,\n                file_policy: FilePolicyRef {\n                    digest: PolicyDigest(7),\n                },\n                policy: NetworkPolicy::DenyAll,\n                operation: OPERATION,\n            },\n        )\n        .expect(\"create\")\n        .next\n    }\n\n    fn running() -> World {\n        let mut world = created();\n        let destination = endpoint(443);\n        let record = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        let mut running = record;\n        running.phase = crate::Phase::Running;\n        running.effective = Authority::Running {\n            sandbox: SID,\n            generation: 1,\n            vm: VM,\n            workspace: WORKSPACE,\n            access: WorkspaceApiAccess::ManagedReadWrite,\n            slot: SLOT,\n            policy: NetworkPolicy::StaticAllowlist(vec![destination]),\n        };\n        running.policy = NetworkPolicy::StaticAllowlist(vec![endpoint(443)]);\n        world.sandboxes.put(SID, running);\n        world\n    }\n\n    #[test]\n    fn timeout_marks_both_current_operation_and_ledger_unknown() {\n        let world = created();\n        let decision = handle_rpc_timeout(&world, SID).expect(\"timeout\");\n        assert_eq!(decision.event, AuxiliaryEvent::RpcTimeout(SID));\n        assert_eq!(\n            decision\n                .next\n                .sandboxes\n                .get(&SID)\n                .and_then(|record| record.current_operation)\n                .map(|operation| operation.status),\n            Some(OperationStatus::OutcomeUnknown)\n        );\n        let ledger = decision\n            .next\n            .operations\n            .get(&operation_key(SID, OPERATION))\n            .expect(\"ledger\");\n        assert_eq!(ledger.operation.status, OperationStatus::OutcomeUnknown);\n        assert_eq!(ledger.result, None::<OperationResult>);\n    }\n\n    #[test]\n    fn timeout_changes_only_the_two_operation_records() {\n        let world = created();\n        let mut expected = world.clone();\n        let mut record = expected.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        record.current_operation.as_mut().expect(\"operation\").status =\n            OperationStatus::OutcomeUnknown;\n        expected.sandboxes.put(SID, record);\n        let key = operation_key(SID, OPERATION);\n        let mut ledger = expected.operations.get(&key).expect(\"ledger\").clone();\n        ledger.operation.status = OperationStatus::OutcomeUnknown;\n        expected.operations.put(key, ledger);\n\n        let decision = handle_rpc_timeout(&world, SID).expect(\"timeout\");\n        assert_eq!(decision.next, expected);\n        assert_eq!(world, created());\n        assert_eq!(\n            handle_rpc_timeout(&decision.next, SID),\n            Err(AuxiliaryReject::OperationAlreadyFinal)\n        );\n    }\n\n    #[test]\n    fn timeout_rejects_missing_sandbox_operation_and_ledger() {\n        assert_eq!(\n            handle_rpc_timeout(&World::default(), SID),\n            Err(AuxiliaryReject::SandboxNotFound)\n        );\n        let mut world = created();\n        let mut record = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        record.current_operation = None;\n        world.sandboxes.put(SID, record);\n        assert_eq!(\n            handle_rpc_timeout(&world, SID),\n            Err(AuxiliaryReject::OperationUnavailable)\n        );\n\n        let mut world = created();\n        world.operations = crate::store::Store::default();\n        assert_eq!(\n            handle_rpc_timeout(&world, SID),\n            Err(AuxiliaryReject::OperationUnavailable)\n        );\n    }\n\n    #[test]\n    fn timeout_rejects_each_ledger_inconsistency_without_mutation() {\n        let key = operation_key(SID, OPERATION);\n        for mismatch in 0..3 {\n            let mut world = created();\n            let mut ledger = world.operations.get(&key).expect(\"ledger\").clone();\n            match mismatch {\n                0 => ledger.sandbox = SandboxId(99),\n                1 => ledger.operation.id = OperationId(99),\n                _ => ledger.result = Some(OperationResult::Destroyed),\n            }\n            world.operations.put(key, ledger);\n            let before = world.clone();\n            assert_eq!(\n                handle_rpc_timeout(&world, SID),\n                Err(AuxiliaryReject::LedgerMismatch)\n            );\n            assert_eq!(world, before);\n        }\n    }\n\n    #[test]\n    fn timeout_checks_nonpending_status_before_missing_ledger() {\n        for status in [\n            OperationStatus::OutcomeUnknown,\n            OperationStatus::Succeeded,\n            OperationStatus::Failed(crate::FailureKind::PolicyFailure),\n            OperationStatus::Compensating(crate::FailureKind::PolicyFailure),\n        ] {\n            let mut world = created();\n            let mut record = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n            record.current_operation.as_mut().expect(\"operation\").status = status;\n            world.sandboxes.put(SID, record);\n            world.operations = crate::store::Store::default();\n            assert_eq!(\n                handle_rpc_timeout(&world, SID),\n                Err(AuxiliaryReject::OperationAlreadyFinal)\n            );\n        }\n    }\n\n    #[test]\n    fn access_requires_exact_effective_authority_and_owner() {\n        let world = running();\n        assert_eq!(\n            handle_access(&world, AccessInput::Exec(Actor::Tenant(OWNER), SID, VM))\n                .map(|decision| decision.event),\n            Ok(AuxiliaryEvent::Exec(Actor::Tenant(OWNER), SID))\n        );\n        assert_eq!(\n            handle_access(\n                &world,\n                AccessInput::Exec(Actor::Tenant(TenantId(99)), SID, VM)\n            ),\n            Err(AuxiliaryReject::Unauthorized)\n        );\n        assert_eq!(\n            handle_file_read(&world, Actor::Tenant(OWNER), SID, 2),\n            Err(AuxiliaryReject::WrongGeneration)\n        );\n    }\n\n    #[test]\n    fn egress_is_fail_closed_and_uses_static_exact_membership() {\n        let world = running();\n        assert_eq!(\n            handle_egress(&world, SID, VM, SLOT, endpoint(443)).map(|decision| decision.event),\n            Ok(AuxiliaryEvent::Egress(SID, endpoint(443)))\n        );\n        assert_eq!(\n            handle_egress(&world, SID, VM, SLOT, endpoint(80)),\n            Err(AuxiliaryReject::DestinationDenied)\n        );\n        assert_eq!(\n            handle_egress(&world, SID, VmId(99), SLOT, endpoint(443)),\n            Err(AuxiliaryReject::CapabilityDenied)\n        );\n    }\n}\n"},{"id":9,"name":{"Local":"controller-core/src/effect.rs"},"crate_name":"sandbox_controller_core","contents":"use crate::model::{\n    Command, EffectId, EffectOutcome, EffectStatus, Event, FailureKind, LogicalEffectId,\n    LogicalEffectResult, VmStatus, World,\n};\n\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum EffectInput {\n    Dispatch(EffectId),\n    Receipt(EffectId, EffectOutcome),\n    Timeout(EffectId),\n    Retry(LogicalEffectId, FailureKind),\n    FinalizeFailure(LogicalEffectId, FailureKind),\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum EffectReject {\n    ControllerDown,\n    EffectNotFound,\n    LogicalEffectNotFound,\n    LogicalEffectAlreadyFinal,\n    NotDispatchable,\n    NotAwaitingResult,\n    InvalidOutcomeEvidence,\n    ConflictingReceipt,\n    NotDispatched,\n    CurrentAttemptNotFailed,\n    FailureMismatch,\n    FailureNotRetryable,\n    RetryBudgetExhausted,\n    NextAttemptExists,\n    RetryStillAvailable,\n    CounterExhausted,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct EffectDecision {\n    pub event: Event,\n    pub next: World,\n}\n\nfn insert_unique<T: Clone + PartialEq>(values: &mut Vec<T>, value: T) {\n    let mut index = 0;\n    while index < values.len() {\n        if values[index] == value {\n            return;\n        }\n        index += 1;\n    }\n\n    let mut next = Vec::new();\n    next.push(value);\n    index = 0;\n    while index < values.len() {\n        next.push(values[index].clone());\n        index += 1;\n    }\n    *values = next;\n}\n\n/// Executable counterpart of the model's command-specific success evidence.\n/// A successful receipt is accepted only after the corresponding durable\n/// resource state is already observable.\n#[must_use]\n#[allow(clippy::too_many_lines)]\npub fn command_result_present(world: &World, command: &Command) -> bool {\n    match command {\n        Command::InstallFence {\n            sandbox,\n            epoch,\n            terminal,\n        } => match world.worker_fences.get(sandbox) {\n            Some(fence) => *epoch <= fence.epoch && (!*terminal || fence.terminal),\n            None => false,\n        },\n        Command::PrepareVm {\n            sandbox,\n            generation,\n            vm,\n            slot,\n            ..\n        } => match (world.vms.get(vm), world.net_slots.get(slot)) {\n            (Some(vm_record), Some(slot_record)) => {\n                vm_record.sandbox == *sandbox\n                    && vm_record.generation == *generation\n                    && slot_record.sandbox == *sandbox\n                    && slot_record.generation == *generation\n                    && slot_record.vm == *vm\n            }\n            _ => false,\n        },\n        Command::ConfigureNetwork {\n            sandbox,\n            generation,\n            vm,\n            slot,\n            policy,\n            ..\n        } => match world.net_slots.get(slot) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.generation == *generation\n                    && record.vm == *vm\n                    && record.policy == *policy\n                    && record.configured\n            }\n            None => false,\n        },\n        Command::ActivateVm {\n            sandbox,\n            generation,\n            vm,\n            ..\n        } => match world.vms.get(vm) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.generation == *generation\n                    && matches!(\n                        record.status,\n                        VmStatus::Executing\n                            | VmStatus::Frozen\n                            | VmStatus::Stopped\n                            | VmStatus::Reclaimed\n                    )\n            }\n            None => false,\n        },\n        Command::FreezeVm {\n            sandbox,\n            generation,\n            vm,\n            ..\n        } => match world.vms.get(vm) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.generation == *generation\n                    && matches!(\n                        record.status,\n                        VmStatus::Frozen | VmStatus::Stopped | VmStatus::Reclaimed\n                    )\n            }\n            None => false,\n        },\n        Command::ApplyFilePolicy {\n            sandbox,\n            generation,\n            workspace,\n            policy,\n            ..\n        } => match world.applied_file_policies.get(sandbox) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && *generation <= record.generation\n                    && record.workspace == *workspace\n                    && record.policy == *policy\n            }\n            None => false,\n        },\n        Command::SealSnapshot {\n            sandbox,\n            generation,\n            workspace,\n            snapshot,\n            manifest,\n            ..\n        } => match world.snapshots.get(snapshot) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.source_generation == *generation\n                    && record.workspace == *workspace\n                    && record.manifest == *manifest\n            }\n            None => false,\n        },\n        Command::CommitSnapshot {\n            sandbox,\n            generation,\n            snapshot,\n            manifest,\n            ..\n        } => match world.snapshots.get(snapshot) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.source_generation == *generation\n                    && record.manifest == *manifest\n                    && record.stage == crate::SnapshotStage::Durable\n                    && record.immutable\n            }\n            None => false,\n        },\n        Command::StopVm {\n            sandbox,\n            generation,\n            vm,\n            ..\n        } => match world.vms.get(vm) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.generation == *generation\n                    && matches!(record.status, VmStatus::Stopped | VmStatus::Reclaimed)\n            }\n            None => false,\n        },\n        Command::CleanupVm {\n            sandbox,\n            generation,\n            vm,\n        } => match world.vms.get(vm) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.generation == *generation\n                    && record.status == VmStatus::Reclaimed\n            }\n            None => false,\n        },\n        Command::CleanupSlot {\n            sandbox,\n            generation,\n            slot,\n        } => match world.net_slots.get(slot) {\n            Some(record) => {\n                record.sandbox == *sandbox && record.generation == *generation && record.reclaimed\n            }\n            None => false,\n        },\n    }\n}\n\n/// Return whether the current attempt of a logical command has a successful\n/// acknowledged receipt, matching Lean's `effectSucceededCheck`.\n#[must_use]\npub fn effect_succeeded_check(world: &World, command: &Command) -> bool {\n    let logical = LogicalEffectId {\n        command: command.clone(),\n    };\n    let attempt = match world.logical_effects.get_copy(&logical) {\n        Some(record) => record.current_attempt,\n        None => 0,\n    };\n    let id = EffectId { logical, attempt };\n    match world.effects.get(&id) {\n        Some(EffectStatus::Acknowledged(EffectOutcome::Succeeded(_))) => true,\n        Some(\n            EffectStatus::Committed\n            | EffectStatus::Dispatched\n            | EffectStatus::OutcomeUnknown\n            | EffectStatus::Acknowledged(EffectOutcome::Failed(_)),\n        )\n        | None => false,\n    }\n}\n\n#[must_use]\npub fn effect_outcome_valid(world: &World, command: &Command, outcome: EffectOutcome) -> bool {\n    match outcome {\n        EffectOutcome::Succeeded(_) => command_result_present(world, command),\n        EffectOutcome::Failed(_) => !command_result_present(world, command),\n    }\n}\n\n#[must_use]\npub fn dispatch_effect(world: &World, id: EffectId) -> World {\n    let mut next = world.clone();\n    next.effects.put(id, EffectStatus::Dispatched);\n    next\n}\n\n#[must_use]\npub fn acknowledge_effect(world: &World, id: EffectId, outcome: EffectOutcome) -> World {\n    let mut next = world.clone();\n    if let Some(stored) = world.logical_effects.get(&id.logical) {\n        let mut record = *stored;\n        if record.current_attempt == id.attempt\n            && let EffectOutcome::Succeeded(result) = outcome\n        {\n            record.result = Some(LogicalEffectResult::Succeeded {\n                attempt: id.attempt,\n                result,\n            });\n            next.logical_effects.put(id.logical.clone(), record);\n        }\n    }\n    next.effects\n        .put(id.clone(), EffectStatus::Acknowledged(outcome));\n    insert_unique(&mut next.effect_keys, id);\n    next\n}\n\n#[must_use]\npub fn mark_effect_outcome_unknown(world: &World, id: EffectId) -> World {\n    let mut next = world.clone();\n    next.effects.put(id, EffectStatus::OutcomeUnknown);\n    next\n}\n\n#[must_use]\npub fn start_next_attempt(world: &World, logical: LogicalEffectId, failure: FailureKind) -> World {\n    let Some(stored) = world.logical_effects.get(&logical) else {\n        return world.clone();\n    };\n    let mut record = *stored;\n    let previous = EffectId {\n        logical: logical.clone(),\n        attempt: record.current_attempt,\n    };\n    if world.effects.get(&previous)\n        != Some(&EffectStatus::Acknowledged(EffectOutcome::Failed(failure)))\n        || !failure.retryable()\n        || record.remaining_retries == 0\n    {\n        return world.clone();\n    }\n    if record.current_attempt == u64::MAX {\n        return world.clone();\n    }\n    let next_attempt = record.current_attempt + 1;\n    let next_id = EffectId {\n        logical: logical.clone(),\n        attempt: next_attempt,\n    };\n    if world.effects.contains_key(&next_id) {\n        return world.clone();\n    }\n\n    record.current_attempt = next_attempt;\n    record.remaining_retries -= 1;\n    let mut next = world.clone();\n    next.effects.put(next_id.clone(), EffectStatus::Committed);\n    insert_unique(&mut next.effect_keys, next_id.clone());\n    next.logical_effects.put(logical, record);\n    insert_unique(&mut next.inflight, next_id);\n    next\n}\n\n#[must_use]\npub fn finalize_logical_failure(\n    world: &World,\n    logical: LogicalEffectId,\n    failure: FailureKind,\n) -> World {\n    let Some(stored) = world.logical_effects.get(&logical) else {\n        return world.clone();\n    };\n    let mut record = *stored;\n    let current = EffectId {\n        logical: logical.clone(),\n        attempt: record.current_attempt,\n    };\n    if world.effects.get(&current)\n        != Some(&EffectStatus::Acknowledged(EffectOutcome::Failed(failure)))\n    {\n        return world.clone();\n    }\n    record.result = Some(LogicalEffectResult::Failed {\n        attempt: record.current_attempt,\n        failure,\n    });\n    let mut next = world.clone();\n    next.logical_effects.put(logical, record);\n    next\n}\n\n/// Mirrors `Controller.handleEffectDispatch`.\n///\n/// # Errors\n/// Returns the first failed guard in the same order as the Lean reducer.\npub fn handle_effect_dispatch(world: &World, id: EffectId) -> Result<EffectDecision, EffectReject> {\n    if !world.controller_up {\n        return Err(EffectReject::ControllerDown);\n    }\n    match world.effects.get(&id) {\n        None => Err(EffectReject::EffectNotFound),\n        Some(EffectStatus::Committed | EffectStatus::OutcomeUnknown) => Ok(EffectDecision {\n            event: Event::DispatchEffect(id.clone()),\n            next: dispatch_effect(world, id),\n        }),\n        Some(EffectStatus::Dispatched | EffectStatus::Acknowledged(_)) => {\n            Err(EffectReject::NotDispatchable)\n        }\n    }\n}\n\n/// Mirrors `Controller.handleEffectReceipt`.\n///\n/// # Errors\n/// Returns the first failed guard in the same order as the Lean reducer.\npub fn handle_effect_receipt(\n    world: &World,\n    id: EffectId,\n    outcome: EffectOutcome,\n) -> Result<EffectDecision, EffectReject> {\n    match world.effects.get(&id) {\n        None => Err(EffectReject::EffectNotFound),\n        Some(EffectStatus::Dispatched | EffectStatus::OutcomeUnknown) => {\n            if !effect_outcome_valid(world, id.command(), outcome) {\n                return Err(EffectReject::InvalidOutcomeEvidence);\n            }\n            Ok(EffectDecision {\n                event: Event::AcknowledgeEffect(id.clone(), outcome),\n                next: acknowledge_effect(world, id, outcome),\n            })\n        }\n        Some(EffectStatus::Acknowledged(recorded)) => {\n            if *recorded != outcome {\n                return Err(EffectReject::ConflictingReceipt);\n            }\n            Ok(EffectDecision {\n                event: Event::AcknowledgeEffect(id, outcome),\n                next: world.clone(),\n            })\n        }\n        Some(EffectStatus::Committed) => Err(EffectReject::NotAwaitingResult),\n    }\n}\n\n/// Mirrors `Controller.handleEffectTimeout`.\n///\n/// # Errors\n/// Returns the first failed guard in the same order as the Lean reducer.\npub fn handle_effect_timeout(world: &World, id: EffectId) -> Result<EffectDecision, EffectReject> {\n    match world.effects.get(&id) {\n        None => Err(EffectReject::EffectNotFound),\n        Some(EffectStatus::Dispatched) => Ok(EffectDecision {\n            event: Event::EffectTimeout(id.clone()),\n            next: mark_effect_outcome_unknown(world, id),\n        }),\n        Some(EffectStatus::OutcomeUnknown) => Ok(EffectDecision {\n            event: Event::EffectTimeout(id),\n            next: world.clone(),\n        }),\n        Some(EffectStatus::Committed | EffectStatus::Acknowledged(_)) => {\n            Err(EffectReject::NotDispatched)\n        }\n    }\n}\n\n/// Mirrors `Controller.handleEffectRetry`, with one concrete-machine guard:\n/// `u64::MAX` cannot represent the model's next natural-number attempt.\n///\n/// # Errors\n/// Returns the first failed guard in the same order as the Lean reducer.\npub fn handle_effect_retry(\n    world: &World,\n    logical: LogicalEffectId,\n    failure: FailureKind,\n) -> Result<EffectDecision, EffectReject> {\n    if !world.controller_up {\n        return Err(EffectReject::ControllerDown);\n    }\n    let Some(stored) = world.logical_effects.get(&logical) else {\n        return Err(EffectReject::LogicalEffectNotFound);\n    };\n    let record = *stored;\n    if record.result.is_some() {\n        return Err(EffectReject::LogicalEffectAlreadyFinal);\n    }\n    let previous = EffectId {\n        logical: logical.clone(),\n        attempt: record.current_attempt,\n    };\n    let Some(EffectStatus::Acknowledged(EffectOutcome::Failed(observed))) =\n        world.effects.get(&previous)\n    else {\n        return Err(EffectReject::CurrentAttemptNotFailed);\n    };\n    if *observed != failure {\n        return Err(EffectReject::FailureMismatch);\n    }\n    if !failure.retryable() {\n        return Err(EffectReject::FailureNotRetryable);\n    }\n    if record.remaining_retries == 0 {\n        return Err(EffectReject::RetryBudgetExhausted);\n    }\n    if record.current_attempt == u64::MAX {\n        return Err(EffectReject::CounterExhausted);\n    }\n    let next_attempt = record.current_attempt + 1;\n    let next = EffectId {\n        logical: logical.clone(),\n        attempt: next_attempt,\n    };\n    if world.effects.contains_key(&next) {\n        return Err(EffectReject::NextAttemptExists);\n    }\n\n    Ok(EffectDecision {\n        event: Event::StartNextAttempt(previous, next),\n        next: start_next_attempt(world, logical, failure),\n    })\n}\n\n/// Mirrors `Controller.handleEffectFinalizeFailure`.\n///\n/// # Errors\n/// Returns the first failed guard in the same order as the Lean reducer.\npub fn handle_effect_finalize_failure(\n    world: &World,\n    logical: LogicalEffectId,\n    failure: FailureKind,\n) -> Result<EffectDecision, EffectReject> {\n    if !world.controller_up {\n        return Err(EffectReject::ControllerDown);\n    }\n    let Some(stored) = world.logical_effects.get(&logical) else {\n        return Err(EffectReject::LogicalEffectNotFound);\n    };\n    let record = *stored;\n    if record.result.is_some() {\n        return Err(EffectReject::LogicalEffectAlreadyFinal);\n    }\n    let current = EffectId {\n        logical: logical.clone(),\n        attempt: record.current_attempt,\n    };\n    let Some(EffectStatus::Acknowledged(EffectOutcome::Failed(observed))) =\n        world.effects.get(&current)\n    else {\n        return Err(EffectReject::CurrentAttemptNotFailed);\n    };\n    if *observed != failure {\n        return Err(EffectReject::FailureMismatch);\n    }\n    if failure.retryable() && record.remaining_retries != 0 {\n        return Err(EffectReject::RetryStillAvailable);\n    }\n\n    Ok(EffectDecision {\n        event: Event::FinalizeEffectFailure(current, failure),\n        next: finalize_logical_failure(world, logical, failure),\n    })\n}\n\n/// Dispatches one of the finite effect-ledger inputs.\n///\n/// # Errors\n/// Returns the corresponding handler rejection without mutating `world`.\npub fn handle_effect(world: &World, input: EffectInput) -> Result<EffectDecision, EffectReject> {\n    match input {\n        EffectInput::Dispatch(id) => handle_effect_dispatch(world, id),\n        EffectInput::Receipt(id, outcome) => handle_effect_receipt(world, id, outcome),\n        EffectInput::Timeout(id) => handle_effect_timeout(world, id),\n        EffectInput::Retry(logical, failure) => handle_effect_retry(world, logical, failure),\n        EffectInput::FinalizeFailure(logical, failure) => {\n            handle_effect_finalize_failure(world, logical, failure)\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{\n        EffectReject, effect_succeeded_check, handle_effect_dispatch,\n        handle_effect_finalize_failure, handle_effect_receipt, handle_effect_retry,\n        handle_effect_timeout,\n    };\n    use crate::model::{\n        Actor, Command, EffectId, EffectOutcome, EffectStatus, FilePolicyRef, LogicalEffectId,\n        LogicalEffectResult, NetworkPolicy, WorkerFence, World,\n    };\n    use crate::request::{CreateRequest, handle_create};\n    use crate::{FailureKind, FsId, OperationId, PolicyDigest, ResultDigest, SandboxId, TenantId};\n\n    const SID: SandboxId = SandboxId(11);\n\n    fn created_fence() -> (World, LogicalEffectId, EffectId) {\n        let decision = handle_create(\n            &World::default(),\n            CreateRequest {\n                actor: Actor::Tenant(TenantId(7)),\n                owner: TenantId(7),\n                sandbox: SID,\n                workspace: FsId(13),\n                file_policy: FilePolicyRef {\n                    digest: PolicyDigest(17),\n                },\n                policy: NetworkPolicy::DenyAll,\n                operation: OperationId(19),\n            },\n        )\n        .expect(\"create\");\n        let logical = LogicalEffectId {\n            command: Command::InstallFence {\n                sandbox: SID,\n                epoch: 1,\n                terminal: false,\n            },\n        };\n        let id = EffectId {\n            logical: logical.clone(),\n            attempt: 0,\n        };\n        (decision.next, logical, id)\n    }\n\n    #[test]\n    fn succeeded_check_reads_only_the_current_attempt() {\n        let (mut world, logical, first) = created_fence();\n        world.effects.put(\n            first,\n            EffectStatus::Acknowledged(EffectOutcome::Succeeded(ResultDigest(31))),\n        );\n        assert!(effect_succeeded_check(&world, &logical.command));\n\n        let mut record = *world.logical_effects.get(&logical).expect(\"logical\");\n        record.current_attempt = 1;\n        world.logical_effects.put(logical.clone(), record);\n        let current = EffectId {\n            logical: logical.clone(),\n            attempt: 1,\n        };\n        world.effects.put(\n            current.clone(),\n            EffectStatus::Acknowledged(EffectOutcome::Failed(FailureKind::ResourceFailure)),\n        );\n        assert!(!effect_succeeded_check(&world, &logical.command));\n\n        world.effects.put(\n            current,\n            EffectStatus::Acknowledged(EffectOutcome::Succeeded(ResultDigest(37))),\n        );\n        assert!(effect_succeeded_check(&world, &logical.command));\n    }\n\n    #[test]\n    fn timeout_never_creates_a_new_attempt() {\n        let (world, logical, id) = created_fence();\n        let dispatched = handle_effect_dispatch(&world, id.clone()).expect(\"dispatch\");\n        let timed_out = handle_effect_timeout(&dispatched.next, id.clone()).expect(\"timeout\");\n\n        assert_eq!(\n            timed_out.next.effects.get(&id),\n            Some(&EffectStatus::OutcomeUnknown)\n        );\n        assert_eq!(\n            timed_out\n                .next\n                .logical_effects\n                .get(&logical)\n                .expect(\"logical\")\n                .current_attempt,\n            0\n        );\n        assert_eq!(\n            handle_effect_retry(&timed_out.next, logical, FailureKind::ResourceFailure),\n            Err(EffectReject::CurrentAttemptNotFailed)\n        );\n    }\n\n    #[test]\n    fn explicit_retryable_failure_creates_exactly_the_next_attempt() {\n        let (world, logical, id) = created_fence();\n        let dispatched = handle_effect_dispatch(&world, id.clone()).expect(\"dispatch\");\n        let receipt = handle_effect_receipt(\n            &dispatched.next,\n            id.clone(),\n            EffectOutcome::Failed(FailureKind::ResourceFailure),\n        )\n        .expect(\"failed receipt\");\n        let retried =\n            handle_effect_retry(&receipt.next, logical.clone(), FailureKind::ResourceFailure)\n                .expect(\"retry\");\n        let next_id = EffectId {\n            logical: logical.clone(),\n            attempt: 1,\n        };\n\n        assert_eq!(\n            retried.next.effects.get(&id),\n            Some(&EffectStatus::Acknowledged(EffectOutcome::Failed(\n                FailureKind::ResourceFailure\n            )))\n        );\n        assert_eq!(\n            retried.next.effects.get(&next_id),\n            Some(&EffectStatus::Committed)\n        );\n        assert_eq!(\n            retried\n                .next\n                .logical_effects\n                .get(&logical)\n                .expect(\"logical\")\n                .current_attempt,\n            1\n        );\n        assert_eq!(\n            retried\n                .next\n                .logical_effects\n                .get(&logical)\n                .expect(\"logical\")\n                .remaining_retries,\n            2\n        );\n        assert_eq!(retried.next.inflight.first(), Some(&next_id));\n    }\n\n    #[test]\n    fn successful_receipt_requires_observable_command_result() {\n        let (world, logical, id) = created_fence();\n        let dispatched = handle_effect_dispatch(&world, id.clone()).expect(\"dispatch\");\n        let outcome = EffectOutcome::Succeeded(ResultDigest(31));\n        assert_eq!(\n            handle_effect_receipt(&dispatched.next, id.clone(), outcome),\n            Err(EffectReject::InvalidOutcomeEvidence)\n        );\n\n        let mut observed = dispatched.next;\n        observed.worker_fences.put(\n            SID,\n            WorkerFence {\n                epoch: 1,\n                terminal: false,\n            },\n        );\n        let accepted =\n            handle_effect_receipt(&observed, id.clone(), outcome).expect(\"valid receipt\");\n        assert_eq!(\n            accepted\n                .next\n                .logical_effects\n                .get(&logical)\n                .expect(\"logical\")\n                .result,\n            Some(LogicalEffectResult::Succeeded {\n                attempt: 0,\n                result: ResultDigest(31),\n            })\n        );\n\n        let replay =\n            handle_effect_receipt(&accepted.next, id.clone(), outcome).expect(\"same replay\");\n        assert_eq!(replay.next, accepted.next);\n        assert_eq!(\n            handle_effect_receipt(\n                &accepted.next,\n                id,\n                EffectOutcome::Succeeded(ResultDigest(32))\n            ),\n            Err(EffectReject::ConflictingReceipt)\n        );\n    }\n\n    #[test]\n    fn non_retryable_failure_is_finalized_without_skipping_a_retry() {\n        let (world, logical, id) = created_fence();\n        let dispatched = handle_effect_dispatch(&world, id.clone()).expect(\"dispatch\");\n        let receipt = handle_effect_receipt(\n            &dispatched.next,\n            id,\n            EffectOutcome::Failed(FailureKind::PolicyFailure),\n        )\n        .expect(\"failed receipt\");\n        assert_eq!(\n            handle_effect_retry(&receipt.next, logical.clone(), FailureKind::PolicyFailure),\n            Err(EffectReject::FailureNotRetryable)\n        );\n        let finalized = handle_effect_finalize_failure(\n            &receipt.next,\n            logical.clone(),\n            FailureKind::PolicyFailure,\n        )\n        .expect(\"finalize\");\n        assert_eq!(\n            finalized\n                .next\n                .logical_effects\n                .get(&logical)\n                .expect(\"logical\")\n                .result,\n            Some(LogicalEffectResult::Failed {\n                attempt: 0,\n                failure: FailureKind::PolicyFailure,\n            })\n        );\n    }\n\n    #[test]\n    fn retry_reports_the_concrete_counter_boundary() {\n        let (mut world, logical, _) = created_fence();\n        let mut record = *world.logical_effects.get(&logical).expect(\"logical\");\n        record.current_attempt = u64::MAX;\n        world.logical_effects.put(logical.clone(), record);\n        let id = EffectId {\n            logical: logical.clone(),\n            attempt: u64::MAX,\n        };\n        world.effects.put(\n            id,\n            EffectStatus::Acknowledged(EffectOutcome::Failed(FailureKind::ResourceFailure)),\n        );\n\n        assert_eq!(\n            handle_effect_retry(&world, logical, FailureKind::ResourceFailure),\n            Err(EffectReject::CounterExhausted)\n        );\n    }\n}\n"},{"id":10,"name":{"Local":"controller-core/src/scheduler.rs"},"crate_name":"sandbox_controller_core","contents":"use crate::effect::effect_succeeded_check;\nuse crate::model::{\n    Command, Event, OperationKey, Phase, RestoreSource, SandboxRecord, SnapshotStage, WorkerFence,\n    World,\n};\nuse crate::request::Decision;\nuse crate::transition::{\n    enqueue, operation_key, reserve_pause_snapshot, reserve_startup_resources,\n};\nuse crate::{\n    Generation, ManifestDigest, NetSlotId, SandboxId, SnapshotId, SnapshotManifestRef, VmId,\n};\n\n/// Rejections produced by the executable scheduler reducer.\n///\n/// `CounterExhausted` is the finite-machine refinement boundary for Lean's\n/// unbounded natural-number allocation cursors.  It is checked only after all\n/// guards present in the Lean handler have accepted the input.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum SchedulerReject {\n    ControllerDown,\n    SandboxNotFound,\n    OperationUnavailable,\n    PlanUnavailable,\n    VmNotFound,\n    SlotNotFound,\n    SnapshotNotFound,\n    WrongPhase,\n    Terminal,\n    PlanMismatch,\n    PlanAlreadySealed,\n    PlanNotOpen,\n    FenceNotInstalled,\n    ResourceAlreadyExists,\n    RestoreSourceUnavailable,\n    PrerequisiteNotSucceeded,\n    ResourceMismatch,\n    ResourceNotPlanned,\n    ResourceNotReady,\n    ResourceStillCurrent,\n    AlreadyReclaimed,\n    CounterExhausted,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum SchedulerInput {\n    ReserveStartup(OperationKey),\n    ReservePauseSnapshot(OperationKey),\n    DispatchPrepare(SandboxId, VmId, NetSlotId),\n    SealSnapshot(SandboxId, SnapshotId, SnapshotManifestRef),\n    CommitSnapshot(SandboxId, SnapshotId),\n    StopVm(SandboxId, Generation, VmId),\n    CleanupVm(SandboxId, Generation, VmId),\n    CleanupSlot(SandboxId, Generation, NetSlotId),\n}\n\nconst fn stoppable_vm_status(status: crate::VmStatus) -> bool {\n    match status {\n        crate::VmStatus::Prepared | crate::VmStatus::Executing | crate::VmStatus::Frozen => true,\n        crate::VmStatus::Stopped | crate::VmStatus::Reclaimed => false,\n    }\n}\n\n/// Rust implementation of Lean's `Controller.handleReserveStartup`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's ordered guards.  Once all Lean\n/// guards pass, finite `u64` cursor exhaustion is reported without mutation.\npub fn handle_reserve_startup(\n    world: &World,\n    key: OperationKey,\n) -> Result<Decision, SchedulerReject> {\n    if !world.controller_up {\n        return Err(SchedulerReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&key.sandbox) else {\n        return Err(SchedulerReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Starting {\n        return Err(SchedulerReject::WrongPhase);\n    }\n    if record.terminal {\n        return Err(SchedulerReject::Terminal);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(SchedulerReject::OperationUnavailable);\n    };\n    if operation.id != key.operation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    let Some(plan) = world.operation_plans.get(&key) else {\n        return Err(SchedulerReject::PlanUnavailable);\n    };\n    if plan.key != key {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.epoch != record.epoch {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.generation != record.generation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.sealed {\n        return Err(SchedulerReject::PlanAlreadySealed);\n    }\n    if plan.vm.is_some() {\n        return Err(SchedulerReject::PlanNotOpen);\n    }\n    if plan.slot.is_some() {\n        return Err(SchedulerReject::PlanNotOpen);\n    }\n    if plan.restore_from != record.restore_from {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n\n    let vm = VmId(world.next_vm_id);\n    let slot = NetSlotId(world.next_slot_id);\n    if world.vms.contains_key(&vm) {\n        return Err(SchedulerReject::ResourceAlreadyExists);\n    }\n    if world.net_slots.contains_key(&slot) {\n        return Err(SchedulerReject::ResourceAlreadyExists);\n    }\n\n    // Lean's guards, including both freshness checks, deliberately precede\n    // this finite-representation check.\n    let Some(next) = reserve_startup_resources(world, key, plan) else {\n        return Err(SchedulerReject::CounterExhausted);\n    };\n    Ok(Decision {\n        event: Event::ReserveStartupResources { key, vm, slot },\n        next,\n    })\n}\n\n/// Rust implementation of Lean's `Controller.handleReservePauseSnapshot`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's ordered guards.  Once all Lean\n/// guards pass, finite `u64` cursor exhaustion is reported without mutation.\npub fn handle_reserve_pause_snapshot(\n    world: &World,\n    key: OperationKey,\n) -> Result<Decision, SchedulerReject> {\n    if !world.controller_up {\n        return Err(SchedulerReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&key.sandbox) else {\n        return Err(SchedulerReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Pausing {\n        return Err(SchedulerReject::WrongPhase);\n    }\n    if record.terminal {\n        return Err(SchedulerReject::Terminal);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(SchedulerReject::OperationUnavailable);\n    };\n    if operation.id != key.operation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    let Some(plan) = world.operation_plans.get(&key) else {\n        return Err(SchedulerReject::PlanUnavailable);\n    };\n    if plan.key != key {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.epoch != record.epoch {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.generation != record.generation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.sealed {\n        return Err(SchedulerReject::PlanAlreadySealed);\n    }\n    if plan.vm.is_some() {\n        return Err(SchedulerReject::PlanNotOpen);\n    }\n    if plan.target_snapshot.is_some() {\n        return Err(SchedulerReject::PlanNotOpen);\n    }\n    let Some(vm) = record.current_vm else {\n        return Err(SchedulerReject::VmNotFound);\n    };\n\n    let snapshot = SnapshotId(world.next_snapshot_id);\n    let manifest = SnapshotManifestRef {\n        digest: ManifestDigest(world.next_manifest_digest),\n    };\n    if world.snapshots.contains_key(&snapshot) {\n        return Err(SchedulerReject::ResourceAlreadyExists);\n    }\n\n    // The snapshot freshness guard is part of Lean; only then do we refine\n    // the unbounded cursors to finite machine integers.\n    let Some(next) = reserve_pause_snapshot(world, key, plan, vm) else {\n        return Err(SchedulerReject::CounterExhausted);\n    };\n    Ok(Decision {\n        event: Event::ReservePauseSnapshot {\n            key,\n            snapshot,\n            manifest,\n        },\n        next,\n    })\n}\n\nfn usable_snapshot_check(\n    world: &World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n    source: RestoreSource,\n) -> bool {\n    match world.snapshots.get(&source.snapshot) {\n        Some(snapshot) => {\n            snapshot.owner == record.owner\n                && snapshot.sandbox == sandbox\n                && snapshot.workspace == record.workspace\n                && snapshot.manifest == source.manifest\n                && snapshot.stage == SnapshotStage::Durable\n                && snapshot.immutable\n        }\n        None => false,\n    }\n}\n\nfn restore_source_ready_check(world: &World, sandbox: SandboxId, record: &SandboxRecord) -> bool {\n    match record.restore_from {\n        None => true,\n        Some(source) => {\n            record.durable_snapshot == Some(source)\n                && usable_snapshot_check(world, sandbox, record, source)\n        }\n    }\n}\n\n/// Rust implementation of Lean's `Controller.handleDispatchPrepare`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's ordered plan, fence, resource, and\n/// restore-source checks.  An accepted decision only journals the prepare\n/// command; worker-side resource creation remains a later protocol step.\npub fn handle_dispatch_prepare(\n    world: &World,\n    sandbox: SandboxId,\n    vm: VmId,\n    slot: NetSlotId,\n) -> Result<Decision, SchedulerReject> {\n    if !world.controller_up {\n        return Err(SchedulerReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(SchedulerReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Starting {\n        return Err(SchedulerReject::WrongPhase);\n    }\n    if record.terminal {\n        return Err(SchedulerReject::Terminal);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(SchedulerReject::OperationUnavailable);\n    };\n    let key = operation_key(sandbox, operation.id);\n    let Some(plan) = world.operation_plans.get(&key) else {\n        return Err(SchedulerReject::PlanUnavailable);\n    };\n    if plan.key != key {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.epoch != record.epoch {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.generation != record.generation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if !plan.sealed {\n        return Err(SchedulerReject::PlanNotOpen);\n    }\n    if plan.vm != Some(vm) {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.slot != Some(slot) {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.restore_from != record.restore_from {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: false,\n        })\n    {\n        return Err(SchedulerReject::FenceNotInstalled);\n    }\n    if world.vms.contains_key(&vm) {\n        return Err(SchedulerReject::ResourceAlreadyExists);\n    }\n    if world.net_slots.contains_key(&slot) {\n        return Err(SchedulerReject::ResourceAlreadyExists);\n    }\n    if !restore_source_ready_check(world, sandbox, record) {\n        return Err(SchedulerReject::RestoreSourceUnavailable);\n    }\n\n    let source = record.restore_from;\n    let command = Command::PrepareVm {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm,\n        slot,\n        source,\n    };\n    let mut next = world.clone();\n    enqueue(&mut next, command);\n    Ok(Decision {\n        event: Event::DispatchPrepare {\n            sandbox,\n            vm,\n            slot,\n            source,\n        },\n        next,\n    })\n}\n\n/// Rust implementation of Lean's `Controller.handleScheduleSealSnapshot`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's ordered plan, VM, fence, freeze\n/// receipt, and snapshot-freshness checks.\npub fn handle_schedule_seal_snapshot(\n    world: &World,\n    sandbox: SandboxId,\n    snapshot: SnapshotId,\n    manifest: SnapshotManifestRef,\n) -> Result<Decision, SchedulerReject> {\n    if !world.controller_up {\n        return Err(SchedulerReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(SchedulerReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Pausing {\n        return Err(SchedulerReject::WrongPhase);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(SchedulerReject::OperationUnavailable);\n    };\n    let key = operation_key(sandbox, operation.id);\n    let Some(plan) = world.operation_plans.get(&key) else {\n        return Err(SchedulerReject::PlanUnavailable);\n    };\n    if plan.key != key {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.epoch != record.epoch {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.generation != record.generation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if !plan.sealed {\n        return Err(SchedulerReject::PlanNotOpen);\n    }\n    if plan.target_snapshot != Some(RestoreSource { snapshot, manifest }) {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    let Some(vm_id) = record.current_vm else {\n        return Err(SchedulerReject::VmNotFound);\n    };\n    if plan.vm != Some(vm_id) {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    let Some(vm) = world.vms.get(&vm_id) else {\n        return Err(SchedulerReject::VmNotFound);\n    };\n    if vm.owner != record.owner || vm.sandbox != sandbox || vm.generation != record.generation {\n        return Err(SchedulerReject::ResourceMismatch);\n    }\n    if vm.status != crate::VmStatus::Frozen {\n        return Err(SchedulerReject::ResourceNotReady);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: false,\n        })\n    {\n        return Err(SchedulerReject::FenceNotInstalled);\n    }\n    let freeze = Command::FreezeVm {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm: vm_id,\n    };\n    if !effect_succeeded_check(world, &freeze) {\n        return Err(SchedulerReject::PrerequisiteNotSucceeded);\n    }\n    if world.snapshots.contains_key(&snapshot) {\n        return Err(SchedulerReject::ResourceAlreadyExists);\n    }\n\n    let command = Command::SealSnapshot {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm: vm_id,\n        workspace: record.workspace,\n        snapshot,\n        manifest,\n    };\n    let mut next = world.clone();\n    enqueue(&mut next, command);\n    Ok(Decision {\n        event: Event::ScheduleSealSnapshot {\n            sandbox,\n            snapshot,\n            manifest,\n        },\n        next,\n    })\n}\n\n/// Rust implementation of Lean's `Controller.handleScheduleCommitSnapshot`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's snapshot-first lookup order,\n/// identity and stage checks, and seal-success prerequisite.\npub fn handle_schedule_commit_snapshot(\n    world: &World,\n    sandbox: SandboxId,\n    snapshot_id: SnapshotId,\n) -> Result<Decision, SchedulerReject> {\n    if !world.controller_up {\n        return Err(SchedulerReject::ControllerDown);\n    }\n    let Some(snapshot) = world.snapshots.get(&snapshot_id) else {\n        return Err(SchedulerReject::SnapshotNotFound);\n    };\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(SchedulerReject::SandboxNotFound);\n    };\n    if snapshot.sandbox != sandbox {\n        return Err(SchedulerReject::ResourceMismatch);\n    }\n    if record.phase != Phase::Pausing {\n        return Err(SchedulerReject::WrongPhase);\n    }\n    let Some(vm) = record.current_vm else {\n        return Err(SchedulerReject::VmNotFound);\n    };\n    if snapshot.source_generation != record.generation || snapshot.workspace != record.workspace {\n        return Err(SchedulerReject::ResourceMismatch);\n    }\n    if snapshot.stage != SnapshotStage::LocalSealed {\n        return Err(SchedulerReject::ResourceNotReady);\n    }\n    let seal = Command::SealSnapshot {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm,\n        workspace: record.workspace,\n        snapshot: snapshot_id,\n        manifest: snapshot.manifest,\n    };\n    if !effect_succeeded_check(world, &seal) {\n        return Err(SchedulerReject::PrerequisiteNotSucceeded);\n    }\n\n    let command = Command::CommitSnapshot {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        snapshot: snapshot_id,\n        manifest: snapshot.manifest,\n    };\n    let mut next = world.clone();\n    enqueue(&mut next, command);\n    Ok(Decision {\n        event: Event::ScheduleCommitSnapshot {\n            sandbox,\n            snapshot: snapshot_id,\n        },\n        next,\n    })\n}\n\n/// Rust implementation of Lean's `Controller.handleScheduleStopVm`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's revocation, terminal-fence,\n/// current fence-receipt, VM identity, and stoppable-state checks.\npub fn handle_schedule_stop_vm(\n    world: &World,\n    sandbox: SandboxId,\n    generation: Generation,\n    vm_id: VmId,\n) -> Result<Decision, SchedulerReject> {\n    if !world.controller_up {\n        return Err(SchedulerReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(SchedulerReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Revoking {\n        return Err(SchedulerReject::WrongPhase);\n    }\n    if !record.terminal {\n        return Err(SchedulerReject::Terminal);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(SchedulerReject::OperationUnavailable);\n    };\n    let key = operation_key(sandbox, operation.id);\n    let Some(plan) = world.operation_plans.get(&key) else {\n        return Err(SchedulerReject::PlanUnavailable);\n    };\n    if plan.key != key || plan.epoch != record.epoch || plan.generation != record.generation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if !plan.stop_vms.contains(&vm_id) {\n        return Err(SchedulerReject::ResourceNotPlanned);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: true,\n        })\n    {\n        return Err(SchedulerReject::FenceNotInstalled);\n    }\n    let fence = Command::InstallFence {\n        sandbox,\n        epoch: record.epoch,\n        terminal: true,\n    };\n    if !effect_succeeded_check(world, &fence) {\n        return Err(SchedulerReject::PrerequisiteNotSucceeded);\n    }\n    let Some(vm) = world.vms.get(&vm_id) else {\n        return Err(SchedulerReject::VmNotFound);\n    };\n    if vm.sandbox != sandbox || vm.generation != generation {\n        return Err(SchedulerReject::ResourceMismatch);\n    }\n    if !stoppable_vm_status(vm.status) {\n        return Err(SchedulerReject::ResourceNotReady);\n    }\n\n    let command = Command::StopVm {\n        sandbox,\n        epoch: record.epoch,\n        generation,\n        vm: vm_id,\n    };\n    let mut next = world.clone();\n    enqueue(&mut next, command);\n    Ok(Decision {\n        event: Event::ScheduleStopVm {\n            sandbox,\n            generation,\n            vm: vm_id,\n        },\n        next,\n    })\n}\n\nfn not_current_vm_check(world: &World, sandbox: SandboxId, vm: VmId) -> bool {\n    match world.sandboxes.get(&sandbox) {\n        Some(record) => record.current_vm != Some(vm),\n        None => true,\n    }\n}\n\n/// Rust implementation of Lean's `Controller.handleScheduleCleanupVm`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's current-plan membership, VM\n/// identity, stopped-state, and no-longer-current checks.\npub fn handle_schedule_cleanup_vm(\n    world: &World,\n    sandbox: SandboxId,\n    generation: Generation,\n    vm_id: VmId,\n) -> Result<Decision, SchedulerReject> {\n    if !world.controller_up {\n        return Err(SchedulerReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(SchedulerReject::SandboxNotFound);\n    };\n    let Some(operation) = record.current_operation else {\n        return Err(SchedulerReject::OperationUnavailable);\n    };\n    let key = operation_key(sandbox, operation.id);\n    let Some(plan) = world.operation_plans.get(&key) else {\n        return Err(SchedulerReject::PlanUnavailable);\n    };\n    if plan.key != key || plan.epoch != record.epoch || plan.generation != record.generation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if !plan.stop_vms.contains(&vm_id) {\n        return Err(SchedulerReject::ResourceNotPlanned);\n    }\n    let Some(vm) = world.vms.get(&vm_id) else {\n        return Err(SchedulerReject::VmNotFound);\n    };\n    if vm.sandbox != sandbox || vm.generation != generation {\n        return Err(SchedulerReject::ResourceMismatch);\n    }\n    if vm.status != crate::VmStatus::Stopped {\n        return Err(SchedulerReject::ResourceNotReady);\n    }\n    if !not_current_vm_check(world, sandbox, vm_id) {\n        return Err(SchedulerReject::ResourceStillCurrent);\n    }\n\n    let command = Command::CleanupVm {\n        sandbox,\n        generation,\n        vm: vm_id,\n    };\n    let mut next = world.clone();\n    enqueue(&mut next, command);\n    Ok(Decision {\n        event: Event::ScheduleCleanupVm {\n            sandbox,\n            generation,\n            vm: vm_id,\n        },\n        next,\n    })\n}\n\nfn not_current_slot_check(world: &World, sandbox: SandboxId, slot: NetSlotId) -> bool {\n    match world.sandboxes.get(&sandbox) {\n        Some(record) => record.net_slot != Some(slot),\n        None => true,\n    }\n}\n\n/// Rust implementation of Lean's `Controller.handleScheduleCleanupSlot`.\n///\n/// # Errors\n///\n/// Returns the first rejection from Lean's current-plan membership, slot\n/// identity, inactive, unreclaimed, and no-longer-current checks.\npub fn handle_schedule_cleanup_slot(\n    world: &World,\n    sandbox: SandboxId,\n    generation: Generation,\n    slot_id: NetSlotId,\n) -> Result<Decision, SchedulerReject> {\n    if !world.controller_up {\n        return Err(SchedulerReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(SchedulerReject::SandboxNotFound);\n    };\n    let Some(operation) = record.current_operation else {\n        return Err(SchedulerReject::OperationUnavailable);\n    };\n    let key = operation_key(sandbox, operation.id);\n    let Some(plan) = world.operation_plans.get(&key) else {\n        return Err(SchedulerReject::PlanUnavailable);\n    };\n    if plan.key != key || plan.epoch != record.epoch || plan.generation != record.generation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if !plan.close_slots.contains(&slot_id) {\n        return Err(SchedulerReject::ResourceNotPlanned);\n    }\n    let Some(slot) = world.net_slots.get(&slot_id) else {\n        return Err(SchedulerReject::SlotNotFound);\n    };\n    if slot.sandbox != sandbox || slot.generation != generation {\n        return Err(SchedulerReject::ResourceMismatch);\n    }\n    if slot.active {\n        return Err(SchedulerReject::ResourceNotReady);\n    }\n    if slot.reclaimed {\n        return Err(SchedulerReject::AlreadyReclaimed);\n    }\n    if !not_current_slot_check(world, sandbox, slot_id) {\n        return Err(SchedulerReject::ResourceStillCurrent);\n    }\n\n    let command = Command::CleanupSlot {\n        sandbox,\n        generation,\n        slot: slot_id,\n    };\n    let mut next = world.clone();\n    enqueue(&mut next, command);\n    Ok(Decision {\n        event: Event::ScheduleCleanupSlot {\n            sandbox,\n            generation,\n            slot: slot_id,\n        },\n        next,\n    })\n}\n\n/// Execute one scheduler request through the same eight-way split as Lean's\n/// `handleScheduler`.\n///\n/// # Errors\n/// Returns the selected scheduler handler's first failed guard.\npub fn handle_scheduler(world: &World, input: SchedulerInput) -> Result<Decision, SchedulerReject> {\n    match input {\n        SchedulerInput::ReserveStartup(key) => handle_reserve_startup(world, key),\n        SchedulerInput::ReservePauseSnapshot(key) => handle_reserve_pause_snapshot(world, key),\n        SchedulerInput::DispatchPrepare(sandbox, vm, slot) => {\n            handle_dispatch_prepare(world, sandbox, vm, slot)\n        }\n        SchedulerInput::SealSnapshot(sandbox, snapshot, manifest) => {\n            handle_schedule_seal_snapshot(world, sandbox, snapshot, manifest)\n        }\n        SchedulerInput::CommitSnapshot(sandbox, snapshot) => {\n            handle_schedule_commit_snapshot(world, sandbox, snapshot)\n        }\n        SchedulerInput::StopVm(sandbox, generation, vm) => {\n            handle_schedule_stop_vm(world, sandbox, generation, vm)\n        }\n        SchedulerInput::CleanupVm(sandbox, generation, vm) => {\n            handle_schedule_cleanup_vm(world, sandbox, generation, vm)\n        }\n        SchedulerInput::CleanupSlot(sandbox, generation, slot) => {\n            handle_schedule_cleanup_slot(world, sandbox, generation, slot)\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{\n        SchedulerReject, handle_dispatch_prepare, handle_reserve_pause_snapshot,\n        handle_reserve_startup, handle_schedule_cleanup_slot, handle_schedule_cleanup_vm,\n        handle_schedule_commit_snapshot, handle_schedule_seal_snapshot, handle_schedule_stop_vm,\n    };\n    use crate::model::{\n        Authority, Command, EffectOrigin, EffectStatus, Event, FilePolicyRef, LogicalEffectId,\n        NetworkPolicy, Operation, OperationKind, OperationPlan, OperationStatus, Phase,\n        RestoreSource, SandboxRecord, Snapshot, SnapshotStage, WorkerFence, WorkspaceApiAccess,\n        World,\n    };\n    use crate::transition::operation_key;\n    use crate::{\n        FsId, Generation, ManifestDigest, NetSlot, NetSlotId, OperationId, PolicyDigest,\n        ResultDigest, SandboxId, SnapshotId, SnapshotManifestRef, TenantId, Vm, VmId, VmStatus,\n    };\n\n    const OWNER: TenantId = TenantId(7);\n    const SID: SandboxId = SandboxId(11);\n    const VM: VmId = VmId(23);\n    const OPERATION: OperationId = OperationId(29);\n\n    fn record(phase: Phase, kind: OperationKind) -> SandboxRecord {\n        SandboxRecord {\n            owner: OWNER,\n            phase,\n            terminal: false,\n            epoch: 5,\n            generation: 3,\n            current_vm: Some(VM),\n            workspace: FsId(13),\n            workspace_access: WorkspaceApiAccess::ManagedReadWrite,\n            file_policy: FilePolicyRef {\n                digest: PolicyDigest(17),\n            },\n            durable_snapshot: None,\n            restore_from: None,\n            net_slot: None,\n            policy: NetworkPolicy::DenyAll,\n            desired: Authority::Closed,\n            effective: Authority::Closed,\n            current_operation: Some(Operation {\n                id: OPERATION,\n                epoch: 5,\n                kind,\n                status: OperationStatus::Pending,\n            }),\n        }\n    }\n\n    fn plan() -> OperationPlan {\n        OperationPlan {\n            key: operation_key(SID, OPERATION),\n            epoch: 5,\n            generation: 3,\n            vm: None,\n            slot: None,\n            restore_from: None,\n            target_snapshot: None,\n            stop_vms: vec![VmId(8)],\n            close_slots: vec![NetSlotId(9)],\n            retry_limit: 3,\n            sealed: false,\n        }\n    }\n\n    fn startup_world() -> World {\n        let mut world = World {\n            next_vm_id: 21,\n            next_slot_id: 34,\n            ..World::default()\n        };\n        let key = operation_key(SID, OPERATION);\n        world\n            .sandboxes\n            .put(SID, record(Phase::Starting, OperationKind::Create));\n        world.operation_plans.put(key, plan());\n        world\n    }\n\n    fn pause_world() -> World {\n        let mut world = World {\n            next_snapshot_id: 55,\n            next_manifest_digest: 89,\n            ..World::default()\n        };\n        let key = operation_key(SID, OPERATION);\n        world\n            .sandboxes\n            .put(SID, record(Phase::Pausing, OperationKind::Pause));\n        world.operation_plans.put(key, plan());\n        world\n    }\n\n    fn dispatch_world(source: Option<RestoreSource>) -> World {\n        let mut world = startup_world();\n        let key = operation_key(SID, OPERATION);\n        let mut sandbox = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        sandbox.restore_from = source;\n        sandbox.durable_snapshot = source;\n        world.sandboxes.put(SID, sandbox);\n        let mut reserved = world.operation_plans.get(&key).expect(\"plan\").clone();\n        reserved.vm = Some(VmId(21));\n        reserved.slot = Some(NetSlotId(34));\n        reserved.restore_from = source;\n        reserved.sealed = true;\n        world.operation_plans.put(key, reserved);\n        world.worker_fences.put(\n            SID,\n            WorkerFence {\n                epoch: 5,\n                terminal: false,\n            },\n        );\n        world\n    }\n\n    fn acknowledge_success(world: &mut World, command: Command) {\n        let id = crate::EffectId::initial(command);\n        world.effects.put(\n            id,\n            EffectStatus::Acknowledged(crate::EffectOutcome::Succeeded(ResultDigest(97))),\n        );\n    }\n\n    fn seal_scheduler_world() -> (World, SnapshotManifestRef) {\n        let mut world = pause_world();\n        let key = operation_key(SID, OPERATION);\n        let manifest = SnapshotManifestRef {\n            digest: ManifestDigest(89),\n        };\n        let mut plan = world.operation_plans.get(&key).expect(\"plan\").clone();\n        plan.vm = Some(VM);\n        plan.target_snapshot = Some(RestoreSource {\n            snapshot: SnapshotId(55),\n            manifest,\n        });\n        plan.sealed = true;\n        world.operation_plans.put(key, plan);\n        world.vms.put(\n            VM,\n            Vm {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                status: VmStatus::Frozen,\n            },\n        );\n        world.worker_fences.put(\n            SID,\n            WorkerFence {\n                epoch: 5,\n                terminal: false,\n            },\n        );\n        acknowledge_success(\n            &mut world,\n            Command::FreezeVm {\n                sandbox: SID,\n                epoch: 5,\n                generation: 3,\n                vm: VM,\n            },\n        );\n        (world, manifest)\n    }\n\n    fn commit_scheduler_world() -> (World, SnapshotManifestRef) {\n        let (mut world, manifest) = seal_scheduler_world();\n        world.snapshots.put(\n            SnapshotId(55),\n            Snapshot {\n                owner: OWNER,\n                sandbox: SID,\n                source_generation: 3,\n                workspace: FsId(13),\n                manifest,\n                stage: SnapshotStage::LocalSealed,\n                immutable: false,\n            },\n        );\n        acknowledge_success(\n            &mut world,\n            Command::SealSnapshot {\n                sandbox: SID,\n                epoch: 5,\n                generation: 3,\n                vm: VM,\n                workspace: FsId(13),\n                snapshot: SnapshotId(55),\n                manifest,\n            },\n        );\n        (world, manifest)\n    }\n\n    fn stop_scheduler_world() -> World {\n        let mut sandbox = record(Phase::Revoking, OperationKind::Kill);\n        sandbox.terminal = true;\n        let mut world = World::default();\n        world.sandboxes.put(SID, sandbox);\n        let mut stop_plan = plan();\n        stop_plan.stop_vms.insert(0, VM);\n        stop_plan.sealed = true;\n        world\n            .operation_plans\n            .put(operation_key(SID, OPERATION), stop_plan);\n        world.worker_fences.put(\n            SID,\n            WorkerFence {\n                epoch: 5,\n                terminal: true,\n            },\n        );\n        world.vms.put(\n            VM,\n            Vm {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                status: VmStatus::Prepared,\n            },\n        );\n        acknowledge_success(\n            &mut world,\n            Command::InstallFence {\n                sandbox: SID,\n                epoch: 5,\n                terminal: true,\n            },\n        );\n        world\n    }\n\n    fn cleanup_vm_world() -> World {\n        let mut world = World::default();\n        let mut sandbox = record(Phase::Revoking, OperationKind::Kill);\n        sandbox.current_vm = None;\n        world.sandboxes.put(SID, sandbox);\n        let mut cleanup_plan = plan();\n        cleanup_plan.stop_vms.insert(0, VM);\n        cleanup_plan.sealed = true;\n        world\n            .operation_plans\n            .put(operation_key(SID, OPERATION), cleanup_plan);\n        world.vms.put(\n            VM,\n            Vm {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                status: VmStatus::Stopped,\n            },\n        );\n        world\n    }\n\n    fn cleanup_slot_world() -> World {\n        let mut world = World::default();\n        let mut sandbox = record(Phase::Revoking, OperationKind::Kill);\n        sandbox.current_vm = None;\n        sandbox.net_slot = None;\n        world.sandboxes.put(SID, sandbox);\n        let mut cleanup_plan = plan();\n        cleanup_plan.close_slots.insert(0, NetSlotId(34));\n        cleanup_plan.sealed = true;\n        world\n            .operation_plans\n            .put(operation_key(SID, OPERATION), cleanup_plan);\n        world.net_slots.put(\n            NetSlotId(34),\n            NetSlot {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                vm: VM,\n                policy: NetworkPolicy::DenyAll,\n                configured: true,\n                active: false,\n                reclaimed: false,\n            },\n        );\n        world\n    }\n\n    #[test]\n    fn startup_accepts_and_atomically_seals_the_reserved_plan() {\n        let world = startup_world();\n        let before = world.clone();\n        let key = operation_key(SID, OPERATION);\n        let decision = handle_reserve_startup(&world, key).expect(\"valid reservation\");\n\n        assert_eq!(\n            decision.event,\n            Event::ReserveStartupResources {\n                key,\n                vm: VmId(21),\n                slot: NetSlotId(34),\n            }\n        );\n        let reserved = decision\n            .next\n            .operation_plans\n            .get(&key)\n            .expect(\"reserved plan\");\n        assert_eq!(decision.next.next_vm_id, 22);\n        assert_eq!(decision.next.next_slot_id, 35);\n        assert_eq!(reserved.vm, Some(VmId(21)));\n        assert_eq!(reserved.slot, Some(NetSlotId(34)));\n        assert_eq!(reserved.stop_vms, vec![VmId(21), VmId(8)]);\n        assert_eq!(reserved.close_slots, vec![NetSlotId(34), NetSlotId(9)]);\n        assert!(reserved.sealed);\n        assert_eq!(world, before);\n    }\n\n    #[test]\n    fn pause_accepts_and_atomically_seals_the_snapshot_pair() {\n        let world = pause_world();\n        let before = world.clone();\n        let key = operation_key(SID, OPERATION);\n        let decision = handle_reserve_pause_snapshot(&world, key).expect(\"valid reservation\");\n        let manifest = SnapshotManifestRef {\n            digest: ManifestDigest(89),\n        };\n\n        assert_eq!(\n            decision.event,\n            Event::ReservePauseSnapshot {\n                key,\n                snapshot: SnapshotId(55),\n                manifest,\n            }\n        );\n        let reserved = decision\n            .next\n            .operation_plans\n            .get(&key)\n            .expect(\"reserved plan\");\n        assert_eq!(decision.next.next_snapshot_id, 56);\n        assert_eq!(decision.next.next_manifest_digest, 90);\n        assert_eq!(reserved.vm, Some(VM));\n        assert_eq!(\n            reserved.target_snapshot,\n            Some(crate::RestoreSource {\n                snapshot: SnapshotId(55),\n                manifest,\n            })\n        );\n        assert!(reserved.sealed);\n        assert_eq!(world, before);\n    }\n\n    #[test]\n    fn startup_rejections_follow_the_lean_guard_order() {\n        let key = operation_key(SID, OPERATION);\n        let mut world = startup_world();\n        world.controller_up = false;\n        world.sandboxes = crate::Store::default();\n        assert_eq!(\n            handle_reserve_startup(&world, key),\n            Err(SchedulerReject::ControllerDown)\n        );\n\n        let mut world = startup_world();\n        let mut sandbox = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        sandbox.phase = Phase::Running;\n        sandbox.terminal = true;\n        sandbox.current_operation = None;\n        world.sandboxes.put(SID, sandbox);\n        world.operation_plans = crate::Store::default();\n        assert_eq!(\n            handle_reserve_startup(&world, key),\n            Err(SchedulerReject::WrongPhase)\n        );\n\n        let mut world = startup_world();\n        let mut sandbox = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        sandbox.terminal = true;\n        sandbox.current_operation = None;\n        world.sandboxes.put(SID, sandbox);\n        assert_eq!(\n            handle_reserve_startup(&world, key),\n            Err(SchedulerReject::Terminal)\n        );\n\n        let mut world = startup_world();\n        let mut sandbox = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        sandbox.current_operation = None;\n        world.sandboxes.put(SID, sandbox);\n        assert_eq!(\n            handle_reserve_startup(&world, key),\n            Err(SchedulerReject::OperationUnavailable)\n        );\n\n        let mut world = startup_world();\n        world.operation_plans = crate::Store::default();\n        assert_eq!(\n            handle_reserve_startup(&world, key),\n            Err(SchedulerReject::PlanUnavailable)\n        );\n\n        let mut world = startup_world();\n        let mut reserved = plan();\n        reserved.sealed = true;\n        reserved.vm = Some(VmId(99));\n        world.operation_plans.put(key, reserved);\n        assert_eq!(\n            handle_reserve_startup(&world, key),\n            Err(SchedulerReject::PlanAlreadySealed)\n        );\n    }\n\n    #[test]\n    fn pause_rejections_follow_the_lean_guard_order() {\n        let key = operation_key(SID, OPERATION);\n        let mut world = pause_world();\n        let mut sandbox = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        sandbox.phase = Phase::Starting;\n        sandbox.terminal = true;\n        sandbox.current_vm = None;\n        world.sandboxes.put(SID, sandbox);\n        assert_eq!(\n            handle_reserve_pause_snapshot(&world, key),\n            Err(SchedulerReject::WrongPhase)\n        );\n\n        let mut world = pause_world();\n        let mut sandbox = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        sandbox.current_vm = None;\n        world.sandboxes.put(SID, sandbox);\n        assert_eq!(\n            handle_reserve_pause_snapshot(&world, key),\n            Err(SchedulerReject::VmNotFound)\n        );\n\n        let mut world = pause_world();\n        let mut reserved = plan();\n        reserved.vm = Some(VM);\n        reserved.target_snapshot = Some(crate::RestoreSource {\n            snapshot: SnapshotId(77),\n            manifest: SnapshotManifestRef {\n                digest: ManifestDigest(78),\n            },\n        });\n        world.operation_plans.put(key, reserved);\n        assert_eq!(\n            handle_reserve_pause_snapshot(&world, key),\n            Err(SchedulerReject::PlanNotOpen)\n        );\n    }\n\n    #[test]\n    fn startup_never_wraps_and_freshness_still_precedes_capacity() {\n        let key = operation_key(SID, OPERATION);\n        let mut world = startup_world();\n        world.next_vm_id = u64::MAX;\n        let before = world.clone();\n        assert_eq!(\n            handle_reserve_startup(&world, key),\n            Err(SchedulerReject::CounterExhausted)\n        );\n        assert_eq!(world, before);\n        assert_eq!(world.next_vm_id, u64::MAX);\n\n        world.vms.put(\n            VmId(u64::MAX),\n            Vm {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                status: VmStatus::Prepared,\n            },\n        );\n        assert_eq!(\n            handle_reserve_startup(&world, key),\n            Err(SchedulerReject::ResourceAlreadyExists)\n        );\n\n        let mut slot_world = startup_world();\n        slot_world.next_slot_id = u64::MAX;\n        slot_world.net_slots.put(\n            NetSlotId(u64::MAX),\n            NetSlot {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                vm: VM,\n                policy: NetworkPolicy::DenyAll,\n                configured: false,\n                active: false,\n                reclaimed: false,\n            },\n        );\n        assert_eq!(\n            handle_reserve_startup(&slot_world, key),\n            Err(SchedulerReject::ResourceAlreadyExists)\n        );\n    }\n\n    #[test]\n    fn pause_never_wraps_and_freshness_still_precedes_capacity() {\n        let key = operation_key(SID, OPERATION);\n        let mut world = pause_world();\n        world.next_snapshot_id = u64::MAX;\n        let before = world.clone();\n        assert_eq!(\n            handle_reserve_pause_snapshot(&world, key),\n            Err(SchedulerReject::CounterExhausted)\n        );\n        assert_eq!(world, before);\n        assert_eq!(world.next_snapshot_id, u64::MAX);\n\n        world.snapshots.put(\n            SnapshotId(u64::MAX),\n            Snapshot {\n                owner: OWNER,\n                sandbox: SID,\n                source_generation: Generation::from(3_u64),\n                workspace: FsId(13),\n                manifest: SnapshotManifestRef {\n                    digest: ManifestDigest(80),\n                },\n                stage: SnapshotStage::LocalSealed,\n                immutable: false,\n            },\n        );\n        assert_eq!(\n            handle_reserve_pause_snapshot(&world, key),\n            Err(SchedulerReject::ResourceAlreadyExists)\n        );\n\n        let mut manifest_world = pause_world();\n        manifest_world.next_manifest_digest = u64::MAX;\n        assert_eq!(\n            handle_reserve_pause_snapshot(&manifest_world, key),\n            Err(SchedulerReject::CounterExhausted)\n        );\n        assert_eq!(manifest_world.next_manifest_digest, u64::MAX);\n    }\n\n    #[test]\n    fn dispatch_prepare_accepts_create_and_journals_the_exact_command() {\n        let world = dispatch_world(None);\n        let before = world.clone();\n        let decision = handle_dispatch_prepare(&world, SID, VmId(21), NetSlotId(34))\n            .expect(\"valid prepare dispatch\");\n\n        assert_eq!(\n            decision.event,\n            Event::DispatchPrepare {\n                sandbox: SID,\n                vm: VmId(21),\n                slot: NetSlotId(34),\n                source: None,\n            }\n        );\n        let command = Command::PrepareVm {\n            sandbox: SID,\n            epoch: 5,\n            generation: 3,\n            vm: VmId(21),\n            slot: NetSlotId(34),\n            source: None,\n        };\n        let effect = crate::EffectId::initial(command.clone());\n        assert_eq!(\n            decision.next.effects.get(&effect),\n            Some(&EffectStatus::Committed)\n        );\n        assert_eq!(decision.next.effect_keys, vec![effect.clone()]);\n        assert_eq!(decision.next.inflight, vec![effect]);\n        assert_eq!(\n            decision\n                .next\n                .logical_effects\n                .get(&LogicalEffectId { command })\n                .expect(\"logical effect\")\n                .origin,\n            EffectOrigin::Operation(operation_key(SID, OPERATION))\n        );\n        assert_eq!(world, before);\n    }\n\n    #[test]\n    fn dispatch_prepare_accepts_only_the_selected_usable_restore_source() {\n        let source = RestoreSource {\n            snapshot: SnapshotId(55),\n            manifest: SnapshotManifestRef {\n                digest: ManifestDigest(89),\n            },\n        };\n        let mut world = dispatch_world(Some(source));\n        world.snapshots.put(\n            source.snapshot,\n            Snapshot {\n                owner: OWNER,\n                sandbox: SID,\n                source_generation: 2,\n                workspace: FsId(13),\n                manifest: source.manifest,\n                stage: SnapshotStage::Durable,\n                immutable: true,\n            },\n        );\n\n        let decision = handle_dispatch_prepare(&world, SID, VmId(21), NetSlotId(34))\n            .expect(\"usable selected source\");\n        assert_eq!(\n            decision.event,\n            Event::DispatchPrepare {\n                sandbox: SID,\n                vm: VmId(21),\n                slot: NetSlotId(34),\n                source: Some(source),\n            }\n        );\n        assert!(\n            decision\n                .next\n                .effects\n                .contains_key(&crate::EffectId::initial(Command::PrepareVm {\n                    sandbox: SID,\n                    epoch: 5,\n                    generation: 3,\n                    vm: VmId(21),\n                    slot: NetSlotId(34),\n                    source: Some(source),\n                }))\n        );\n    }\n\n    #[test]\n    fn dispatch_prepare_rejections_follow_fence_resource_and_source_order() {\n        let source = RestoreSource {\n            snapshot: SnapshotId(55),\n            manifest: SnapshotManifestRef {\n                digest: ManifestDigest(89),\n            },\n        };\n        let mut world = dispatch_world(Some(source));\n        world.worker_fences = crate::Store::default();\n        world.vms.put(\n            VmId(21),\n            Vm {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                status: VmStatus::Prepared,\n            },\n        );\n        assert_eq!(\n            handle_dispatch_prepare(&world, SID, VmId(21), NetSlotId(34)),\n            Err(SchedulerReject::FenceNotInstalled)\n        );\n\n        world.worker_fences.put(\n            SID,\n            WorkerFence {\n                epoch: 5,\n                terminal: false,\n            },\n        );\n        assert_eq!(\n            handle_dispatch_prepare(&world, SID, VmId(21), NetSlotId(34)),\n            Err(SchedulerReject::ResourceAlreadyExists)\n        );\n\n        world.vms = crate::Store::default();\n        assert_eq!(\n            handle_dispatch_prepare(&world, SID, VmId(21), NetSlotId(34)),\n            Err(SchedulerReject::RestoreSourceUnavailable)\n        );\n    }\n\n    #[test]\n    fn dispatch_prepare_checks_the_sealed_plan_before_the_fence() {\n        let mut world = dispatch_world(None);\n        let key = operation_key(SID, OPERATION);\n        let mut plan = world.operation_plans.get(&key).expect(\"plan\").clone();\n        plan.sealed = false;\n        plan.vm = Some(VmId(99));\n        world.operation_plans.put(key, plan);\n        world.worker_fences = crate::Store::default();\n\n        assert_eq!(\n            handle_dispatch_prepare(&world, SID, VmId(21), NetSlotId(34)),\n            Err(SchedulerReject::PlanNotOpen)\n        );\n    }\n\n    #[test]\n    fn schedule_seal_accepts_and_journals_the_exact_command() {\n        let (world, manifest) = seal_scheduler_world();\n        let before = world.clone();\n        let decision = handle_schedule_seal_snapshot(&world, SID, SnapshotId(55), manifest)\n            .expect(\"valid seal scheduling\");\n\n        assert_eq!(\n            decision.event,\n            Event::ScheduleSealSnapshot {\n                sandbox: SID,\n                snapshot: SnapshotId(55),\n                manifest,\n            }\n        );\n        let command = Command::SealSnapshot {\n            sandbox: SID,\n            epoch: 5,\n            generation: 3,\n            vm: VM,\n            workspace: FsId(13),\n            snapshot: SnapshotId(55),\n            manifest,\n        };\n        let effect = crate::EffectId::initial(command);\n        assert_eq!(\n            decision.next.effects.get(&effect),\n            Some(&EffectStatus::Committed)\n        );\n        assert_eq!(decision.next.inflight.first(), Some(&effect));\n        assert_eq!(world, before);\n    }\n\n    #[test]\n    fn schedule_seal_rejections_follow_vm_fence_receipt_and_freshness_order() {\n        let (mut world, manifest) = seal_scheduler_world();\n        let mut vm = *world.vms.get(&VM).expect(\"vm\");\n        vm.owner = TenantId(99);\n        vm.status = VmStatus::Prepared;\n        world.vms.put(VM, vm);\n        world.worker_fences = crate::Store::default();\n        world.effects = crate::Store::default();\n        world.snapshots.put(\n            SnapshotId(55),\n            Snapshot {\n                owner: OWNER,\n                sandbox: SID,\n                source_generation: 3,\n                workspace: FsId(13),\n                manifest,\n                stage: SnapshotStage::LocalSealed,\n                immutable: false,\n            },\n        );\n        assert_eq!(\n            handle_schedule_seal_snapshot(&world, SID, SnapshotId(55), manifest),\n            Err(SchedulerReject::ResourceMismatch)\n        );\n\n        vm.owner = OWNER;\n        world.vms.put(VM, vm);\n        assert_eq!(\n            handle_schedule_seal_snapshot(&world, SID, SnapshotId(55), manifest),\n            Err(SchedulerReject::ResourceNotReady)\n        );\n\n        vm.status = VmStatus::Frozen;\n        world.vms.put(VM, vm);\n        assert_eq!(\n            handle_schedule_seal_snapshot(&world, SID, SnapshotId(55), manifest),\n            Err(SchedulerReject::FenceNotInstalled)\n        );\n\n        world.worker_fences.put(\n            SID,\n            WorkerFence {\n                epoch: 5,\n                terminal: false,\n            },\n        );\n        assert_eq!(\n            handle_schedule_seal_snapshot(&world, SID, SnapshotId(55), manifest),\n            Err(SchedulerReject::PrerequisiteNotSucceeded)\n        );\n\n        acknowledge_success(\n            &mut world,\n            Command::FreezeVm {\n                sandbox: SID,\n                epoch: 5,\n                generation: 3,\n                vm: VM,\n            },\n        );\n        assert_eq!(\n            handle_schedule_seal_snapshot(&world, SID, SnapshotId(55), manifest),\n            Err(SchedulerReject::ResourceAlreadyExists)\n        );\n    }\n\n    #[test]\n    fn schedule_seal_checks_the_plan_before_vm_and_fence_state() {\n        let (mut world, manifest) = seal_scheduler_world();\n        let key = operation_key(SID, OPERATION);\n        let mut plan = world.operation_plans.get(&key).expect(\"plan\").clone();\n        plan.sealed = false;\n        plan.target_snapshot = None;\n        world.operation_plans.put(key, plan);\n        world.vms = crate::Store::default();\n        world.worker_fences = crate::Store::default();\n\n        assert_eq!(\n            handle_schedule_seal_snapshot(&world, SID, SnapshotId(55), manifest),\n            Err(SchedulerReject::PlanNotOpen)\n        );\n    }\n\n    #[test]\n    fn schedule_commit_accepts_and_journals_the_exact_command() {\n        let (world, manifest) = commit_scheduler_world();\n        let before = world.clone();\n        let decision = handle_schedule_commit_snapshot(&world, SID, SnapshotId(55))\n            .expect(\"valid commit scheduling\");\n\n        assert_eq!(\n            decision.event,\n            Event::ScheduleCommitSnapshot {\n                sandbox: SID,\n                snapshot: SnapshotId(55),\n            }\n        );\n        let command = Command::CommitSnapshot {\n            sandbox: SID,\n            epoch: 5,\n            generation: 3,\n            snapshot: SnapshotId(55),\n            manifest,\n        };\n        let effect = crate::EffectId::initial(command);\n        assert_eq!(\n            decision.next.effects.get(&effect),\n            Some(&EffectStatus::Committed)\n        );\n        assert_eq!(decision.next.inflight.first(), Some(&effect));\n        assert_eq!(world, before);\n    }\n\n    #[test]\n    fn schedule_commit_rejections_follow_snapshot_first_identity_stage_and_receipt_order() {\n        let empty = World::default();\n        assert_eq!(\n            handle_schedule_commit_snapshot(&empty, SID, SnapshotId(55)),\n            Err(SchedulerReject::SnapshotNotFound)\n        );\n\n        let (mut world, manifest) = commit_scheduler_world();\n        let mut snapshot = *world.snapshots.get(&SnapshotId(55)).expect(\"snapshot\");\n        snapshot.sandbox = SandboxId(99);\n        snapshot.source_generation = 99;\n        snapshot.stage = SnapshotStage::Durable;\n        world.snapshots.put(SnapshotId(55), snapshot);\n        let mut record = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        record.phase = Phase::Starting;\n        record.current_vm = None;\n        world.sandboxes.put(SID, record);\n        world.effects = crate::Store::default();\n        assert_eq!(\n            handle_schedule_commit_snapshot(&world, SID, SnapshotId(55)),\n            Err(SchedulerReject::ResourceMismatch)\n        );\n\n        snapshot.sandbox = SID;\n        world.snapshots.put(SnapshotId(55), snapshot);\n        assert_eq!(\n            handle_schedule_commit_snapshot(&world, SID, SnapshotId(55)),\n            Err(SchedulerReject::WrongPhase)\n        );\n\n        let (mut world, _) = commit_scheduler_world();\n        let mut snapshot = *world.snapshots.get(&SnapshotId(55)).expect(\"snapshot\");\n        snapshot.source_generation = 99;\n        snapshot.stage = SnapshotStage::Durable;\n        world.snapshots.put(SnapshotId(55), snapshot);\n        assert_eq!(\n            handle_schedule_commit_snapshot(&world, SID, SnapshotId(55)),\n            Err(SchedulerReject::ResourceMismatch)\n        );\n\n        snapshot.source_generation = 3;\n        world.snapshots.put(SnapshotId(55), snapshot);\n        assert_eq!(\n            handle_schedule_commit_snapshot(&world, SID, SnapshotId(55)),\n            Err(SchedulerReject::ResourceNotReady)\n        );\n\n        snapshot.stage = SnapshotStage::LocalSealed;\n        world.snapshots.put(SnapshotId(55), snapshot);\n        world.effects = crate::Store::default();\n        assert_eq!(\n            handle_schedule_commit_snapshot(&world, SID, SnapshotId(55)),\n            Err(SchedulerReject::PrerequisiteNotSucceeded)\n        );\n\n        assert_eq!(manifest, snapshot.manifest);\n    }\n\n    #[test]\n    fn schedule_stop_accepts_exact_command_and_repeated_scheduling_is_idempotent() {\n        let world = stop_scheduler_world();\n        let before = world.clone();\n        let decision = handle_schedule_stop_vm(&world, SID, 3, VM).expect(\"valid stop scheduling\");\n        assert_eq!(\n            decision.event,\n            Event::ScheduleStopVm {\n                sandbox: SID,\n                generation: 3,\n                vm: VM,\n            }\n        );\n        let command = Command::StopVm {\n            sandbox: SID,\n            epoch: 5,\n            generation: 3,\n            vm: VM,\n        };\n        let effect = crate::EffectId::initial(command);\n        assert_eq!(\n            decision.next.effects.get(&effect),\n            Some(&EffectStatus::Committed)\n        );\n        assert_eq!(decision.next.inflight.first(), Some(&effect));\n        assert_eq!(world, before);\n\n        let repeated = handle_schedule_stop_vm(&decision.next, SID, 3, VM)\n            .expect(\"same stop remains schedulable\");\n        assert_eq!(repeated.next, decision.next);\n    }\n\n    #[test]\n    fn schedule_stop_rejections_follow_terminal_fence_receipt_and_vm_order() {\n        let mut world = stop_scheduler_world();\n        let mut sandbox = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        sandbox.phase = Phase::Running;\n        sandbox.terminal = false;\n        world.sandboxes.put(SID, sandbox.clone());\n        world.worker_fences = crate::Store::default();\n        world.effects = crate::Store::default();\n        world.vms = crate::Store::default();\n        assert_eq!(\n            handle_schedule_stop_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::WrongPhase)\n        );\n\n        sandbox.phase = Phase::Revoking;\n        world.sandboxes.put(SID, sandbox.clone());\n        assert_eq!(\n            handle_schedule_stop_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::Terminal)\n        );\n\n        sandbox.terminal = true;\n        world.sandboxes.put(SID, sandbox);\n        assert_eq!(\n            handle_schedule_stop_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::FenceNotInstalled)\n        );\n\n        world.worker_fences.put(\n            SID,\n            WorkerFence {\n                epoch: 5,\n                terminal: true,\n            },\n        );\n        assert_eq!(\n            handle_schedule_stop_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::PrerequisiteNotSucceeded)\n        );\n\n        acknowledge_success(\n            &mut world,\n            Command::InstallFence {\n                sandbox: SID,\n                epoch: 5,\n                terminal: true,\n            },\n        );\n        assert_eq!(\n            handle_schedule_stop_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::VmNotFound)\n        );\n\n        world.vms.put(\n            VM,\n            Vm {\n                owner: OWNER,\n                sandbox: SandboxId(99),\n                generation: 9,\n                status: VmStatus::Stopped,\n            },\n        );\n        assert_eq!(\n            handle_schedule_stop_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::ResourceMismatch)\n        );\n\n        world.vms.put(\n            VM,\n            Vm {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                status: VmStatus::Stopped,\n            },\n        );\n        assert_eq!(\n            handle_schedule_stop_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::ResourceNotReady)\n        );\n    }\n\n    #[test]\n    fn schedule_cleanup_vm_accepts_exact_command_and_is_idempotent() {\n        let world = cleanup_vm_world();\n        let decision =\n            handle_schedule_cleanup_vm(&world, SID, 3, VM).expect(\"valid VM cleanup scheduling\");\n        assert_eq!(\n            decision.event,\n            Event::ScheduleCleanupVm {\n                sandbox: SID,\n                generation: 3,\n                vm: VM,\n            }\n        );\n        let effect = crate::EffectId::initial(Command::CleanupVm {\n            sandbox: SID,\n            generation: 3,\n            vm: VM,\n        });\n        assert_eq!(\n            decision.next.effects.get(&effect),\n            Some(&EffectStatus::Committed)\n        );\n        let repeated = handle_schedule_cleanup_vm(&decision.next, SID, 3, VM)\n            .expect(\"same cleanup remains schedulable\");\n        assert_eq!(repeated.next, decision.next);\n    }\n\n    #[test]\n    fn schedule_cleanup_vm_rejections_follow_identity_status_and_current_order() {\n        let mut world = cleanup_vm_world();\n        world.vms.put(\n            VM,\n            Vm {\n                owner: OWNER,\n                sandbox: SandboxId(99),\n                generation: 9,\n                status: VmStatus::Prepared,\n            },\n        );\n        let mut sandbox = record(Phase::Running, OperationKind::Create);\n        sandbox.current_vm = Some(VM);\n        world.sandboxes.put(SID, sandbox);\n        assert_eq!(\n            handle_schedule_cleanup_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::ResourceMismatch)\n        );\n\n        world.vms.put(\n            VM,\n            Vm {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                status: VmStatus::Prepared,\n            },\n        );\n        assert_eq!(\n            handle_schedule_cleanup_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::ResourceNotReady)\n        );\n\n        world.vms.put(\n            VM,\n            Vm {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                status: VmStatus::Stopped,\n            },\n        );\n        assert_eq!(\n            handle_schedule_cleanup_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::ResourceStillCurrent)\n        );\n    }\n\n    #[test]\n    fn schedule_cleanup_slot_accepts_exact_command_and_is_idempotent() {\n        let world = cleanup_slot_world();\n        let slot = NetSlotId(34);\n        let decision = handle_schedule_cleanup_slot(&world, SID, 3, slot)\n            .expect(\"valid slot cleanup scheduling\");\n        assert_eq!(\n            decision.event,\n            Event::ScheduleCleanupSlot {\n                sandbox: SID,\n                generation: 3,\n                slot,\n            }\n        );\n        let effect = crate::EffectId::initial(Command::CleanupSlot {\n            sandbox: SID,\n            generation: 3,\n            slot,\n        });\n        assert_eq!(\n            decision.next.effects.get(&effect),\n            Some(&EffectStatus::Committed)\n        );\n        let repeated = handle_schedule_cleanup_slot(&decision.next, SID, 3, slot)\n            .expect(\"same cleanup remains schedulable\");\n        assert_eq!(repeated.next, decision.next);\n    }\n\n    #[test]\n    fn schedule_cleanup_slot_rejections_follow_identity_activity_reclaimed_and_current_order() {\n        let slot_id = NetSlotId(34);\n        let mut world = cleanup_slot_world();\n        let mut slot = world.net_slots.get(&slot_id).expect(\"slot\").clone();\n        slot.sandbox = SandboxId(99);\n        slot.generation = 9;\n        slot.active = true;\n        slot.reclaimed = true;\n        world.net_slots.put(slot_id, slot.clone());\n        let mut sandbox = record(Phase::Running, OperationKind::Create);\n        sandbox.net_slot = Some(slot_id);\n        world.sandboxes.put(SID, sandbox);\n        assert_eq!(\n            handle_schedule_cleanup_slot(&world, SID, 3, slot_id),\n            Err(SchedulerReject::ResourceMismatch)\n        );\n\n        slot.sandbox = SID;\n        slot.generation = 3;\n        world.net_slots.put(slot_id, slot.clone());\n        assert_eq!(\n            handle_schedule_cleanup_slot(&world, SID, 3, slot_id),\n            Err(SchedulerReject::ResourceNotReady)\n        );\n\n        slot.active = false;\n        world.net_slots.put(slot_id, slot.clone());\n        assert_eq!(\n            handle_schedule_cleanup_slot(&world, SID, 3, slot_id),\n            Err(SchedulerReject::AlreadyReclaimed)\n        );\n\n        slot.reclaimed = false;\n        world.net_slots.put(slot_id, slot);\n        assert_eq!(\n            handle_schedule_cleanup_slot(&world, SID, 3, slot_id),\n            Err(SchedulerReject::ResourceStillCurrent)\n        );\n    }\n\n    #[test]\n    fn remaining_scheduler_handlers_check_controller_before_resource_lookups() {\n        let mut world = World {\n            controller_up: false,\n            ..World::default()\n        };\n        assert_eq!(\n            handle_schedule_stop_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::ControllerDown)\n        );\n        assert_eq!(\n            handle_schedule_cleanup_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::ControllerDown)\n        );\n        assert_eq!(\n            handle_schedule_cleanup_slot(&world, SID, 3, NetSlotId(34)),\n            Err(SchedulerReject::ControllerDown)\n        );\n\n        world.controller_up = true;\n        assert_eq!(\n            handle_schedule_stop_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::SandboxNotFound)\n        );\n        assert_eq!(\n            handle_schedule_cleanup_vm(&world, SID, 3, VM),\n            Err(SchedulerReject::SandboxNotFound)\n        );\n        assert_eq!(\n            handle_schedule_cleanup_slot(&world, SID, 3, NetSlotId(34)),\n            Err(SchedulerReject::SandboxNotFound)\n        );\n    }\n\n    #[test]\n    fn remaining_scheduler_handlers_reject_resources_outside_the_current_plan() {\n        let mut stop_world = stop_scheduler_world();\n        let key = operation_key(SID, OPERATION);\n        let mut plan = stop_world.operation_plans.get(&key).expect(\"plan\").clone();\n        plan.stop_vms.clear();\n        stop_world.operation_plans.put(key, plan);\n        stop_world.worker_fences = crate::Store::default();\n        assert_eq!(\n            handle_schedule_stop_vm(&stop_world, SID, 3, VM),\n            Err(SchedulerReject::ResourceNotPlanned)\n        );\n\n        let mut vm_world = cleanup_vm_world();\n        let mut plan = vm_world.operation_plans.get(&key).expect(\"plan\").clone();\n        plan.stop_vms.clear();\n        vm_world.operation_plans.put(key, plan);\n        vm_world.vms = crate::Store::default();\n        assert_eq!(\n            handle_schedule_cleanup_vm(&vm_world, SID, 3, VM),\n            Err(SchedulerReject::ResourceNotPlanned)\n        );\n\n        let mut slot_world = cleanup_slot_world();\n        let mut plan = slot_world.operation_plans.get(&key).expect(\"plan\").clone();\n        plan.close_slots.clear();\n        slot_world.operation_plans.put(key, plan);\n        slot_world.net_slots = crate::Store::default();\n        assert_eq!(\n            handle_schedule_cleanup_slot(&slot_world, SID, 3, NetSlotId(34)),\n            Err(SchedulerReject::ResourceNotPlanned)\n        );\n    }\n}\n"},{"id":11,"name":{"Local":"controller-core/src/worker.rs"},"crate_name":"sandbox_controller_core","contents":"use crate::model::{\n    AppliedFilePolicy, Authority, Command, EffectId, EffectStatus, LogicalEffectId, NetSlot,\n    OperationKey, Phase, RestoreSource, SandboxRecord, Snapshot, SnapshotStage, Vm, VmStatus,\n    WorkerFence, World,\n};\nuse crate::transition::{enqueue, operation_key};\nuse crate::{Generation, NetSlotId, SandboxId, SnapshotId, SnapshotManifestRef, VmId};\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum WorkerEvent {\n    InstallFence {\n        sandbox: SandboxId,\n    },\n    PrepareVm {\n        sandbox: SandboxId,\n        vm: VmId,\n        slot: NetSlotId,\n        source: Option<RestoreSource>,\n    },\n    ConfigureNetwork {\n        sandbox: SandboxId,\n        slot: NetSlotId,\n    },\n    ActivateVm {\n        sandbox: SandboxId,\n        vm: VmId,\n    },\n    ApplyFilePolicy {\n        sandbox: SandboxId,\n        generation: Generation,\n    },\n    FreezeVm {\n        sandbox: SandboxId,\n        vm: VmId,\n    },\n    SealSnapshot {\n        sandbox: SandboxId,\n        snapshot: SnapshotId,\n        manifest: SnapshotManifestRef,\n    },\n    CommitSnapshot {\n        snapshot: SnapshotId,\n    },\n    StopVm {\n        sandbox: SandboxId,\n        vm: VmId,\n    },\n    CleanupVm {\n        sandbox: SandboxId,\n        generation: Generation,\n        vm: VmId,\n    },\n    CleanupSlot {\n        sandbox: SandboxId,\n        generation: Generation,\n        slot: NetSlotId,\n    },\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum WorkerReject {\n    StaleAttempt,\n    NotQueued,\n    NotAwaiting,\n    SandboxNotFound,\n    ResourceNotFound,\n    OperationNotFound,\n    PlanNotFound,\n    WrongPhase,\n    Terminal,\n    IdentityMismatch,\n    PlanMismatch,\n    FenceNotReady,\n    ResourceBusy,\n    ResultAlreadyPresent,\n    SourceUnavailable,\n    SnapshotNotReady,\n    ResourceStillCurrent,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct WorkerDecision {\n    pub event: WorkerEvent,\n    pub next: World,\n}\n\nfn insert_unique<T: Clone + PartialEq>(values: &mut Vec<T>, value: T) {\n    let mut index = 0;\n    while index < values.len() {\n        if values[index] == value {\n            return;\n        }\n        index += 1;\n    }\n    let mut next = Vec::new();\n    next.push(value);\n    index = 0;\n    while index < values.len() {\n        next.push(values[index].clone());\n        index += 1;\n    }\n    *values = next;\n}\n\nfn contains<T: PartialEq>(values: &[T], value: &T) -> bool {\n    let mut index = 0;\n    while index < values.len() {\n        if &values[index] == value {\n            return true;\n        }\n        index += 1;\n    }\n    false\n}\n\nfn current_effect_id(world: &World, command: &Command) -> EffectId {\n    let logical = LogicalEffectId {\n        command: command.clone(),\n    };\n    let attempt = match world.logical_effects.get_copy(&logical) {\n        Some(record) => record.current_attempt,\n        None => 0,\n    };\n    EffectId { logical, attempt }\n}\n\nfn fence_can_advance(old: Option<&WorkerFence>, epoch: u64, terminal: bool) -> bool {\n    match old {\n        None => true,\n        Some(fence) => fence.epoch <= epoch && (!fence.terminal || terminal),\n    }\n}\n\nfn effect_awaiting(status: Option<&EffectStatus>) -> bool {\n    match status {\n        Some(EffectStatus::Dispatched | EffectStatus::OutcomeUnknown) => true,\n        Some(EffectStatus::Committed | EffectStatus::Acknowledged(_)) | None => false,\n    }\n}\n\nconst fn revocation_phase(phase: Phase) -> bool {\n    match phase {\n        Phase::Pausing | Phase::Revoking => true,\n        Phase::Starting | Phase::Running | Phase::Paused | Phase::Destroyed => false,\n    }\n}\n\nconst fn stoppable_vm_status(status: VmStatus) -> bool {\n    match status {\n        VmStatus::Prepared | VmStatus::Executing | VmStatus::Frozen => true,\n        VmStatus::Stopped | VmStatus::Reclaimed => false,\n    }\n}\n\nfn register_vm(world: &mut World, sandbox: SandboxId, vm: VmId) {\n    let mut index = world.resource_index(sandbox);\n    insert_unique(&mut index.vms, vm);\n    world.resource_indexes.put(sandbox, index);\n}\n\nfn register_slot(world: &mut World, sandbox: SandboxId, slot: NetSlotId) {\n    let mut index = world.resource_index(sandbox);\n    insert_unique(&mut index.slots, slot);\n    world.resource_indexes.put(sandbox, index);\n}\n\nfn register_snapshot(world: &mut World, sandbox: SandboxId, snapshot: SnapshotId) {\n    let mut index = world.resource_index(sandbox);\n    insert_unique(&mut index.snapshots, snapshot);\n    world.resource_indexes.put(sandbox, index);\n}\n\nfn put_vm(world: &mut World, id: VmId, value: Vm) {\n    register_vm(world, value.sandbox, id);\n    world.vms.put(id, value);\n}\n\nfn put_slot(world: &mut World, id: NetSlotId, value: NetSlot) {\n    register_slot(world, value.sandbox, id);\n    world.net_slots.put(id, value);\n}\n\nfn put_snapshot(world: &mut World, id: SnapshotId, value: Snapshot) {\n    register_snapshot(world, value.sandbox, id);\n    world.snapshots.put(id, value);\n}\n\nfn usable_snapshot(\n    world: &World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n    source: RestoreSource,\n) -> bool {\n    match world.snapshots.get(&source.snapshot) {\n        Some(snapshot) => {\n            snapshot.owner == record.owner\n                && snapshot.sandbox == sandbox\n                && snapshot.workspace == record.workspace\n                && snapshot.manifest == source.manifest\n                && snapshot.stage == SnapshotStage::Durable\n                && snapshot.immutable\n        }\n        None => false,\n    }\n}\n\nfn indexed_no_executing_vm(world: &World, sandbox: SandboxId) -> bool {\n    let index = world.resource_index(sandbox);\n    let mut cursor = 0;\n    while cursor < index.vms.len() {\n        let Some(vm) = world.vms.get(&index.vms[cursor]) else {\n            return false;\n        };\n        if vm.status == VmStatus::Executing {\n            return false;\n        }\n        cursor += 1;\n    }\n    true\n}\n\nfn apply_start_fence(world: &World, sandbox: SandboxId, record: &SandboxRecord) -> World {\n    let mut next = world.clone();\n    next.worker_fences.put(\n        sandbox,\n        WorkerFence {\n            epoch: record.epoch,\n            terminal: false,\n        },\n    );\n    next\n}\n\nfn apply_revocation_fence(world: &World, sandbox: SandboxId, record: &SandboxRecord) -> World {\n    let mut next = world.clone();\n    let mut updated = record.clone();\n    updated.effective = Authority::Closed;\n    next.sandboxes.put(sandbox, updated);\n    next.worker_fences.put(\n        sandbox,\n        WorkerFence {\n            epoch: record.epoch,\n            terminal: record.terminal,\n        },\n    );\n    if let Some(slot_id) = record.net_slot\n        && let Some(slot) = world.net_slots.get(&slot_id)\n    {\n        let mut closed = slot.clone();\n        closed.active = false;\n        put_slot(&mut next, slot_id, closed);\n    }\n    next\n}\n\nfn prepare_resources(\n    world: &World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n    vm_id: VmId,\n    slot_id: NetSlotId,\n) -> World {\n    let mut next = world.clone();\n    put_vm(\n        &mut next,\n        vm_id,\n        Vm {\n            owner: record.owner,\n            sandbox,\n            generation: record.generation,\n            status: VmStatus::Prepared,\n        },\n    );\n    put_slot(\n        &mut next,\n        slot_id,\n        NetSlot {\n            owner: record.owner,\n            sandbox,\n            generation: record.generation,\n            vm: vm_id,\n            policy: record.policy.clone(),\n            configured: false,\n            active: false,\n            reclaimed: false,\n        },\n    );\n    let mut updated = record.clone();\n    updated.current_vm = Some(vm_id);\n    updated.net_slot = Some(slot_id);\n    next.sandboxes.put(sandbox, updated);\n    enqueue(\n        &mut next,\n        Command::ConfigureNetwork {\n            sandbox,\n            epoch: record.epoch,\n            generation: record.generation,\n            vm: vm_id,\n            slot: slot_id,\n            policy: record.policy.clone(),\n        },\n    );\n    enqueue(\n        &mut next,\n        Command::ActivateVm {\n            sandbox,\n            epoch: record.epoch,\n            generation: record.generation,\n            vm: vm_id,\n        },\n    );\n    enqueue(\n        &mut next,\n        Command::ApplyFilePolicy {\n            sandbox,\n            epoch: record.epoch,\n            generation: record.generation,\n            workspace: record.workspace,\n            policy: record.file_policy,\n        },\n    );\n    next\n}\n\nfn current_plan<'a>(\n    world: &'a World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n) -> Result<(OperationKey, &'a crate::OperationPlan), WorkerReject> {\n    let Some(operation) = record.current_operation else {\n        return Err(WorkerReject::OperationNotFound);\n    };\n    let key = operation_key(sandbox, operation.id);\n    let Some(plan) = world.operation_plans.get(&key) else {\n        return Err(WorkerReject::PlanNotFound);\n    };\n    Ok((key, plan))\n}\n\n/// Execute one exact current worker attempt against durable state.\n///\n/// # Errors\n/// Returns the first failed guard in the same order as the Lean worker\n/// reducer. Rejection leaves `world` unchanged.\n#[allow(clippy::too_many_lines)]\npub fn handle_worker(world: &World, id: &EffectId) -> Result<WorkerDecision, WorkerReject> {\n    let command = id.logical.command.clone();\n    if current_effect_id(world, &command) != *id {\n        return Err(WorkerReject::StaleAttempt);\n    }\n    if !contains(&world.inflight, id) {\n        return Err(WorkerReject::NotQueued);\n    }\n    if !effect_awaiting(world.effects.get(id)) {\n        return Err(WorkerReject::NotAwaiting);\n    }\n\n    match command {\n        Command::InstallFence {\n            sandbox,\n            epoch,\n            terminal,\n        } => {\n            let Some(record) = world.sandboxes.get(&sandbox) else {\n                return Err(WorkerReject::SandboxNotFound);\n            };\n            if epoch != record.epoch || terminal != record.terminal {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if !fence_can_advance(world.worker_fences.get(&sandbox), epoch, terminal) {\n                return Err(WorkerReject::FenceNotReady);\n            }\n            let next = if record.phase == Phase::Starting {\n                if record.terminal {\n                    return Err(WorkerReject::Terminal);\n                }\n                apply_start_fence(world, sandbox, record)\n            } else if revocation_phase(record.phase) {\n                if let Some(slot_id) = record.net_slot {\n                    let Some(slot) = world.net_slots.get(&slot_id) else {\n                        return Err(WorkerReject::ResourceNotFound);\n                    };\n                    if slot.sandbox != sandbox {\n                        return Err(WorkerReject::IdentityMismatch);\n                    }\n                }\n                apply_revocation_fence(world, sandbox, record)\n            } else {\n                return Err(WorkerReject::WrongPhase);\n            };\n            Ok(WorkerDecision {\n                event: WorkerEvent::InstallFence { sandbox },\n                next,\n            })\n        }\n        Command::PrepareVm {\n            sandbox,\n            epoch,\n            generation,\n            vm,\n            slot,\n            source,\n        } => {\n            let Some(record) = world.sandboxes.get(&sandbox) else {\n                return Err(WorkerReject::SandboxNotFound);\n            };\n            if record.phase != Phase::Starting {\n                return Err(WorkerReject::WrongPhase);\n            }\n            if record.terminal {\n                return Err(WorkerReject::Terminal);\n            }\n            if epoch != record.epoch || generation != record.generation {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            let (key, plan) = current_plan(world, sandbox, record)?;\n            if plan.key != key\n                || plan.epoch != record.epoch\n                || plan.generation != record.generation\n                || !plan.sealed\n                || plan.vm != Some(vm)\n                || plan.slot != Some(slot)\n                || plan.restore_from != source\n            {\n                return Err(WorkerReject::PlanMismatch);\n            }\n            if world.worker_fences.get(&sandbox)\n                != Some(&WorkerFence {\n                    epoch: record.epoch,\n                    terminal: false,\n                })\n            {\n                return Err(WorkerReject::FenceNotReady);\n            }\n            if world.vms.contains_key(&vm) || world.net_slots.contains_key(&slot) {\n                return Err(WorkerReject::ResultAlreadyPresent);\n            }\n            if source != record.restore_from {\n                return Err(WorkerReject::SourceUnavailable);\n            }\n            if let Some(selected) = source\n                && (record.durable_snapshot != Some(selected)\n                    || !usable_snapshot(world, sandbox, record, selected))\n            {\n                return Err(WorkerReject::SourceUnavailable);\n            }\n            Ok(WorkerDecision {\n                event: WorkerEvent::PrepareVm {\n                    sandbox,\n                    vm,\n                    slot,\n                    source,\n                },\n                next: prepare_resources(world, sandbox, record, vm, slot),\n            })\n        }\n        Command::ConfigureNetwork {\n            sandbox,\n            epoch,\n            generation,\n            vm,\n            slot,\n            policy,\n        } => {\n            let Some(record) = world.sandboxes.get(&sandbox) else {\n                return Err(WorkerReject::SandboxNotFound);\n            };\n            if record.phase != Phase::Starting {\n                return Err(WorkerReject::WrongPhase);\n            }\n            if record.terminal {\n                return Err(WorkerReject::Terminal);\n            }\n            if epoch != record.epoch || generation != record.generation || policy != record.policy {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            let Some(stored) = world.net_slots.get(&slot) else {\n                return Err(WorkerReject::ResourceNotFound);\n            };\n            if record.net_slot != Some(slot)\n                || record.current_vm != Some(vm)\n                || stored.owner != record.owner\n                || stored.sandbox != sandbox\n                || stored.generation != record.generation\n                || stored.vm != vm\n                || stored.policy != record.policy\n            {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if world.worker_fences.get(&sandbox)\n                != Some(&WorkerFence {\n                    epoch: record.epoch,\n                    terminal: false,\n                })\n            {\n                return Err(WorkerReject::FenceNotReady);\n            }\n            let mut next = world.clone();\n            let mut configured = stored.clone();\n            configured.configured = true;\n            put_slot(&mut next, slot, configured);\n            Ok(WorkerDecision {\n                event: WorkerEvent::ConfigureNetwork { sandbox, slot },\n                next,\n            })\n        }\n        Command::ApplyFilePolicy {\n            sandbox,\n            epoch,\n            generation,\n            workspace,\n            policy,\n        } => {\n            let Some(record) = world.sandboxes.get(&sandbox) else {\n                return Err(WorkerReject::SandboxNotFound);\n            };\n            if record.phase != Phase::Starting {\n                return Err(WorkerReject::WrongPhase);\n            }\n            if record.terminal {\n                return Err(WorkerReject::Terminal);\n            }\n            if epoch != record.epoch\n                || generation != record.generation\n                || workspace != record.workspace\n                || policy != record.file_policy\n            {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if world.worker_fences.get(&sandbox)\n                != Some(&WorkerFence {\n                    epoch: record.epoch,\n                    terminal: false,\n                })\n            {\n                return Err(WorkerReject::FenceNotReady);\n            }\n            let mut next = world.clone();\n            next.applied_file_policies.put(\n                sandbox,\n                AppliedFilePolicy {\n                    sandbox,\n                    generation: record.generation,\n                    workspace: record.workspace,\n                    policy: record.file_policy,\n                },\n            );\n            Ok(WorkerDecision {\n                event: WorkerEvent::ApplyFilePolicy {\n                    sandbox,\n                    generation: record.generation,\n                },\n                next,\n            })\n        }\n        Command::ActivateVm {\n            sandbox,\n            epoch,\n            generation,\n            vm,\n        } => {\n            let Some(record) = world.sandboxes.get(&sandbox) else {\n                return Err(WorkerReject::SandboxNotFound);\n            };\n            if record.phase != Phase::Starting {\n                return Err(WorkerReject::WrongPhase);\n            }\n            if record.terminal {\n                return Err(WorkerReject::Terminal);\n            }\n            if epoch != record.epoch\n                || generation != record.generation\n                || record.current_vm != Some(vm)\n            {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            let Some(stored_vm) = world.vms.get(&vm) else {\n                return Err(WorkerReject::ResourceNotFound);\n            };\n            if stored_vm.owner != record.owner\n                || stored_vm.sandbox != sandbox\n                || stored_vm.generation != record.generation\n            {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if stored_vm.status != VmStatus::Prepared {\n                return Err(WorkerReject::WrongPhase);\n            }\n            let Some(slot_id) = record.net_slot else {\n                return Err(WorkerReject::ResourceNotFound);\n            };\n            let Some(slot) = world.net_slots.get(&slot_id) else {\n                return Err(WorkerReject::ResourceNotFound);\n            };\n            if slot.vm != vm || !slot.configured {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if world.worker_fences.get(&sandbox)\n                != Some(&WorkerFence {\n                    epoch: record.epoch,\n                    terminal: false,\n                })\n            {\n                return Err(WorkerReject::FenceNotReady);\n            }\n            if !indexed_no_executing_vm(world, sandbox) {\n                return Err(WorkerReject::ResourceBusy);\n            }\n            let mut next = world.clone();\n            let mut executing = *stored_vm;\n            executing.status = VmStatus::Executing;\n            put_vm(&mut next, vm, executing);\n            Ok(WorkerDecision {\n                event: WorkerEvent::ActivateVm { sandbox, vm },\n                next,\n            })\n        }\n        Command::FreezeVm {\n            sandbox,\n            epoch,\n            generation,\n            vm,\n        } => {\n            let Some(record) = world.sandboxes.get(&sandbox) else {\n                return Err(WorkerReject::SandboxNotFound);\n            };\n            if record.phase != Phase::Pausing {\n                return Err(WorkerReject::WrongPhase);\n            }\n            if epoch != record.epoch\n                || generation != record.generation\n                || record.current_vm != Some(vm)\n            {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            let Some(stored_vm) = world.vms.get(&vm) else {\n                return Err(WorkerReject::ResourceNotFound);\n            };\n            if stored_vm.owner != record.owner\n                || stored_vm.sandbox != sandbox\n                || stored_vm.generation != record.generation\n            {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if stored_vm.status != VmStatus::Executing {\n                return Err(WorkerReject::WrongPhase);\n            }\n            if world.worker_fences.get(&sandbox)\n                != Some(&WorkerFence {\n                    epoch: record.epoch,\n                    terminal: false,\n                })\n            {\n                return Err(WorkerReject::FenceNotReady);\n            }\n            let mut next = world.clone();\n            let mut frozen = *stored_vm;\n            frozen.status = VmStatus::Frozen;\n            put_vm(&mut next, vm, frozen);\n            Ok(WorkerDecision {\n                event: WorkerEvent::FreezeVm { sandbox, vm },\n                next,\n            })\n        }\n        Command::SealSnapshot {\n            sandbox,\n            epoch,\n            generation,\n            vm,\n            workspace,\n            snapshot,\n            manifest,\n        } => {\n            let Some(record) = world.sandboxes.get(&sandbox) else {\n                return Err(WorkerReject::SandboxNotFound);\n            };\n            if record.phase != Phase::Pausing {\n                return Err(WorkerReject::WrongPhase);\n            }\n            if epoch != record.epoch\n                || generation != record.generation\n                || workspace != record.workspace\n            {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            let (key, plan) = current_plan(world, sandbox, record)?;\n            if plan.key != key\n                || plan.epoch != record.epoch\n                || plan.generation != record.generation\n                || !plan.sealed\n                || plan.vm != Some(vm)\n                || plan.target_snapshot != Some(RestoreSource { snapshot, manifest })\n            {\n                return Err(WorkerReject::PlanMismatch);\n            }\n            let Some(stored_vm) = world.vms.get(&vm) else {\n                return Err(WorkerReject::ResourceNotFound);\n            };\n            if record.current_vm != Some(vm)\n                || stored_vm.owner != record.owner\n                || stored_vm.sandbox != sandbox\n                || stored_vm.generation != record.generation\n            {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if stored_vm.status != VmStatus::Frozen {\n                return Err(WorkerReject::WrongPhase);\n            }\n            if world.worker_fences.get(&sandbox)\n                != Some(&WorkerFence {\n                    epoch: record.epoch,\n                    terminal: false,\n                })\n            {\n                return Err(WorkerReject::FenceNotReady);\n            }\n            if world.snapshots.contains_key(&snapshot) {\n                return Err(WorkerReject::ResultAlreadyPresent);\n            }\n            let mut next = world.clone();\n            put_snapshot(\n                &mut next,\n                snapshot,\n                Snapshot {\n                    owner: record.owner,\n                    sandbox,\n                    source_generation: record.generation,\n                    workspace: record.workspace,\n                    manifest,\n                    stage: SnapshotStage::LocalSealed,\n                    immutable: false,\n                },\n            );\n            Ok(WorkerDecision {\n                event: WorkerEvent::SealSnapshot {\n                    sandbox,\n                    snapshot,\n                    manifest,\n                },\n                next,\n            })\n        }\n        Command::CommitSnapshot {\n            sandbox,\n            epoch,\n            generation,\n            snapshot,\n            manifest,\n        } => {\n            let Some(stored) = world.snapshots.get(&snapshot) else {\n                return Err(WorkerReject::ResourceNotFound);\n            };\n            let Some(record) = world.sandboxes.get(&sandbox) else {\n                return Err(WorkerReject::SandboxNotFound);\n            };\n            if epoch != record.epoch\n                || generation != record.generation\n                || manifest != stored.manifest\n                || stored.sandbox != sandbox\n            {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if record.phase != Phase::Pausing {\n                return Err(WorkerReject::WrongPhase);\n            }\n            let Some(vm) = record.current_vm else {\n                return Err(WorkerReject::ResourceNotFound);\n            };\n            if stored.source_generation != record.generation || stored.workspace != record.workspace\n            {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if stored.stage != SnapshotStage::LocalSealed {\n                return Err(WorkerReject::SnapshotNotReady);\n            }\n            let mut next = world.clone();\n            let mut durable = *stored;\n            durable.stage = SnapshotStage::Durable;\n            durable.immutable = true;\n            put_snapshot(&mut next, snapshot, durable);\n            enqueue(\n                &mut next,\n                Command::StopVm {\n                    sandbox,\n                    epoch: record.epoch,\n                    generation: record.generation,\n                    vm,\n                },\n            );\n            Ok(WorkerDecision {\n                event: WorkerEvent::CommitSnapshot { snapshot },\n                next,\n            })\n        }\n        Command::StopVm {\n            sandbox,\n            epoch,\n            generation,\n            vm,\n        } => {\n            let Some(record) = world.sandboxes.get(&sandbox) else {\n                return Err(WorkerReject::SandboxNotFound);\n            };\n            let Some(stored_vm) = world.vms.get(&vm) else {\n                return Err(WorkerReject::ResourceNotFound);\n            };\n            if epoch != record.epoch\n                || generation != stored_vm.generation\n                || stored_vm.sandbox != sandbox\n            {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if !stoppable_vm_status(stored_vm.status) {\n                return Err(WorkerReject::WrongPhase);\n            }\n            if record.phase == Phase::Pausing {\n                if record.current_vm != Some(vm) {\n                    return Err(WorkerReject::IdentityMismatch);\n                }\n                if record.terminal {\n                    return Err(WorkerReject::Terminal);\n                }\n                if stored_vm.status != VmStatus::Frozen {\n                    return Err(WorkerReject::WrongPhase);\n                }\n                if world.worker_fences.get(&sandbox)\n                    != Some(&WorkerFence {\n                        epoch: record.epoch,\n                        terminal: false,\n                    })\n                {\n                    return Err(WorkerReject::FenceNotReady);\n                }\n                let (_, plan) = current_plan(world, sandbox, record)?;\n                let Some(target) = plan.target_snapshot else {\n                    return Err(WorkerReject::SnapshotNotReady);\n                };\n                let Some(stored_snapshot) = world.snapshots.get(&target.snapshot) else {\n                    return Err(WorkerReject::SnapshotNotReady);\n                };\n                if stored_snapshot.sandbox != sandbox\n                    || stored_snapshot.source_generation != record.generation\n                    || stored_snapshot.stage != SnapshotStage::Durable\n                    || !stored_snapshot.immutable\n                {\n                    return Err(WorkerReject::SnapshotNotReady);\n                }\n            } else if record.phase == Phase::Revoking {\n                if !record.terminal {\n                    return Err(WorkerReject::Terminal);\n                }\n                if world.worker_fences.get(&sandbox)\n                    != Some(&WorkerFence {\n                        epoch: record.epoch,\n                        terminal: true,\n                    })\n                {\n                    return Err(WorkerReject::FenceNotReady);\n                }\n            } else {\n                return Err(WorkerReject::WrongPhase);\n            }\n            let mut next = world.clone();\n            let mut stopped = *stored_vm;\n            stopped.status = VmStatus::Stopped;\n            put_vm(&mut next, vm, stopped);\n            Ok(WorkerDecision {\n                event: WorkerEvent::StopVm { sandbox, vm },\n                next,\n            })\n        }\n        Command::CleanupVm {\n            sandbox,\n            generation,\n            vm,\n        } => {\n            let Some(stored) = world.vms.get(&vm) else {\n                return Err(WorkerReject::ResourceNotFound);\n            };\n            if stored.sandbox != sandbox || stored.generation != generation {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if stored.status != VmStatus::Stopped {\n                return Err(WorkerReject::WrongPhase);\n            }\n            if let Some(record) = world.sandboxes.get(&sandbox)\n                && record.current_vm == Some(vm)\n            {\n                return Err(WorkerReject::ResourceStillCurrent);\n            }\n            let mut next = world.clone();\n            let mut reclaimed = *stored;\n            reclaimed.status = VmStatus::Reclaimed;\n            put_vm(&mut next, vm, reclaimed);\n            Ok(WorkerDecision {\n                event: WorkerEvent::CleanupVm {\n                    sandbox,\n                    generation,\n                    vm,\n                },\n                next,\n            })\n        }\n        Command::CleanupSlot {\n            sandbox,\n            generation,\n            slot,\n        } => {\n            let Some(stored) = world.net_slots.get(&slot) else {\n                return Err(WorkerReject::ResourceNotFound);\n            };\n            if stored.sandbox != sandbox || stored.generation != generation {\n                return Err(WorkerReject::IdentityMismatch);\n            }\n            if stored.active {\n                return Err(WorkerReject::ResourceBusy);\n            }\n            if stored.reclaimed {\n                return Err(WorkerReject::ResultAlreadyPresent);\n            }\n            if let Some(record) = world.sandboxes.get(&sandbox)\n                && record.net_slot == Some(slot)\n            {\n                return Err(WorkerReject::ResourceStillCurrent);\n            }\n            let mut next = world.clone();\n            let mut reclaimed = stored.clone();\n            reclaimed.active = false;\n            reclaimed.reclaimed = true;\n            put_slot(&mut next, slot, reclaimed);\n            Ok(WorkerDecision {\n                event: WorkerEvent::CleanupSlot {\n                    sandbox,\n                    generation,\n                    slot,\n                },\n                next,\n            })\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{WorkerEvent, WorkerReject, handle_worker};\n    use crate::effect::{handle_effect_dispatch, handle_effect_receipt};\n    use crate::model::{\n        Actor, Command, EffectId, EffectOutcome, FilePolicyRef, LogicalEffectId, NetworkPolicy,\n        VmStatus, WorkerFence, World,\n    };\n    use crate::request::{CreateRequest, handle_create};\n    use crate::scheduler::{handle_dispatch_prepare, handle_reserve_startup};\n    use crate::transition::operation_key;\n    use crate::{\n        FsId, NetSlotId, OperationId, PolicyDigest, ResultDigest, SandboxId, TenantId, VmId,\n    };\n\n    const SID: SandboxId = SandboxId(11);\n    const OPERATION: OperationId = OperationId(19);\n\n    fn created() -> World {\n        handle_create(\n            &World::default(),\n            CreateRequest {\n                actor: Actor::Tenant(TenantId(7)),\n                owner: TenantId(7),\n                sandbox: SID,\n                workspace: FsId(13),\n                file_policy: FilePolicyRef {\n                    digest: PolicyDigest(17),\n                },\n                policy: NetworkPolicy::DenyAll,\n                operation: OPERATION,\n            },\n        )\n        .expect(\"create\")\n        .next\n    }\n\n    fn dispatch(world: &World, command: Command) -> (World, EffectId) {\n        let logical = LogicalEffectId { command };\n        let attempt = world\n            .logical_effects\n            .get(&logical)\n            .map_or(0, |record| record.current_attempt);\n        let id = EffectId { logical, attempt };\n        let next = handle_effect_dispatch(world, id.clone())\n            .expect(\"dispatch\")\n            .next;\n        (next, id)\n    }\n\n    fn execute_and_acknowledge(world: &World, command: Command, result: u64) -> World {\n        let (dispatched, id) = dispatch(world, command);\n        let executed = handle_worker(&dispatched, &id)\n            .expect(\"worker execution\")\n            .next;\n        handle_effect_receipt(\n            &executed,\n            id,\n            EffectOutcome::Succeeded(ResultDigest(result)),\n        )\n        .expect(\"success receipt\")\n        .next\n    }\n\n    #[test]\n    fn stale_and_unqueued_attempts_are_rejected_before_command_guards() {\n        let world = created();\n        let command = Command::InstallFence {\n            sandbox: SID,\n            epoch: 1,\n            terminal: false,\n        };\n        let stale = EffectId {\n            logical: LogicalEffectId {\n                command: command.clone(),\n            },\n            attempt: 1,\n        };\n        assert_eq!(\n            handle_worker(&world, &stale),\n            Err(WorkerReject::StaleAttempt)\n        );\n\n        let initial = EffectId::initial(command);\n        let mut unqueued = world;\n        unqueued.inflight.clear();\n        assert_eq!(\n            handle_worker(&unqueued, &initial),\n            Err(WorkerReject::NotQueued)\n        );\n    }\n\n    #[test]\n    fn startup_worker_commands_reach_an_executing_prepared_environment() {\n        let world = execute_and_acknowledge(\n            &created(),\n            Command::InstallFence {\n                sandbox: SID,\n                epoch: 1,\n                terminal: false,\n            },\n            1,\n        );\n        assert_eq!(\n            world.worker_fences.get(&SID),\n            Some(&WorkerFence {\n                epoch: 1,\n                terminal: false,\n            })\n        );\n\n        let key = operation_key(SID, OPERATION);\n        let reserved = handle_reserve_startup(&world, key)\n            .expect(\"reserve startup\")\n            .next;\n        let plan = reserved.operation_plans.get(&key).expect(\"plan\");\n        let vm = plan.vm.expect(\"planned VM\");\n        let slot = plan.slot.expect(\"planned slot\");\n        let scheduled = handle_dispatch_prepare(&reserved, SID, vm, slot)\n            .expect(\"schedule prepare\")\n            .next;\n        let prepared = execute_and_acknowledge(\n            &scheduled,\n            Command::PrepareVm {\n                sandbox: SID,\n                epoch: 1,\n                generation: 1,\n                vm,\n                slot,\n                source: None,\n            },\n            2,\n        );\n        assert_eq!(\n            prepared.vms.get(&vm).map(|value| value.status),\n            Some(VmStatus::Prepared)\n        );\n        assert!(prepared.resource_index(SID).vms.contains(&vm));\n        assert!(prepared.resource_index(SID).slots.contains(&slot));\n\n        let configured = execute_and_acknowledge(\n            &prepared,\n            Command::ConfigureNetwork {\n                sandbox: SID,\n                epoch: 1,\n                generation: 1,\n                vm,\n                slot,\n                policy: NetworkPolicy::DenyAll,\n            },\n            3,\n        );\n        let policy_applied = execute_and_acknowledge(\n            &configured,\n            Command::ApplyFilePolicy {\n                sandbox: SID,\n                epoch: 1,\n                generation: 1,\n                workspace: FsId(13),\n                policy: FilePolicyRef {\n                    digest: PolicyDigest(17),\n                },\n            },\n            4,\n        );\n        let active = execute_and_acknowledge(\n            &policy_applied,\n            Command::ActivateVm {\n                sandbox: SID,\n                epoch: 1,\n                generation: 1,\n                vm,\n            },\n            5,\n        );\n        assert_eq!(\n            active.vms.get(&vm).map(|value| value.status),\n            Some(VmStatus::Executing)\n        );\n        assert!(\n            active\n                .net_slots\n                .get(&slot)\n                .is_some_and(|value| value.configured)\n        );\n        assert!(active.applied_file_policies.contains_key(&SID));\n    }\n\n    #[test]\n    fn activation_distinguishes_identity_mismatch_from_unprepared_vm() {\n        let mut world = created();\n        let vm = VmId(88);\n        let mut record = world.sandboxes.get(&SID).expect(\"sandbox\").clone();\n        record.current_vm = Some(vm);\n        world.sandboxes.put(SID, record.clone());\n        let machine = crate::model::Vm {\n            owner: record.owner,\n            sandbox: SID,\n            generation: record.generation,\n            status: VmStatus::Frozen,\n        };\n        super::put_vm(&mut world, vm, machine);\n        let command = Command::ActivateVm {\n            sandbox: SID,\n            epoch: record.epoch,\n            generation: record.generation,\n            vm,\n        };\n        crate::transition::enqueue(&mut world, command.clone());\n        let (world, id) = dispatch(&world, command);\n        assert_eq!(handle_worker(&world, &id), Err(WorkerReject::WrongPhase));\n\n        // Identity is checked first, even when the VM is also not prepared.\n        for mismatched in [\n            crate::model::Vm {\n                owner: TenantId(99),\n                ..machine\n            },\n            crate::model::Vm {\n                sandbox: SandboxId(99),\n                ..machine\n            },\n            crate::model::Vm {\n                generation: record.generation + 1,\n                ..machine\n            },\n        ] {\n            let mut invalid = world.clone();\n            invalid.vms.put(vm, mismatched);\n            assert_eq!(\n                handle_worker(&invalid, &id),\n                Err(WorkerReject::IdentityMismatch)\n            );\n        }\n    }\n\n    #[test]\n    fn prepare_rejects_resources_outside_the_sealed_plan() {\n        let mut world = created();\n        world.worker_fences.put(\n            SID,\n            WorkerFence {\n                epoch: 1,\n                terminal: false,\n            },\n        );\n        let command = Command::PrepareVm {\n            sandbox: SID,\n            epoch: 1,\n            generation: 1,\n            vm: VmId(88),\n            slot: NetSlotId(89),\n            source: None,\n        };\n        crate::transition::enqueue(&mut world, command.clone());\n        let (world, id) = dispatch(&world, command);\n        assert_eq!(handle_worker(&world, &id), Err(WorkerReject::PlanMismatch));\n    }\n\n    #[test]\n    fn worker_execution_survives_controller_unavailability() {\n        let command = Command::InstallFence {\n            sandbox: SID,\n            epoch: 1,\n            terminal: false,\n        };\n        let (mut world, id) = dispatch(&created(), command);\n        world.controller_up = false;\n        assert_eq!(\n            handle_worker(&world, &id).map(|decision| decision.event),\n            Ok(WorkerEvent::InstallFence { sandbox: SID })\n        );\n    }\n}\n"},{"id":12,"name":{"Local":"controller-core/src/publication.rs"},"crate_name":"sandbox_controller_core","contents":"use crate::SandboxId;\nuse crate::effect::effect_succeeded_check;\nuse crate::model::{\n    Authority, Command, EffectId, FailureKind, OperationKind, OperationResult, OperationStatus,\n    Phase, RestoreSource, SandboxRecord, SnapshotStage, VmStatus, WorkerFence, World,\n};\nuse crate::transition::operation_key;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum PublicationInput {\n    Running(SandboxId),\n    Paused(SandboxId, RestoreSource),\n    Destroyed(SandboxId),\n    Failed(SandboxId, FailureKind),\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum PublicationEvent {\n    PublishRunning(SandboxId),\n    PublishPaused(SandboxId, crate::SnapshotId),\n    PublishDestroyed(SandboxId),\n    PublishFailure(SandboxId, FailureKind),\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum PublicationReject {\n    ControllerDown,\n    SandboxNotFound,\n    VmNotFound,\n    SlotNotFound,\n    SnapshotNotFound,\n    OperationUnavailable,\n    WrongPhase,\n    TerminalMismatch,\n    FenceNotInstalled,\n    ResourceMismatch,\n    ResourceNotReady,\n    PolicyNotApplied,\n    PrerequisiteNotSucceeded,\n    ResourcesNotClosed,\n    StopReceiptsMissing,\n    WrongOperationKind,\n    WrongOperationStatus,\n    LedgerMismatch,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct PublicationDecision {\n    pub event: PublicationEvent,\n    pub next: World,\n}\n\nfn indexed_vms_closed(world: &World, sandbox: SandboxId) -> bool {\n    let index = world.resource_index(sandbox);\n    let mut cursor = 0;\n    while cursor < index.vms.len() {\n        let Some(vm) = world.vms.get(&index.vms[cursor]) else {\n            return false;\n        };\n        if vm.status != VmStatus::Stopped && vm.status != VmStatus::Reclaimed {\n            return false;\n        }\n        cursor += 1;\n    }\n    true\n}\n\nfn indexed_slots_closed(world: &World, sandbox: SandboxId) -> bool {\n    let index = world.resource_index(sandbox);\n    let mut cursor = 0;\n    while cursor < index.slots.len() {\n        let Some(slot) = world.net_slots.get(&index.slots[cursor]) else {\n            return false;\n        };\n        if slot.active {\n            return false;\n        }\n        cursor += 1;\n    }\n    true\n}\n\nfn stop_receipt_candidate(\n    world: &World,\n    sandbox: SandboxId,\n    generation: u64,\n    vm: crate::VmId,\n    candidate: &EffectId,\n) -> bool {\n    match candidate.command() {\n        Command::StopVm {\n            sandbox: command_sandbox,\n            generation: command_generation,\n            vm: command_vm,\n            ..\n        } => {\n            *command_sandbox == sandbox\n                && *command_generation == generation\n                && *command_vm == vm\n                && effect_succeeded_check(world, candidate.command())\n        }\n        Command::InstallFence { .. }\n        | Command::PrepareVm { .. }\n        | Command::ConfigureNetwork { .. }\n        | Command::ActivateVm { .. }\n        | Command::FreezeVm { .. }\n        | Command::ApplyFilePolicy { .. }\n        | Command::SealSnapshot { .. }\n        | Command::CommitSnapshot { .. }\n        | Command::CleanupVm { .. }\n        | Command::CleanupSlot { .. } => false,\n    }\n}\n\nfn vm_has_stop_receipt(\n    world: &World,\n    sandbox: SandboxId,\n    generation: u64,\n    vm: crate::VmId,\n) -> bool {\n    let mut cursor = 0;\n    while cursor < world.effect_keys.len() {\n        if stop_receipt_candidate(world, sandbox, generation, vm, &world.effect_keys[cursor]) {\n            return true;\n        }\n        cursor += 1;\n    }\n    false\n}\n\nfn indexed_stops_succeeded(world: &World, sandbox: SandboxId) -> bool {\n    let index = world.resource_index(sandbox);\n    let mut cursor = 0;\n    while cursor < index.vms.len() {\n        let vm_id = index.vms[cursor];\n        let Some(vm) = world.vms.get(&vm_id) else {\n            return false;\n        };\n        if !vm_has_stop_receipt(world, sandbox, vm.generation, vm_id) {\n            return false;\n        }\n        cursor += 1;\n    }\n    true\n}\n\nfn update_operation_result(\n    world: &mut World,\n    sandbox: SandboxId,\n    operation: crate::Operation,\n    result: OperationResult,\n) {\n    let key = operation_key(sandbox, operation.id);\n    if let Some(stored) = world.operations.get(&key) {\n        let mut ledger = stored.clone();\n        ledger.operation = operation;\n        ledger.result = Some(result);\n        world.operations.put(key, ledger);\n    }\n}\n\nfn publish_running(\n    world: &World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n    slot_id: crate::NetSlotId,\n    slot: &crate::NetSlot,\n) -> World {\n    let mut next = world.clone();\n    let mut running = record.clone();\n    running.phase = Phase::Running;\n    running.terminal = false;\n    running.restore_from = None;\n    if let Some(mut operation) = running.current_operation {\n        operation.status = OperationStatus::Succeeded;\n        running.current_operation = Some(operation);\n    }\n    let authority = Authority::Running {\n        sandbox,\n        generation: running.generation,\n        vm: slot.vm,\n        workspace: running.workspace,\n        access: running.workspace_access,\n        slot: slot_id,\n        policy: running.policy.clone(),\n    };\n    running.desired = authority.clone();\n    running.effective = authority;\n    let mut active_slot = slot.clone();\n    active_slot.active = true;\n    next.net_slots.put(slot_id, active_slot);\n    next.sandboxes.put(sandbox, running.clone());\n    if let Some(operation) = running.current_operation {\n        update_operation_result(\n            &mut next,\n            sandbox,\n            operation,\n            OperationResult::Running(running.generation),\n        );\n    }\n    next\n}\n\nfn publish_paused(\n    world: &World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n    source: RestoreSource,\n) -> World {\n    let mut next = world.clone();\n    let mut paused = record.clone();\n    paused.phase = Phase::Paused;\n    paused.current_vm = None;\n    paused.durable_snapshot = Some(source);\n    paused.restore_from = None;\n    paused.net_slot = None;\n    if let Some(mut operation) = paused.current_operation {\n        operation.status = OperationStatus::Succeeded;\n        paused.current_operation = Some(operation);\n    }\n    let authority = Authority::Paused { sandbox, source };\n    paused.desired = authority.clone();\n    paused.effective = authority;\n    next.sandboxes.put(sandbox, paused.clone());\n    if let Some(operation) = paused.current_operation {\n        update_operation_result(\n            &mut next,\n            sandbox,\n            operation,\n            OperationResult::Paused(source),\n        );\n    }\n    next\n}\n\nfn publish_destroyed(world: &World, sandbox: SandboxId, record: &SandboxRecord) -> World {\n    let mut next = world.clone();\n    let mut destroyed = record.clone();\n    destroyed.phase = Phase::Destroyed;\n    destroyed.terminal = true;\n    destroyed.current_vm = None;\n    destroyed.net_slot = None;\n    destroyed.desired = Authority::Closed;\n    destroyed.effective = Authority::Closed;\n    if let Some(mut operation) = destroyed.current_operation {\n        operation.status = OperationStatus::Succeeded;\n        destroyed.current_operation = Some(operation);\n    }\n    next.sandboxes.put(sandbox, destroyed.clone());\n    if let Some(operation) = destroyed.current_operation {\n        update_operation_result(&mut next, sandbox, operation, OperationResult::Destroyed);\n    }\n    next\n}\n\nfn publish_failure(\n    world: &World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n    failure: FailureKind,\n) -> World {\n    let mut next = world.clone();\n    let mut destroyed = record.clone();\n    destroyed.phase = Phase::Destroyed;\n    destroyed.terminal = true;\n    destroyed.current_vm = None;\n    destroyed.net_slot = None;\n    destroyed.desired = Authority::Closed;\n    destroyed.effective = Authority::Closed;\n    if let Some(mut operation) = destroyed.current_operation {\n        operation.status = OperationStatus::Failed(failure);\n        destroyed.current_operation = Some(operation);\n    }\n    next.sandboxes.put(sandbox, destroyed.clone());\n    if let Some(operation) = destroyed.current_operation {\n        update_operation_result(\n            &mut next,\n            sandbox,\n            operation,\n            OperationResult::Failed(failure),\n        );\n    }\n    next\n}\n\n/// Publish a fully prepared startup or resume as the only running authority.\n///\n/// # Errors\n/// Returns the first failed guard in Lean's publication order.\n#[allow(clippy::too_many_lines)]\npub fn handle_publish_running(\n    world: &World,\n    sandbox: SandboxId,\n) -> Result<PublicationDecision, PublicationReject> {\n    if !world.controller_up {\n        return Err(PublicationReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(PublicationReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Starting {\n        return Err(PublicationReject::WrongPhase);\n    }\n    if record.terminal {\n        return Err(PublicationReject::TerminalMismatch);\n    }\n    let Some(vm_id) = record.current_vm else {\n        return Err(PublicationReject::VmNotFound);\n    };\n    let Some(vm) = world.vms.get(&vm_id) else {\n        return Err(PublicationReject::VmNotFound);\n    };\n    if vm.owner != record.owner || vm.sandbox != sandbox || vm.generation != record.generation {\n        return Err(PublicationReject::ResourceMismatch);\n    }\n    if vm.status != VmStatus::Executing {\n        return Err(PublicationReject::ResourceNotReady);\n    }\n    let Some(slot_id) = record.net_slot else {\n        return Err(PublicationReject::SlotNotFound);\n    };\n    let Some(slot) = world.net_slots.get(&slot_id) else {\n        return Err(PublicationReject::SlotNotFound);\n    };\n    if slot.owner != record.owner\n        || slot.sandbox != sandbox\n        || slot.generation != record.generation\n        || slot.vm != vm_id\n        || slot.policy != record.policy\n        || !slot.configured\n        || slot.active\n    {\n        return Err(PublicationReject::ResourceNotReady);\n    }\n    if !indexed_slots_closed(world, sandbox) {\n        return Err(PublicationReject::ResourcesNotClosed);\n    }\n    if world.applied_file_policies.get(&sandbox)\n        != Some(&crate::AppliedFilePolicy {\n            sandbox,\n            generation: record.generation,\n            workspace: record.workspace,\n            policy: record.file_policy,\n        })\n    {\n        return Err(PublicationReject::PolicyNotApplied);\n    }\n    let fence = Command::InstallFence {\n        sandbox,\n        epoch: record.epoch,\n        terminal: false,\n    };\n    if !effect_succeeded_check(world, &fence) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    let prepare = Command::PrepareVm {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm: vm_id,\n        slot: slot_id,\n        source: record.restore_from,\n    };\n    if !effect_succeeded_check(world, &prepare) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    let configure = Command::ConfigureNetwork {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm: vm_id,\n        slot: slot_id,\n        policy: record.policy.clone(),\n    };\n    if !effect_succeeded_check(world, &configure) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    let activate = Command::ActivateVm {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm: vm_id,\n    };\n    if !effect_succeeded_check(world, &activate) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    let apply_policy = Command::ApplyFilePolicy {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        workspace: record.workspace,\n        policy: record.file_policy,\n    };\n    if !effect_succeeded_check(world, &apply_policy) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    let key = operation_key(sandbox, operation.id);\n    let Some(ledger) = world.operations.get(&key) else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    if ledger.sandbox != sandbox || ledger.operation != operation || ledger.result.is_some() {\n        return Err(PublicationReject::LedgerMismatch);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: false,\n        })\n    {\n        return Err(PublicationReject::FenceNotInstalled);\n    }\n    Ok(PublicationDecision {\n        event: PublicationEvent::PublishRunning(sandbox),\n        next: publish_running(world, sandbox, record, slot_id, slot),\n    })\n}\n\n/// Publish a durable pause after every exact pause command has succeeded.\n///\n/// # Errors\n/// Returns the first failed guard in Lean's publication order.\n#[allow(clippy::too_many_lines)]\npub fn handle_publish_paused(\n    world: &World,\n    sandbox: SandboxId,\n    source: RestoreSource,\n) -> Result<PublicationDecision, PublicationReject> {\n    if !world.controller_up {\n        return Err(PublicationReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(PublicationReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Pausing {\n        return Err(PublicationReject::WrongPhase);\n    }\n    let Some(snapshot) = world.snapshots.get(&source.snapshot) else {\n        return Err(PublicationReject::SnapshotNotFound);\n    };\n    if snapshot.owner != record.owner\n        || snapshot.sandbox != sandbox\n        || snapshot.source_generation != record.generation\n        || snapshot.workspace != record.workspace\n        || snapshot.manifest != source.manifest\n        || snapshot.stage != SnapshotStage::Durable\n        || !snapshot.immutable\n    {\n        return Err(PublicationReject::ResourceNotReady);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: false,\n        })\n    {\n        return Err(PublicationReject::FenceNotInstalled);\n    }\n    let Some(vm_id) = record.current_vm else {\n        return Err(PublicationReject::VmNotFound);\n    };\n    let fence = Command::InstallFence {\n        sandbox,\n        epoch: record.epoch,\n        terminal: false,\n    };\n    if !effect_succeeded_check(world, &fence) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    let freeze = Command::FreezeVm {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm: vm_id,\n    };\n    if !effect_succeeded_check(world, &freeze) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    let seal = Command::SealSnapshot {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm: vm_id,\n        workspace: record.workspace,\n        snapshot: source.snapshot,\n        manifest: source.manifest,\n    };\n    if !effect_succeeded_check(world, &seal) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    let commit = Command::CommitSnapshot {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        snapshot: source.snapshot,\n        manifest: source.manifest,\n    };\n    if !effect_succeeded_check(world, &commit) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    let stop = Command::StopVm {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm: vm_id,\n    };\n    if !effect_succeeded_check(world, &stop) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    if !indexed_vms_closed(world, sandbox) || !indexed_slots_closed(world, sandbox) {\n        return Err(PublicationReject::ResourcesNotClosed);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    let key = operation_key(sandbox, operation.id);\n    let Some(ledger) = world.operations.get(&key) else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    if ledger.sandbox != sandbox || ledger.operation != operation || ledger.result.is_some() {\n        return Err(PublicationReject::LedgerMismatch);\n    }\n    Ok(PublicationDecision {\n        event: PublicationEvent::PublishPaused(sandbox, source.snapshot),\n        next: publish_paused(world, sandbox, record, source),\n    })\n}\n\nconst fn operation_pending_or_unknown(status: OperationStatus) -> bool {\n    match status {\n        OperationStatus::Pending | OperationStatus::OutcomeUnknown => true,\n        OperationStatus::Compensating(_)\n        | OperationStatus::Succeeded\n        | OperationStatus::Failed(_) => false,\n    }\n}\n\nconst fn recoverable_operation_kind(kind: OperationKind) -> bool {\n    match kind {\n        OperationKind::Create | OperationKind::Pause | OperationKind::Resume => true,\n        OperationKind::Kill => false,\n    }\n}\n\n/// Publish terminal success only after the terminal fence, every planned stop,\n/// and every indexed resource closure are durably visible.\n///\n/// # Errors\n/// Returns the first failed guard in Lean's publication order.\n#[allow(clippy::too_many_lines)]\npub fn handle_publish_destroyed(\n    world: &World,\n    sandbox: SandboxId,\n) -> Result<PublicationDecision, PublicationReject> {\n    if !world.controller_up {\n        return Err(PublicationReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(PublicationReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Revoking {\n        return Err(PublicationReject::WrongPhase);\n    }\n    if !record.terminal {\n        return Err(PublicationReject::TerminalMismatch);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: true,\n        })\n    {\n        return Err(PublicationReject::FenceNotInstalled);\n    }\n    let fence = Command::InstallFence {\n        sandbox,\n        epoch: record.epoch,\n        terminal: true,\n    };\n    if !effect_succeeded_check(world, &fence) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    if !indexed_vms_closed(world, sandbox) {\n        return Err(PublicationReject::ResourcesNotClosed);\n    }\n    if !indexed_stops_succeeded(world, sandbox) {\n        return Err(PublicationReject::StopReceiptsMissing);\n    }\n    if !indexed_slots_closed(world, sandbox) {\n        return Err(PublicationReject::ResourcesNotClosed);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    if operation.kind != OperationKind::Kill {\n        return Err(PublicationReject::WrongOperationKind);\n    }\n    if !operation_pending_or_unknown(operation.status) {\n        return Err(PublicationReject::WrongOperationStatus);\n    }\n    let key = operation_key(sandbox, operation.id);\n    let Some(ledger) = world.operations.get(&key) else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    if ledger.sandbox != sandbox || ledger.operation != operation || ledger.result.is_some() {\n        return Err(PublicationReject::LedgerMismatch);\n    }\n    Ok(PublicationDecision {\n        event: PublicationEvent::PublishDestroyed(sandbox),\n        next: publish_destroyed(world, sandbox, record),\n    })\n}\n\n/// Publish terminal compensated failure after revocation is durably complete.\n///\n/// # Errors\n/// Returns the first failed guard in Lean's publication order.\n#[allow(clippy::too_many_lines)]\npub fn handle_publish_failure(\n    world: &World,\n    sandbox: SandboxId,\n    failure: FailureKind,\n) -> Result<PublicationDecision, PublicationReject> {\n    if !world.controller_up {\n        return Err(PublicationReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(PublicationReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Revoking {\n        return Err(PublicationReject::WrongPhase);\n    }\n    if !record.terminal {\n        return Err(PublicationReject::TerminalMismatch);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: true,\n        })\n    {\n        return Err(PublicationReject::FenceNotInstalled);\n    }\n    let fence = Command::InstallFence {\n        sandbox,\n        epoch: record.epoch,\n        terminal: true,\n    };\n    if !effect_succeeded_check(world, &fence) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    if !indexed_vms_closed(world, sandbox) {\n        return Err(PublicationReject::ResourcesNotClosed);\n    }\n    if !indexed_stops_succeeded(world, sandbox) {\n        return Err(PublicationReject::StopReceiptsMissing);\n    }\n    if !indexed_slots_closed(world, sandbox) {\n        return Err(PublicationReject::ResourcesNotClosed);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    if operation.status != OperationStatus::Compensating(failure) {\n        return Err(PublicationReject::WrongOperationStatus);\n    }\n    if !recoverable_operation_kind(operation.kind) {\n        return Err(PublicationReject::WrongOperationKind);\n    }\n    let key = operation_key(sandbox, operation.id);\n    let Some(ledger) = world.operations.get(&key) else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    if ledger.sandbox != sandbox || ledger.operation != operation || ledger.result.is_some() {\n        return Err(PublicationReject::LedgerMismatch);\n    }\n    Ok(PublicationDecision {\n        event: PublicationEvent::PublishFailure(sandbox, failure),\n        next: publish_failure(world, sandbox, record, failure),\n    })\n}\n\n/// Execute one publication request through the same four-way split as Lean's\n/// `handlePublication`.\n///\n/// # Errors\n/// Returns the selected handler's first failed guard.\npub fn handle_publication(\n    world: &World,\n    input: PublicationInput,\n) -> Result<PublicationDecision, PublicationReject> {\n    match input {\n        PublicationInput::Running(sandbox) => handle_publish_running(world, sandbox),\n        PublicationInput::Paused(sandbox, source) => handle_publish_paused(world, sandbox, source),\n        PublicationInput::Destroyed(sandbox) => handle_publish_destroyed(world, sandbox),\n        PublicationInput::Failed(sandbox, failure) => {\n            handle_publish_failure(world, sandbox, failure)\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{\n        PublicationEvent, PublicationInput, PublicationReject, handle_publication,\n        handle_publish_destroyed, handle_publish_failure, handle_publish_paused,\n        handle_publish_running,\n    };\n    use crate::model::{\n        AppliedFilePolicy, Authority, Command, EffectId, EffectOutcome, EffectStatus,\n        FilePolicyRef, LogicalEffectId, NetworkPolicy, Operation, OperationInput, OperationKind,\n        OperationLedgerRecord, OperationResult, OperationStatus, Phase, ResourceIndex,\n        RestoreSource, SandboxRecord, Snapshot, SnapshotStage, Vm, VmStatus, WorkerFence,\n        WorkspaceApiAccess, World,\n    };\n    use crate::transition::operation_key;\n    use crate::{\n        FsId, ManifestDigest, NetSlot, NetSlotId, OperationId, PolicyDigest, ResultDigest,\n        SandboxId, SnapshotId, SnapshotManifestRef, TenantId, VmId,\n    };\n\n    const OWNER: TenantId = TenantId(7);\n    const SID: SandboxId = SandboxId(11);\n    const VM: VmId = VmId(13);\n    const SLOT: NetSlotId = NetSlotId(17);\n    const OPERATION: OperationId = OperationId(19);\n    const WORKSPACE: FsId = FsId(23);\n    const FILE_POLICY: FilePolicyRef = FilePolicyRef {\n        digest: PolicyDigest(29),\n    };\n\n    fn operation(kind: OperationKind, status: OperationStatus) -> Operation {\n        Operation {\n            id: OPERATION,\n            epoch: 5,\n            kind,\n            status,\n        }\n    }\n\n    fn record(phase: Phase, terminal: bool, operation: Operation) -> SandboxRecord {\n        SandboxRecord {\n            owner: OWNER,\n            phase,\n            terminal,\n            epoch: 5,\n            generation: 3,\n            current_vm: Some(VM),\n            workspace: WORKSPACE,\n            workspace_access: WorkspaceApiAccess::ManagedReadWrite,\n            file_policy: FILE_POLICY,\n            durable_snapshot: None,\n            restore_from: None,\n            net_slot: Some(SLOT),\n            policy: NetworkPolicy::DenyAll,\n            desired: Authority::Closed,\n            effective: Authority::Closed,\n            current_operation: Some(operation),\n        }\n    }\n\n    fn put_ledger(world: &mut World, operation: Operation, input: OperationInput) {\n        world.operations.put(\n            operation_key(SID, OPERATION),\n            OperationLedgerRecord {\n                sandbox: SID,\n                operation,\n                input,\n                result: None,\n            },\n        );\n    }\n\n    fn acknowledge(world: &mut World, command: Command, result: u64) {\n        let logical = LogicalEffectId { command };\n        let id = EffectId {\n            logical,\n            attempt: 0,\n        };\n        world.effects.put(\n            id.clone(),\n            EffectStatus::Acknowledged(EffectOutcome::Succeeded(ResultDigest(result))),\n        );\n        world.effect_keys.push(id);\n    }\n\n    #[allow(clippy::too_many_lines)]\n    fn running_ready_world() -> World {\n        let operation = operation(OperationKind::Create, OperationStatus::Pending);\n        let mut world = World::default();\n        world\n            .sandboxes\n            .put(SID, record(Phase::Starting, false, operation));\n        world.vms.put(\n            VM,\n            Vm {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                status: VmStatus::Executing,\n            },\n        );\n        world.net_slots.put(\n            SLOT,\n            NetSlot {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                vm: VM,\n                policy: NetworkPolicy::DenyAll,\n                configured: true,\n                active: false,\n                reclaimed: false,\n            },\n        );\n        world.resource_indexes.put(\n            SID,\n            ResourceIndex {\n                vms: vec![VM],\n                slots: vec![SLOT],\n                snapshots: Vec::new(),\n            },\n        );\n        world.applied_file_policies.put(\n            SID,\n            AppliedFilePolicy {\n                sandbox: SID,\n                generation: 3,\n                workspace: WORKSPACE,\n                policy: FILE_POLICY,\n            },\n        );\n        world.worker_fences.put(\n            SID,\n            WorkerFence {\n                epoch: 5,\n                terminal: false,\n            },\n        );\n        put_ledger(\n            &mut world,\n            operation,\n            OperationInput::Create {\n                workspace: WORKSPACE,\n                network: NetworkPolicy::DenyAll,\n                file_policy: FILE_POLICY,\n            },\n        );\n        acknowledge(\n            &mut world,\n            Command::InstallFence {\n                sandbox: SID,\n                epoch: 5,\n                terminal: false,\n            },\n            1,\n        );\n        acknowledge(\n            &mut world,\n            Command::PrepareVm {\n                sandbox: SID,\n                epoch: 5,\n                generation: 3,\n                vm: VM,\n                slot: SLOT,\n                source: None,\n            },\n            2,\n        );\n        acknowledge(\n            &mut world,\n            Command::ConfigureNetwork {\n                sandbox: SID,\n                epoch: 5,\n                generation: 3,\n                vm: VM,\n                slot: SLOT,\n                policy: NetworkPolicy::DenyAll,\n            },\n            3,\n        );\n        acknowledge(\n            &mut world,\n            Command::ActivateVm {\n                sandbox: SID,\n                epoch: 5,\n                generation: 3,\n                vm: VM,\n            },\n            4,\n        );\n        acknowledge(\n            &mut world,\n            Command::ApplyFilePolicy {\n                sandbox: SID,\n                epoch: 5,\n                generation: 3,\n                workspace: WORKSPACE,\n                policy: FILE_POLICY,\n            },\n            5,\n        );\n        world\n    }\n\n    fn terminal_ready_world(kind: OperationKind, status: OperationStatus) -> World {\n        let operation = operation(kind, status);\n        let mut world = World::default();\n        world\n            .sandboxes\n            .put(SID, record(Phase::Revoking, true, operation));\n        world.vms.put(\n            VM,\n            Vm {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                status: VmStatus::Stopped,\n            },\n        );\n        world.net_slots.put(\n            SLOT,\n            NetSlot {\n                owner: OWNER,\n                sandbox: SID,\n                generation: 3,\n                vm: VM,\n                policy: NetworkPolicy::DenyAll,\n                configured: true,\n                active: false,\n                reclaimed: false,\n            },\n        );\n        world.resource_indexes.put(\n            SID,\n            ResourceIndex {\n                vms: vec![VM],\n                slots: vec![SLOT],\n                snapshots: Vec::new(),\n            },\n        );\n        world.worker_fences.put(\n            SID,\n            WorkerFence {\n                epoch: 5,\n                terminal: true,\n            },\n        );\n        let input = match kind {\n            OperationKind::Create => OperationInput::Create {\n                workspace: WORKSPACE,\n                network: NetworkPolicy::DenyAll,\n                file_policy: FILE_POLICY,\n            },\n            OperationKind::Pause => OperationInput::Pause { generation: 3 },\n            OperationKind::Resume => OperationInput::Resume {\n                source: RestoreSource {\n                    snapshot: SnapshotId(31),\n                    manifest: SnapshotManifestRef {\n                        digest: ManifestDigest(37),\n                    },\n                },\n            },\n            OperationKind::Kill => OperationInput::Kill { generation: 3 },\n        };\n        put_ledger(&mut world, operation, input);\n        acknowledge(\n            &mut world,\n            Command::InstallFence {\n                sandbox: SID,\n                epoch: 5,\n                terminal: true,\n            },\n            1,\n        );\n        acknowledge(\n            &mut world,\n            Command::StopVm {\n                sandbox: SID,\n                epoch: 5,\n                generation: 3,\n                vm: VM,\n            },\n            2,\n        );\n        world\n    }\n\n    #[test]\n    fn running_publication_atomically_installs_authority_and_ledger_result() {\n        let world = running_ready_world();\n        let decision = handle_publish_running(&world, SID).expect(\"publish running\");\n        assert_eq!(decision.event, PublicationEvent::PublishRunning(SID));\n        let record = decision.next.sandboxes.get(&SID).expect(\"sandbox\");\n        assert_eq!(record.phase, Phase::Running);\n        assert_eq!(record.desired, record.effective);\n        assert!(decision.next.net_slots.get(&SLOT).expect(\"slot\").active);\n        assert_eq!(\n            decision\n                .next\n                .operations\n                .get(&operation_key(SID, OPERATION))\n                .and_then(|ledger| ledger.result),\n            Some(OperationResult::Running(3))\n        );\n    }\n\n    #[test]\n    fn terminal_success_requires_stop_receipts_and_closes_authority() {\n        let world = terminal_ready_world(OperationKind::Kill, OperationStatus::Pending);\n        let decision = handle_publish_destroyed(&world, SID).expect(\"publish destroyed\");\n        let record = decision.next.sandboxes.get(&SID).expect(\"sandbox\");\n        assert_eq!(record.phase, Phase::Destroyed);\n        assert_eq!(record.desired, Authority::Closed);\n        assert_eq!(record.effective, Authority::Closed);\n        assert_eq!(\n            decision\n                .next\n                .operations\n                .get(&operation_key(SID, OPERATION))\n                .and_then(|ledger| ledger.result),\n            Some(OperationResult::Destroyed)\n        );\n\n        let mut missing = world;\n        missing\n            .effect_keys\n            .retain(|id| !matches!(id.command(), Command::StopVm { .. }));\n        assert_eq!(\n            handle_publish_destroyed(&missing, SID),\n            Err(PublicationReject::StopReceiptsMissing)\n        );\n    }\n\n    #[test]\n    fn compensated_failure_publishes_only_the_matching_final_failure() {\n        let failure = crate::FailureKind::StorageFailure;\n        let world = terminal_ready_world(\n            OperationKind::Create,\n            OperationStatus::Compensating(failure),\n        );\n        let decision =\n            handle_publish_failure(&world, SID, failure).expect(\"publish compensated failure\");\n        assert_eq!(\n            decision.event,\n            PublicationEvent::PublishFailure(SID, failure)\n        );\n        assert_eq!(\n            decision\n                .next\n                .operations\n                .get(&operation_key(SID, OPERATION))\n                .and_then(|ledger| ledger.result),\n            Some(OperationResult::Failed(failure))\n        );\n        assert_eq!(\n            handle_publish_failure(&world, SID, crate::FailureKind::InternalFailure),\n            Err(PublicationReject::WrongOperationStatus)\n        );\n    }\n\n    #[test]\n    fn unified_publication_dispatch_preserves_guard_priority() {\n        let mut world = running_ready_world();\n        world.controller_up = false;\n        assert_eq!(\n            handle_publication(&world, PublicationInput::Running(SID)),\n            Err(PublicationReject::ControllerDown)\n        );\n    }\n\n    #[test]\n    fn paused_publication_checks_the_exact_durable_source() {\n        let source = RestoreSource {\n            snapshot: SnapshotId(31),\n            manifest: SnapshotManifestRef {\n                digest: ManifestDigest(37),\n            },\n        };\n        let operation = operation(OperationKind::Pause, OperationStatus::Pending);\n        let mut world = terminal_ready_world(OperationKind::Pause, OperationStatus::Pending);\n        let mut paused = record(Phase::Pausing, false, operation);\n        paused.terminal = false;\n        world.sandboxes.put(SID, paused);\n        world.worker_fences.put(\n            SID,\n            WorkerFence {\n                epoch: 5,\n                terminal: false,\n            },\n        );\n        world.snapshots.put(\n            source.snapshot,\n            Snapshot {\n                owner: OWNER,\n                sandbox: SID,\n                source_generation: 3,\n                workspace: WORKSPACE,\n                manifest: source.manifest,\n                stage: SnapshotStage::Durable,\n                immutable: true,\n            },\n        );\n        acknowledge(\n            &mut world,\n            Command::InstallFence {\n                sandbox: SID,\n                epoch: 5,\n                terminal: false,\n            },\n            3,\n        );\n        acknowledge(\n            &mut world,\n            Command::FreezeVm {\n                sandbox: SID,\n                epoch: 5,\n                generation: 3,\n                vm: VM,\n            },\n            4,\n        );\n        acknowledge(\n            &mut world,\n            Command::SealSnapshot {\n                sandbox: SID,\n                epoch: 5,\n                generation: 3,\n                vm: VM,\n                workspace: WORKSPACE,\n                snapshot: source.snapshot,\n                manifest: source.manifest,\n            },\n            5,\n        );\n        acknowledge(\n            &mut world,\n            Command::CommitSnapshot {\n                sandbox: SID,\n                epoch: 5,\n                generation: 3,\n                snapshot: source.snapshot,\n                manifest: source.manifest,\n            },\n            6,\n        );\n        let decision = handle_publish_paused(&world, SID, source).expect(\"publish paused\");\n        let record = decision.next.sandboxes.get(&SID).expect(\"sandbox\");\n        assert_eq!(record.phase, Phase::Paused);\n        assert_eq!(record.durable_snapshot, Some(source));\n        assert_eq!(record.desired, record.effective);\n    }\n}\n"},{"id":13,"name":{"Local":"controller-core/src/recovery_monitor.rs"},"crate_name":"sandbox_controller_core","contents":"use crate::model::{EffectId, Phase, World};\nuse crate::{Generation, SandboxId};\n\n/// Controller-runtime inputs represented by `SandboxModel.RuntimeController`.\n#[derive(Clone, Debug, PartialEq, Eq)]\n#[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\npub enum RuntimeInput {\n    Crash,\n    Recover,\n    DuplicateOrLateDelivery(EffectId),\n}\n\n/// Runtime events emitted by an accepted input.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum RuntimeEvent {\n    ControllerCrash,\n    ControllerRecover,\n    DuplicateOrLateDelivery(EffectId),\n}\n\n/// Rejections from the ordered runtime guards.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum RuntimeReject {\n    ControllerAlreadyDown,\n    ControllerAlreadyUp,\n    EffectNotFound,\n}\n\n/// Successful pure reduction of a controller-runtime input.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct RuntimeDecision {\n    pub event: RuntimeEvent,\n    pub next: World,\n}\n\n/// Rust counterpart of `RuntimeController.handleCrash`.\n///\n/// # Errors\n///\n/// Returns [`RuntimeReject::ControllerAlreadyDown`] when the controller is\n/// already down. Rejection leaves the supplied world untouched.\npub fn handle_controller_crash(world: &World) -> Result<RuntimeDecision, RuntimeReject> {\n    if !world.controller_up {\n        return Err(RuntimeReject::ControllerAlreadyDown);\n    }\n\n    let mut next = world.clone();\n    next.controller_up = false;\n    Ok(RuntimeDecision {\n        event: RuntimeEvent::ControllerCrash,\n        next,\n    })\n}\n\n/// Rust counterpart of `RuntimeController.handleRecover`.\n///\n/// # Errors\n///\n/// Returns [`RuntimeReject::ControllerAlreadyUp`] when the controller is\n/// already up. Rejection leaves the supplied world untouched.\npub fn handle_controller_recover(world: &World) -> Result<RuntimeDecision, RuntimeReject> {\n    if world.controller_up {\n        return Err(RuntimeReject::ControllerAlreadyUp);\n    }\n\n    let mut next = world.clone();\n    next.controller_up = true;\n    Ok(RuntimeDecision {\n        event: RuntimeEvent::ControllerRecover,\n        next,\n    })\n}\n\n/// Rust counterpart of `RuntimeController.handleDuplicateOrLateDelivery`.\n///\n/// This observation is deliberately available while the controller is down:\n/// the matching Lean `Step` has only the persisted-effect guard and is a\n/// state-preserving transition.\n///\n/// # Errors\n///\n/// Returns [`RuntimeReject::EffectNotFound`] unless the exact attempt is in\n/// the durable effect table.\npub fn handle_duplicate_or_late_delivery(\n    world: &World,\n    effect: EffectId,\n) -> Result<RuntimeDecision, RuntimeReject> {\n    if !world.effects.contains_key(&effect) {\n        return Err(RuntimeReject::EffectNotFound);\n    }\n\n    Ok(RuntimeDecision {\n        event: RuntimeEvent::DuplicateOrLateDelivery(effect),\n        next: world.clone(),\n    })\n}\n\n/// Deterministic coordinator for controller-runtime inputs.\n///\n/// # Errors\n///\n/// Returns the first rejection from the selected handler's Lean guard.\npub fn handle_runtime(\n    world: &World,\n    input: RuntimeInput,\n) -> Result<RuntimeDecision, RuntimeReject> {\n    match input {\n        RuntimeInput::Crash => handle_controller_crash(world),\n        RuntimeInput::Recover => handle_controller_recover(world),\n        RuntimeInput::DuplicateOrLateDelivery(effect) => {\n            handle_duplicate_or_late_delivery(world, effect)\n        }\n    }\n}\n\n/// Observable sandbox projection used by the verified trace monitor.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct SandboxView {\n    pub phase: Phase,\n    pub terminal: bool,\n    pub generation: Generation,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\nstruct MonitorState {\n    accepted: bool,\n    seen_terminal: bool,\n}\n\nfn monitor_observation(seen_terminal: bool, observation: Option<SandboxView>) -> MonitorState {\n    match observation {\n        None => MonitorState {\n            accepted: true,\n            seen_terminal,\n        },\n        Some(current) if !seen_terminal => MonitorState {\n            accepted: true,\n            seen_terminal: current.terminal,\n        },\n        Some(current) => MonitorState {\n            accepted: current.terminal && current.phase != Phase::Running,\n            seen_terminal: true,\n        },\n    }\n}\n\n/// Rust counterpart of `Monitor.view`.\n#[must_use]\n#[allow(clippy::manual_map)]\npub fn view(world: &World, sandbox: SandboxId) -> Option<SandboxView> {\n    // Keep the projection as a direct match. Besides mirroring Lean's\n    // definition, this avoids adding `Option::map` to the extraction boundary.\n    match world.sandboxes.get(&sandbox) {\n        None => None,\n        Some(record) => Some(SandboxView {\n            phase: record.phase,\n            terminal: record.terminal,\n            generation: record.generation,\n        }),\n    }\n}\n\n/// Rust counterpart of `Monitor.monitorFrom`.\n///\n/// `seen_terminal` is a latch. Missing observations are skipped in either\n/// state. Before the latch is set, an observation only updates it; after it is\n/// set, every observable state must remain terminal and must not be running.\n#[must_use]\npub fn monitor_from(mut seen_terminal: bool, views: &[Option<SandboxView>]) -> bool {\n    let mut index = 0;\n    while index < views.len() {\n        let next = monitor_observation(seen_terminal, views[index]);\n        if !next.accepted {\n            return false;\n        }\n        seen_terminal = next.seen_terminal;\n        index += 1;\n    }\n    true\n}\n\n/// Check an observation sequence from an initially clear terminal latch.\n#[must_use]\npub fn monitor(views: &[Option<SandboxView>]) -> bool {\n    monitor_from(false, views)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{\n        RuntimeEvent, RuntimeInput, RuntimeReject, SandboxView, handle_controller_crash,\n        handle_controller_recover, handle_duplicate_or_late_delivery, handle_runtime, monitor,\n        monitor_from, view,\n    };\n    use crate::model::{\n        AppliedFilePolicy, Command, FilePolicyRef, NetSlot, NetworkPolicy, Phase, ResourceIndex,\n        Snapshot, SnapshotManifestRef, SnapshotStage, Vm, VmStatus, WorkerFence, World,\n    };\n    use crate::transition::begin_create;\n    use crate::{\n        FsId, ManifestDigest, NetSlotId, OperationId, PolicyDigest, SandboxId, SnapshotId,\n        TenantId, VmId,\n    };\n\n    const OWNER: TenantId = TenantId::new(1);\n    const SANDBOX: SandboxId = SandboxId::new(2);\n    const WORKSPACE: FsId = FsId::new(3);\n    const VM: VmId = VmId::new(4);\n    const SLOT: NetSlotId = NetSlotId::new(5);\n    const SNAPSHOT: SnapshotId = SnapshotId::new(6);\n    const OPERATION: OperationId = OperationId::new(7);\n    const FILE_POLICY: FilePolicyRef = FilePolicyRef {\n        digest: PolicyDigest::new(8),\n    };\n    const MANIFEST: SnapshotManifestRef = SnapshotManifestRef {\n        digest: ManifestDigest::new(9),\n    };\n\n    fn populated_world() -> World {\n        let mut world = begin_create(\n            &World::default(),\n            SANDBOX,\n            OWNER,\n            WORKSPACE,\n            FILE_POLICY,\n            NetworkPolicy::DenyAll,\n            OPERATION,\n        );\n        world.vms.put(\n            VM,\n            Vm {\n                owner: OWNER,\n                sandbox: SANDBOX,\n                generation: 1,\n                status: VmStatus::Prepared,\n            },\n        );\n        world.snapshots.put(\n            SNAPSHOT,\n            Snapshot {\n                owner: OWNER,\n                sandbox: SANDBOX,\n                source_generation: 1,\n                workspace: WORKSPACE,\n                manifest: MANIFEST,\n                stage: SnapshotStage::Durable,\n                immutable: true,\n            },\n        );\n        world.net_slots.put(\n            SLOT,\n            NetSlot {\n                owner: OWNER,\n                sandbox: SANDBOX,\n                generation: 1,\n                vm: VM,\n                policy: NetworkPolicy::DenyAll,\n                configured: true,\n                active: true,\n                reclaimed: false,\n            },\n        );\n        world.applied_file_policies.put(\n            SANDBOX,\n            AppliedFilePolicy {\n                sandbox: SANDBOX,\n                generation: 1,\n                workspace: WORKSPACE,\n                policy: FILE_POLICY,\n            },\n        );\n        world.worker_fences.put(\n            SANDBOX,\n            WorkerFence {\n                epoch: 1,\n                terminal: false,\n            },\n        );\n        world.resource_indexes.put(\n            SANDBOX,\n            ResourceIndex {\n                vms: vec![VM],\n                slots: vec![SLOT],\n                snapshots: vec![SNAPSHOT],\n            },\n        );\n        world.next_vm_id = 11;\n        world.next_slot_id = 12;\n        world.next_snapshot_id = 13;\n        world.next_manifest_digest = 14;\n        world\n    }\n\n    #[test]\n    fn crash_and_recovery_only_toggle_runtime_availability() {\n        let world = populated_world();\n\n        let crashed = handle_controller_crash(&world).expect(\"up controller must crash\");\n        let mut expected_crashed = world.clone();\n        expected_crashed.controller_up = false;\n        assert_eq!(crashed.event, RuntimeEvent::ControllerCrash);\n        assert_eq!(crashed.next, expected_crashed);\n        assert!(world.controller_up);\n\n        let recovered =\n            handle_controller_recover(&crashed.next).expect(\"down controller must recover\");\n        assert_eq!(recovered.event, RuntimeEvent::ControllerRecover);\n        assert_eq!(recovered.next, world);\n    }\n\n    #[test]\n    fn lifecycle_handlers_enforce_the_exact_runtime_guard() {\n        let up = populated_world();\n        assert_eq!(\n            handle_controller_recover(&up),\n            Err(RuntimeReject::ControllerAlreadyUp)\n        );\n\n        let mut down = up.clone();\n        down.controller_up = false;\n        assert_eq!(\n            handle_controller_crash(&down),\n            Err(RuntimeReject::ControllerAlreadyDown)\n        );\n    }\n\n    #[test]\n    fn runtime_coordinator_selects_the_matching_handler() {\n        let world = populated_world();\n        let crashed = handle_runtime(&world, RuntimeInput::Crash)\n            .expect(\"coordinator must route a legal crash\");\n        assert_eq!(crashed.event, RuntimeEvent::ControllerCrash);\n\n        let recovered = handle_runtime(&crashed.next, RuntimeInput::Recover)\n            .expect(\"coordinator must route a legal recovery\");\n        assert_eq!(recovered.event, RuntimeEvent::ControllerRecover);\n        assert_eq!(recovered.next, world);\n    }\n\n    #[test]\n    fn duplicate_delivery_requires_the_exact_persisted_attempt() {\n        let mut world = populated_world();\n        world.controller_up = false;\n        let persisted = world.effect_keys[0].clone();\n\n        let accepted = handle_duplicate_or_late_delivery(&world, persisted.clone())\n            .expect(\"persisted delivery must be observable even while down\");\n        assert_eq!(\n            accepted.event,\n            RuntimeEvent::DuplicateOrLateDelivery(persisted)\n        );\n        assert_eq!(accepted.next, world);\n\n        let missing = crate::EffectId::initial(Command::CleanupVm {\n            sandbox: SANDBOX,\n            generation: 99,\n            vm: VmId::new(99),\n        });\n        assert_eq!(\n            handle_duplicate_or_late_delivery(&world, missing),\n            Err(RuntimeReject::EffectNotFound)\n        );\n    }\n\n    #[test]\n    fn view_is_the_exact_observable_projection() {\n        let world = populated_world();\n        assert_eq!(\n            view(&world, SANDBOX),\n            Some(SandboxView {\n                phase: Phase::Starting,\n                terminal: false,\n                generation: 1,\n            })\n        );\n        assert_eq!(view(&world, SandboxId::new(404)), None);\n    }\n\n    #[test]\n    fn monitor_accepts_the_model_normal_lifecycle_example() {\n        let observations = [\n            Some(SandboxView {\n                phase: Phase::Starting,\n                terminal: false,\n                generation: 1,\n            }),\n            Some(SandboxView {\n                phase: Phase::Running,\n                terminal: false,\n                generation: 1,\n            }),\n            Some(SandboxView {\n                phase: Phase::Paused,\n                terminal: false,\n                generation: 1,\n            }),\n            Some(SandboxView {\n                phase: Phase::Starting,\n                terminal: false,\n                generation: 2,\n            }),\n            Some(SandboxView {\n                phase: Phase::Running,\n                terminal: false,\n                generation: 2,\n            }),\n        ];\n        assert!(monitor(&observations));\n    }\n\n    #[test]\n    fn monitor_rejects_running_after_terminal() {\n        let observations = [\n            Some(SandboxView {\n                phase: Phase::Paused,\n                terminal: false,\n                generation: 1,\n            }),\n            Some(SandboxView {\n                phase: Phase::Revoking,\n                terminal: true,\n                generation: 1,\n            }),\n            Some(SandboxView {\n                phase: Phase::Running,\n                terminal: false,\n                generation: 1,\n            }),\n        ];\n        assert!(!monitor(&observations));\n    }\n\n    #[test]\n    fn monitor_skips_missing_observations_without_clearing_the_latch() {\n        let terminal = SandboxView {\n            phase: Phase::Revoking,\n            terminal: true,\n            generation: 1,\n        };\n        let destroyed = SandboxView {\n            phase: Phase::Destroyed,\n            terminal: true,\n            generation: 1,\n        };\n        assert!(monitor(&[None, Some(terminal), None, Some(destroyed)]));\n        assert!(!monitor(&[\n            Some(terminal),\n            None,\n            Some(SandboxView {\n                phase: Phase::Paused,\n                terminal: false,\n                generation: 1,\n            }),\n        ]));\n    }\n\n    #[test]\n    fn monitor_from_matches_the_model_latch_boundary() {\n        let terminal_running = SandboxView {\n            phase: Phase::Running,\n            terminal: true,\n            generation: 1,\n        };\n\n        // `monitorFrom false` records the first terminal observation; the\n        // consistency check starts with the next observable entry.\n        assert!(monitor_from(false, &[Some(terminal_running)]));\n        assert!(!monitor_from(true, &[Some(terminal_running)]));\n        assert!(monitor_from(true, &[None]));\n        assert!(monitor_from(false, &[]));\n    }\n}\n"},{"id":14,"name":{"Local":"controller-core/src/transition.rs"},"crate_name":"sandbox_controller_core","contents":"use crate::model::{\n    Command, EffectId, EffectOrigin, EffectStatus, FailureKind, Filesystem, LogicalEffectId,\n    LogicalEffectRecord, Operation, OperationInput, OperationKey, OperationLedgerRecord,\n    OperationPlan, OperationResult, OperationStatus, RestoreSource, SandboxRecord,\n    SnapshotManifestRef, World,\n};\nuse crate::{\n    Actor, Authority, FilePolicyRef, FsId, NetworkPolicy, OperationKind, Phase, SandboxId,\n    SnapshotId, TenantId, VmId, WorkspaceApiAccess,\n};\n\npub const DEFAULT_RETRY_LIMIT: u64 = 3;\n\n#[must_use]\npub const fn operation_key(sandbox: SandboxId, operation: crate::OperationId) -> OperationKey {\n    OperationKey { sandbox, operation }\n}\n\n#[must_use]\npub fn authorized(actor: &Actor, owner: TenantId) -> bool {\n    actor == &Actor::Tenant(owner) || actor == &Actor::SystemController\n}\n\nfn insert_unique<T: Clone + PartialEq>(values: &mut Vec<T>, value: T) {\n    let mut index = 0;\n    while index < values.len() {\n        if values[index] == value {\n            return;\n        }\n        index += 1;\n    }\n    let mut updated = Vec::new();\n    updated.push(value);\n    let mut old_index = 0;\n    while old_index < values.len() {\n        updated.push(values[old_index].clone());\n        old_index += 1;\n    }\n    *values = updated;\n}\n\n#[must_use]\npub fn initial_operation_plan(\n    world: &World,\n    sandbox: SandboxId,\n    operation: Operation,\n    input: &OperationInput,\n) -> OperationPlan {\n    let index = world.resource_index(sandbox);\n    let generation = match input {\n        OperationInput::Create { .. } => 1,\n        OperationInput::Pause { generation } | OperationInput::Kill { generation } => *generation,\n        OperationInput::Resume { .. } => match world.sandboxes.get(&sandbox) {\n            Some(record) => record.generation,\n            None => 0,\n        },\n    };\n    let restore_from = match input {\n        OperationInput::Resume { source } => Some(*source),\n        OperationInput::Create { .. }\n        | OperationInput::Pause { .. }\n        | OperationInput::Kill { .. } => None,\n    };\n\n    OperationPlan {\n        key: operation_key(sandbox, operation.id),\n        epoch: operation.epoch,\n        generation,\n        vm: None,\n        slot: None,\n        restore_from,\n        target_snapshot: None,\n        stop_vms: index.vms,\n        close_slots: index.slots,\n        retry_limit: DEFAULT_RETRY_LIMIT,\n        sealed: operation.kind == OperationKind::Kill,\n    }\n}\n\npub fn store_new_operation(\n    world: &mut World,\n    sandbox: SandboxId,\n    operation: Operation,\n    input: OperationInput,\n) {\n    let key = operation_key(sandbox, operation.id);\n    let plan = initial_operation_plan(world, sandbox, operation, &input);\n    world.operations.put(\n        key,\n        OperationLedgerRecord {\n            sandbox,\n            operation,\n            input,\n            result: None,\n        },\n    );\n    world.operation_plans.put(key, plan);\n}\n\n#[must_use]\npub fn inferred_effect_origin(world: &World, command: &Command) -> EffectOrigin {\n    let sandbox = command.sandbox();\n    if let (Some(epoch), Some(record)) = (command.epoch(), world.sandboxes.get(&sandbox))\n        && let Some(operation) = record.current_operation\n        && operation.epoch == epoch\n    {\n        return EffectOrigin::Operation(operation_key(sandbox, operation.id));\n    }\n    EffectOrigin::Maintenance(sandbox)\n}\n\npub fn commit_effect(world: &mut World, command: Command) {\n    let id = EffectId::initial(command.clone());\n    if world.effects.contains_key(&id) {\n        return;\n    }\n\n    let logical = LogicalEffectId { command };\n    world.effects.put(id.clone(), EffectStatus::Committed);\n    insert_unique(&mut world.effect_keys, id);\n\n    if !world.logical_effects.contains_key(&logical) {\n        let origin = inferred_effect_origin(world, &logical.command);\n        world.logical_effects.put(\n            logical,\n            LogicalEffectRecord {\n                origin,\n                current_attempt: 0,\n                remaining_retries: DEFAULT_RETRY_LIMIT,\n                result: None,\n            },\n        );\n    }\n}\n\npub fn enqueue(world: &mut World, command: Command) {\n    let id = EffectId::initial(command.clone());\n    commit_effect(world, command);\n    insert_unique(&mut world.inflight, id);\n}\n\n#[must_use]\npub fn begin_create(\n    world: &World,\n    sandbox: SandboxId,\n    owner: TenantId,\n    workspace: FsId,\n    file_policy: FilePolicyRef,\n    policy: NetworkPolicy,\n    operation_id: crate::OperationId,\n) -> World {\n    let mut next = world.clone();\n    let operation = Operation {\n        id: operation_id,\n        epoch: 1,\n        kind: OperationKind::Create,\n        status: OperationStatus::Pending,\n    };\n    let record = SandboxRecord {\n        owner,\n        phase: crate::Phase::Starting,\n        terminal: false,\n        epoch: 1,\n        generation: 1,\n        current_vm: None,\n        workspace,\n        workspace_access: WorkspaceApiAccess::ManagedReadWrite,\n        file_policy,\n        durable_snapshot: None,\n        restore_from: None,\n        net_slot: None,\n        policy: policy.clone(),\n        desired: Authority::Closed,\n        effective: Authority::Closed,\n        current_operation: Some(operation),\n    };\n    next.filesystems.put(\n        workspace,\n        Filesystem {\n            owner,\n            sandbox,\n            created_generation: 1,\n        },\n    );\n    next.sandboxes.put(sandbox, record);\n    store_new_operation(\n        &mut next,\n        sandbox,\n        operation,\n        OperationInput::Create {\n            workspace,\n            network: policy,\n            file_policy,\n        },\n    );\n    enqueue(\n        &mut next,\n        Command::InstallFence {\n            sandbox,\n            epoch: 1,\n            terminal: false,\n        },\n    );\n    next\n}\n\n/// Begin a pause exactly as `SandboxModel.beginPause`: persist the new\n/// operation before committing its fence and freeze effects.\n#[must_use]\npub fn begin_pause(\n    world: &World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n    operation_id: crate::OperationId,\n    vm: VmId,\n    epoch: crate::Epoch,\n) -> World {\n    let mut next = world.clone();\n    let operation = Operation {\n        id: operation_id,\n        epoch,\n        kind: OperationKind::Pause,\n        status: OperationStatus::Pending,\n    };\n    let mut updated = record.clone();\n    updated.phase = Phase::Pausing;\n    updated.epoch = epoch;\n    updated.desired = Authority::Closed;\n    updated.current_operation = Some(operation);\n    next.sandboxes.put(sandbox, updated);\n    store_new_operation(\n        &mut next,\n        sandbox,\n        operation,\n        OperationInput::Pause {\n            generation: record.generation,\n        },\n    );\n    enqueue(\n        &mut next,\n        Command::InstallFence {\n            sandbox,\n            epoch,\n            terminal: false,\n        },\n    );\n    enqueue(\n        &mut next,\n        Command::FreezeVm {\n            sandbox,\n            epoch,\n            generation: record.generation,\n            vm,\n        },\n    );\n    next\n}\n\n/// Begin a resume exactly as `SandboxModel.beginResume`.\n#[must_use]\npub fn begin_resume(\n    world: &World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n    operation_id: crate::OperationId,\n    source: RestoreSource,\n    epoch: crate::Epoch,\n    generation: crate::Generation,\n) -> World {\n    let mut next = world.clone();\n    let operation = Operation {\n        id: operation_id,\n        epoch,\n        kind: OperationKind::Resume,\n        status: OperationStatus::Pending,\n    };\n    let mut updated = record.clone();\n    updated.phase = Phase::Starting;\n    updated.epoch = epoch;\n    updated.generation = generation;\n    updated.current_vm = None;\n    updated.restore_from = Some(source);\n    updated.net_slot = None;\n    updated.desired = Authority::Closed;\n    updated.effective = Authority::Closed;\n    updated.current_operation = Some(operation);\n    next.sandboxes.put(sandbox, updated);\n    store_new_operation(\n        &mut next,\n        sandbox,\n        operation,\n        OperationInput::Resume { source },\n    );\n    enqueue(\n        &mut next,\n        Command::InstallFence {\n            sandbox,\n            epoch,\n            terminal: false,\n        },\n    );\n    next\n}\n\n/// Return whether a kill may replace the current operation.  The comparison\n/// and lookup order mirrors `Controller.supersedeReadyCheck`.\n#[must_use]\npub fn supersede_ready_check(\n    world: &World,\n    sandbox: SandboxId,\n    current: Option<Operation>,\n) -> bool {\n    let Some(operation) = current else {\n        return true;\n    };\n    match operation.status {\n        OperationStatus::Pending | OperationStatus::OutcomeUnknown => {\n            match world.operations.get(&operation_key(sandbox, operation.id)) {\n                Some(ledger) => ledger.operation == operation && ledger.result.is_none(),\n                None => false,\n            }\n        }\n        OperationStatus::Compensating(_)\n        | OperationStatus::Succeeded\n        | OperationStatus::Failed(_) => true,\n    }\n}\n\nfn supersede_current_operation(world: &mut World, sandbox: SandboxId, current: Option<Operation>) {\n    let Some(operation) = current else {\n        return;\n    };\n    if !matches!(\n        operation.status,\n        OperationStatus::Pending | OperationStatus::OutcomeUnknown\n    ) {\n        return;\n    }\n    let key = operation_key(sandbox, operation.id);\n    let Some(ledger) = world.operations.get(&key) else {\n        return;\n    };\n    if ledger.operation != operation || ledger.result.is_some() {\n        return;\n    }\n    let mut superseded = ledger.clone();\n    superseded.operation.status = OperationStatus::Failed(FailureKind::Cancelled);\n    superseded.result = Some(OperationResult::Failed(FailureKind::Cancelled));\n    world.operations.put(key, superseded);\n}\n\n/// Begin a kill exactly as `SandboxModel.beginKill`, including finalizing an\n/// unfinished operation that the tombstone supersedes.\n#[must_use]\npub fn begin_kill(\n    world: &World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n    operation_id: crate::OperationId,\n    epoch: crate::Epoch,\n) -> World {\n    let mut next = world.clone();\n    let operation = Operation {\n        id: operation_id,\n        epoch,\n        kind: OperationKind::Kill,\n        status: OperationStatus::Pending,\n    };\n    supersede_current_operation(&mut next, sandbox, record.current_operation);\n    let mut updated = record.clone();\n    updated.phase = Phase::Revoking;\n    updated.terminal = true;\n    updated.epoch = epoch;\n    updated.desired = Authority::Closed;\n    updated.effective = record.effective.without_resume();\n    updated.current_operation = Some(operation);\n    next.sandboxes.put(sandbox, updated);\n    store_new_operation(\n        &mut next,\n        sandbox,\n        operation,\n        OperationInput::Kill {\n            generation: record.generation,\n        },\n    );\n    enqueue(\n        &mut next,\n        Command::InstallFence {\n            sandbox,\n            epoch,\n            terminal: true,\n        },\n    );\n    next\n}\n\n/// Convert the current create/resume/pause operation into terminal\n/// compensation while retaining its operation identity and durable plan.\n#[must_use]\npub fn begin_compensation(\n    world: &World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n    operation: Operation,\n    failure: FailureKind,\n) -> World {\n    let mut next = world.clone();\n    let mut compensating = operation;\n    compensating.status = OperationStatus::Compensating(failure);\n\n    let mut updated = record.clone();\n    updated.phase = Phase::Revoking;\n    updated.terminal = true;\n    updated.desired = Authority::Closed;\n    updated.effective = Authority::Closed;\n    updated.current_operation = Some(compensating);\n    next.sandboxes.put(sandbox, updated);\n\n    let key = operation_key(sandbox, operation.id);\n    if let Some(stored) = next.operations.get(&key) {\n        let mut ledger = stored.clone();\n        ledger.operation = compensating;\n        ledger.result = None;\n        next.operations.put(key, ledger);\n    }\n\n    enqueue(\n        &mut next,\n        Command::InstallFence {\n            sandbox,\n            epoch: record.epoch,\n            terminal: true,\n        },\n    );\n    next\n}\n\n/// Mark the current RPC operation as outcome-unknown in both the sandbox row\n/// and its operation ledger.  This is a journal-only transition: no worker\n/// command is invented from a client-side timeout.\n#[must_use]\npub fn mark_operation_outcome_unknown(\n    world: &World,\n    sandbox: SandboxId,\n    record: &SandboxRecord,\n    operation: Operation,\n) -> World {\n    let mut next = world.clone();\n    let mut unknown = operation;\n    unknown.status = OperationStatus::OutcomeUnknown;\n\n    let mut updated = record.clone();\n    updated.current_operation = Some(unknown);\n    next.sandboxes.put(sandbox, updated);\n\n    let key = operation_key(sandbox, operation.id);\n    if let Some(stored) = world.operations.get(&key) {\n        let mut ledger = stored.clone();\n        ledger.operation = unknown;\n        ledger.result = None;\n        next.operations.put(key, ledger);\n    }\n    next\n}\n\n/// Reserve the next startup VM and slot in the durable operation plan.\n#[must_use]\npub fn reserve_startup_resources(\n    world: &World,\n    key: OperationKey,\n    plan: &OperationPlan,\n) -> Option<World> {\n    if world.next_vm_id == u64::MAX || world.next_slot_id == u64::MAX {\n        return None;\n    }\n    let mut next = world.clone();\n    let vm = VmId(world.next_vm_id);\n    let slot = crate::NetSlotId(world.next_slot_id);\n    next.next_vm_id = world.next_vm_id + 1;\n    next.next_slot_id = world.next_slot_id + 1;\n    let mut reserved = plan.clone();\n    reserved.vm = Some(vm);\n    reserved.slot = Some(slot);\n    insert_unique(&mut reserved.stop_vms, vm);\n    insert_unique(&mut reserved.close_slots, slot);\n    reserved.sealed = true;\n    next.operation_plans.put(key, reserved);\n    Some(next)\n}\n\n/// Reserve the next pause snapshot and manifest in the durable operation plan.\n#[must_use]\npub fn reserve_pause_snapshot(\n    world: &World,\n    key: OperationKey,\n    plan: &OperationPlan,\n    vm: VmId,\n) -> Option<World> {\n    if world.next_snapshot_id == u64::MAX || world.next_manifest_digest == u64::MAX {\n        return None;\n    }\n    let mut next = world.clone();\n    let source = RestoreSource {\n        snapshot: SnapshotId(world.next_snapshot_id),\n        manifest: SnapshotManifestRef {\n            digest: crate::ManifestDigest(world.next_manifest_digest),\n        },\n    };\n    next.next_snapshot_id = world.next_snapshot_id + 1;\n    next.next_manifest_digest = world.next_manifest_digest + 1;\n    let mut reserved = plan.clone();\n    reserved.vm = Some(vm);\n    reserved.target_snapshot = Some(source);\n    reserved.sealed = true;\n    next.operation_plans.put(key, reserved);\n    Some(next)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{operation_key, reserve_pause_snapshot, reserve_startup_resources};\n    use crate::model::{OperationPlan, RestoreSource, World};\n    use crate::{\n        ManifestDigest, NetSlotId, OperationId, SandboxId, SnapshotId, SnapshotManifestRef, VmId,\n    };\n\n    fn plan() -> OperationPlan {\n        OperationPlan {\n            key: operation_key(SandboxId(1), OperationId(2)),\n            epoch: 3,\n            generation: 4,\n            vm: None,\n            slot: None,\n            restore_from: None,\n            target_snapshot: None,\n            stop_vms: vec![VmId(8)],\n            close_slots: vec![NetSlotId(9)],\n            retry_limit: 3,\n            sealed: false,\n        }\n    }\n\n    #[test]\n    fn startup_reservation_advances_cursors_and_prepends_cleanup_resources() {\n        let mut world = World {\n            next_vm_id: 21,\n            next_slot_id: 34,\n            ..World::default()\n        };\n        let plan = plan();\n        world.operation_plans.put(plan.key, plan.clone());\n\n        let next = reserve_startup_resources(&world, plan.key, &plan).expect(\"capacity\");\n        let reserved = next.operation_plans.get(&plan.key).expect(\"reserved plan\");\n        assert_eq!(next.next_vm_id, 22);\n        assert_eq!(next.next_slot_id, 35);\n        assert_eq!(reserved.vm, Some(VmId(21)));\n        assert_eq!(reserved.slot, Some(NetSlotId(34)));\n        assert_eq!(reserved.stop_vms, vec![VmId(21), VmId(8)]);\n        assert_eq!(reserved.close_slots, vec![NetSlotId(34), NetSlotId(9)]);\n        assert!(reserved.sealed);\n        assert_eq!(world.next_vm_id, 21);\n        assert_eq!(world.next_slot_id, 34);\n    }\n\n    #[test]\n    fn pause_reservation_advances_snapshot_and_manifest_cursors() {\n        let world = World {\n            next_snapshot_id: 55,\n            next_manifest_digest: 89,\n            ..World::default()\n        };\n        let plan = plan();\n        let next = reserve_pause_snapshot(&world, plan.key, &plan, VmId(8)).expect(\"capacity\");\n        let reserved = next.operation_plans.get(&plan.key).expect(\"reserved plan\");\n        assert_eq!(next.next_snapshot_id, 56);\n        assert_eq!(next.next_manifest_digest, 90);\n        assert_eq!(reserved.vm, Some(VmId(8)));\n        assert_eq!(\n            reserved.target_snapshot,\n            Some(RestoreSource {\n                snapshot: SnapshotId(55),\n                manifest: SnapshotManifestRef {\n                    digest: ManifestDigest(89),\n                },\n            })\n        );\n        assert!(reserved.sealed);\n    }\n\n    #[test]\n    fn reservations_fail_closed_at_the_machine_counter_boundary() {\n        let plan = plan();\n        let startup_world = World {\n            next_vm_id: u64::MAX,\n            ..World::default()\n        };\n        assert_eq!(\n            reserve_startup_resources(&startup_world, plan.key, &plan),\n            None\n        );\n\n        let snapshot_world = World {\n            next_manifest_digest: u64::MAX,\n            ..World::default()\n        };\n        assert_eq!(\n            reserve_pause_snapshot(&snapshot_world, plan.key, &plan, VmId(8)),\n            None\n        );\n    }\n}\n"},{"id":15,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"controller-core/src/ids.rs"},"crate_name":"sandbox_controller_core","contents":"macro_rules! identifier {\n    ($name:ident) => {\n        #[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]\n        #[cfg_attr(feature = \"serde\", derive(serde::Serialize, serde::Deserialize))]\n        pub struct $name(pub u64);\n\n        impl $name {\n            #[must_use]\n            pub const fn new(value: u64) -> Self {\n                Self(value)\n            }\n\n            #[must_use]\n            pub const fn value(self) -> u64 {\n                self.0\n            }\n        }\n    };\n}\n\nidentifier!(TenantId);\nidentifier!(SandboxId);\nidentifier!(VmId);\nidentifier!(FsId);\nidentifier!(SnapshotId);\nidentifier!(NetSlotId);\nidentifier!(OperationId);\nidentifier!(PolicyDigest);\nidentifier!(ManifestDigest);\nidentifier!(ResultDigest);\n\npub type Epoch = u64;\npub type Generation = u64;\npub type AttemptNo = u64;\n"},{"id":21,"name":{"Local":"controller-core/src/store.rs"},"crate_name":"sandbox_controller_core","contents":"/// A finite association list used by the verified core.\n///\n/// The production journal may index rows differently, but the reducer sees a\n/// finite value with last-write replacement semantics matching Lean's `put`.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct Store<K, V> {\n    entries: Vec<(K, V)>,\n}\n\nimpl<K, V> Default for Store<K, V> {\n    fn default() -> Self {\n        Self {\n            entries: Vec::new(),\n        }\n    }\n}\n\nimpl<K: PartialEq, V> Store<K, V> {\n    #[must_use]\n    pub fn get(&self, key: &K) -> Option<&V> {\n        let mut index = 0;\n        while index < self.entries.len() {\n            if &self.entries[index].0 == key {\n                return Some(&self.entries[index].1);\n            }\n            index += 1;\n        }\n        None\n    }\n\n    #[must_use]\n    pub fn contains_key(&self, key: &K) -> bool {\n        self.get(key).is_some()\n    }\n\n    pub fn put(&mut self, key: K, value: V) {\n        let mut index = 0;\n        while index < self.entries.len() {\n            if self.entries[index].0 == key {\n                self.entries[index].1 = value;\n                return;\n            }\n            index += 1;\n        }\n        self.entries.push((key, value));\n    }\n\n    #[must_use]\n    pub fn entries(&self) -> &[(K, V)] {\n        &self.entries\n    }\n}\n\nimpl<K: PartialEq, V: Copy> Store<K, V> {\n    /// Return an owned copy without keeping a borrow of the store alive across\n    /// later reducer branches.  All protocol ledger rows using this helper are\n    /// small copyable values.\n    #[must_use]\n    pub fn get_copy(&self, key: &K) -> Option<V> {\n        let mut index = 0;\n        while index < self.entries.len() {\n            if &self.entries[index].0 == key {\n                return Some(self.entries[index].1);\n            }\n            index += 1;\n        }\n        None\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::Store;\n\n    #[test]\n    fn put_replaces_without_duplicating_a_key() {\n        let mut store = Store::default();\n        store.put(7_u64, 11_u64);\n        store.put(7_u64, 13_u64);\n\n        assert_eq!(store.get(&7), Some(&13));\n        assert_eq!(store.entries().len(), 1);\n    }\n}\n"},{"id":22,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":24,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":28,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":29,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":30,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":31,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":32,"name":{"Local":"/rustc/library/core/src/default.rs"},"crate_name":"core","contents":null},{"id":33,"name":{"Local":"/rustc/library/core/src/intrinsics/mod.rs"},"crate_name":"core","contents":null},{"id":34,"name":{"Local":"/rustc/library/core/src/macros/mod.rs"},"crate_name":"core","contents":null},{"id":35,"name":{"Local":"/rustc/library/alloc/src/string.rs"},"crate_name":"alloc","contents":null},{"id":36,"name":{"Local":"/rustc/library/core/src/ops/deref.rs"},"crate_name":"core","contents":null},{"id":37,"name":{"Local":"/rustc/library/core/src/ops/try_trait.rs"},"crate_name":"core","contents":null},{"id":38,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null},{"id":39,"name":{"Local":"/rustc/library/alloc/src/vec/partial_eq.rs"},"crate_name":"alloc","contents":null},{"id":40,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":41,"name":{"Local":"/rustc/library/core/src/hash/mod.rs"},"crate_name":"core","contents":null}],