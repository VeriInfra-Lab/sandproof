handle_replay(world: &World, input: ReplayRequest) -> Result<Decision, Reject> {\n    let ReplayRequest {\n        actor,\n        sandbox,\n        operation,\n        kind,\n        input,\n    } = input;\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(Reject::SandboxNotFound);\n    };\n    if !authorized(&actor, record.owner) {\n        return Err(Reject::Unauthorized);\n    }\n    let key = operation_key(sandbox, operation);\n    let Some(ledger) = world.operations.get(&key) else {\n        return Err(Reject::OperationUnavailable);\n    };\n    if ledger.operation.kind != kind {\n        return Err(Reject::LedgerMismatch);\n    }\n    if ledger.input != input {\n        return Err(Reject::LedgerMismatch);\n    }\n\n    Ok(Decision {\n        event: Event::RetryOperation {\n            actor,\n            sandbox,\n            operation,\n            kind,\n            input,\n        },\n        next: world.clone(),\n    })\n}","attr_info":{"attributes":[{"DocComment":" Return a previously persisted operation without creating a new operation"},{"DocComment":" or changing durable state.  This intentionally remains available while the"},{"DocComment":" controller process is marked down, matching Lean's `handleReplay`."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns the first rejection from Lean's ordered replay checks."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":131},{"Deduplicated":99}],"output":{"Deduplicated":132}},"src":"Normal","body":{"Structured":{"span":{"Value":[5321,{"data":{"file_id":5,"beg":{"line":39