ox, operation);\n    if world.operations.contains_key(&key) {\n        return Err(Reject::OperationExists);\n    }\n    if world.operation_plans.contains_key(&key) {\n        return Err(Reject::OperationPlanExists);\n    }\n    if !authorized(&actor, record.owner) {\n        return Err(Reject::Unauthorized);\n    }\n    if record.epoch == u64::MAX || record.generation == u64::MAX {\n        return Err(Reject::CounterExhausted);\n    }\n    let epoch = record.epoch + 1;\n    let generation = record.generation + 1;\n\n    Ok(Decision {\n        event: Event::AcceptResume {\n            actor,\n            sandbox,\n            operation,\n        },\n        next: begin_resume(world, sandbox, record, operation, source, epoch, generation),\n    })\n}","attr_info":{"attributes":[{"DocComment":" Rust implementation of Lean's `Controller.handleResume`."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns the first rejection from Lean's ordered admission checks."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":131},{"Deduplicated":97}],"output":{"Deduplicated":132}},"src":"Normal","body":{"Structured":{"span":{"Value":[436,{"data":{"file_id":5,"beg":{"line":291,"col":0},"end":{"line":339,"col":1}},"generated_from_span":null}]},"bound_body_regions":67,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[437,{"data":{"file_id":5,"beg":{"line":291,"col":61},"end":{"line":291,"col":85}},"generated_from_span":null}]},"ty":{"Deduplicated":132}},{"index":1,"name":"world","span":{"Value":[438,{"data":{"file_id":5,"beg":{"line":291,"col":21},"end":{"li