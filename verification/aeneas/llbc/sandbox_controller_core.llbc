,{"Ident":["effect",0]},{"Ident":["handle_effect_finalize_failure",0]}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":497,"col":0},"end":{"line":532,"col":1}},"generated_from_span":null}},"source_text":"pub fn handle_effect_finalize_failure(\n    world: &World,\n    logical: LogicalEffectId,\n    failure: FailureKind,\n) -> Result<EffectDecision, EffectReject> {\n    if !world.controller_up {\n        return Err(EffectReject::ControllerDown);\n    }\n    let Some(stored) = world.logical_effects.get(&logical) else {\n        return Err(EffectReject::LogicalEffectNotFound);\n    };\n    let record = *stored;\n    if record.result.is_some() {\n        return Err(EffectReject::LogicalEffectAlreadyFinal);\n    }\n    let current = EffectId {\n        logical: logical.clone(),\n        attempt: record.current_attempt,\n    };\n    let Some(EffectStatus::Acknowledged(EffectOutcome::Failed(observed))) =\n        world.effects.get(&current)\n    else {\n        return Err(EffectReject::CurrentAttemptNotFailed);\n    };\n    if *observed != failure {\n        return Err(EffectReject::FailureMismatch);\n    }\n    if failure.retryable() && record.remaining_retries != 0 {\n        return Err(EffectReject::RetryStillAvailable);\n    }\n\n    Ok(EffectDecision {\n        event: Event::FinalizeEffectFailure(current, failure),\n        next: finalize_logical_failure(world, logical, failure),\n    })\n}","attr_info":{"attributes":[{"DocComment":" Mirrors `Controller.handleEffectFinalizeFailure`."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":" Returns the first failed guard in the same order as the Lean reducer."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"i