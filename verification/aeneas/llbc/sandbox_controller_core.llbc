           next: acknowledge_effect(world, id, outcome),\n            })\n        }\n        Some(EffectStatus::Acknowledged(recorded)) => {\n            if *recorded != outcome {\n                return Err(EffectReject::ConflictingReceipt);\n            }\n            Ok(EffectDecision {\n                event: Event::AcknowledgeEffect(id, outcome),\n                next: world.clone(),\n            })\n        }\n        Some(EffectStatus::Committed) => Err(EffectReject::NotAwaitingResult),\n    }\n}","attr_info":{"attributes":[{"DocComment":" Mirrors `Controller.handleEffectReceipt`."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":" Returns the first failed guard in the same order as the Lean reducer."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":131},{"Deduplicated":12},{"Deduplicated":80}],"output":{"Deduplicated":157}},"src":"Normal","body":{"Structured":{"span":{"Value":[5991,{"data":{"file_id":9,"beg":{"line":387,"col":0},"end":{"line":414,"col":1}},"generated_from_span":null}]},"bound_body_regions":64,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"Value":[5992,{"data":{"file_id":9,"beg":{"line":391,"col":5},"end":{"line":391,"col":41}},"generated_from_span":null}]},"ty":{"Deduplicated":157}},{"index":1,"name":"world","span":{"Value":[5993,{"data":{"file_id":9,"beg":{"line":388,"col":4},"end":{"line":388,"col":9}},"generated_from_span":null}]},"ty":{"Deduplicated":134}},{"index":2,"name":"id","span":{"Value":[5994,{"data":{"file_id":9,"beg":{"line":389,"col":4},"end":{"line":389,"col":6}},"generated_from_span":null}]},"ty":{"Deduplicated":12}},{"ind