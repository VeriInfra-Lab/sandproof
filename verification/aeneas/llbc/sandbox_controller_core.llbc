ageDead":147},"comments_before":[]},{"span":{"Deduplicated":7778},"id":64706,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":113,"item_meta":{"name":[{"Ident":["sandbox_controller_core",0]},{"Ident":["publication",0]},{"Ident":["handle_publish_destroyed",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":554,"col":0},"end":{"line":615,"col":1}},"generated_from_span":null}},"source_text":"pub fn handle_publish_destroyed(\n    world: &World,\n    sandbox: SandboxId,\n) -> Result<PublicationDecision, PublicationReject> {\n    if !world.controller_up {\n        return Err(PublicationReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(PublicationReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Revoking {\n        return Err(PublicationReject::WrongPhase);\n    }\n    if !record.terminal {\n        return Err(PublicationReject::TerminalMismatch);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: true,\n        })\n    {\n        return Err(PublicationReject::FenceNotInstalled);\n    }\n    let fence = Command::InstallFence {\n        sandbox,\n        epoch: record.epoch,\n        terminal: true,\n    };\n    if !effect_succeeded_check(world, &fence) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    if !indexed_vms_closed(world, sandbox) {\n        return Err(PublicationReject::ResourcesNotClosed);\n    }\n    if !indexed_stops_succeeded(world, sandbox) {\n        return Err(PublicationReject::StopReceiptsMissing);\n    }\n    if !indexed_slots_closed(world, sandbox) {\n        return Err(PublicationReject::ResourcesNotClosed);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    if operation.kind != OperationKind::Kill {\n        return Err(PublicationReject::WrongOperationKind);\n    }\n    if !operation_pending_or_unknown(operation.status) {\n        return Err(PublicationReject::WrongOperationStatus);\n    }\n    let key = operation_key(sandbox, operation.id);\n    let Some(ledger) = world.operations.get(&key) else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    if ledger.sandbox != sandbox || ledger.operation != operation || ledger.result.is_some() {\n        return Err(PublicationReject::LedgerMismatch);\n    }\n    Ok(PublicationDecision {\n        event: PublicationEvent::PublishDestroyed(sandbox),\n        next: publish_destroyed(world, sandbox, record),\n    })\n}","attr_info":{"attributes":[{"DocComment":" Publish terminal success only after the terminal fence, every planned stop,"},{"DocComment":" and every indexed resource closure are durably visible."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":" Returns the first failed guard in Lean's publication order."},{"Unknown":{"path":"allow","args":"clippy::too_many_lines"}}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":131},{"Deduplicated":20}],"output":{"Deduplicated":167}},"src":"Normal","body":{"Structured":{"span":{"Value":[7931,{"data":{"file_id":12,"beg":{"line":554,"col":0},"end":{"line":615,"col":1}},"generated_from_span":null}]},"bound_body_regions":137,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[7932,{"data":{"file_id":12,"beg":{"line":557,"col":5},"end":{"line":557,"col":51}},"generated_from_span":null}]},"ty":{"Deduplicated":167}},{"index":1,"name":"world","span":{"Value":[7933,{"data":{"file_id":12,"beg":{"lin