  return Err(SchedulerReject::WrongPhase);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(SchedulerReject::OperationUnavailable);\n    };\n    let key = operation_key(sandbox, operation.id);\n    let Some(plan) = world.operation_plans.get(&key) else {\n        return Err(SchedulerReject::PlanUnavailable);\n    };\n    if plan.key != key {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.epoch != record.epoch {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.generation != record.generation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if !plan.sealed {\n        return Err(SchedulerReject::PlanNotOpen);\n    }\n    if plan.target_snapshot != Some(RestoreSource { snapshot, manifest }) {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    let Some(vm_id) = record.current_vm else {\n        return Err(SchedulerReject::VmNotFound);\n    };\n    if plan.vm != Some(vm_id) {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    let Some(vm) = world.vms.get(&vm_id) else {\n        return Err(SchedulerReject::VmNotFound);\n    };\n    if vm.owner != record.owner || vm.sandbox != sandbox || vm.generation != record.generation {\n        return Err(SchedulerReject::ResourceMismatch);\n    }\n    if vm.status != crate::VmStatus::Frozen {\n        return Err(SchedulerReject::ResourceNotReady);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: false,\n        })\n    {\n        return Err(SchedulerReject::FenceNotInstalled);\n    }\n    let freeze = Command::FreezeVm {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm: vm_id,\n    };\n    if !effect_succeeded_check(world, &freeze) {\n        return Err(SchedulerReject::PrerequisiteNotSucceeded);\n    }\n    if world.snapshots.contains_key(&snapshot) {\n        return Err(SchedulerReject::ResourceAlreadyExists);\n    }\n\n    let command = Command::SealSnapshot {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm: vm_id,\n        workspace: record.workspace,\n        snapshot,\n        manifest,\n    };\n    let mut next = world.clone();\n    enqueue(&mut next, command);\n    Ok(Decision {\n        event: Event::ScheduleSealSnapshot {\n            sandbox,\n            snapshot,\n            manifest,\n        },\n        next,\n    })\n}","attr_info":{"attributes":[{"DocComment":" Rust implementation of Lean's `Controller.handleScheduleSealSnapshot`."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns the first rejection from Lean's ordered plan, VM, fence, freeze"},{"DocComment":" receipt, and snapshot-freshness checks."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":131},{"Deduplicated":20},{"Deduplicated":29},{"Deduplicated":79}],"output":{"Deduplicated":160}},"src":"Normal","body":{"Structured":{"span":{"Value":[1589,{"data":{"file_id":10,"beg":{"line":342,"col":0},"end":{"line":434,"col":1}},"generated_from_span":null}]},"bound_body_regions":177,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"span":{"Value":[1590,{"data":{"file_id":10,"beg":{"line":347,"col":5},"end":{"line":347,"col":38}},"generated_from_span":null}]},"ty":{"Deduplicated":160}},{"index":1,"name":"world","span":{"Value":[1591,{"data":{"file_id":10,"beg":{"line":343,"col":4},"end":{"line":343,"col":9}},"generated_from_span":null}]},"ty":{"Deduplicated":134}},{"index":2,"name":"sandbox","span":