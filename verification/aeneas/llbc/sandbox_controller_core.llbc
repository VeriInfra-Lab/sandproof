_id":26,"item_meta":{"name":[{"Ident":["sandbox_controller_core",0]},{"Ident":["scheduler",0]},{"Ident":["handle_schedule_stop_vm",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":508,"col":0},"end":{"line":581,"col":1}},"generated_from_span":null}},"source_text":"pub fn handle_schedule_stop_vm(\n    world: &World,\n    sandbox: SandboxId,\n    generation: Generation,\n    vm_id: VmId,\n) -> Result<Decision, SchedulerReject> {\n    if !world.controller_up {\n        return Err(SchedulerReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(SchedulerReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Revoking {\n        return Err(SchedulerReject::WrongPhase);\n    }\n    if !record.terminal {\n        return Err(SchedulerReject::Terminal);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(SchedulerReject::OperationUnavailable);\n    };\n    let key = operation_key(sandbox, operation.id);\n    let Some(plan) = world.operation_plans.get(&key) else {\n        return Err(SchedulerReject::PlanUnavailable);\n    };\n    if plan.key != key || plan.epoch != record.epoch || plan.generation != record.generation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if !plan.stop_vms.contains(&vm_id) {\n        return Err(SchedulerReject::ResourceNotPlanned);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: true,\n        })\n    {\n        return Err(SchedulerReject::FenceNotInstalled);\n    }\n    let fence = Command::InstallFence {\n        sandbox,\n        epoch: record.epoch,\n        terminal: true,\n    };\n    if !effect_succeeded_check(world, &fence) {\n        return Err(SchedulerReject::PrerequisiteNotSucceeded);\n    }\n    let Some(vm) = world.vms.get(&vm_id) else {\n        return Err(SchedulerReject::VmNotFound);\n    };\n    if vm.sandbox != sandbox || vm.generation != generation {\n        return Err(SchedulerReject::ResourceMismatch);\n    }\n    if !stoppable_vm_status(vm.status) {\n        return Err(SchedulerReject::ResourceNotReady);\n    }\n\n    let command = Command::StopVm {\n        sandbox,\n        epoch: record.epoch,\n        generation,\n        vm: vm_id,\n    };\n    let mut next = world.clone();\n    enqueue(&mut next, command);\n    Ok(Decision {\n        event: Event::ScheduleStopVm {\n            sandbox,\n            generation,\n            vm: vm_id,\n        },\n        next,\n    })\n}","attr_info":{"attributes":[{"DocComment":" Rust implementation of Lean's `Controller.handleScheduleStopVm`."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns the first rejection from Lean's revocation, terminal-fence,"},{"DocComment":" current fence-receipt, VM identity, and stoppable-state checks."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":131},{"Deduplicated":20},{"Deduplicated":6},{"Deduplicated":23}],"output":{"Deduplicated":160}},"src":"Normal","body":{"Structured":{"span":{"Value":[1992,{"data":{"file_id":10,"beg":{"line":508,"col":0},"end":{"line":581,"col":1}},"generated_from_span":null}]},"bound_body_regions":150,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"span":{"Value":[1993,{"data":{"file_id":10,"beg":{"line":513,"col":5},"end":{"line":513,"col":38}},"generated_from_span":null}]},"ty":{"Deduplicated":160}},{"index":1,"name":"world","span":{"Value":[1994,{"data":{"file_id":10,"beg":{"line":509,"col":4},"end":{"line":509,"col":9}},"generated_from_span":null