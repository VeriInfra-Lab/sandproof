0]},{"Ident":["handle_dispatch_prepare",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":250,"col":0},"end":{"line":334,"col":1}},"generated_from_span":null}},"source_text":"pub fn handle_dispatch_prepare(\n    world: &World,\n    sandbox: SandboxId,\n    vm: VmId,\n    slot: NetSlotId,\n) -> Result<Decision, SchedulerReject> {\n    if !world.controller_up {\n        return Err(SchedulerReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(SchedulerReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Starting {\n        return Err(SchedulerReject::WrongPhase);\n    }\n    if record.terminal {\n        return Err(SchedulerReject::Terminal);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(SchedulerReject::OperationUnavailable);\n    };\n    let key = operation_key(sandbox, operation.id);\n    let Some(plan) = world.operation_plans.get(&key) else {\n        return Err(SchedulerReject::PlanUnavailable);\n    };\n    if plan.key != key {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.epoch != record.epoch {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.generation != record.generation {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if !plan.sealed {\n        return Err(SchedulerReject::PlanNotOpen);\n    }\n    if plan.vm != Some(vm) {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.slot != Some(slot) {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if plan.restore_from != record.restore_from {\n        return Err(SchedulerReject::PlanMismatch);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: false,\n        })\n    {\n        return Err(SchedulerReject::FenceNotInstalled);\n    }\n    if world.vms.contains_key(&vm) {\n        return Err(SchedulerReject::ResourceAlreadyExists);\n    }\n    if world.net_slots.contains_key(&slot) {\n        return Err(SchedulerReject::ResourceAlreadyExists);\n    }\n    if !restore_source_ready_check(world, sandbox, record) {\n        return Err(SchedulerReject::RestoreSourceUnavailable);\n    }\n\n    let source = record.restore_from;\n    let command = Command::PrepareVm {\n        sandbox,\n        epoch: record.epoch,\n        generation: record.generation,\n        vm,\n        slot,\n        source,\n    };\n    let mut next = world.clone();\n    enqueue(&mut next, command);\n    Ok(Decision {\n        event: Event::DispatchPrepare {\n            sandbox,\n            vm,\n            slot,\n            source,\n        },\n        next,\n    })\n}","attr_info":{"attributes":[{"DocComment":" Rust implementation of Lean's `Controller.handleDispatchPrepare`."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns the first rejection from Lean's ordered plan, fence, resource, and"},{"DocComment":" restore-source checks.  An accepted decision only journals the prepare"},{"DocComment":" command; worker-side resource creation remains a later protocol step."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":131},{"Deduplicated":20},{"Deduplicated":23},{"Deduplicated":32}],"output":{"Deduplicated":160}},"src":"Normal","body":{"Structured":{"span":{"Value":[1357,{"data":{"file_id":10,"beg":{"line":250,"col":0},"end":{"line":334,"col":1}},"generated_from_span":null}]},"bound_body_regions":150,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"span":{"Value":[1358,{"data":{"file_id