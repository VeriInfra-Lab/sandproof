"Ident":["sandbox_controller_core",0]},{"Ident":["request",0]},{"Ident":["handle_create",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":164,"col":0},"end":{"line":214,"col":1}},"generated_from_span":null}},"source_text":"pub fn handle_create(world: &World, input: CreateRequest) -> Result<Decision, Reject> {\n    let CreateRequest {\n        actor,\n        owner,\n        sandbox,\n        workspace,\n        file_policy,\n        policy,\n        operation,\n    } = input;\n    if !world.controller_up {\n        return Err(Reject::ControllerDown);\n    }\n    if world.sandboxes.contains_key(&sandbox) {\n        return Err(Reject::SandboxExists);\n    }\n    if world.filesystems.contains_key(&workspace) {\n        return Err(Reject::WorkspaceExists);\n    }\n    let key = operation_key(sandbox, operation);\n    if world.operations.contains_key(&key) {\n        return Err(Reject::OperationExists);\n    }\n    if world.operation_plans.contains_key(&key) {\n        return Err(Reject::OperationPlanExists);\n    }\n    if !authorized(&actor, owner) {\n        return Err(Reject::Unauthorized);\n    }\n\n    Ok(Decision {\n        event: Event::AcceptCreate {\n            actor,\n            owner,\n            sandbox,\n            workspace,\n            file_policy,\n            policy: policy.clone(),\n            operation,\n        },\n        next: begin_create(\n            world,\n            sandbox,\n            owner,\n            workspace,\n            file_policy,\n            policy,\n            operation,\n        ),\n    })\n}","attr_info":{"attributes":[{"DocComment":" Rust implementation of Lean's `Controller.handleCreate`."},{"DocComment":""},{"DocComment":" Check order is part of the observable contract: malformed requests receive"},{"DocComment":" the same first rejection as the executable Lean reducer."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns the first `Reject` produced by the same ordered