ct::FailureUnjustified);\n    }\n\n    Ok(Decision {\n        event: Event::BeginCompensation { sandbox, failure },\n        next: begin_compensation(world, sandbox, record, operation, failure),\n    })\n}","attr_info":{"attributes":[{"DocComment":" Start the terminal compensation protocol for the current create, resume,"},{"DocComment":" or pause operation.  Worker-caused compensation requires the finalized"},{"DocComment":" failure of the exact current logical-effect attempt owned by that operation."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns the first rejection from Lean's ordered compensation checks."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":131},{"Deduplicated":101}],"output":{"Deduplicated":132}},"src":"Normal","body":{"Structured":{"span":{"Value":[5180,{"data":{"file_id":5,"beg":{"line":508,"col":0},"end":{"line":556,"col":1}},"generated_from_span":null}]},"bound_body_regions":72,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[5181,{"data":{"file_id":5,"beg":{"line":508,"col":73},"end":{"line":508,"col":97}},"generated_from_span":null}]},"ty":{"Deduplicated":132}},{"index":1,"name":"world","span":{"Value":[5182,{"data":{"file_id":5,"beg":{"line":508,"col":27},"end":{"line":508,"col":32}},"generated_from_span":null}]},"ty":{"Deduplicated":134}},{"index":2,"name":"input","span":{"Value":[5183,{"data":{"file_id":5,"beg":{"line":508,"col":42},"end":{"line":508,"col":47}},"generated_from_span":null}]},"ty":{"Deduplicated":101}},{"index":3,"name":"sandbox","span":{"Value":[5184,{"data":{"file_id":5,"beg":{"line":5