blicationReject::ControllerDown);\n    }\n    let Some(record) = world.sandboxes.get(&sandbox) else {\n        return Err(PublicationReject::SandboxNotFound);\n    };\n    if record.phase != Phase::Revoking {\n        return Err(PublicationReject::WrongPhase);\n    }\n    if !record.terminal {\n        return Err(PublicationReject::TerminalMismatch);\n    }\n    if world.worker_fences.get(&sandbox)\n        != Some(&WorkerFence {\n            epoch: record.epoch,\n            terminal: true,\n        })\n    {\n        return Err(PublicationReject::FenceNotInstalled);\n    }\n    let fence = Command::InstallFence {\n        sandbox,\n        epoch: record.epoch,\n        terminal: true,\n    };\n    if !effect_succeeded_check(world, &fence) {\n        return Err(PublicationReject::PrerequisiteNotSucceeded);\n    }\n    if !indexed_vms_closed(world, sandbox) {\n        return Err(PublicationReject::ResourcesNotClosed);\n    }\n    if !indexed_stops_succeeded(world, sandbox) {\n        return Err(PublicationReject::StopReceiptsMissing);\n    }\n    if !indexed_slots_closed(world, sandbox) {\n        return Err(PublicationReject::ResourcesNotClosed);\n    }\n    let Some(operation) = record.current_operation else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    if operation.status != OperationStatus::Compensating(failure) {\n        return Err(PublicationReject::WrongOperationStatus);\n    }\n    if !recoverable_operation_kind(operation.kind) {\n        return Err(PublicationReject::WrongOperationKind);\n    }\n    let key = operation_key(sandbox, operation.id);\n    let Some(ledger) = world.operations.get(&key) else {\n        return Err(PublicationReject::OperationUnavailable);\n    };\n    if ledger.sandbox != sandbox || ledger.operation != operation || ledger.result.is_some() {\n        return Err(PublicationReject::LedgerMismatch);\n    }\n    Ok(PublicationDecision {\n        event: PublicationEvent::PublishFailure(sandbox, failure),\n        next: publish_failure(world, sandbox, record, failure),\n    })\n}","attr_info":{"attributes":[{"DocComment":" Publish terminal compensated failure after revocation is durably complete."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":" Returns the first failed guard in Lean's publication order."},{"Unknown":{"path":"allow","args":"clippy::too_many_lines"}}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":131},{"Deduplicated":20},{"Deduplicated":11}],"output":{"Deduplicated":167}},"src":"Normal","body":{"Structured":{"span":{"Value":[7068,{"data":{"file_id":12,"beg":{"line":622,"col":0},"end":{"line":684,"col":1}},"generated_from_span":null}]},"bound_body_regions":134,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"Value":[7069,{"data":{"file_id":12,"beg":{"line":626,"col":5},"end":{"line":626,"col":51}},"generated_from_span":null}]},"ty":{"Deduplicated":167}},{"index":1,"name":"world","span":{"Value":[7070,{"data":{"file_id":12,"beg":{"line":623,"col":4},"end":{"line":623,"col":9}},"generated_from_span":null}]},"ty":{"Deduplicated":134}},{"index":2,"name":"sandbox","span":{"Value":[7071,{"data":{"file_id":12,"beg":{"line":624,"col":4},"end":{"line":624,"col":11}},"generated_from_span":null}]},"ty":{"Deduplicated":20}},{"index":3,"name":"failure","span":{"Value":[7072,{"data":{"file_id":12,"beg":{"line":625,"col":4},"end":{"line":625,"col":11}},"generated_from_span":null}]},"ty":{"Deduplicated":11}},{"index":4,"name":null,"span":{"Value":[7073,{"data":{"file_id":12,"beg":{"line":627,"col":8},"end":{"line":627,"col":27}},"generated_from_span":null}]},"ty":{"