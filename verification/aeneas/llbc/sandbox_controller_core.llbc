s);\n    }\n    if world.operation_plans.contains_key(&key) {\n        return Err(Reject::OperationPlanExists);\n    }\n    if !authorized(&actor, record.owner) {\n        return Err(Reject::Unauthorized);\n    }\n    if record.epoch == u64::MAX {\n        return Err(Reject::CounterExhausted);\n    }\n    let epoch = record.epoch + 1;\n\n    Ok(Decision {\n        event: Event::AcceptKill {\n            actor,\n            sandbox,\n            operation,\n        },\n        next: begin_kill(world, sandbox, record, operation, epoch),\n    })\n}","attr_info":{"attributes":[{"DocComment":" Rust implementation of Lean's `Controller.handleKill`."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns the first rejection from Lean's ordered admission checks."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":131},{"Deduplicated":98}],"output":{"Deduplicated":132}},"src":"Normal","body":{"Structured":{"span":{"Value":[584,{"data":{"file_id":5,"beg":{"line":346,"col":0},"end":{"line":390,"col":1}},"generated_from_span":null}]},"bound_body_regions":64,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[585,{"data":{"file_id":5,"beg":{"line":346,"col":57},"end":{"line":346,"col":81}},"generated_from_span":null}]},"ty":{"Deduplicated":132}},{"index":1,"name":"world","span":{"Value":[586,{"data":{"file_id":5,"beg":{"line":346,"col":19},"end":{"line":346,"col":24}},"generated_from_span":null}]},"ty":{"Deduplicated":134}},{"index":2,"name":"input","span":{"Value":[587,{"data":{"file_id":5,"beg":{"line":346,"col":34},"end":{"line":346,"col":39}},"genera