                && record.configured\n            }\n            None => false,\n        },\n        Command::ActivateVm {\n            sandbox,\n            generation,\n            vm,\n            ..\n        } => match world.vms.get(vm) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.generation == *generation\n                    && matches!(\n                        record.status,\n                        VmStatus::Executing\n                            | VmStatus::Frozen\n                            | VmStatus::Stopped\n                            | VmStatus::Reclaimed\n                    )\n            }\n            None => false,\n        },\n        Command::FreezeVm {\n            sandbox,\n            generation,\n            vm,\n            ..\n        } => match world.vms.get(vm) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.generation == *generation\n                    && matches!(\n                        record.status,\n                        VmStatus::Frozen | VmStatus::Stopped | VmStatus::Reclaimed\n                    )\n            }\n            None => false,\n        },\n        Command::ApplyFilePolicy {\n            sandbox,\n            generation,\n            workspace,\n            policy,\n            ..\n        } => match world.applied_file_policies.get(sandbox) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && *generation <= record.generation\n                    && record.workspace == *workspace\n                    && record.policy == *policy\n            }\n            None => false,\n        },\n        Command::SealSnapshot {\n            sandbox,\n            generation,\n            workspace,\n            snapshot,\n            manifest,\n            ..\n        } => match world.snapshots.get(snapshot) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.source_generation == *generation\n                    && record.workspace == *workspace\n                    && record.manifest == *manifest\n            }\n            None => false,\n        },\n        Command::CommitSnapshot {\n            sandbox,\n            generation,\n            snapshot,\n            manifest,\n            ..\n        } => match world.snapshots.get(snapshot) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.source_generation == *generation\n                    && record.manifest == *manifest\n                    && record.stage == crate::SnapshotStage::Durable\n                    && record.immutable\n            }\n            None => false,\n        },\n        Command::StopVm {\n            sandbox,\n            generation,\n            vm,\n            ..\n        } => match world.vms.get(vm) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.generation == *generation\n                    && matches!(record.status, VmStatus::Stopped | VmStatus::Reclaimed)\n            }\n            None => false,\n        },\n        Command::CleanupVm {\n            sandbox,\n            generation,\n            vm,\n        } => match world.vms.get(vm) {\n            Some(record) => {\n                record.sandbox == *sandbox\n                    && record.generation == *generation\n                    && record.status == VmStatus::Reclaimed\n            }\n            None => false,\n        },\n        Command::CleanupSlot {\n            sandbox,\n            generation,\n            slot,\n        } => match world.net_slots.get(slot) {\n            Some(record) => {\n                record.sandbox == *sandbox && record.generation == *generation && record.reclaimed\n            }\n            None => false,\n        },\n    }\n}","attr_info":{"attributes":[{"DocComment":" 