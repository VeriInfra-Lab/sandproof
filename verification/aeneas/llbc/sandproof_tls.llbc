{"charon_version":"0.1.254","translated":{"crate_name":"sandproof_internal","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::tls::verify_pin_bytes","crate::tls::leaf_pin_bytes"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate::tls"],"opaque":["rustls","rustls_pki_types","sha2","digest","generic_array","typenum","crypto_common"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"verification/aeneas/llbc/sandproof_tls.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":true,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"sandbox-internal/src/lib.rs"},"crate_name":"sandproof_internal","contents":"#![forbid(unsafe_code)]\n\n//! Bounded, mutually authenticated center/host transport.\n//! Shared authenticated transport for identity probes and high-level lifecycle\n//! intents. The center is the sole public product entrance.\n//! TLS material, registered endpoint and peer pins come from trusted assembly,\n//! never from a user/template or an HTTP header. Entrypoints explicitly choose\n//! paths/owners/bounds; a shared protected-file primitive avoids two loaders.\n\nmod artifact_client;\npub mod cache;\nmod client;\npub mod diagnostic;\n#[cfg(unix)]\nmod protected_files;\nmod protected_server;\nmod server;\npub mod status;\npub mod template;\nmod tls;\n\npub use artifact_client::ArtifactClient;\npub use cache::CacheReceiver;\npub use client::{InternalClient, RegisteredEndpoint};\n#[cfg(unix)]\npub use protected_files::{ProtectedFileError, check_protected_directory, read_protected};\npub use protected_server::{ProtectedHttp, ProtectedServer};\npub use server::{DataReceiver, InternalServer, LifecycleReceiver, ReceiveError, RejectLifecycle};\npub use template::ValidationReceiver;\npub use tls::{CertificatePin, ClientTls, ServerTls, TlsIdentity};\n\nuse std::{error::Error, fmt, time::Duration};\n\n// Both HTTP parsers use the same explicit budget; body limits are separate.\npub(crate) const HTTP_MAX_HEADERS: usize = 16;\npub(crate) const HTTP_HEADER_BUFFER_BYTES: usize = 8192;\n\n/// Explicit deployment budgets; no semaphore wait queue is created.\n#[derive(Clone, Copy, Debug)]\npub struct Limits {\n    pub(crate) max_connections: usize,\n    pub(crate) handshake_timeout: Duration,\n    pub(crate) request_timeout: Duration,\n}\n\nimpl Limits {\n    #[must_use]\n    pub const fn max_connections(&self) -> usize {\n        self.max_connections\n    }\n    /// # Errors\n    /// Rejects zero/oversized budgets and handshake deadlines beyond the call.\n    pub fn new(\n        max_connections: usize,\n        handshake_timeout: Duration,\n        request_timeout: Duration,\n    ) -> Result<Self, TransportError> {\n        if !(1..=8192).contains(&max_connections)\n            || handshake_timeout.is_zero()\n            || handshake_timeout > request_timeout\n            || request_timeout > Duration::from_hours(24)\n        {\n            return Err(TransportError::Configuration);\n        }\n        Ok(Self {\n            max_connections,\n            handshake_timeout,\n            request_timeout,\n        })\n    }\n}\n\n/// A communication failure is never definitive lifecycle failure/no effects.\n/// Callers of future effectful endpoints must retain the original operation.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum TransportError {\n    Configuration,\n    Overloaded,\n    Deadline,\n    Authentication,\n    Communication,\n    InvalidResponse,\n    Rejected,\n}\n\nimpl fmt::Display for TransportError {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        f.write_str(match self {\n            Self::Configuration => \"invalid internal transport configuration\",\n            Self::Overloaded => \"internal transport capacity exhausted\",\n            Self::Deadline => \"internal call deadline exceeded\",\n            Self::Authentication => \"internal peer authentication failed\",\n            Self::Communication => \"internal communication unavailable\",\n            Self::InvalidResponse => \"invalid internal response\",\n            Self::Rejected => \"internal request rejected\",\n        })\n    }\n}\n\nimpl Error for TransportError {}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"sandbox-internal/src/tls.rs"},"crate_name":"sandproof_internal","contents":"use crate::TransportError;\nuse rustls::{\n    ClientConfig, RootCertStore, ServerConfig,\n    pki_types::{CertificateDer, PrivateKeyDer},\n    server::WebPkiClientVerifier,\n};\nuse sha2::{Digest, Sha256};\nuse std::sync::Arc;\n\n/// Public certificate digest, registered out of band for an exact service role.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct CertificatePin([u8; 32]);\n\nimpl CertificatePin {\n    #[must_use]\n    pub fn from_certificate(certificate: &CertificateDer<'_>) -> Self {\n        certificate_pin_bytes(certificate.as_ref())\n    }\n}\n\n/// Trusted in-memory identity. Deliberately no Debug/Serialize of private keys.\npub struct TlsIdentity {\n    pub chain: Vec<CertificateDer<'static>>,\n    pub private_key: PrivateKeyDer<'static>,\n}\n\n#[derive(Clone)]\npub struct ServerTls {\n    pub(crate) config: Arc<ServerConfig>,\n    peer_pins: Vec<CertificatePin>,\n}\n\nimpl ServerTls {\n    /// Roots verify chain/time/client usage; pins additionally bind center role.\n    /// Rotation permits at most two protected, explicitly approved leaf pins.\n    /// # Errors\n    /// Rejects empty/invalid trust, identity and peer registration.\n    pub fn new(\n        identity: TlsIdentity,\n        roots: Vec<CertificateDer<'static>>,\n        peer_pins: Vec<CertificatePin>,\n    ) -> Result<Self, TransportError> {\n        Self::with_pin_limit(identity, roots, peer_pins, 2)\n    }\n    /// Protected artifact role with a finite set of registered host pins.\n    /// The HTTP handler still binds each TLS pin to the exact registered node.\n    /// # Errors\n    /// Rejects empty/duplicate/oversized registration or invalid TLS identity.\n    pub fn for_registered_hosts(\n        identity: TlsIdentity,\n        roots: Vec<CertificateDer<'static>>,\n        peer_pins: Vec<CertificatePin>,\n    ) -> Result<Self, TransportError> {\n        Self::with_pin_limit(identity, roots, peer_pins, 512)\n    }\n    fn with_pin_limit(\n        identity: TlsIdentity,\n        roots: Vec<CertificateDer<'static>>,\n        peer_pins: Vec<CertificatePin>,\n        maximum: usize,\n    ) -> Result<Self, TransportError> {\n        validate_material(&identity, &peer_pins, maximum)?;\n        let provider = Arc::new(rustls::crypto::ring::default_provider());\n        let verifier = WebPkiClientVerifier::builder_with_provider(\n            Arc::new(root_store(roots)?),\n            Arc::clone(&provider),\n        )\n        .build()\n        .map_err(|_| TransportError::Configuration)?;\n        let mut config = ServerConfig::builder_with_provider(provider)\n            .with_protocol_versions(&[&rustls::version::TLS13])\n            .map_err(|_| TransportError::Configuration)?\n            .with_client_cert_verifier(verifier)\n            .with_single_cert(identity.chain, identity.private_key)\n            .map_err(|_| TransportError::Configuration)?;\n        config.alpn_protocols = vec![b\"http/1.1\".to_vec()];\n        // Every new connection revalidates the certificate and current pin.\n        config.session_storage = Arc::new(rustls::server::NoServerSessionStorage {});\n        config.send_tls13_tickets = 0;\n        config.max_early_data_size = 0;\n        Ok(Self {\n            config: Arc::new(config),\n            peer_pins,\n        })\n    }\n\n    pub(crate) fn verify_peer(\n        &self,\n        certificates: Option<&[CertificateDer<'_>]>,\n    ) -> Result<(), TransportError> {\n        verify_pin(certificates, &self.peer_pins)\n    }\n    pub(crate) fn peer_pin(\n        &self,\n        certificates: Option<&[CertificateDer<'_>]>,\n    ) -> Result<CertificatePin, TransportError> {\n        self.verify_peer(certificates)?;\n        let bytes = certificate_chain_bytes(certificates);\n        leaf_pin_bytes(bytes.as_deref(), &Sha256CertificateDigest)\n    }\n}\n\n#[derive(Clone)]\npub struct ClientTls {\n    pub(crate) config: Arc<ClientConfig>,\n    peer_pins: Vec<CertificatePin>,\n}\n\nimpl ClientTls {\n    /// Roots and DNS name verify server validity; pins bind exact host role.\n    /// # Errors\n    /// Rejects empty/invalid trust, identity and peer registration.\n    pub fn new(\n        identity: TlsIdentity,\n        roots: Vec<CertificateDer<'static>>,\n        peer_pins: Vec<CertificatePin>,\n    ) -> Result<Self, TransportError> {\n        validate_material(&identity, &peer_pins, 2)?;\n        let mut config =\n            ClientConfig::builder_with_provider(Arc::new(rustls::crypto::ring::default_provider()))\n                .with_protocol_versions(&[&rustls::version::TLS13])\n                .map_err(|_| TransportError::Configuration)?\n                .with_root_certificates(root_store(roots)?)\n                .with_client_auth_cert(identity.chain, identity.private_key)\n                .map_err(|_| TransportError::Configuration)?;\n        config.alpn_protocols = vec![b\"http/1.1\".to_vec()];\n        config.enable_early_data = false;\n        config.resumption = rustls::client::Resumption::disabled();\n        Ok(Self {\n            config: Arc::new(config),\n            peer_pins,\n        })\n    }\n\n    pub(crate) fn verify_peer(\n        &self,\n        certificates: Option<&[CertificateDer<'_>]>,\n    ) -> Result<(), TransportError> {\n        verify_pin(certificates, &self.peer_pins)\n    }\n}\n\nfn validate_material(\n    identity: &TlsIdentity,\n    pins: &[CertificatePin],\n    maximum: usize,\n) -> Result<(), TransportError> {\n    if identity.chain.is_empty()\n        || identity.chain.len() > 8\n        || !(1..=maximum).contains(&pins.len())\n        || pins\n            .iter()\n            .enumerate()\n            .any(|(i, pin)| pins[..i].contains(pin))\n        || identity.chain.iter().any(|cert| cert.len() > 64 * 1024)\n        || identity.private_key.secret_der().len() > 64 * 1024\n    {\n        Err(TransportError::Configuration)\n    } else {\n        Ok(())\n    }\n}\n\nfn root_store(roots: Vec<CertificateDer<'static>>) -> Result<RootCertStore, TransportError> {\n    if roots.is_empty() || roots.len() > 8 || roots.iter().any(|root| root.len() > 64 * 1024) {\n        return Err(TransportError::Configuration);\n    }\n    let mut store = RootCertStore::empty();\n    for root in roots {\n        store.add(root).map_err(|_| TransportError::Configuration)?;\n    }\n    Ok(store)\n}\n\nfn verify_pin(\n    certificates: Option<&[CertificateDer<'_>]>,\n    pins: &[CertificatePin],\n) -> Result<(), TransportError> {\n    let bytes = certificate_chain_bytes(certificates);\n    verify_pin_bytes(bytes.as_deref(), pins, &Sha256CertificateDigest)\n}\n\nfn certificate_chain_bytes(certificates: Option<&[CertificateDer<'_>]>) -> Option<Vec<Vec<u8>>> {\n    certificates.map(|chain| {\n        chain\n            .iter()\n            .map(|certificate| certificate.as_ref().to_vec())\n            .collect()\n    })\n}\n\ntrait CertificateDigest {\n    fn digest(&self, certificate: &[u8]) -> CertificatePin;\n}\n\nstruct Sha256CertificateDigest;\n\nimpl CertificateDigest for Sha256CertificateDigest {\n    fn digest(&self, certificate: &[u8]) -> CertificatePin {\n        CertificatePin(Sha256::digest(certificate).into())\n    }\n}\n\nfn certificate_pin_bytes(certificate: &[u8]) -> CertificatePin {\n    Sha256CertificateDigest.digest(certificate)\n}\n\nfn verify_pin_bytes<H: CertificateDigest>(\n    certificates: Option<&[Vec<u8>]>,\n    pins: &[CertificatePin],\n    hasher: &H,\n) -> Result<(), TransportError> {\n    let Some(chain) = certificates else {\n        return Err(TransportError::Authentication);\n    };\n    let Some(leaf) = chain.first() else {\n        return Err(TransportError::Authentication);\n    };\n    if pins.contains(&hasher.digest(leaf)) {\n        Ok(())\n    } else {\n        Err(TransportError::Authentication)\n    }\n}\n\n// This reads a leaf digest only; it does not authorize the peer.\n// The real ServerTls::peer_pin calls verify_peer first and propagates refusal.\nfn leaf_pin_bytes<H: CertificateDigest>(\n    certificates: Option<&[Vec<u8>]>,\n    hasher: &H,\n) -> Result<CertificatePin, TransportError> {\n    let Some(chain) = certificates else {\n        return Err(TransportError::Authentication);\n    };\n    let Some(leaf) = chain.first() else {\n        return Err(TransportError::Authentication);\n    };\n    Ok(hasher.digest(leaf))\n}\n"},{"id":6,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":12,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":13,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/ops/deref.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/array/equality.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array":[{"Value":[2,{"TypeVar":{"Bound":[0,0]}}]},{"Value":[0,[{"Var":{"Bound":[0,0]}},{"Deduplicated":0}]]},null]}]},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1},"kind":"InherentImplBlock"}}},{"Ident":["as_mut_slice",0]}]},{"key":{"Fun":2},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["repeat",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}}]},{"key":{"Fun":3},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}},{"Ident":["index",0]}]},{"key":{"TraitImpl":1},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":1}}]},{"key":{"Fun":4},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":1}},{"Ident":["index",0]}]},{"key":{"TraitImpl":2},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":2}}]},{"key":{"Fun":5},"value":[{"Ident":["core",0]},{"Id