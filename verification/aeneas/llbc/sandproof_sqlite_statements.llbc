{"charon_version":"0.1.254","translated":{"crate_name":"sandproof_controller_service","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::journal::statement_core::next_revision","crate::journal::statement_core::update_existing"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["sandproof_controller_service","sandproof_protocol"],"opaque":["rusqlite","serde_json","std::io"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/zn/candidate-tuple-preflight-first/original.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":true,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"controller-service/src/lib.rs"},"crate_name":"sandproof_controller_service","contents":"#![forbid(unsafe_code)]\n\n//! Single-node durable journal and post-commit dispatch boundary.\n//!\n//! `ControllerJournal` delegates lifecycle decisions to the existing pure\n//! core and atomically persists accepted inputs, projections, and actions.\n//! The lower-level `Journal` remains an opaque persistence primitive, not a\n//! second production writer. Physical host claims require a trusted adapter.\n\n#[cfg(test)]\nextern crate self as sandproof_controller_service;\n\npub mod application;\npub use application::BuildWindow;\n#[cfg(feature = \"durable\")]\nmod controller;\n#[cfg(feature = \"durable\")]\nmod dispatch;\nmod host_contract;\n#[cfg(feature = \"durable\")]\nmod journal;\npub mod physical_storage;\npub mod template_registry;\npub mod templates;\n#[cfg(feature = \"durable\")]\nmod workflow;\n\npub use host_contract::{\n    AdmissionError, AdmissionLimits, BoundedHostConfig, ConsolePolicy, CreateNetwork,\n    CreateNetworking, CreateOptions, DEFAULT_STARTUP_TIMEOUT_SECS, DEFAULT_TIMEOUT_SECS,\n    HostEvidence, HostSlotContext, WorkerTransportError,\n};\n\n/// Current original host metadata format when the authenticated inbox is\n/// explicitly provisioned. Older experimental formats are refused, not upgraded.\npub const INTERNAL_INBOX_FORMAT_VERSION: i64 =\n    sandproof_protocol::internal::HOST_STORE_FORMAT_VERSION;\n\n#[cfg(feature = \"durable\")]\npub use controller::{\n    BuildAnchor, BuildRetryConfig, CapacityConfig, CheckpointInfo, CheckpointProgress,\n    ControllerJournal, CreateAdmission, HostReleaseWitness, InternalAdmission, InternalAudit,\n    InternalAuditOperation, InternalCreateResult, InternalInboxConfig, InternalLocalBinding,\n    InternalNativeAudit, InternalRetentionLane, InternalTemplate, InternalWorkState, Lifetime,\n    MaintenanceConfig, RetirementCandidate,\n};\n\n#[cfg(feature = \"durable\")]\npub use dispatch::DispatchResult;\n#[cfg(feature = \"durable\")]\npub use journal::{\n    AcceptedWrite, DispatchState, Journal, RecordedReceipt, StorageSettings, StoredOperation,\n    StoredSandbox,\n};\n#[cfg(feature = \"durable\")]\npub use workflow::{\n    finish_accepted_kill_v1, finish_admitted_create_v1, finish_admitted_create_v1_timed,\n    finish_compensating_create_v1, kill_v1,\n};\n\n#[cfg(feature = \"durable\")]\nuse rusqlite::Error as SqliteError;\nuse sandproof_protocol::ContractError;\nuse std::error::Error;\nuse std::fmt::{self, Display};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CrashPoint {\n    BeforeCommit,\n    AfterCommit,\n    BeforeDispatchClaim,\n    AfterDispatchClaim,\n    AfterWorkerCall,\n    AfterRetirementDelete,\n}\n\n/// Tests inject a process stop at a named boundary. Production uses `NeverCrash`.\npub trait CrashInjector {\n    /// # Errors\n    /// Returns `JournalError::InjectedCrash` when the selected point is hit.\n    fn hit(&mut self, point: CrashPoint) -> Result<(), JournalError>;\n}\n\npub struct NeverCrash;\n\nimpl CrashInjector for NeverCrash {\n    fn hit(&mut self, _point: CrashPoint) -> Result<(), JournalError> {\n        Ok(())\n    }\n}\n\n#[derive(Debug)]\npub enum JournalError {\n    Io(std::io::Error),\n    #[cfg(feature = \"durable\")]\n    Sqlite(SqliteError),\n    #[cfg(feature = \"durable\")]\n    CommitUncertain(SqliteError),\n    Json(serde_json::Error),\n    Contract(ContractError),\n    Conflict,\n    IdentifierExhausted,\n    MaintenanceCapacity,\n    RevisionConflict,\n    ReceiptBeforeDispatch,\n    ConflictingReceipt,\n    UnsupportedStore,\n    CorruptStore,\n    CredentialIndexPoisoned,\n    InjectedCrash(CrashPoint),\n    ControllerRejected(sandbox_controller_core::controller::ControllerReject),\n    ControllerBusy,\n    UnsupportedInput,\n    UnresolvedAction,\n    OperationFailed,\n    InvalidHostEvidence,\n    ObsoleteReceipt,\n}\n\nimpl JournalError {\n    /// A rejected observation or transition belongs to one sandbox. Durable\n    /// storage, replay, and commit errors are deliberately not in this list:\n    /// their scope cannot be established, so recovery must stop globally.\n    #[must_use]\n    pub fn is_local_recovery_failure(&self) -> bool {\n        matches!(\n            self,\n            Self::Contract(_)\n                | Self::ReceiptBeforeDispatch\n                | Self::ConflictingReceipt\n                | Self::ControllerRejected(_)\n                | Self::UnsupportedInput\n                | Self::UnresolvedAction\n                | Self::OperationFailed\n                | Self::InvalidHostEvidence\n                | Self::ObsoleteReceipt\n        )\n    }\n}\n\nimpl Display for JournalError {\n    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n        match self {\n            Self::MaintenanceCapacity => {\n                formatter.write_str(\"configured maintenance capacity exhausted\")\n            }\n            Self::IdentifierExhausted => {\n                formatter.write_str(\"controller identifier space exhausted\")\n            }\n            Self::Io(error) => write!(formatter, \"controller filesystem error: {error}\"),\n            #[cfg(feature = \"durable\")]\n            Self::Sqlite(error) => write!(formatter, \"sqlite journal error: {error}\"),\n            #[cfg(feature = \"durable\")]\n            Self::CommitUncertain(error) => {\n                write!(\n                    formatter,\n                    \"sqlite commit outcome must be reconciled: {error}\"\n                )\n            }\n            Self::Json(error) => write!(formatter, \"journal message error: {error}\"),\n            Self::Contract(error) => write!(formatter, \"protocol contract error: {error}\"),\n            Self::Conflict => formatter.write_str(\"journal identity conflict\"),\n            Self::RevisionConflict => formatter.write_str(\"sandbox revision conflict\"),\n            Self::ReceiptBeforeDispatch => formatter.write_str(\"receipt before dispatch claim\"),\n            Self::ConflictingReceipt => formatter.write_str(\"conflicting receipt for one attempt\"),\n            Self::UnsupportedStore => formatter.write_str(\"unsupported sqlite journal format\"),\n            Self::CorruptStore => formatter.write_str(\"corrupt sqlite journal record\"),\n            Self::CredentialIndexPoisoned => {\n                formatter.write_str(\"data credential index is poisoned\")\n            }\n            Self::InjectedCrash(point) => write!(formatter, \"injected crash at {point:?}\"),\n            Self::ControllerRejected(reason) => {\n                write!(formatter, \"controller rejected: {reason:?}\")\n            }\n            Self::ControllerBusy => formatter.write_str(\"another controller owns this database\"),\n            Self::UnsupportedInput => {\n                formatter.write_str(\"input is not supported at this service boundary\")\n            }\n            Self::OperationFailed => {\n                formatter.write_str(\"accepted operation failed and was compensated\")\n            }\n            Self::UnresolvedAction => {\n                formatter.write_str(\"an earlier worker action must be reconciled first\")\n            }\n            Self::InvalidHostEvidence => {\n                formatter.write_str(\"host evidence does not establish this command result\")\n            }\n            Self::ObsoleteReceipt => {\n                formatter.write_str(\"terminal operation no longer accepts this activation receipt\")\n            }\n        }\n    }\n}\n\nimpl Error for JournalError {\n    fn source(&self) -> Option<&(dyn Error + 'static)> {\n        match self {\n            Self::Io(error) => Some(error),\n            #[cfg(feature = \"durable\")]\n            Self::Sqlite(error) | Self::CommitUncertain(error) => Some(error),\n            Self::Json(error) => Some(error),\n            Self::Contract(error) => Some(error),\n            _ => None,\n        }\n    }\n}\n\nimpl From<std::io::Error> for JournalError {\n    fn from(error: std::io::Error) -> Self {\n        Self::Io(error)\n    }\n}\n\n#[cfg(feature = \"durable\")]\nimpl From<SqliteError> for JournalError {\n    fn from(error: SqliteError) -> Self {\n        Self::Sqlite(error)\n    }\n}\n\nimpl From<serde_json::Error> for JournalError {\n    fn from(error: serde_json::Error) -> Self {\n        Self::Json(error)\n    }\n}\n\nimpl From<ContractError> for JournalError {\n    fn from(error: ContractError) -> Self {\n        Self::Contract(error)\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"controller-service/src/journal/statement_core.rs"},"crate_name":"sandproof_controller_service","contents":"use super::{AcceptedWrite, JournalError, as_sql_integer};\nuse rusqlite::Transaction;\n\npub(super) fn next_revision(expected_revision: Option<u64>) -> Result<(u64, i64), JournalError> {\n    let next_revision = match expected_revision {\n        Some(revision) => revision\n            .checked_add(1)\n            .ok_or(JournalError::RevisionConflict)?,\n        None => 1,\n    };\n    let next_revision_sql = as_sql_integer(next_revision)?;\n    Ok((next_revision, next_revision_sql))\n}\n\npub(super) fn update_existing<C>(\n    transaction: &Transaction<'_>,\n    write: &AcceptedWrite<C>,\n    next_revision_sql: i64,\n    expected: u64,\n) -> Result<(), JournalError> {\n    let changed = transaction.execute(\n        \"UPDATE sandboxes SET revision=?1, state_blob=?2\n             WHERE sandbox_id=?3 AND owner_id=?4 AND revision=?5\",\n        (\n            next_revision_sql,\n            &write.sandbox_state,\n            write.sandbox.as_str(),\n            write.owner.as_str(),\n            as_sql_integer(expected)?,\n        ),\n    )?;\n    if changed != 1 {\n        return Err(JournalError::RevisionConflict);\n    }\n    Ok(())\n}\n"},{"id":6,"name":{"Local":"controller-service/src/journal.rs"},"crate_name":"sandproof_controller_service","contents":"use crate::{CrashInjector, CrashPoint, JournalError};\nuse rusqlite::{Connection, OptionalExtension, TransactionBehavior, params};\nuse sandproof_protocol::{\n    ActionIdentity, OperationId, ResourceEvidence, SandboxId, TenantId, WorkAction, WorkReceipt,\n};\nuse serde::Serialize;\nuse serde::de::DeserializeOwned;\nuse std::path::Path;\nuse std::time::Duration;\n\nmod statement_core;\n\nconst APPLICATION_ID: i64 = 0x5350_4631; // SPF1\nconst FORMAT_VERSION: i64 = 1;\npub(crate) const MAINTAINED_FORMAT_VERSION: i64 = 5;\ntype ExistingReceiptRow = (i64, String, Vec<u8>, Option<Vec<u8>>);\n\n/// Bytes are a projection supplied by the controller reducer's adapter.\n/// This journal never interprets or independently changes business state.\npub struct AcceptedWrite<C> {\n    pub owner: TenantId,\n    pub sandbox: SandboxId,\n    pub operation: OperationId,\n    pub expected_revision: Option<u64>,\n    pub sandbox_state: Vec<u8>,\n    pub operation_state: Vec<u8>,\n    pub actions: Vec<WorkAction<C>>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct StoredSandbox {\n    pub owner: TenantId,\n    pub revision: u64,\n    pub state: Vec<u8>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct StoredOperation {\n    pub owner: TenantId,\n    pub sandbox: SandboxId,\n    pub state: Vec<u8>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct RecordedReceipt<C, E> {\n    pub action: WorkAction<C>,\n    pub receipt: WorkReceipt<E>,\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct StorageSettings {\n    pub sqlite_version: String,\n    pub journal_mode: String,\n    pub synchronous: i64,\n    pub foreign_keys: bool,\n    pub trusted_schema: bool,\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DispatchState {\n    Ready,\n    Dispatched,\n    Receipted,\n}\n\nimpl DispatchState {\n    fn from_db(value: &str) -> Result<Self, JournalError> {\n        match value {\n            \"ready\" => Ok(Self::Ready),\n            \"dispatched\" => Ok(Self::Dispatched),\n            \"receipted\" => Ok(Self::Receipted),\n            _ => Err(JournalError::CorruptStore),\n        }\n    }\n}\n\npub struct Journal {\n    pub(crate) connection: Connection,\n}\n\nfn as_sql_integer(value: u64) -> Result<i64, JournalError> {\n    i64::try_from(value).map_err(|_| JournalError::Conflict)\n}\n\nfn from_sql_integer(value: i64) -> Result<u64, JournalError> {\n    u64::try_from(value).map_err(|_| JournalError::CorruptStore)\n}\n\nfn tenant_from_db(value: String) -> Result<TenantId, JournalError> {\n    TenantId::try_from(value).map_err(JournalError::from)\n}\n\nfn sandbox_from_db(value: String) -> Result<SandboxId, JournalError> {\n    SandboxId::try_from(value).map_err(JournalError::from)\n}\n\nfn constraint_as_conflict(error: rusqlite::Error) -> JournalError {\n    match &error {\n        rusqlite::Error::SqliteFailure(code, _)\n            if code.code == rusqlite::ErrorCode::ConstraintViolation =>\n        {\n            JournalError::Conflict\n        }\n        _ => JournalError::Sqlite(error),\n    }\n}\n\npub(crate) fn write_accepted<C: Serialize>(\n    transaction: &rusqlite::Transaction<'_>,\n    write: &AcceptedWrite<C>,\n) -> Result<u64, JournalError> {\n    write_accepted_with_ids(transaction, write, None)\n}\n\n/// Controller-owned journals supply transactionally reserved outbox IDs.\n/// The generic journal retains its existing opaque-store allocation contract.\npub(crate) fn write_accepted_with_ids<C: Serialize>(\n    transaction: &rusqlite::Transaction<'_>,\n    write: &AcceptedWrite<C>,\n    outbox_ids: Option<&[i64]>,\n) -> Result<u64, JournalError> {\n    if outbox_ids.is_some_and(|ids| ids.len() != write.actions.len()) {\n        return Err(JournalError::CorruptStore);\n    }\n    for action in &write.actions {\n        action.identity.validate_version()?;\n        if action.identity.owner != write.owner\n            || action.identity.sandbox != write.sandbox\n            || action.identity.operation != write.operation\n        {\n            return Err(JournalError::Conflict);\n        }\n        as_sql_integer(action.identity.attempt)?;\n    }\n\n    let (next_revision, next_revision_sql) = statement_core::next_revision(write.expected_revision)?;\n    if let Some(expected) = write.expected_revision {\n        statement_core::update_existing(transaction, write, next_revision_sql, expected)?;\n    } else {\n        transaction\n            .execute(\n                \"INSERT INTO sandboxes (sandbox_id, owner_id, revision, state_blob)\n                 VALUES (?1, ?2, ?3, ?4)\",\n                params![\n                    write.sandbox.as_str(),\n                    write.owner.as_str(),\n                    next_revision_sql,\n                    &write.sandbox_state\n                ],\n            )\n            .map_err(constraint_as_conflict)?;\n    }\n\n    let changed = transaction.execute(\n        \"INSERT INTO operations (operation_id, sandbox_id, owner_id, state_blob)\n         VALUES (?1, ?2, ?3, ?4)\n         ON CONFLICT(operation_id) DO UPDATE SET state_blob=excluded.state_blob\n         WHERE operations.sandbox_id=excluded.sandbox_id\n           AND operations.owner_id=excluded.owner_id\",\n        params![\n            write.operation.as_str(),\n            write.sandbox.as_str(),\n            write.owner.as_str(),\n            &write.operation_state\n        ],\n    )?;\n    if changed != 1 {\n        return Err(JournalError::Conflict);\n    }\n\n    for (index, action) in write.actions.iter().enumerate() {\n        transaction\n            .execute(\n                \"INSERT INTO outbox\n                 (id, sandbox_id, owner_id, operation_id, logical_action_id, attempt,\n                  action_json, dispatch_state)\n                 VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, 'ready')\",\n                params![\n                    outbox_ids.map(|ids| ids[index]),\n                    write.sandbox.as_str(),\n                    write.owner.as_str(),\n                    write.operation.as_str(),\n                    action.identity.logical_action.as_str(),\n                    as_sql_integer(action.identity.attempt)?,\n                    serde_json::to_vec(action)?\n                ],\n            )\n            .map_err(constraint_as_conflict)?;\n    }\n    Ok(next_revision)\n}\n\n// A handle opened before ControllerJournal took ownership must also be\n// rejected. Check inside each write transaction, not only at open time.\nfn require_generic_store(connection: &Connection) -> Result<(), JournalError> {\n    let format: i64 = connection.query_row(\"PRAGMA user_version\", [], |row| row.get(0))?;\n    if !matches!(format, 0 | FORMAT_VERSION) {\n        return Err(JournalError::UnsupportedStore);\n    }\n    let controller: bool = connection.query_row(\n        \"SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='controller_meta')\",\n        [],\n        |row| row.get(0),\n    )?;\n    if controller {\n        return Err(JournalError::UnsupportedStore);\n    }\n    Ok(())\n}\n\n/// Inspect only: the formal service never imports an older controller schema.\n/// This also runs under the writer lease and again in the open transaction.\npub(crate) fn require_current_controller_store(\n    connection: &Connection,\n) -> Result<(), JournalError> {\n    let app: i64 = connection.query_row(\"PRAGMA application_id\", [], |row| row.get(0))?;\n    let format: i64 = connection.query_row(\"PRAGMA user_version\", [], |row| row.get(0))?;\n    if app != APPLICATION_ID || format != MAINTAINED_FORMAT_VERSION {\n        return Err(JournalError::UnsupportedStore);\n    }\n    let version: i64 = connection.query_row(\n        \"SELECT version FROM controller_meta WHERE id=1\",\n        [],\n        |row| row.get(0),\n    )?;\n    // 7 is the current base lifecycle schema. 8..11 and 13 are durable feature\n    // gates (network/template/private-window/inbox evidence), not older deployments.\n    // Their existing recovery validation still checks every enabled feature.\n    if !(7..=11).contains(&version) && version != crate::INTERNAL_INBOX_FORMAT_VERSION {\n        return Err(JournalError::UnsupportedStore);\n    }\n    let maintenance: Vec<u8> = connection.query_row(\n        \"SELECT config_json FROM controller_maintenance_config WHERE id=1\",\n        [],\n        |row| row.get(0),\n    )?;\n    let maintenance: crate::MaintenanceConfig = serde_json::from_slice(&maintenance)?;\n    let host: Vec<u8> = connection.query_row(\n        \"SELECT config_json FROM controller_bounded_config WHERE id=1\",\n        [],\n        |row| row.get(0),\n    )?;\n    let host: crate::BoundedHostConfig = serde_json::from_slice(&host)?;\n    if maintenance.capacity.is_none()\n        || host.physical_storage.is_none()\n        || host.console_policy != Some(crate::ConsolePolicy::Discard)\n    {\n        return Err(JournalError::UnsupportedStore);\n    }\n    Ok(())\n}\n\nimpl Journal {\n    /// Opens one local `SQLite` database. WAL + FULL + IMMEDIATE transactions\n    /// are part of this format's operating contract, not caller preferences.\n    ///\n    /// # Errors\n    /// Rejects unsupported/corrupt stores, unsuitable journal settings, and I/O errors.\n    pub fn open(path: impl AsRef<Path>) -> Result<Self, JournalError> {\n        Self::open_inner(path, false)\n    }\n\n    pub(crate) fn open_controller(path: impl AsRef<Path>) -> Result<Self, JournalError> {\n        Self::open_inner(path, true)\n    }\n\n    fn open_inner(path: impl AsRef<Path>, controller: bool) -> Result<Self, JournalError> {\n        let connection = Connection::open(path)?;\n        if !controller {\n            require_generic_store(&connection)?;\n        }\n        connection.busy_timeout(Duration::from_secs(5))?;\n        connection.execute_batch(\"PRAGMA trusted_schema=OFF; PRAGMA foreign_keys=ON;\")?;\n\n        let app_id: i64 = connection.query_row(\"PRAGMA application_id\", [], |row| row.get(0))?;\n        let format: i64 = connection.query_row(\"PRAGMA user_version\", [], |row| row.get(0))?;\n        if controller && (app_id != 0 || format != 0) {\n            require_current_controller_store(&connection)?;\n        }\n        if app_id == 0 && format == 0 {\n            let user_objects: i64 = connection.query_row(\n                \"SELECT count(*) FROM sqlite_master WHERE name NOT LIKE 'sqlite_%'\",\n                [],\n                |row| row.get(0),\n            )?;\n            if user_objects != 0 {\n                return Err(JournalError::UnsupportedStore);\n            }\n            if !controller {\n                connection.execute_batch(\n                    \"BEGIN IMMEDIATE;\n                 CREATE TABLE sandboxes (\n                   sandbox_id TEXT PRIMARY KEY,\n                   owner_id TEXT NOT NULL,\n                   revision INTEGER NOT NULL CHECK(revision >= 1),\n                   state_blob BLOB NOT NULL,\n                   UNIQUE(sandbox_id, owner_id)\n                 );\n                 CREATE TABLE operations (\n                   operation_id TEXT PRIMARY KEY,\n                   sandbox_id TEXT NOT NULL,\n                   owner_id TEXT NOT NULL,\n                   state_blob BLOB NOT NULL,\n                   UNIQUE(sandbox_id, owner_id, operation_id),\n                   FOREIGN KEY(sandbox_id, owner_id)\n                     REFERENCES sandboxes(sandbox_id, owner_id)\n                 );\n                 CREATE TABLE outbox (\n                   id INTEGER PRIMARY KEY,\n                   sandbox_id TEXT NOT NULL,\n                   owner_id TEXT NOT NULL,\n                   operation_id TEXT NOT NULL,\n                   logical_action_id TEXT NOT NULL,\n                   attempt INTEGER NOT NULL CHECK(attempt >= 0),\n                   action_json BLOB NOT NULL,\n                   dispatch_state TEXT NOT NULL\n                     CHECK(dispatch_state IN ('ready', 'dispatched', 'receipted')),\n                   receipt_json BLOB,\n                   UNIQUE(sandbox_id, logical_action_id, attempt),\n                   CHECK((dispatch_state = 'receipted') = (receipt_json IS NOT NULL)),\n                   FOREIGN KEY(sandbox_id, owner_id, operation_id)\n                     REFERENCES operations(sandbox_id, owner_id, operation_id)\n                 );\n                 PRAGMA application_id=0x53504631;\n                 PRAGMA user_version=1;\n                 COMMIT;\",\n                )?;\n            }\n        } else if app_id != APPLICATION_ID\n            || (format != FORMAT_VERSION && !(controller && format == MAINTAINED_FORMAT_VERSION))\n        {\n            return Err(JournalError::UnsupportedStore);\n        }\n\n        let mode: String = connection.query_row(\"PRAGMA journal_mode=WAL\", [], |row| row.get(0))?;\n        if mode != \"wal\" {\n            return Err(JournalError::UnsupportedStore);\n        }\n        connection.execute_batch(\"PRAGMA synchronous=FULL;\")?;\n        let synchronous: i64 = connection.query_row(\"PRAGMA synchronous\", [], |row| row.get(0))?;\n        let foreign_keys: i64 =\n            connection.query_row(\"PRAGMA foreign_keys\", [], |row| row.get(0))?;\n        let trusted_schema: i64 =\n            connection.query_row(\"PRAGMA trusted_schema\", [], |row| row.get(0))?;\n        if synchronous != 2 || foreign_keys != 1 || trusted_schema != 0 {\n            return Err(JournalError::UnsupportedStore);\n        }\n        Ok(Self { connection })\n    }\n\n    /// Returns the effective settings of this connection for evidence logs.\n    ///\n    /// # Errors\n    /// Returns a storage error if the settings cannot be read.\n    pub fn storage_settings(&self) -> Result<StorageSettings, JournalError> {\n        let journal_mode: String = self\n            .connection\n            .query_row(\"PRAGMA journal_mode\", [], |row| row.get(0))?;\n        let synchronous: i64 = self\n            .connection\n            .query_row(\"PRAGMA synchronous\", [], |row| row.get(0))?;\n        let foreign_keys: i64 = self\n            .connection\n            .query_row(\"PRAGMA foreign_keys\", [], |row| row.get(0))?;\n        let trusted_schema: i64 =\n            self.connection\n                .query_row(\"PRAGMA trusted_schema\", [], |row| row.get(0))?;\n        Ok(StorageSettings {\n            sqlite_version: rusqlite::version().to_owned(),\n            journal_mode,\n            synchronous,\n            foreign_keys: foreign_keys == 1,\n            trusted_schema: trusted_schema == 1,\n        })\n    }\n\n    /// Atomically stores one accepted reducer decision and all newly emitted\n    /// actions. No worker callback is possible before this commit returns.\n    ///\n    /// # Errors\n    /// Returns a revision/identity conflict, a storage error, or an injected crash.\n    pub fn commit<C: Serialize>(\n        &mut self,\n        write: &AcceptedWrite<C>,\n        crashes: &mut impl CrashInjector,\n    ) -> Result<u64, JournalError> {\n        let transaction = self\n            .connection\n            .transaction_with_behavior(TransactionBehavior::Immediate)?;\n        require_generic_store(&transaction)?;\n        let next_revision = write_accepted(&transaction, write)?;\n        crashes.hit(CrashPoint::BeforeCommit)?;\n        transaction\n            .commit()\n            .map_err(JournalError::CommitUncertain)?;\n        crashes.hit(CrashPoint::AfterCommit)?;\n        Ok(next_revision)\n    }\n\n    /// # Errors\n    /// Returns a storage or record-decoding error.\n    pub fn sandbox(&self, sandbox: &SandboxId) -> Result<Option<StoredSandbox>, JournalError> {\n        let row: Option<(String, i64, Vec<u8>)> = self\n            .connection\n            .query_row(\n                \"SELECT owner_id, revision, state_blob FROM sandboxes WHERE sandbox_id=?1\",\n                [sandbox.as_str()],\n                |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),\n            )\n            .optional()?;\n        row.map(|(owner, revision, state)| {\n            Ok(StoredSandbox {\n                owner: tenant_from_db(owner)?,\n                revision: from_sql_integer(revision)?,\n                state,\n            })\n        })\n        .transpose()\n    }\n\n    /// # Errors\n    /// Returns a storage or record-decoding error.\n    pub fn operation(\n        &self,\n        operation: &OperationId,\n    ) -> Result<Option<StoredOperation>, JournalError> {\n        let row: Option<(String, String, Vec<u8>)> = self\n            .connection\n            .query_row(\n                \"SELECT owner_id, sandbox_id, state_blob FROM operations WHERE operation_id=?1\",\n                [operation.as_str()],\n                |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),\n            )\n            .optional()?;\n        row.map(|(owner, sandbox, state)| {\n            Ok(StoredOperation {\n                owner: tenant_from_db(owner)?,\n                sandbox: sandbox_from_db(sandbox)?,\n                state,\n            })\n        })\n        .transpose()\n    }\n\n    /// # Errors\n    /// Returns a storage or record-decoding error.\n    pub fn dispatch_state(\n        &self,\n        identity: &ActionIdentity,\n    ) -> Result<Option<DispatchState>, JournalError> {\n        let row: Option<(String, Vec<u8>)> = self\n            .connection\n            .query_row(\n                \"SELECT dispatch_state, action_json FROM outbox\n                 WHERE sandbox_id=?1 AND logical_action_id=?2 AND attempt=?3\",\n                params![\n                    identity.sandbox.as_str(),\n                    identity.logical_action.as_str(),\n                    as_sql_integer(identity.attempt)?\n                ],\n                |row| Ok((row.get(0)?, row.get(1)?)),\n            )\n            .optional()?;\n        row.map(|(state, action_json)| {\n            let action: WorkAction<serde_json::Value> = serde_json::from_slice(&action_json)?;\n            if action.identity != *identity {\n                return Err(JournalError::Conflict);\n            }\n            DispatchState::from_db(&state)\n        })\n        .transpose()\n    }\n\n    /// Dispatched-but-unreceipted actions are ambiguous after restart. They\n    /// are returned for host reconciliation and are never blindly re-sent.\n    ///\n    /// # Errors\n    /// Returns a storage or record-decoding error.\n    pub fn uncertain_actions<C: DeserializeOwned>(\n        &self,\n    ) -> Result<Vec<WorkAction<C>>, JournalError> {\n        let mut statement = self.connection.prepare(\n            \"SELECT action_json FROM outbox WHERE dispatch_state='dispatched' ORDER BY id\",\n        )?;\n        let rows = statement.query_map([], |row| row.get::<_, Vec<u8>>(0))?;\n        let mut actions = Vec::new();\n        for row in rows {\n            let action: WorkAction<C> = serde_json::from_slice(&row?)?;\n            action.identity.validate_version()?;\n            actions.push(action);\n        }\n        Ok(actions)\n    }\n\n    /// Returns receipts durably captured after dispatch. A future reducer\n    /// adapter must apply them idempotently; merely reading a receipt does not\n    /// publish a stable sandbox state.\n    ///\n    /// # Errors\n    /// Returns a storage, decoding, or identity mismatch error.\n    pub fn recorded_receipts<C, E>(&self) -> Result<Vec<RecordedReceipt<C, E>>, JournalError>\n    where\n        C: DeserializeOwned,\n        E: ResourceEvidence + DeserializeOwned,\n    {\n        let mut statement = self.connection.prepare(\n            \"SELECT action_json, receipt_json FROM outbox\n             WHERE dispatch_state='receipted' ORDER BY id\",\n        )?;\n        let rows = statement.query_map([], |row| {\n            Ok((row.get::<_, Vec<u8>>(0)?, row.get::<_, Vec<u8>>(1)?))\n        })?;\n        let mut receipts = Vec::new();\n        for row in rows {\n            let (action_json, receipt_json) = row?;\n            let action: WorkAction<C> = serde_json::from_slice(&action_json)?;\n            let receipt: WorkReceipt<E> = serde_json::from_slice(&receipt_json)?;\n            receipt.validate_for(&action)?;\n            receipts.push(RecordedReceipt { action, receipt });\n        }\n        Ok(receipts)\n    }\n\n    pub(crate) fn claim_next<C: DeserializeOwned>(\n        &mut self,\n        crashes: &mut impl CrashInjector,\n    ) -> Result<Option<WorkAction<C>>, JournalError> {\n        let transaction = self\n            .connection\n            .transaction_with_behavior(TransactionBehavior::Immediate)?;\n        require_generic_store(&transaction)?;\n        let row: Option<(i64, Vec<u8>)> = transaction\n            .query_row(\n                \"SELECT id, action_json FROM outbox\n                 WHERE dispatch_state='ready' ORDER BY id LIMIT 1\",\n                [],\n                |row| Ok((row.get(0)?, row.get(1)?)),\n            )\n            .optional()?;\n        let Some((id, action_json)) = row else {\n            return Ok(None);\n        };\n        let action: WorkAction<C> = serde_json::from_slice(&action_json)?;\n        action.identity.validate_version()?;\n        crashes.hit(CrashPoint::BeforeDispatchClaim)?;\n        transaction.execute(\n            \"UPDATE outbox SET dispatch_state='dispatched' WHERE id=?1 AND dispatch_state='ready'\",\n            [id],\n        )?;\n        transaction\n            .commit()\n            .map_err(JournalError::CommitUncertain)?;\n        crashes.hit(CrashPoint::AfterDispatchClaim)?;\n        Ok(Some(action))\n    }\n\n    /// Stores a late or duplicate receipt only for the exact claimed attempt.\n    /// The controller reducer must separately decide whether it can advance.\n    ///\n    /// # Errors\n    /// Rejects mismatched, premature, or conflicting receipts.\n    pub fn record_receipt<E>(&mut self, receipt: &WorkReceipt<E>) -> Result<bool, JournalError>\n    where\n        E: ResourceEvidence + Serialize + DeserializeOwned + PartialEq,\n    {\n        receipt.identity.validate_version()?;\n        let transaction = self\n            .connection\n            .transaction_with_behavior(TransactionBehavior::Immediate)?;\n        require_generic_store(&transaction)?;\n        let row: Option<ExistingReceiptRow> = transaction\n            .query_row(\n                \"SELECT id, dispatch_state, action_json, receipt_json FROM outbox\n                 WHERE sandbox_id=?1 AND logical_action_id=?2 AND attempt=?3\",\n                params![\n                    receipt.identity.sandbox.as_str(),\n                    receipt.identity.logical_action.as_str(),\n                    as_sql_integer(receipt.identity.attempt)?\n                ],\n                |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),\n            )\n            .optional()?;\n        let Some((id, state, action_json, old_receipt)) = row else {\n            return Err(JournalError::Conflict);\n        };\n        let action: WorkAction<serde_json::Value> = serde_json::from_slice(&action_json)?;\n        receipt.validate_for(&action)?;\n        match DispatchState::from_db(&state)? {\n            DispatchState::Ready => Err(JournalError::ReceiptBeforeDispatch),\n            DispatchState::Dispatched => {\n                transaction.execute(\n                    \"UPDATE outbox SET dispatch_state='receipted', receipt_json=?1 WHERE id=?2\",\n                    params![serde_json::to_vec(receipt)?, id],\n                )?;\n                transaction\n                    .commit()\n                    .map_err(JournalError::CommitUncertain)?;\n                Ok(true)\n            }\n            DispatchState::Receipted => {\n                let old: WorkReceipt<E> =\n                    serde_json::from_slice(&old_receipt.ok_or(JournalError::CorruptStore)?)?;\n                if old == *receipt {\n                    Ok(false)\n                } else {\n                    Err(JournalError::ConflictingReceipt)\n                }\n            }\n        }\n    }\n}\n"},{"id":7,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Lo