ints":[]},"skip_binder":{"name":"get_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["get_mut",0]},{"Target":"x86_64-unknown-linux-gnu"}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":137,"col":4},"end":{"line":137,"col":65}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a mutable reference to the output at this location, if in"},{"DocComment":" bounds."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10},{"Value":[164,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":11},"Mut"]}]}],"output":{"Value":[165,{"Adt":{"id":2,"generics":{"regions":[],"types":[{"Value":[166,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":51},"Mut"]}]}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":null},"kind":{"TraitMethod":[2,1]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"get_unchecked","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["get_unchecked",0]},{"Target":"x86_64-unknown-linux-gnu"}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":149,"col":4},"end":{"line":149,"col":74}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a pointer to the output at this location, without"},{"DocComment":" performing any bounds checking."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Calling this method with an out-of-bounds index or a dangling `slice` pointer"},{"DocComment":" is *[undefined behavior]* even if the resulting pointer is not used."},{"DocComment":""},{"DocComment":" [undefined behav