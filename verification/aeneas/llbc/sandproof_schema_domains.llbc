{"charon_version":"0.1.254","translated":{"crate_name":"sandproof_internal","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::status::_::validate","crate::status::_::validate_for"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["sandproof_internal","sandproof_protocol"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"verification/aeneas/llbc/sandproof_schema_domains.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":true,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"sandbox-internal/src/lib.rs"},"crate_name":"sandproof_internal","contents":"#![forbid(unsafe_code)]\n\n//! Bounded, mutually authenticated center/host transport.\n//! Shared authenticated transport for identity probes and high-level lifecycle\n//! intents. The center is the sole public product entrance.\n//! TLS material, registered endpoint and peer pins come from trusted assembly,\n//! never from a user/template or an HTTP header. Entrypoints explicitly choose\n//! paths/owners/bounds; a shared protected-file primitive avoids two loaders.\n\nmod artifact_client;\npub mod cache;\nmod client;\npub mod diagnostic;\n#[cfg(unix)]\nmod protected_files;\nmod protected_server;\nmod server;\npub mod status;\npub mod template;\nmod tls;\n\npub use artifact_client::ArtifactClient;\npub use cache::CacheReceiver;\npub use client::{InternalClient, RegisteredEndpoint};\n#[cfg(unix)]\npub use protected_files::{ProtectedFileError, check_protected_directory, read_protected};\npub use protected_server::{ProtectedHttp, ProtectedServer};\npub use server::{DataReceiver, InternalServer, LifecycleReceiver, ReceiveError, RejectLifecycle};\npub use template::ValidationReceiver;\npub use tls::{CertificatePin, ClientTls, ServerTls, TlsIdentity};\n\nuse std::{error::Error, fmt, time::Duration};\n\n// Both HTTP parsers use the same explicit budget; body limits are separate.\npub(crate) const HTTP_MAX_HEADERS: usize = 16;\npub(crate) const HTTP_HEADER_BUFFER_BYTES: usize = 8192;\n\n/// Explicit deployment budgets; no semaphore wait queue is created.\n#[derive(Clone, Copy, Debug)]\npub struct Limits {\n    pub(crate) max_connections: usize,\n    pub(crate) handshake_timeout: Duration,\n    pub(crate) request_timeout: Duration,\n}\n\nimpl Limits {\n    #[must_use]\n    pub const fn max_connections(&self) -> usize {\n        self.max_connections\n    }\n    /// # Errors\n    /// Rejects zero/oversized budgets and handshake deadlines beyond the call.\n    pub fn new(\n        max_connections: usize,\n        handshake_timeout: Duration,\n        request_timeout: Duration,\n    ) -> Result<Self, TransportError> {\n        if !(1..=8192).contains(&max_connections)\n            || handshake_timeout.is_zero()\n            || handshake_timeout > request_timeout\n            || request_timeout > Duration::from_hours(24)\n        {\n            return Err(TransportError::Configuration);\n        }\n        Ok(Self {\n            max_connections,\n            handshake_timeout,\n            request_timeout,\n        })\n    }\n}\n\n/// A communication failure is never definitive lifecycle failure/no effects.\n/// Callers of future effectful endpoints must retain the original operation.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum TransportError {\n    Configuration,\n    Overloaded,\n    Deadline,\n    Authentication,\n    Communication,\n    InvalidResponse,\n    Rejected,\n}\n\nimpl fmt::Display for TransportError {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        f.write_str(match self {\n            Self::Configuration => \"invalid internal transport configuration\",\n            Self::Overloaded => \"internal transport capacity exhausted\",\n            Self::Deadline => \"internal call deadline exceeded\",\n            Self::Authentication => \"internal peer authentication failed\",\n            Self::Communication => \"internal communication unavailable\",\n            Self::InvalidResponse => \"invalid internal response\",\n            Self::Rejected => \"internal request rejected\",\n        })\n    }\n}\n\nimpl Error for TransportError {}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"sandbox-internal/src/status.rs"},"crate_name":"sandproof_internal","contents":"//! Authenticated physical/time veto, not lifecycle success or quota release.\nuse crate::{ReceiveError, TransportError};\nuse sandproof_protocol::internal::{NodeIdentity, lifecycle::Resources};\nuse serde::{Deserialize, Serialize};\n\npub const STATUS_PATH: &str = \"/internal/v2/node-status\";\npub const STATUS_REQUEST_BYTES: usize = 1024;\npub const STATUS_RESPONSE_BYTES: usize = 2048;\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct StatusRequest {\n    pub node: NodeIdentity,\n}\nimpl StatusRequest {\n    /// # Errors\n    /// The authenticated endpoint cannot query a different node or generation.\n    pub fn validate(&self, node: &NodeIdentity) -> Result<(), TransportError> {\n        if self.node != *node {\n            return Err(TransportError::Rejected);\n        }\n        Ok(())\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(deny_unknown_fields)]\npub struct HostStatus {\n    pub node: NodeIdentity,\n    /// Protected inbox capacity, not inferred from native IDs or physical slots.\n    pub retention_slots: u16,\n    pub observed_at_ms: u64,\n    /// Conservative physical/local free capacity. It can only veto admission;\n    /// center reservations are still counted separately by the pure core.\n    pub free: Resources,\n}\nimpl HostStatus {\n    /// # Errors\n    /// Responses for a different node or generation cannot refresh registration.\n    pub fn validate_for(&self, request: &StatusRequest) -> Result<(), TransportError> {\n        if self.node != request.node || self.retention_slots == 0 || self.retention_slots > 4096 {\n            return Err(TransportError::InvalidResponse);\n        }\n        Ok(())\n    }\n}\n\npub trait StatusReceiver: Send + Sync + 'static {\n    fn status(\n        &self,\n        request: StatusRequest,\n    ) -> impl std::future::Future<Output = Result<HostStatus, ReceiveError>> + Send;\n}\n"},{"id":6,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"sandbox-protocol/src/internal.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":11,"name":{"Local":"sandbox-protocol/src/lib.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"sandbox-protocol/src/internal/lifecycle.rs"},"crate_name":"sandproof_protocol","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/alloc/src/string.rs"},"crate_name":"alloc","contents":null},{"id":18,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"I