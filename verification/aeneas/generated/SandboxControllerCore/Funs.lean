def publication.stop_receipt_candidate
  (world : model.World) (sandbox : ids.SandboxId) (generation : Std.U64)
  (vm : ids.VmId) (candidate : model.EffectId) :
  Result Bool
  := do
  let c ← model.EffectId.command candidate
  match c with
  | model.Command.InstallFence _ _ _ => ok false
  | model.Command.PrepareVm _ _ _ _ _ _ => ok false
  | model.Command.ConfigureNetwork _ _ _ _ _ _ => ok false
  | model.Command.ActivateVm _ _ _ _ => ok false
  | model.Command.FreezeVm _ _ _ _ => ok false
  | model.Command.ApplyFilePolicy _ _ _ _ _ => ok false
  | model.Command.SealSnapshot _ _ _ _ _ _ _ => ok false
  | model.Command.CommitSnapshot _ _ _ _ _ => ok false
  | model.Command.StopVm command_sandbox _ command_generation command_vm =>
    let b ←
      ids.SandboxId.Insts.CoreCmpPartialEqSandboxId.eq command_sandbox sandbox
    if b
    then
      if command_generation = generation
      then
        let b1 ← ids.VmId.Insts.CoreCmpPartialEqVmId.eq command_vm vm
        if b1
        then effect.effect_succeeded_check world c
        else ok false
      else ok false
    else ok false
  | model.Command.CleanupVm _ _ _ => ok false
  | model.Command.CleanupSlot _ _ _ => ok false

