      ok (some
        { operation with status := (model.OperationStatus.Failed failure) })
  let sr ←
    model.SandboxRecord.Insts.CoreCloneClone.clone
      {
        destroyed
          with
          phase := model.Phase.Destroyed,
          terminal := true,
          current_vm := none,
          net_slot := none,
          desired := model.Authority.Closed,
          effective := model.Authority.Closed,
          current_operation := o
      }
  let s ←
    store.Store.put ids.SandboxId.Insts.CoreCmpPartialEqSandboxId
      next.sandboxes sandbox sr
  match o with
  | none => ok { next with sandboxes := s }
  | some operation =>
    publication.update_operation_result { next with sandboxes := s } sandbox
      operation (model.OperationResult.Failed failure)

