    | core.result.Result.Err reject =>
      ok (core.result.Result.Err (controller.ControllerReject.Request reject))
  | controller.ControllerInput.Effect effect_input =>
    let r ← effect.handle_effect world effect_input
    match r with
    | core.result.Result.Ok decision =>
      let cd ← controller.effect_decision decision
      ok (core.result.Result.Ok cd)
    | core.result.Result.Err reject =>
      ok (core.result.Result.Err (controller.ControllerReject.Effect reject))
  | controller.ControllerInput.Scheduler input1 =>
    let r ← scheduler.handle_scheduler world input1
    match r with
    | core.result.Result.Ok decision =>
      let cd ← controller.protocol_decision decision
      ok (core.result.Result.Ok cd)
    | core.result.Result.Err reject =>
      ok (core.result.Result.Err (controller.ControllerReject.Scheduler
        reject))
  | controller.ControllerInput.Worker effect =>
    let r ← worker.handle_worker world effect
    match r with
    | core.result.Result.Ok decision =>
      let cd ← controller.worker_decision decision
      ok (core.result.Result.Ok cd)
    | core.result.Result.Err reject =>
      ok (core.result.Result.Err (controller.ControllerReject.Worker reject))
  | controller.ControllerInput.Publication input1 =>
    let r ← publication.handle_publication world input1
    match r with
    | core.result.Result.Ok decision =>
      let cd ← controller.publication_decision decision
      ok (core.result.Result.Ok cd)
    | core.result.Result.Err reject =>
      ok (core.result.Result.Err (controller.ControllerReject.Publication
        reject))
  | controller.ControllerInput.RpcTimeout sandbox =>
    let r ← auxiliary.handle_rpc_timeout world sandbox
    match r with
    | core.result.Result.Ok decision =>
      let cd ← controller.auxiliary_decision decision
      ok (core.result.Result.Ok cd)
    | core.result.Result.Err reject =>
      ok (core.result.Result.Err (controller.ControllerReject.Auxiliary
        reject))
  | controller.ControllerInput.Access input1 =>
    let r ← auxiliary.handle_access world input1
    match r with
    | core.result.Result.Ok decision =>
      let cd ← controller.auxiliary_decision decision
      ok (core.result.Result.Ok cd)
    | core.result.Result.Err reject =>
      ok (core.result.Result.Err (controller.ControllerReject.Auxiliary
        reject))
  | controller.ControllerInput.Runtime input1 =>
    let r ← recovery_monitor.handle_runtime world input1
    match r with
    | core.result.Result.Ok decision =>
      let cd ← controller.runtime_decision decision
      ok (core.result.Result.Ok cd)
    | core.result.Result.Err reject =>
      ok (core.result.Result.Err (controller.ControllerReject.Runtime reject))

