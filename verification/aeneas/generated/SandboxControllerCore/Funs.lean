  Result (core.result.Result request.Decision scheduler.SchedulerReject)
  := do
  match input with
  | scheduler.SchedulerInput.ReserveStartup key =>
    scheduler.handle_reserve_startup world key
  | scheduler.SchedulerInput.ReservePauseSnapshot key =>
    scheduler.handle_reserve_pause_snapshot world key
  | scheduler.SchedulerInput.DispatchPrepare sandbox vm slot =>
    scheduler.handle_dispatch_prepare world sandbox vm slot
  | scheduler.SchedulerInput.SealSnapshot sandbox snapshot manifest =>
    scheduler.handle_schedule_seal_snapshot world sandbox snapshot manifest
  | scheduler.SchedulerInput.CommitSnapshot sandbox snapshot =>
    scheduler.handle_schedule_commit_snapshot world sandbox snapshot
  | scheduler.SchedulerInput.StopVm sandbox generation vm =>
    scheduler.handle_schedule_stop_vm world sandbox generation vm
  | scheduler.SchedulerInput.CleanupVm sandbox generation vm =>
    scheduler.handle_schedule_cleanup_vm world sandbox generation vm
  | scheduler.SchedulerInput.CleanupSlot sandbox generation slot =>
    scheduler.handle_schedule_cleanup_slot world sandbox generation slot

