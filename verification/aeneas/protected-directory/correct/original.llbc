{"charon_version":"0.1.254","translated":{"crate_name":"sandproof_internal","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::protected_files::directory"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate::protected_files"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"../raw/original.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":true,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"sandbox-internal/src/lib.rs"},"crate_name":"sandproof_internal","contents":"#![forbid(unsafe_code)]\n\n//! Bounded, mutually authenticated center/host transport.\n//! Shared authenticated transport for identity probes and high-level lifecycle\n//! intents. The center is the sole public product entrance.\n//! TLS material, registered endpoint and peer pins come from trusted assembly,\n//! never from a user/template or an HTTP header. Entrypoints explicitly choose\n//! paths/owners/bounds; a shared protected-file primitive avoids two loaders.\n\nmod artifact_client;\npub mod cache;\nmod client;\npub mod diagnostic;\n#[cfg(unix)]\nmod protected_files;\nmod protected_server;\nmod server;\npub mod status;\npub mod template;\nmod tls;\n\npub use artifact_client::ArtifactClient;\npub use cache::CacheReceiver;\npub use client::{InternalClient, RegisteredEndpoint};\n#[cfg(unix)]\npub use protected_files::{ProtectedFileError, check_protected_directory, read_protected};\npub use protected_server::{ProtectedHttp, ProtectedServer};\npub use server::{DataReceiver, InternalServer, LifecycleReceiver, ReceiveError, RejectLifecycle};\npub use template::ValidationReceiver;\npub use tls::{CertificatePin, ClientTls, ServerTls, TlsIdentity};\n\nuse std::{error::Error, fmt, time::Duration};\n\n// Both HTTP parsers use the same explicit budget; body limits are separate.\npub(crate) const HTTP_MAX_HEADERS: usize = 16;\npub(crate) const HTTP_HEADER_BUFFER_BYTES: usize = 8192;\n\n/// Explicit deployment budgets; no semaphore wait queue is created.\n#[derive(Clone, Copy, Debug)]\npub struct Limits {\n    pub(crate) max_connections: usize,\n    pub(crate) handshake_timeout: Duration,\n    pub(crate) request_timeout: Duration,\n}\n\nimpl Limits {\n    #[must_use]\n    pub const fn max_connections(&self) -> usize {\n        self.max_connections\n    }\n    /// # Errors\n    /// Rejects zero/oversized budgets and handshake deadlines beyond the call.\n    pub fn new(\n        max_connections: usize,\n        handshake_timeout: Duration,\n        request_timeout: Duration,\n    ) -> Result<Self, TransportError> {\n        if !(1..=8192).contains(&max_connections)\n            || handshake_timeout.is_zero()\n            || handshake_timeout > request_timeout\n            || request_timeout > Duration::from_hours(24)\n        {\n            return Err(TransportError::Configuration);\n        }\n        Ok(Self {\n            max_connections,\n            handshake_timeout,\n            request_timeout,\n        })\n    }\n}\n\n/// A communication failure is never definitive lifecycle failure/no effects.\n/// Callers of future effectful endpoints must retain the original operation.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum TransportError {\n    Configuration,\n    Overloaded,\n    Deadline,\n    Authentication,\n    Communication,\n    InvalidResponse,\n    Rejected,\n}\n\nimpl fmt::Display for TransportError {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        f.write_str(match self {\n            Self::Configuration => \"invalid internal transport configuration\",\n            Self::Overloaded => \"internal transport capacity exhausted\",\n            Self::Deadline => \"internal call deadline exceeded\",\n            Self::Authentication => \"internal peer authentication failed\",\n            Self::Communication => \"internal communication unavailable\",\n            Self::InvalidResponse => \"invalid internal response\",\n            Self::Rejected => \"internal request rejected\",\n        })\n    }\n}\n\nimpl Error for TransportError {}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"sandbox-internal/src/protected_files.rs"},"crate_name":"sandproof_internal","contents":"//! Shared deployment-file primitive; no implicit config or credential lookup.\n//! Both entrypoints provide an absolute path, their protected owner and a bound.\n\nuse rustix::fs::{Mode, OFlags, open, openat};\nuse std::{\n    fs::{File, Metadata},\n    io::Read,\n    os::unix::fs::MetadataExt,\n    path::{Component, Path},\n};\n\nconst MAX_PROTECTED_FILE_BYTES: usize = 16 * 1024 * 1024;\n\n/// Fixed errors deliberately omit paths, key bytes and operating-system detail.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ProtectedFileError {\n    Invalid,\n    Unavailable,\n    Untrusted,\n    TooLarge,\n}\n\nimpl std::fmt::Display for ProtectedFileError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::Invalid => \"invalid protected file configuration\",\n            Self::Unavailable => \"protected file unavailable\",\n            Self::Untrusted => \"protected file ownership or permissions rejected\",\n            Self::TooLarge => \"protected file exceeds its byte budget\",\n        })\n    }\n}\nimpl std::error::Error for ProtectedFileError {}\n\nfn directory(metadata: &Metadata, owner: u32) -> Result<(), ProtectedFileError> {\n    let trusted_owner = metadata.uid() == 0 || metadata.uid() == owner;\n    // A root-owned sticky temporary ancestor cannot replace another owner's\n    // private child. The final directory/leaf must still be owner-only below.\n    let trusted_writes =\n        metadata.mode() & 0o022 == 0 || (metadata.uid() == 0 && metadata.mode() & 0o1000 != 0);\n    if !metadata.is_dir() || !trusted_owner || !trusted_writes {\n        return Err(ProtectedFileError::Untrusted);\n    }\n    Ok(())\n}\n\nfn open_checked(path: &Path, owner: u32, leaf_directory: bool) -> Result<File, ProtectedFileError> {\n    if !path.is_absolute() || path.as_os_str().len() > 4096 {\n        return Err(ProtectedFileError::Invalid);\n    }\n    let names: Vec<_> = path\n        .components()\n        .skip(1)\n        .map(|part| match part {\n            Component::Normal(name) => Ok(name),\n            _ => Err(ProtectedFileError::Invalid),\n        })\n        .collect::<Result<_, _>>()?;\n    if names.is_empty() || names.len() > 128 {\n        return Err(ProtectedFileError::Invalid);\n    }\n    // Directory handles are only traversed and inspected, never read. Linux\n    // O_PATH preserves search-only root-owned ancestors such as mode 0711;\n    // DIRECTORY and NOFOLLOW still reject symlinks before the metadata checks.\n    #[cfg(target_os = \"linux\")]\n    let directory_access = OFlags::PATH;\n    #[cfg(not(target_os = \"linux\"))]\n    let directory_access = OFlags::RDONLY;\n    let dir_flags = directory_access | OFlags::DIRECTORY | OFlags::NOFOLLOW | OFlags::CLOEXEC;\n    let mut current = File::from(\n        open(\"/\", dir_flags, Mode::empty()).map_err(|_| ProtectedFileError::Unavailable)?,\n    );\n    directory(\n        &current\n            .metadata()\n            .map_err(|_| ProtectedFileError::Unavailable)?,\n        owner,\n    )?;\n    for (index, name) in names.iter().enumerate() {\n        let last = index + 1 == names.len();\n        let flags = if !last || leaf_directory {\n            dir_flags\n        } else {\n            // A FIFO must not block before we can reject its file type.\n            OFlags::RDONLY | OFlags::NOFOLLOW | OFlags::CLOEXEC | OFlags::NONBLOCK\n        };\n        current = File::from(\n            openat(&current, *name, flags, Mode::empty())\n                .map_err(|_| ProtectedFileError::Unavailable)?,\n        );\n        let metadata = current\n            .metadata()\n            .map_err(|_| ProtectedFileError::Unavailable)?;\n        if !last || leaf_directory {\n            directory(&metadata, owner)?;\n        }\n        if last\n            && (metadata.uid() != owner\n                || metadata.mode() & 0o077 != 0\n                || (!leaf_directory && (!metadata.is_file() || metadata.nlink() != 1)))\n        {\n            return Err(ProtectedFileError::Untrusted);\n        }\n    }\n    Ok(current)\n}\n\n/// Check an existing private registration/coordination directory without\n/// following a symlink in any component or creating/replacing the directory.\n/// # Errors\n/// Rejects untrusted ownership, writeable ancestors, non-private final modes.\npub fn check_protected_directory(path: &Path, owner_uid: u32) -> Result<(), ProtectedFileError> {\n    open_checked(path, owner_uid, true).map(drop)\n}\n\n/// Read one bounded existing regular file through checked directory handles.\n/// This does not canonicalize an untrusted path or reopen the leaf after check.\n/// The explicit owner comes from the service account, not from the file itself.\n/// # Errors\n/// Rejects symlinks, extra hard links, other owners, permissive modes or oversize.\npub fn read_protected(\n    path: &Path,\n    owner_uid: u32,\n    max_bytes: usize,\n) -> Result<Vec<u8>, ProtectedFileError> {\n    if !(1..=MAX_PROTECTED_FILE_BYTES).contains(&max_bytes) {\n        return Err(ProtectedFileError::Invalid);\n    }\n    let file = open_checked(path, owner_uid, false)?;\n    if file\n        .metadata()\n        .map_err(|_| ProtectedFileError::Unavailable)?\n        .len()\n        > max_bytes as u64\n    {\n        return Err(ProtectedFileError::TooLarge);\n    }\n    let mut bytes = Vec::new();\n    file.take(max_bytes as u64 + 1)\n        .read_to_end(&mut bytes)\n        .map_err(|_| ProtectedFileError::Unavailable)?;\n    if bytes.len() > max_bytes {\n        return Err(ProtectedFileError::TooLarge);\n    }\n    Ok(bytes)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::{\n        fs,\n        os::unix::fs::{PermissionsExt, symlink},\n    };\n\n    fn fixture() -> (tempfile::TempDir, u32) {\n        // The test intentionally chooses a real path, not the production loader\n        // silently canonicalizing a user-selected alias or symlink.\n        let parent = std::env::temp_dir().canonicalize().unwrap();\n        let dir = tempfile::tempdir_in(parent).unwrap();\n        fs::set_permissions(dir.path(), fs::Permissions::from_mode(0o700)).unwrap();\n        let owner = fs::metadata(dir.path()).unwrap().uid();\n        (dir, owner)\n    }\n    fn secret(path: &Path) {\n        fs::write(path, b\"fixture-only\").unwrap();\n        fs::set_permissions(path, fs::Permissions::from_mode(0o600)).unwrap();\n    }\n\n    #[cfg(target_os = \"linux\")]\n    fn check_search_only_ancestor(path: &Path, owner: u32) {\n        // Root bypasses directory DAC and therefore cannot prove this case.\n        assert_ne!(\n            owner, 0,\n            \"permission probe must run without root privileges\"\n        );\n        assert_eq!(\n            fs::read_dir(path).unwrap_err().kind(),\n            std::io::ErrorKind::PermissionDenied\n        );\n        let child = path.join(\"private\");\n        assert_eq!(\n            read_protected(&child.join(\"secret\"), owner, 64).unwrap(),\n            b\"fixture-only\"\n        );\n        check_protected_directory(&child, owner).unwrap();\n        // Search permission does not relax the final directory's private mode.\n        assert!(check_protected_directory(path, owner).is_err());\n    }\n\n    #[cfg(target_os = \"linux\")]\n    #[test]\n    fn search_only_ancestors_do_not_require_directory_read_permission() {\n        use std::os::unix::{fs::chown, process::CommandExt};\n\n        const CHILD_ROOT: &str = \"SANDPROOF_PROTECTED_SEARCH_ONLY_TEST_ROOT\";\n        if let Some(path) = std::env::var_os(CHILD_ROOT) {\n            let path = std::path::PathBuf::from(path);\n            let owner = fs::metadata(path.join(\"private/secret\")).unwrap().uid();\n            check_search_only_ancestor(&path, owner);\n            return;\n        }\n        let (dir, owner) = fixture();\n        let ancestor = dir.path().join(\"search-only\");\n        let child = ancestor.join(\"private\");\n        fs::create_dir(&ancestor).unwrap();\n        fs::create_dir(&child).unwrap();\n        fs::set_permissions(&child, fs::Permissions::from_mode(0o700)).unwrap();\n        secret(&child.join(\"secret\"));\n        if owner == 0 {\n            const SERVICE_UID: u32 = 65534;\n            chown(&child, Some(SERVICE_UID), Some(SERVICE_UID)).unwrap();\n            chown(child.join(\"secret\"), Some(SERVICE_UID), Some(SERVICE_UID)).unwrap();\n            fs::set_permissions(dir.path(), fs::Permissions::from_mode(0o711)).unwrap();\n            fs::set_permissions(&ancestor, fs::Permissions::from_mode(0o711)).unwrap();\n            // The original test executable may live below a private root target.\n            // Copy only this test binary into the scoped fixture for the real\n            // unprivileged child; no source/configuration permission is changed.\n            let binary = dir.path().join(\"permission-test\");\n            fs::copy(std::env::current_exe().unwrap(), &binary).unwrap();\n            fs::set_permissions(&binary, fs::Permissions::from_mode(0o555)).unwrap();\n            let status = std::process::Command::new(binary)\n                .args([\n                    \"--exact\",\n                    \"protected_files::tests::search_only_ancestors_do_not_require_directory_read_permission\",\n                    \"--nocapture\",\n                ])\n                .env(CHILD_ROOT, &ancestor)\n                .uid(SERVICE_UID)\n                .gid(SERVICE_UID)\n                .status()\n                .unwrap();\n            assert!(status.success(), \"unprivileged directory probe failed\");\n        } else {\n            // A user's own 0711 directory remains readable by that owner. Mode\n            // 0111 models the same search-only DAC without requiring chown.\n            fs::set_permissions(&ancestor, fs::Permissions::from_mode(0o111)).unwrap();\n            let result = std::panic::catch_unwind(|| check_search_only_ancestor(&ancestor, owner));\n            fs::set_permissions(&ancestor, fs::Permissions::from_mode(0o700)).unwrap();\n            result.unwrap();\n        }\n    }\n\n    #[test]\n    fn existing_private_file_is_bounded_and_owner_selected() {\n        let (dir, owner) = fixture();\n        let path = dir.path().join(\"secret\");\n        secret(&path);\n        assert_eq!(read_protected(&path, owner, 12).unwrap(), b\"fixture-only\");\n        assert_eq!(\n            read_protected(&path, owner, 11),\n            Err(ProtectedFileError::TooLarge)\n        );\n        assert_eq!(\n            read_protected(&path, owner, 0),\n            Err(ProtectedFileError::Invalid)\n        );\n        assert!(read_protected(&path, owner.checked_add(1).unwrap(), 64).is_err());\n        check_protected_directory(dir.path(), owner).unwrap();\n        assert!(read_protected(dir.path(), owner, 64).is_err());\n    }\n\n    #[test]\n    fn symlink_leaf_or_ancestor_and_traversal_are_rejected() {\n        let (dir, owner) = fixture();\n        let child = dir.path().join(\"private\");\n        fs::create_dir(&child).unwrap();\n        fs::set_permissions(&child, fs::Permissions::from_mode(0o700)).unwrap();\n        secret(&child.join(\"secret\"));\n        symlink(child.join(\"secret\"), dir.path().join(\"alias\")).unwrap();\n        symlink(&child, dir.path().join(\"alias-dir\")).unwrap();\n        assert!(read_protected(&dir.path().join(\"alias\"), owner, 64).is_err());\n        assert!(read_protected(&dir.path().join(\"alias-dir/secret\"), owner, 64).is_err());\n        assert!(read_protected(&child.join(\"../private/secret\"), owner, 64).is_err());\n        assert!(read_protected(Path::new(\"relative\"), owner, 64).is_err());\n    }\n\n    #[test]\n    fn permissions_hardlinks_and_untrusted_parent_writes_are_rejected() {\n        let (dir, owner) = fixture();\n        let path = dir.path().join(\"secret\");\n        secret(&path);\n        fs::set_permissions(&path, fs::Permissions::from_mode(0o640)).unwrap();\n        assert_eq!(\n            read_protected(&path, owner, 64),\n            Err(ProtectedFileError::Untrusted)\n        );\n        fs::set_permissions(&path, fs::Permissions::from_mode(0o600)).unwrap();\n        fs::hard_link(&path, dir.path().join(\"other\")).unwrap();\n        assert_eq!(\n            read_protected(&path, owner, 64),\n            Err(ProtectedFileError::Untrusted)\n        );\n        fs::remove_file(dir.path().join(\"other\")).unwrap();\n        fs::set_permissions(dir.path(), fs::Permissions::from_mode(0o777)).unwrap();\n        assert_eq!(\n            read_protected(&path, owner, 64),\n            Err(ProtectedFileError::Untrusted)\n        );\n    }\n}\n"},{"id":6,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/std/src/fs.rs"},"crate_name":"std","contents":null},{"id":11,"name":{"Local":"/rustc/library/std/src/lib.rs"},"crate_name":"std","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/std/src/os/unix/fs.rs"},"crate_name":"std","contents":null},{"id":14,"name":{"Loc