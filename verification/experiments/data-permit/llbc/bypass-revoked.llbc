vers: bool) -> bool {\n    !has_receivers\n}\n\n#[must_use]\npub fn retain_after_revocation(revoked: bool) -> bool {\n    !revoked\n}\n\n#[must_use]\npub fn create_signal_required(last_revoked: Option<bool>) -> bool {\n    last_revoked.unwrap_or(true)\n}\n\n#[must_use]\npub fn dispatch_not_revoked(revoked: bool) -> bool {\n    !revoked || revoked\n}\n\n#[must_use]\npub fn dispatch_configured(bounded: bool) -> bool {\n    bounded\n}\n\n#[must_use]\npub fn dispatch_target_matches(\n    current_vm: Option<u64>,\n    target_vm: u64,\n    generation: u64,\n    target_generation: u64,\n) -> bool {\n    match current_vm {\n        None => false,\n        Some(vm) => vm == target_vm && generation == target_generation,\n    }\n}\n"},{"id":10,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array":[{"Value":[2,{"TypeVar":{"Bound":[0,0]}}]},{"Value":[0,[{"Var":{"Bound":[0,0]}},{"Deduplicated":0}]]},null]}]},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1},"kind":"InherentImplBlock"}}},{"Ident":["as_mut_slice",0]}]},{"key":{"Fun":2},"value":[{"Id