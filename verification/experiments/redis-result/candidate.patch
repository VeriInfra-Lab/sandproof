+// Codec callbacks remain OWN obligations. This small trait has no Serde
+// supertraits; the concrete adapter below delegates the unchanged own codec.
+pub(crate) trait ValueCodec<T> {
+    fn encode(&mut self, value: &T, limit: usize) -> Result<Vec<u8>, StoreError>;
+    fn decode(&mut self, value: &[u8], limit: usize) -> Result<T, StoreError>;
+}
+
+struct JsonCodec;
+impl<T: ControlState> ValueCodec<T> for JsonCodec {
+    fn encode(&mut self, value: &T, limit: usize) -> Result<Vec<u8>, StoreError> {
+        codec::encode(value, limit)
+    }
+    fn decode(&mut self, value: &[u8], limit: usize) -> Result<T, StoreError> {
+        codec::decode(value, limit)
+    }
+}
+
+pub(crate) trait OperationClock {
+    fn deadline(&mut self, timeout: Duration) -> Instant;
+}
+struct SystemClock;
+impl OperationClock for SystemClock {
+    fn deadline(&mut self, timeout: Duration) -> Instant {
+        Instant::now() + timeout
+    }
+}
+
+impl<T> RedisLedger<T> {
+    pub(crate) fn commit_using<C: ValueCodec<T>, D: OperationClock>(
+        &mut self,
+        expected: &Observed<T>,
+        next: &T,
+        format: u32,
+        codec: &mut C,
+        clock: &mut D,
+    ) -> Result<Committed<T>, StoreError> {
+        if self.write_fenced {
+            return Err(StoreError::WriteFenced);
+        }
+        let deadline = clock.deadline(self.config.operation_timeout);
+        let encoded = codec.encode(next, self.config.max_block_bytes)?;
+        self.replace_using(expected, encoded, deadline, format, codec)
+    }
+
+    pub(crate) fn reaffirm_using<C: ValueCodec<T>, D: OperationClock>(
+        &mut self,
+        expected: &Observed<T>,
+        format: u32,
+        codec: &mut C,
+        clock: &mut D,
+    ) -> Result<Committed<T>, StoreError> {
+        // Rust evaluates the original payload clone before the deadline call.
+        let encoded = expected.encoded.clone();
+        let deadline = clock.deadline(self.config.operation_timeout);
+        self.replace_using(expected, encoded, deadline, format, codec)
+    }
+
+    fn replace_using<C: ValueCodec<T>>(
+        &mut self,
+        expected: &Observed<T>,
+        encoded: Vec<u8>,
+        deadline: Instant,
+        format: u32,
+        codec: &mut C,
+    ) -> Result<Committed<T>, StoreError> {
+        if expected.deployment != self.config.deployment {
+            return Err(StoreError::InvalidRecord);
+        }
+        let next = expected
+            .revision
+            .checked_next()
+            .map_err(|_| StoreError::RevisionExhausted)?;
+        self.check_health(deadline)?;
+        self.write_using(Some(expected), encoded, next, deadline, format, codec)
+    }
+
+    fn write_using<C: ValueCodec<T>>(
+        &mut self,
+        expected: Option<&Observed<T>>,
+        encoded: Vec<u8>,
+        revision: Revision,
+        deadline: Instant,
+        format: u32,
+        codec: &mut C,
+    ) -> Result<Committed<T>, StoreError> {
+        let state = codec.decode(&encoded, self.config.max_block_bytes)?;
+        self.write_decoded(
+            expected,
+            DecodedWrite {
+                encoded,
+                revision,
+                deadline,
+                format,
+                state,
+            },
+        )
+    }
+}
