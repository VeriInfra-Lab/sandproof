+//! Concrete library calls only; no health/result/fence policy lives here.
+use crate::StoreError;
+use redis::Connection;
+use std::{collections::BTreeMap, time::Instant};
+
+pub(super) struct Cas<'a> {
+    pub script: &'a str,
+    pub key: String,
+    pub deployment: &'a str,
+    pub format: u32,
+    pub prior: String,
+    pub revision: u64,
+    pub payload: &'a [u8],
+    pub limit: usize,
+    pub expected: &'a [u8],
+}
+
+pub(super) fn eval(
+    connection: &mut Option<Connection>,
+    input: Cas<'_>,
+    deadline: Instant,
+) -> Result<i64, StoreError> {
+    query(
+        connection,
+        redis::cmd("EVAL")
+            .arg(input.script)
+            .arg(1)
+            .arg(input.key)
+            .arg(input.deployment)
+            .arg(input.format)
+            .arg(input.prior)
+            .arg(input.revision)
+            .arg(input.payload)
+            .arg(input.limit)
+            .arg(input.expected),
+        deadline,
+    )
+}
+
+pub(super) fn info(
+    connection: &mut Option<Connection>,
+    section: &str,
+    deadline: Instant,
+) -> Result<String, StoreError> {
+    query(connection, redis::cmd("INFO").arg(section), deadline)
+}
+
+pub(super) fn settings(
+    connection: &mut Option<Connection>,
+    keys: &[&str],
+    deadline: Instant,
+) -> Result<BTreeMap<String, String>, StoreError> {
+    query(
+        connection,
+        redis::cmd("CONFIG").arg("GET").arg(keys),
+        deadline,
+    )
+}
+
+pub(super) fn trim_cr(value: &str) -> &str {
+    value.trim_end_matches('\r')
+}
+
+pub(super) fn query<R: redis::FromRedisValue>(
+    connection: &mut Option<Connection>,
+    command: &mut redis::Cmd,
+    deadline: Instant,
+) -> Result<R, StoreError> {
+    let remaining = deadline
+        .checked_duration_since(Instant::now())
+        .filter(|value| !value.is_zero())
+        .ok_or(StoreError::Unavailable)?;
+    let result = (|| {
+        let connection = connection.as_mut().ok_or(StoreError::Unavailable)?;
+        connection
+            .set_read_timeout(Some(remaining))
+            .map_err(|_| StoreError::Unavailable)?;
+        connection
+            .set_write_timeout(Some(remaining))
+            .map_err(|_| StoreError::Unavailable)?;
+        command
+            .query(connection)
+            .map_err(|_| StoreError::Unavailable)
+    })();
+    // Never reuse a timed-out protocol stream with a possibly pending reply.
+    if result.is_err() {
+        *connection = None;
+    }
+    result
+}
+
+pub(super) fn split_colon(value: &str) -> Option<(&str, &str)> {
+    value.split_once(':')
+}
