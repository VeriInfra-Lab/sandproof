// Appended only to the isolated lifecycle_inbox/tests.rs. The wrong and
// restored phases change only the selected probe name below, not this property.
#[test]
fn proof_full_write_read_contract() {
    use sha2::Digest as _;

    let dir = tempfile::tempdir().unwrap();
    let mut journal = initialize(&dir.path().join("db"));
    let before: (Vec<u8>, Vec<u8>) = journal
        .journal
        .connection
        .query_row(
            "SELECT state_json,sha256 FROM controller_lifecycle_inbox WHERE id=1",
            (),
            |row| Ok((row.get(0)?, row.get(1)?)),
        )
        .unwrap();
    let bytes = br#"{"proof":"new","tail":[0,255,128]}"#.to_vec();
    let digest = sha2::Sha256::digest(&bytes).to_vec();
    assert_ne!(before, (bytes.clone(), digest.clone()), "distinct fixture");

    let transaction =
        super::WorldTransaction::begin(&mut journal.journal.connection, &journal.committed_world)
            .unwrap();
    let mut effects = super::recording::StandardRecord {
        tx: transaction,
        namespace: &journal.namespace,
    };
    let (count, pair) = super::proof_record_update_then_read(
        &mut effects,
        "UPDATE controller_lifecycle_inbox SET state_json=?1,sha256=?2 WHERE id=1",
        &bytes,
        &digest,
    )
    .unwrap();
    assert_eq!(count, 1, "full write/read contract: original count");
    assert_eq!(
        pair,
        (bytes, digest),
        "full write/read contract: complete BLOBs"
    );
}
