import SandproofTxFinish.Types
import SandproofSqlite.SlotData

open Aeneas Aeneas.Std
namespace SandproofTxFinishRust.Model

-- Use the EXISTING two-slot data type and primitive functions. The only new
-- declaration is a dictionary adapter to the freshly generated Cells trait.
abbrev Slots := SandproofSqliteRust.Model.Slots

def slotOps (W : Type) : controller.transaction.memo.Cells (Slots W) W where
  set_committed := fun state value => .ok { state with committed := value }
  take_candidate := fun state => .ok (state.candidate, { state with candidate := none })
end SandproofTxFinishRust.Model
