import SandboxModel.CreateTransactionLink.ActualReadModel
import SandboxModel.CreateTransactionLink.UpdateOwner
import SandboxModel.ProofAuditCommand

open Aeneas Aeneas.Std
open V3CreateSqlStepRust

namespace SandboxModel.CreateTransactionLink.FullWriteRead
noncomputable section

/-- The original Rust probe has the complete primitive-observation contract.
The A4 content clause is used separately to derive the full newly written
bytes/digest; no whole-program correctness assumption occurs here. -/
theorem actual_full_write_read_contract :
    FullWriteReadContract controller.lifecycle_inbox.proof_record_update_then_read := by
  intro effects raw bytes digest present _coherent
  cases transition : raw.conn.step raw.conn.current updateSql bytes digest with
  | fail error =>
    simp [controller.lifecycle_inbox.proof_record_update_then_read, expected,
      controller.lifecycle_inbox.recording.StandardRecord.Insts.Sandproof_controller_serviceControllerLifecycle_inboxCodecInboxSaveEffects.update,
      controller.transaction.WorldTransaction.execute_inbox_update,
      controller.transaction.sqlite_io.execute_blobs,
      SandproofSqliteSession.executeBlobs, present, transition]
  | div =>
    simp [controller.lifecycle_inbox.proof_record_update_then_read, expected,
      controller.lifecycle_inbox.recording.StandardRecord.Insts.Sandproof_controller_serviceControllerLifecycle_inboxCodecInboxSaveEffects.update,
      controller.transaction.WorldTransaction.execute_inbox_update,
      controller.transaction.sqlite_io.execute_blobs,
      SandproofSqliteSession.executeBlobs, present, transition]
  | ok outcome =>
    rcases outcome with ⟨reply, view⟩
    cases reply with
    | Err error =>
      simpa [expected, transition, post, withWriteView] using
        actual_update_error_returns_successor effects raw view updateSql bytes digest
          error present transition
    | Ok count =>
      have owner := actual_update_routes_successor effects raw view updateSql bytes digest
        (.Ok count) present transition
      have read := actual_select_model (withWriteView effects raw view)
        { raw with conn := { raw.conn with current := view } } rfl
      cases selected : select view with
      | fail error =>
        simp [controller.lifecycle_inbox.proof_record_update_then_read, owner, read,
          expected, transition, readExpected, selected, post, withWriteView,
          journalReply, core.result.Result.Insts.CoreOpsTry.branch]
      | div =>
        simp [controller.lifecycle_inbox.proof_record_update_then_read, owner, read,
          expected, transition, readExpected, selected, post, withWriteView,
          journalReply, core.result.Result.Insts.CoreOpsTry.branch]
      | ok selectedReply =>
        cases selectedReply <;>
          simp [controller.lifecycle_inbox.proof_record_update_then_read, owner, read,
            expected, transition, readExpected, selected, post, withWriteView,
            journalReply, core.result.Result.Insts.CoreOpsTry.branch,
            core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]

/-- Actual Rust success with the original count and complete newly written
bytes/digest, derived from the per-operation A4 clause and normal SELECT
observations. No success, liveness or frame is supplied on an SQL Err. -/
theorem actual_success_returns_complete_new_blobs
    (effects : Record) (raw : RawTransaction) (bytes digest : Bytes)
    (count : Usize) (view : SandproofSqliteSession.ReadView)
    (row : SandproofSqliteSession.Row)
    (present : effects.tx.transaction = some raw)
    (coherent : A4FixedUpdateSelect raw.conn bytes digest)
    (written : raw.conn.step raw.conn.current updateSql bytes digest = .ok (.Ok count, view))
    (oneRow : count.val = 1)
    (prepared : view.single.canonical.prepare selectSql = .ok (.Ok 0))
    (observed : view.single.expectedRow selectSql
      (SandproofLoadBlobRust.issuedReadStatement view.single selectSql 0) = .ok (.Ok row)) :
    controller.lifecycle_inbox.proof_record_update_then_read effects updateSql bytes digest =
      .ok (.Ok (count, (⟨bytes⟩, ⟨digest⟩)), post effects raw view) := by
  have fields := coherent count view written oneRow
    (SandproofLoadBlobRust.issuedReadStatement view.single selectSql 0) row observed
  have read := select_complete view row bytes digest prepared observed
    fields.1 fields.2.1 fields.2.2
  rw [actual_full_write_read_contract effects raw bytes digest present coherent]
  simp [expected, written, read]

end
end SandboxModel.CreateTransactionLink.FullWriteRead

#audit_controller_proof SandboxModel.CreateTransactionLink.FullWriteRead.actual_full_write_read_contract
#audit_controller_proof SandboxModel.CreateTransactionLink.FullWriteRead.actual_success_returns_complete_new_blobs
