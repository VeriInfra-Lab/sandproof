    (statement : Str) :
    RequiresLive before (SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.recording.StandardRecord.Insts.Sandproof_controller_serviceControllerCheckpointConfigReadConfigEffects.query_bytes
