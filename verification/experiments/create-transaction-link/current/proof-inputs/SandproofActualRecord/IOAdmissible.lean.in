theorem lift_reply_preserves_normal {D A : Type} (before : IOOwnerTransport.Holder D)
    (call : Result (SandproofParentCommitRust.ErrorTransport.RequestRustResult A × OldHolder D))
    (requires : RequiresLive (toSource before) call)
    (reply : SandproofParentCommitRust.ErrorTransport.RequestRustResult A) (sourceAfter : OldHolder D)
    (returned : call = .ok (reply, sourceAfter)) :
    ∃ after, liftReply before call =
      .ok (SandproofParentCommitRust.ErrorTransport.fromRequestRustResult reply, after) ∧
      toSource after = sourceAfter ∧ after.tx.terminate = before.tx.terminate := by
  obtain ⟨raw, live⟩ := requires (reply, sourceAfter) returned
  obtain ⟨after, transfer, mapped, observed⟩ := transfer_of_live before sourceAfter (by simp [live])
  exact ⟨after, by simp [liftReply, returned, transfer], mapped, observed⟩

theorem lift_value_preserves_normal {D A : Type} (before : IOOwnerTransport.Holder D)
    (call : Result (A × OldHolder D)) (requires : RequiresLive (toSource before) call)
    (reply : A) (sourceAfter : OldHolder D) (returned : call = .ok (reply, sourceAfter)) :
    ∃ after, liftValue before call = .ok (reply, after) ∧
      toSource after = sourceAfter ∧ after.tx.terminate = before.tx.terminate := by
  obtain ⟨raw, live⟩ := requires (reply, sourceAfter) returned
  obtain ⟨after, transfer, mapped, observed⟩ := transfer_of_live before sourceAfter (by simp [live])
  exact ⟨after, by simp [liftValue, returned, transfer], mapped, observed⟩

end
end SandproofActualRecordRust.IOAdmissible

