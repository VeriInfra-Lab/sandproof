  {W : Type} {T : Type} {S : Type} {R : Type} (CellsInst :
  sandproof_controller_service.controller.transaction.memo.Cells S W)
  (coreopsfunctionFnOnceRTupleTResultTupleErrorInst : core.ops.function.FnOnce
  R T (core.result.Result Unit rusqlite.error.Error)) (transaction : Option T)
