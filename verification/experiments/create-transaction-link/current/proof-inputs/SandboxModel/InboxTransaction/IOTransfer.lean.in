import SandboxModel.InboxTransaction.CodecTransfer

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service
open sandproof_controller_service.controller.lifecycle_inbox.recording
set_option autoImplicit false

namespace SandboxModel.StandardRecordIO
noncomputable section
open SandboxModel.StandardRecordCodec

-- A view of the actual two dereferences, one library call, and original owner.
-- It is not a database frame or a guarantee that an Err leaves SQL active.
def borrowedView {D X A R : Type}
    (observe : rusqlite.Connection → X → Result (A × R))
    (before : Holder D) (input : X) : Result (A × Holder D) := do
  let raw ← controller.transaction.WorldTransaction.Insts.CoreOpsDerefDerefTransaction.deref before.tx
  let connection ← rusqlite.transaction.Transaction.Insts.CoreOpsDerefDerefConnection.deref raw
  let (reply, _) ← observe connection input
  .ok (reply, before)

theorem observed_borrow_returns_original_owner {D X A R : Type}
    (observe : rusqlite.Connection → X → Result (A × R))
    (before : Holder D) (input : X) (raw : rusqlite.transaction.Transaction)
    (reply : A) (returnedReader : R)
    (slot : before.tx.transaction = some raw)
    (returned : observe raw.conn input = .ok (reply, returnedReader)) :
    borrowedView observe before input = .ok (reply, before) := by
  simp [borrowedView, controller.transaction.WorldTransaction.Insts.CoreOpsDerefDerefTransaction.deref,
    core.option.Option.as_ref, SandproofFoundationsRust.core.option.Option.as_ref,
    core.option.Option.expect, Result.ofOption,
    rusqlite.transaction.Transaction.Insts.CoreOpsDerefDerefConnection.deref, slot, returned]

theorem actual_query_i64_call_contract {D : Type} (codec : RecordCodec D)
    (before : Holder D) (input : Str) :
    sandproof_controller_service.controller.lifecycle_inbox.recording.StandardRecord.Insts.Sandproof_controller_serviceControllerCheckpointConfigReadConfigEffects.query_i64 codec before input =
      borrowedView (fun connection arg =>
        sandproof_controller_service.controller.checkpoint.config.StandardConfigRead.Insts.Sandproof_controller_serviceControllerCheckpointConfigReadConfigEffects.query_i64
          { connection } arg) before input := by
  rfl

