def updateView {D : Type} (before : Holder D) (sql : Str) (bytes digest : Slice U8) :
    Result (JournalReply Usize × Holder D) := do
  let (reply, after) ← controller.transaction.WorldTransaction.execute_inbox_update
    before.tx sql bytes digest
  .ok (reply, { before with tx := after })

theorem actual_update_call_contract {D : Type} (codec : RecordCodec D)
    (before : Holder D) (sql : Str) (bytes digest : Slice U8) :
    StandardRecord.Insts.Sandproof_controller_serviceControllerLifecycle_inboxCodecInboxSaveEffects.update
      codec before sql bytes digest = updateView before sql bytes digest := by
  rfl

theorem update_owner_retains_codec_and_namespace {D : Type}
    (before : Holder D) (after : controller.transaction.WorldTransaction) :
    ({ before with tx := after } : Holder D).codec = before.codec ∧
      ({ before with tx := after } : Holder D).«namespace» = before.«namespace» := ⟨rfl, rfl⟩

def mapSql {A : Type} (reply : SandproofSqliteSession.SqlReply A) : JournalReply A :=
  match reply with
  | .Ok value => .Ok value
  | .Err error => .Err (.Sqlite error)

-- Full returned raw transaction on both SQL Ok and SQL Err, rather than
-- replacing the Err poststate by the pre-call transaction.
theorem actual_update_returned_transaction
    (before : controller.transaction.WorldTransaction) (raw after : rusqlite.transaction.Transaction)
    (sql : Str) (bytes digest : Slice U8) (reply : SandproofSqliteSession.SqlReply Usize)
    (slot : before.transaction = some raw)
    (returned : controller.transaction.sqlite_io.execute_blobs raw sql bytes digest =
      .ok (reply, after)) :
    controller.transaction.WorldTransaction.execute_inbox_update before sql bytes digest =
      .ok (mapSql reply, { before with transaction := some after }) := by
  unfold controller.transaction.WorldTransaction.execute_inbox_update
  simp only [slot]
  rw [returned]
  cases reply <;> simp [mapSql, core.result.Result.Insts.CoreOpsTry.branch,
    core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual,
    JournalErrorFromSqlite.from]

end
end SandboxModel.StandardRecordIO

