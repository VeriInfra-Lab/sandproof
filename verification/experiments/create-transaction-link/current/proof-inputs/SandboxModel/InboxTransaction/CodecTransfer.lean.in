theorem actual_encode_for_load_returned_state {D : Type} (codec : RecordCodec D)
    (before : Holder D) (input : controller.lifecycle_inbox.model.Inbox) (raw : rusqlite.transaction.Transaction)
    (reply : JsonReply (alloc.vec.Vec U8)) (after : D)
    (slot : before.tx.transaction = some raw)
    (returned : codec.encode_inbox before.codec raw.conn input = .ok (reply, after)) :
    StandardRecord.Insts.Sandproof_controller_serviceControllerLifecycle_inboxCodecInboxLoadEffects.encode_inbox codec before input =
