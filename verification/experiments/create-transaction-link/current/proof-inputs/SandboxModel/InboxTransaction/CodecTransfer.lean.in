theorem actual_encode_for_save_returned_state {D : Type} (codec : RecordCodec D)
    (before : Holder D) (input : controller.lifecycle_inbox.model.Inbox) (raw : rusqlite.transaction.Transaction)
    (reply : JsonReply (alloc.vec.Vec U8)) (after : D)
    (slot : before.tx.transaction = some raw)
    (returned : codec.encode_inbox before.codec raw.conn input = .ok (reply, after)) :
    StandardRecord.Insts.Sandproof_controller_serviceControllerLifecycle_inboxCodecInboxSaveEffects.encode codec before input =
      .ok (mapJson reply, { before with codec := after }) := by
  rw [actual_encode_for_save_call_contract]
  exact observed_call_returns_full_state _ _ _ _ _ _ slot returned

end
end SandboxModel.StandardRecordCodec

