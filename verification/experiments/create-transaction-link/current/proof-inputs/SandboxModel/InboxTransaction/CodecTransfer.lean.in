theorem actual_encode_for_save_call_contract {D : Type} (codec : RecordCodec D)
    (before : Holder D) (input : controller.lifecycle_inbox.model.Inbox) :
    StandardRecord.Insts.Sandproof_controller_serviceControllerLifecycle_inboxCodecInboxSaveEffects.encode codec before input =
      callView codec.encode_inbox before input := by
  unfold StandardRecord.Insts.Sandproof_controller_serviceControllerLifecycle_inboxCodecInboxSaveEffects.encode callView
  congr 1
  funext raw
