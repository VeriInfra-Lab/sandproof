    JournalErrorFromJson.from]

theorem actual_decode_inbox_returned_state {D : Type} (codec : RecordCodec D)
    (before : Holder D) (input : Slice U8) (raw : rusqlite.transaction.Transaction)
    (reply : JsonReply (controller.lifecycle_inbox.model.Inbox)) (after : D)
    (slot : before.tx.transaction = some raw)
