import SandproofRestoreClaim.Types

open Aeneas Aeneas.Std
namespace SandproofRestoreClaimRust

-- The registered A6 normal-value String and Option comparisons.
@[simp] def alloc.string.String.Insts.CoreCmpPartialEqString.eq
    (left right : String) : Result Bool := .ok (decide (left = right))

def core.option.Option.Insts.CoreCmpPartialEqOption.eq {T : Type}
    (dictionary : core.cmp.PartialEq T T) (left right : Option T) : Result Bool :=
  match left, right with
  | none, none => .ok true
  | some left, some right => dictionary.eq left right
  | _, _ => .ok false

-- A6 normal-value Clone operations also used by the original restore-work proof.
@[simp] def alloc.string.String.Insts.CoreCloneClone.clone (value : String) :
    Result String := .ok value

def core.option.Option.Insts.CoreCloneClone.clone {T : Type}
    (dictionary : core.clone.Clone T) (value : Option T) : Result (Option T) :=
  match value with
  | none => .ok none
  | some item => do
      let copied ← dictionary.clone item
      .ok (some copied)

end SandproofRestoreClaimRust
