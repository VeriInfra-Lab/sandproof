import SandboxModel.Lifecycle.Protocol.SourceLive.Examples
import SandboxModel.Lifecycle.Protocol.SourceLive.Counterexamples
open Aeneas Aeneas.Std SandproofSourceLiveRust
namespace SandboxModel.Stage1Protocol.SourceLive.NegativeVersion
open sandbox_controller_core

theorem actual_mutant_accepts : run Values.native Values.localBinding 3#u64 4#u64 20#i64 = .ok true := by
  simp [run, controller.lifecycle_inbox.source_work.snapshot.live_native,
    source_observation.SourceObservationGuard.allows,
    ids.TenantId.Insts.CoreCmpPartialEqTenantId.eq,
    ids.VmId.Insts.CoreCmpPartialEqVmId.eq,
    model.Phase.Insts.CoreCmpPartialEqPhase.eq, model.Phase.read_discriminant,
    SandproofSourceLiveRust.core.option.Option.is_some_and,
    SandproofFoundationsRust.core.option.Option.is_some_and,
    controller.lifecycle_inbox.source_work.snapshot.live_native.closure.Insts.CoreOpsFunctionFnOnceTupleI64Bool.call_once,
    Values.native, Values.localBinding, Values.life]

theorem violates_full_contract : ¬ FullLiveContract run :=
  Counterexamples.false_positive_excludes run Values.native Values.localBinding 3#u64 4#u64 20#i64
    Examples.version_expected actual_mutant_accepts
end SandboxModel.Stage1Protocol.SourceLive.NegativeVersion

#audit_controller_proof SandboxModel.Stage1Protocol.SourceLive.NegativeVersion.actual_mutant_accepts
#audit_controller_proof SandboxModel.Stage1Protocol.SourceLive.NegativeVersion.violates_full_contract
