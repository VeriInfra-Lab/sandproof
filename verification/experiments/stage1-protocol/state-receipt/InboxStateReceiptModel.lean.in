import SandboxModel.Lifecycle.Protocol.InboxStateModel
import SandboxModel.ProofAuditCommand

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_controller_service.controller.lifecycle_inbox.native_retirement
open sandproof_controller_service.controller.lifecycle_inbox.renewal_confirmation
open sandproof_controller_service.controller.lifecycle_inbox.unload_resolution
open sandproof_protocol.lifecycle.authority
namespace SandboxModel.Stage1Protocol.StateReceipt
noncomputable section
-- Representation of the actual four-field constructor. This relation is not
-- a substitute implementation or a claim about the async producer.
def Assembled (state : LifecycleWorkState) (receipt : RecordedLifecycleIntent) : Prop :=
  receipt.intent = state.intent ∧
  receipt.current_session_version = state.current_session_version ∧
  receipt.current = state.current ∧ receipt.terminal = state.terminal

end
end SandboxModel.Stage1Protocol.StateReceipt
