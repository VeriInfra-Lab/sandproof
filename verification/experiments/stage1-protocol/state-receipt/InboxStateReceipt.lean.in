#audit_controller_proof SandboxModel.Stage1Protocol.StateReceipt.actual_validated_state_version_bound
#audit_controller_proof SandboxModel.Stage1Protocol.StateReceipt.actual_validated_state_receipt_iff
#audit_controller_proof SandboxModel.Stage1Protocol.StateReceipt.assembled_changed_intent_rejected
#audit_controller_proof SandboxModel.Stage1Protocol.StateReceipt.actual_inbox_state_version_bound
#audit_controller_proof SandboxModel.Stage1Protocol.StateReceipt.actual_inbox_state_receipt_iff
#audit_controller_proof SandboxModel.Stage1Protocol.StateReceipt.actual_record_success_receipt_matches
