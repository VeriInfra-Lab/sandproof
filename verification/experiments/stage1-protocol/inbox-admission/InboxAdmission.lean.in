#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.accepts_iff
#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.context_rejection_before_envelope
#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.envelope_error_is_conflict
#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.normal_accepted
#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.refuses_iff
#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.foreign_config_center_rejected
#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.foreign_config_node_rejected
#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.accepted_binds_original_configuration
#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.distinct_retention_window_accepted
