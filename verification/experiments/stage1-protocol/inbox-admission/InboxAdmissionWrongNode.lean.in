import SandboxModel.Lifecycle.Protocol.InboxAdmissionSupport
import SandboxModel.Lifecycle.Protocol.InboxAdmissionValues
open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_protocol.lifecycle.authority
namespace SandboxModel.Stage1Protocol.InboxAdmission.WrongNode

theorem foreign_generation_accepted :
    authenticated (InboxLookup.Witness.inbox 1#u64) foreignIntent foreignContext = .ok (.Ok ()) := by
  have accepted := accepted_body foreignIntent foreignContext
  rw [(Validation.expectedAccepted_success_iff _ _).mpr foreign_envelope_has_valid_shape] at accepted
  have context_ok : (InboxLookup.Witness.inbox 1#u64).verify_context foreignContext = .ok (.Ok ()) := by
    simp [Inbox.verify_context, InboxLookup.Witness.inbox, foreignContext,
      EnvelopeValues.context, AuthenticatedCenterContext.impl.center,
      core.cmp.PartialEq.ne.trait_default, core.cmp.PartialEq.ne.default, Replay.center_eq]
  unfold authenticated
  rw [context_ok]
  simp [core.result.Result.Insts.CoreOpsTry.branch, accepted, core.result.Result.map_err]

theorem rejects_same_full_contract : ¬ FullAuthenticationContract authenticated := by
  intro contract
  have actual := contract (InboxLookup.Witness.inbox 1#u64) foreignIntent foreignContext
  rw [foreign_generation_accepted] at actual
  have foreign : ¬ ContextMatches (InboxLookup.Witness.inbox 1#u64) foreignContext := by
    simp [ContextMatches, InboxLookup.Witness.inbox, foreignContext, EnvelopeValues.context, EnvelopeValues.node]
  simp [expectedAuthentication, foreign] at actual

end SandboxModel.Stage1Protocol.InboxAdmission.WrongNode

#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.WrongNode.foreign_generation_accepted
#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.WrongNode.rejects_same_full_contract
