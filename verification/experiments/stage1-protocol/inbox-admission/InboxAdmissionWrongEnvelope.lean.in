import SandboxModel.Lifecycle.Protocol.InboxAdmissionSupport
import SandboxModel.Lifecycle.Protocol.InboxAdmissionValues
open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_protocol.lifecycle.authority
namespace SandboxModel.Stage1Protocol.InboxAdmission


namespace WrongEnvelope

theorem invalid_envelope_accepted :
    authenticated (InboxLookup.Witness.inbox 1#u64) invalidIntent EnvelopeValues.context = .ok (.Ok ()) := by
  unfold authenticated
  simp [Inbox.verify_context, InboxLookup.Witness.inbox, EnvelopeValues.context,
    AuthenticatedCenterContext.impl.center, AuthenticatedCenterContext.impl.expected_node,
    core.cmp.PartialEq.ne.trait_default, core.cmp.PartialEq.ne.default, Replay.center_eq, Replay.node_eq,
    core.result.Result.Insts.CoreOpsTry.branch]

theorem rejects_same_full_contract : ¬ FullAuthenticationContract authenticated := by
  intro contract
  have actual := contract (InboxLookup.Witness.inbox 1#u64) invalidIntent EnvelopeValues.context
  rw [invalid_envelope_accepted] at actual
  have matching : ContextMatches (InboxLookup.Witness.inbox 1#u64) EnvelopeValues.context := ⟨rfl,rfl⟩
  have rejected := (Validation.expectedAccepted_error_iff _ _ _).mpr invalid_retention_is_first
  simp [expectedAuthentication, matching, rejected, collapse] at actual

end WrongEnvelope
end SandboxModel.Stage1Protocol.InboxAdmission

#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.WrongEnvelope.invalid_envelope_accepted
#audit_controller_proof SandboxModel.Stage1Protocol.InboxAdmission.WrongEnvelope.rejects_same_full_contract
