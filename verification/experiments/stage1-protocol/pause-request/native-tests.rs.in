fn proof_pause_request_work() -> SourceWork {
    let dir = tempfile::tempdir().unwrap();
    let (mut journal, _) = ready(&dir.path().join("db"));
    prepare(&mut journal).work
}

fn proof_pause_request_expected(work: &SourceWork) -> crate::capture::PauseWorkRequest {
    let LifecycleOperation::Unload {
        source_incarnation,
        capture,
    } = work.anchor.request.request.operation
    else {
        panic!("the original fixture is an Unload");
    };
    crate::capture::PauseWorkRequest {
        binding: sandproof_protocol::lifecycle::CaptureBinding {
            operation: work.anchor.request.request.binding.clone(),
            source_incarnation,
            capture,
        },
        source_work_binding: work.requirement.work_binding,
        node: work.requirement.node.clone(),
        source_resource: work.requirement.resource.clone(),
        source: work.requirement.source.clone(),
    }
}

#[test]
fn proof_pause_request_full() {
    let work = proof_pause_request_work();
    let expected = proof_pause_request_expected(&work);
    assert!(expected.valid());
    let value = crate::proof_source_pause_request(&work).unwrap();
    assert_eq!(value, expected);
}

#[test]
fn proof_pause_request_operation_binding() {
    let work = proof_pause_request_work();
    let value = crate::proof_source_pause_request(&work).unwrap();
    assert_eq!(value.binding.operation, work.anchor.request.request.binding);
}

#[test]
fn proof_pause_request_wire_numbers() {
    let work = proof_pause_request_work();
    let expected = proof_pause_request_expected(&work);
    let value = crate::proof_source_pause_request(&work).unwrap();
    assert_eq!(
        value.binding.source_incarnation,
        expected.binding.source_incarnation
    );
    assert_eq!(value.binding.capture, expected.binding.capture);
}

#[test]
fn proof_pause_request_work_binding() {
    let work = proof_pause_request_work();
    let value = crate::proof_source_pause_request(&work).unwrap();
    assert_eq!(value.source_work_binding, work.requirement.work_binding);
}

#[test]
fn proof_pause_request_node() {
    let work = proof_pause_request_work();
    let value = crate::proof_source_pause_request(&work).unwrap();
    assert_eq!(value.node, work.requirement.node);
}

#[test]
fn proof_pause_request_resource() {
    let work = proof_pause_request_work();
    let value = crate::proof_source_pause_request(&work).unwrap();
    assert_eq!(value.source_resource, work.requirement.resource);
