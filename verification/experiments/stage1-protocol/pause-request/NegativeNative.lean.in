import SandboxModel.Lifecycle.Protocol.PauseRequest.Spec
import SandboxModel.Lifecycle.Protocol.PauseRequest.Cloning
import SandboxModel.Lifecycle.Protocol.PauseRequest.Examples
open Aeneas Aeneas.Std SandproofPauseRequestRust
namespace SandboxModel.Stage1Protocol.PauseRequest.NegativeNative
open Values ProtocolCloning Cloning
theorem bad_actual : proof_source_pause_request distinctNative =
    .ok (.Ok (Assembled distinctNative 37#u64 1#u64)) := by
  simp [proof_source_pause_request,
    controller.lifecycle_inbox.source_work.full.SourceWork.pause_request,
    controller.lifecycle_inbox.source_work.SourceWork.request,
    sandproof_protocol.lifecycle.identity.IncarnationId.Insts.CoreConvertTryFromU64InternalError.try_from,
    sandproof_protocol.internal.PositiveCounter.Insts.CoreConvertTryFromU64InternalError.try_from,
    core.result.Result.map_err, core.result.Result.Insts.CoreOpsTry.branch,
    Assembled, distinctNative, base, request]
theorem rejects_same_full_contract : ¬ FullPauseContract proof_source_pause_request := by
  intro claimed
  have failed := claimed distinctNative
  rw [bad_actual, domains_expected] at failed
  have same : Assembled distinctNative 37#u64 1#u64 = Assembled distinctNative 101#u64 1#u64 := by
    simpa using failed
  have value := congrArg (fun p : Request => p.binding.source_incarnation.val) same
  simp [Assembled] at value
end SandboxModel.Stage1Protocol.PauseRequest.NegativeNative
#audit_controller_proof SandboxModel.Stage1Protocol.PauseRequest.NegativeNative.bad_actual
#audit_controller_proof SandboxModel.Stage1Protocol.PauseRequest.NegativeNative.rejects_same_full_contract
