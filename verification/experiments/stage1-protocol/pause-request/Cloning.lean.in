import SandboxModel.Lifecycle.Protocol.PauseRequest.ProtocolCloning
open Aeneas Aeneas.Std SandproofPauseRequestRust
namespace SandboxModel.Stage1Protocol.PauseRequest.Cloning
open ProtocolCloning
@[simp] theorem sandproof_protocol_ResourceKind_clone_exact (value : sandproof_protocol.ResourceKind) :
    sandproof_protocol.ResourceKind.Insts.CoreCloneClone.clone value = .ok value := by
  cases value <;> simp [sandproof_protocol.ResourceKind.Insts.CoreCloneClone.clone]

@[simp] theorem sandproof_protocol_ResourceRef_clone_exact (value : sandproof_protocol.ResourceRef) :
    sandproof_protocol.ResourceRef.Insts.CoreCloneClone.clone value = .ok value := by
  simp [sandproof_protocol.ResourceRef.Insts.CoreCloneClone.clone]

@[simp] theorem capture_SourceProcessIdentity_clone_exact (value : capture.SourceProcessIdentity) :
    capture.SourceProcessIdentity.Insts.CoreCloneClone.clone value = .ok value := by
  simp [capture.SourceProcessIdentity.Insts.CoreCloneClone.clone, lift]

end SandboxModel.Stage1Protocol.PauseRequest.Cloning
