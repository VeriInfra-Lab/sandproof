import SandboxModel.Lifecycle.Protocol.PauseRequest.Spec
import SandboxModel.Lifecycle.Protocol.PauseRequest.Cloning
import SandboxModel.Lifecycle.Protocol.PauseRequest.Examples
open Aeneas Aeneas.Std SandproofPauseRequestRust
namespace SandboxModel.Stage1Protocol.PauseRequest.NegativeBinding
open Values ProtocolCloning Cloning
def wrong : Request :=
  { Assembled changedBinding 101#u64 1#u64 with source_work_binding := digest }
theorem bad_actual : proof_source_pause_request changedBinding = .ok (.Ok wrong) := by
  simp [proof_source_pause_request,
    controller.lifecycle_inbox.source_work.full.SourceWork.pause_request,
    controller.lifecycle_inbox.source_work.SourceWork.request,
    wrong, Assembled, changedBinding, base, request]
theorem rejects_same_full_contract : ¬ FullPauseContract proof_source_pause_request := by
  intro claimed
  have failed := claimed changedBinding
  rw [bad_actual, binding_expected] at failed
  have same : wrong = Assembled changedBinding 101#u64 1#u64 := by simpa using failed
  have value := congrArg (fun p : Request => p.source_work_binding) same
  change digest = otherDigest at value
  exact (by decide : digest ≠ otherDigest) value
end SandboxModel.Stage1Protocol.PauseRequest.NegativeBinding
#audit_controller_proof SandboxModel.Stage1Protocol.PauseRequest.NegativeBinding.bad_actual
#audit_controller_proof SandboxModel.Stage1Protocol.PauseRequest.NegativeBinding.rejects_same_full_contract
