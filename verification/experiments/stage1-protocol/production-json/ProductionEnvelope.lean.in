#audit_controller_proof SandboxModel.Stage1Protocol.ProductionEnvelope.actual_accepts_iff
#audit_controller_proof SandboxModel.Stage1Protocol.ProductionEnvelope.parsed_own_fields_are_proved
#audit_controller_proof SandboxModel.Stage1Protocol.ProductionEnvelope.actual_json_error_precedes_guard
#audit_controller_proof SandboxModel.Stage1Protocol.ProductionEnvelope.actual_parser_failure_preserved
#audit_controller_proof SandboxModel.Stage1Protocol.ProductionEnvelope.actual_parser_divergence_preserved
#audit_controller_proof SandboxModel.Stage1Protocol.ProductionEnvelope.accepted_normal_bounded_roundtrip
#audit_controller_proof SandboxModel.Stage1Protocol.ProductionEnvelope.recorded_full_value_and_match
#audit_controller_proof SandboxModel.Stage1Protocol.ProductionEnvelope.recorded_writer_from_actual_input
