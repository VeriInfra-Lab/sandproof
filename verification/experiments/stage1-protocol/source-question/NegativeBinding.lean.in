import SandboxModel.Lifecycle.Protocol.SourceQuestion.Cloning
import SandboxModel.Lifecycle.Protocol.SourceQuestion.Examples
open Aeneas Aeneas.Std SandproofSourceQuestionRust
namespace SandboxModel.Stage1Protocol.SourceQuestion.Candidate.NegativeBinding
open Values Cloning
theorem bad_actual : run anchor limits otherDigest = .ok (Build anchor limits digest vmAction.resource) := by
  simp [run, controller.lifecycle_inbox.source_work.snapshot.question_from_binding,
    alloc.vec.Vec.index_usize, Build, anchor, base]
theorem rejects_same_contract : ¬ FullQuestionContract run := by
  intro claimed
  have failed := claimed anchor limits otherDigest
  rw [bad_actual, other_binding_expected] at failed
  have same : Build anchor limits digest vmAction.resource = Build anchor limits otherDigest vmAction.resource := by
    simpa using failed
  have wrong := congrArg (fun work : Work => work.requirement.work_binding) same
  change digest = otherDigest at wrong
  exact (by decide : digest ≠ otherDigest) wrong
end SandboxModel.Stage1Protocol.SourceQuestion.Candidate.NegativeBinding
#audit_controller_proof SandboxModel.Stage1Protocol.SourceQuestion.Candidate.NegativeBinding.bad_actual
#audit_controller_proof SandboxModel.Stage1Protocol.SourceQuestion.Candidate.NegativeBinding.rejects_same_contract
