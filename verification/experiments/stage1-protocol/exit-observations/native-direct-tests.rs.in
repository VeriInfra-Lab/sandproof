// Same full matching assertions on actual original SQLite candidate fixtures.

#[test]
fn proof_exit_observations_direct_normal() {
    let dir = tempfile::tempdir().unwrap();
    let path = dir.path().join("db");
    let (journal, request, work, action) = candidate(&path, true);
    let qualified = journal
        .lifecycle_restore_exit_candidate(&request, &v3::context(), 10)
        .unwrap()
        .expect("original committed activation qualifies the direct exit question");
    let observed = exit(&action, &work);
    assert!(qualified.matches(&observed));
}

#[test]
fn proof_exit_observations_direct_identity() {
    let dir = tempfile::tempdir().unwrap();
    let path = dir.path().join("db");
    let (journal, request, work, action) = candidate(&path, true);
    let qualified = journal
        .lifecycle_restore_exit_candidate(&request, &v3::context(), 10)
        .unwrap()
        .expect("original committed activation qualifies the direct exit question");
    let mut observed = exit(&action, &work);
    assert!(qualified.matches(&observed));
    observed.action.identity.generation ^= 1;
    assert!(!qualified.matches(&observed));
}

