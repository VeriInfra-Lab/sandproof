import SandproofExitObservations.Types
open Aeneas Aeneas.Std SandproofExitObservationsRust
namespace SandboxModel.Stage1Protocol.ExitObservations
open controller.lifecycle_inbox.source_work.restore
abbrev Direct := exit.RestoreExitCandidate
abbrev Before := continued_exit.BeforeAdmissionExitCandidate
abbrev Continued := continued_exit.ContinuedExitCandidate
abbrev DirectObservation := capture.restore.RestoreCandidateExitObservation
abbrev ContinuedObservation := capture.continuation.OriginalContinueExitObservation

/-- Full decoded value conditions only; no physical or transaction fact. -/
def DirectMatches (candidate : Direct) (observed : DirectObservation) : Prop :=
  observed.action = candidate.action ∧ observed.work_binding = candidate.work_binding ∧
  observed.process.pid > 0#u32 ∧ observed.process.start_time_ticks > 0#u64 ∧
  observed.process.boot_id = candidate.work.source.host_bootstrap.boot_id

def BeforeMatches (candidate : Before) (observed : DirectObservation) : Prop :=
  observed.action = candidate.action ∧ observed.work_binding = candidate.work_binding ∧
  observed.process = candidate.process

def ContinuedMatches (candidate : Continued) (observed : ContinuedObservation) : Prop :=
  observed.action = candidate.action ∧ observed.work_binding = candidate.work_binding ∧
  observed.process = candidate.work.source.source

def FullExitMatchContract
    (direct : Direct → DirectObservation → Result Bool)
    (before : Before → DirectObservation → Result Bool)
    (continued : Continued → ContinuedObservation → Result Bool) : Prop :=
  (∀ c o, direct c o = .ok ((by classical exact decide (DirectMatches c o)))) ∧
  (∀ c o, before c o = .ok ((by classical exact decide (BeforeMatches c o)))) ∧
  (∀ c o, continued c o = .ok ((by classical exact decide (ContinuedMatches c o))))


end SandboxModel.Stage1Protocol.ExitObservations
