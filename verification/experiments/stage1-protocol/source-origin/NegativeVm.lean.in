import SandboxModel.Lifecycle.Protocol.SourceOrigin.Examples
open Aeneas Aeneas.Std SandproofSourceOriginRust
namespace SandboxModel.Stage1Protocol.SourceOrigin.NegativeVm
open sandbox_controller_core WitnessSupport

theorem bad_actual : run Values.world Values.inbox Values.otherVm 0#usize = .ok (.Ok ()) := by
  unfold run controller.lifecycle_inbox.source_work.snapshot.validate_execution_origin
  simp only [Values.otherVm, Values.anchor, find_inbox]
  simp [core.result.Result.map_err, core.result.Result.Insts.CoreOpsTry.branch,
    core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual,
    core.option.Option.ok_or, alloc.vec.Vec.index_usize,
    core.cmp.PartialEq.ne.trait_default, core.cmp.PartialEq.ne.default,
    core.option.Option.Insts.CoreCmpPartialEqOption.eq,
    ids.OperationId.Insts.CoreCmpPartialEqOperationId.eq,
    model.OperationKind.Insts.CoreCmpPartialEqOperationKind.eq,
    model.OperationKind.read_discriminant,
    Values.inbox, Values.session, Values.entry, Values.singleton,
    Values.origin, Values.key, plan_contents, row_contents, Values.world,
    SandboxModel.Foundations.tableLookup, Values.plan, Values.row,
    epoch_actual, EpochExpected]

theorem rejects_same_contract : ¬ FullOriginContract run := by
  intro contract
  have same := contract Values.world Values.inbox Values.otherVm 0#usize
  rw [bad_actual, Examples.vm_expected] at same
  simp [Reject] at same
end SandboxModel.Stage1Protocol.SourceOrigin.NegativeVm
#audit_controller_proof SandboxModel.Stage1Protocol.SourceOrigin.NegativeVm.bad_actual
#audit_controller_proof SandboxModel.Stage1Protocol.SourceOrigin.NegativeVm.rejects_same_contract
