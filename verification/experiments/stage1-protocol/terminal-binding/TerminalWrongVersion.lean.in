import SandboxModel.Lifecycle.Protocol.TerminalValues
import SandboxModel.Lifecycle.Protocol.Accepted

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_protocol.lifecycle.authority sandproof_protocol.lifecycle.request
open sandproof_protocol.lifecycle.terminal
namespace SandboxModel.Stage1Protocol.Terminal.WrongVersion

theorem actual_return :
    terminal_matches (Values.observation Values.wrongVersion .Cleaned) Values.wrongVersion = .ok true := by
  simp [terminal_matches, TerminalLifecycleObservation.matches_request,
    Replay.accepted_eq, Validation.retention_valid,

    Values.observation, Values.original,
     Values.wrongVersion, EnvelopeValues.intent,
    EnvelopeValues.center, EnvelopeValues.node, Validation.retentionOK]

theorem refutes_full_contract : ¬ FullTerminalContract terminal_matches := by
  intro full
  have returned := full (Values.observation Values.wrongVersion .Cleaned) Values.wrongVersion
  rw [actual_return] at returned
  have invalid := Values.rejected_shapes.2.2.2.1
  simp [expected, invalid] at returned

end SandboxModel.Stage1Protocol.Terminal.WrongVersion

#audit_controller_proof SandboxModel.Stage1Protocol.Terminal.WrongVersion.actual_return
#audit_controller_proof SandboxModel.Stage1Protocol.Terminal.WrongVersion.refutes_full_contract
