import SandboxModel.Lifecycle.Protocol.InboxSessionsScan

/-! Full decoded-value contract for the extracted private Inbox candidate.
Production-to-candidate equivalence/adoption and concrete codec providers remain
separate obligations. This theorem does not assert durable acceptance. -/

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service
open sandproof_controller_service.capture
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_controller_service.controller.lifecycle_inbox.native_retirement
open sandproof_controller_service.controller.lifecycle_inbox.renewal_confirmation
open sandproof_controller_service.controller.lifecycle_inbox.unload_resolution
namespace SandboxModel.Stage1Protocol.InboxValidation
noncomputable section
open scoped Classical

theorem owners_result_spec (inbox : Inbox) :
    Inbox.validate_owners inbox = .ok (if OwnersValid inbox then .Ok () else .Err .CorruptStore) := by
  have acceptance := owners_accepts_iff inbox
  rw [owners_refines] at acceptance ⊢
  cases invalid : remainingOwnerInvalid inbox 0 <;> simp_all [RetiredIdentity.validationResult]

theorem inbox_refines {R T N U B : Type}
    (saved : RetirementEncoding R) (terminal : TerminalEncoding T)
    (renewal : RenewalEncoding N) (unload : UnloadEncoding U)
    (graphic : GraphicBytes B) (graphicLaw : ComposedConfig.FullGraphicContract graphic)
    (inbox : Inbox) (bounded : ConfigValidation.Representable inbox.config) :
    Inbox.validate_using saved terminal renewal unload graphic inbox =
      inboxView saved terminal renewal.encode unload.encode inbox := by
  unfold Inbox.validate_using inboxView
  rw [ComposedConfig.config_refines graphic graphicLaw inbox.config bounded]
  simp only [bind_tc_ok, decide_eq_true_eq]
  by_cases config : ConfigValidation.Valid inbox.config
  · simp only [config, ↓reduceIte, not_true_eq_false]
    simp only [lift, bind_tc_ok, alloc.vec.Vec.len_val,
      core.convert.num.FromUsizeU16.from_val_eq, UScalar.lt_equiv]
    by_cases sessionsBound : inbox.sessions.val.length > inbox.config.max_sessions.val
    · simp [sessionsBound, rejected]
    · simp only [sessionsBound, ↓reduceIte]
      by_cases ownersBound : inbox.owners.val.length > inbox.config.max_sessions.val
      · simp [ownersBound, rejected]
      · simp only [ownersBound, ↓reduceIte]
        rw [context_fields]
        simp only [bind_tc_ok, bne_iff_ne, ne_eq, UScalar.eq_equiv, alloc.vec.Vec.len_val,
          core.convert.num.FromUsizeU16.from_val_eq]
        by_cases laneCount : inbox.lanes.val.length ≠ inbox.config.max_sessions.val
        · simp [laneCount, rejected]
        · simp only [laneCount, ↓reduceIte]
          rw [lanes_invalid_refines]
          simp only [bind_assoc_eq]
          apply congrArg (fun continuation => Bind.bind (laneScan terminal.encode (decodedContext inbox.config) inbox.lanes.val 0) continuation)
          funext lanes
          cases lanes with
          | false => simp [rejected]
          | true =>
            simp only [bind_tc_ok, Bool.not_true, Bool.false_eq_true, ↓reduceIte]
            rw [RetiredIdentity.candidate_retired_contract]
            cases retired : RetiredIdentity.validationResult (RetiredIdentity.remainingConflict inbox 0) with
            | Err error =>
              simp [core.result.Result.Insts.CoreOpsTry.branch,
                core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]
            | Ok value =>
              cases value
              simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_tc_ok,
                core.option.Option.as_ref, SandproofFoundationsRust.core.option.Option.as_ref]
              rw [host_option]
              simp only [bind_tc_ok, decide_eq_true_eq]
              by_cases host : HostMatches inbox
              · simp only [host, not_true_eq_false, ↓reduceIte]
                rw [owners_result_spec]
                by_cases owners : OwnersValid inbox
                · simp only [owners, ↓reduceIte, not_true_eq_false, bind_tc_ok,
                    core.slice.Slice.iter,
                    core.iter.traits.iterator.Iterator.enumerate.trait_default,
                    core.iter.traits.iterator.Iterator.enumerate.default]
                  change sessionsLoop saved terminal renewal unload inbox (decodedContext inbox.config)
                    (RetiredIdentity.enumCursor (alloc.vec.Vec.deref inbox.sessions) 0#usize) = _
                  rw [sessions_loop_refines]
                  simp [alloc.vec.Vec.deref]
                · simp [owners, rejected,
                    core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]
              · simp [host, rejected]
  · simp [config, rejected]

/-- Candidate decoded-value adapter. Codec implementations and source-to-candidate
adoption remain named obligations; no wire/authentication/storage conclusion. -/
def runInbox (saved : RetirementEncoding Unit) (terminal : TerminalEncoding Unit)
    (renewal : InboxRenewal.Encoding) (unload : UnloadResolution.Encoding) (inbox : Inbox) : Check :=
  Inbox.validate_using saved terminal (N := Unit) ⟨renewal⟩ (U := Unit) ⟨unload⟩
    ComposedConfig.standardGraphic inbox

theorem full_inbox_contract : FullInboxContract runInbox := by
  intro saved terminal renewal unload inbox bounded
  exact inbox_refines saved terminal (N := Unit) ⟨renewal⟩ (U := Unit) ⟨unload⟩ ComposedConfig.standardGraphic
    ComposedConfig.standard_graphic_contract inbox bounded

end
end SandboxModel.Stage1Protocol.InboxValidation

#audit_controller_proof SandboxModel.Stage1Protocol.InboxValidation.owners_result_spec
#audit_controller_proof SandboxModel.Stage1Protocol.InboxValidation.inbox_refines
#audit_controller_proof SandboxModel.Stage1Protocol.InboxValidation.full_inbox_contract
