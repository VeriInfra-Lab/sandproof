import SandboxModel.Lifecycle.Protocol.InboxCompositionBoundaryValues
import SandboxModel.Lifecycle.Protocol.InboxWrongSessionLoops

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_controller_service.controller.lifecycle_inbox.native_retirement
namespace SandboxModel.Stage1Protocol.InboxValidation.WrongSession
noncomputable section
open scoped Classical

def run (saved : RetirementEncoding Unit) (terminal : TerminalEncoding Unit)
    (renewal : InboxRenewal.Encoding) (unload : UnloadResolution.Encoding) (inbox : Inbox) : Check :=
  Inbox.validate_using saved terminal (N := Unit) ⟨renewal⟩ (U := Unit) ⟨unload⟩
    ComposedConfig.standardGraphic inbox

theorem accepts_bad_session (saved : RetirementEncoding Unit) (terminal : TerminalEncoding Unit)
    (renewal : InboxRenewal.Encoding) (unload : UnloadResolution.Encoding)
    (inbox : Inbox) (bounded : ConfigValidation.Representable inbox.config)
    (valid : ConfigValidation.Valid inbox.config)
    (sessionsBound : ¬inbox.sessions.val.length > inbox.config.max_sessions.val)
    (ownersBound : ¬inbox.owners.val.length > inbox.config.max_sessions.val)
    (laneCount : ¬inbox.lanes.val.length ≠ inbox.config.max_sessions.val)
    (lanes : laneScan terminal.encode (decodedContext inbox.config) inbox.lanes.val 0 = .ok true)
    (retired : RetiredIdentity.remainingConflict inbox 0 = false)
    (host : HostMatches inbox) (owners : OwnersValid inbox)
    (scanned : sessionsLoop saved terminal (N := Unit) ⟨renewal⟩ (U := Unit) ⟨unload⟩ inbox
      (decodedContext inbox.config) (RetiredIdentity.enumCursor (alloc.vec.Vec.deref inbox.sessions) 0#usize) = .ok ()) :
    run saved terminal renewal unload inbox = .ok (.Ok ()) := by
  unfold run Inbox.validate_using
  rw [ComposedConfig.config_refines _ ComposedConfig.standard_graphic_contract inbox.config bounded]
  simp only [bind_tc_ok, decide_eq_true_eq, valid, ↓reduceIte,
    lift, alloc.vec.Vec.len_val, core.convert.num.FromUsizeU16.from_val_eq, UScalar.lt_equiv,
    sessionsBound, ownersBound]
  rw [context_fields]
  simp only [bind_tc_ok, bne_iff_ne, ne_eq, UScalar.eq_equiv, alloc.vec.Vec.len_val,
    core.convert.num.FromUsizeU16.from_val_eq, laneCount, ↓reduceIte]
  rw [lanes_invalid_refines, lanes]
  simp only [bind_tc_ok, Bool.not_true, Bool.false_eq_true, ↓reduceIte]
  rw [RetiredIdentity.candidate_retired_contract, retired]
  simp only [RetiredIdentity.validationResult, Bool.false_eq_true, ↓reduceIte,
    bind_tc_ok, core.result.Result.Insts.CoreOpsTry.branch,
    core.option.Option.as_ref, SandproofFoundationsRust.core.option.Option.as_ref]
  rw [host_option]
  simp only [bind_tc_ok, decide_eq_true_eq, host, not_true_eq_false, ↓reduceIte]
  rw [(owners_accepts_iff inbox).mpr owners]
  simp only [bind_tc_ok, core.slice.Slice.iter,
    core.iter.traits.iterator.Iterator.enumerate.trait_default,
    core.iter.traits.iterator.Iterator.enumerate.default]
  change (do
    let _ ← sessionsLoop saved terminal (N := Unit) ⟨renewal⟩ (U := Unit) ⟨unload⟩ inbox
      (decodedContext inbox.config) (RetiredIdentity.enumCursor (alloc.vec.Vec.deref inbox.sessions) 0#usize)
    (Result.ok (core.result.Result.Ok ()) : Check)) = _
  rw [scanned]
  simp only [bind_tc_ok]

theorem wrong_accepts (saved : RetirementEncoding Unit) (terminal : TerminalEncoding Unit)
    (renewal : InboxRenewal.Encoding) (unload : UnloadResolution.Encoding) :
    run saved terminal renewal unload Values.wrongCurrent = .ok (.Ok ()) := by
  apply accepts_bad_session saved terminal renewal unload Values.wrongCurrent Values.fixture_representable
  · exact ConfigValidation.Values.normal_valid _ (by simp [Values.wrongCurrent, Values.recorded, Values.normal])
  · decide
  · decide
  · decide
  · have successor : RetentionLane.successor 0#u64 = some 1#u64 := by decide
    simp [Values.wrongCurrent, Values.recorded, Values.normal, SessionShape.Values.vector,
      laneScan, RetentionLane.validateView, successor]
  · simp [RetiredIdentity.remainingConflict, RetiredIdentity.conflictAt,
      Values.wrongCurrent, Values.recorded, Values.normal, SessionShape.Values.vector]
  · simp [HostMatches, Values.wrongCurrent, Values.recorded, Values.normal]
  · exact Values.normal_owner_fields
  · exact rejected_session_ignored saved terminal renewal unload

theorem same_full_contract_rejected : ¬FullInboxContract run := by
  intro contract
  let renewal : InboxRenewal.Encoding := fun _ => .fail .panic
  let unload : UnloadResolution.Encoding := fun _ => .fail .panic
  have equality := contract SavedRetirement.Values.small SessionShape.Values.small renewal unload
    Values.wrongCurrent Values.fixture_representable
  rw [wrong_accepts,
    Values.wrong_current_model SavedRetirement.Values.small SessionShape.Values.small renewal unload] at equality
  simp [rejected] at equality

end
end SandboxModel.Stage1Protocol.InboxValidation.WrongSession

#audit_controller_proof SandboxModel.Stage1Protocol.InboxValidation.WrongSession.accepts_bad_session
#audit_controller_proof SandboxModel.Stage1Protocol.InboxValidation.WrongSession.wrong_accepts
#audit_controller_proof SandboxModel.Stage1Protocol.InboxValidation.WrongSession.same_full_contract_rejected
