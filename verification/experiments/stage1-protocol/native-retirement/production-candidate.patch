+struct StandardRetirementEncoding;
+impl RetirementEncoding for StandardRetirementEncoding {
+    fn encode_intent(
+        value: &sandproof_protocol::lifecycle::AcceptedLifecycleIntent,
+    ) -> Result<Vec<u8>, serde_json::Error> {
