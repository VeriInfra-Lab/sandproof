import SandboxModel.Lifecycle.Protocol.ManifestFilesValues
open Aeneas Aeneas.Std SandproofStage1ManifestRust
namespace SandboxModel.Stage1Protocol.ManifestFiles.Negative
open SandboxModel.Stage1Protocol.Manifest
open SandboxModel.Stage1Protocol.ManifestLoop
open SandboxModel.Stage1Protocol.ManifestFiles.Values

theorem mutant_accepts_foreign_disk :
    manifest_validate (manifestWith profile (filesWithDisk "foreign" "disk-0.img")) original profile =
      .ok (.Ok 3#u64) := by
  apply finish_after_headers
  change loop (fileBody (filesWithDisk "foreign" "disk-0.img")) (.Ok 2#u64, 2#usize) = .ok (.Ok 3#u64)
  refine loop_cont _ _ (.Ok 3#u64, 3#usize) _ ?_ ?_
  · have add_one : ((2#usize + 1#usize) : Result Usize) = .ok 3#usize :=
      add_exact _ _ _ (by scalar_tac)
    have checked : U64.checked_add 2#u64 1#u64 = some 3#u64 := by decide
    have difference : ((2#usize - 2#usize) : Result Usize) = .ok 0#usize :=
      sub_exact _ _ _ (by scalar_tac) (by scalar_tac)
    have length : sandproof_protocol.lifecycle.manifest.file_length
        ⟨.Disk "foreign", "disk-0.img", 1#u64, digest⟩ 2#usize profile = .ok (.Ok 1#u64) := by
      simp [sandproof_protocol.lifecycle.manifest.file_length, profile,
        alloc.vec.Vec.index, alloc.vec.Vec.from, Slice.index_usize, difference,
        sandproof_protocol.lifecycle.manifest.disk_bundle_path, literal_owned,
        core.option.Option.ok_or, core.result.Result.Insts.CoreOpsTry.branch,
        core.cmp.PartialEq.ne.trait_default, core.cmp.PartialEq.ne.default,
        sandproof_protocol.ResourceId.Insts.CoreCmpPartialEqResourceId.eq,
        alloc.string.String.Insts.CoreCmpPartialEqString.eq,
        SandproofFoundationsRust.alloc.string.String.Insts.CoreCmpPartialEqString.eq]
    simp only [profile, alloc.vec.Vec.from] at length
    simp [fileBody, sandproof_protocol.lifecycle.manifest.SnapshotManifest.validate_loop.body,
      filesWithDisk, alloc.vec.Vec.index, alloc.vec.Vec.from, alloc.vec.Vec.val, Slice.index_usize,
      core.result.Result.is_ok, profile, length, lift, checked, core.option.Option.ok_or, add_one]
  apply loop_done
  simp [fileBody, sandproof_protocol.lifecycle.manifest.SnapshotManifest.validate_loop.body,
    filesWithDisk]

theorem skipped_disk_id_not_files_contract : ¬ FilesContract manifest_validate := by
  intro contract
  have complete := (contract (manifestWith profile (filesWithDisk "foreign" "disk-0.img"))
    original profile 3#u64 mutant_accepts_foreign_disk).2.2
  have disk := complete.2 2 (by simp [manifestWith, filesWithDisk])
  simp [FileAt, manifestWith, filesWithDisk, profile] at disk
end SandboxModel.Stage1Protocol.ManifestFiles.Negative

#audit_controller_proof SandboxModel.Stage1Protocol.ManifestFiles.Negative.mutant_accepts_foreign_disk
#audit_controller_proof SandboxModel.Stage1Protocol.ManifestFiles.Negative.skipped_disk_id_not_files_contract
