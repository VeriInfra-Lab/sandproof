import SandboxModel.Boundaries.JsonRequest.SliceBinding
import SandboxModel.ProofAuditCommand

set_option autoImplicit false

open Aeneas Aeneas.Std SandproofFoundationsRust
open SandboxModel.Boundaries
namespace SandboxModel.Stage1Protocol.RoleLeaves

theorem session_refines {D E : Type}
    (provider : serde_core.de.Deserializer D E) (input : D) :
    protocol_leaves.session_decode provider input = JsonIdentifiers.actual .sandbox provider input := by
  unfold protocol_leaves.session_decode
    sandproof_protocol.lifecycle.identity.SessionId.Insts.Serde_coreDeDeserialize.deserialize
  have pass (r : core.result.Result String E) :
      core.result.Result.map
        (sandproof_protocol.lifecycle.identity.__1.DeserializeDeSessionId.deserialize.closure.Insts.CoreOpsFunctionFnOnceTupleSandboxIdSessionId provider)
        r () = .ok r := by
    cases r <;> simp [Aeneas.Std.core.result.Result.map, SandproofProtocolResultRust.core.result.Result.map,
      sandproof_protocol.lifecycle.identity.__1.DeserializeDeSessionId.deserialize.closure.Insts.CoreOpsFunctionFnOnceTupleSandboxIdSessionId.call_once]
  simp only [pass]
  change (JsonIdentifiers.actual .sandbox provider input >>= pure) = _
  exact bind_pure _


