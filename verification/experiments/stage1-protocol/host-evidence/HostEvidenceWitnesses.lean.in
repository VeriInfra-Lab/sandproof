#audit_controller_proof SandboxModel.Stage1Protocol.HostEvidence.sample_activate_domain
#audit_controller_proof SandboxModel.Stage1Protocol.HostEvidence.sample_seal_domain
#audit_controller_proof SandboxModel.Stage1Protocol.HostEvidence.malformed_prepare_domain
#audit_controller_proof SandboxModel.Stage1Protocol.HostEvidence.normal_prepare_accepted
#audit_controller_proof SandboxModel.Stage1Protocol.HostEvidence.normal_source_retained
#audit_controller_proof SandboxModel.Stage1Protocol.HostEvidence.normal_activate_source
#audit_controller_proof SandboxModel.Stage1Protocol.HostEvidence.normal_seal_projections
#audit_controller_proof SandboxModel.Stage1Protocol.HostEvidence.foreign_full_command_refused
#audit_controller_proof SandboxModel.Stage1Protocol.HostEvidence.independent_resource_refused
#audit_controller_proof SandboxModel.Stage1Protocol.HostEvidence.prepare_shape_does_not_validate_boot
