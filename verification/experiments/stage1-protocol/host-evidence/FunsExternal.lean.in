import SandproofHostEvidence.Types
import SandproofFoundations.IdentifierLibrary
open Aeneas Aeneas.Std
namespace SandproofHostEvidenceRust

def Bool.Insts.CoreCmpPartialEqBool.ne (left right : Bool) : Result Bool :=
  .ok (left != right)

def core.option.Option.Insts.CoreCmpPartialEqOption.eq {T : Type}
    (dictionary : core.cmp.PartialEq T T) (left right : Option T) : Result Bool :=
  match left, right with
  | none, none => .ok true
  | some left, some right => dictionary.eq left right
  | _, _ => .ok false

def core.str.Str.len (value : Str) : Result Usize :=
  .ok (Usize.ofNatCore value.val.length (by have := value.property; scalar_tac))

def core.str.Str.bytes (value : Str) : Result core.str.iter.Bytes :=
  .ok ⟨value.val⟩

def core.str.iter.Bytes.Insts.CoreIterTraitsIteratorIteratorU8.all {F : Type}
    (callback : core.ops.function.FnMut F U8 Bool)
    (bytes : core.str.iter.Bytes) (state : F) : Result (Bool × core.str.iter.Bytes) := do
  let (accepted, rest) ←
    SandproofFoundationsRust.IdentifierLibrary.allBytes callback.call_mut state bytes.remaining
  .ok (accepted, ⟨rest⟩)

def alloc.string.String.Insts.CoreCmpPartialEqString.eq
    (left right : String) : Result Bool := .ok (decide (left = right))

def alloc.string.String.Insts.CoreCloneClone.clone (value : String) : Result String :=
  .ok value

def alloc.string.String.Insts.CoreOpsDerefDerefStr.deref (value : String) : Result Str :=
  if h : SandproofFoundationsRust.IdentifierLibrary.StringRepresentable value then
    .ok (.from (SandproofFoundationsRust.IdentifierLibrary.stringBytes value) h)
  else .fail .maximumSizeExceeded

end SandproofHostEvidenceRust
