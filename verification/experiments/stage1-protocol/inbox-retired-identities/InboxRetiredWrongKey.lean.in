import SandboxModel.Lifecycle.Protocol.InboxRetiredWitnessSupport
import SandboxModel.Lifecycle.Protocol.InboxRetiredValues

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox.model
namespace SandboxModel.Stage1Protocol.RetiredIdentity.WrongKey
open Values
open scoped Classical
noncomputable section

theorem wrong_entry_hit :
    (session changedOwner).contains_entry_key intent.request.binding.key = .ok true := by
  unfold Session.contains_entry_key
  simp only [SharedAVec.Insts.CoreIterTraitsCollectIntoIteratorSharedATIter.into_iter,
    core.slice.Slice.iter, bind_tc_ok]
  unfold Session.contains_entry_key_loop
  rw [loop]
  simp [Session.contains_entry_key_loop.body, core.slice.iter.IteratorSliceIter.next,
    alloc.vec.Vec.deref, Slice.len, session, Values.singleton, entry, changedOwner, intent,
    EnvelopeValues.intent,
    sandproof_protocol.lifecycle.identity.RequestSequence.Insts.CoreCmpPartialEqRequestSequence.eq,
    sandproof_protocol.internal.PositiveCounter.Insts.CoreCmpPartialEqPositiveCounter.eq]

theorem wrong_current_hit :
    distinctKeys.current_identity_conflict intent.request.binding.session intent.request.binding.key = .ok true := by
  have entryHit := wrong_entry_hit
  simp only [session, Values.singleton, intent, EnvelopeValues.intent] at entryHit
  unfold Inbox.current_identity_conflict
  simp only [SharedAVec.Insts.CoreIterTraitsCollectIntoIteratorSharedATIter.into_iter,
    core.slice.Slice.iter, bind_tc_ok]
  unfold Inbox.current_identity_conflict_loop
  rw [loop]
  simp [Inbox.current_identity_conflict_loop.body, core.slice.iter.IteratorSliceIter.next,
    alloc.vec.Vec.deref, Slice.len, distinctKeys, base, Values.singleton, session_eq,
    entryHit, session, intent, EnvelopeValues.intent]

theorem actual_return : distinctKeys.validate_retired_identities = .ok (.Err .CorruptStore) := by
  let values := alloc.vec.Vec.deref distinctKeys.lanes
  have step : outerBody distinctKeys (enumCursor values 0#usize) = .ok (.done (.Err .CorruptStore)) := by
    unfold outerBody Inbox.validate_retired_identities_loop.body
    rw [enum_next_some values 0#usize 1#usize (by decide) (by rfl)]
    have selected : values.val[0] = lane retired := by rfl
    simp [selected, lane, retired, prior_empty_prefix]
    change (do
      let hit ← distinctKeys.current_identity_conflict intent.request.binding.session intent.request.binding.key
      if hit then .ok (.done (.Err .CorruptStore)) else .ok (.cont (enumCursor values 1#usize)) : Result (ControlFlow (EnumIter LifecycleRetentionLane) Return)) = _
    rw [wrong_current_hit]
    simp
  have completed := loop_done (outerBody distinctKeys) (enumCursor values 0#usize) _ step
  simpa [Inbox.validate_retired_identities, Inbox.validate_retired_identities_loop,
    core.slice.Slice.iter, core.iter.traits.iterator.Iterator.enumerate.trait_default,
    core.iter.traits.iterator.Iterator.enumerate.default, enumCursor, outerBody, values] using completed

theorem refutes_full_contract : ¬FullRetiredIdentityContract Inbox.validate_retired_identities := by
  intro contract
  have required := contract distinctKeys
  rw [actual_return, expected_outcomes.2.1] at required
  cases (Result.ok_injective required)

end
end SandboxModel.Stage1Protocol.RetiredIdentity.WrongKey

#audit_controller_proof SandboxModel.Stage1Protocol.RetiredIdentity.WrongKey.wrong_entry_hit
#audit_controller_proof SandboxModel.Stage1Protocol.RetiredIdentity.WrongKey.wrong_current_hit
#audit_controller_proof SandboxModel.Stage1Protocol.RetiredIdentity.WrongKey.actual_return
#audit_controller_proof SandboxModel.Stage1Protocol.RetiredIdentity.WrongKey.refutes_full_contract
