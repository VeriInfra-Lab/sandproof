def toStr (text : String)
    (bounded : text.toByteArray.size ≤ U32.max := by rw [U32.max_eq]; decide) : Str :=
  Aeneas.Std.toStr text bounded

def alloc.string.String.Insts.CoreCmpPartialEqString.eq
    (left right : String) : Result Bool := .ok (decide (left = right))

def sandbox_controller_core.model.EffectId.command
    [Representations]
    (self : sandbox_controller_core.model.EffectId) : Result sandbox_controller_core.model.Command
    := do
  ok self.logical.command

def P.Insts.CoreOpsFunctionFnOnceTupleCaptureHandoffOptionOriginalContinuation.call_once
    [Representations]
    (f : sandbox_controller_core.capture.CaptureHandoff →
      Result (Option sandbox_controller_core.capture.continuation.OriginalContinuation))
    (x : sandbox_controller_core.capture.CaptureHandoff) :
    Result (Option sandbox_controller_core.capture.continuation.OriginalContinuation) :=
  f x

def core.option.Option.is_some_and {T S : Type}
    (f : core.ops.function.FnOnce S T Bool) (x : Option T) (s : S) : Result Bool :=
  match x with
  | none => .ok false
  | some a => f.call_once s a

def core.option.Option.is_none_or {T S : Type}
    (f : core.ops.function.FnOnce S T Bool) (x : Option T) (s : S) : Result Bool :=
  match x with
  | none => .ok true
  | some a => f.call_once s a

def core.option.Option.and_then {T U F : Type}
    (f : core.ops.function.FnOnce F T (Option U)) (x : Option T) (s : F) : Result (Option U) :=
  match x with
  | none => .ok none
  | some a => f.call_once s a

def core.option.Option.Insts.CoreCmpPartialEqOption.eq {T : Type}
    (d : core.cmp.PartialEq T T) (x y : Option T) : Result Bool :=
  match x, y with
  | none, none => .ok true
  | some a, some b => d.eq a b
  | _, _ => .ok false

