import SandboxModel.Lifecycle.Protocol.ReadyCandidateModel
import SandboxModel.Lifecycle.Protocol.ReadyCandidateValues

open Aeneas Aeneas.Std SandproofReadyCandidateRust
open sandproof_controller_service.controller.lifecycle_inbox.readiness
namespace SandboxModel.Stage1Protocol.ReadyProbe
open scoped Classical
noncomputable section

theorem wrong_credential_accepts_missing : run missingCredential = .ok true := by
  simp [run, snapshot.ReadyCandidate.can_probe, missingCredential, sampleFive,
    core.option.Option.is_some, CreateReadiness.Insts.CoreCmpPartialEqCreateReadiness.eq,
    CreateReadiness.read_discriminant,
    CreateReadinessPending.Insts.CoreCmpPartialEqCreateReadinessPending.eq,
    CreateReadinessPending.read_discriminant]

theorem missing_rejected_by_unchanged_spec : ¬ ProbeEligible missingCredential := by
  simp [ProbeEligible, missingCredential]

theorem wrong_credential_refutes_full_contract : ¬ FullProbeContract run := by
  intro contract
  have checked := contract missingCredential
  rw [wrong_credential_accepts_missing] at checked
  simp [missing_rejected_by_unchanged_spec] at checked

end
end SandboxModel.Stage1Protocol.ReadyProbe
#audit_controller_proof SandboxModel.Stage1Protocol.ReadyProbe.wrong_credential_accepts_missing
#audit_controller_proof SandboxModel.Stage1Protocol.ReadyProbe.missing_rejected_by_unchanged_spec
#audit_controller_proof SandboxModel.Stage1Protocol.ReadyProbe.wrong_credential_refutes_full_contract
