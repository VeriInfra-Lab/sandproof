import SandboxModel.Lifecycle.Protocol.RequestValues
import SandboxModel.ProofAuditCommand
open Aeneas Aeneas.Std SandproofStage1RequestRust
namespace SandboxModel.Stage1Protocol.Request
theorem mutant_accepts_changed_capture :
    replay_matches (unload 2#u64) (unload 1#u64) = .ok true := by
  simp [unload, binding, replay_matches,
    sandproof_protocol.lifecycle.request.LifecycleRequest.replay_matches,
    sandproof_protocol.lifecycle.identity.OperationKey.Insts.CoreCmpPartialEqOperationKey.eq,
    sandproof_protocol.DeploymentId.Insts.CoreCmpPartialEqDeploymentId.eq,
    sandproof_protocol.TenantId.Insts.CoreCmpPartialEqTenantId.eq,
    sandproof_protocol.lifecycle.identity.RequestWindowId.Insts.CoreCmpPartialEqRequestWindowId.eq,
    sandproof_protocol.lifecycle.identity.RequestSequence.Insts.CoreCmpPartialEqRequestSequence.eq,
    sandproof_protocol.internal.PositiveCounter.Insts.CoreCmpPartialEqPositiveCounter.eq,
    alloc.string.String.Insts.CoreCmpPartialEqString.eq,
    SandproofFoundationsRust.alloc.string.String.Insts.CoreCmpPartialEqString.eq]
theorem mutant_not_full_replay_pair :
    ¬ ReplayPairContract replay_matches (unload 1#u64) (unload 2#u64) := by
  intro contract
  have refused := contract.2
  rw [mutant_accepts_changed_capture] at refused
  simp at refused
end SandboxModel.Stage1Protocol.Request
#audit_controller_proof SandboxModel.Stage1Protocol.Request.mutant_accepts_changed_capture
#audit_controller_proof SandboxModel.Stage1Protocol.Request.mutant_not_full_replay_pair
