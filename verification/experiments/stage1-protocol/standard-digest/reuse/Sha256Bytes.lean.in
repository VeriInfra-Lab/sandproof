import Std

/-! A pure byte-level SHA-256 specification candidate. No Rust or cryptographic
library correspondence is asserted here. The fixed concrete sha2 instance and
GenericArray conversion still need their explicit finite library contract.
The cryptographic normal domain is fewer than 2^64 input bits. -/
namespace SandboxModel.Stage1Protocol.Sha256Bytes

structure State where
  a : UInt32
  b : UInt32
  c : UInt32
  d : UInt32
  e : UInt32
  f : UInt32
  g : UInt32
  h : UInt32
  deriving DecidableEq

def initial : State :=
  ⟨0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
   0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19⟩

def roundConstants : Array UInt32 := #[
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
  0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
  0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
  0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
  0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
  0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

def rotateRight (x n : UInt32) : UInt32 :=
  (x >>> n) ||| (x <<< (32-n))

def smallZero (x : UInt32) : UInt32 :=
  rotateRight x 7 ^^^ rotateRight x 18 ^^^ (x >>> 3)

def smallOne (x : UInt32) : UInt32 :=
  rotateRight x 17 ^^^ rotateRight x 19 ^^^ (x >>> 10)

def largeZero (x : UInt32) : UInt32 :=
  rotateRight x 2 ^^^ rotateRight x 13 ^^^ rotateRight x 22

def largeOne (x : UInt32) : UInt32 :=
  rotateRight x 6 ^^^ rotateRight x 11 ^^^ rotateRight x 25

def choose (x y z : UInt32) : UInt32 :=
  (x &&& y) ^^^ ((~~~x) &&& z)

def majority (x y z : UInt32) : UInt32 :=
  (x &&& y) ^^^ (x &&& z) ^^^ (y &&& z)

def bigEndianWord (block : List UInt8) (index : Nat) : UInt32 :=
  ((block.getD (4*index) 0).toUInt32 <<< 24) |||
  ((block.getD (4*index+1) 0).toUInt32 <<< 16) |||
  ((block.getD (4*index+2) 0).toUInt32 <<< 8) |||
  (block.getD (4*index+3) 0).toUInt32

def schedule (block : List UInt8) : Array UInt32 :=
  let first := (List.range 16).toArray.map (bigEndianWord block)
  (List.range 48).foldl (fun words offset =>
    let index := offset+16
    words.push (smallOne (words.getD (index-2) 0) + words.getD (index-7) 0 +
      smallZero (words.getD (index-15) 0) + words.getD (index-16) 0)) first

def round (state : State) (constant word : UInt32) : State :=
  let first := state.h + largeOne state.e + choose state.e state.f state.g + constant + word
  let second := largeZero state.a + majority state.a state.b state.c
  ⟨first+second, state.a, state.b, state.c, state.d+first, state.e, state.f, state.g⟩

def addState (left right : State) : State :=
  ⟨left.a+right.a, left.b+right.b, left.c+right.c, left.d+right.d,
   left.e+right.e, left.f+right.f, left.g+right.g, left.h+right.h⟩

def compress (state : State) (block : List UInt8) : State :=
  let words := schedule block
  addState state ((List.range 64).foldl (fun current index =>
    round current (roundConstants.getD index 0) (words.getD index 0)) state)

def lengthBytes (byteCount : Nat) : List UInt8 :=
  (List.range 8).map (fun index =>
    UInt8.ofNat ((byteCount*8 / 2^(8*(7-index))) % 256))

def padded (input : List UInt8) : List UInt8 :=
  input ++ [128] ++ List.replicate ((119-input.length % 64) % 64) 0 ++ lengthBytes input.length

def process : Nat → List UInt8 → State → State
  | 0, _, state => state
  | count+1, input, state =>
    process count (input.drop 64) (compress state (input.take 64))

def wordBytes (word : UInt32) : List UInt8 :=
  [(word >>> 24).toUInt8, (word >>> 16).toUInt8, (word >>> 8).toUInt8, word.toUInt8]

def output (state : State) : List UInt8 :=
  wordBytes state.a ++ wordBytes state.b ++ wordBytes state.c ++ wordBytes state.d ++
  wordBytes state.e ++ wordBytes state.f ++ wordBytes state.g ++ wordBytes state.h

def digest (input : List UInt8) : List UInt8 :=
  let inputPadded := padded input
  output (process (inputPadded.length / 64) inputPadded initial)

def SupportedInput (input : List UInt8) : Prop := input.length < 2^61

end SandboxModel.Stage1Protocol.Sha256Bytes
