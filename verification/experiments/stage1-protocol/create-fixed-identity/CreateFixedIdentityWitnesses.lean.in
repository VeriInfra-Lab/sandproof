import SandboxModel.Lifecycle.Protocol.CreateFixedIdentity
import SandboxModel.Lifecycle.Protocol.CreateFixedIdentityValues
open Aeneas Aeneas.Std
namespace SandboxModel.Stage1Protocol.CreateFixedIdentity.Witnesses
open SandproofStage1CreateAttachmentRust
open Values SandproofFoundationsRust.IdentifierLibrary
abbrev run := sandproof_controller_service.controller.identity.sandbox_id

theorem normal_accepted : run normal 2#u64 = .ok (.Ok "sb-normal-2") := by
  simpa only [normal_expected] using identity_complete normal "normal" 2#u64
    normal_represented normal_output_representable

theorem empty_namespace_accepted : run empty 0#u64 = .ok (.Ok "sb--0") := by
  exact identity_complete empty "" 0#u64 rfl (by change 5 ≤ Usize.max; scalar_tac)

theorem all_numeric_bits_retained :
    run empty 18446744073709551615#u64 = .ok (.Ok "sb--18446744073709551615") := by
  exact identity_complete empty "" 18446744073709551615#u64 rfl
    (by change 24 ≤ Usize.max; scalar_tac)

theorem invalid_namespace_rejected :
    run invalid 2#u64 = .ok (.Err (.Contract .InvalidIdentifier)) := by
  simpa only [invalid_expected] using identity_complete invalid "bad space" 2#u64 rfl
    (by change 14 ≤ Usize.max; scalar_tac)

theorem unicode_namespace_rejected :
    run unicode 2#u64 = .ok (.Err (.Contract .InvalidIdentifier)) := by
  simpa only [unicode_expected] using identity_complete unicode "中文" 2#u64 rfl
    (by change 11 ≤ Usize.max; scalar_tac)

end SandboxModel.Stage1Protocol.CreateFixedIdentity.Witnesses
#audit_controller_proof SandboxModel.Stage1Protocol.CreateFixedIdentity.Witnesses.normal_accepted
#audit_controller_proof SandboxModel.Stage1Protocol.CreateFixedIdentity.Witnesses.empty_namespace_accepted
#audit_controller_proof SandboxModel.Stage1Protocol.CreateFixedIdentity.Witnesses.all_numeric_bits_retained
#audit_controller_proof SandboxModel.Stage1Protocol.CreateFixedIdentity.Witnesses.invalid_namespace_rejected
#audit_controller_proof SandboxModel.Stage1Protocol.CreateFixedIdentity.Witnesses.unicode_namespace_rejected
