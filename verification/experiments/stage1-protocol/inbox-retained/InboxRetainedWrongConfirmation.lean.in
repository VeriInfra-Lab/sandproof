import SandboxModel.Lifecycle.Protocol.InboxRetainedValues

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox
namespace SandboxModel.Stage1Protocol.InboxRetained.WrongConfirmation
open Values

theorem actual_return :
    renewal_confirmation.follows_retained pastConfirmation 1#u64 (renewal 5#u64 4#u64) = .ok true := by
  simp [renewal_confirmation.follows_retained, session, renewal, initial, checkpoint,
    pastConfirmation, EnvelopeValues.intent,
    core.option.Option.is_some_and, core.option.Option.as_ref,
    SandproofFoundationsRust.core.option.Option.is_some_and,
    SandproofFoundationsRust.core.option.Option.as_ref,
    renewal_confirmation.follows_retained.closure.Insts.CoreOpsFunctionFnOnceTupleU64Bool.call_once,
    renewal_confirmation.follows_retained.closure_1.Insts.CoreOpsFunctionFnOnceTupleSharedRenewalConfirmationBool.call_once]

theorem rejects_same_full_contract : ¬ FullRetainedContract renewal_confirmation.follows_retained := by
  intro contract
  have required := contract pastConfirmation 1#u64 (renewal 5#u64 4#u64)
  have rejected : expected pastConfirmation 1#u64 (renewal 5#u64 4#u64) = false := by decide
  rw [actual_return, rejected] at required
  cases (Result.ok_injective required)

end SandboxModel.Stage1Protocol.InboxRetained.WrongConfirmation

#audit_controller_proof SandboxModel.Stage1Protocol.InboxRetained.WrongConfirmation.actual_return
#audit_controller_proof SandboxModel.Stage1Protocol.InboxRetained.WrongConfirmation.rejects_same_full_contract
