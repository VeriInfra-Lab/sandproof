import SandboxModel.Lifecycle.Protocol.EnvelopeWriterWitnesses

set_option autoImplicit false
open Aeneas Aeneas.Std
open SandproofBoundedWriterRust
open sandproof_controller_service.template_registry.evidence
open SandboxModel.Boundaries.BoundedWriter
open SandboxModel.Boundaries.BoundedWriter.Refinement
open SandboxModel.Boundaries.BoundedWriter.Refinement.Examples
namespace SandboxModel.Stage1Protocol.EnvelopeWriter

/-- The changed Rust candidate returns the incomplete prefix after the real
write refuses allocation. Compilation or translation failure is not this fact. -/
theorem swallow_error_returns_truncated_prefix :
    encode_bounded_using (ordinaryOps true) (oneChunkSerializer true) oneByte 1#usize =
      .ok (.Ok emptyBuffer.bytes) := by
  have call := one_chunk_allocation_failure_call
  change (oneChunkSerializer true).serialize ⟨emptyBuffer, 1#usize, false⟩ oneByte =
    .ok (.Err ⟨7⟩, initial 1#usize) at call
  simp only [encode_bounded_using, ordinaryOps, bind_tc_ok, call]
  simp [finish_bounded, initial, core.result.Result.Insts.CoreOpsTry.branch]

theorem swallow_error_violates_same_full_contract :
    ¬EncoderContract (ordinaryOps true) ordinaryView (oneChunkSerializer true) Slice.val
      (encode_bounded_using (ordinaryOps true) (oneChunkSerializer true)) := by
  intro contract
  have required := contract.1 oneByte 1#usize emptyBuffer (.Err ⟨7⟩) (initial 1#usize)
    (.Ok emptyBuffer.bytes) rfl one_chunk_allocation_failure_call swallow_error_returns_truncated_prefix
  simp [finishedView, finishSpec, writerView, initial, serializationView] at required

end SandboxModel.Stage1Protocol.EnvelopeWriter

#audit_controller_proof SandboxModel.Stage1Protocol.EnvelopeWriter.swallow_error_returns_truncated_prefix
#audit_controller_proof SandboxModel.Stage1Protocol.EnvelopeWriter.swallow_error_violates_same_full_contract
