import SandboxModel.Lifecycle.Protocol.Sha256Bytes
import SandboxModel.ProofAuditCommand

/-! Isolated proof trials only until original kernel/service/dependency checks.
These do not prove any Rust implementation or actual crypto-library conformance. -/
namespace SandboxModel.Stage1Protocol.Sha256Bytes

theorem output_length (state : State) : (output state).length = 32 := by
  simp [output, wordBytes]

theorem complete_digest_length (input : List UInt8) : (digest input).length = 32 := by
  exact output_length _

theorem empty_supported : SupportedInput [] := by unfold SupportedInput; decide

theorem abc_supported : SupportedInput [97, 98, 99] := by unfold SupportedInput; decide

theorem empty_known_value : digest [] = [
    0xe3, 0xb0, 0xc4, 0x42, 0x98, 0xfc, 0x1c, 0x14,
    0x9a, 0xfb, 0xf4, 0xc8, 0x99, 0x6f, 0xb9, 0x24,
    0x27, 0xae, 0x41, 0xe4, 0x64, 0x9b, 0x93, 0x4c,
    0xa4, 0x95, 0x99, 0x1b, 0x78, 0x52, 0xb8, 0x55] := by decide +kernel

theorem abc_known_value : digest [97, 98, 99] = [
    0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
    0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
    0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,
    0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad] := by decide +kernel

end SandboxModel.Stage1Protocol.Sha256Bytes
#audit_controller_proof SandboxModel.Stage1Protocol.Sha256Bytes.output_length
#audit_controller_proof SandboxModel.Stage1Protocol.Sha256Bytes.complete_digest_length
#audit_controller_proof SandboxModel.Stage1Protocol.Sha256Bytes.empty_supported
#audit_controller_proof SandboxModel.Stage1Protocol.Sha256Bytes.abc_supported
#audit_controller_proof SandboxModel.Stage1Protocol.Sha256Bytes.empty_known_value
#audit_controller_proof SandboxModel.Stage1Protocol.Sha256Bytes.abc_known_value
