import SandboxModel.Lifecycle.Protocol.DigestUsesModel
open Aeneas Aeneas.Std
namespace SandboxModel.Stage1Protocol.DigestUses.Values

def empty : Slice U8 := Slice.from [] (by simp)
def abc : Slice U8 := Slice.from [97#u8, 98#u8, 99#u8] (by change 3 ≤ Usize.max; scalar_tac)

theorem empty_normal : Normal empty :=
  DigestByteBridge.supported_of_input_bound _ (by simp only [empty, Slice.from_val, List.length_nil]; decide)

theorem abc_normal : Normal abc :=
  DigestByteBridge.supported_of_input_bound _ (by simp only [abc, Slice.from_val, List.length_nil, List.length_cons]; decide)

theorem abc_full_payload :
    (SandproofFoundationsRust.IdentifierLibrary.byteArray (expected abc).val).toList = [
      0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
      0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
      0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,
      0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad] := by
  have source : DigestByteBridge.inputBytes abc = [97, 98, 99] := by
    simp [DigestByteBridge.input_bytes_exact, abc]
  rw [DigestByteBridge.reference_output_complete, source]
  exact Sha256Bytes.abc_known_value

theorem empty_full_payload :
    (SandproofFoundationsRust.IdentifierLibrary.byteArray (expected empty).val).toList = [
      0xe3, 0xb0, 0xc4, 0x42, 0x98, 0xfc, 0x1c, 0x14,
      0x9a, 0xfb, 0xf4, 0xc8, 0x99, 0x6f, 0xb9, 0x24,
      0x27, 0xae, 0x41, 0xe4, 0x64, 0x9b, 0x93, 0x4c,
      0xa4, 0x95, 0x99, 0x1b, 0x78, 0x52, 0xb8, 0x55] := by
  have source : DigestByteBridge.inputBytes empty = [] := by
    simp [DigestByteBridge.input_bytes_exact, empty]
  rw [DigestByteBridge.reference_output_complete, source]
  exact Sha256Bytes.empty_known_value

end SandboxModel.Stage1Protocol.DigestUses.Values
#audit_controller_proof SandboxModel.Stage1Protocol.DigestUses.Values.empty_normal
#audit_controller_proof SandboxModel.Stage1Protocol.DigestUses.Values.abc_normal
#audit_controller_proof SandboxModel.Stage1Protocol.DigestUses.Values.abc_full_payload
#audit_controller_proof SandboxModel.Stage1Protocol.DigestUses.Values.empty_full_payload
