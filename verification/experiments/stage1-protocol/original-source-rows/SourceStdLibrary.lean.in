import SourceStdTypes
import SandproofFoundations.IdentifierLibrary

/-!
Unchecked candidate bindings for the exact C17 Std surface. Library agreement
remains the registered A6 condition. These are library operations, not identity
construction business functions. Import no prior generated Funs/World.
Formatting is restricted to the four actual Arguments::new programs in C17.
It invokes each supplied callback in order, retains its formatter and failure,
and does not promise allocation success, physical cleanup or arbitrary formats.
-/
open Aeneas Aeneas.Std
namespace SandproofOriginalSourceRowsRust
open SandproofFoundationsRust.IdentifierLibrary

def toStr (text : String)
    (bounded : text.toByteArray.size ≤ U32.max := by rw [U32.max_eq]; decide) : Str :=
  Aeneas.Std.toStr text bounded

-- Identical finite definitions already used by Network, Storage and LoadBlob.
def Bool.Insts.CoreCmpPartialEqBool.ne (left right : Bool) : Result Bool :=
  .ok (left != right)

def core.hint.must_use {T : Type} (value : T) : Result T := .ok value

def core.option.Option.Insts.CoreCloneClone.clone {T : Type}
    (dictionary : core.clone.Clone T) (value : Option T) : Result (Option T) :=
  match value with
  | none => .ok none
  | some item => do
      let copied ← dictionary.clone item
      .ok (some copied)

def core.option.Option.Insts.CoreCmpPartialEqOption.eq {T : Type}
    (dictionary : core.cmp.PartialEq T T) (left right : Option T) : Result Bool :=
  match left, right with
  | none, none => .ok true
  | some left, some right => dictionary.eq left right
  | _, _ => .ok false

def alloc.string.String.Insts.CoreCmpPartialEqString.eq
    (left right : String) : Result Bool := .ok (decide (left = right))

def alloc.string.String.Insts.CoreCloneClone.clone (value : String) : Result String :=
  .ok value

def alloc.string.String.Insts.CoreOpsDerefDerefStr.deref (value : String) : Result Str :=
  if h : StringRepresentable value then .ok (.from (stringBytes value) h)
  else .fail .maximumSizeExceeded

def alloc.string.String.is_empty (value : String) : Result Bool := do
  let text ← alloc.string.String.Insts.CoreOpsDerefDerefStr.deref value
  .ok (decide (text.val.length = 0))

-- Same default String sink and callback carriers as Foundations, with no
-- import of its generated business type universe.
def Shared0T.Insts.CoreFmtDisplay.fmt {T : Type}
    (display : core.fmt.Display T) (value : T) (formatter : core.fmt.Formatter) :=
  display.fmt value formatter

def Str.Insts.CoreFmtDisplay.fmt (value : Str) (formatter : core.fmt.Formatter) :
    Result (core.result.Result Unit core.fmt.Error × core.fmt.Formatter) :=
  match decodeString value.val with
  | some text => .ok (.Ok (), ⟨formatter.output ++ text⟩)
  | none => .fail .panic

def core.fmt.num.imp.DisplayU64.fmt (value : U64) (formatter : core.fmt.Formatter) :
    Result (core.result.Result Unit core.fmt.Error × core.fmt.Formatter) :=
  .ok (.Ok (), ⟨formatter.output ++ toString value.val⟩)

def core.fmt.rt.Argument.new_display {T : Type}
    (display : core.fmt.Display T) (value : T) : Result core.fmt.rt.Argument :=
  .ok ⟨display.fmt value⟩

def core.fmt.Arguments.new {N M : Usize}
    (bytes : Aeneas.Std.Array U8 N)
    (arguments : Aeneas.Std.Array core.fmt.rt.Argument M) : Result core.fmt.Arguments :=
  .ok ⟨bytes.val, arguments.val⟩

def renderFirst (argument : core.fmt.rt.Argument) (initial : String) :
    Result core.fmt.Formatter := do
  let (reply, after) ← argument.render ⟨initial⟩
  match reply with
  | .Err _ => .fail .panic
  | .Ok () => .ok after

def renderAfter (argument : core.fmt.rt.Argument)
    (previous : core.fmt.Formatter) : Result core.fmt.Formatter :=
  renderFirst argument (previous.output ++ "-")

def alloc.fmt.format (arguments : core.fmt.Arguments) : Result String := do
  let program := arguments.bytecode.map (·.val)
  if program = [192, 1, 45, 192, 1, 45, 192, 0] then
    match arguments.arguments with
    | [first, second, third] =>
        let a ← renderFirst first ""
        let b ← renderAfter second a
        let c ← renderAfter third b
        .ok c.output
    | _ => .fail .panic
  else if program = [7, 116, 101, 110, 97, 110, 116, 45, 192, 0] then
    match arguments.arguments with
    | [first] =>
        let a ← renderFirst first "tenant-"
        .ok a.output
    | _ => .fail .panic
  else if program = [3, 111, 112, 45, 192, 1, 45, 192, 1, 45, 192, 0] then
    match arguments.arguments with
    | [first, second, third] =>
        let a ← renderFirst first "op-"
        let b ← renderAfter second a
        let c ← renderAfter third b
        .ok c.output
    | _ => .fail .panic
  else if program = [3, 115, 98, 45, 192, 1, 45, 192, 0] then
    match arguments.arguments with
    | [first, second] =>
        let a ← renderFirst first "sb-"
        let b ← renderAfter second a
        .ok b.output
    | _ => .fail .panic
  else .fail .panic

end SandproofOriginalSourceRowsRust
