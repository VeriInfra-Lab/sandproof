name = "sandbox-model"
version = "0.1.0"
defaultTargets = ["SourceRowEvidence", "SourceCompleteEvidence", "SourceObservedRows"]

[[lean_lib]]
name = "SandboxModel"

[[lean_lib]]
name = "SandproofFoundations"
srcDir = "verification/aeneas/foundations"

[[require]]
name = "aeneas"
git = { url = "https://github.com/AeneasVerif/aeneas", subDir = "backends/lean" }
rev = "505b6ca35217e7be5c96c3e2f8045edfbdf47291"

[[lean_lib]]
name = "SandproofSqliteStatements"
srcDir = "verification/aeneas/sqlite-statements"

[[lean_lib]]
name = "SandproofSqlite"
srcDir = "verification/aeneas/sqlite"

[[lean_lib]]
name = "SourceStdTypes"
srcDir = "."
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "SourceStdLibrary"
srcDir = "."
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "SourceOptionResult"
srcDir = "."
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "SourceIdentifierFormula"
srcDir = "."
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "OriginalRowsDriver"
srcDir = "."
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "OriginalSourceSqliteOps"
srcDir = "."
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "SandproofOriginalSourceRows"
srcDir = "verification/aeneas/original-source-rows"
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "SandproofSqliteSession"
srcDir = "verification/aeneas/create-transaction-link"
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "SandproofLoadBlob"
srcDir = "verification/aeneas/create-transaction-link"
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "SourceAgreement"
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "SourceUsingSuccess"
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "OriginalRowsInvariant"
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "SourceUsingRowInvariant"
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "SourceDriverPrefix"
leanOptions = { weak.linter.style.nameCheck = false }

[[lean_lib]]
name = "SourceRowSlots"

[[lean_lib]]
name = "SourceRowEvidence"

[[lean_lib]]
name = "SourceCompleteEvidence"

[[lean_lib]]
name = "SourceObservedRows"
