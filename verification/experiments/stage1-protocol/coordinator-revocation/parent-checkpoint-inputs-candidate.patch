diff --git a/verification/experiments/stage1-protocol/test_registered.py b/verification/experiments/stage1-protocol/test_registered.py
index 440d25aa..eeeb06c4 100644
--- a/verification/experiments/stage1-protocol/test_registered.py
+++ b/verification/experiments/stage1-protocol/test_registered.py
@@ -736,6 +736,47 @@ class Registration(OriginalReadPlanFixture):
                 with self.assertRaisesRegex(ValueError, 'concrete decoder page'):
                     codec.check_page(root, row)

+    def test_coordinator_checkpoint_requires_the_original_parent_capture(self):
+        checker = registered.UNLOAD.journal_component(registered.ROOT, 'parent_checkpoint')
+        root = registered.ROOT
+        head, tree = registered.subprocess.check_output(
+            ['git', 'rev-parse', 'HEAD', 'HEAD^{tree}'], cwd=root, text=True).splitlines()
+        result = dict(original=checker.BASE, candidate=head, tree=tree)
+        job = dict(name='coordinator-revocation')
+        with tempfile.TemporaryDirectory() as directory:
+            folder = Path(directory)
+            helper = SimpleNamespace(evidence_files=lambda *args, **kwargs: {})
+            with self.assertRaisesRegex(ValueError, 'missing coordinator parent capture: original'):
+                registered._checkpoint_evidence(helper, job, result, folder/'result.json', folder/'command.log')
+            with self.assertRaisesRegex(ValueError, 'coordinator checkpoint source differs'):
+                checker.check_parent_evidence(root, folder, dict(result, original='unrelated'), {})
+
+    def test_parent_declarations_must_carry_their_complete_original_rust_files(self):
+        root = registered.ROOT
+        checker = registered.UNLOAD.journal_component(root, 'parent_checkpoint')
+        methods = [(checker.PARENT, checker.CALLER),
+                   (checker.ONE, Path('controller-service/src/application/coordinator.rs'))]
+        files = []
+        functions = {}
+        for index, (method, path) in enumerate(methods):
+            name = [{'Impl': {}} if piece == '{impl}' else {'Ident': [piece, 0]} for piece in method.split('::')]
+            span = {'Untagged': {'data': {'file_id': index}}}
+            functions[index] = {'item_meta': {'name': name, 'span': span}}
+            files.append({'name': {'Local': str(path)}, 'contents': (root/path).read_text()})
+        view = SimpleNamespace(functions=functions, data={'files': files})
+
+        def sources():
+            return checker.parent_sources(view, lambda path: (root/path).read_bytes())
+
+        self.assertEqual(sources(), dict(caller=registered._sha(root/methods[0][1]),
+                                         coordinator=registered._sha(root/methods[1][1])))
+        for index, (_, path) in enumerate(methods):
+            for edit in ({'contents': None}, {'contents': files[index]['contents'][:-1]},
+                         {'name': files[1-index]['name']}):
+                with self.subTest(path=path, edit=next(iter(edit))), patch.dict(files[index], edit):
+                    with self.assertRaisesRegex(ValueError, 'coordinator declaration source differs'):
+                        sources()
+
     def test_public_journal_refuses_old_receipt_and_missing_generated_body(self):
         with self.assertRaisesRegex(ValueError, 'journal entry evidence'):
             registered._coordinator_entry({'candidate_parent': {}})
