import SandboxModel.Lifecycle.Protocol.InboxAppendSelections

open Aeneas Aeneas.Std
open SandboxModel.Stage1Protocol SandproofParentCommitRust.ErrorTransport
open SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.model (Session)
namespace SandproofActualRecordRust.PublicUnload
open controller.lifecycle_inbox recording PublicBegin PublicReplay SourceFlowLink
open InboxAppend
noncomputable section
set_option autoImplicit false

/-- All fields of the newly appended nonterminal entry as read by the recording body. -/
def appendedState (session : Session) (intent : Intent) : model.LifecycleWorkState :=
  InboxState.workState {session with current_version := intent.accepted_version, terminal := false}
    (InboxRecord.pendingEntry intent)

theorem append_current (inbox : model.Inbox) (intent : Intent) (s : Usize)
    (selected : ExistingSelection inbox intent s)
    (accepted : existingDecision inbox (inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)) intent =
      .append false) :
    ∃ (next : model.Inbox) (e : Usize), inbox.record intent = .ok (.Ok (s,e), next) ∧
      next.state s e = .ok (appendedState (inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)) intent) := by
  have bound := selected_bound inbox intent s selected
  let session := inbox.sessions.val[s.val]'bound
  obtain ⟨out, recorded, post⟩ := WP.spec_imp_exists (record_existing_contract inbox intent s selected)
  rw [accepted] at post
  obtain ⟨entries, e, contents, position, rfl⟩ := post
  let updated := appendedSession session intent false entries
  let next := replaceSession inbox s updated
  have hs : next.sessions.val[s.val]? = some updated := by simp [next, replaceSession, bound]
  have he : updated.entries.val[e.val]? = some (InboxRecord.pendingEntry intent) := by
    simp [updated, appendedSession, contents, position, session]
  obtain ⟨sb, sameSession⟩ := List.getElem?_eq_some_iff.mp hs
  obtain ⟨eb, sameEntry⟩ := List.getElem?_eq_some_iff.mp he
  refine ⟨next, e, recorded, ?_⟩
  rw [InboxState.state_contract next s e sb (by simpa only [sameSession] using eb)]
  simp only [sameSession, sameEntry]
  rfl

open SandproofParentCommitRust.ActualCalls (Owner Raw)

/-- Only the observed prefix of the four concrete V5 calls is required. -/
def FirstValidationError (owner : Owner) (raw : Raw) (world : SandproofParentCommitRust.World)
    (error : ParentError) : Prop :=
  let candidate := fromRequestResult (raw.conn.v5.candidate raw.conn.base world)
  let inbox := fromRequestResult (raw.conn.v5.inbox raw.conn.base world)
  let capacity := fromRequestResult (raw.conn.v5.capacity raw.conn.base world)
  let transaction := fromRequestResult
    (raw.conn.v5.transaction (SandproofParentCommitRust.CurrentViews.ownerToSource owner))
  let ok : Result (ParentRustResult Unit) := .ok (.Ok ())
  let failed : Result (ParentRustResult Unit) := .ok (.Err error)
  candidate = failed ∨ (candidate = ok ∧
    (inbox = failed ∨ (inbox = ok ∧ (capacity = failed ∨ (capacity = ok ∧ transaction = failed)))))

open SandproofParentCommitRust in
/-- The first concrete validator refusal on this raw transaction ends the saved
owner's actual commit. There is no premise about subsequent calls or the finisher. -/
theorem commit_validation_error (owner : Owner) (raw : Raw) (world : World) (error : ParentError)
    (live : owner.transaction = some raw)
    (present : SandboxModel.InboxTransaction.CurrentWorldRead.CandidateAt (CurrentViews.ownerToRead owner) world)
    (refused : FirstValidationError owner raw world error) :
    SandproofParentCommitRust.controller.transaction.WorldTransaction.commit owner = .ok (.Err error) := by
  have rawReturned : CurrentViews.liveRaw owner = .ok raw := by
    simp only [CurrentViews.liveRaw, SandproofParentReadRust.core.option.Option.as_ref, live, bind_tc_ok,
      core.option.Option.expect, Result.ofOption]
  have worldReturned := SandboxModel.InboxTransaction.CurrentWorldRead.world_from_same_candidate
    (CurrentViews.ownerToRead owner) world present
  have candidate := ActualCalls.candidate_complete_call owner
  have inbox := ActualCalls.inbox_complete_call owner
  have capacity := ActualCalls.capacity_complete_call owner
  have transaction := ActualCalls.transaction_complete_original_owner owner
  simp only [rawReturned, worldReturned, bind_tc_ok] at candidate inbox capacity transaction
  rw [ParentOrder.actual_complete_first_error_order]
  rcases refused with h | ⟨a, h | ⟨b, h | ⟨c, h⟩⟩⟩ <;>
    simp [CommitOrder.orderView, CommitOrder.continueAfter, *]

variable [env : PublicCalls] [SandproofStandardRecordCodec.DecodeCalls]

abbrev originalSave (inbox : model.Inbox) (before : StandardRecord Unit) :=
  SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.codec.save_using
    (oldRetirement retirement) (oldTerminal terminal) (oldRenewal renewal) (oldUnload unload)
    (oldGraphic graphic) (ScopeTransport.recordEffects reads).codecInboxSaveEffectsInst inbox before

local notation "sourceRecord" =>
  SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.recording.record_using
local notation "admits" =>
  SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.authenticated

/-- The Unload miss bypasses both Destroy-only helpers. The complete new inbox and
the holder returned by the loader are the two operands of the original save. -/
theorem record_after_save (begun : SandproofUnloadWorldBegin.controller.transaction.WorldTransaction)
    (ns : Str) (intent : Intent) (context : Context) (inbox next : model.Inbox)
    (afterLoad afterSave : StandardRecord Unit) (s e : Usize) (value : model.LifecycleWorkState)
    (loaded : PublicLoaded.originalLoad begun ns = .ok (.Ok (some inbox), afterLoad))
    (admitted : admits inbox intent context = .ok (.Ok ()))
    (absent : inbox.find intent = .ok (.Ok none))
    (op : ∃ source capture, intent.request.operation = .Unload source capture)
    (appended : inbox.record intent = .ok (.Ok (s,e), next))
    (read : next.state s e = .ok value)
    (reply : core.result.Result Unit JournalError)
    (saved : originalSave next afterLoad = .ok (toRequestRustResult reply, afterSave)) :
    record_using retirement terminal renewal unload graphic reads (holder begun ns) intent context =
      .ok ((match reply with | .Ok () => .Ok (.Recorded value) | .Err error => .Err error), afterSave) := by
  obtain ⟨source, capture, operation⟩ := op
  change liftResult transferOutcome (sourceRecord (oldRetirement retirement) (oldTerminal terminal)
    (oldRenewal renewal) (oldUnload unload) (oldGraphic graphic) (ScopeTransport.recordEffects reads)
    (holder begun ns) intent context) = _
  unfold SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.recording.record_using
  unfold PublicLoaded.originalLoad JournalLoadExit.originalLoad JournalLoadExit.sourceIO at loaded
  simp only [reads]
  rw [loaded]
  unfold originalSave reads at saved
  cases reply <;> simp [admitted, absent, appended, read, operation, saved, liftResult, transferOutcome,
    convertOutcome, ScopeTransport.outcomeFromSource, toRequestRustResult, core.option.Option.ok_or,
    core.result.Result.Insts.CoreOpsTry.branch, core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual,
    SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.recording.guard_destroy,
    SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.recording.attach_destroy]

abbrev saveValidation (inbox : model.Inbox) :=
  SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.model.Inbox.validate_using
    (oldRetirement retirement) (oldTerminal terminal) (oldRenewal renewal) (oldUnload unload) (oldGraphic graphic) inbox

abbrev saveEffects := (ScopeTransport.recordEffects reads).codecInboxSaveEffectsInst

/-- The save encoder borrows the live connection of this holder, supplies the complete
inbox, maps the JSON reply, and returns the same public standard holder. -/
theorem save_encode_returned (before : StandardRecord Unit) (inbox : model.Inbox)
    (raw : IOOwnerTransport.ParentRaw) (slot : before.tx.parent.transaction = some raw)
    (reply : SandboxModel.StandardRecordCodec.JsonReply (alloc.vec.Vec U8))
    (returned : env.encodeInbox () raw.conn.base inbox = .ok (reply, ())) :
    saveEffects.encode before inbox = .ok (SandboxModel.StandardRecordCodec.mapJson reply, before) := by
  have live : (IOOwnerTransport.toSource before).tx.transaction =
      some (SandproofParentCommitRust.CurrentViews.rawToSource raw) := by
    simp [IOOwnerTransport.toSource, SandproofParentCommitRust.CurrentViews.ownerToSource, slot]
  have ran := SandboxModel.StandardRecordCodec.actual_encode_for_save_returned_state
    (IOOwnerTransport.codecToSource codec) (IOOwnerTransport.toSource before) inbox
    (SandproofParentCommitRust.CurrentViews.rawToSource raw) reply () live returned
  change toRequestStateResult (IOOwnerTransport.liftReply before _) = _
  rw [ran]
  have holder : {IOOwnerTransport.toSource before with codec := ()} = IOOwnerTransport.toSource before := rfl
  simp [holder, IOOwnerTransport.liftReply, JournalHeaderReads.returned_borrowed_holder,
    toRequestStateResult, liftResult]

/-- A failed validation returns the incoming holder. After a successful validation,
both kinds of encoding refusal return before digest or update. -/
theorem save_encoding_refusals (inbox : model.Inbox) (before : StandardRecord Unit) :
    (∀ err, saveValidation inbox = .ok (.Err err) → originalSave inbox before = .ok (.Err err, before)) ∧
    (saveValidation inbox = .ok (.Ok ()) →
      ∀ raw : IOOwnerTransport.ParentRaw, before.tx.parent.transaction = some raw →
        (∀ err, env.encodeInbox () raw.conn.base inbox = .ok (.Err err, ()) →
          originalSave inbox before = .ok (.Err (.Json err), before)) ∧
        (∀ bytes, env.encodeInbox () raw.conn.base inbox = .ok (.Ok bytes, ()) →
          ConfigBudget.bytes inbox.config < bytes.val.length →
          originalSave inbox before = .ok (.Err .MaintenanceCapacity, before))) := by
  constructor
  · intro err refused
    unfold originalSave SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.codec.save_using
    unfold saveValidation at refused
    simp [refused, core.result.Result.Insts.CoreOpsTry.branch,
      core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]
  · intro checked raw slot
    have encoded := save_encode_returned before inbox raw slot
    unfold saveValidation at checked
    unfold originalSave SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.codec.save_using
    constructor
    · intro err failed
      have reply := encoded (.Err err) failed
      unfold saveEffects at reply
      simp [checked, core.result.Result.Insts.CoreOpsTry.branch, reply, SandboxModel.StandardRecordCodec.mapJson,
        core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]
    · intro bytes returned over
      have reply := encoded (.Ok bytes) returned
      unfold saveEffects at reply
      obtain ⟨budget, cost, exactCost⟩ := ConfigBudget.required_bytes_refines inbox.config
      simp [checked, core.result.Result.Insts.CoreOpsTry.branch, reply, SandboxModel.StandardRecordCodec.mapJson,
        lift, cost, UScalar.lt_equiv, exactCost, over]

variable [FileHandle] (journal : controller.ControllerJournal) (intent : Intent) (context : Context)
    (begun : SandproofUnloadWorldBegin.controller.transaction.WorldTransaction)
    (after : UnloadWorldBegin.Conn) (ns : Str)
    (started : UnloadWorldBegin.begin (initial journal) journal.committed_world = .ok (.Ok begun, after))
    (borrowed : alloc.string.String.Insts.CoreOpsDerefDerefStr.deref journal.«namespace» = .ok ns)

include started borrowed
/-- The standard dictionary consumes exactly the owner returned by the save. Both NeverCrash
calls succeed at the real points. A commit error reaches the public journal with its payload. -/
theorem commit_reply (afterSave : StandardRecord Unit) (value : model.LifecycleWorkState)
    (recorded : record_using retirement terminal renewal unload graphic reads (holder begun ns) intent context =
      .ok (.Ok (.Recorded value), afterSave))
    (reply : core.result.Result Unit JournalError)
    (committed : SandproofParentCommitRust.controller.transaction.WorldTransaction.commit afterSave.tx.parent =
      .ok reply) :
    proof_public_journal hook journal intent context () =
      .ok ((match reply with | .Ok () => .Ok value | .Err error => .Err error),
        {journal with journal := ⟨after.base⟩}, ()) := by
  apply started_reply hook journal intent context () begun after ns started borrowed
  rw [CallerBranches.extraction_root_uses_real_constructor_and_dictionary]
  have boundCommit : (CallerBranches.actualEffects codec).commit afterSave = .ok reply := by
    rwa [CallerBranches.actual_standard_record_uses_original_commit]
  cases reply with
  | Ok result =>
    cases result
    exact CallerBranches.actual_recorded_success retirement terminal renewal unload graphic _ hook
      (holder begun ns) afterSave intent context () () () value recorded
      (hook_return () .BeforeCommit) boundCommit (hook_return () .AfterCommit)
  | Err error =>
    exact CallerBranches.actual_recorded_commit_error retirement terminal renewal unload graphic _ hook
      (holder begun ns) afterSave intent context () () value error recorded
      (hook_return () .BeforeCommit) boundCommit

/-- A fresh Unload that passes the existing-session guards supplies the new current bit
and the old session's actual mapping. Save refusal needs no commit observation. -/
theorem fresh_unload (inbox : model.Inbox) (afterLoad : StandardRecord Unit) (s : Usize)
    (loaded : PublicLoaded.originalLoad begun ns = .ok (.Ok (some inbox), afterLoad))
    (config : InboxAdmission.ContextMatches inbox context) (valid : Validation.ValidEnvelope intent context)
    (op : ∃ source capture, intent.request.operation = .Unload source capture)
    (selected : ExistingSelection inbox intent s)
    (accept : existingDecision inbox (inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)) intent =
      .append false) :
    let session := inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)
    let value := appendedState session intent
    let returned := {journal with journal := ⟨after.base⟩}
    let run := journalDecision journal intent context
    ∃ (next : model.Inbox) (e : Usize), inbox.record intent = .ok (.Ok (s,e), next) ∧
      next.state s e = .ok value ∧
      (∀ afterSave error, originalSave next afterLoad = .ok (.Err (toRequest error), afterSave) →
        run = .ok ((.Err error, returned, ()), match toRequest error with
          | .CommitUncertain _ => .All | _ => .None)) ∧
      (∀ afterSave, originalSave next afterLoad = .ok (.Ok (), afterSave) →
        ∀ reply, SandproofParentCommitRust.controller.transaction.WorldTransaction.commit afterSave.tx.parent =
          .ok reply → match reply with
          | .Ok () => run = .ok ((.Ok value, returned, ()), match session.local with
            | some binding => .Sandbox binding.sandbox | none => .None)
          | .Err error => run = .ok ((.Err error, returned, ()), match toRequest error with
            | .CommitUncertain _ => .All | _ => .None)) := by
  dsimp only
  obtain ⟨next, e, appended, read⟩ := append_current inbox intent s selected accept
  have admitted := (InboxAdmission.accepts_iff inbox intent context).mpr ⟨config, valid⟩
  have absent := (InboxLookup.find_none_iff inbox intent).mpr selected.1
  have recording := record_after_save begun ns intent context inbox next afterLoad
  obtain ⟨source, capture, operation⟩ := op
  have ends : CoordinatorRevocation.endsAccess intent.request.operation = true := by
    simp [operation, CoordinatorRevocation.endsAccess]
  refine ⟨next, e, appended, read, ?_, ?_⟩
  · intro afterSave error saved
    have body := recording afterSave s e _ loaded admitted absent ⟨source,capture,operation⟩ appended read (.Err error) saved
    have parent : proof_record_actual_parent retirement terminal renewal unload graphic codec hook
        (holder begun ns).tx ns () intent context () = .ok (.Err error, ()) := by
      rw [CallerBranches.extraction_root_uses_real_constructor_and_dictionary]
      simp [record_transaction_using, body, core.result.Result.Insts.CoreOpsTry.branch,
        core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]
    have refused := journal_error journal intent context error _
      (started_reply hook journal intent context () begun after ns started borrowed _ () parent)
    cases h : toRequest error <;> simpa only [h, ends, if_true] using refused
  · intro afterSave saved reply committed
    have body := recording afterSave s e _ loaded admitted absent ⟨source,capture,operation⟩ appended read (.Ok ()) saved
    have returned := commit_reply journal intent context begun after ns started borrowed afterSave _ body reply committed
    cases reply with
    | Ok result =>
      cases result
      simp [journalDecision, returned, toRequestRustResult, CoordinatorRevocation.success, CoordinatorRevocation.selected,
        ends, appendedState, InboxState.workState, InboxRecord.pendingEntry]
      cases (inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)).local <;> rfl
    | Err error =>
      have refused := journal_error journal intent context error _ returned
      cases h : toRequest error <;> simpa only [h, ends, if_true] using refused

/-- A successful save hands the original parent the exact raw transaction and candidate
checked by V5. SQLite success selects the stored mapping and publishes the candidate
to the linked committed cell. An error retains its payload, broadcasts, and clears
that cell. The linked observation concerns the committed memo. -/
theorem fresh_sqlite_outcome (inbox : model.Inbox) (afterLoad : StandardRecord Unit) (s : Usize)
    (loaded : PublicLoaded.originalLoad begun ns = .ok (.Ok (some inbox), afterLoad))
    (config : InboxAdmission.ContextMatches inbox context) (valid : Validation.ValidEnvelope intent context)
    (op : ∃ source capture, intent.request.operation = .Unload source capture)
    (selected : ExistingSelection inbox intent s)
    (accept : existingDecision inbox (inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)) intent =
      .append false) :
    let session := inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)
    let value := appendedState session intent
    let returned := {journal with journal := ⟨after.base⟩}
    ∃ (next : model.Inbox) (e : Usize), inbox.record intent = .ok (.Ok (s,e), next) ∧
      next.state s e = .ok value ∧
      ∀ afterSave, originalSave next afterLoad = .ok (.Ok (), afterSave) →
        let owner := afterSave.tx.parent
        ∀ (raw : Raw) (world : SandproofParentCommitRust.World) (observed : Option SandproofParentCommitRust.World),
          owner.transaction = some raw →
          SandboxModel.InboxTransaction.CurrentWorldRead.CandidateAt
            (SandproofParentCommitRust.CurrentViews.ownerToRead owner) world →
          (∀ error, FirstValidationError owner raw world error →
            journalDecision journal intent context = .ok ((.Err error, returned, ()), match toRequest error with
              | .CommitUncertain _ => .All | _ => .None)) ∧
          (SandproofParentCommitRust.ParentResults.ChecksReturnedOk owner raw world →
          owner.committed.value.beforeBorrowCount = 0 →
          SandproofParentCommitRust.PhysicalLink.LinkedCommitted observed
            (SandproofParentCommitRust.ActualFinish.memoInvocation owner) (fun output => output.2.2) →
          (owner.candidate.beforeBorrowCount = 0 →
            SandproofParentCommitRust.rusqlite.transaction.Transaction.commit raw = .ok (.Ok ()) →
            journalDecision journal intent context = .ok ((.Ok value, returned, ()), match session.local with
              | some binding => .Sandbox binding.sandbox | none => .None) ∧
            observed = owner.candidate.value) ∧
          (∀ error, SandproofParentCommitRust.rusqlite.transaction.Transaction.commit raw = .ok (.Err error) →
            journalDecision journal intent context = .ok ((.Err (.CommitUncertain error), returned, ()), .All) ∧
            observed = none)) := by
  obtain ⟨next, e, recorded, read, _, finish⟩ := fresh_unload journal intent context begun after ns
    started borrowed inbox afterLoad s loaded config valid op selected accept
  refine ⟨next, e, recorded, read, ?_⟩
  intro afterSave saved owner raw world observed live present
  constructor
  · intro error refused
    exact finish afterSave saved (.Err error) (commit_validation_error owner raw world error live present refused)
  intro checks available physical
  constructor
  · intro free committed
    obtain ⟨reply, seen⟩ := SandproofParentCommitRust.ParentResults.actual_commit_success_and_original_observation
      afterSave.tx.parent raw world observed live present checks available free committed physical
    exact ⟨finish afterSave saved (.Ok ()) reply, seen⟩
  · intro error failed
    obtain ⟨reply, seen⟩ := SandproofParentCommitRust.ParentResults.actual_commit_unknown_and_original_observation
      afterSave.tx.parent raw world error observed live present checks available failed physical
    exact ⟨finish afterSave saved (.Err (.CommitUncertain error)) reply, seen⟩

open SandproofStage1RequestRust.sandproof_controller_service.application.coordinator.lifecycle_intent in
/-- The public decision consumes the ordinary result of the commit on the recorded holder.
An outer failure or divergence propagates through the bind without an action value. -/
theorem recorded_commit_dispatch (afterSave : StandardRecord Unit) (value : model.LifecycleWorkState)
    (recorded : record_using retirement terminal renewal unload graphic reads (holder begun ns) intent context =
      .ok (.Ok (.Recorded value), afterSave)) :
    journalDecision journal intent context = (do
      let committed ← SandproofParentCommitRust.controller.transaction.WorldTransaction.commit afterSave.tx.parent
      let reply : core.result.Result model.LifecycleWorkState JournalError := match committed with
        | .Ok () => .Ok value | .Err error => .Err error
      let action ← data_revocation intent.request.operation (toRequestRustResult reply)
      .ok ((reply, {journal with journal := ⟨after.base⟩}, ()), action)) := by
  have okBegin : controller.transaction.WorldTransaction.begin journal.journal.connection journal.committed_world =
      .ok (.Ok (env.onOwner (SandproofUnloadWorldBegin.originalOwner begun)).val, after.base) := by
    unfold controller.transaction.WorldTransaction.begin
    rw [show (⟨journal.journal.connection, env.observation⟩ : UnloadWorldBegin.Conn) = initial journal from rfl, started]
    simp
  unfold journalDecision proof_public_journal ControllerJournal.record_lifecycle_intent
  simp [okBegin, core.result.Result.Insts.CoreOpsTry.branch, borrowed]
  change (do
    let entry ← record_transaction_using retirement terminal renewal unload graphic
      (CallerBranches.actualEffects codec) hook (holder begun ns) intent context ()
    let returned ← (let (reply, c) := entry
      Result.ok (reply, {journal with journal := ⟨after.base⟩}, c))
    let action ← data_revocation intent.request.operation (toRequestRustResult returned.1)
    .ok (returned, action)) = _
  unfold record_transaction_using
  rw [show (CallerBranches.actualEffects codec).RecordEffectsInst = reads from rfl, recorded]
  simp [core.result.Result.Insts.CoreOpsTry.branch, hook_return]
  congr 1
  funext reply
  cases reply with
  | Ok u => cases u; simp
  | Err error => simp [core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]

/-- In the first accepted Unload, the original save supplies the transaction sent to
SQLite. A normal SQL error returns its payload and a broadcast decision. Failure and
divergence of the call propagate through the public journal and decision. -/
theorem fresh_sqlite_dispatch (inbox : model.Inbox) (afterLoad : StandardRecord Unit) (s : Usize)
    (loaded : PublicLoaded.originalLoad begun ns = .ok (.Ok (some inbox), afterLoad))
    (config : InboxAdmission.ContextMatches inbox context) (valid : Validation.ValidEnvelope intent context)
    (op : ∃ source capture, intent.request.operation = .Unload source capture)
    (selected : ExistingSelection inbox intent s)
    (accept : existingDecision inbox
      (inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)) intent = .append false) :
    let session := inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)
    let value := appendedState session intent
    let returned := {journal with journal := ⟨after.base⟩}
    let run := journalDecision journal intent context
    ∃ (next : model.Inbox) (e : Usize), inbox.record intent = .ok (.Ok (s,e), next) ∧
      next.state s e = .ok value ∧
      ∀ afterSave, originalSave next afterLoad = .ok (.Ok (), afterSave) →
        let owner := afterSave.tx.parent
        ∀ (raw : Raw) (world : SandproofParentCommitRust.World), owner.transaction = some raw →
          SandboxModel.InboxTransaction.CurrentWorldRead.CandidateAt
            (SandproofParentCommitRust.CurrentViews.ownerToRead owner) world →
          SandproofParentCommitRust.ParentResults.ChecksReturnedOk owner raw world →
          owner.committed.value.beforeBorrowCount = 0 →
          let sql := SandproofParentCommitRust.rusqlite.transaction.Transaction.commit raw
          (owner.candidate.beforeBorrowCount = 0 → sql = .ok (.Ok ()) →
            run = .ok ((.Ok value, returned, ()), match session.local with
              | some binding => .Sandbox binding.sandbox | none => .None)) ∧
          (∀ err, sql = .ok (.Err err) → run = .ok ((.Err (.CommitUncertain err), returned, ()), .All)) ∧
          (∀ err, sql = .fail err → run = .fail err) ∧ (sql = .div → run = .div) := by
  dsimp only
  obtain ⟨next, e, appended, read⟩ := append_current inbox intent s selected accept
  refine ⟨next, e, appended, read, ?_⟩
  intro afterSave saved raw world live present checks available
  let owner := afterSave.tx.parent
  have admitted := (InboxAdmission.accepts_iff inbox intent context).mpr ⟨config, valid⟩
  have absent := (InboxLookup.find_none_iff inbox intent).mpr selected.1
  have recorded := record_after_save begun ns intent context inbox next afterLoad afterSave s e _
    loaded admitted absent op appended read (.Ok ()) saved
  rw [recorded_commit_dispatch journal intent context begun after ns started borrowed afterSave _ recorded,
    SandproofParentCommitRust.ParentResults.actual_commit_reaches_same_finisher owner raw world live present checks]
  obtain ⟨source, capture, operation⟩ := op
  have ends : CoordinatorRevocation.endsAccess intent.request.operation = true := by
    simp [operation, CoordinatorRevocation.endsAccess]
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro candidateFree ok
    rw [SandproofParentCommitRust.ActualFinish.actual_finish_success owner raw live available candidateFree ok]
    simp [toRequestRustResult, CoordinatorRevocation.success, CoordinatorRevocation.selected,
      appendedState, InboxState.workState, InboxRecord.pendingEntry, ends]
    cases (inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)).local <;> rfl
  · intro err refused
    rw [SandproofParentCommitRust.ActualFinish.actual_finish_unknown owner raw err live available refused]
    simp [toRequestRustResult, toRequest, CoordinatorRevocation.failure, ends]
  · intro err failed
    rw [SandproofParentCommitRust.ActualFinish.actual_finish_fail owner raw err live available failed]
    simp only [bind_tc_fail]
  · intro diverged
    rw [SandproofParentCommitRust.ActualFinish.actual_finish_div owner raw live available diverged]
    simp only [bind_tc_div]

/-- A first Unload passes the existing-session guards. Its own appended inbox and
the post-load holder determine the validation, JSON and budget refusal reaching
the public decision. Later effects need no observations on these branches. -/
theorem fresh_save_refusal (inbox : model.Inbox) (afterLoad : StandardRecord Unit) (s : Usize)
    (loaded : PublicLoaded.originalLoad begun ns = .ok (.Ok (some inbox), afterLoad))
    (config : InboxAdmission.ContextMatches inbox context) (valid : Validation.ValidEnvelope intent context)
    (op : ∃ source capture, intent.request.operation = .Unload source capture)
    (selected : ExistingSelection inbox intent s)
    (accept : existingDecision inbox (inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)) intent =
      .append false) :
    let session := inbox.sessions.val[s.val]'(selected_bound inbox intent s selected)
    let returned := {journal with journal := ⟨after.base⟩}
    let run := journalDecision journal intent context
    ∃ (next : model.Inbox) (e : Usize), inbox.record intent = .ok (.Ok (s,e), next) ∧
      next.state s e = .ok (appendedState session intent) ∧
      (∀ err, saveValidation next = .ok (.Err err) →
        run = .ok ((.Err (fromRequest err), returned, ()), match err with
          | .CommitUncertain _ => .All | _ => .None)) ∧
      (saveValidation next = .ok (.Ok ()) →
        ∀ raw : IOOwnerTransport.ParentRaw, afterLoad.tx.parent.transaction = some raw →
          (∀ err, env.encodeInbox () raw.conn.base next = .ok (.Err err, ()) →
            run = .ok ((.Err (.Json err), returned, ()), .None)) ∧
          (∀ bytes, env.encodeInbox () raw.conn.base next = .ok (.Ok bytes, ()) →
            ConfigBudget.bytes next.config < bytes.val.length →
            run = .ok ((.Err .MaintenanceCapacity, returned, ()), .None))) := by
  dsimp only
  obtain ⟨next, e, appended, state, saveError, _⟩ :=
    fresh_unload journal intent context begun after ns started borrowed inbox afterLoad s loaded config valid op selected accept
  obtain ⟨validation, encoding⟩ := save_encoding_refusals next afterLoad
  refine ⟨next, e, appended, state, ?_, ?_⟩
  · intro err refused
    have saved := validation err refused
    have dispatched := saveError afterLoad (fromRequest err) (by simpa only [toRequest_fromRequest] using saved)
    rw [toRequest_fromRequest] at dispatched
    cases err <;> exact dispatched
  · intro checked raw slot
    obtain ⟨json, budget⟩ := encoding checked raw slot
    exact ⟨fun err failed => saveError afterLoad (.Json err) (json err failed),
      fun bytes returned over => saveError afterLoad .MaintenanceCapacity (budget bytes returned over)⟩

omit started borrowed [FileHandle] [PublicCalls] [SandproofStandardRecordCodec.DecodeCalls] in
/-- The original valid Unload from the append suite is absent from a mapped running session.
The real record call appends it and state returns its full current version and original local. -/
theorem mapped_append_witness :
    let inbox := InboxAppend.Values.withSession InboxAppend.Values.runningSession
    let intent := InboxAppend.Values.unload
    Validation.ValidEnvelope intent EnvelopeValues.context ∧
      ∃ (next : model.Inbox) (e : Usize) (value : model.LifecycleWorkState),
        inbox.record intent = .ok (.Ok (0#usize,e), next) ∧ next.state 0#usize e = .ok value ∧
        value.intent = intent ∧ value.current = true ∧ value.current_session_version = intent.accepted_version ∧
        value.local = some ⟨10#u64, 20#u64, 30#u64⟩ := by
  refine ⟨InboxAppend.Values.normal_unload_valid, ?_⟩
  obtain ⟨next, e, appended, read⟩ := append_current _ _ _ InboxAppend.Values.unload_selection
    InboxAppend.Values.unload_decision
  exact ⟨next,e,_,appended,read,rfl,rfl,rfl,rfl⟩

end
end SandproofActualRecordRust.PublicUnload

