+    def test_stage1_preflight_propagates_each_source_guard_refusal(self):
+        checkout = self.path/'checkout'
+        verification = checkout/'verification'
+        area = verification/'experiments/stage1-protocol'
+        area.mkdir(parents=True)
+        registered = area/'registered.py'
+        registered.write_text("def validate_registration(root, *, profile):\n    assert profile == 'full'\n")
+        manifest = verification/'stage1-protocol-inputs.sha256'
+        manifest.write_text(f'{gate.digest(registered)}  {registered.relative_to(checkout)}\n')
+
+        guards = []
+        for name in ('lifetime-row', 'pause-request', 'source-origin', 'source-question'):
+            package = area/name
+            package.mkdir()
+            (package/'support.py').write_text(
+                "from pathlib import Path\n"
+                "def source_guard():\n    Path(__file__).with_name('provider').read_bytes()\n")
+            provider = package/'provider'
+            provider.touch()
+            guards.append(provider)
+
+        env = dict(os.environ, PYTHONPATH=str(gate.ROOT), PYTHONDONTWRITEBYTECODE='1')
+        with patch.object(gate, 'BINARY', [sys.executable]):
+            passed = self.path/'passed'
+            passed.mkdir()
+            gate.check_stage1_inputs(checkout, passed, env)
+            for provider in guards:
+                with self.subTest(package=provider.parent.name):
+                    failed = self.path/provider.parent.name
+                    failed.mkdir()
+                    provider.unlink()
+                    with self.assertRaises(subprocess.CalledProcessError):
+                        gate.check_stage1_inputs(checkout, failed, env)
+                    self.assertIn(str(provider), (failed/'stage1-registration.log').read_text())
+                    provider.touch()
