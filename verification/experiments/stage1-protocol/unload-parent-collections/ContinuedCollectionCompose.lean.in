import ContinuedCollectionPrefix

open Aeneas Aeneas.Std
namespace SandboxModel.Stage1Protocol.UnloadCollectionLink
open SandproofUnloadFirstObservation
open SandboxModel.Stage1Protocol.UnloadFirstObservation.Parent
open SandboxModel.Stage1Protocol.DigestByteBridge (referenceOutput)
open SandboxModel.Stage1Protocol.UnloadParentLink.Continuation

section
variable (encoding : SandproofCreateOptionsEncoded.Representations)
variable (base : SandproofUnloadFirstObservation.Representations)
variable (options : SandproofUnloadOptionsRead.Representations)
variable (startup : SandproofUnloadStartupJoint.Representations)

theorem complete_continued_read (parent : CallsAt encoding base options startup) :
    letI : Representations := parentView encoding base options startup
    letI : ParentCalls := installCollections encoding base options startup parent
    ∀ {E : Type} {host : host_contract.HostEvidence E}
      {serde : serde_core.de.DeserializeOwned E}
      {tx : SandproofUnloadFirstObservation.rusqlite.transaction.Transaction}
      {ns : Str} {intent : Intent} {now : I64} {input : SourceSnapshot}
      (before : BeforeContinuedCollections host serde tx ns intent now input),
      (∀ raw ∈ before.expandedReceipts.val, raw.deref.val.length < 2^61) →
      ∃ reads : ContinuedRead host serde tx ns intent now input,
        eraseContinuedRead reads = before ∧
        reads.actionIdentities.val = before.expandedActions.val.map (·.identity) ∧
        reads.receiptDigests.val = before.expandedReceipts.val.map (fun raw => referenceOutput raw.deref) := by
  letI : Representations := parentView encoding base options startup
  letI : ParentCalls := installCollections encoding base options startup parent
  intro E host serde tx ns intent now input before normal
  obtain ⟨identities, actions, complete⟩ :=
    installed_actions_complete encoding base options startup parent before.expandedActions.deref
  obtain ⟨digests, receipts, hashes⟩ :=
    installed_receipts_complete encoding base options startup parent before.expandedReceipts.deref
      (by simpa [alloc.vec.Vec.deref] using normal)
  have full : identities.val = before.expandedActions.val.map (·.identity) := by
    simpa [alloc.vec.Vec.deref] using complete
  let reads : ContinuedRead host serde tx ns intent now input :=
    attachContinuedCollections before identities digests actions receipts full
  refine ⟨reads, erase_attach_continued before identities digests actions receipts full, full, ?_⟩
  simpa [reads, attachContinuedCollections, alloc.vec.Vec.deref] using hashes

theorem complete_continued_reaches_exact_question (parent : CallsAt encoding base options startup) :
    letI : Representations := parentView encoding base options startup
    letI : ParentCalls := installCollections encoding base options startup parent
    ∀ {E : Type} {host : host_contract.HostEvidence E}
      {serde : serde_core.de.DeserializeOwned E}
      {tx : SandproofUnloadFirstObservation.rusqlite.transaction.Transaction}
      {ns : Str} {intent : Intent} {now : I64} {input : SourceSnapshot}
      (before : BeforeContinuedCollections host serde tx ns intent now input),
      (∀ raw ∈ before.expandedReceipts.val, raw.deref.val.length < 2^61) →
      ∃ reads : ContinuedRead host serde tx ns intent now input,
        eraseContinuedRead reads = before ∧
        reads.actionIdentities.val = before.expandedActions.val.map (·.identity) ∧
        reads.receiptDigests.val = before.expandedReceipts.val.map (fun raw => referenceOutput raw.deref) ∧
        controller.lifecycle_inbox.source_work.snapshot.current host serde tx ns intent now input =
          question reads.expected input.limits := by
  letI : Representations := parentView encoding base options startup
  letI : ParentCalls := installCollections encoding base options startup parent
  intro E host serde tx ns intent now input before normal
  obtain ⟨reads, erased, actions, receipts⟩ :=
    complete_continued_read encoding base options startup parent before normal
  exact ⟨reads, erased, actions, receipts, actual_continued_reaches_exact_question reads⟩

theorem complete_continued_keeps_exact_prefix (parent : CallsAt encoding base options startup) :
    letI : Representations := parentView encoding base options startup
    letI : ParentCalls := installCollections encoding base options startup parent
    ∀ {E : Type} {host : host_contract.HostEvidence E}
      {serde : serde_core.de.DeserializeOwned E}
      {tx : SandproofUnloadFirstObservation.rusqlite.transaction.Transaction}
      {ns : Str} {intent : Intent} {now : I64} {input : SourceSnapshot}
      (before : BeforeContinuedCollections host serde tx ns intent now input),
      (∀ raw ∈ before.expandedReceipts.val, raw.deref.val.length < 2^61) →
      ∃ reads : ContinuedRead host serde tx ns intent now input,
        eraseContinuedRead reads = before ∧
        reads.expected.continued_from = some before.continuedIdentity ∧
        reads.actionIdentities.val = (before.originalActions.val ++ [before.continuedAction]).map (·.identity) ∧
        reads.receiptDigests.val = (before.originalReceipts.val ++ [before.continuedReceipt]).map
          (fun raw => referenceOutput raw.deref) := by
  letI : Representations := parentView encoding base options startup
  letI : ParentCalls := installCollections encoding base options startup parent
  intro E host serde tx ns intent now input before normal
  obtain ⟨reads, erased, actions, receipts⟩ :=
    complete_continued_read encoding base options startup parent before normal
  have completeActions := successful_push_keeps_complete_prefix _ _ _ before.appendActions
  have completeReceipts := successful_push_keeps_complete_prefix _ _ _ before.appendReceipts
  rw [completeActions] at actions
  rw [completeReceipts] at receipts
  refine ⟨reads, erased, ?_, actions, receipts⟩
  change some reads.continuedIdentity = some before.continuedIdentity
  exact congrArg some (congrArg (fun value => value.continuedIdentity) erased)

end
end SandboxModel.Stage1Protocol.UnloadCollectionLink

#audit_controller_proof SandboxModel.Stage1Protocol.UnloadCollectionLink.complete_continued_read
#audit_controller_proof SandboxModel.Stage1Protocol.UnloadCollectionLink.complete_continued_reaches_exact_question
#audit_controller_proof SandboxModel.Stage1Protocol.UnloadCollectionLink.complete_continued_keeps_exact_prefix
