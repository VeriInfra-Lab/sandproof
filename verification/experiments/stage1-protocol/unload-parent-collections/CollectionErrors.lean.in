      {ns : Str} {intent : Intent} {now : I64} {input : SourceSnapshot}
      (reads : Found host serde tx ns intent now input)
      (entry : Entry)
      (_ : reads.state.current = true)
      (_ : reads.state.terminal = false)
      (_ : reads.session.entries.val[reads.e.val]? = some entry)
      (_ : entry.unload_resolution.isSome = true),
      NoQuestion host serde tx ns intent now input (JournalError.Conflict) := by
  letI : Representations := parentView encoding base options startup
  letI : ParentCalls := installCollections encoding base options startup parent
  intro E host serde tx ns intent now input reads entry current nonterminal indexed resolved
  exact SandboxModel.Stage1Protocol.UnloadParentLink.Errors.resolved_entry_skips_question (reads := reads) (entry := entry) (current := current) (nonterminal := nonterminal) (indexed := indexed) (resolved := resolved)

