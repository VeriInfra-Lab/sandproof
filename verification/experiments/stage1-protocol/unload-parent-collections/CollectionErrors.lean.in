theorem installed_base_error_skips_question
    (encoding : SandproofCreateOptionsEncoded.Representations)
    (base : SandproofUnloadFirstObservation.Representations)
    (options : SandproofUnloadOptionsRead.Representations)
    (startup : SandproofUnloadStartupJoint.Representations)
    (parent : CallsAt encoding base options startup) :
    letI : Representations := parentView encoding base options startup
    letI : ParentCalls := installCollections encoding base options startup parent
    ∀ {E : Type} {host : host_contract.HostEvidence E}
      {serde : serde_core.de.DeserializeOwned E}
      {tx : SandproofUnloadFirstObservation.rusqlite.transaction.Transaction}
      {ns : Str} {intent : Intent} {now : I64} {input : SourceSnapshot}
      (reads : Selected host serde tx ns intent now input)
      (error : JournalError)
      (_ : ParentCalls.readBaseSnapshot tx ns input.world reads.originEntry.intent reads.context = .ok (.Err error)),
      NoQuestion host serde tx ns intent now input error := by
  letI : Representations := parentView encoding base options startup
  letI : ParentCalls := installCollections encoding base options startup parent
  intro E host serde tx ns intent now input reads error failed
  exact SandboxModel.Stage1Protocol.UnloadParentLink.Errors.base_error_skips_question (reads := reads) (error := error) (failed := failed)

