+def plan_sources():
+    """Bind an explicitly selected materialized project's complete Lean view."""
+    setting = os.environ.get("SANDPROOF_LEAN_SOURCE_PLAN")
+    if setting is None:
+        return None
+    if setting != "plan.json":
+        raise ValueError("Use the materialized project's original plan.json.")
+    plan_path = ROOT / setting
+    if plan_path.resolve() != plan_path or not plan_path.is_file():
+        raise ValueError("Missing or linked Lean source plan.")
+    raw = plan_path.read_bytes()
+    plan = json.loads(raw)
+    modules = plan.get("modules")
+    if plan.get("schema") != 1 or type(modules) is not dict or not modules:
+        raise ValueError("Missing materialized Lean source inventory.")
+    fingerprints = []
+    for name in sorted(modules, key=Path):
+        relative = Path(name)
+        source = ROOT / relative
+        if (relative.is_absolute() or ".." in relative.parts or relative.as_posix() != name
+                or relative.suffix != ".lean" or source.resolve() != source or not source.is_file()):
+            raise ValueError("Invalid materialized Lean source: " + name)
+        actual = hashlib.sha256(source.read_bytes()).digest()
+        if actual.hex() != modules[name]["sha256"]:
+            raise ValueError("Changed materialized Lean source: " + name)
+        fingerprints.append((relative, actual))
+    return hashlib.sha256(raw).hexdigest(), fingerprints
+
