import CollectionPrefix

open Aeneas Aeneas.Std
namespace SandboxModel.Stage1Protocol.UnloadCollectionLink
open SandproofUnloadFirstObservation
open SandboxModel.Stage1Protocol.UnloadFirstObservation.Parent
open SandboxModel.Stage1Protocol.DigestByteBridge (referenceOutput)

section
variable (encoding : SandproofCreateOptionsEncoded.Representations)
variable (base : SandproofUnloadFirstObservation.Representations)
variable (options : SandproofUnloadOptionsRead.Representations)
variable (startup : SandproofUnloadStartupJoint.Representations)

theorem complete_first_read (parent : CallsAt encoding base options startup) :
    letI : Representations := parentView encoding base options startup
    letI : ParentCalls := installCollections encoding base options startup parent
    ∀ {E : Type} {host : host_contract.HostEvidence E}
      {serde : serde_core.de.DeserializeOwned E}
      {tx : SandproofUnloadFirstObservation.rusqlite.transaction.Transaction}
      {ns : Str} {intent : Intent} {now : I64} {input : SourceSnapshot}
      (before : BeforeCollections host serde tx ns intent now input),
      (∀ raw ∈ before.originalReceipts.val, raw.deref.val.length < 2^61) →
      ∃ reads : FirstRead host serde tx ns intent now input,
        eraseFirstRead reads = before ∧
        reads.actionIdentities.val = before.originalActions.val.map (·.identity) ∧
        reads.receiptDigests.val = before.originalReceipts.val.map (fun raw => referenceOutput raw.deref) := by
  letI : Representations := parentView encoding base options startup
  letI : ParentCalls := installCollections encoding base options startup parent
  intro E host serde tx ns intent now input before normal
  obtain ⟨identities, actions, complete⟩ :=
    installed_actions_complete encoding base options startup parent before.originalActions.deref
  obtain ⟨digests, receipts, hashes⟩ :=
    installed_receipts_complete encoding base options startup parent before.originalReceipts.deref
      (by simpa [alloc.vec.Vec.deref] using normal)
  have full : identities.val = before.originalActions.val.map (·.identity) := by
    simpa [alloc.vec.Vec.deref] using complete
  let reads : FirstRead host serde tx ns intent now input :=
    attachCollections before identities digests actions receipts full
  refine ⟨reads, erase_attach before identities digests actions receipts full, full, ?_⟩
  simpa [reads, attachCollections, alloc.vec.Vec.deref] using hashes

theorem complete_first_reaches_exact_question (parent : CallsAt encoding base options startup) :
    letI : Representations := parentView encoding base options startup
    letI : ParentCalls := installCollections encoding base options startup parent
    ∀ {E : Type} {host : host_contract.HostEvidence E}
      {serde : serde_core.de.DeserializeOwned E}
      {tx : SandproofUnloadFirstObservation.rusqlite.transaction.Transaction}
      {ns : Str} {intent : Intent} {now : I64} {input : SourceSnapshot}
      (before : BeforeCollections host serde tx ns intent now input),
      (∀ raw ∈ before.originalReceipts.val, raw.deref.val.length < 2^61) →
      ∃ reads : FirstRead host serde tx ns intent now input,
        eraseFirstRead reads = before ∧
        reads.actionIdentities.val = before.originalActions.val.map (·.identity) ∧
        reads.receiptDigests.val = before.originalReceipts.val.map (fun raw => referenceOutput raw.deref) ∧
        controller.lifecycle_inbox.source_work.snapshot.current host serde tx ns intent now input =
          question reads.expected input.limits := by
  letI : Representations := parentView encoding base options startup
  letI : ParentCalls := installCollections encoding base options startup parent
  intro E host serde tx ns intent now input before normal
  obtain ⟨reads, erased, actions, receipts⟩ :=
    complete_first_read encoding base options startup parent before normal
  exact ⟨reads, erased, actions, receipts, actual_current_reaches_exact_question reads⟩

end
end SandboxModel.Stage1Protocol.UnloadCollectionLink

#audit_controller_proof SandboxModel.Stage1Protocol.UnloadCollectionLink.complete_first_read
#audit_controller_proof SandboxModel.Stage1Protocol.UnloadCollectionLink.complete_first_reaches_exact_question
