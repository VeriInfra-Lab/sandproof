import SandboxModel.Lifecycle.Protocol.InboxRenewalNegativeSupport
import SandboxModel.Lifecycle.Protocol.InboxRenewalValues
import SandboxModel.Lifecycle.Protocol.InboxRenewalCheckpoint
import SandboxModel.Lifecycle.Protocol.InboxRenewalClassifier

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_controller_service.controller.lifecycle_inbox.renewal_confirmation
namespace SandboxModel.Stage1Protocol.InboxRenewal.WrongUnapplied
open Values

theorem wrong_scan (session : Session) (version : U64) :
    has_unapplied_sdk_through session version = .ok false := by
  have loop_spec := any_loop_spec (alloc.vec.Vec.deref session.entries)
    (fun _ => false) (has_unapplied_sdk_through_loop.body version)
    (by
      intro index bound
      unfold has_unapplied_sdk_through_loop.body
      rw [slice_next_none _ _ bound]
      simp)
    (by
      intro index bound
      unfold has_unapplied_sdk_through_loop.body
      rw [slice_next_some _ _ bound]
      simp [sdk_renewal_spec, core.option.Option.is_some_and,
        SandproofFoundationsRust.core.option.Option.is_some_and,
        has_unapplied_sdk_through.closure.Insts.CoreOpsFunctionFnOnceTupleI64Bool.call_once]
      split <;> simp_all)
    0 (by omega)
  obtain ⟨result, returned, same⟩ := WP.spec_imp_exists loop_spec
  have all_false (entries : List Entry) : entries.any (fun _ => false) = false := by
    induction entries <;> simp_all
  simp only [List.drop_zero, all_false] at same
  rw [same] at returned
  simpa [has_unapplied_sdk_through, has_unapplied_sdk_through_loop,
    SharedAVec.Insts.CoreIterTraitsCollectIntoIteratorSharedATIter.into_iter,
    core.slice.Slice.iter, sliceCursor, alloc.vec.Vec.deref] using returned

theorem actual_return : run encode unapplied = .ok (.Ok ()) := by
  apply accepts_given_actual_checks encode unapplied (confirmation 3#u64 2#u64) rfl
    confirmation_shapes.1 bytes rfl (by simp [bytes]) (by rfl)
  · rw [checkpoint_spec]
    simp [checkpointInvalid, checkpointMatches, entryInvalid, unapplied, base, entry,
      confirmation, RenewalValues.exactResult, RenewalValues.intent]
  · simp [unapplied, base, core.option.Option.is_some_and,
      SandproofFoundationsRust.core.option.Option.is_some_and]
  · exact wrong_scan _ _

theorem rejects_same_full_contract : ¬ FullRenewalSessionContract run := by
  intro contract
  have required := contract encode unapplied
  rw [actual_return, expected_outcomes.2.2.2.1] at required
  cases Result.ok_injective required

end SandboxModel.Stage1Protocol.InboxRenewal.WrongUnapplied
#audit_controller_proof SandboxModel.Stage1Protocol.InboxRenewal.WrongUnapplied.wrong_scan
#audit_controller_proof SandboxModel.Stage1Protocol.InboxRenewal.WrongUnapplied.actual_return
#audit_controller_proof SandboxModel.Stage1Protocol.InboxRenewal.WrongUnapplied.rejects_same_full_contract
