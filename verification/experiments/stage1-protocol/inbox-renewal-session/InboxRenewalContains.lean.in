import SandboxModel.Lifecycle.Protocol.InboxRenewalReduction

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_controller_service.controller.lifecycle_inbox
namespace SandboxModel.Stage1Protocol.InboxRenewal

theorem contains_version_with_binding (binding : BorrowedVecBinding) (session : Session) (version : U64) :
    renewal_confirmation.contains_accepted_version session version =
      .ok (containsVersion session.entries.val version) := by
  have loop_spec := any_loop_spec (alloc.vec.Vec.deref session.entries)
    (fun entry => decide (entry.intent.accepted_version = version))
    (renewal_confirmation.contains_accepted_version_loop.body version)
    (by
      intro index bound
      unfold renewal_confirmation.contains_accepted_version_loop.body
      rw [slice_next_none _ _ bound]
      simp)
    (by
      intro index bound
      unfold renewal_confirmation.contains_accepted_version_loop.body
      rw [slice_next_some _ _ bound]
      simp
      split <;> simp_all)
    0 (by omega)
  obtain ⟨result, returned, same⟩ := WP.spec_imp_exists loop_spec
  simp only [List.drop_zero] at same
  rw [same] at returned
  unfold renewal_confirmation.contains_accepted_version
  rw [binding]
  simpa [renewal_confirmation.contains_accepted_version_loop, sliceCursor, alloc.vec.Vec.deref, containsVersion] using returned

theorem contains_version_spec (session : Session) (version : U64) :
    renewal_confirmation.contains_accepted_version session version =
      .ok (containsVersion session.entries.val version) := by
  exact contains_version_with_binding borrowed_vec_model session version

end SandboxModel.Stage1Protocol.InboxRenewal
#audit_controller_proof SandboxModel.Stage1Protocol.InboxRenewal.contains_version_spec
#audit_controller_proof SandboxModel.Stage1Protocol.InboxRenewal.contains_version_with_binding
