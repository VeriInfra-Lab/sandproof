import SandboxModel.Lifecycle.Protocol.InboxSaveValidationWitnesses

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_controller_service.controller.lifecycle_inbox.codec
namespace SandboxModel.Stage1Protocol.InboxSave.Values
noncomputable section

theorem wrong_zero_rows_saved (trace : Trace) :
    runSave saved terminal renewal unload (effects bytes (.Ok 0#usize))
      InboxValidation.Values.normal trace =
      .ok (.Ok (), trace ++ completeTrace InboxValidation.Values.normal bytes) := by
  unfold runSave save_using
  rw [actual_normal_validation]
  obtain ⟨budget, returned, exactValue⟩ :=
    ConfigBudget.required_bytes_refines InboxValidation.Values.normal.config
  have value : budget.val = 286720 := exactValue.trans fixture_budget
  simp [effects, returned, value, bytes, SessionShape.Values.vector,
    core.result.Result.Insts.CoreOpsTry.branch, lift, UScalar.lt_equiv, UScalar.cast_val_eq,
    alloc.vec.Vec.deref, Array.to_slice, completeTrace, statement, List.append_assoc]

theorem wrong_zero_rows_contract_rejected : ¬FullSaveContract (runSave (E := Trace)) := by
  intro contract
  have contradiction := contract saved terminal renewal unload (effects bytes (.Ok 0#usize))
    InboxValidation.Values.normal [] InboxValidation.Values.fixture_representable
  rw [wrong_zero_rows_saved, zero_rows_model_rejected] at contradiction
  simp only [Result.ok.injEq, Prod.mk.injEq] at contradiction
  cases contradiction.1

end
end SandboxModel.Stage1Protocol.InboxSave.Values

#audit_controller_proof SandboxModel.Stage1Protocol.InboxSave.Values.wrong_zero_rows_saved
#audit_controller_proof SandboxModel.Stage1Protocol.InboxSave.Values.wrong_zero_rows_contract_rejected
