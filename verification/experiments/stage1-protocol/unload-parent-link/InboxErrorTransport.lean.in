  | .LedgerMismatch => .LedgerMismatch
  | .ResourcesNotReclaimed => .ResourcesNotReclaimed
  | .UnresolvedEffects => .UnresolvedEffects
  | .SnapshotHistoryUnsupported => .SnapshotHistoryUnsupported
  | .DependencyNotClosed => .DependencyNotClosed
  | .RetentionExpired => .RetentionExpired
