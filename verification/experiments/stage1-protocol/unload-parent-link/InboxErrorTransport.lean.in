@[simp] theorem recoverRetirementReject (value : SandproofStage1RequestRust.sandbox_controller_core.maintenance.retirement.RetirementReject) :
    toInboxRetirementReject (toSourceRetirementReject value) = value := by
  cases value <;> simp [toSourceRetirementReject, toInboxRetirementReject]

