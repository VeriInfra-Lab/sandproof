import SourceConfigGuards

open Aeneas Aeneas.Std Result
open SandproofSourceRowSqlSelect hiding toStr
open SandboxModel.Stage1Protocol.SourceRecordBoundsView (Limits Capacity Config)
open SandboxModel.Stage1Protocol.SourceKeyEncode (Fields Row)
set_option autoImplicit false
set_option maxRecDepth 2048
set_option linter.style.longLine false
set_option linter.style.whitespace false

namespace SandboxModel.Stage1Protocol.SourceLoadErrorsView

open SourceMetadataView
private abbrev toStr (text : String)
    (bounded : text.toByteArray.size ≤ U32.max := by rw [U32.max_eq]; decide) : Str :=
  SandproofSourceRowSqlSelect.toStr text bounded

local notation "controller.lifecycle_inbox.source_work.codec.Sources" =>
  SourceMetadataView.controller.lifecycle_inbox.source_work.codec.Sources
local notation "capture.source.SourceObservationConfig" => Limits
local notation "U64.Insts.CoreConvertTryFromI64TryFromIntError.try_from" => SourceRecordBoundsView.toUnsigned
local notation "controller.lifecycle_inbox.source_work.codec.sql" => SourceRecordBoundsView.sqlConvert
local notation "JournalError.Insts.CoreConvertFromError" => SourceLoadView.fromSql
local notation "core.ops.range.RangeInclusive.contains" => SourceMetadataView.rangeContains
local notation "Dyn" => (fun (_ : Type → Type) => Unit)
local notation "ArrayShared0P0.Insts.RusqliteParamsParams" =>
  SourceRecordBoundsView.ArrayShared0P0.Insts.RusqliteParamsParams

section
variable {Node : Type} {f : Fields} (ports : SourceMetadataView.Ports Node f)
local notation "controller.lifecycle_inbox.source_work.codec.schema" => SourceMetadataView.schema ports.text
local notation "controller.lifecycle_inbox.source_work.codec.checked_source_configuration" => SourceMetadataView.checked ports.codec
local notation "controller.lifecycle_inbox.source_work.codec.load_records" => ports.records
local notation "controller.capacity.config" => ports.capacity
local notation "sandproof_protocol.internal.NodeIdentity" => Node
local notation "controller.lifecycle_inbox.source_work.SourceWorkRecord" => Row f

-- ACTUAL LOAD

end
abbrev load := @controller.lifecycle_inbox.source_work.codec.load

end SandboxModel.Stage1Protocol.SourceLoadErrorsView
