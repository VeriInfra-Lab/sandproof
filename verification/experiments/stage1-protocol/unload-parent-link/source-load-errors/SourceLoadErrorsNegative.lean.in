import SourceLoadErrorsSpec

open Aeneas Aeneas.Std
open SandboxModel.Stage1Protocol.SourceKeyEncode (Fields)
set_option autoImplicit false

namespace SandboxModel.Stage1Protocol.SourceLoadErrorsNegative
open SourceMetadataView SourceMetadataSpec SourceLoadErrorsSpec
theorem actual_early_count_rejects_before_missing_row (f : Fields) :
    SourceLoadErrorsView.load (samplePorts f) emptyMetadataDb = .ok (.Err .CorruptStore) := by
  reduce_format_prefix (emptyPrefix f)
  change (do let result ← queryCount emptyMetadataDb; _) = _
  rw [empty_count]
  simp

theorem early_guard_breaks_same_contract (f : Fields) :
    ¬SourceLoadErrorsSpec.Contract (SourceLoadErrorsView.load (Node := Unit) (f := f)) := by
  intro contract
  have required := contract (samplePorts f) emptyMetadataDb (emptyPrefix f) 0#i64 noRows
    empty_count empty_numbers
  rw [actual_early_count_rejects_before_missing_row] at required
  simp only [Result.ok.injEq, core.result.Result.Err.injEq] at required
  cases required

end SandboxModel.Stage1Protocol.SourceLoadErrorsNegative

#audit_controller_proof SandboxModel.Stage1Protocol.SourceLoadErrorsNegative.actual_early_count_rejects_before_missing_row
#audit_controller_proof SandboxModel.Stage1Protocol.SourceLoadErrorsNegative.early_guard_breaks_same_contract
