trait SavedRecordChecks<R, Keys> {
    fn has_key(keys: &Keys, record: &R) -> bool;
    fn same_work(next: &R, record: &R) -> bool;
    fn same_binding(next: &R, record: &R) -> bool;
    fn preserves(record: &R, next: &R) -> bool;
}

struct JournalSavedRecords;

impl SavedRecordChecks<SourceWorkRecord, BTreeSet<[u8; 32]>> for JournalSavedRecords {
    fn has_key(keys: &BTreeSet<[u8; 32]>, record: &SourceWorkRecord) -> bool {
        keys.contains(record.work.requirement.work_binding.as_bytes())
    }

    fn same_work(next: &SourceWorkRecord, record: &SourceWorkRecord) -> bool {
        next.work == record.work
    }

    fn same_binding(next: &SourceWorkRecord, record: &SourceWorkRecord) -> bool {
        next.work.requirement.work_binding == record.work.requirement.work_binding
    }

    fn preserves(record: &SourceWorkRecord, next: &SourceWorkRecord) -> bool {
        super::retirement::preserves_saved_facts(record, next)
    }
}

fn retains_saved_records(current: &Sources, sources: &Sources, keys: &BTreeSet<[u8; 32]>) -> bool {
    retains_inventory_using::<_, _, JournalSavedRecords>(&current.records, &sources.records, keys)
}

fn retains_inventory_using<R, Keys, Check: SavedRecordChecks<R, Keys>>(
    current: &Vec<R>,
    sources: &Vec<R>,
    keys: &Keys,
) -> bool {
    let mut index = 0;
    while index < current.len() {
        if !retains_record_using::<_, _, Check>(&current[index], sources, keys) {
            return false;
        }
        index += 1;
    }
    true
}

fn retains_record_using<R, Keys, Check: SavedRecordChecks<R, Keys>>(
    record: &R,
    sources: &Vec<R>,
    keys: &Keys,
) -> bool {
    if !Check::has_key(keys, record) {
        return false;
    }
    let mut index = 0;
    while index < sources.len() {
        let next = &sources[index];
        if Check::same_work(next, record) {
            return Check::preserves(record, next);
        }
        index += 1;
    }
    false
}
