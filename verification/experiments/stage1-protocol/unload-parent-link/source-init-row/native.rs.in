#[cfg(test)]
mod source_init_row_contract {
    use super::*;
    use crate::controller::{checkpoint, tests_support::lifecycle_application as v3};

    #[test]
    fn source_init_row_keeps_complete_initial_insert() {
        let directory = tempfile::tempdir().unwrap();
        let journal = v3::open(&directory.path().join("db"));
        let connection = &journal.journal.connection;
        let transaction = connection.unchecked_transaction().unwrap();
        let mut policy = checkpoint::config(&transaction).unwrap().unwrap();
        policy.max_operations_per_sandbox = 3;
        policy.validate().unwrap();
        assert_eq!(
            transaction
                .execute(
                    "UPDATE controller_maintenance_config SET config_json=?1 WHERE id=1",
                    [serde_json::to_vec(&policy).unwrap()],
                )
                .unwrap(),
            1
        );
        assert_eq!(checkpoint::config(&transaction).unwrap().unwrap(), policy);
        let mut inbox = v3::config();
        inbox.max_sessions = 1;
        inbox.max_operations_per_session = 3;
        let limits = v3::source_limits();
        let future = limits.required_bytes(1);
        assert_ne!(
            future, 1,
            "the original id and reservation must be distinct"
        );
        assert_eq!(
            reserved_records(&transaction, inbox.max_sessions).unwrap(),
            1
        );
        initialize(&transaction, limits, &inbox).unwrap();
        let mut statement = transaction
            .prepare("SELECT id,state_json,sha256,reserve_bytes,work_key FROM controller_source_work_records ORDER BY id")
            .unwrap();
        let records: Vec<(i64, Vec<u8>, Vec<u8>, i64, Option<Vec<u8>>)> = statement
            .query_map([], |row| {
                Ok((
                    row.get(0)?,
                    row.get(1)?,
                    row.get(2)?,
                    row.get(3)?,
                    row.get(4)?,
                ))
            })
            .unwrap()
            .collect::<Result<_, _>>()
            .unwrap();
        assert_eq!(records.len(), 1);
        let row = &records[0];
        assert_eq!(
            (
                row.0,
                row.1.as_slice(),
                row.2.as_slice(),
                row.3,
                row.4.as_deref()
            ),
            (
                1,
                b"null".as_slice(),
                Sha256::digest(b"null").as_slice(),
                i64::try_from(future).unwrap(),
                None
            ),
            "initial source row must preserve all four bound values and NULL key"
        );
        drop(statement);
        transaction.rollback().unwrap();
    }
}
