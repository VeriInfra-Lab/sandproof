#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyReadSpec.decoded_expected
#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyReadSpec.normal_expected
#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyReadSpec.validated_has_bound
#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyReadSpec.read_success_provenance
#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyReadSpec.read_success_has_bound

#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyReadSpec.invalid_operations_expected

#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyReadSpec.invalid_retention_expected
