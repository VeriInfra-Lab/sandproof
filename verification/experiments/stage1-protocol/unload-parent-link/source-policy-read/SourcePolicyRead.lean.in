#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyRead.original_count_from_standard_read
#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyRead.original_loader_uses_validated_policy
#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyRead.standard_format_error
#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyRead.original_format_error_precedes_aggregate
#audit_controller_proof SandboxModel.Stage1Protocol.SourcePolicyRead.normal_decoded_read
