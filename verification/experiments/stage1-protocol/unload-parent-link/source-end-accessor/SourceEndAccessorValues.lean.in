import SourceEndAccessorProof
open Aeneas Aeneas.Std Result SandproofSourceRetentionProviders
open SandboxModel.Stage1Protocol SourceRetireTypes SourceEndAccessorModel
set_option autoImplicit false
set_option maxHeartbeats 1000000
namespace SandboxModel.Stage1Protocol.SourceEndAccessorValues
noncomputable section
local notation "Root" => SourceEndAccessorActual.controller.lifecycle_inbox.source_work.full.end.SourceWorkRecord.capture_work_end_receipt
local notation "Ctor" => SourceEndAccessorActual.capture.continuation.OriginalContinueWorkRequest.from_ended_source

def identity : Identity :=
  ⟨⟨SourceEndReceiptValues.returnedSaved.work.anchor.«local».sandbox,
     SourceEndReceiptValues.returnedCapture.operation⟩,
    SourceEndReceiptValues.returnedSaved.work.anchor.native.epoch,
    SourceEndReceiptValues.returnedSaved.work.anchor.native.generation, 7#u64⟩
def full : Full := SourceEndReceiptValues.returnedCapture.full
def source : Requirement := SourceEndReceiptValues.returnedSaved.work.requirement
def receipt : Receipt := ⟨SourceWorkMatch.Values.digest, SourceWorkMatch.Values.otherDigest,
  .Returned SourceEndReceiptValues.sealResult⟩
def equalReceipt : Receipt := { receipt with end_binding := receipt.work_binding }
def policy : NetworkPolicy := .DenyAll
def filePolicy : FilePolicy := ⟨9#u64⟩
def question : Question := ⟨identity, full, source, receipt, policy, filePolicy⟩

theorem normal_returned :
    Root SourceEndReceiptValues.io SourceEndReceiptValues.returnedSaved =
      .ok (.Ok (some ⟨SourceEndReceiptValues.digest, SourceEndReceiptValues.digest,
        .Returned SourceEndReceiptValues.sealResult⟩)) := by
  rw [SourceEndAccessorProof.original_receipt_same]
  exact SourceEndReceiptValues.normal_returned

theorem normal_no_request :
    Root SourceEndReceiptValues.io SourceEndReceiptValues.noRequestSaved =
      .ok (.Ok (some ⟨SourceEndReceiptValues.digest, SourceEndReceiptValues.digest,
        .NoRequest SourceEndReceiptValues.sealResult⟩)) := by
  rw [SourceEndAccessorProof.original_receipt_same]
  exact SourceEndReceiptValues.normal_no_request

theorem normal_never_without_seal :
    Root SourceEndReceiptValues.io (SourceEndReceiptValues.neverSaved none) =
      .ok (.Ok (some ⟨SourceEndReceiptValues.digest, SourceEndReceiptValues.digest,
        .NeverReleased none⟩)) := by
  rw [SourceEndAccessorProof.original_receipt_same]
  exact SourceEndReceiptValues.normal_never_without_seal

theorem normal_terminated_none :
    Root SourceEndReceiptValues.io SourceEndValidationValues.terminatedSaved = .ok (.Ok none) := by
  rw [SourceEndAccessorProof.original_receipt_same]
  exact SourceEndReceiptValues.normal_terminated

theorem independent_final_full_error :
    Root SourceEndReceiptValues.lateFullError SourceEndReceiptValues.returnedSaved =
      .ok (.Err (.Json ⟨8⟩)) := by
  rw [SourceEndAccessorProof.original_receipt_same]
  exact SourceEndReceiptValues.last_full_error_is_independent_of_validation

theorem independent_final_end_error :
    Root SourceEndReceiptValues.lateEndError SourceEndReceiptValues.returnedSaved =
      .ok (.Err (.Json ⟨9⟩)) := by
  rw [SourceEndAccessorProof.original_receipt_same]
  exact SourceEndReceiptValues.last_end_error_is_independent_of_validation

/-- Explicit complete decoded values. Two digest fields are deliberately
    independent; no actual hashing or physical source fact follows. -/
theorem normal_complete_question : Ctor identity full source receipt policy filePolicy = .ok question :=
  SourceEndAccessorProof.constructor_complete_contract identity full source receipt policy filePolicy

theorem normal_complete_readout : SourceEndAccessorProof.readAll question = .ok question :=
  SourceEndAccessorProof.read_all_complete question

theorem question_domain_inhabited : ∃ question : Question, SourceEndAccessorProof.readAll question = .ok question :=
  ⟨question, normal_complete_readout⟩

theorem independent_bindings : receipt.work_binding ≠ receipt.end_binding := by decide

theorem equal_binding_control :
    Ctor identity full source equalReceipt policy filePolicy =
      .ok (⟨identity, full, source, equalReceipt, policy, filePolicy⟩ : Question) :=
  SourceEndAccessorProof.constructor_complete_contract identity full source equalReceipt policy filePolicy
end
end SandboxModel.Stage1Protocol.SourceEndAccessorValues
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorValues.normal_returned
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorValues.normal_no_request
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorValues.normal_never_without_seal
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorValues.normal_terminated_none
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorValues.independent_final_full_error
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorValues.independent_final_end_error
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorValues.normal_complete_question
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorValues.normal_complete_readout
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorValues.question_domain_inhabited
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorValues.independent_bindings
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorValues.equal_binding_control
