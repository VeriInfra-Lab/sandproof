import SourceEndAccessor
import SourceEndAccessorReceiptWrong
import SourceEndReceiptNegative
open Aeneas Aeneas.Std Result SandproofSourceRetentionProviders
open SandboxModel.Stage1Protocol SourceRetireTypes SourceEndAccessorModel
set_option autoImplicit false
set_option maxHeartbeats 1000000
namespace SandboxModel.Stage1Protocol.SourceEndAccessorReceiptNegative
noncomputable section
local notation "Root" => SourceEndAccessorReceiptWrongActual.controller.lifecycle_inbox.source_work.full.end.SourceWorkRecord.capture_work_end_receipt

theorem same_actual_wrong_parent (io : SourceEndReceiptModel.Ports) (record : SourceEndReceiptModel.Record) :
    Root io record = SourceEndReceiptWrongActual.controller.lifecycle_inbox.source_work.full.end.receipt io record := rfl

theorem normal_returned_control :
    Root SourceEndReceiptValues.io SourceEndReceiptValues.returnedSaved =
      .ok (.Ok (some ⟨SourceEndReceiptValues.digest, SourceEndReceiptValues.digest,
        .Returned SourceEndReceiptValues.sealResult⟩)) := by
  rw [same_actual_wrong_parent]
  exact SourceEndReceiptNegative.normal_returned_control

theorem normal_never_control :
    Root SourceEndReceiptValues.io (SourceEndReceiptValues.neverSaved none) =
      .ok (.Ok (some ⟨SourceEndReceiptValues.digest, SourceEndReceiptValues.digest,
        .NeverReleased none⟩)) := by
  rw [same_actual_wrong_parent]
  exact SourceEndReceiptNegative.normal_never_without_seal_control

theorem actual_no_request_mistagged :
    Root SourceEndReceiptValues.io SourceEndReceiptValues.noRequestSaved =
      .ok (.Ok (some ⟨SourceEndReceiptValues.digest, SourceEndReceiptValues.digest,
        .Returned SourceEndReceiptValues.sealResult⟩)) := by
  rw [same_actual_wrong_parent]
  exact SourceEndReceiptNegative.actual_no_request_mistagged

/-- The same complete parent property and nonempty decoded domain. -/
theorem violates_same_complete_getter_contract :
    ¬ SourceEndReceiptModel.Contract SourceEndReceiptValues.io (Root SourceEndReceiptValues.io) := by
  intro claimed
  apply SourceEndReceiptNegative.violates_same_complete_contract
  intro record represented
  rw [← same_actual_wrong_parent]
  exact claimed record represented

theorem constructor_still_preserves_all_fields :
    ConstructorContract SourceEndAccessorReceiptWrongActual.capture.continuation.OriginalContinueWorkRequest.from_ended_source := by
  intro identity full source receipt networkPolicy filePolicy
  rfl
end
end SandboxModel.Stage1Protocol.SourceEndAccessorReceiptNegative
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorReceiptNegative.same_actual_wrong_parent
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorReceiptNegative.normal_returned_control
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorReceiptNegative.normal_never_control
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorReceiptNegative.actual_no_request_mistagged
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorReceiptNegative.violates_same_complete_getter_contract
#audit_controller_proof SandboxModel.Stage1Protocol.SourceEndAccessorReceiptNegative.constructor_still_preserves_all_fields
