    (oversized : limit.val < (alloc.vec.Vec.len bytes).val) :
    SourceEndValidationActual.controller.lifecycle_inbox.source_work.full.end.validate_record io record = .ok (.Err .CorruptStore) := by
  rw [actual_contract io record represented]
  exact SourceEndValidationOrder.oversized_before_all_matches io record captured saved bytes present ended encoded oversized

theorem actual_within_limit_continues_to_matches (io : Ports) (record : Record) (represented : Representable record)
    (captured : controller.lifecycle_inbox.source_work.full.CaptureWork) (saved : End)
    (bytes : alloc.vec.Vec U8)
    (present : record.capture = some captured) (ended : captured.«end» = some saved)
    (encoded : io.encode_end saved = .ok (.Ok bytes))
    (bounded : (alloc.vec.Vec.len bytes).val ≤ limit.val) :
    SourceEndValidationActual.controller.lifecycle_inbox.source_work.full.end.validate_record io record = SourceRetireSpec.tryJournal id (matched io record saved)
      (fun isMatch => .ok (if isMatch then .Ok () else .Err .CorruptStore)) := by
  rw [actual_contract io record represented]
  exact SourceEndValidationOrder.within_limit_continues_to_matches io record captured saved bytes present ended encoded bounded

theorem actual_matched_error_after_encoding (io : Ports) (record : Record) (represented : Representable record)
    (captured : controller.lifecycle_inbox.source_work.full.CaptureWork) (saved : End)
    (bytes : alloc.vec.Vec U8) (error : Journal)
    (present : record.capture = some captured) (ended : captured.«end» = some saved)
    (encoded : io.encode_end saved = .ok (.Ok bytes))
    (bounded : (alloc.vec.Vec.len bytes).val ≤ limit.val)
    (failed : matched io record saved = .ok (.Err error)) :
    SourceEndValidationActual.controller.lifecycle_inbox.source_work.full.end.validate_record io record = .ok (.Err error) := by
  rw [actual_contract io record represented]
  exact SourceEndValidationOrder.matched_error_after_encoding io record captured saved bytes error present ended encoded bounded failed

theorem actual_matched_false_rejected (io : Ports) (record : Record) (represented : Representable record)
    (captured : controller.lifecycle_inbox.source_work.full.CaptureWork) (saved : End)
    (bytes : alloc.vec.Vec U8)
    (present : record.capture = some captured) (ended : captured.«end» = some saved)
    (encoded : io.encode_end saved = .ok (.Ok bytes))
    (bounded : (alloc.vec.Vec.len bytes).val ≤ limit.val)
