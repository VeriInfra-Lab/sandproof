theorem actual_matched_true_accepted (io : Ports) (record : Record) (represented : Representable record)
    (captured : controller.lifecycle_inbox.source_work.full.CaptureWork) (saved : End)
    (bytes : alloc.vec.Vec U8)
    (present : record.capture = some captured) (ended : captured.«end» = some saved)
    (encoded : io.encode_end saved = .ok (.Ok bytes))
    (bounded : (alloc.vec.Vec.len bytes).val ≤ limit.val)
    (accepted : matched io record saved = .ok (.Ok true)) :
    SourceEndValidationActual.controller.lifecycle_inbox.source_work.full.end.validate_record io record = .ok (.Ok ()) := by
