theorem actual_material_missing_capture_true (io : Ports) (record : Record) (represented : Representable record) (missing : record.capture = none) :
    SourceEndValidationActual.controller.lifecycle_inbox.source_work.full.end.material_writer_closed io record = .ok (.Ok true) := by
  rw [writer_actual_contract io record represented]
  exact SourceEndValidationOrder.material_missing_capture_true io record missing

theorem actual_material_no_end_false (io : Ports) (record : Record) (represented : Representable record)
    (captured : controller.lifecycle_inbox.source_work.full.CaptureWork)
    (present : record.capture = some captured) (missing : captured.«end» = none) :
    SourceEndValidationActual.controller.lifecycle_inbox.source_work.full.end.material_writer_closed io record = .ok (.Ok false) := by
  rw [writer_actual_contract io record represented]
  exact SourceEndValidationOrder.material_no_end_false io record captured present missing

theorem actual_material_never_after_validation (io : Ports) (record : Record) (represented : Representable record)
    (captured : controller.lifecycle_inbox.source_work.full.CaptureWork)
    (digest : SourceRequestEndMatchModel.Digest) (action : Option SourceRequestEndMatchModel.Action)
    (present : record.capture = some captured)
    (ended : captured.«end» = some (.NeverReleased digest action))
    (accepted : outcome io record = .ok (.Ok ())) :
    SourceEndValidationActual.controller.lifecycle_inbox.source_work.full.end.material_writer_closed io record = .ok (.Ok true) := by
  rw [writer_actual_contract io record represented]
  exact SourceEndValidationOrder.material_never_after_validation io record captured digest action present ended accepted

theorem actual_material_worker_after_validation (io : Ports) (record : Record) (represented : Representable record)
    (captured : controller.lifecycle_inbox.source_work.full.CaptureWork)
    (observation : SourceRequestEndMatchModel.Observation)
    (present : record.capture = some captured)
    (ended : captured.«end» = some (.WorkerEnded observation))
    (accepted : outcome io record = .ok (.Ok ())) :
    SourceEndValidationActual.controller.lifecycle_inbox.source_work.full.end.material_writer_closed io record = .ok (.Ok true) := by
