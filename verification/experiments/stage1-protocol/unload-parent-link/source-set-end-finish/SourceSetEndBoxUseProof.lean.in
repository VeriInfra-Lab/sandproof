#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndBoxUseProof.option_prior_eq_same
#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndBoxUseProof.end_eq_same
#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndBoxUseProof.original_root_same
#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndBoxUseProof.generated_body_contract
#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndBoxUseProof.complete_generated_body_contract
#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndBoxUseProof.independent_of_box_ne
