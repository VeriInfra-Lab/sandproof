#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndOrder.receipt_error_retains_its_complete_input
#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndOrder.absent_receipt_is_corrupt_with_same_complete_state
#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndOrder.receipt_success_retains_all_output_and_state
