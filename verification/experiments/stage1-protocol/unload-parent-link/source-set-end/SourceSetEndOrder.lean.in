#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndOrder.no_observation_with_completed_before_encoding
#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndOrder.differing_complete_end_before_encoding
#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndOrder.same_complete_end_goes_directly_to_receipt
#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndOrder.proposal_error_before_assignment
#audit_controller_proof SandboxModel.Stage1Protocol.SourceSetEndOrder.proposal_over_budget_before_assignment
