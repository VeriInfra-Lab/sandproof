#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.copied_complete_key
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.duplicate_key_is_first
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.scan_uses_complete_record
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.current_complete_record_is_first
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.actual_settled
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.capture_none
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.vector_deref
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.stored_ne
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.bytes_ne
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.vector_ne
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.root_contract
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireSpec.actual_contract
