import SourceRetireCases
import SourceRetireWrongView

open Aeneas Aeneas.Std Result
open SandproofSourceRetentionProviders
open SandboxModel.Stage1Protocol
open SourceRetireTypes SourceRetireActual SourceRetireSpec SourceRetireCases
set_option autoImplicit false
set_option maxRecDepth 2048
set_option maxHeartbeats 1000000

namespace SandboxModel.Stage1Protocol.SourceRetireNegative
noncomputable section

variable {Tree : Type → Type → Type} (io : SourceRetireLibrary.Ports Tree)
variable (record : Record) (payload : Bytes) (sha emptySha : Array U8 32#usize)
variable (before after : keyState (Tree := Tree))
variable (ready : Ready io record payload sha emptySha before after)
include ready

abbrev wrong := @SourceRetireWrong.controller.lifecycle_inbox.source_work.codec.clear_retired_source_record Tree io

theorem wrong_complete_count (count : Usize) :
    wrong io (database count record payload sha emptySha) (fullCurrent record) before record =
      .ok ((if count.val > 1 then .Err .CorruptStore else .Ok ()),after) := by
  have queried := original_four_columns record payload sha emptySha count
  unfold SourceRetireSpec.query at queried
  have written := original_six_values io record payload sha emptySha before after ready count
  unfold SourceRetireSpec.update at written
  have scanned : core.slice.Slice.contains
      controller.lifecycle_inbox.source_work.SourceWorkRecord.Insts.CoreCmpPartialEqSourceWorkRecord
      (fullCurrent record).records.deref record = .ok true := by
    rw [scan_uses_complete_record]
    simp [fullCurrent,alloc.vec.Vec.from]
  unfold wrong SourceRetireWrong.controller.lifecycle_inbox.source_work.codec.clear_retired_source_record
  simp only [sandproof_protocol.lifecycle.digest.ContentDigest.as_bytes,lift,bind_tc_ok,
    copied_complete_key,ready.fresh,scanned]
  simp [ready.noCapture,ready.noRetirement,
    empty_material io record payload sha emptySha before after ready,queried,
    vector_deref,checked_full_record io record payload sha emptySha before after ready,
    stored_ne,SourceRetireLibrary.optionRef,ready.canonicalRecord,vector_ne,
    fullCurrent,legal_reservation,signed_reservation,ready.emptyDigest,
    SourceRetireLibrary.vectorSlice,written,core.result.Result.Insts.CoreOpsTry.branch]
  by_cases more : 1 < count.val <;> simp [more]

theorem wrong_normal_one_row :
    wrong io (database 1#usize record payload sha emptySha) (fullCurrent record) before record =
      .ok (.Ok (),after) := by
  simpa using wrong_complete_count io record payload sha emptySha before after ready 1#usize

theorem wrong_accepts_zero_rows :
    wrong io (database 0#usize record payload sha emptySha) (fullCurrent record) before record =
      .ok (.Ok (),after) := by
  simpa using wrong_complete_count io record payload sha emptySha before after ready 0#usize

theorem rejects_same_complete_contract : ¬ Contract io (wrong io) := by
  intro accepted
  have expected := accepted (database 0#usize record payload sha emptySha) (fullCurrent record) before record
  rw [wrong_accepts_zero_rows io record payload sha emptySha before after ready] at expected
  rw [expected_complete_count io record payload sha emptySha before after ready 0#usize] at expected
  simp at expected

end
end SandboxModel.Stage1Protocol.SourceRetireNegative

#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireNegative.wrong_complete_count
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireNegative.wrong_normal_one_row
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireNegative.wrong_accepts_zero_rows
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRetireNegative.rejects_same_complete_contract
