    capture.work.PauseWorkRequest.mk.injEq, capture_binding_eq, wire_content_digest_eq,
    RequestEquality.node_eq, SourceData.resource_eq, SourceData.process_eq, RequestEquality.ok_and]

theorem full_request_eq (a b : capture.work.FullCaptureWorkRequest) :
    capture.work.FullCaptureWorkRequest.Insts.CoreCmpPartialEqFullCaptureWorkRequest.eq a b = .ok (decide (a=b)) := by
