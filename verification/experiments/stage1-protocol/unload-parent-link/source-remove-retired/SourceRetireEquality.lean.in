    capture.CaptureRequestEndOutcome.Insts.CoreCmpPartialEqCaptureRequestEndOutcome.eq a b = .ok (decide (a=b)) := by
  cases a <;> cases b <;>
    simp [capture.CaptureRequestEndOutcome.Insts.CoreCmpPartialEqCaptureRequestEndOutcome.eq,
      read_discriminant, capture.CaptureRequestEndOutcome.read_discriminant, lift]

theorem end_observation_eq (a b : capture.CaptureRequestEndObservation) :
    capture.CaptureRequestEndObservation.Insts.CoreCmpPartialEqCaptureRequestEndObservation.eq a b = .ok (decide (a=b)) := by
  cases a; cases b
  simp [capture.CaptureRequestEndObservation.Insts.CoreCmpPartialEqCaptureRequestEndObservation.eq,
    capture.CaptureRequestEndObservation.mk.injEq, effect_action_eq, wire_content_digest_eq,
    worker_eq, SourceData.process_eq, end_outcome_eq, RequestEquality.ok_and]

theorem release_facts_eq (a b : controller.lifecycle_inbox.source_work.retirement.MaterialReleaseFacts) :
    controller.lifecycle_inbox.source_work.retirement.MaterialReleaseFacts.Insts.CoreCmpPartialEqMaterialReleaseFacts.eq a b = .ok (decide (a=b)) := by
  cases a; cases b
  simp [controller.lifecycle_inbox.source_work.retirement.MaterialReleaseFacts.Insts.CoreCmpPartialEqMaterialReleaseFacts.eq,
    controller.lifecycle_inbox.source_work.retirement.MaterialReleaseFacts.mk.injEq,
    SourcePreservation.option_witness_eq, RequestEquality.ok_and]

theorem restore_claim_eq (a b : controller.lifecycle_inbox.source_work.restore.RestoreClaim) :
    controller.lifecycle_inbox.source_work.restore.RestoreClaim.Insts.CoreCmpPartialEqRestoreClaim.eq a b = .ok (decide (a=b)) := by
  cases a; cases b
  simp [controller.lifecycle_inbox.source_work.restore.RestoreClaim.Insts.CoreCmpPartialEqRestoreClaim.eq,
    controller.lifecycle_inbox.source_work.restore.RestoreClaim.mk.injEq, RequestEquality.accepted_eq,
    SourceData.local_eq, option_action_eq, RequestEquality.ok_and, Bool.and_left_comm]

theorem boxed_action_eq (a b : sandproof_protocol.WorkAction sandbox_controller_core.model.EffectId) :
    (core.cmp.PartialEqBox (sandproof_protocol.WorkAction.Insts.CoreCmpPartialEqWorkAction
      sandbox_controller_core.model.EffectId.Insts.CoreCmpPartialEqEffectId)).eq a b = .ok (decide (a=b)) := by
  simpa [core.cmp.PartialEqBox, alloc.boxed.PartialEqBox.eq,
    sandproof_protocol.WorkAction.Insts.CoreCmpPartialEqWorkAction] using effect_action_eq a b

theorem option_boxed_action_eq (a b : Option (sandproof_protocol.WorkAction sandbox_controller_core.model.EffectId)) :
    core.option.Option.Insts.CoreCmpPartialEqOption.eq
      (core.cmp.PartialEqBox (sandproof_protocol.WorkAction.Insts.CoreCmpPartialEqWorkAction
        sandbox_controller_core.model.EffectId.Insts.CoreCmpPartialEqEffectId)) a b = .ok (decide (a=b)) :=
  Containers.option_eq_of _ boxed_action_eq a b

