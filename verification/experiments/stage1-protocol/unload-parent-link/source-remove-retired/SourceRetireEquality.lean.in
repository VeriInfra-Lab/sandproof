    controller.lifecycle_inbox.source_work.full.drain.PriorCaptureEnd.Insts.CoreCmpPartialEqPriorCaptureEnd.eq a b = .ok (decide (a=b)) := by
  cases a <;> cases b <;>
    simp [controller.lifecycle_inbox.source_work.full.drain.PriorCaptureEnd.Insts.CoreCmpPartialEqPriorCaptureEnd.eq,
      read_discriminant, controller.lifecycle_inbox.source_work.full.drain.PriorCaptureEnd.read_discriminant,
      wire_content_digest_eq, option_boxed_action_eq, end_observation_eq, RequestEquality.ok_and]

theorem option_prior_end_eq (a b : Option controller.lifecycle_inbox.source_work.full.drain.PriorCaptureEnd) :
    core.option.Option.Insts.CoreCmpPartialEqOption.eq
      controller.lifecycle_inbox.source_work.full.drain.PriorCaptureEnd.Insts.CoreCmpPartialEqPriorCaptureEnd a b = .ok (decide (a=b)) :=
  Containers.option_eq_of _ prior_end_eq a b

theorem capture_end_eq (a b : controller.lifecycle_inbox.source_work.full.end.CaptureEndRecord) :
    controller.lifecycle_inbox.source_work.full.end.CaptureEndRecord.Insts.CoreCmpPartialEqCaptureEndRecord.eq a b = .ok (decide (a=b)) := by
  cases a <;> cases b <;>
    simp [controller.lifecycle_inbox.source_work.full.end.CaptureEndRecord.Insts.CoreCmpPartialEqCaptureEndRecord.eq,
      read_discriminant, controller.lifecycle_inbox.source_work.full.end.CaptureEndRecord.read_discriminant,
      wire_content_digest_eq, option_boxed_action_eq, end_observation_eq, stop_coverage_eq, terminated_eq,
      option_prior_end_eq, RequestEquality.ok_and]

theorem option_digest_eq (a b : Option sandproof_protocol.lifecycle.digest.ContentDigest) :
    core.option.Option.Insts.CoreCmpPartialEqOption.eq
      sandproof_protocol.lifecycle.digest.ContentDigest.Insts.CoreCmpPartialEqContentDigest a b = .ok (decide (a=b)) :=
  ContainerInstances.option_eq _ wire_content_digest_eq a b

theorem option_u64_eq (a b : Option U64) :
    core.option.Option.Insts.CoreCmpPartialEqOption.eq core.cmp.PartialEqU64 a b = .ok (decide (a=b)) := by
  cases a <;> cases b <;> simp [core.option.Option.Insts.CoreCmpPartialEqOption.eq]

theorem option_capture_end_eq (a b : Option controller.lifecycle_inbox.source_work.full.end.CaptureEndRecord) :
    core.option.Option.Insts.CoreCmpPartialEqOption.eq
      controller.lifecycle_inbox.source_work.full.end.CaptureEndRecord.Insts.CoreCmpPartialEqCaptureEndRecord a b = .ok (decide (a=b)) :=
  Containers.option_eq_of _ capture_end_eq a b

theorem capture_work_eq (a b : controller.lifecycle_inbox.source_work.full.CaptureWork) :
    controller.lifecycle_inbox.source_work.full.CaptureWork.Insts.CoreCmpPartialEqCaptureWork.eq a b = .ok (decide (a=b)) := by
  cases a; cases b
  simp [controller.lifecycle_inbox.source_work.full.CaptureWork.Insts.CoreCmpPartialEqCaptureWork.eq,
    controller.lifecycle_inbox.source_work.full.CaptureWork.mk.injEq, core_operation_id_eq,
    full_request_eq, option_action_eq, option_worker_eq, option_digest_eq, option_u64_eq,
    option_capture_end_eq, RequestEquality.ok_and,
    Bool.and_assoc, Bool.and_left_comm, Bool.and_comm]

theorem option_observation_eq (a b : Option capture.source.RawSourceObservation) :
    core.option.Option.Insts.CoreCmpPartialEqOption.eq
      capture.source.RawSourceObservation.Insts.CoreCmpPartialEqRawSourceObservation a b = .ok (decide (a=b)) :=
  Containers.option_eq_of _ raw_observation_eq a b

theorem option_capture_eq (a b : Option controller.lifecycle_inbox.source_work.full.CaptureWork) :
    core.option.Option.Insts.CoreCmpPartialEqOption.eq
      controller.lifecycle_inbox.source_work.full.CaptureWork.Insts.CoreCmpPartialEqCaptureWork a b = .ok (decide (a=b)) :=
  Containers.option_eq_of _ capture_work_eq a b

theorem option_restore_eq (a b : Option controller.lifecycle_inbox.source_work.restore.RestoreClaim) :
    core.option.Option.Insts.CoreCmpPartialEqOption.eq
      controller.lifecycle_inbox.source_work.restore.RestoreClaim.Insts.CoreCmpPartialEqRestoreClaim a b = .ok (decide (a=b)) :=
  Containers.option_eq_of _ restore_claim_eq a b

theorem complete_record_eq (a b : controller.lifecycle_inbox.source_work.SourceWorkRecord) :
    controller.lifecycle_inbox.source_work.SourceWorkRecord.Insts.CoreCmpPartialEqSourceWorkRecord.eq a b = .ok (decide (a=b)) := by
  cases a; cases b
  simp [controller.lifecycle_inbox.source_work.SourceWorkRecord.Insts.CoreCmpPartialEqSourceWorkRecord.eq,
    controller.lifecycle_inbox.source_work.SourceWorkRecord.mk.injEq, SourceWorkMatch.work_eq,
    option_observation_eq, option_capture_eq, option_restore_eq, SourcePreservation.option_state_eq,
    release_facts_eq, RequestEquality.ok_and]


theorem complete_record_accepts_iff (a b : controller.lifecycle_inbox.source_work.SourceWorkRecord) :
    controller.lifecycle_inbox.source_work.SourceWorkRecord.Insts.CoreCmpPartialEqSourceWorkRecord.eq a b = .ok true ↔ a=b := by
  rw [complete_record_eq]
  simp

theorem complete_record_rejects_iff (a b : controller.lifecycle_inbox.source_work.SourceWorkRecord) :
    controller.lifecycle_inbox.source_work.SourceWorkRecord.Insts.CoreCmpPartialEqSourceWorkRecord.eq a b = .ok false ↔ a≠b := by
  rw [complete_record_eq]
  simp

theorem complete_record_total (a b : controller.lifecycle_inbox.source_work.SourceWorkRecord) :
    ∃ accepted, controller.lifecycle_inbox.source_work.SourceWorkRecord.Insts.CoreCmpPartialEqSourceWorkRecord.eq a b = .ok accepted :=
  ⟨decide (a=b),complete_record_eq a b⟩


theorem complete_record_same_value (record : controller.lifecycle_inbox.source_work.SourceWorkRecord) :
    controller.lifecycle_inbox.source_work.SourceWorkRecord.Insts.CoreCmpPartialEqSourceWorkRecord.eq record record = .ok true :=
  (complete_record_accepts_iff record record).mpr rfl

theorem same_key_other_configuration_limit_is_rejected
    (record : controller.lifecycle_inbox.source_work.SourceWorkRecord) (limit : U32)
    (different : limit ≠ record.work.requirement.limits.max_configuration_bytes) :
    let changed := {record with work := {record.work with requirement := {record.work.requirement with
      limits := {record.work.requirement.limits with max_configuration_bytes := limit}}}}
    changed.work.requirement.work_binding = record.work.requirement.work_binding ∧
      controller.lifecycle_inbox.source_work.SourceWorkRecord.Insts.CoreCmpPartialEqSourceWorkRecord.eq record changed = .ok false := by
  dsimp only
  constructor
  · rfl
  · apply (complete_record_rejects_iff _ _).mpr
    intro same
    have field := congrArg (fun r : controller.lifecycle_inbox.source_work.SourceWorkRecord =>
      r.work.requirement.limits.max_configuration_bytes) same
    exact different field.symm

end
end SandboxModel.Stage1Protocol.SourceRetireEquality

