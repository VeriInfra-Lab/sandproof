import SourceRetireEqualityView

open Aeneas Aeneas.Std
open SandproofSourceRetentionProviders
open SandboxModel.Stage1Protocol
open SourceWorkMatch SourceWorkMatch.Scalars SourceWorkMatch.SourceData
open SandboxModel.Stage1Protocol.SourceRetireActual
set_option autoImplicit false

namespace SandboxModel.Stage1Protocol.SourceRetireEquality
noncomputable section
local instance corePropDecidable (p : Prop) : Decidable p := Classical.propDecidable p

-- These instantiate existing field/container proofs over the same actual types.
theorem result_digest_eq (a b : sandbox_controller_core.ids.ResultDigest) :
    sandbox_controller_core.ids.ResultDigest.Insts.CoreCmpPartialEqResultDigest.eq a b = .ok (decide (a=b)) := by
  cases a; cases b
  simp [sandbox_controller_core.ids.ResultDigest.Insts.CoreCmpPartialEqResultDigest.eq]

theorem work_action_eq {C : Type} (dictionary : core.cmp.PartialEq C C)
    (lawful : ∀ a b, dictionary.eq a b = .ok (decide (a=b)))
    (a b : sandproof_protocol.WorkAction C) :
    sandproof_protocol.WorkAction.Insts.CoreCmpPartialEqWorkAction.eq dictionary a b =
      .ok (decide (a=b)) := by
  cases a; cases b
  simp [sandproof_protocol.WorkAction.Insts.CoreCmpPartialEqWorkAction.eq,
    sandproof_protocol.WorkAction.mk.injEq, SourceData.action_eq, lawful, RequestEquality.ok_and]

theorem capture_binding_eq (a b : sandproof_protocol.lifecycle.manifest.CaptureBinding) :
    sandproof_protocol.lifecycle.manifest.CaptureBinding.Insts.CoreCmpPartialEqCaptureBinding.eq a b =
      .ok (decide (a=b)) := by
  cases a; cases b
  simp [sandproof_protocol.lifecycle.manifest.CaptureBinding.Insts.CoreCmpPartialEqCaptureBinding.eq,
    sandproof_protocol.lifecycle.manifest.CaptureBinding.mk.injEq, RequestEquality.binding_eq,
    sandproof_protocol.lifecycle.identity.IncarnationId.Insts.CoreCmpPartialEqIncarnationId.eq,
    sandproof_protocol.lifecycle.identity.CaptureId.Insts.CoreCmpPartialEqCaptureId.eq,
    sandproof_protocol.internal.PositiveCounter.Insts.CoreCmpPartialEqPositiveCounter.eq, RequestEquality.ok_and]

theorem drive_eq (a b : sandproof_protocol.lifecycle.manifest.WritableDrive) :
    sandproof_protocol.lifecycle.manifest.WritableDrive.Insts.CoreCmpPartialEqWritableDrive.eq a b =
      .ok (decide (a=b)) := by
  cases a; cases b
  simp [sandproof_protocol.lifecycle.manifest.WritableDrive.Insts.CoreCmpPartialEqWritableDrive.eq,
    sandproof_protocol.lifecycle.manifest.WritableDrive.mk.injEq, wire_resource_id_eq,
    alloc.string.String.Insts.CoreCmpPartialEqString.eq, RequestEquality.ok_and]

theorem drives_eq (a b : alloc.vec.Vec sandproof_protocol.lifecycle.manifest.WritableDrive) :
    alloc.vec.partial_eq.PartialEqVec.eq
      sandproof_protocol.lifecycle.manifest.WritableDrive.Insts.CoreCmpPartialEqWritableDrive a b =
      .ok (decide (a=b)) :=
  Containers.vec_eq_of _ drive_eq a b

theorem compatibility_eq (a b : sandproof_protocol.lifecycle.manifest.VmCompatibility) :
    sandproof_protocol.lifecycle.manifest.VmCompatibility.Insts.CoreCmpPartialEqVmCompatibility.eq a b =
      .ok (decide (a=b)) := by
  cases a; cases b
  simp [sandproof_protocol.lifecycle.manifest.VmCompatibility.Insts.CoreCmpPartialEqVmCompatibility.eq,
    sandproof_protocol.lifecycle.manifest.VmCompatibility.mk.injEq, wire_content_digest_eq,
    drives_eq, RequestEquality.ok_and]

theorem worker_eq (a b : capture.launch.CaptureWorkerBinding) :
    capture.launch.CaptureWorkerBinding.Insts.CoreCmpPartialEqCaptureWorkerBinding.eq a b =
      .ok (decide (a=b)) := by
  cases a; cases b
  simp [capture.launch.CaptureWorkerBinding.Insts.CoreCmpPartialEqCaptureWorkerBinding.eq,
    capture.launch.CaptureWorkerBinding.mk.injEq, SourceData.process_eq,
    wire_content_digest_eq, RequestEquality.ok_and]

theorem raw_observation_eq (a b : capture.source.RawSourceObservation) :
    capture.source.RawSourceObservation.Insts.CoreCmpPartialEqRawSourceObservation.eq a b =
      .ok (decide (a=b)) := by
  cases a; cases b
  simp [capture.source.RawSourceObservation.Insts.CoreCmpPartialEqRawSourceObservation.eq,
    capture.source.RawSourceObservation.mk.injEq, wire_content_digest_eq,
    SourceData.resource_eq, SourceData.process_eq, RequestEquality.vec_eq,
    RequestEquality.array_eq, RequestEquality.ok_and,
    Bool.and_assoc, Bool.and_left_comm, Bool.and_comm]

theorem effect_action_eq (a b : sandproof_protocol.WorkAction sandbox_controller_core.model.EffectId) :
    sandproof_protocol.WorkAction.Insts.CoreCmpPartialEqWorkAction.eq
      sandbox_controller_core.model.EffectId.Insts.CoreCmpPartialEqEffectId a b = .ok (decide (a=b)) :=
  work_action_eq _ SourceWorkMatch.CoreEffects.effect_eq a b

theorem option_action_eq (a b : Option (sandproof_protocol.WorkAction sandbox_controller_core.model.EffectId)) :
    core.option.Option.Insts.CoreCmpPartialEqOption.eq
      (sandproof_protocol.WorkAction.Insts.CoreCmpPartialEqWorkAction
        sandbox_controller_core.model.EffectId.Insts.CoreCmpPartialEqEffectId) a b = .ok (decide (a=b)) :=
  Containers.option_eq_of _ effect_action_eq a b

theorem option_worker_eq (a b : Option capture.launch.CaptureWorkerBinding) :
    core.option.Option.Insts.CoreCmpPartialEqOption.eq
      capture.launch.CaptureWorkerBinding.Insts.CoreCmpPartialEqCaptureWorkerBinding a b = .ok (decide (a=b)) :=
  Containers.option_eq_of _ worker_eq a b

theorem stop_coverage_eq (a b : sandbox_controller_core.model.StopCoverage) :
    sandbox_controller_core.model.StopCoverage.Insts.CoreCmpPartialEqStopCoverage.eq a b = .ok (decide (a=b)) := by
