theorem terminated_eq (a b : capture.terminated.TerminatedCaptureObservation) :
    capture.terminated.TerminatedCaptureObservation.Insts.CoreCmpPartialEqTerminatedCaptureObservation.eq a b =
      .ok (decide (a=b)) := by
  cases a; cases b
  simp [capture.terminated.TerminatedCaptureObservation.Insts.CoreCmpPartialEqTerminatedCaptureObservation.eq,
    capture.terminated.TerminatedCaptureObservation.StoppedAndDrained.injEq,
    wire_content_digest_eq, effect_action_eq, SourceData.process_eq, option_worker_eq,
    SourcePreservation.host_context_eq, lift, RequestEquality.ok_and,
    Bool.and_assoc, Bool.and_left_comm, Bool.and_comm]

theorem pause_request_eq (a b : capture.work.PauseWorkRequest) :
    capture.work.PauseWorkRequest.Insts.CoreCmpPartialEqPauseWorkRequest.eq a b = .ok (decide (a=b)) := by
