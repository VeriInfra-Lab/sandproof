theorem request_contract (record : Record) :
    SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.request record =
      .ok (match requestValue record with
        | none => .Err .UnresolvedAction
        | some value => .Ok value) := by
  have actions := clone_option
    (SourceRetireActual.sandproof_protocol.WorkAction.Insts.CoreCloneClone
      SourceRetireActual.sandbox_controller_core.model.EffectId.Insts.CoreCloneClone)
    (by intro item; exact clone_work_action item)
  have workers := clone_option SourceRetireActual.capture.launch.CaptureWorkerBinding.Insts.CoreCloneClone
    (by intro item; exact clone_capture_capture_worker_binding item)
  cases captured : record.capture <;>
    simp [SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.request,
      SourceRetireLibrary.optionRef,core.option.Option.ok_or,requestValue,captured,
      core.result.Result.Insts.CoreOpsTry.branch,
      core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual,
      clone_capture_full_capture_work_request,clone_capture_source_observation_requirement,
      actions,workers,SourceRetireActual.capture.retirement.CaptureMaterialRetirementRequest.from_source]

theorem tryJournal_rewrap {A B E : Type} (convert : E → Journal)
    (reply : Result (core.result.Result A E)) (next : A → Result (core.result.Result B Journal)) :
    tryJournal id (tryJournal convert reply (fun value => .ok (.Ok value))) next =
      tryJournal convert reply next := by
  simp only [tryJournal,bind_assoc_eq]
  apply congrArg (fun continuation => reply >>= continuation)
  funext result
  cases result <;> simp


theorem request_binding_continuation {B : Type} (request : Request)
    (next : Key → Result (core.result.Result B Journal)) :
    tryJournal id (requestBinding io request) next =
      tryJournal SourceRetireTypes.JournalError.Json
        (SourceRetireActual.capture.retirement.CaptureMaterialRetirementRequest.binding_digest io request) next := by
  rw [←request_binding_all_fields,tryJournal_rewrap]

theorem saved_plan (state : State) :
    controller.lifecycle_inbox.source_work.retirement.plan state = .ok (saved state) := by
  cases state <;> rfl

theorem empty_release_iff (facts : controller.lifecycle_inbox.source_work.retirement.MaterialReleaseFacts) :
    facts = ⟨none,none⟩ ↔ facts.producer.isNone ∧ facts.consumer.isNone := by
  cases facts with
  | mk producer consumer => cases producer <;> cases consumer <;> simp

theorem restore_material_use (claim : Option controller.lifecycle_inbox.source_work.restore.RestoreClaim) :
    core.option.Option.is_some_and
      SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.material_charge.closure.Insts.CoreOpsFunctionFnOnceTupleSharedRestoreClaimBool
      claim () = .ok (claim.any (fun value => value.material_use)) := by
  cases claim <;>
    simp [core.option.Option.is_some_and,
      SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.material_charge.closure.Insts.CoreOpsFunctionFnOnceTupleSharedRestoreClaimBool.call_once]


theorem actual_contract (record : Record) :
    SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.material_charge io record = charge io record := by
  cases captured : record.capture with
  | none =>
    cases retired : record.retirement <;>
      simp [SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.material_charge,
        charge,captured,retired,core.option.Option.is_none,
        SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.MaterialReleaseFacts.empty,
        SourceRetireEquality.release_facts_eq,empty_release_iff]
  | some captureRecord =>
    cases retired : record.retirement with
    | none =>
      simp [SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.material_charge,
        charge,captured,retired]
    | some state =>
      simp only [SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.material_charge,
        charge,captured,retired]
      rw [bounded_contract]
      change (boundedState io state >>= _) = (boundedState io state >>= _)
      apply congrArg (fun next => boundedState io state >>= next)
      funext reply
      cases reply with
      | Err failure =>
        simp [core.result.Result.Insts.CoreOpsTry.branch,
          core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]
      | Ok bounded =>
        simp only [core.result.Result.Insts.CoreOpsTry.branch,bind_tc_ok]
        rw [saved_plan]
        simp only [bind_tc_ok]
        by_cases empty : (saved state).bytes.slice.val = []
        · simp [SourceRetireLibrary.vectorEmpty,empty]
        · by_cases large : (saved state).bytes.slice.val.length > 16384
          · simp [SourceRetireLibrary.vectorEmpty,empty,
              alloc.vec.Vec.len,alloc.vec.Vec.val,UScalar.lt_equiv,
              SourceRetireActual.capture.retirement.MATERIAL_RETIREMENT_PLAN_MAX_BYTES,large]
          · simp [SourceRetireLibrary.vectorEmpty,empty,alloc.vec.Vec.len,alloc.vec.Vec.val,UScalar.lt_equiv,
              SourceRetireActual.capture.retirement.MATERIAL_RETIREMENT_PLAN_MAX_BYTES,large]
            rw [request_contract]
            simp only [requestValue,captured,Option.map_some,bind_tc_ok,
              ]
            rw [request_binding_continuation]
            let originalRequest : Request :=
              ⟨record.work.anchor.local.sandbox,record.work.anchor.native.generation,
                captureRecord.full,record.work.requirement,captureRecord.action,captureRecord.worker,captureRecord.completed⟩
            change (SourceRetireActual.capture.retirement.CaptureMaterialRetirementRequest.binding_digest io originalRequest >>= _) =
              (SourceRetireActual.capture.retirement.CaptureMaterialRetirementRequest.binding_digest io originalRequest >>= _)
            apply congrArg (fun next => SourceRetireActual.capture.retirement.CaptureMaterialRetirementRequest.binding_digest io originalRequest >>= next)
            funext reply
            cases reply with
            | Err failure =>
              simp [
                core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual,
                SourceRetireActual.JournalErrorFromJson.from_json]
            | Ok workBinding =>
              simp only [bind_tc_ok]
              rw [digest_ne]
              by_cases sameWork : (saved state).work_binding = workBinding
              · simp only [sameWork,ne_eq,not_true_eq_false,decide_false,bind_tc_ok,Bool.false_eq_true,ite_false]
                simp only [SourceRetireSpec.vector_deref,source_digest]
                apply congrArg (fun next => SandproofSourceRowSqlSelect.controller.lifecycle_inbox.sha256.digest (saved state).bytes.slice >>= next)
                funext planBinding
                rw [digest_ne]
                by_cases samePlan : (saved state).plan_binding = planBinding
                · simp only [samePlan,ne_eq,not_true_eq_false,decide_false,bind_tc_ok,Bool.false_eq_true,ite_false]
                  simp only [SourceRetireLibrary.optionRef,bind_tc_ok,restore_material_use]
                  by_cases held : record.restore.any (fun claim => claim.material_use) = true
                  · simp [held]
                  · simp only [held]
                    rw [closure_contract]
                    change (closureBinding io record (saved state).closure >>= _) = (closureBinding io record (saved state).closure >>= _)
                    apply congrArg (fun next => closureBinding io record (saved state).closure >>= next)
                    funext closed
                    cases closed with
                    | Err failure =>
                      simp [
                        core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]
                    | Ok value =>
                      simp only [bind_tc_ok]
                      cases state <;> simp [digest_ne]
                      all_goals split_ifs <;> simp_all
                · simp [samePlan]
              · simp [sameWork]


theorem actual_full_contract :
    Contract io (SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.material_charge io) := by
  intro record
  exact actual_contract io record

end
end SandboxModel.Stage1Protocol.SourceMaterialChargeProof

