import SourceMaterialChargeSpec

open Aeneas Aeneas.Std Result
open SandproofSourceRetentionProviders
open SandboxModel.Stage1Protocol
open SourceRetireTypes SourceRetireActual SourceRetireSpec SourceMaterialChargeSpec
set_option autoImplicit false
set_option maxRecDepth 2048

namespace SandboxModel.Stage1Protocol.SourceMaterialChargeProof
noncomputable section
variable {Tree : Type → Type → Type} (io : SourceRetireLibrary.Ports Tree)

theorem restore_binding_contract (record : Record) :
    SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.closure.restore_binding io record =
      restoreBinding io record := by
  cases restored : record.restore with
  | none =>
    simp [SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.closure.restore_binding,
      SourceRetireLibrary.optionRef,SourceRetireLibrary.optionMap,SourceRetireLibrary.optionTranspose,
      restoreBinding,restored]
  | some claim =>
    simp only [SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.closure.restore_binding,
      SourceRetireLibrary.optionRef,SourceRetireLibrary.optionMap,restored,bind_tc_ok]
    simp only [SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.closure.restore_binding.closure.Insts.CoreOpsFunctionFnOnceTupleSharedRestoreClaimResultContentDigestJournalError.call_once,
      restoreBinding,restored,tryJournal,bind_assoc_eq,SourceRetireSpec.vector_deref]
    apply congrArg (fun next => io.restoreJson claim.intent claim.local claim.generation claim.activation >>= next)
    funext encoded
    cases encoded <;>
      simp [core.result.Result.Insts.CoreOpsTry.branch,
        core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual,
        SourceRetireActual.JournalErrorFromJson.from_json,
        SourceRetireActual.controller.lifecycle_inbox.source_work.digest,
        SourceRetireActual.sandproof_protocol.lifecycle.digest.ContentDigest.from_sha256,
        SourceRetireLibrary.optionTranspose]


theorem source_digest (bytes : Slice U8) :
    SourceRetireActual.controller.lifecycle_inbox.source_work.digest bytes =
      SandproofSourceRowSqlSelect.controller.lifecycle_inbox.sha256.digest bytes := by
  simp [SourceRetireActual.controller.lifecycle_inbox.source_work.digest,
    SourceRetireActual.sandproof_protocol.lifecycle.digest.ContentDigest.from_sha256]
  change (SandproofSourceRowSqlSelect.controller.lifecycle_inbox.sha256.digest bytes >>= pure) = _
  simp

theorem digest_ne (a b : Key) :
    core.cmp.PartialEq.ne.trait_default
      sandproof_protocol.lifecycle.digest.ContentDigest.Insts.CoreCmpPartialEqContentDigest a b =
      .ok (decide (a ≠ b)) := by
  simp [core.cmp.PartialEq.ne.trait_default,core.cmp.PartialEq.ne.default,
    SourceWorkMatch.Scalars.wire_content_digest_eq]

theorem option_digest_ne (a b : Option Key) :
    core.cmp.PartialEq.ne.trait_default
      (core.option.Option.Insts.CoreCmpPartialEqOption
        sandproof_protocol.lifecycle.digest.ContentDigest.Insts.CoreCmpPartialEqContentDigest) a b =
      .ok (decide (a ≠ b)) := by
  simp [core.cmp.PartialEq.ne.trait_default,core.cmp.PartialEq.ne.default,
    SourceRetireEquality.option_digest_eq]

theorem closure_contract (record : Record) (closed : Closure) :
    SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.closure.validate_bindings io record closed =
      closureBinding io record closed := by
  unfold SourceRetireActual.controller.lifecycle_inbox.source_work.retirement.closure.validate_bindings
  simp only [core.option.Option.is_some]
  rw [release_complete]
  by_cases ready : complete record
  · simp only [ready,decide_true,bind_tc_ok,ite_true]
    simp only [closureBinding,ready,not_true_eq_false,ite_false,tryJournal]
    apply congrArg (fun next => io.releaseJson record.material_release >>= next)
    funext encoded
    cases encoded with
    | Err failure =>
      simp [core.result.Result.Insts.CoreOpsTry.branch,
        core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual,
        SourceRetireActual.JournalErrorFromJson.from_json]
    | Ok bytes =>
      simp only [core.result.Result.Insts.CoreOpsTry.branch,bind_tc_ok,
        SourceRetireSpec.vector_deref,source_digest]
      apply congrArg (fun next => SandproofSourceRowSqlSelect.controller.lifecycle_inbox.sha256.digest bytes.slice >>= next)
      funext released
      rw [digest_ne]
      by_cases same : closed.release_binding = released
      · simp only [same,ne_eq,not_true_eq_false,decide_false,bind_tc_ok,ite_false]
        rw [restore_binding_contract]
        simp only [Bool.false_eq_true,ite_false]
        apply congrArg (fun next => restoreBinding io record >>= next)
        funext restored
        cases restored with
        | Err failure =>
          simp [core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]
        | Ok value =>
          simp [option_digest_ne]
      · simp [same]
  · simp [ready,closureBinding]


theorem clone_option {T : Type} (dictionary : core.clone.Clone T)
    (copies : ∀ value, dictionary.clone value = .ok value) (value : Option T) :
    SourceRetireLibrary.optionClone dictionary value = .ok value := by
  cases value <;> simp [SourceRetireLibrary.optionClone,copies]

theorem clone_vector {T : Type} (dictionary : core.clone.Clone T)
    (copies : ∀ value, dictionary.clone value = .ok value) (value : alloc.vec.Vec T) :
    alloc.vec.CloneVec.clone dictionary value = .ok value := by
  obtain ⟨copied,returned,same⟩ := WP.spec_imp_exists
    (Slice.clone_spec (s := value.slice) (by intro item _; exact copies item))
  simp [alloc.vec.CloneVec.clone,returned,←same]


