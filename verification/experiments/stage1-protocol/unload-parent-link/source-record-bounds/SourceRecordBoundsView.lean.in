def aggregateSql : Str := toStr
  "SELECT count(*),COALESCE(min(id),0),COALESCE(max(id),0),COALESCE(min(reserve_bytes),0),COALESCE(max(reserve_bytes),0),COALESCE(max(length(state_json)),0) FROM controller_source_work_records"

def queryBounds (connection : SaveRows.Db) : Result BoundsReply :=
  rusqlite.Connection.query_row ArrayShared0P0.Insts.RusqliteParamsParams aggregateDictionary
    connection aggregateSql (Std.Array.empty (Dyn (fun item => rusqlite.types.to_sql.ToSql item))) ()

