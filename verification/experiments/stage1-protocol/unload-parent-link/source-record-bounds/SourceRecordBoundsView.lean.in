-- The only dynamic parameter carrier has zero entries.
private abbrev EmptyArgument (_ : Type → Type) := Unit
local notation "Dyn" => EmptyArgument

def emptyBinding (_ : Array Unit 0#usize)
    (statement : rusqlite.statement.Statement) :
    Result (core.result.Result Unit rusqlite.error.Error × rusqlite.statement.Statement) := do
  let result ← rusqlite.statement.Statement.ensure_parameter_count statement 0#usize
  .ok (result, statement)

local notation "ArrayShared0P0.Insts.RusqliteParamsParams.__bind_in" => emptyBinding

-- ACTUAL EMPTY SEALED
-- ACTUAL EMPTY DICTIONARY

def toUnsigned (value : I64) : Result (core.result.Result U64 core.num.error.TryFromIntError) :=
  if 0 ≤ value.val then .ok (.Ok (IScalar.hcast .U64 value)) else .ok (.Err ())

def toSigned (value : U64) : Result (core.result.Result I64 core.num.error.TryFromIntError) :=
  if (value.val : Int) ≤ I64.max then .ok (.Ok (UScalar.hcast .I64 value)) else .ok (.Err ())

def integerEq : core.cmp.PartialEq I64 I64 :=
  { eq := fun left right => .ok (decide (left = right)) }

def anyMismatch : List (Result Bool) → Result Bool
  | [] => .ok false
  | comparison :: rest => do
    let differs ← comparison
    if differs then .ok true else anyMismatch rest

def i64TupleNe {A B C D E : Type} (a : core.cmp.PartialEq A A) (b : core.cmp.PartialEq B B)
    (c : core.cmp.PartialEq C C) (d : core.cmp.PartialEq D D) (e : core.cmp.PartialEq E E)
    (left right : A × B × C × D × E) : Result Bool :=
  anyMismatch [a.ne left.1 right.1, b.ne left.2.1 right.2.1, c.ne left.2.2.1 right.2.2.1,
    d.ne left.2.2.2.1 right.2.2.2.1, e.ne left.2.2.2.2 right.2.2.2.2]

local notation "U64.Insts.CoreConvertTryFromI64TryFromIntError.try_from" => toUnsigned
local notation "I64.Insts.CoreConvertTryFromU64TryFromIntError.try_from" => toSigned
local notation "TupleXWVUT.Insts.CoreCmpPartialEqTupleXWVUT.ne" => i64TupleNe
local notation "core.cmp.PartialEqI64" => integerEq
local notation "JournalError.Insts.CoreConvertFromError" => SourceLoadView.fromSql

