#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.actual_complete_result_contract
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.factored_same_original
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.actual_input_contract
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.same_complete_contract
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.actual_json_first
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.actual_complete_bytes
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.wrong_complete_tuple
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.file_policy_omission_refutes_complete_contract
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.real_wrong_refutes_same_complete_contract
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.zero_policy_factored_control
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.zero_policy_control
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.normal_full_question

#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.wrong_factored_same_original
#audit_controller_proof SandboxModel.Stage1Protocol.ContinueWorkBindingProof.same_unfactored_complete_contract
