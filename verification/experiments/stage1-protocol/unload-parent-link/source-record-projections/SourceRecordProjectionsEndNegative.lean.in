import SourceRecordProjectionsEndWrong
open Aeneas Aeneas.Std Result SandproofSourceRetentionProviders
open SandboxModel.Stage1Protocol SourceRetireTypes SourceRecordProjectionsModel
set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option maxRecDepth 2048
namespace SandboxModel.Stage1Protocol.SourceRecordProjectionsEndNegative
noncomputable section

def readers : Readers :=
  { sandbox := SourceRecordProjectionsEndWrongActual.controller.lifecycle_inbox.source_work.full.SourceWorkRecord.source_sandbox
    hasEnd := SourceRecordProjectionsEndWrongActual.controller.lifecycle_inbox.source_work.full.SourceWorkRecord.capture_has_end
    full := SourceRecordProjectionsEndWrongActual.controller.lifecycle_inbox.source_work.full.SourceWorkRecord.full_capture
    worker := SourceRecordProjectionsEndWrongActual.controller.lifecycle_inbox.source_work.full.SourceWorkRecord.capture_worker
    action := SourceRecordProjectionsEndWrongActual.controller.lifecycle_inbox.source_work.full.SourceWorkRecord.capture_action
    requestEnd := SourceRecordProjectionsEndWrongActual.controller.lifecycle_inbox.source_work.full.SourceWorkRecord.capture_request_end
    manifest := SourceRecordProjectionsEndWrongActual.controller.lifecycle_inbox.source_work.full.SourceWorkRecord.captured_manifest
    materialBytes := SourceRecordProjectionsEndWrongActual.controller.lifecycle_inbox.source_work.full.SourceWorkRecord.captured_material_bytes
    operation := SourceRecordProjectionsEndWrongActual.controller.lifecycle_inbox.source_work.full.SourceWorkRecord.capture_operation }

theorem actual_wrong_projection (record : Record) :
    readers.hasEnd record = .ok (match record.capture with | none => false | some _ => true) := by
  rcases record with ⟨work, observation, captured, restore, retirement, materialRelease⟩
  cases captured <;> simp [readers, SourceRecordProjectionsEndWrongActual.controller.lifecycle_inbox.source_work.full.SourceWorkRecord.capture_has_end,
    SourceRecordProjectionsEndWrongActual.core.option.Option.is_some_and,
    SourceRecordProjectionsEndWrongActual.controller.lifecycle_inbox.source_work.full.SourceWorkRecord.capture_has_end.closure.Insts.CoreOpsFunctionFnOnceTupleSharedCaptureWorkBool.call_once,
    SourceEndReceiptActual.core.option.Option.as_ref, SourceRetireLibrary.optionRef]

theorem actual_pending_is_wrongly_ended :
    readers.hasEnd SourceRecordProjectionsValues.pending = .ok true := by
  rw [actual_wrong_projection]; rfl

theorem violates_same_complete_contract : ¬ Contract readers := by
  intro all
  have wrong := (all SourceRecordProjectionsValues.pending).2.1
  rw [actual_pending_is_wrongly_ended] at wrong
  change (Result.ok true : Result Bool) = .ok false at wrong
  have values := Result.ok_injective wrong
  cases values

theorem missing_capture_control (record : Record) (missing : record.capture = none) :
    readers.hasEnd record = .ok false := by
  rw [actual_wrong_projection, missing]

theorem saved_end_control (record : Record) (captured : Capture) (savedEnd : End)
    (present : record.capture = some captured) (ended : captured.«end» = some savedEnd) :
    readers.hasEnd record = SourceRecordProjectionsProof.readers.hasEnd record := by
  rw [actual_wrong_projection, SourceRecordProjectionsProof.hasEnd_reader]
  simp [expected, present, ended]
end
end SandboxModel.Stage1Protocol.SourceRecordProjectionsEndNegative
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRecordProjectionsEndNegative.actual_wrong_projection
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRecordProjectionsEndNegative.actual_pending_is_wrongly_ended
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRecordProjectionsEndNegative.violates_same_complete_contract
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRecordProjectionsEndNegative.missing_capture_control
#audit_controller_proof SandboxModel.Stage1Protocol.SourceRecordProjectionsEndNegative.saved_end_control
