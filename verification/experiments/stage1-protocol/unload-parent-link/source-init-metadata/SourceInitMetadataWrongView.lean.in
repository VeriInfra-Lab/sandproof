import SourceInitMetadataView

open Aeneas Aeneas.Std Result ControlFlow
open SandproofSourceRowSqlSelect
open SandproofSourceInitCapacity hiding JournalError toStr
set_option autoImplicit false
set_option linter.style.whitespace false
set_option linter.style.longLine false
set_option maxRecDepth 2048

namespace SandboxModel.Stage1Protocol.SourceInitMetadataWrongView
noncomputable section

abbrev toStr (text : String)
    (bounded : text.toByteArray.size ≤ U32.max := by rw [U32.max_eq]; decide) : Str :=
  SandproofSourceRowSqlSelect.toStr text bounded

section
variable (io : Ports)
local notation "capture.source.SourceObservationConfig" => SourceRecordBoundsView.Limits
local notation "JournalError" => SaveRows.Error
local notation "JournalErrorFromJson" => SandproofSourceInitCapacity.JournalErrorFromJson
