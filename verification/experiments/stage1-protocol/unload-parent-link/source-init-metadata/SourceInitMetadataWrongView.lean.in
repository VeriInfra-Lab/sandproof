local notation "controller.lifecycle_inbox.source_work.codec.write_initial_source_rows" => SandproofSourceInitCapacity.controller.lifecycle_inbox.source_work.codec.write_initial_source_rows io
local notation "controller.lifecycle_inbox.source_work.codec.sql" => SandproofSourceInitCapacity.controller.lifecycle_inbox.source_work.codec.sql
local notation "controller.lifecycle_inbox.source_work.codec.METADATA_BYTES" => SandproofSourceInitCapacity.controller.lifecycle_inbox.source_work.codec.METADATA_BYTES
local notation "controller.lifecycle_inbox.source_work.codec.TABLE" => SandproofSourceInitCapacity.controller.lifecycle_inbox.source_work.codec.TABLE
local notation "controller.lifecycle_inbox.source_work.codec.RECORDS_TABLE" => SandproofSourceInitCapacity.controller.lifecycle_inbox.source_work.codec.RECORDS_TABLE
local notation "TupleABC.Insts.RusqliteParamsParams" => SandproofSourceInitCapacity.TupleABC.Insts.RusqliteParamsParams io
local notation "I64.Insts.RusqliteTypesTo_sqlToSql" => SandproofSourceInitCapacity.I64.Insts.RusqliteTypesTo_sqlToSql io
local notation "SliceU8.Insts.RusqliteTypesTo_sqlToSql" => SandproofSourceInitCapacity.SliceU8.Insts.RusqliteTypesTo_sqlToSql io
local notation "alloc.vec.Vec.as_slice" => SandproofSourceInitCapacity.alloc.vec.Vec.as_slice
local notation "rusqlite.Connection.execute_batch" => io.batch
local notation "rusqlite.Connection.execute" => io.execute

-- ACTUAL WRONG SUFFIX

end
end
end SandboxModel.Stage1Protocol.SourceInitMetadataWrongView
