namespace SandboxModel.Stage1Protocol.SourceEndReceiptProof
noncomputable section
abbrev Capture := SourceEndReceiptOrder.Capture

theorem actual_missing_capture_skips_all (io : Ports) (record : Record) (represented : Representable record) (absent : record.capture = none) :
    SourceEndReceiptActual.controller.lifecycle_inbox.source_work.full.end.receipt io record = .ok (.Ok none) := by
  rw [actual_contract io record represented]
  exact SourceEndReceiptOrder.missing_capture_skips_all io record absent

theorem actual_missing_end_skips_validation (io : Ports) (record : Record) (represented : Representable record) (captured : Capture)
    (present : record.capture = some captured) (absent : captured.«end» = none) :
    SourceEndReceiptActual.controller.lifecycle_inbox.source_work.full.end.receipt io record = .ok (.Ok none) := by
  rw [actual_contract io record represented]
  exact SourceEndReceiptOrder.missing_end_skips_validation io record captured present absent

theorem actual_validation_error_first (io : Ports) (record : Record) (represented : Representable record) (captured : Capture) (saved : End)
    (error : Journal) (present : record.capture = some captured) (ended : captured.«end» = some saved)
    (failed : SourceEndValidationModel.outcome io.validation record = .ok (.Err error)) :
    SourceEndReceiptActual.controller.lifecycle_inbox.source_work.full.end.receipt io record = .ok (.Err error) := by
  rw [actual_contract io record represented]
  exact SourceEndReceiptOrder.validation_error_first io record captured saved error present ended failed

theorem actual_typed_error_before_final_bindings (io : Ports) (record : Record) (represented : Representable record) (captured : Capture) (saved : End)
    (error : Journal) (present : record.capture = some captured) (ended : captured.«end» = some saved)
    (ready : SourceEndValidationModel.outcome io.validation record = .ok (.Ok ()))
    (failed : typedEnd record saved = .ok (.Err error)) :
    SourceEndReceiptActual.controller.lifecycle_inbox.source_work.full.end.receipt io record = .ok (.Err error) := by
  rw [actual_contract io record represented]
  exact SourceEndReceiptOrder.typed_error_before_final_bindings io record captured saved error present ended ready failed

theorem actual_typed_none_skips_final_bindings (io : Ports) (record : Record) (represented : Representable record) (captured : Capture) (saved : End)
    (present : record.capture = some captured) (ended : captured.«end» = some saved)
    (ready : SourceEndValidationModel.outcome io.validation record = .ok (.Ok ()))
    (absent : typedEnd record saved = .ok (.Ok none)) :
    SourceEndReceiptActual.controller.lifecycle_inbox.source_work.full.end.receipt io record = .ok (.Ok none) := by
  rw [actual_contract io record represented]
  exact SourceEndReceiptOrder.typed_none_skips_final_bindings io record captured saved present ended ready absent

theorem actual_terminated_none_after_validation (io : Ports) (record : Record) (represented : Representable record) (captured : Capture)
    (stop : SourceDrainValidationModel.Stop) (observed : SourceDrainValidationModel.Observation)
    (prior : Option SourceEndValidationModel.Prior)
    (present : record.capture = some captured) (ended : captured.«end» = some (.Terminated stop observed prior))
    (ready : SourceEndValidationModel.outcome io.validation record = .ok (.Ok ())) :
    SourceEndReceiptActual.controller.lifecycle_inbox.source_work.full.end.receipt io record = .ok (.Ok none) := by
  rw [actual_contract io record represented]
  exact SourceEndReceiptOrder.terminated_none_after_validation io record captured stop observed prior present ended ready

theorem actual_accepted_type_continues_exact_tail (io : Ports) (record : Record) (represented : Representable record) (captured : Capture)
    (saved : End) (typed : TypedEnd)
    (present : record.capture = some captured) (ended : captured.«end» = some saved)
    (ready : SourceEndValidationModel.outcome io.validation record = .ok (.Ok ()))
    (selected : typedEnd record saved = .ok (.Ok (some typed))) :
    SourceEndReceiptActual.controller.lifecycle_inbox.source_work.full.end.receipt io record = SourceEndReceiptOrder.tail io captured.full saved typed := by
  rw [actual_contract io record represented]
  exact SourceEndReceiptOrder.accepted_type_continues_exact_tail io record captured saved typed present ended ready selected

theorem actual_final_full_error_before_last_end (io : Ports) (record : Record) (represented : Representable record) (captured : Capture)
    (saved : End) (typed : TypedEnd) (error : JsonError)
    (present : record.capture = some captured) (ended : captured.«end» = some saved)
    (ready : SourceEndValidationModel.outcome io.validation record = .ok (.Ok ()))
    (selected : typedEnd record saved = .ok (.Ok (some typed)))
    (failed : SourceRequestEndMatchModel.binding (finalFull io) captured.full = .ok (.Err error)) :
    SourceEndReceiptActual.controller.lifecycle_inbox.source_work.full.end.receipt io record = .ok (.Err (.Json error)) := by
  rw [actual_contract io record represented]
  exact SourceEndReceiptOrder.final_full_error_before_last_end io record captured saved typed error present ended ready selected failed

theorem actual_last_end_error_after_full (io : Ports) (record : Record) (represented : Representable record) (captured : Capture)
    (saved : End) (typed : TypedEnd) (workBinding : SourceRequestEndMatchModel.Digest) (error : JsonError)
    (present : record.capture = some captured) (ended : captured.«end» = some saved)
    (ready : SourceEndValidationModel.outcome io.validation record = .ok (.Ok ()))
    (selected : typedEnd record saved = .ok (.Ok (some typed)))
    (bound : SourceRequestEndMatchModel.binding (finalFull io) captured.full = .ok (.Ok workBinding))
    (failed : io.encode_end_again saved = .ok (.Err error)) :
    SourceEndReceiptActual.controller.lifecycle_inbox.source_work.full.end.receipt io record = .ok (.Err (.Json error)) := by
  rw [actual_contract io record represented]
  exact SourceEndReceiptOrder.last_end_error_after_full io record captured saved typed workBinding error present ended ready selected bound failed

theorem actual_complete_output_fields (io : Ports) (record : Record) (represented : Representable record) (captured : Capture)
    (saved : End) (typed : TypedEnd) (workBinding endBinding : SourceRequestEndMatchModel.Digest)
    (bytes : alloc.vec.Vec U8)
    (present : record.capture = some captured) (ended : captured.«end» = some saved)
    (ready : SourceEndValidationModel.outcome io.validation record = .ok (.Ok ()))
    (selected : typedEnd record saved = .ok (.Ok (some typed)))
    (bound : SourceRequestEndMatchModel.binding (finalFull io) captured.full = .ok (.Ok workBinding))
    (encoded : io.encode_end_again saved = .ok (.Ok bytes))
    (hashed : io.validation.drain.full.digest bytes.slice = .ok endBinding) :
    SourceEndReceiptActual.controller.lifecycle_inbox.source_work.full.end.receipt io record = .ok (.Ok (some ⟨workBinding, endBinding, typed⟩)) := by
  rw [actual_contract io record represented]
  exact SourceEndReceiptOrder.complete_output_fields io record captured saved typed workBinding endBinding bytes present ended ready selected bound encoded hashed

end
end SandboxModel.Stage1Protocol.SourceEndReceiptProof

