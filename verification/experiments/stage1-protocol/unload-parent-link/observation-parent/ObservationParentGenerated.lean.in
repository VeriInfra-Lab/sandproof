import ObservationSuffix

open Aeneas Aeneas.Std Result SandproofObservationSlot
open SandboxModel.Stage1Protocol.ObservationSuffix
set_option autoImplicit false

namespace SandboxModel.Stage1Protocol.ObservationParent

structure ReadTypes where
  requirement : Type
  request : Type
  context : Type
  world : Type
  host : Type → Type
  decoder : Type → Type

section
variable (c : Carriers) (t : ReadTypes)
local notation "sandbox_controller_core.model.World" => t.world
local notation "controller.lifecycle_inbox.model.Inbox" => Inbox c
local notation "capture.source.SourceObservationConfig" => c.limits
local notation "capture.HostEpochObservation" => c.epoch

-- GENERATED CURRENT SOURCE
end

abbrev Current := controller.lifecycle_inbox.source_work.snapshot.CurrentSource

structure ReadCalls (c : Carriers) (t : ReadTypes) where
  requirement : c.work → Result t.requirement
  guard : c.observation → t.requirement → Result Bool
  invalidEvidence : c.error
  cloneEpoch : core.clone.Clone c.epoch
  cloneActive : core.clone.Clone c.epoch → Option c.epoch → Result (Option c.epoch)
  begin : c.connection → c.committed → Result (core.result.Result c.transaction c.error × c.connection)
  loadInbox : c.connection → Result (core.result.Result (Option (Inbox c)) c.error)
  unsupported : c.error
  request : c.work → Result t.request
  authenticate : Inbox c → t.request → t.context → Result (core.result.Result Unit c.error)
  loadSources : c.connection → Result (core.result.Result (Option (Sources c)) c.error)
  namespaceView : String → Result Str
  world : c.transaction → Result t.world
  activeRef : Option c.epoch → Result (Option c.epoch)
  current : {E : Type} → t.host E → t.decoder E → c.rawTransaction →
    Str → t.request → I64 → Current c t → Result (core.result.Result c.work c.error)

def workDictionary {c : Carriers} (calls : Calls c) : core.cmp.PartialEq c.work c.work :=
  { eq := calls.workEq }

section
variable {c : Carriers} {t : ReadTypes} (calls : Calls c) (reads : ReadCalls c t)
local notation "host_contract.HostEvidence" => t.host
local notation "serde_core.de.DeserializeOwned" => t.decoder
local notation "CrashInjector" => Hooks c
