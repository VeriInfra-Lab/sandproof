#[test]
fn source_cursor_reports_first_invalid_column_type() {
    let directory = tempfile::tempdir().unwrap();
    let (mut journal, _) = ready(&directory.path().join("db"));
    let original = prepare(&mut journal);
    let key = original.work.requirement.work_binding.as_bytes();
    let connection = &journal.journal.connection;
    assert_eq!(
        codec::load(connection).unwrap().unwrap().records,
        vec![original.clone()]
    );

    // The real schema accepts TEXT values of the prescribed lengths. The
    // cursor must reject their storage class, before attempting JSON decoding.
    for (assignments, expected) in [
        (
            "state_json='null',sha256=printf('%032d',0),work_key=printf('%032d',0)",
            (0, "state_json"),
        ),
        (
            "sha256=printf('%032d',0),work_key=printf('%032d',0)",
            (1, "sha256"),
        ),
        ("work_key=printf('%032d',0)", (2, "work_key")),
    ] {
        let tx = connection.unchecked_transaction().unwrap();
        assert_eq!(
            tx.execute(
                &format!(
                    "UPDATE controller_source_work_records SET {assignments} WHERE work_key=?1"
                ),
                [key.as_slice()],
            )
            .unwrap(),
            1
        );
        match codec::load(&tx) {
            Err(JournalError::Sqlite(rusqlite::Error::InvalidColumnType(index, name, storage))) => {
                assert_eq!(storage, rusqlite::types::Type::Text);
                assert_eq!(
                    (index, name.as_str()),
                    expected,
                    "source cursor must return the first invalid column"
                );
            }
            _ => panic!("source cursor must preserve the original SQLite InvalidColumnType"),
        }
        tx.rollback().unwrap();
        assert_eq!(
            codec::load(connection).unwrap().unwrap().records,
            vec![original.clone()]
        );
    }
}
