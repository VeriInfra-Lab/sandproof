def rangeContains {A B : Type} (_ : core.cmp.PartialOrd A A)
    (lower : core.cmp.PartialOrd A B) (upper : core.cmp.PartialOrd B A)
    (range : core.ops.range.RangeInclusive A) (value : B) : Result Bool := do
  let lowerOk ← lower.le range.start value
  if lowerOk then upper.le value range.end else .ok false

local notation "core.ops.range.RangeInclusive.contains" => rangeContains

-- ACTUAL VALID
abbrev valid := capture.source.SourceObservationConfig.valid

def sessionValid (value : U16) : Result Bool := do
  let range ← core.ops.range.RangeInclusive.new 1#u16 4096#u16
  rangeContains core.cmp.PartialOrdU16 core.cmp.PartialOrdU16 core.cmp.PartialOrdU16 range value

/-- A4 validates the underlying SQLite text before providing its original
    UTF-8 bytes. A failing conversion keeps the issued Row's exact error. -/
abbrev TextDecode := Slice U8 → Result (core.result.Result Str rusqlite.types.from_sql.FromSqlError)

def readText (decode : TextDecode) (value : rusqlite.types.value_ref.ValueRef) :
    Result (core.result.Result Str rusqlite.types.from_sql.FromSqlError) :=
  match value with
  | .Text bytes => decode bytes
  | _ => .ok (.Err .invalidType)

def fromBool (value : rusqlite.types.value_ref.ValueRef) :
    Result (core.result.Result Bool rusqlite.types.from_sql.FromSqlError) :=
  match value with
  | .Integer number => .ok (.Ok (number != 0#i64))
  | _ => .ok (.Err .invalidType)

def strToSql (table : Str) : Result (SqlReply rusqlite.types.to_sql.ToSqlOutput) :=
  .ok (.Ok (.Borrowed (.Text table)))

def sharedToSql {T : Type} (encoder : rusqlite.types.to_sql.ToSql T) (value : T) :=
  encoder.to_sql value

/-- The original singleton array contains the table name as TEXT. The
    canonical firstRow provider includes fallible SQLite binding and stepping. -/
def bindText {T : Type} (encode : rusqlite.types.to_sql.ToSql T)
    (values : Array T 1#usize) (statement : rusqlite.statement.Statement) : Result BindReply :=
  rusqlite.statement.Statement.ensure_parameter_count statement 1#usize >>= fun result =>
  match result with
  | .Err failure => .ok (.Err failure, statement)
  | .Ok () =>
    encode.to_sql (getElem values 0 (by simp)) >>= fun encoded =>
    match encoded with
    | .Err failure => .ok (.Err failure, statement)
    | .Ok (.Borrowed (.Text bytes)) => .ok (.Ok (), appendValue statement (.text bytes))
    | _ => .fail .panic

def optionalCompare {T : Type} (compare : core.cmp.PartialEq T T) :
    core.cmp.PartialEq (Option T) (Option T) :=
  { eq := fun left right =>
      match left, right with
      | some left, some right => compare.eq left right
      | none, none => .ok true
      | _, _ => .ok false }

def strCompare : core.cmp.PartialEq Str Str :=
  { eq := fun left right => .ok (decide (left = right)) }

def optionalDeref {T V : Type} (deref : core.ops.deref.Deref T V) :
    Option T → Result (Option V)
  | none => .ok none
  | some value => do let view ← deref.deref value; .ok (some view)

def textDeref : core.ops.deref.Deref Str Str := { deref := .ok }

def bytesCompare (_ : core.cmp.PartialEq U8 U8) : core.cmp.PartialEq (Slice U8) (Slice U8) :=
  { eq := fun left right => .ok (left.val == right.val) }

def vecBytesDiffer (_ : Type) (_ : core.cmp.PartialEq U8 U8)
    (left : Bytes) (right : Slice U8) : Result Bool := .ok (!(left.val == right.val))

