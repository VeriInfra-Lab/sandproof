  rusqlite.Connection.query_row (ArrayT1.Insts.RusqliteParamsParams
      (Shared0T.Insts.RusqliteTypesTo_sqlToSql Str.Insts.RusqliteTypesTo_sqlToSql))
    controller.lifecycle_inbox.source_work.codec.schema.closure.Insts.CoreOpsFunctionFnOnceTupleSharedRowResultStringError
