-- Fields in the existing explicit base operation dictionary.
  queryRow {T P F : Type} : rusqlite.params.Params P →
    core.ops.function.FnOnce F rusqlite.row.Row (core.result.Result T rusqlite.error.Error) →
    rusqlite.Connection → Str → P → F → Result (core.result.Result T rusqlite.error.Error)
  bindOne {T : Type} : rusqlite.types.to_sql.ToSql T → Array T 1#usize →
    rusqlite.statement.Statement → Result
      ((core.result.Result Unit rusqlite.error.Error) × rusqlite.statement.Statement)
  rowGet {I T : Type} : rusqlite.row.RowIndex I → rusqlite.types.from_sql.FromSql T →
    rusqlite.row.Row → I → Result (core.result.Result T rusqlite.error.Error)
  columnIndex : Usize → rusqlite.statement.Statement →
    Result (core.result.Result Usize rusqlite.error.Error)
  intColumn : rusqlite.types.value_ref.ValueRef →
    Result (core.result.Result I64 rusqlite.types.from_sql.FromSqlError)
  borrowedToSql {T : Type} : rusqlite.types.to_sql.ToSql T → T →
    Result (core.result.Result rusqlite.types.to_sql.ToSqlOutput rusqlite.error.Error)
  strToSql : Str → Result (core.result.Result rusqlite.types.to_sql.ToSqlOutput rusqlite.error.Error)
