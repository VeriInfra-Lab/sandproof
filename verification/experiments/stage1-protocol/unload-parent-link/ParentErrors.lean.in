  intro encode
  simp only [controller.lifecycle_inbox.source_work.snapshot.current,
    controller.lifecycle_inbox.model.Inbox.find, failed, core.result.Result.Insts.CoreOpsTry.branch,
    core.option.Option.ok_or, alloc.vec.Vec.index_slice_index, alloc.vec.Vec.index_usize, alloc.vec.Vec.getElem?_Nat_eq,
    controller.lifecycle_inbox.model.Inbox.state, core.option.Option.is_some, core.option.Option.as_ref,
    core.cmp.PartialEq.ne.trait_default, core.cmp.PartialEq.ne.default,
    core.option.Option.Insts.CoreCmpPartialEqOption.eq, reduceCtorEq, imp_self, implies_true,
    core.cmp.impls.PartialEqShared.eq, capture.HostEpochObservation.Insts.CoreCmpPartialEqHostEpochObservation.eq,
