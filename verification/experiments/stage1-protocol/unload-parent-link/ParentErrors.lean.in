import ParentSuccess

open Aeneas Aeneas.Std
namespace SandboxModel.Stage1Protocol.UnloadParentLink.Errors
open SandproofUnloadFirstObservation
open SandboxModel.Stage1Protocol.UnloadFirstObservation.Parent
variable [Representations] [calls : ParentCalls]

/-- Changing the final complete-anchor encoder arbitrarily cannot change this
first error. In particular the encoder may diverge; the actual parent still
returns the error, so the question's first call is not evaluated. -/
def NoQuestion {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot) (error : JournalError) : Prop :=
  ∀ encode,
    letI : ParentCalls := { calls with encodeCompleteSourceAnchor := encode }
    controller.lifecycle_inbox.source_work.snapshot.current host serde tx ns intent now input = .ok (.Err error)

structure Selected {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot) where
  sessionIndex : Usize
  entryIndex : Usize
  session : Session
  entry : Entry
  state : WorkState
  localValue : Local
  originEntry : Entry
  sourceIncarnation : sandproof_protocol.lifecycle.identity.IncarnationId
  captureId : sandproof_protocol.lifecycle.identity.CaptureId
  boot : HostEpoch
  context : sandproof_protocol.lifecycle.authority.AuthenticatedCenterContext
  find : ParentCalls.inboxFindCompleteRequest input.inbox intent = .ok (.Ok (some (sessionIndex, entryIndex)))
  getSession : input.inbox.sessions.val[sessionIndex.val]? = some session
  getEntry : session.entries.val[entryIndex.val]? = some entry
  stateRead : ParentCalls.inboxState input.inbox sessionIndex entryIndex = .ok state
  isCurrent : state.current = true
  nonterminal : state.terminal = false
  noResolution : entry.unload_resolution = none
  unload : intent.request.operation = .Unload sourceIncarnation captureId
  bootObservation : input.inbox.host_epoch_observation = some boot
  activeObservation : input.active = some boot
  bootMatch : ParentCalls.equalHostObservation boot boot = .ok true
  localBinding : state.«local» = some localValue
  originRead : ParentCalls.sessionExecutionOrigin session = .ok (some originEntry)
  cloneOrigin : ParentCalls.cloneCompleteIntent originEntry.intent = .ok originEntry.intent
  contextRead : ParentCalls.inboxContext input.inbox.config = .ok context

structure FirstBase {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot)
    extends Selected host serde tx ns intent now input where
  base : Ready
  native : Native
  baseRead : ParentCalls.readBaseSnapshot tx ns input.world originEntry.intent context = .ok (.Ok base)
  nativePresent : base.view.native = some native
  completedOriginal : ParentCalls.hasCompletedOriginalExecution native localValue = .ok true
  historicalRunning : base.view.historical_result = some (.Running native.generation)
  historicalMatch : ParentCalls.equalOperationResult (.Running native.generation) (.Running native.generation) = .ok true
  live : ParentCalls.checkLiveNative native localValue intent.accepted_version session.current_version now = .ok true

structure FirstSource {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot)
    extends FirstBase host serde tx ns intent now input where
  source : Process
  sourceRead : ParentCalls.readOriginalSource host serde tx ns input.world localValue.sandbox = .ok (.Ok source)
  sameBootText : ParentCalls.equalBootText source.boot_id boot.registration.boot_id = .ok true
  nonzeroPid : source.pid ≠ 0#u32
  nonzeroTicks : source.start_time_ticks ≠ 0#u64

structure Startup {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot)
    extends FirstSource host serde tx ns intent now input where
  actions : Actions
  receipts : Receipts
  connection : rusqlite.Connection
  startupRead : ParentCalls.readOriginalStartupRecords host serde tx ns input.world localValue = .ok (.Ok (actions, receipts))
  connectionRead : ParentCalls.transactionConnection tx = .ok connection

structure Options {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot)
    extends Startup host serde tx ns intent now input where
  options : host_contract.CreateOptions
  optionsRead : ParentCalls.readCreateOptions connection ns localValue.sandbox = .ok (.Ok options)

structure Found {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot) where
  s : Usize
  e : Usize
  session : Session
  state : WorkState
  find : ParentCalls.inboxFindCompleteRequest input.inbox intent = .ok (.Ok (some (s, e)))
  getSession : input.inbox.sessions.val[s.val]? = some session
  stateRead : ParentCalls.inboxState input.inbox s e = .ok state

structure NativeRead {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot)
    extends Selected host serde tx ns intent now input where
  base : Ready
  native : Native
  baseRead : ParentCalls.readBaseSnapshot tx ns input.world originEntry.intent context = .ok (.Ok base)
  nativePresent : base.view.native = some native

structure BeforeLive {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot)
    extends NativeRead host serde tx ns intent now input where
  completedOriginal : ParentCalls.hasCompletedOriginalExecution native localValue = .ok true
  historicalRunning : base.view.historical_result = some (.Running native.generation)
  historicalMatch : ParentCalls.equalOperationResult (.Running native.generation) (.Running native.generation) = .ok true

structure Continued {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot)
    extends NativeRead host serde tx ns intent now input where
  connection : rusqlite.Connection
  completedOriginal : ParentCalls.hasCompletedOriginalExecution native localValue = .ok false
  connectionRead : ParentCalls.transactionConnection tx = .ok connection

structure EntryReady {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot)
    extends Found host serde tx ns intent now input where
  entry : Entry
  sourceIncarnation : sandproof_protocol.lifecycle.identity.IncarnationId
  captureId : sandproof_protocol.lifecycle.identity.CaptureId
  getEntry : session.entries.val[e.val]? = some entry
  isCurrent : state.current = true
  nonterminal : state.terminal = false
  noResolution : entry.unload_resolution = none
  unload : intent.request.operation = .Unload sourceIncarnation captureId

structure BootReady {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot)
    extends EntryReady host serde tx ns intent now input where
  boot : HostEpoch
  bootObservation : input.inbox.host_epoch_observation = some boot
  activeObservation : input.active = some boot
  bootMatch : ParentCalls.equalHostObservation boot boot = .ok true

structure BeforeEncoding {E : Type} (host : host_contract.HostEvidence E)
    (serde : serde_core.de.DeserializeOwned E) (tx : rusqlite.transaction.Transaction)
    (ns : Str) (intent : Intent) (now : I64) (input : SourceSnapshot)
    extends Options host serde tx ns intent now input where
  credential : Credential
  credentialRead : ParentCalls.readCredential connection input.world ns localValue.sandbox true = .ok (.Ok (some credential))
  sameGeneration : credential.1 = native.generation
  cloneUnload : ParentCalls.cloneCompleteIntent intent = .ok intent
  cloneNode : ParentCalls.cloneNode input.inbox.config.node = .ok input.inbox.config.node
  cloneRegistration : ParentCalls.cloneHostRegistration boot.registration = .ok boot.registration
  cloneSource : ParentCalls.cloneProcessIdentity source = .ok source

variable {E : Type} {host : host_contract.HostEvidence E} {serde : serde_core.de.DeserializeOwned E}
variable {tx : rusqlite.transaction.Transaction} {ns : Str} {intent : Intent} {now : I64} {input : SourceSnapshot}

theorem base_error_skips_question (reads : Selected host serde tx ns intent now input)
    (error : JournalError) (failed : ParentCalls.readBaseSnapshot tx ns input.world reads.originEntry.intent reads.context = .ok (.Err error)) :
    NoQuestion host serde tx ns intent now input error := by
  intro encode
  simp only [controller.lifecycle_inbox.source_work.snapshot.current,
    controller.lifecycle_inbox.model.Inbox.find, reads.find, core.result.Result.Insts.CoreOpsTry.branch,
    core.option.Option.ok_or, alloc.vec.Vec.index_slice_index, alloc.vec.Vec.index_usize, alloc.vec.Vec.getElem?_Nat_eq,
    controller.lifecycle_inbox.model.Inbox.state, core.option.Option.is_some, reads.unload, core.option.Option.as_ref,
    reads.bootObservation, core.cmp.PartialEq.ne.trait_default, core.cmp.PartialEq.ne.default,
    core.option.Option.Insts.CoreCmpPartialEqOption.eq, reads.activeObservation, core.cmp.impls.PartialEqShared.eq,
    capture.HostEpochObservation.Insts.CoreCmpPartialEqHostEpochObservation.eq, Bool.not_eq_true, Bool.decide_eq_false,
    controller.lifecycle_inbox.model.Session.current_execution_origin,
    sandproof_protocol.lifecycle.authority.AcceptedLifecycleIntent.Insts.CoreCloneClone.clone,
    controller.lifecycle_inbox.model.LifecycleInboxConfig.context, reads.contextRead,
    controller.lifecycle_inbox.readiness.snapshot.base_snapshot,
    controller.lifecycle_inbox.readiness.NativeCreateSnapshot.has_completed_original_execution, reduceCtorEq, imp_self,
    implies_true, sandbox_controller_core.model.OperationResult.Insts.CoreCmpPartialEqOperationResult.eq,
    controller.lifecycle_inbox.source_work.snapshot.live_native, controller.capture.original_source,
    alloc.string.String.Insts.CoreCmpPartialEqString.eq, controller.lifecycle_inbox.readiness.snapshot.startup_records,
    rusqlite.transaction.Transaction.Insts.CoreOpsDerefDerefConnection.deref, controller.admission.read_create_options,
    core.result.Result.map_err,
    controller.lifecycle_inbox.source_work.snapshot.current.closure.Insts.CoreOpsFunctionFnOnceTupleAdmissionErrorJournalError.call_once,
    bind_tc_ok, controller.data_credentials.snapshot, bne_iff_ne, ne_eq, UScalar.neq_to_neq_val,
    core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual, ite_not,
    core.convert.FromSame.from, bind_assoc, Bool.not_eq_eq_eq_not, Bool.not_true, reads.bootMatch, Bool.true_eq_false,
    ↓reduceIte, uncurry_apply_pair, reads.getSession, reads.stateRead, reads.isCurrent, reads.nonterminal,
    Bool.false_eq_true, reads.localBinding, reads.getEntry, reads.originRead, reads.cloneOrigin, failed,
    reads.noResolution, Option.isSome_none]

