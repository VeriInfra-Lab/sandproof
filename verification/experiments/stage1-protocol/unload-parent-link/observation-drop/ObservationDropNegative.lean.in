import ObservationDropCore
import SandboxModel.ProofAuditCommand

open Aeneas Aeneas.Std Result
open SandproofSqliteRust
open SandproofSqliteRust.Model
open SandboxModel.Stage1Protocol.ObservationDropCore

set_option autoImplicit false

namespace SandboxModel.Stage1Protocol.ObservationDropNegative

local notation "controller.transaction.memo.Cells" => ObservationDropCore.controller.transaction.memo.Cells
local notation "rusqlite.error.Error" => SandproofSqliteRust.rusqlite.error.Error

set_option linter.unusedVariables false in
-- ACTUAL WRONG ROLLBACK

theorem retained_memo_violates_failed_rollback {W T R : Type}
    (state : Slots W) (tx : T)
    (api : core.ops.function.FnOnce R T (core.result.Result Unit rusqlite.error.Error))
    (rollback : R) (error : rusqlite.error.Error)
    (reply : api.call_once rollback tx = .ok (.Err error))
    (present : state.committed ≠ none) :
    controller.transaction.memo.rollback_if_live (ObservationDropCore.slotOps W) api (some tx) state rollback ≠
      .ok (none, {state with committed := none}) := by
  intro equal
  simp [controller.transaction.memo.rollback_if_live, reply,
    core.option.Option.take, core.result.Result.is_err] at equal
  exact present (congrArg (fun (s : Slots W) => s.committed) equal)

end SandboxModel.Stage1Protocol.ObservationDropNegative

#audit_controller_proof SandboxModel.Stage1Protocol.ObservationDropNegative.retained_memo_violates_failed_rollback
