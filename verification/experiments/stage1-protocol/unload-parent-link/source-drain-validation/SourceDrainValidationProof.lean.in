#audit_controller_proof SandboxModel.Stage1Protocol.SourceDrainValidationProof.complete_contract
#audit_controller_proof SandboxModel.Stage1Protocol.SourceDrainValidationProof.writer_actual_contract
#audit_controller_proof SandboxModel.Stage1Protocol.SourceDrainValidationProof.complete_writer_contract

open Aeneas Aeneas.Std Result SandproofSourceRetentionProviders
open SandboxModel.Stage1Protocol SourceRetireTypes SourceTerminalMatchTypes SourceDrainValidationModel
set_option autoImplicit false
namespace SandboxModel.Stage1Protocol.SourceDrainValidationProof
noncomputable section

theorem actual_question_error_before_observation (io : Ports) (record : Record) (stop : Stop)
    (observed : Observation) (error : Journal)
    (failed : SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.question.from_saved
      record stop observed = .ok (.Err error)) :
    SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.validate_record
      io record stop observed = .ok (.Err error) := by
  unfold SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.validate_record
  rw [failed]
  simp [core.result.Result.Insts.CoreOpsTry.branch,
    core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]

theorem actual_first_question_error (io : Ports) (record : Record) (stop : Stop)
    (observed : Observation) (error : Journal) (represented : Representable record)
    (failed : SourceSavedQuestionModel.outcome record stop observed = .ok (.Err error)) :
    SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.validate_record
      io record stop observed = .ok (.Err error) := by
  rw [actual_contract io record stop observed represented]
  exact question_error_first io record stop observed error failed

theorem actual_match_error_before_prior (io : Ports) (record : Record) (stop : Stop)
    (observed : Observation) (work : Work) (error : SourceTerminalMatchModel.JsonError)
    (represented : Representable record)
    (ready : SourceSavedQuestionModel.outcome record stop observed = .ok (.Ok work))
    (failed : SourceTerminalMatchModel.outcome io observed work = .ok (.Err error)) :
    SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.validate_record
      io record stop observed = .ok (.Err (.Json error)) := by
  rw [actual_contract io record stop observed represented]
  exact match_error_before_prior io record stop observed work error ready failed

theorem actual_match_false_before_prior (io : Ports) (record : Record) (stop : Stop)
    (observed : Observation) (work : Work) (represented : Representable record)
    (ready : SourceSavedQuestionModel.outcome record stop observed = .ok (.Ok work))
    (failed : SourceTerminalMatchModel.outcome io observed work = .ok (.Ok false)) :
    SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.validate_record
      io record stop observed = .ok (.Err .CorruptStore) := by
  rw [actual_contract io record stop observed represented]
  exact match_false_before_prior io record stop observed work ready failed

theorem actual_successful_match_continues_prior (io : Ports) (record : Record) (stop : Stop)
    (observed : Observation) (work : Work) (represented : Representable record)
    (ready : SourceSavedQuestionModel.outcome record stop observed = .ok (.Ok work))
    (matched : SourceTerminalMatchModel.outcome io observed work = .ok (.Ok true)) :
    SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.validate_record
      io record stop observed = priorOutcome io record := by
  rw [actual_contract io record stop observed represented]
  exact successful_match_continues_to_prior io record stop observed work ready matched

theorem actual_prior_false (io : Ports) (record : Record) (stop : Stop)
    (observed : Observation) (work : Work) (prior : Prior) (represented : Representable record)
    (ready : SourceSavedQuestionModel.outcome record stop observed = .ok (.Ok work))
    (matched : SourceTerminalMatchModel.outcome io observed work = .ok (.Ok true))
    (present : savedPrior record = some prior)
    (refused : SourcePriorEndMatchModel.outcome io.full record prior = .ok (.Ok false)) :
    SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.validate_record
      io record stop observed = .ok (.Err .CorruptStore) := by
  rw [actual_successful_match_continues_prior io record stop observed work represented ready matched]
  exact prior_false io record prior present refused

theorem actual_prior_error (io : Ports) (record : Record) (stop : Stop)
    (observed : Observation) (work : Work) (prior : Prior) (error : Journal)
    (represented : Representable record)
    (ready : SourceSavedQuestionModel.outcome record stop observed = .ok (.Ok work))
    (matched : SourceTerminalMatchModel.outcome io observed work = .ok (.Ok true))
    (present : savedPrior record = some prior)
    (failed : SourcePriorEndMatchModel.outcome io.full record prior = .ok (.Err error)) :
    SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.validate_record
      io record stop observed = .ok (.Err error) := by
  rw [actual_successful_match_continues_prior io record stop observed work represented ready matched]
  exact prior_error io record prior error present failed

theorem actual_writer_missing_capture (io : Ports) (record : Record) (absent : record.capture = none) :
    SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.writer_closed io record = .ok (.Ok false) := by
  unfold SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.writer_closed
  simp [absent]

theorem actual_writer_missing_end (io : Ports) (record : Record)
    (captured : controller.lifecycle_inbox.source_work.full.CaptureWork)
    (present : record.capture = some captured) (absent : captured.«end» = none) :
    SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.writer_closed io record = .ok (.Ok false) := by
  unfold SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.writer_closed
  simp [present, absent]

theorem actual_writer_failed_validation (io : Ports) (record : Record)
    (captured : controller.lifecycle_inbox.source_work.full.CaptureWork)
    (stop : Stop) (observed : Observation) (prior : Option Prior) (error : Journal)
    (present : record.capture = some captured)
    (ended : captured.«end» = some (.Terminated stop observed prior))
    (failed : SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.validate_record
      io record stop observed = .ok (.Err error)) :
    SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.writer_closed io record = .ok (.Err error) := by
  unfold SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.writer_closed
  simp [present, ended, failed, core.result.Result.Insts.CoreOpsTry.branch,
    core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual]

theorem actual_writer_validated_success (io : Ports) (record : Record)
    (captured : controller.lifecycle_inbox.source_work.full.CaptureWork)
    (stop : Stop) (observed : Observation) (prior : Option Prior)
    (present : record.capture = some captured)
    (ended : captured.«end» = some (.Terminated stop observed prior))
    (accepted : SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.validate_record
      io record stop observed = .ok (.Ok ())) :
    SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.writer_closed io record = .ok (.Ok true) := by
  unfold SourceDrainValidationActual.controller.lifecycle_inbox.source_work.full.drain.writer_closed
  simp [present, ended, accepted, core.result.Result.Insts.CoreOpsTry.branch]

end
end SandboxModel.Stage1Protocol.SourceDrainValidationProof

