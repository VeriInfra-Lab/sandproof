#audit_controller_proof SandboxModel.Stage1Protocol.SourceDrainValidationValues.writer_bad_prior_rejected
#audit_controller_proof SandboxModel.Stage1Protocol.SourceDrainValidationValues.writer_completed_no_request_rejected
#audit_controller_proof SandboxModel.Stage1Protocol.SourceDrainValidationValues.writer_missing_capture_control
