import SandboxModel.Lifecycle.Protocol.InboxEntryValues
import SandboxModel.Lifecycle.Protocol.UnloadProofs
import SandboxModel.Lifecycle.Protocol.RenewalResultBindings

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox.model
namespace SandboxModel.Stage1Protocol.InboxEntry
open scoped Classical
open Values
noncomputable section

theorem wrong_single_count (count : Usize) :
    (sessionFor createEntry).count_entry_key_from createEntry.intent.request.binding.key count = .ok 1#usize := by
  unfold Session.count_entry_key_from
  simp only [SharedAVec.Insts.CoreIterTraitsCollectIntoIteratorSharedATIter.into_iter,
    core.slice.Slice.iter, bind_tc_ok]
  unfold Session.count_entry_key_from_loop
  rw [loop]
  simp [Session.count_entry_key_from_loop.body, core.slice.iter.IteratorSliceIter.next,
    sessionFor, Values.singleton, alloc.vec.Vec.deref, Slice.len, Replay.key_eq]
  rw [loop]
  simp

def duplicateIter (index : Nat) : core.slice.iter.Iter Session :=
  ⟨Slice.from [sessionFor createEntry, sessionFor createEntry] (by scalar_tac), index⟩

theorem duplicate_next_zero : core.slice.iter.IteratorSliceIter.next (duplicateIter 0) =
    .ok (some (sessionFor createEntry), duplicateIter 1) := by rfl

theorem duplicate_next_one : core.slice.iter.IteratorSliceIter.next (duplicateIter 1) =
    .ok (some (sessionFor createEntry), duplicateIter 2) := by rfl

theorem duplicate_next_two : core.slice.iter.IteratorSliceIter.next (duplicateIter 2) =
    .ok (none, duplicateIter 2) := by rfl

theorem wrong_duplicate_count :
    duplicated.count_entry_key createEntry.intent.request.binding.key = .ok 1#usize := by
  unfold Inbox.count_entry_key
  simp only [SharedAVec.Insts.CoreIterTraitsCollectIntoIteratorSharedATIter.into_iter,
    core.slice.Slice.iter, bind_tc_ok]
  change Inbox.count_entry_key_loop (duplicateIter 0) createEntry.intent.request.binding.key 0#usize = .ok 1#usize
  unfold Inbox.count_entry_key_loop
  rw [loop]
  simp [Inbox.count_entry_key_loop.body, duplicate_next_zero, wrong_single_count]
  rw [loop]
  simp [duplicate_next_one, wrong_single_count]
  rw [loop]
  simp [duplicate_next_two]

theorem wrong_duplicate_accepts :
    run encode duplicated (sessionFor createEntry) createEntry EnvelopeValues.context = .ok (.Ok 0#usize) := by
  have accepted := Validation.envelope_refines createEntry.intent EnvelopeValues.context
  have legal := (Validation.expectedAccepted_success_iff _ _).mpr normal_envelopes.1
  simp only [accepted_validate, legal] at accepted
  unfold run Inbox.entry_kind_using
  rw [UnloadResolution.validate_entry_spec]
  simp only [show UnloadResolution.validateView encode createEntry = .ok (.Ok ()) from rfl,
    bind_tc_ok, core.result.Result.Insts.CoreOpsTry.branch, accepted,
    RenewalResultTag.actual_is_err, RenewalResultTag.IsError]
  simp only [wrong_duplicate_count]
  simp [core.cmp.PartialEq.ne.trait_default, core.cmp.PartialEq.ne.default, Replay.retention_eq,
    sandproof_protocol.lifecycle.identity.SessionId.Insts.CoreCmpPartialEqSessionId.eq,
    sandproof_protocol.SandboxId.Insts.CoreCmpPartialEqSandboxId.eq,
    sandproof_protocol.TenantId.Insts.CoreCmpPartialEqTenantId.eq,
    alloc.string.String.Insts.CoreCmpPartialEqString.eq,
    SandproofFoundationsRust.alloc.string.String.Insts.CoreCmpPartialEqString.eq,
    sessionFor, createEntry, intentFor, EnvelopeValues.intent, duplicated, inboxFor,
    core.option.Option.is_none, core.option.Option.is_some,
    alloc.vec.Vec.len, Validation.Examples.createPayload, lift]

theorem duplicate_omission_refutes_full_contract : ¬ FullEntryContract run := by
  intro contract
  have same := contract encode duplicated (sessionFor createEntry) createEntry EnvelopeValues.context
  rw [wrong_duplicate_accepts, expected_outcomes.2.2.2.2.2.1] at same
  simp [corrupt] at same

end
end SandboxModel.Stage1Protocol.InboxEntry

#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.wrong_single_count
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.duplicate_next_zero
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.duplicate_next_one
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.duplicate_next_two
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.wrong_duplicate_count
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.wrong_duplicate_accepts
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.duplicate_omission_refutes_full_contract
