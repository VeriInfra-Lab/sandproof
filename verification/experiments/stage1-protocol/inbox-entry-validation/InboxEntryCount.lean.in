#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.entries_loop_refines
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.entries_refines
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.sessions_loop_end
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.sessions_loop_step
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.sessions_loop_refines
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.count_with_bindings
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.candidate_iterator_binding
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.candidate_count_contract
