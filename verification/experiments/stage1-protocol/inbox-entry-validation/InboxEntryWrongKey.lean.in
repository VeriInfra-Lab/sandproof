import SandboxModel.Lifecycle.Protocol.InboxEntryValues
import SandboxModel.Lifecycle.Protocol.UnloadProofs
import SandboxModel.Lifecycle.Protocol.RenewalResultBindings

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox.model
namespace SandboxModel.Stage1Protocol.InboxEntry
open scoped Classical
open Values
noncomputable section

theorem wrong_sequence_single (stored : Entry) (count next : Usize)
    (same : stored.intent.request.binding.key.sequence = createEntry.intent.request.binding.key.sequence)
    (addition : (count + 1#usize : Result Usize) = .ok next) :
    (sessionFor stored).count_entry_key_from createEntry.intent.request.binding.key count = .ok next := by
  unfold Session.count_entry_key_from
  simp only [SharedAVec.Insts.CoreIterTraitsCollectIntoIteratorSharedATIter.into_iter,
    core.slice.Slice.iter, bind_tc_ok]
  unfold Session.count_entry_key_from_loop
  rw [loop]
  simp [Session.count_entry_key_from_loop.body, core.slice.iter.IteratorSliceIter.next,
    sessionFor, Values.singleton, alloc.vec.Vec.deref, Slice.len,
    sandproof_protocol.lifecycle.identity.RequestSequence.Insts.CoreCmpPartialEqRequestSequence.eq,
    sandproof_protocol.internal.PositiveCounter.Insts.CoreCmpPartialEqPositiveCounter.eq,
    same, addition]
  rw [loop]
  simp

def keyIter (index : Nat) : core.slice.iter.Iter Session :=
  ⟨Slice.from [sessionFor createEntry, sessionFor changedOwner] (by scalar_tac), index⟩

theorem key_next_zero : core.slice.iter.IteratorSliceIter.next (keyIter 0) =
    .ok (some (sessionFor createEntry), keyIter 1) := by rfl

theorem key_next_one : core.slice.iter.IteratorSliceIter.next (keyIter 1) =
    .ok (some (sessionFor changedOwner), keyIter 2) := by rfl

theorem key_next_two : core.slice.iter.IteratorSliceIter.next (keyIter 2) =
    .ok (none, keyIter 2) := by rfl

theorem wrong_sequence_count :
    distinctKeys.count_entry_key createEntry.intent.request.binding.key = .ok 2#usize := by
  have addZero : (0#usize + 1#usize : Result Usize) = .ok 1#usize := by simpa [count_add_one] using count_result_val 1#usize
  have addOne : (1#usize + 1#usize : Result Usize) = .ok 2#usize := by simpa [count_add_one] using count_result_val 2#usize
  have first := wrong_sequence_single createEntry 0#usize 1#usize rfl addZero
  have second := wrong_sequence_single changedOwner 1#usize 2#usize rfl addOne
  unfold Inbox.count_entry_key
  simp only [SharedAVec.Insts.CoreIterTraitsCollectIntoIteratorSharedATIter.into_iter,
    core.slice.Slice.iter, bind_tc_ok]
  change Inbox.count_entry_key_loop (keyIter 0) createEntry.intent.request.binding.key 0#usize = .ok 2#usize
  unfold Inbox.count_entry_key_loop
  rw [loop]
  simp [Inbox.count_entry_key_loop.body, key_next_zero, first]
  rw [loop]
  simp [key_next_one, second]
  rw [loop]
  simp [key_next_two]

theorem wrong_sequence_rejects :
    run encode distinctKeys (sessionFor createEntry) createEntry EnvelopeValues.context = .ok corrupt := by
  have accepted := Validation.envelope_refines createEntry.intent EnvelopeValues.context
  have legal := (Validation.expectedAccepted_success_iff _ _).mpr normal_envelopes.1
  simp only [accepted_validate, legal] at accepted
  unfold run Inbox.entry_kind_using
  rw [UnloadResolution.validate_entry_spec]
  simp only [show UnloadResolution.validateView encode createEntry = .ok (.Ok ()) from rfl,
    bind_tc_ok, core.result.Result.Insts.CoreOpsTry.branch, accepted,
    RenewalResultTag.actual_is_err, RenewalResultTag.IsError]
  simp only [wrong_sequence_count]
  simp [core.cmp.PartialEq.ne.trait_default, core.cmp.PartialEq.ne.default, Replay.retention_eq,
    sandproof_protocol.lifecycle.identity.SessionId.Insts.CoreCmpPartialEqSessionId.eq,
    sandproof_protocol.SandboxId.Insts.CoreCmpPartialEqSandboxId.eq,
    sandproof_protocol.TenantId.Insts.CoreCmpPartialEqTenantId.eq,
    alloc.string.String.Insts.CoreCmpPartialEqString.eq,
    SandproofFoundationsRust.alloc.string.String.Insts.CoreCmpPartialEqString.eq,
    sessionFor, createEntry, intentFor, EnvelopeValues.intent, distinctKeys, inboxFor,
    core.option.Option.is_none, core.option.Option.is_some,
    alloc.vec.Vec.len, Validation.Examples.createPayload, lift, corrupt]

theorem sequence_only_refutes_full_contract : ¬ FullEntryContract run := by
  intro contract
  have same := contract encode distinctKeys (sessionFor createEntry) createEntry EnvelopeValues.context
  rw [wrong_sequence_rejects, expected_outcomes.2.2.2.2.2.2.1] at same
  simp [corrupt] at same

end
end SandboxModel.Stage1Protocol.InboxEntry

#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.wrong_sequence_single
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.key_next_zero
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.key_next_one
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.key_next_two
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.wrong_sequence_count
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.wrong_sequence_rejects
#audit_controller_proof SandboxModel.Stage1Protocol.InboxEntry.sequence_only_refutes_full_contract
