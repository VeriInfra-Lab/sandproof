import SandboxModel.Lifecycle.Protocol.InboxLineageModel
import SandboxModel.Lifecycle.Protocol.EnvelopeValues
import SandboxModel.Lifecycle.Protocol.ValidationExamples

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_protocol.lifecycle.authority sandproof_protocol.lifecycle.identity
open sandproof_protocol.lifecycle.request
namespace SandboxModel.Stage1Protocol.InboxLineage.Values

def create : AcceptedLifecycleIntent := {
  (EnvelopeValues.intent 1#u64) with request := {
    (EnvelopeValues.intent 1#u64).request with
    binding := { (EnvelopeValues.intent 1#u64).request.binding with expected := .Absent },
    operation := .Create Validation.Examples.createPayload 1#u64 } }

def follow (version previous : U64) (operation : LifecycleOperation) : AcceptedLifecycleIntent := { create with
  accepted_version := version,
  request := { create.request with
    operation := operation,
    binding := { create.request.binding with
      expected := .Version previous,
      key := { create.request.binding.key with sequence := version } } } }

def unload : AcceptedLifecycleIntent := follow 2#u64 1#u64 (.Unload 1#u64 1#u64)
def resume (target : U64) : AcceptedLifecycleIntent :=
  follow 3#u64 2#u64 (.Resume 1#u64 1#u64 target Request.digest)
def nextUnload (capture : U64) : AcceptedLifecycleIntent :=
  follow 4#u64 3#u64 (.Unload 2#u64 capture)
def renew : AcceptedLifecycleIntent := follow 2#u64 1#u64 (.Renew 1#u64 100#i64 false)
def destroy : AcceptedLifecycleIntent := follow 3#u64 2#u64 .Destroy

def entry (intent : AcceptedLifecycleIntent) (operation : Option U64) : Entry :=
  ⟨intent, operation, none, none, none⟩

def session (incarnation : Option IncarnationId) (entries : alloc.vec.Vec Entry) : Session := {
  id := create.request.binding.session, retention := create.retention,
  owner := create.request.binding.key.owner,
  current_version := (entries.val.getLast?.map (·.intent.accepted_version)).getD 0#u64,
  terminal := match entries.val.getLast? with
    | some last => match last.intent.request.operation with | .Destroy => true | _ => false
    | none => false,
  refusal := none, incarnation := incarnation, «local» := some ⟨10#u64, 20#u64, 30#u64⟩,
  entries := entries, confirmed_terminal := none, confirmed_renewal := none,
  compacted_sdk_through := none, native_retirement := none }

def created : Session := session (some 1#u64)
  (alloc.vec.Vec.from [entry create (some 30#u64)] (by scalar_tac))
def resumed (attached : Bool) : Session := session (some (if attached then 2#u64 else 1#u64))
  (alloc.vec.Vec.from [entry create (some 30#u64), entry unload none,
    entry (resume 2#u64) (if attached then some 31#u64 else none)] (by scalar_tac))
def repeatedCapture : Session := session (some 2#u64)
  (alloc.vec.Vec.from [entry create (some 30#u64), entry unload none,
    entry (resume 2#u64) (some 31#u64), entry (nextUnload 1#u64) none] (by scalar_tac))
def advancedCapture : Session := { repeatedCapture with
  entries := alloc.vec.Vec.from [entry create (some 30#u64), entry unload none,
    entry (resume 2#u64) (some 31#u64), entry (nextUnload 2#u64) none] (by scalar_tac) }
def storedMismatch : Session := { created with incarnation := some 2#u64 }
def gap : Session := session (some 1#u64)
  (alloc.vec.Vec.from [entry create (some 30#u64), entry unload none,
    entry (resume 9#u64) none] (by scalar_tac))
def renewedDestroyed : Session := session (some 1#u64)
  (alloc.vec.Vec.from [entry create (some 30#u64), entry renew none,
    entry destroy none] (by scalar_tac))

theorem inputs_valid :
    Validation.ValidEnvelope create EnvelopeValues.context ∧
    Validation.ValidEnvelope unload EnvelopeValues.context ∧
    Validation.ValidEnvelope (resume 2#u64) EnvelopeValues.context ∧
    Validation.ValidEnvelope (resume 9#u64) EnvelopeValues.context ∧
    Validation.ValidEnvelope (nextUnload 1#u64) EnvelopeValues.context ∧
    Validation.ValidEnvelope (nextUnload 2#u64) EnvelopeValues.context ∧
    Validation.ValidEnvelope renew EnvelopeValues.context ∧
    Validation.ValidEnvelope destroy EnvelopeValues.context := by
  have add1 : U64.checked_add 1#u64 1#u64 = some 2#u64 := by decide
  have add2 : U64.checked_add 2#u64 1#u64 = some 3#u64 := by decide
  have add3 : U64.checked_add 3#u64 1#u64 = some 4#u64 := by decide
  simp [Validation.ValidEnvelope, Validation.ValidRequest, Validation.headersOK,
    Validation.expectationOK, Validation.operationOK, Validation.retentionOK,
    Validation.versionOK, create, follow, unload, resume, nextUnload, renew, destroy,
    EnvelopeValues.intent, EnvelopeValues.context, EnvelopeValues.node, EnvelopeValues.center,
    Validation.Examples.createPayload, Validation.createView, Validation.resourceView,
    SandboxModel.Foundations.CreatePlan.valid, SandboxModel.Foundations.ResourceVector.positive,
    SandboxModel.Foundations.maxCounter, add1, add2, add3]

theorem expected_outcomes :
    expectedResult created = .Ok () ∧
    expectedResult (resumed false) = .Ok () ∧
    expectedResult (resumed true) = .Ok () ∧
    expectedResult advancedCapture = .Ok () ∧
    expectedResult renewedDestroyed = .Ok () ∧
    expectedResult repeatedCapture = .Err .CorruptStore ∧
    expectedResult storedMismatch = .Err .CorruptStore ∧
    expectedResult gap = .Err .CorruptStore := by
  exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

end SandboxModel.Stage1Protocol.InboxLineage.Values

#audit_controller_proof SandboxModel.Stage1Protocol.InboxLineage.Values.inputs_valid
#audit_controller_proof SandboxModel.Stage1Protocol.InboxLineage.Values.expected_outcomes
