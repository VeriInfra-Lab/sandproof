import SandboxModel.Lifecycle.Protocol.InboxOriginWitnessSupport
import SandboxModel.Lifecycle.Protocol.InboxOriginValues

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox.model
namespace SandboxModel.Stage1Protocol.OriginSelection
noncomputable section

namespace WrongLocal
theorem skipped : Session.current_execution_origin_loop.body Values.resumeCase.entries 2#usize =
    .ok (.cont 1#usize) := by
  have sub : ((2#usize - 1#usize) : Result Usize) = .ok 1#usize :=
    subtract_one _ _ (by decide) (by decide)
  simp [Session.current_execution_origin_loop.body, core.option.Option.is_some, sub,
    alloc.vec.Vec.index_slice_index, alloc.vec.Vec.index_usize,
    Values.resumeCase, Values.session, Values.created, Values.resumed, Values.entry,
    Values.create, Values.resume, Values.follow]

theorem first : Session.current_execution_origin_loop.body Values.resumeCase.entries 1#usize =
    .ok (.done (some Values.created)) := by
  have sub : ((1#usize - 1#usize) : Result Usize) = .ok 0#usize :=
    subtract_one _ _ (by decide) (by decide)
  simp [Session.current_execution_origin_loop.body, core.option.Option.is_some, sub,
    alloc.vec.Vec.index_slice_index, alloc.vec.Vec.index_usize,
    Values.resumeCase, Values.session, Values.created, Values.resumed, Values.entry,
    Values.create, Values.resume, Values.follow]

theorem actual_return : Session.current_execution_origin Values.resumeCase = .ok (some Values.created) := by
  unfold Session.current_execution_origin
  change Session.current_execution_origin_loop Values.resumeCase.entries 2#usize = _
  rw [loop_continue _ _ _ skipped, loop_done _ _ _ first]

theorem refutes_full_contract : ¬FullOriginContract Session.current_execution_origin := by
  intro contract
  have wrong := contract Values.resumeCase
  rw [actual_return, Values.expected_outcomes.1] at wrong
  exact Values.distinctions.1 (by simpa only [Result.ok.injEq, Option.some.injEq] using wrong)

end WrongLocal
end
end SandboxModel.Stage1Protocol.OriginSelection

#audit_controller_proof SandboxModel.Stage1Protocol.OriginSelection.WrongLocal.skipped
#audit_controller_proof SandboxModel.Stage1Protocol.OriginSelection.WrongLocal.first
#audit_controller_proof SandboxModel.Stage1Protocol.OriginSelection.WrongLocal.actual_return
#audit_controller_proof SandboxModel.Stage1Protocol.OriginSelection.WrongLocal.refutes_full_contract
