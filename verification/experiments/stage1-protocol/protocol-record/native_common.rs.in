// Append to the original lifecycle_inbox::tests module. These use the real
// ControllerJournal, standard providers, database and transaction wrapper.
fn proof_caller_inbox_row(journal: &ControllerJournal) -> (Vec<u8>, Vec<u8>, i64) {
    journal
        .journal
        .connection
        .query_row(
            "SELECT state_json,sha256,reserve_bytes FROM controller_lifecycle_inbox WHERE id=1",
            [],
            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
        )
        .unwrap()
}

#[derive(Default)]
struct ProofCallerCommitTrace(Vec<CrashPoint>);

impl CrashInjector for ProofCallerCommitTrace {
    fn hit(&mut self, point: CrashPoint) -> Result<(), JournalError> {
        self.0.push(point);
        Ok(())
    }
}

#[test]
fn proof_caller_foreign_node_refuses_without_changing_complete_inbox_or_world() {
    let dir = tempfile::tempdir().unwrap();
    let path = dir.path().join("db");
    let mut journal = initialize(&path);
    let intent = create("alpha", "session-a");
    let mut node = config().node;
    node.node_generation = 2.try_into().unwrap();
    let foreign =
        AuthenticatedCenterContext::from_verified_peer_registration(config().center, node);
    let before_row = proof_caller_inbox_row(&journal);
    let before_world = journal.world().unwrap();
    let mut commits = ProofCallerCommitTrace::default();
    assert!(matches!(
        journal.record_lifecycle_intent(&intent, &foreign, &mut commits),
        Err(JournalError::Conflict)
    ));
    assert!(commits.0.is_empty());
    assert_eq!(proof_caller_inbox_row(&journal), before_row);
    assert_eq!(journal.world().unwrap(), before_world);
}

#[test]
fn proof_caller_full_replay_returns_same_state_before_commit_points() {
    let dir = tempfile::tempdir().unwrap();
    let path = dir.path().join("db");
    let mut journal = initialize(&path);
    let intent = create("alpha", "session-a");
    let expected = journal
        .record_lifecycle_intent(&intent, &context(), &mut NeverCrash)
        .unwrap();
    let before_row = proof_caller_inbox_row(&journal);
    let before_world = journal.world().unwrap();
    let mut commits = ProofCallerCommitTrace::default();
    let actual = journal
        .record_lifecycle_intent(&intent, &context(), &mut commits)
        .unwrap();
    assert_eq!(actual, expected);
    assert!(commits.0.is_empty());
    assert_eq!(proof_caller_inbox_row(&journal), before_row);
    assert_eq!(journal.world().unwrap(), before_world);
}

#[test]
fn proof_caller_destroy_keeps_the_real_new_current_operation_in_full_state() {
    let dir = tempfile::tempdir().unwrap();
    let path = dir.path().join("db");
    let mut journal = initialize(&path);
    let request = create("alpha", "session-a");
    journal
        .record_lifecycle_intent(&request, &context(), &mut NeverCrash)
        .unwrap();
    let admitted = journal
        .admit_lifecycle_create(&request, &context(), admission(), &mut NeverCrash)
        .unwrap();
    let local = admitted.local.unwrap();
    let stop = destroy(&request);
    let result = journal
        .record_lifecycle_intent(&stop, &context(), &mut NeverCrash)
        .unwrap();
    let operation = journal
        .world()
        .unwrap()
        .sandbox_record(local.sandbox)
        .unwrap()
        .current_operation
        .unwrap()
        .id;
    assert_ne!(operation, local.operation);
    assert_eq!(result.intent, stop);
    assert_eq!(result.local, Some(local));
    assert_eq!(result.local_operation, Some(operation));
    assert!(result.current && result.terminal);
    assert_eq!(
        journal.lifecycle_work_state(&stop, &context()).unwrap(),
        result
    );
}
