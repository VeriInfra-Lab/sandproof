import SandboxModel.Lifecycle.Protocol.UnloadLibrary
import SandboxModel.Lifecycle.Protocol.UnloadValues

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox.unload_resolution
namespace SandboxModel.Stage1Protocol.UnloadResolution
open scoped Classical
noncomputable section

theorem wrong_phase_accepts : run Values.encode Values.wrongPhase = .ok (.Ok ()) := by
  simp [run, validate_entry_using, operation_spec, result_spec, resultOf, unload,
    Values.wrongPhase, Values.before, Values.snapshot, Values.facts, Values.intent,
    EnvelopeValues.intent, Values.encode, Values.bytes,
    core.result.Result.Insts.CoreOpsTry.branch, core.option.Option.is_some, core.option.Option.is_none,
    alloc.vec.Vec.len, alloc.vec.Vec.is_empty, SandproofFoundationsRust.alloc.vec.Vec.is_empty]

theorem phase_omission_refutes_full_contract : ¬ FullUnloadContract run := by
  intro contract
  have same := contract Values.encode Values.wrongPhase
  rw [wrong_phase_accepts, Values.expected_outcomes.2.2.2.1] at same
  simp [corrupt] at same

end
end SandboxModel.Stage1Protocol.UnloadResolution

#audit_controller_proof SandboxModel.Stage1Protocol.UnloadResolution.wrong_phase_accepts
#audit_controller_proof SandboxModel.Stage1Protocol.UnloadResolution.phase_omission_refutes_full_contract
