open sandproof_controller_service.controller.lifecycle_inbox.unload_resolution
namespace SandboxModel.Stage1Protocol.UnloadResolution
open scoped Classical
noncomputable section

theorem phase_ne_running (phase : sandbox_controller_core.model.Phase) :
    core.cmp.PartialEq.ne.trait_default sandbox_controller_core.model.Phase.Insts.CoreCmpPartialEqPhase
      phase .Running = .ok (decide (phase ≠ .Running)) := by
  cases phase <;>
    simp [core.cmp.PartialEq.ne.trait_default, core.cmp.PartialEq.ne.default,
      sandbox_controller_core.model.Phase.Insts.CoreCmpPartialEqPhase.eq,
      sandbox_controller_core.model.Phase.read_discriminant]


end
end SandboxModel.Stage1Protocol.UnloadResolution
#audit_controller_proof SandboxModel.Stage1Protocol.UnloadResolution.phase_ne_running
