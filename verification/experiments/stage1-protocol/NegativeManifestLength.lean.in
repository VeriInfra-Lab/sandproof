import SandboxModel.Lifecycle.Protocol.ManifestLengthValues
open Aeneas Aeneas.Std SandproofStage1ManifestRust
namespace SandboxModel.Stage1Protocol.ManifestLength.Negative
open SandboxModel.Stage1Protocol.Manifest
open SandboxModel.Stage1Protocol.ManifestLoop
open SandboxModel.Stage1Protocol.ManifestLength.Values

theorem mutant_wraps_total :
    manifest_validate (value 18446744073709551615#u64 1#u64 1#u64) original profile = .ok (.Ok 1#u64) := by
  rw [validate_enters_length_scan]
  change loop (fileBody 18446744073709551615#u64 1#u64 1#u64) (.Ok 0#u64, 0#usize) = .ok (.Ok 1#u64)
  refine loop_cont _ _ (.Ok 18446744073709551615#u64, 1#usize) _ ?_ ?_
  · have add_one : ((0#usize + 1#usize) : Result Usize) = .ok 1#usize :=
      add_exact _ _ _ (by scalar_tac)
    have wrapped : core.num.U64.wrapping_add 0#u64 18446744073709551615#u64 = 18446744073709551615#u64 := by decide
    have length := state_length 18446744073709551615#u64
    simp only [profile, alloc.vec.Vec.from] at length
    simp [fileBody, sandproof_protocol.lifecycle.manifest.SnapshotManifest.validate_loop.body,
      lengthFiles, alloc.vec.Vec.index, alloc.vec.Vec.from, alloc.vec.Vec.val, Slice.index_usize,
      core.result.Result.is_ok, profile, length, lift, wrapped, add_one]
  refine loop_cont _ _ (.Ok 0#u64, 2#usize) _ ?_ ?_
  · have add_one : ((1#usize + 1#usize) : Result Usize) = .ok 2#usize :=
      add_exact _ _ _ (by scalar_tac)
    have wrapped : core.num.U64.wrapping_add 18446744073709551615#u64 1#u64 = 0#u64 := by decide
    have length := memory_length 1#u64
    simp only [profile, alloc.vec.Vec.from] at length
    simp [fileBody, sandproof_protocol.lifecycle.manifest.SnapshotManifest.validate_loop.body,
      lengthFiles, alloc.vec.Vec.index, alloc.vec.Vec.from, alloc.vec.Vec.val, Slice.index_usize,
      core.result.Result.is_ok, profile, length, lift, wrapped, add_one]
  refine loop_cont _ _ (.Ok 1#u64, 3#usize) _ ?_ ?_
  · have add_one : ((2#usize + 1#usize) : Result Usize) = .ok 3#usize :=
      add_exact _ _ _ (by scalar_tac)
    have wrapped : core.num.U64.wrapping_add 0#u64 1#u64 = 1#u64 := by decide
    have length := disk_length 1#u64
    simp only [profile, alloc.vec.Vec.from] at length
    simp [fileBody, sandproof_protocol.lifecycle.manifest.SnapshotManifest.validate_loop.body,
      lengthFiles, alloc.vec.Vec.index, alloc.vec.Vec.from, alloc.vec.Vec.val, Slice.index_usize,
      core.result.Result.is_ok, profile, length, lift, wrapped, add_one]
  apply loop_done
  simp [fileBody, sandproof_protocol.lifecycle.manifest.SnapshotManifest.validate_loop.body, lengthFiles]

theorem wrapping_not_length_contract : ¬ LengthContract manifest_validate := by
  intro contract
  have exact_sum := (contract (value 18446744073709551615#u64 1#u64 1#u64)
    original profile 1#u64 mutant_wraps_total).1
  have different : (1#u64).val ≠ bytes (value 18446744073709551615#u64 1#u64 1#u64).files.val := by decide
  exact different exact_sum
end SandboxModel.Stage1Protocol.ManifestLength.Negative
#audit_controller_proof SandboxModel.Stage1Protocol.ManifestLength.Negative.mutant_wraps_total
#audit_controller_proof SandboxModel.Stage1Protocol.ManifestLength.Negative.wrapping_not_length_contract
