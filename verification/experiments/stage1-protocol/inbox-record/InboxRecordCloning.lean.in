import SandboxModel.Lifecycle.Protocol.Library
import SandboxModel.Foundations.Cloning
import SandboxModel.ProofAuditCommand

open Aeneas Aeneas.Std SandproofStage1RequestRust
namespace SandboxModel.Stage1Protocol.InboxRecord

@[simp] theorem byte_array_clone (value : Array U8 n) :
    core.array.CloneArray.clone core.clone.CloneU8 value = .ok value := by
  obtain ⟨copy, returned, same⟩ := WP.spec_imp_exists
    (core.array.CloneArray.clone_spec core.clone.CloneU8 value (by intro x member; rfl))
  simpa [← same] using returned

@[simp] theorem byte_vector_clone (value : alloc.vec.Vec U8) :
    alloc.vec.CloneVec.clone core.clone.CloneU8 value = .ok value :=
  SandboxModel.Foundations.vec_clone_exact core.clone.CloneU8 value (by intro x; rfl)

@[simp] theorem string_clone (value : String) :
    alloc.string.String.Insts.CoreCloneClone.clone value = .ok value := rfl

@[simp] theorem SandboxId_clone (value : sandproof_protocol.SandboxId) :
    sandproof_protocol.SandboxId.Insts.CoreCloneClone.clone value = .ok value := by
  simp [sandproof_protocol.SandboxId.Insts.CoreCloneClone.clone]

