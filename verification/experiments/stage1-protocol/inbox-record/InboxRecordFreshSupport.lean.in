import SandboxModel.Lifecycle.Protocol.InboxRecordFreshModel

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_protocol.lifecycle.authority sandproof_protocol.lifecycle.identity
namespace SandboxModel.Stage1Protocol.InboxRecord

@[simp] theorem fresh_entries_push (intent : AcceptedLifecycleIntent) :
    alloc.vec.Vec.push (alloc.vec.Vec.with_capacity Entry 1#usize) (pendingEntry intent) =
      .ok (freshEntries intent) := by
  obtain ⟨entries, pushed, same⟩ := WP.spec_imp_exists
    (alloc.vec.Vec.push_spec (alloc.vec.Vec.with_capacity Entry 1#usize) (pendingEntry intent) (by change 0 < Usize.max; scalar_tac))
  have exact_entries : entries = freshEntries intent := by
    apply alloc.vec.Vec.ext
    simpa [freshEntries, alloc.vec.Vec.with_capacity, alloc.vec.Vec.new] using same
  simpa [exact_entries] using pushed

theorem fresh_push_outcome (inbox : Inbox) (intent : AcceptedLifecycleIntent)
    (terminal : Bool) (incarnation : Option IncarnationId)
    (room : inbox.sessions.val.length < inbox.config.max_sessions.val) :
    ∃ (sessions : alloc.vec.Vec Session) (index : Usize),
      inbox.sessions.push (freshSession intent terminal incarnation) = .ok sessions ∧
      ((alloc.vec.Vec.len sessions - 1#usize) : Result Usize) = .ok index ∧
      index.val = inbox.sessions.val.length ∧
      sessions.val = inbox.sessions.val ++ [freshSession intent terminal incarnation] := by
  have capacity : inbox.sessions.val.length < Usize.max := by scalar_tac
  obtain ⟨sessions, pushed, contents⟩ := WP.spec_imp_exists
    (alloc.vec.Vec.push_spec inbox.sessions (freshSession intent terminal incarnation) capacity)
  have length : sessions.val.length = inbox.sessions.val.length + 1 := by simp [contents]
  obtain ⟨index, subtracted, post⟩ := WP.spec_imp_exists
    (Usize.sub_spec (x := alloc.vec.Vec.len sessions) (y := 1#usize) (by simp; omega))
  refine ⟨sessions, index, pushed, subtracted, ?_, contents⟩
  simp only [alloc.vec.Vec.len_val] at post
  scalar_tac


end SandboxModel.Stage1Protocol.InboxRecord

#audit_controller_proof SandboxModel.Stage1Protocol.InboxRecord.fresh_entries_push
#audit_controller_proof SandboxModel.Stage1Protocol.InboxRecord.fresh_push_outcome
