#audit_controller_proof SandboxModel.Stage1Protocol.InboxLoad.Values.policy_fixture_to_body
#audit_controller_proof SandboxModel.Stage1Protocol.InboxLoad.Values.wrong_policy_model_rejected
#audit_controller_proof SandboxModel.Stage1Protocol.InboxLoad.Values.wrong_policy_contract_rejected
