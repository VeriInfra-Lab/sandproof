-- Retained raw control-flow correspondence from the physically checked layout.
-- This is a comparison-level intermediate representation, not a second full
-- protocol contract. A separate equality must connect it to InboxLoadModel;
-- until then it does not establish the shared FullLoadContract.
import SandboxModel.Lifecycle.Protocol.InboxLoadHeader
import SandboxModel.Lifecycle.Protocol.InboxLoadConfigComposition

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service
open sandproof_controller_service.capture
open sandproof_controller_service.controller.lifecycle_inbox.codec
open sandproof_controller_service.controller.lifecycle_inbox.native_retirement
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_controller_service.controller.lifecycle_inbox.renewal_confirmation
open sandproof_controller_service.controller.lifecycle_inbox.unload_resolution

namespace SandboxModel.Stage1Protocol.InboxLoad.Raw
noncomputable section

abbrev Outcome (E : Type) := Result (core.result.Result (Option Inbox) JournalError × E)
abbrev Check := Result (core.result.Result Unit JournalError)

def attempt {E α : Type} (run : Result (core.result.Result α JournalError × E))
    (next : α → E → Outcome E) : Outcome E := do
  let (result, after) ← run
  match result with
  | .Ok value => next value after
  | .Err error => .ok (.Err error, after)

def corrupt {E : Type} (state : E) : Outcome E := .ok (.Err .CorruptStore, state)
def unsupported {E : Type} (state : E) : Outcome E := .ok (.Err .UnsupportedStore, state)

def lengthsStatement : Str := SandproofStage1RequestRust.toStr
  "SELECT length(state_json),reserve_bytes FROM controller_lifecycle_inbox WHERE id=1"
def bodyStatement : Str := SandproofStage1RequestRust.toStr
  "SELECT state_json,sha256 FROM controller_lifecycle_inbox WHERE id=1"

-- The reader has already been proved against all Maintenance/Capacity fields.
-- This second read is deliberately separate from the earlier capacity read.
def finishView {E : Type} (io : InboxLoadEffects E) (inbox : Inbox) (state : E) : Outcome E :=
  attempt (InboxLoadConfig.readFullView io.checkpointconfigReadConfigEffectsInst state) fun policy after =>
    match policy with
    | some config =>
      if inbox.config.max_operations_per_session.val > config.max_operations_per_sandbox.val
      then corrupt after else .ok (.Ok (some inbox), after)
    | none => unsupported after

-- Validator and budget are parameters during control-flow correspondence.
-- The final contract must instantiate their existing independent specifications.
def validatedView {E : Type} (io : InboxLoadEffects E) (validate : Inbox → Check)
    (budget : LifecycleInboxConfig → Result U64) (inbox : Inbox) (reserve : U64) (state : E) : Outcome E := do
  let required ← budget inbox.config
  if required ≠ reserve then corrupt state
  else do
    let checked ← validate inbox
    match checked with
    | .Ok _ => finishView io inbox state
    | .Err error => .ok (.Err error, state)

def canonicalView {E : Type} (io : InboxLoadEffects E) (validate : Inbox → Check)
    (budget : LifecycleInboxConfig → Result U64) (inbox : Inbox)
    (bytes : alloc.vec.Vec U8) (reserve : U64) (state : E) : Outcome E :=
  attempt (io.encode_inbox state inbox) fun encoded after => do
    let different ← alloc.vec.partial_eq.PartialEqVec.ne core.cmp.PartialEqU8 encoded bytes
    if different then corrupt after else validatedView io validate budget inbox reserve after

def digestView {E : Type} (io : InboxLoadEffects E) (validate : Inbox → Check)
    (budget : LifecycleInboxConfig → Result U64) (inbox : Inbox)
    (bytes sha : alloc.vec.Vec U8) (reserve : U64) (state : E) : Outcome E := do
  let (digest, after) ← io.digest state (alloc.vec.Vec.deref bytes)
  let different ← core.cmp.impls.PartialEqShared.ne
    (Slice.Insts.CoreCmpPartialEqSlice core.cmp.PartialEqU8)
    (Array.to_slice digest) (alloc.vec.Vec.deref sha)
  if different then corrupt after else canonicalView io validate budget inbox bytes reserve after

def bodyView {E : Type} (io : InboxLoadEffects E) (validate : Inbox → Check)
    (budget : LifecycleInboxConfig → Result U64) (reserve : U64) (state : E) : Outcome E :=
  attempt (io.query_bytes_pair state bodyStatement) fun stored afterBytes =>
    let (bytes, sha) := stored
    do
    let (decoded, afterDecode) ← io.decode_inbox afterBytes (alloc.vec.Vec.deref bytes)
    match decoded with
    | .Ok inbox => digestView io validate budget inbox bytes sha reserve afterDecode
    | .Err _ => corrupt afterDecode

def sixteenKiB : U64 := 16384#u64
def maximumBytes : U64 := 16777216#u64

def limitsView {E : Type} (io : InboxLoadEffects E) (validate : Inbox → Check)
    (budget : LifecycleInboxConfig → Result U64) (capacity : controller.capacity.CapacityConfig)
    (length reserve : I64) (state : E) : Outcome E :=
  if length < 0#i64 then corrupt state
  else do
    let unsignedLength ← core.num.I64.cast_unsigned length
    if reserve < 0#i64 then corrupt state
    else do
      let unsignedReserve ← core.num.I64.cast_unsigned reserve
      if unsignedReserve < unsignedLength then corrupt state
      else if unsignedReserve > capacity.max_sql_value_bytes then corrupt state
      else if unsignedReserve > maximumBytes then corrupt state
      else bodyView io validate budget unsignedReserve state

def capacityView {E : Type} (io : InboxLoadEffects E) (validate : Inbox → Check)
    (budget : LifecycleInboxConfig → Result U64) (state : E) : Outcome E :=
  attempt (InboxLoadConfig.capacityReadView io.checkpointconfigReadConfigEffectsInst state) fun value after =>
    match value with
    | some capacity => attempt (io.query_i64_pair after lengthsStatement) fun measured afterLengths =>
        let (length, reserve) := measured
        limitsView io validate budget capacity length reserve afterLengths
    | none => unsupported after

def currentView {E : Type} (io : InboxLoadEffects E) (validate : Inbox → Check)
    (budget : LifecycleInboxConfig → Result U64) (state : E) : Outcome E :=
  attempt (io.query_bool state internalStatement) fun internal after =>
    if internal then corrupt after else capacityView io validate budget after

def loadView {E : Type} (io : InboxLoadEffects E) (validate : Inbox → Check)
    (budget : LifecycleInboxConfig → Result U64) (state : E) : Outcome E :=
  attempt (io.query_bool state existsStatement) fun hasInbox afterExists =>
    attempt (io.checkpointconfigReadConfigEffectsInst.query_i64 afterExists versionStatement) fun version afterVersion =>
      attempt (io.query_bool afterVersion sourceStatement) fun source afterSource =>
        if source != (version = LIFECYCLE_STORE_FORMAT_VERSION) then corrupt afterSource
        else if hasInbox then do
          let current ← match version with | 23#iscalar => Result.ok true | _ => .ok false
          if current then currentView io validate budget afterSource else corrupt afterSource
        else do
          let current ← match version with | 23#iscalar => Result.ok true | _ => .ok false
          if current then corrupt afterSource else .ok (.Ok none, afterSource)

theorem branch_bind {α β : Type} (result : core.result.Result α JournalError)
    (next : core.ops.control_flow.ControlFlow (core.result.Result core.convert.Infallible JournalError) α → Result β) :
    (do let control ← core.result.Result.Insts.CoreOpsTry.branch result; next control) =
      (match result with
       | .Ok value => next (.Continue value)
       | .Err error => next (.Break (.Err error))) := by
  cases result <;> simp [core.result.Result.Insts.CoreOpsTry.branch]

theorem optional_bind {α β : Type} (value : Option α)
    (next : core.result.Result α JournalError → Result β) :
    (do let checked ← core.option.Option.ok_or value JournalError.UnsupportedStore; next checked) =
      (match value with | some value => next (.Ok value) | none => next (.Err .UnsupportedStore)) := by
  cases value <;> simp [core.option.Option.ok_or]

theorem version_match (version : I64) :
    (match version with | 23#iscalar => (Result.ok true) | _ => .ok false) =
      .ok (decide (version = 23#i64)) := by
  have literalValue : (23#iscalar : I64).val = 23 := by decide
  split <;> simp_all [IScalar.eq_equiv]

theorem decode_map_bind {R T N U B E α : Type}
    (saved : RetirementEncoding R) (terminal : TerminalEncoding T)
    (renewal : RenewalEncoding N) (unload : UnloadEncoding U)
    (graphic : GraphicBytes B) (io : InboxLoadEffects E)
    (result : core.result.Result Inbox JournalError)
    (next : core.result.Result Inbox JournalError → Result α) :
    (do let mapped ← core.result.Result.map_err
          (load_using.closure.Insts.CoreOpsFunctionFnOnceTupleJournalErrorJournalError
            saved terminal renewal unload graphic io) result ()
        next mapped) =
      match result with
      | .Ok inbox => next (.Ok inbox)
      | .Err _ => next (.Err .CorruptStore) := by
  cases result <;> simp [core.result.Result.map_err,
    load_using.closure.Insts.CoreOpsFunctionFnOnceTupleJournalErrorJournalError.call_once]

theorem continue_congr {α β : Type} (run : Result α) (left right : α → Result β)
    (same : ∀ value, left value = right value) :
    Bind.bind run left = Bind.bind run right := congrArg (fun next => Bind.bind run next) (funext same)

theorem pair_continue_congr {α β E : Type} (run : Result (α × E))
    (left right : α × E → Result β) (same : ∀ value after, left (value, after) = right (value, after)) :
    Bind.bind run left = Bind.bind run right := by
  apply continue_congr
  intro pair
  rcases pair with ⟨value, after⟩
  exact same value after

theorem guard_congr {α : Type} (condition : Prop) [Decidable condition]
    (rejected left right : α) (same : left = right) :
    (if condition then rejected else left) = (if condition then rejected else right) :=
  congrArg (fun next => if condition then rejected else next) same

theorem load_control_flow_refines {R T N U B E : Type}
    (saved : RetirementEncoding R) (terminal : TerminalEncoding T)
    (renewal : RenewalEncoding N) (unload : UnloadEncoding U)
    (graphic : GraphicBytes B) (io : InboxLoadEffects E) (state : E) :
    load_using saved terminal renewal unload graphic io state =
      loadView io (Inbox.validate_using saved terminal renewal unload graphic)
        LifecycleInboxConfig.required_bytes state := by
  have firstMul : (16#u64 * 1024#u64 : Result U64) = .ok sixteenKiB := by rfl
  have secondMul : (sixteenKiB * 1024#u64 : Result U64) = .ok maximumBytes := by rfl
  unfold load_using loadView currentView capacityView limitsView bodyView digestView canonicalView validatedView finishView
  simp only [attempt, branch_bind, optional_bind, decode_map_bind,
    InboxLoadConfig.capacity_read_refines, controller.checkpoint.config_using,
    InboxLoadConfig.read_full_refines, firstMul, secondMul, lift, bind_tc_ok,
    bne_iff_ne, existsStatement, versionStatement, sourceStatement, internalStatement,
    lengthsStatement, bodyStatement, corrupt, unsupported,
    core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual,
    core.convert.FromSame.from, core.convert.num.FromU64U16.from_val_eq, UScalar.lt_equiv]
  apply pair_continue_congr (io.query_bool state existsStatement)
  intro first afterExists
  cases first with
  | Err error => rfl
  | Ok hasInbox =>
    apply pair_continue_congr (io.checkpointconfigReadConfigEffectsInst.query_i64 afterExists versionStatement)
    intro second afterVersion
    cases second with
    | Err error => rfl
    | Ok version =>
      apply pair_continue_congr (io.query_bool afterVersion sourceStatement)
      intro third afterSource
      cases third with
      | Err error => rfl
      | Ok source =>
        change (if source ≠ decide (version = LIFECYCLE_STORE_FORMAT_VERSION) then
          (Result.ok (.Err .CorruptStore, afterSource) : Outcome E) else _) =
          (if source ≠ decide (version = LIFECYCLE_STORE_FORMAT_VERSION) then
          (Result.ok (.Err .CorruptStore, afterSource) : Outcome E) else _)
        by_cases mismatch : source ≠ decide (version = LIFECYCLE_STORE_FORMAT_VERSION)
        · exact (if_pos mismatch).trans (if_pos mismatch).symm
        · simp only [mismatch, ↓reduceIte]
          cases hasInbox with
          | false => rfl
          | true =>
            simp only [↓reduceIte]
            apply continue_congr (match version with | 23#iscalar => Result.ok true | _ => .ok false)
            intro current
            cases current with
            | false => rfl
            | true =>
              simp only [↓reduceIte]
              apply pair_continue_congr (io.query_bool afterSource internalStatement)
              intro fourth afterInternal
              cases fourth with
              | Err error => rfl
              | Ok internal =>
                cases internal with
                | true => rfl
                | false =>
                  apply pair_continue_congr (InboxLoadConfig.capacityReadView io.checkpointconfigReadConfigEffectsInst afterInternal)
                  intro fifth afterCapacity
                  cases fifth with
                  | Err error => rfl
                  | Ok capacity =>
                    cases capacity with
                    | none => rfl
                    | some capacity =>
                      apply pair_continue_congr (io.query_i64_pair afterCapacity lengthsStatement)
                      intro sixth afterLengths
                      cases sixth with
                      | Err error => rfl
                      | Ok measured =>
                        rcases measured with ⟨length, reserve⟩
                        simp only [core.num.I64.cast_unsigned, bind_tc_ok]
                        apply guard_congr
                        apply guard_congr
                        apply guard_congr
                        apply guard_congr
                        apply guard_congr
                        apply pair_continue_congr (io.query_bytes_pair afterLengths bodyStatement)
                        intro seventh afterBytes
                        cases seventh with
                        | Err error => rfl
                        | Ok stored =>
                          rcases stored with ⟨bytes, sha⟩
                          apply pair_continue_congr (io.decode_inbox afterBytes (alloc.vec.Vec.deref bytes))
                          intro decoded afterDecode
                          cases decoded with
                          | Err error => rfl
                          | Ok inbox =>
                            apply pair_continue_congr (io.digest afterDecode (alloc.vec.Vec.deref bytes))
                            intro digest afterDigest
                            apply continue_congr (core.cmp.impls.PartialEqShared.ne
                              (Slice.Insts.CoreCmpPartialEqSlice core.cmp.PartialEqU8)
                              (Array.to_slice digest) (alloc.vec.Vec.deref sha))
                            intro digestDifferent
                            apply guard_congr
                            apply pair_continue_congr (io.encode_inbox afterDigest inbox)
                            intro encoded afterEncode
                            cases encoded with
                            | Err error => rfl
                            | Ok encoded =>
                              apply continue_congr (alloc.vec.partial_eq.PartialEqVec.ne core.cmp.PartialEqU8 encoded bytes)
                              intro bytesDifferent
                              apply guard_congr
                              apply continue_congr (LifecycleInboxConfig.required_bytes inbox.config)
                              intro required
                              apply guard_congr
                              apply continue_congr (Inbox.validate_using saved terminal renewal unload graphic inbox)
                              intro validated
                              cases validated with
                              | Err error => rfl
                              | Ok returnedUnit =>
                                cases returnedUnit
                                apply pair_continue_congr (InboxLoadConfig.readFullView io.checkpointconfigReadConfigEffectsInst afterEncode)
                                intro policy afterPolicy
                                cases policy with
                                | Err error => rfl
                                | Ok policy =>
                                  cases policy <;> rfl

end
end SandboxModel.Stage1Protocol.InboxLoad.Raw

#audit_controller_proof SandboxModel.Stage1Protocol.InboxLoad.Raw.branch_bind
#audit_controller_proof SandboxModel.Stage1Protocol.InboxLoad.Raw.optional_bind
#audit_controller_proof SandboxModel.Stage1Protocol.InboxLoad.Raw.version_match
#audit_controller_proof SandboxModel.Stage1Protocol.InboxLoad.Raw.decode_map_bind
#audit_controller_proof SandboxModel.Stage1Protocol.InboxLoad.Raw.continue_congr
#audit_controller_proof SandboxModel.Stage1Protocol.InboxLoad.Raw.pair_continue_congr
#audit_controller_proof SandboxModel.Stage1Protocol.InboxLoad.Raw.guard_congr
#audit_controller_proof SandboxModel.Stage1Protocol.InboxLoad.Raw.load_control_flow_refines
