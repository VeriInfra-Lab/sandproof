#audit_controller_proof SandboxModel.Stage1Protocol.CreateSelection.Values.lookup_shape
#audit_controller_proof SandboxModel.Stage1Protocol.CreateSelection.Values.lookup_returns
#audit_controller_proof SandboxModel.Stage1Protocol.CreateSelection.Values.normal_expected
#audit_controller_proof SandboxModel.Stage1Protocol.CreateSelection.Values.terminal_expected
#audit_controller_proof SandboxModel.Stage1Protocol.CreateSelection.Values.refused_expected
#audit_controller_proof SandboxModel.Stage1Protocol.CreateSelection.Values.older_expected
#audit_controller_proof SandboxModel.Stage1Protocol.CreateSelection.Values.mapped_expected
#audit_controller_proof SandboxModel.Stage1Protocol.CreateSelection.Values.singleton_index
