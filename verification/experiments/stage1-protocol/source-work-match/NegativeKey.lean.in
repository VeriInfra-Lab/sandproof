import SandboxModel.Lifecycle.Protocol.SourceWorkMatch.Bytes
import SandboxModel.Lifecycle.Protocol.SourceWorkMatch.Examples
open Aeneas Aeneas.Std SandproofSourceWorkMatchRust
namespace SandboxModel.Stage1Protocol.SourceWorkMatch.NegativeKey
open Values
theorem key_comparison (left right : Work) : proof_source_work_eq left right =
    .ok (decide (left.requirement.work_binding = right.requirement.work_binding)) := by
  simp [proof_source_work_eq,
    controller.lifecycle_inbox.source_work.SourceWork.Insts.CoreCmpPartialEqSourceWork.eq,
    sandproof_protocol.lifecycle.digest.ContentDigest.Insts.CoreCmpPartialEqContentDigest.eq,
    RequestEquality.array_eq]
theorem shared_normal : proof_source_work_eq base base = .ok true := by simp [key_comparison]
theorem bad_actual : proof_source_work_eq base changedLimits = .ok true := by
  simp [key_comparison, changedLimits]
theorem omitted_credential : proof_source_work_eq base changedCredential = .ok true := by
  simp [key_comparison, changedCredential]
theorem rejects_same_full_contract : ¬ FullWorkContract proof_source_work_eq := by
  intro contract
  have failed := contract base changedLimits
  rw [bad_actual, limits_expected] at failed
  simp at failed
end SandboxModel.Stage1Protocol.SourceWorkMatch.NegativeKey
#audit_controller_proof SandboxModel.Stage1Protocol.SourceWorkMatch.NegativeKey.key_comparison
#audit_controller_proof SandboxModel.Stage1Protocol.SourceWorkMatch.NegativeKey.shared_normal
#audit_controller_proof SandboxModel.Stage1Protocol.SourceWorkMatch.NegativeKey.bad_actual
#audit_controller_proof SandboxModel.Stage1Protocol.SourceWorkMatch.NegativeKey.omitted_credential
#audit_controller_proof SandboxModel.Stage1Protocol.SourceWorkMatch.NegativeKey.rejects_same_full_contract
