#audit_controller_proof SandboxModel.Stage1Protocol.RetentionLane.next_spec
#audit_controller_proof SandboxModel.Stage1Protocol.RetentionLane.successor_values
#audit_controller_proof SandboxModel.Stage1Protocol.RetentionLane.window_option_ne
#audit_controller_proof SandboxModel.Stage1Protocol.RetentionLane.status_cleaned
#audit_controller_proof SandboxModel.Stage1Protocol.RetentionLane.terminal_body
#audit_controller_proof SandboxModel.Stage1Protocol.RetentionLane.envelope_body
#audit_controller_proof SandboxModel.Stage1Protocol.RetentionLane.envelope_ok

#audit_controller_proof SandboxModel.Stage1Protocol.RetentionLane.terminal_full
