import SandboxModel.Lifecycle.Protocol.StandardSaveDigestValues
open Aeneas Aeneas.Std SandproofStandardSaveDigestRust
namespace SandboxModel.Stage1Protocol.StandardSaveDelegateCounter
open StandardSaveDigest

theorem wrong_common_normal :
    throughSave Values.normal Values.empty = StandardDigest.expected Values.normal Values.empty ∧
    throughRebind Values.normal Values.empty = StandardDigest.expected Values.normal Values.empty := by
  constructor <;> simp [throughSave, throughRebind, actualSave, actualRebind, StandardDigest.expected, saveFromCommon, saveToCommon, readFromCommon, readToCommon, controller.lifecycle_inbox.codec.StandardInboxSave.Insts.Sandproof_controller_serviceControllerLifecycle_inboxCodecInboxSaveEffects.digest, controller.checkpoint.config.StandardConfigRead.Insts.Sandproof_controller_serviceControllerLifecycle_inboxCodecInboxSaveEffects.digest, controller.lifecycle_inbox.codec.sha256_bytes, SandproofStandardDigestRust.controller.lifecycle_inbox.codec.sha256_bytes, Values.empty, StandardDigest.Values.empty, core.slice.index.Slice.index, core.slice.index.SliceIndexRangeToUsizeSlice.index, Slice.length, List.slice]

theorem wrong_abc_uses_empty :
    throughRebind Values.normal Values.abc = StandardDigest.expected Values.normal Values.empty := by
  simp [throughRebind, actualRebind, StandardDigest.expected, readFromCommon, readToCommon, controller.lifecycle_inbox.codec.StandardInboxSave.Insts.Sandproof_controller_serviceControllerLifecycle_inboxCodecInboxSaveEffects.digest, controller.checkpoint.config.StandardConfigRead.Insts.Sandproof_controller_serviceControllerLifecycle_inboxCodecInboxSaveEffects.digest, controller.lifecycle_inbox.codec.sha256_bytes, SandproofStandardDigestRust.controller.lifecycle_inbox.codec.sha256_bytes, Values.empty, StandardDigest.Values.empty, core.slice.index.Slice.index, core.slice.index.SliceIndexRangeToUsizeSlice.index, Slice.length, List.slice, Values.abc, StandardDigest.Values.abc]

theorem same_full_contract_rejected : ¬ FullSaveDigestContract := by
  intro contract
  have promised := contract.2 Values.normal Values.abc StandardDigest.Values.abc_normal
  rw [wrong_abc_uses_empty] at promised
  have same := congrArg Prod.fst (Result.ok_injective promised)
  exact Values.complete_hashes_differ same

end SandboxModel.Stage1Protocol.StandardSaveDelegateCounter
#audit_controller_proof SandboxModel.Stage1Protocol.StandardSaveDelegateCounter.wrong_common_normal
#audit_controller_proof SandboxModel.Stage1Protocol.StandardSaveDelegateCounter.wrong_abc_uses_empty
#audit_controller_proof SandboxModel.Stage1Protocol.StandardSaveDelegateCounter.same_full_contract_rejected
