import SandboxModel.Lifecycle.Protocol.ShapeLane
import SandboxModel.Lifecycle.Protocol.ShapeRefusal
import SandboxModel.Lifecycle.Protocol.ShapeTerminal
import SandboxModel.Lifecycle.Protocol.ShapeBoundaryValues

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service
open sandproof_controller_service.controller.lifecycle_inbox.model
open sandproof_protocol.lifecycle.identity
namespace SandboxModel.Stage1Protocol.SessionShape.WrongPhysical
noncomputable section
open scoped Classical

theorem wrong_loop (values : Slice Session) (expected : values.val = [Values.previous]) :
    prior_session_conflict_loop Values.physical values 0#usize = .ok false := by
  have inside : (0#usize).val < values.val.length := by simp [expected]
  obtain ⟨old, indexed, same⟩ := WP.spec_imp_exists (Slice.index_usize_spec values 0#usize inside)
  have first : prior_session_conflict_loop.body Values.physical values 0#usize = .ok (.cont 1#usize) := by
    have insideSlice : 0#usize < Slice.len values := inside
    simp only [prior_session_conflict_loop.body, insideSlice, ↓reduceIte, indexed, same,
      bind_tc_ok, index_add_one 0#usize 1#usize (by decide)]
    simp [expected, Values.previous, Values.physical, Values.normal,
      SavedRetirement.Values.normal, SavedRetirement.Values.createIntent, EnvelopeValues.intent,
      SessionId.Insts.CoreCmpPartialEqSessionId.eq,
      sandproof_protocol.SandboxId.Insts.CoreCmpPartialEqSandboxId.eq,
      alloc.string.String.Insts.CoreCmpPartialEqString.eq,
      SandproofFoundationsRust.alloc.string.String.Insts.CoreCmpPartialEqString.eq]
  have last : prior_session_conflict_loop.body Values.physical values 1#usize = .ok (.done false) := by
    simp [prior_session_conflict_loop.body, Slice.len, UScalar.lt_equiv, expected]
  unfold prior_session_conflict_loop
  conv_lhs => rw [loop]
  rw [first]
  simp only [bind_ok]
  conv_lhs => rw [loop]
  rw [last]
  simp

theorem wrong_prior_accepts : prior_session_conflict Values.conflicted 1#usize Values.physical = .ok false := by
  unfold prior_session_conflict
  obtain ⟨previous, sliced, values, length⟩ := WP.spec_imp_exists
    (alloc.vec.Vec.index_RangeTo_spec Values.conflicted.sessions { «end» := 1#usize } (by decide))
  simp only [sliced, bind_tc_ok]
  apply wrong_loop previous
  simpa [Values.conflicted, Values.vector] using values

theorem wrong_accepts :
    Inbox.validate_session_shape_using Values.savedEncoding Values.small Values.conflicted 1#usize Values.physical = .ok (.Ok ()) := by
  have receipt : SavedRetirement.validateView Values.savedEncoding Values.physical = .ok (.Ok ()) := rfl
  simp only [Inbox.validate_session_shape_using, SavedRetirement.validate_saved_spec, receipt,
    core.result.Result.Insts.CoreOpsTry.branch, bind_tc_ok, wrong_prior_accepts,
    alloc.vec.Vec.is_empty, SandproofFoundationsRust.alloc.vec.Vec.is_empty,
    first_window_spec, option_some_spec, option_none_spec, lift, decide_eq_true_eq,
    UScalar.lt_equiv, alloc.vec.Vec.len_val, core.convert.num.FromUsizeU16.from_val_eq]
  simp [FirstWindowMatches, Values.conflicted, Values.observed, Values.inbox, Values.physical,
    Values.normal, Values.vector, Values.lane, SavedRetirement.Values.normal,
    SavedRetirement.Values.createIntent, EnvelopeValues.intent]

theorem violates_full_contract :
    ¬FullShapeContract (Inbox.validate_session_shape_using (R := Unit) (E := Unit)) := by
  intro contract
  have mismatch := contract Values.savedEncoding Values.small Values.conflicted 1#usize Values.physical
  rw [wrong_accepts, Values.model_physical_conflict] at mismatch
  simp [corrupt, SavedRetirement.corrupt] at mismatch

end
end SandboxModel.Stage1Protocol.SessionShape.WrongPhysical

#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.WrongPhysical.wrong_loop
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.WrongPhysical.wrong_prior_accepts
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.WrongPhysical.wrong_accepts
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.WrongPhysical.violates_full_contract
