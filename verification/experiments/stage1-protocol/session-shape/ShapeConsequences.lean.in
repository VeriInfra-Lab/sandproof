#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.rejected_before_index
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.index_panic_after_shape
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.prior_rejected_before_confirmed
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.refusal_rejected_before_confirmed
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.confirmed_reached_exactly
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.receipt_failure_preserved
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.receipt_divergence_preserved
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.receipt_error_precedes_shape
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.empty_entries_rejected_after_receipt
