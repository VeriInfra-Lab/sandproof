import SandboxModel.Lifecycle.Protocol.ShapeLane
import SandboxModel.Lifecycle.Protocol.ShapePrior
import SandboxModel.Lifecycle.Protocol.ShapeTerminal
import SandboxModel.Lifecycle.Protocol.ShapeBoundaryValues

open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_controller_service
open sandproof_controller_service.controller.lifecycle_inbox.model
namespace SandboxModel.Stage1Protocol.SessionShape.WrongRefusal
noncomputable section
open scoped Classical

theorem body_step (session : Session) (index next : Usize)
    (inside : index.val < session.entries.val.length) (added : next.val = index.val + 1)
    (observed : session.entries.val[index.val].local_operation = none ∧
      session.entries.val[index.val].applied_deadline = none)
    (kind : IsCreate session.entries.val[index.val].intent.request.operation ∨
      session.entries.val[index.val].intent.request.operation = .Destroy) :
    refusal_entries_invalid_loop.body session index = .ok (.cont next) := by
  obtain ⟨entry, indexed, same⟩ := WP.spec_imp_exists
    (alloc.vec.Vec.index_usize_spec session.entries index inside)
  have insideVec : index < alloc.vec.Vec.len session.entries := inside
  simp only [refusal_entries_invalid_loop.body, insideVec, ↓reduceIte,
    alloc.vec.Vec.index_slice_index, indexed, same, bind_tc_ok,
    observed.1, observed.2, core.option.Option.is_some,
    index_add_one index next added]
  unfold IsCreate at kind
  cases operation : session.entries.val[index.val].intent.request.operation <;> simp_all
  all_goals
    erw [operation] at kind
    simp at kind

theorem wrong_entries_accepts : refusal_entries_invalid Values.wrongRefusal = .ok false := by
  have first : refusal_entries_invalid_loop.body Values.wrongRefusal 0#usize = .ok (.cont 1#usize) := by
    apply body_step _ _ _ (by decide) (by decide)
    · simp [Values.wrongRefusal, Values.vector, Values.entry]
    · simp [Values.wrongRefusal, Values.vector, Values.entry, IsCreate, SavedRetirement.Values.createIntent]
  have second : refusal_entries_invalid_loop.body Values.wrongRefusal 1#usize = .ok (.cont 2#usize) := by
    apply body_step _ _ _ (by decide) (by decide)
    · simp [Values.wrongRefusal, Values.vector, Values.entry]
    · simp [Values.wrongRefusal, Values.vector, Values.entry, IsCreate, SavedRetirement.Values.destroyIntent]
  have last : refusal_entries_invalid_loop.body Values.wrongRefusal 2#usize = .ok (.done false) := by
    simp [refusal_entries_invalid_loop.body, alloc.vec.Vec.len, UScalar.lt_equiv,
      Values.wrongRefusal, Values.vector]
  unfold refusal_entries_invalid refusal_entries_invalid_loop
  conv_lhs => rw [loop]
  rw [first]
  simp only [bind_ok]
  conv_lhs => rw [loop]
  rw [second]
  simp only [bind_ok]
  conv_lhs => rw [loop]
  rw [last]
  simp

theorem wrong_accepts :
    Inbox.validate_session_shape_using Values.savedEncoding Values.small Values.inbox 0#usize Values.wrongRefusal = .ok (.Ok ()) := by
  have receipt : SavedRetirement.validateView Values.savedEncoding Values.wrongRefusal = .ok (.Ok ()) := rfl
  simp only [Inbox.validate_session_shape_using, SavedRetirement.validate_saved_spec, receipt,
    core.result.Result.Insts.CoreOpsTry.branch, bind_tc_ok, wrong_entries_accepts,
    alloc.vec.Vec.is_empty, SandproofFoundationsRust.alloc.vec.Vec.is_empty,
    first_window_spec, prior_spec, first_entry_spec, core.option.Option.is_some,
    option_none_spec, lift, decide_eq_true_eq, UScalar.lt_equiv, alloc.vec.Vec.len_val,
    core.convert.num.FromUsizeU16.from_val_eq]
  simp [FirstWindowMatches, Values.inbox, Values.wrongRefusal, Values.refused, Values.stopped,
    Values.normal, Values.vector, Values.lane, Values.entry, SavedRetirement.Values.normal,
    SavedRetirement.Values.createIntent, EnvelopeValues.intent,
    core.option.Option.is_none_or, SandproofFoundationsRust.core.option.Option.is_none_or,
    Inbox.validate_session_shape_using.closure.Insts.CoreOpsFunctionFnOnceTupleSharedEntryBool.call_once]

theorem violates_full_contract :
    ¬FullShapeContract (Inbox.validate_session_shape_using (R := Unit) (E := Unit)) := by
  intro contract
  have mismatch := contract Values.savedEncoding Values.small Values.inbox 0#usize Values.wrongRefusal
  rw [wrong_accepts, Values.model_refusal_rejection] at mismatch
  simp [corrupt, SavedRetirement.corrupt] at mismatch

end
end SandboxModel.Stage1Protocol.SessionShape.WrongRefusal

#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.WrongRefusal.body_step
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.WrongRefusal.wrong_entries_accepts
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.WrongRefusal.wrong_accepts
#audit_controller_proof SandboxModel.Stage1Protocol.SessionShape.WrongRefusal.violates_full_contract
