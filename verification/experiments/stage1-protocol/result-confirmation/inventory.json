  "mutations": {
    "terminal-key-only": {
      "source": "sandbox-protocol/src/lifecycle/terminal.rs",
      "old": "self.request == *request",
      "new": "self.request.request.binding.key == request.request.binding.key",
      "template": "NegativeTerminalKey"
    },
    "confirmation-key-only": {
      "source": "sandbox-protocol/src/lifecycle/confirmation.rs",
      "old": "self.result == *result",
      "new": "self.result.request.request.binding.key == result.request.request.binding.key",
      "template": "NegativeConfirmationKey"
    },
    "close-pending": {
      "source": "sandbox-protocol/src/lifecycle/confirmation.rs",
      "old": "self.terminal.status == TerminalStatus::Cleaned\n            && self.terminal.matches_request(&self.terminal.request)",
      "new": "self.terminal.matches_request(&self.terminal.request)",
      "template": "NegativeClosePending"
    },
    "close-newer-frontier": {
      "source": "sandbox-protocol/src/lifecycle/confirmation.rs",
      "old": "self.retired_through == request.terminal.request.retention.window",
      "new": "self.retired_through.get() >= request.terminal.request.retention.window.get()",
      "template": "NegativeCloseFrontier"
    }
  },
