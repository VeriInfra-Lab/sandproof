import SandproofStage1Request.Funs
import SandboxModel.Lifecycle.Protocol.ResultValues
import SandboxModel.Lifecycle.Protocol.Accepted
import SandboxModel.Lifecycle.Protocol.ResultEquality
open Aeneas Aeneas.Std SandproofStage1RequestRust
open sandproof_protocol.lifecycle.authority sandproof_protocol.lifecycle.request
open sandproof_protocol.lifecycle.terminal sandproof_protocol.lifecycle.confirmation
open sandproof_protocol.lifecycle.identity
open SandboxModel.Stage1Protocol SandboxModel.Stage1Protocol.Confirmation
open SandboxModel.Stage1Protocol.ConfirmationValues
namespace SandboxModel.Stage1Protocol.NegativeConfirmationKey

theorem actual_mutant_accepts : confirmed_matches ⟨changed⟩ (terminal .Cleaned) = .ok true := by
  have checked : U64.checked_add 0#u64 1#u64 = some 1#u64 := by decide
  simp [confirmed_matches, ConfirmedLifecycleResult.matches, Replay.key_eq, status_eq,
    TerminalLifecycleObservation.matches_request, Replay.accepted_eq,
    Validation.retention_valid, Validation.version_comparison, changed, terminal, intent,
    EnvelopeValues.intent, Validation.retentionOK, Validation.versionOK, checked]

theorem violates_same_full_contract : ¬ FullConfirmedContract confirmed_matches := by
  classical
  intro contract
  have exact_result := contract ⟨changed⟩ (terminal .Cleaned)
  rw [actual_mutant_accepts] at exact_result
  simp [ConfirmedMatches, changed_complete_result] at exact_result

end SandboxModel.Stage1Protocol.NegativeConfirmationKey

#audit_controller_proof SandboxModel.Stage1Protocol.NegativeConfirmationKey.actual_mutant_accepts
#audit_controller_proof SandboxModel.Stage1Protocol.NegativeConfirmationKey.violates_same_full_contract
