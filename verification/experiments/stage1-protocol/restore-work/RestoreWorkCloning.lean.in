@[simp] theorem vec_clone_exact {T : Type} (dictionary : core.clone.Clone T)
    (values : alloc.vec.Vec T) (exactClone : ∀ value, dictionary.clone value = .ok value) :
    alloc.vec.CloneVec.clone dictionary values = .ok values :=
  SandboxModel.Foundations.vec_clone_exact dictionary values exactClone
@[simp] theorem option_clone_exact {T : Type} (dictionary : core.clone.Clone T)
    (value : Option T) (exactClone : ∀ item, dictionary.clone item = .ok item) :
    core.option.Option.Insts.CoreCloneClone.clone dictionary value = .ok value := by
  cases value <;> simp [core.option.Option.Insts.CoreCloneClone.clone, exactClone]

