abbrev serde_json.error.Error [r : Representations] := r.serde_json_error_Error
abbrev CrashPoint [r : Representations] := r.CrashPoint
abbrev host_contract.CreateOptions [r : Representations] := r.host_contract_CreateOptions
abbrev core.fmt.Formatter := SandproofFoundationsRust.core.fmt.Formatter
abbrev core.fmt.Error := SandproofFoundationsRust.core.fmt.Error
