def fromError (c : Carriers) :
    SandproofStage1RequestRust.sandproof_controller_service.JournalError →
    SandproofUnloadFirstObservation.JournalError
  | .Io error => .Io (cast c.io.symm error)
  | .Sqlite error => .Sqlite (cast c.sqlite.symm error)
  | .CommitUncertain error => .CommitUncertain (cast c.sqlite.symm error)
  | .Json error => .Json (cast c.json.symm error)
  | .Contract error => .Contract (cast c.contract.symm error)
  | .Conflict => .Conflict
  | .IdentifierExhausted => .IdentifierExhausted
  | .MaintenanceCapacity => .MaintenanceCapacity
  | .CaptureMaterialQuotaExceeded => .CaptureMaterialQuotaExceeded
  | .RevisionConflict => .RevisionConflict
  | .ReceiptBeforeDispatch => .ReceiptBeforeDispatch
  | .ConflictingReceipt => .ConflictingReceipt
  | .UnsupportedStore => .UnsupportedStore
  | .CorruptStore => .CorruptStore
  | .CredentialIndexPoisoned => .CredentialIndexPoisoned
  | .InjectedCrash error => .InjectedCrash (cast c.crash.symm error)
  | .ControllerRejected error => .ControllerRejected (cast c.reject.symm error)
  | .ControllerBusy => .ControllerBusy
  | .UnsupportedInput => .UnsupportedInput
  | .UnresolvedAction => .UnresolvedAction
  | .OperationFailed => .OperationFailed
  | .InvalidHostEvidence => .InvalidHostEvidence
  | .ObsoleteReceipt => .ObsoleteReceipt

@[simp] private theorem mapVec_cancel (f : α → β) (g : β → α)
    (inverse : ∀ a, g (f a) = a) (xs : alloc.vec.Vec α) :
    mapVec g (mapVec f xs) = xs := by
  apply alloc.vec.Vec.ext
  simp [mapVec, List.map_map, Function.comp_def, inverse]

@[simp] private theorem mapVec_cast_cancel (h : α = β) (xs : alloc.vec.Vec α) :
    mapVec (fun x => cast h.symm x) (mapVec (fun x => cast h x) xs) = xs :=
  mapVec_cancel _ _ (fun x => by simp) xs

@[simp] theorem from_to_Operation (c : Carriers)
    (value : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.request.LifecycleOperation) :
    fromOperation c (toOperation c value) = value := by
  cases value <;> simp [toOperation, fromOperation, Function.comp_def]

@[simp] theorem from_to_Local (c : Carriers)
    (value : SandproofUnloadFirstObservation.controller.internal_inbox.model.InternalLocalBinding) :
    fromLocal c (toLocal c value) = value := by
  cases value <;> simp [toLocal, fromLocal, Function.comp_def]

@[simp] theorem from_to_Request (c : Carriers)
    (value : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.request.LifecycleRequest) :
    fromRequest c (toRequest c value) = value := by
