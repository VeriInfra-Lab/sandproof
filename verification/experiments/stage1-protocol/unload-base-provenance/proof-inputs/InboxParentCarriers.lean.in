import InboxOriginSelected
import SandproofUnloadFirstObservation.FunsExternal

open Aeneas Aeneas.Std
namespace SandboxModel.Stage1Protocol.InboxOriginBinding.ParentBridge

variable [SandproofUnloadFirstObservation.Representations]

/-- Shared exact Rust leaf types. Aggregate transport below is structural. -/
structure Carriers where
  sandbox : SandproofUnloadFirstObservation.sandbox_controller_core.ids.SandboxId =
    SandproofStage1RequestRust.sandbox_controller_core.ids.SandboxId
  owner : SandproofUnloadFirstObservation.sandbox_controller_core.ids.TenantId =
    SandproofStage1RequestRust.sandbox_controller_core.ids.TenantId
  operation : SandproofUnloadFirstObservation.sandbox_controller_core.ids.OperationId =
    SandproofStage1RequestRust.sandbox_controller_core.ids.OperationId
  operationBinding : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.identity.OperationBinding =
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.identity.OperationBinding
  center : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.authority.CenterIdentity =
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.authority.CenterIdentity
  retention : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.identity.RetentionBinding =
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.identity.RetentionBinding
  unloadResolution : SandproofUnloadFirstObservation.controller.lifecycle_inbox.unload_resolution.UnloadResolution =
    SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.unload_resolution.UnloadResolution
  sessionId : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.identity.SessionId =
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.identity.SessionId
  tenant : SandproofUnloadFirstObservation.sandproof_protocol.TenantId =
    SandproofStage1RequestRust.sandproof_protocol.TenantId
  refusal : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.observation.CreateRefusalReason =
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.observation.CreateRefusalReason
  incarnation : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.identity.IncarnationId =
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.identity.IncarnationId
  capture : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.identity.CaptureId =
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.identity.CaptureId
  terminal : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.terminal.TerminalLifecycleObservation =
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.terminal.TerminalLifecycleObservation
  renewal : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.renewal.RenewalConfirmation =
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.renewal.RenewalConfirmation
  retirement : SandproofUnloadFirstObservation.controller.lifecycle_inbox.native_retirement.NativeRetirementReceipt =
    SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.native_retirement.NativeRetirementReceipt
  digest : SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.digest.ContentDigest =
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.digest.ContentDigest
  node : SandproofUnloadFirstObservation.sandproof_protocol.internal.NodeIdentity =
    SandproofStage1RequestRust.sandproof_protocol.internal.NodeIdentity
  create : SandproofUnloadFirstObservation.sandproof_protocol.internal.lifecycle.CreateBinding =
    SandproofStage1RequestRust.sandproof_protocol.internal.lifecycle.CreateBinding
  inboxOwner : SandproofUnloadFirstObservation.controller.lifecycle_inbox.model.Owner =
    SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.model.Owner
  lane : SandproofUnloadFirstObservation.controller.lifecycle_inbox.model.LifecycleRetentionLane =
    SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.model.LifecycleRetentionLane
  io : SandproofUnloadFirstObservation.core.io.error.Error =
    SandproofStage1RequestRust.core.io.error.Error
  sqlite : SandproofUnloadFirstObservation.rusqlite.error.Error =
    SandproofStage1RequestRust.rusqlite.error.Error
  json : SandproofUnloadFirstObservation.serde_json.error.Error =
    SandproofStage1RequestRust.serde_json.error.Error
  contract : SandproofUnloadFirstObservation.sandproof_protocol.ContractError =
    SandproofStage1RequestRust.sandproof_protocol.ContractError
  crash : SandproofUnloadFirstObservation.CrashPoint =
    SandproofStage1RequestRust.sandproof_controller_service.CrashPoint
  reject : SandproofUnloadFirstObservation.sandbox_controller_core.controller.ControllerReject =
    SandproofStage1RequestRust.sandbox_controller_core.controller.ControllerReject

def mapVec (f : α → β) (xs : alloc.vec.Vec α) : alloc.vec.Vec β :=
  alloc.vec.Vec.from (xs.val.map f) (by simpa only [List.length_map] using xs.property)

def toOperation (c : Carriers) :
    SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.request.LifecycleOperation →
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.request.LifecycleOperation
  | .Create a0 a1 => .Create (cast c.create a0) (cast c.incarnation a1)
  | .Unload a0 a1 => .Unload (cast c.incarnation a0) (cast c.capture a1)
  | .Resume a0 a1 a2 a3 => .Resume (cast c.incarnation a0) (cast c.capture a1) (cast c.incarnation a2) (cast c.digest a3)
  | .Renew a0 a1 a2 => .Renew (cast c.incarnation a0) a1 a2
  | .Destroy => .Destroy

def toLocal (c : Carriers) :
    SandproofUnloadFirstObservation.controller.internal_inbox.model.InternalLocalBinding →
    SandproofStage1RequestRust.sandproof_controller_service.controller.internal_inbox.model.InternalLocalBinding :=
  fun value =>
    { sandbox := cast c.sandbox value.sandbox
      owner := cast c.owner value.owner
      operation := cast c.operation value.operation }

def toRequest (c : Carriers) :
    SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.request.LifecycleRequest →
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.request.LifecycleRequest :=
  fun value =>
    { binding := cast c.operationBinding value.binding
      operation := toOperation c value.operation }

def toIntent (c : Carriers) :
    SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.authority.AcceptedLifecycleIntent →
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.authority.AcceptedLifecycleIntent :=
  fun value =>
    { request := toRequest c value.request
      accepted_version := value.accepted_version
      center := cast c.center value.center
      retention := cast c.retention value.retention }

def toEntry (c : Carriers) :
    SandproofUnloadFirstObservation.controller.lifecycle_inbox.model.Entry →
    SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.model.Entry :=
  fun value =>
    { intent := toIntent c value.intent
      local_operation := Option.map (fun item => cast c.operation item) value.local_operation
      applied_deadline := value.applied_deadline
      previous_effective_end_at_ms := value.previous_effective_end_at_ms
      unload_resolution := Option.map (fun item => cast c.unloadResolution item) value.unload_resolution }

def toSession (c : Carriers) :
    SandproofUnloadFirstObservation.controller.lifecycle_inbox.model.Session →
    SandproofStage1RequestRust.sandproof_controller_service.controller.lifecycle_inbox.model.Session :=
  fun value =>
    { id := cast c.sessionId value.id
      retention := cast c.retention value.retention
      owner := cast c.tenant value.owner
      current_version := value.current_version
      terminal := value.terminal
      refusal := Option.map (fun item => cast c.refusal item) value.refusal
      incarnation := Option.map (fun item => cast c.incarnation item) value.incarnation
      «local» := Option.map (fun item => toLocal c item) value.«local»
      entries := mapVec (fun item => toEntry c item) value.entries
      confirmed_terminal := Option.map (fun item => cast c.terminal item) value.confirmed_terminal
      confirmed_renewal := Option.map (fun item => cast c.renewal item) value.confirmed_renewal
      compacted_sdk_through := value.compacted_sdk_through
      native_retirement := Option.map (fun item => cast c.retirement item) value.native_retirement }

