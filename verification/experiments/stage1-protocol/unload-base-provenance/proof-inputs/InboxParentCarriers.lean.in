def fromOperation (c : Carriers) :
    SandproofStage1RequestRust.sandproof_protocol.lifecycle.request.LifecycleOperation →
    SandproofUnloadFirstObservation.sandproof_protocol.lifecycle.request.LifecycleOperation
  | .Create a0 a1 => .Create (cast c.create.symm a0) (cast c.incarnation.symm a1)
  | .Unload a0 a1 => .Unload (cast c.incarnation.symm a0) (cast c.capture.symm a1)
  | .Resume a0 a1 a2 a3 => .Resume (cast c.incarnation.symm a0) (cast c.capture.symm a1) (cast c.incarnation.symm a2) (cast c.digest.symm a3)
  | .Renew a0 a1 a2 => .Renew (cast c.incarnation.symm a0) a1 a2
  | .Destroy => .Destroy

