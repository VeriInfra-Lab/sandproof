import SandproofUnloadBaseSnapshot.Provider
import SandproofUnloadFirstObservation.FunsExternal
import SandboxModel.ProofAuditCommand

open Aeneas Aeneas.Std Result

namespace BaseSnapshotLink

variable [p : SandproofUnloadFirstObservation.Representations]

