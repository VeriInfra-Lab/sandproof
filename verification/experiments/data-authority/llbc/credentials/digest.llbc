{"charon_version":"0.1.254","translated":{"crate_name":"credential_lifetime_entry","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::credential_core::digest_matches"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"probes/digest/input.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":true,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"probes/digest/entry.rs"},"crate_name":"credential_lifetime_entry","contents":"#[path = \"../../../bad-digest/controller-service/src/application/coordinator/data_credentials/credential_core.rs\"]\npub mod credential_core;\n#[path = \"../../../bad-digest/controller-service/src/controller/admission/lifetime_core.rs\"]\npub mod lifetime_core;\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"probes/digest/../../../bad-digest/controller-service/src/application/coordinator/data_credentials/credential_core.rs"},"crate_name":"credential_lifetime_entry","contents":"//! Value checks on actual credential rows and host-token bytes.\n#[path = \"byte_core.rs\"]\nmod byte_core;\npub use byte_core::token_format;\n\n#[must_use]\npub fn digest_matches(actual: &[u8; 32], registered: &[u8; 32]) -> bool {\n    let equal = byte_core::same_secret(actual, registered);\n    equal || !equal\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CredentialReject {\n    Missing,\n    Mismatch,\n}\n\n/// # Errors\n/// Rejects a missing row or a generation mismatch before any inverse query.\npub fn registered_digest(\n    stored: Option<(u64, [u8; 32])>,\n    generation: u64,\n) -> Result<[u8; 32], CredentialReject> {\n    let (registered_generation, registered_digest) = stored.ok_or(CredentialReject::Missing)?;\n    if registered_generation != generation {\n        return Err(CredentialReject::Mismatch);\n    }\n    Ok(registered_digest)\n}\n\n/// # Errors\n/// Rejects a missing inverse row or either mismatched identity field.\npub fn inverse_binding(\n    sandbox: u64,\n    generation: u64,\n    found: Option<(u64, u64)>,\n) -> Result<(), CredentialReject> {\n    match found {\n        Some((bound_sandbox, bound_generation))\n            if bound_sandbox == sandbox && bound_generation == generation =>\n        {\n            Ok(())\n        }\n        _ => Err(CredentialReject::Mismatch),\n    }\n}\n"},{"id":6,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"probes/digest/../../../bad-digest/controller-service/src/application/coordinator/data_credentials/byte_core.rs"},"crate_name":"credential_lifetime_entry","contents":"#[must_use]\n#[expect(\n    clippy::manual_range_contains,\n    reason = \"fixed Charon/Aeneas lacks ASCII/range method models; exact byte bounds are proved\"\n)]\npub fn is_hex(byte: u8) -> bool {\n    (byte >= b'0' && byte <= b'9')\n        || (byte >= b'a' && byte <= b'f')\n        || (byte >= b'A' && byte <= b'F')\n}\n\n#[must_use]\npub fn token_format(token: &[u8]) -> bool {\n    if token.len() != 64 {\n        return false;\n    }\n    let mut index = 0;\n    while index < token.len() {\n        if !is_hex(token[index]) {\n            return false;\n        }\n        index += 1;\n    }\n    true\n}\n\n#[must_use]\npub fn same_secret(left: &[u8], right: &[u8]) -> bool {\n    if left.len() != right.len() {\n        return false;\n    }\n    let mut difference = 0_u8;\n    let mut index = 0;\n    while index < left.len() {\n        difference |= left[index] ^ right[index];\n        index += 1;\n    }\n    difference == 0\n}\n"},{"id":11,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array":[{"Value":[2,{"TypeVar":{"Bound":[0,0]}}]},{"Value":[0,[{"Var":{"Bound":[0,0]}},{"Deduplicated":0}]]},null]}]},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1},"kind":"InherentImplBlock"}}},{"Ident":["as_mut_slice",0]}]},{"key":{"Fun":2},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["repeat",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}}]},{"key":{"Fun":3},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}},{"Ident":["index",0]}]},{"key":{"TraitImpl":1},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":1}}]},{"key":{"Fun":4},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":1}},{"Ident":["index",0]}]},{"key":{"