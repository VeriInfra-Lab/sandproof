,"trait_refs":[]},"builtin":null}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":32},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":24},{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":2,"item_meta":{"name":[{"Ident":["sandproof_internal",0]},{"Ident":["tls",0]},{"Ident":["ClientTls",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":106,"col":0},"end":{"line":109,"col":1}},"generated_from_span":null}},"source_text":"pub struct ClientTls {\n    pub(crate) config: Arc<ClientConfig>,\n    peer_pins: Vec<CertificatePin>,\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":107,"col":4},"end":{"line":107,"col":40}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"config","is_positional":false,"ty":{"Value":[11,{"Adt":{"id":4,"generics":{"regions":[],"types":[{"Value":[12,{"Adt":{"id":13,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},{"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":108,"col":4},"end":{"line":108,"col":34}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"peer_pins","is_positional":false,"ty":{"Deduplicated":10}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":32},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":24},{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["Range",0]}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":82,"col":0},"end":{"line":82,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A (half-open) range bounded inclusively below and exclusively above"},{"DocComment":" (`start..end`)."},{"DocComment":""},{"DocComment":" The range `start..end` contains all values with `start <= x < end`."},{"DocComment":" It is empty if `start >= end`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..end` syntax is a `Range`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((3..5), std::ops::Range { start: 3, end: 5 });"},{"DocComment":" assert_eq!(3 + 4 + 5, (3..6).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]); // This is a `Range`"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Range","diagnostic_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Idx","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":85,"col":4},"end":{"line":85,"col":18}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The lower bound of the range (inclusive)."}],"inline":null,"rename":null,"public":true},"name":"start","is_positional":false,"ty":{"Value":[13,{"TypeVar":{"Free":0}}]}},{"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":88,"col":4},"end":{"line":88,"col":16}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (exclusive)."}],"inline":null,"rename":null,"public":true},"name":"end","is_positional":false,"ty":{"Deduplicated":13}}]},"layout":[],"ptr_metadata":"None"},{"def_id":4,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["sync",0]},{"Ident":["Arc",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":274,"col":0},"end":{"line":277,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A thread-safe reference-counting pointer. 'Arc' stands for 'Atomically"},{"DocComment":" Reference Counted'."},{"DocComment":""},{"DocComment":" The type `Arc<T>` provides shared ownership of a value of type `T`,"},{"DocComment":" allocated in the heap. Invoking [`clone`][clone] on `Arc` produces"},{"DocComment":" a new `Arc` instance, which points to the same allocation on the heap as the"},{"DocComment":" source `Arc`, while increasing a reference count. When the last `Arc`"},{"DocComment":" pointer to a given allocation is destroyed, the value stored in that allocation (often"},{"DocComment":" referred to as \"inner value\") is also dropped."},{"DocComment":""},{"DocComment":" Shared references in Rust disallow mutation by default, and `Arc` is no"},{"DocComment":" exception: you cannot generally obtain a mutable reference to something"},{"DocComment":" inside an `Arc`. If you do need to mutate through an `Arc`, you have several options:"},{"DocComment":""},{"DocComment":" 1. Use interior mutability with synchronization primitives like [`Mutex`][mutex],"},{"DocComment":"    [`RwLock`][rwlock], or one of the [`Atomic`][atomic] types."},{"DocComment":""},{"DocComment":" 2. Use clone-on-write semantics with [`Arc::make_mut`] which provides efficient mutation"},{"DocComment":"    without requiring interior mutability. This approach clones the data only when"},{"DocComment":"    needed (when there are multiple references) and can be more efficient when mutations"},{"DocComment":"    are infrequent."},{"DocComment":""},{"DocComment":" 3. Use [`Arc::get_mut`] when you know your `Arc` is not shared (has a reference count of 1),"},{"DocComment":"    which provides direct mutable access to the inner value without any cloning."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let mut data = Arc::new(vec![1, 2, 3]);"},{"DocComment":""},{"DocComment":" // This will clone the vector only if there are other references to it"},{"DocComment":" Arc::make_mut(&mut data).push(4);"},{"DocComment":""},{"DocComment":" assert_eq!(*data, vec![1, 2, 3, 4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" **Note**: This type is only available on platforms that support atomic"},{"DocComment":" loads and stores of pointers, which includes all platforms that support"},{"DocComment":" the `std` crate but not all those which only support [`alloc`](crate)."},{"DocComment":" This may be detected at compile time using `#[cfg(target_has_atomic = \"ptr\")]`."},{"DocComment":""},{"DocComment":" ## Thread Safety"},{"DocComment":""},{"DocComment":" Unlike [`Rc<T>`], `Arc<T>` uses atomic operations for its reference"},{"DocComment":" counting. This means that it is thread-safe. The disadvantage is that"},{"DocComment":" atomic operations are more expensive than ordinary memory accesses. If you"},{"DocComment":" are not sharing reference-counted allocations between threads, consider using"},{"DocComment":" [`Rc<T>`] for lower overhead. [`Rc<T>`] is a safe default, because the"},{"DocComment":" compiler will catch any attempt to send an [`Rc<T>`] between threads."},{"DocComment":" However, a library might choose `Arc<T>` in order to give library consumers"},{"DocComment":" more flexibility."},{"DocComment":""},{"DocComment":" `Arc<T>` will implement [`Send`] and [`Sync`] as long as the `T` implements"},{"DocComment":" [`Send`] and [`Sync`]. Why can't you put a non-thread-safe type `T` in an"},{"DocComment":" `Arc<T>` to make it thread-safe? This may be a bit counter-intuitive at"},{"DocComment":" first: after all, isn't the point of `Arc<T>` thread safety? The key is"},{"DocComment":" this: `Arc<T>` makes it thread safe to have multiple ownership of the same"},{"DocComment":" data, but it  doesn't add thread safety to its data. Consider"},{"DocComment":" <code>Arc<[RefCell\\<T>]></code>. [`RefCell<T>`] isn't [`Sync`], and if `Arc<T>` was always"},{"DocComment":" [`Send`], <code>Arc<[RefCell\\<T>]></code> would be as well. But then we'd have a problem:"},{"DocComment":" [`RefCell<T>`] is not thread safe; it keeps track of the borrowing count using"},{"DocComment":" non-atomic operations."},{"DocComment":""},{"DocComment":" In the end, this means that you may need to pair `Arc<T>` with some sort of"},{"DocComment":" [`std::sync`] type, usually [`Mutex<T>`][mutex]."},{"DocComment":""},{"DocComment":" ## Breaking cycles with `Weak`"},{"DocComment":""},{"DocComment":" The [`downgrade`][downgrade] method can be used to create a non-owning"},{"DocComment":" [`Weak`] pointer. A [`Weak`] pointer can be [`upgrade`][upgrade]d"},{"DocComment":" to an `Arc`, but this will return [`None`] if the value stored in the allocation has"},{"DocComment":" already been dropped. In other words, `Weak` pointers do not keep the value"},{"DocComment":" inside the allocation alive; however, they *do* keep the allocation"},{"DocComment":" (the backing store for the value) alive."},{"DocComment":""},{"DocComment":" A cycle between `Arc` pointers will never be deallocated. For this reason,"},{"DocComment":" [`Weak`] is used to break cycles. For example, a tree could have"},{"DocComment":" strong `Arc` pointers from parent nodes to children, and [`Weak`]"},{"DocComment":" pointers from children back to their parents."},{"DocComment":""},{"DocComment":" # Cloning references"},{"DocComment":""},{"DocComment":" Creating a new reference from an existing reference-counted pointer is done using the"},{"DocComment":" `Clone` trait implemented for [`Arc<T>`][Arc] and [`Weak<T>`][Weak]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" let foo = Arc::new(vec![1.0, 2.0, 3.0]);"},{"DocComment":" // The two syntaxes below are equivalent."},{"DocComment":" let a = foo.clone();"},{"DocComment":" let b = Arc::clone(&foo);"},{"DocComment":" // a, b, and foo are all Arcs that point to the same memory location"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Deref` behavior"},{"DocComment":""},{"DocComment":" `Arc<T>` automatically dereferences to `T` (via the [`Deref`] trait),"},{"DocComment":" so you can call `T`'s methods on a value of type `Arc<T>`. To avoid name"},{"DocComment":" clashes with `T`'s methods, the methods of `Arc<T>` itself are associated"},{"DocComment":" functions, called using [fully qualified syntax]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let my_arc = Arc::new(());"},{"DocComment":" let my_weak = Arc::downgrade(&my_arc);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Arc<T>`'s implementations of traits like `Clone` may also be called using"},{"DocComment":" fully qualified syntax. Some people prefer to use fully qualified syntax,"},{"DocComment":" while others prefer using method-call syntax."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let arc = Arc::new(());"},{"DocComment":" // Method-call syntax"},{"DocComment":" let arc2 = arc.clone();"},{"DocComment":" // Fully qualified syntax"},{"DocComment":" let arc3 = Arc::clone(&arc);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Weak<T>`][Weak] does not auto-dereference to `T`, because the inner value may have"},{"DocComment":" already been dropped."},{"DocComment":""},{"DocComment":" [`Rc<T>`]: crate::rc::Rc"},{"DocComment":" [clone]: Clone::clone"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [atomic]: core::sync::atomic"},{"DocComment":" [downgrade]: Arc::downgrade"},{"DocComment":" [upgrade]: Weak::upgrade"},{"DocComment":" [RefCell\\<T>]: core::cell::RefCell"},{"DocComment":" [`RefCell<T>`]: core::cell::RefCell"},{"DocComment":" [`std::sync`]: ../../std/sync/index.html"},{"DocComment":" [`Arc::clone(&from)`]: Arc::clone"},{"DocComment":" [fully qualified syntax]: https://doc.rust-lang.org/book/ch19-03-advanced-traits.html#fully-qualified-syntax-for-disambiguation-calling-methods-with-the-same-name"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Sharing some immutable data between threads:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let five = Arc::new(5);"},{"DocComment":""},{"DocComment":" for _ in 0..10 {"},{"DocComment":"     let five = Arc::clone(&five);"},{"DocComment":""},{"DocComment":"     thread::spawn(move || {"},{"DocComment":"         println!(\"{five:?}\");"},{"DocComment":"     });"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Sharing a mutable [`AtomicUsize`]:"},{"DocComment":""},{"DocComment":" [`AtomicUsize`]: core::sync::atomic::AtomicUsize \"sync::atomic::AtomicUsize\""},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" use std::sync::atomic::{AtomicUsize, Ordering};"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let val = Arc::new(AtomicUsize::new(5));"},{"DocComment":""},{"DocComment":" for _ in 0..10 {"},{"DocComment":"     let val = Arc::clone(&val);"},{"DocComment":""},{"DocComment":"     thread::spawn(move || {"},{"DocComment":"         let v = val.fetch_add(1, Ordering::Relaxed);"},{"DocComment":"         println!(\"{v:?}\");"},{"DocComment":"     });"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" See the [`rc` documentation][rc_examples] for more examples of reference"},{"DocComment":" counting in general."},{"DocComment":""},{"DocComment":" [rc_examples]: crate::rc#examples"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Arc"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":5,"item_meta":{"name":[{"Ident":["rustls",0]},{"Ident":["server",0]},{"Ident":["server_conn",0]},{"Ident":["ServerConfig",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":297,"col":0},"end":{"line":297,"col":23}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Common configuration for a set of server sessions."},{"DocComment":""},{"DocComment":" Making one of these is cheap, though one of the inputs may be expensive: gathering trust roots"},{"DocComment":" from the operating system to add to the [`RootCertStore`] passed to a `ClientCertVerifier`"},{"DocComment":" builder may take on the order of a few hundred milliseconds."},{"DocComment":""},{"DocComment":" These must be created via the [`ServerConfig::builder()`] or [`ServerConfig::builder_with_provider()`]"},{"DocComment":" function."},{"DocComment":""},{"DocComment":" # Defaults"},{"DocComment":""},{"DocComment":" * [`ServerConfig::max_fragment_size`]: the default is `None` (meaning 16kB)."},{"DocComment":" * [`ServerConfig::session_storage`]: if the `std` feature is enabled, the default stores 256"},{"DocComment":"   sessions in memory. If the `std` feature is not enabled, the default is to not store any"},{"DocComment":"   sessions. In a no-std context, by enabling the `hashbrown` feature you may provide your"},{"DocComment":"   own `session_storage` using [`ServerSessionMemoryCache`] and a `crate::lock::MakeMutex`"},{"DocComment":"   implementation."},{"DocComment":" * [`ServerConfig::alpn_protocols`]: the default is empty -- no ALPN protocol is negotiated."},{"DocComment":" * [`ServerConfig::key_log`]: key material is not logged."},{"DocComment":" * [`ServerConfig::send_tls13_tickets`]: 2 tickets are sent."},{"DocComment":" * [`ServerConfig::cert_compressors`]: depends on the crate features, see [`compress::default_cert_compressors()`]."},{"DocComment":" * [`ServerConfig::cert_compression_cache`]: caches the most recently used 4 compressions"},{"DocComment":" * [`ServerConfig::cert_decompressors`]: depends on the crate features, see [`compress::default_cert_decompressors()`]."},{"DocComment":""},{"DocComment":" # Sharing resumption storage between `ServerConfig`s"},{"DocComment":""},{"DocComment":" In a program using many `ServerConfig`s it may improve resumption rates"},{"DocComment":" (which has a significant impact on connection performance) if those"},{"DocComment":" configs share [`ServerConfig::session_storage`] or [`ServerConfig::ticketer`]."},{"DocComment":""},{"DocComment":" However, caution is needed: other fields influence the security of a session"},{"DocComment":" and resumption between them can be surprising.  If sharing"},{"DocComment":" [`ServerConfig::session_storage`] or [`ServerConfig::ticketer`] between two"},{"DocComment":" `ServerConfig`s, you should also evaluate the following fields and ensure"},{"DocComment":" they are equivalent:"},{"DocComment":""},{"DocComment":" * `ServerConfig::verifier` -- client authentication requirements,"},{"DocComment":" * [`ServerConfig::cert_resolver`] -- server identities."},{"DocComment":""},{"DocComment":" To illustrate, imagine two `ServerConfig`s `A` and `B`.  `A` requires"},{"DocComment":" client authentication, `B` does not.  If `A` and `B` shared a resumption store,"},{"DocComment":" it would be possible for a session originated by `B` (that is, an unauthenticated client)"},{"DocComment":" to be inserted into the store, and then resumed by `A`.  This would give a false"},{"DocComment":" impression to the user of `A` that the client was authenticated.  This is possible"},{"DocComment":" whether the resumption is performed statefully (via [`ServerConfig::session_storage`])"},{"DocComment":" or statelessly (via [`ServerConfig::ticketer`])."},{"DocComment":""},{"DocComment":" _Unlike_ `ClientConfig`, rustls does not enforce any policy here."},{"DocComment":""},{"DocComment":" [`RootCertStore`]: crate::RootCertStore"},{"DocComment":" [`ServerSessionMemoryCache`]: crate::server::handy::ServerSessionMemoryCache"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":232},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":88},{"guarantee":null,"chosen":228},{"guarantee":null,"chosen":0},{"guarantee":null,"chosen":96},{"guarantee":null,"chosen":112},{"guarantee":null,"chosen":128},{"guarantee":null,"chosen":16},{"guarantee":null,"chosen":200},{"guarantee":null,"chosen":144},{"guarantee":null,"chosen":160},{"guarantee":null,"chosen":229},{"guarantee":null,"chosen":224},{"guarantee":null,"chosen":230},{"guarantee":null,"chosen":208},{"guarantee":null,"chosen":216},{"guarantee":null,"chosen":176},{"guarantee":null,"chosen":40},{"guarantee":null,"chosen":192},{"guarantee":null,"chosen":64}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":6,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Ident":["Global",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":59,"col":0},"end":{"line":59,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The global memory allocator."},{"DocComment":""},{"DocComment":" This type implements the [`Allocator`] trait by forwarding calls"},{"DocComment":" to the allocator registered with the `#[global_allocator]` attribute"},{"DocComment":" if there is one, or the `std` crate’s default."},{"DocComment":""},{"DocComment":" Note: while this type is unstable, the functionality it provides can be"},{"DocComment":" accessed through the [free functions in `alloc`](self#functions)."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"GlobalAlloc","diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":0},"align":{"guarantee":null,"chosen":1},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":7,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["Vec",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":436,"col":0},"end":{"line":436,"col":96}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A contiguous growable array type, written as `Vec<T>`, short for 'vector'."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec = Vec::new();"},{"DocComment":" vec.push(1);"},{"DocComment":" vec.push(2);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.len(), 2);"},{"DocComment":" assert_eq!(vec[0], 1);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.pop(), Some(2));"},{"DocComment":" assert_eq!(vec.len(), 1);"},{"DocComment":""},{"DocComment":" vec[0] = 7;"},{"DocComment":" assert_eq!(vec[0], 7);"},{"DocComment":""},{"DocComment":" vec.extend([1, 2, 3]);"},{"DocComment":""},{"DocComment":" for x in &vec {"},{"DocComment":"     println!(\"{x}\");"},{"DocComment":" }"},{"DocComment":" assert_eq!(vec, [7, 1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The [`vec!`] macro is provided for convenient initialization:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec1 = vec![1, 2, 3];"},{"DocComment":" vec1.push(4);"},{"DocComment":" let vec2 = Vec::from([1, 2, 3, 4]);"},{"DocComment":" assert_eq!(vec1, vec2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It can also initialize each element of a `Vec<T>` with a given value."},{"DocComment":" This may be more efficient than performing allocation and initialization"},{"DocComment":" in separate steps, especially when initializing a vector of zeros:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let vec = vec![0; 5];"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":""},{"DocComment":" // The following is equivalent, but potentially slower:"},{"DocComment":" let mut vec = Vec::with_capacity(5);"},{"DocComment":" vec.resize(5, 0);"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For more information, see"},{"DocComment":" [Capacity and Reallocation](#capacity-and-reallocation)."},{"DocComment":""},{"DocComment":" Use a `Vec<T>` as an efficient stack:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut stack = Vec::new();"},{"DocComment":""},{"DocComment":" stack.push(1);"},{"DocComment":" stack.push(2);"},{"DocComment":" stack.push(3);"},{"DocComment":""},{"DocComment":" while let Some(top) = stack.pop() {"},{"DocComment":"     // Prints 3, 2, 1"},{"DocComment":"     println!(\"{top}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Indexing"},{"DocComment":""},{"DocComment":" The `Vec` type allows access to values by index, because it implements the"},{"DocComment":" [`Index`] trait. An example will be more explicit:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[1]); // it will display '2'"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However be careful: if you try to access an index which isn't in the `Vec`,"},{"DocComment":" your software will panic! You cannot do this:"},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[6]); // it will panic!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use [`get`] and [`get_mut`] if you want to check whether the index is in"},{"DocComment":" the `Vec`."},{"DocComment":""},{"DocComment":" # Slicing"},{"DocComment":""},{"DocComment":" A `Vec` can be mutable. On the other hand, slices are read-only objects."},{"DocComment":" To get a [slice][prim@slice], use [`&`]. Example:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn read_slice(slice: &[usize]) {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let v = vec![0, 1];"},{"DocComment":" read_slice(&v);"},{"DocComment":""},{"DocComment":" // ... and that's all!"},{"DocComment":" // you can also do it like this:"},{"DocComment":" let u: &[usize] = &v;"},{"DocComment":" // or like this:"},{"DocComment":" let u: &[_] = &v;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In Rust, it's more common to pass slices as arguments rather than vectors"},{"DocComment":" when you just want to provide read access. The same goes for [`String`] and"},{"DocComment":" [`&str`]."},{"DocComment":""},{"DocComment":" # Capacity and reallocation"},{"DocComment":""},{"DocComment":" The capacity of a vector is the amount of space allocated for any future"},{"DocComment":" elements that will be added onto the vector. This is not to be confused with"},{"DocComment":" the *length* of a vector, which specifies the number of actual elements"},{"DocComment":" within the vector. If a vector's length exceeds its capacity, its capacity"},{"DocComment":" will automatically be increased, but its elements will have to be"},{"DocComment":" reallocated."},{"DocComment":""},{"DocComment":" For example, a vector with capacity 10 and length 0 would be an empty vector"},{"DocComment":" with space for 10 more elements. Pushing 10 or fewer elements onto the"},{"DocComment":" vector will not change its capacity or cause reallocation to occur. However,"},{"DocComment":" if the vector's length is increased to 11, it will have to reallocate, which"},{"DocComment":" can be slow. For this reason, it is recommended to use [`Vec::with_capacity`]"},{"DocComment":" whenever possible to specify how big the vector is expected to get."},{"DocComment":""},{"DocComment":" # Guarantees"},{"DocComment":""},{"DocComment":" Due to its incredibly fundamental nature, `Vec` makes a lot of guarantees"},{"DocComment":" about its design. This ensures that it's as low-overhead as possible in"},{"DocComment":" the general case, and can be correctly manipulated in primitive ways"},{"DocComment":" by unsafe code. Note that these guarantees refer to an unqualified `Vec<T>`."},{"DocComment":" If additional type parameters are added (e.g., to support custom allocators),"},{"DocComment":" overriding their defaults may change the behavior."},{"DocComment":""},{"DocComment":" Most fundamentally, `Vec` is and always will be a (pointer, capacity, length)"},{"DocComment":" triplet. No more, no less. The order of these fields is completely"},{"DocComment":" unspecified, and you should use the appropriate methods to modify these."},{"DocComment":" The pointer will never be null, so this type is null-pointer-optimized."},{"DocComment":""},{"DocComment":" However, the pointer might not actually point to allocated memory. In particular,"},{"DocComment":" if you construct a `Vec` with capacity 0 via [`Vec::new`], [`vec![]`][`vec!`],"},{"DocComment":" [`Vec::with_capacity(0)`][`Vec::with_capacity`], or by calling [`shrink_to_fit`]"},{"DocComment":" on an empty Vec, it will not allocate memory. Similarly, if you store zero-sized"},{"DocComment":" types inside a `Vec`, it will not allocate space for them. *Note that in this case"},{"DocComment":" the `Vec` might not report a [`capacity`] of 0*. `Vec` will allocate if and only"},{"DocComment":" if <code>[size_of::\\<T>]\\() * [capacity]\\() > 0</code>. In general, `Vec`'s allocation"},{"DocComment":" details are very subtle --- if you intend to allocate memory using a `Vec`"},{"DocComment":" and use it for something else (either to pass to unsafe code, or to build your"},{"DocComment":" own memory-backed collection), be sure to deallocate this memory by using"},{"DocComment":" `from_raw_parts` to recover the `Vec` and then dropping it."},{"DocComment":""},{"DocComment":" If a `Vec` *has* allocated memory, then the memory it points to is on the heap"},{"DocComment":" (as defined by the allocator Rust is configured to use by default), and its"},{"DocComment":" pointer points to [`len`] initialized, contiguous elements in order (what"},{"DocComment":" you would see if you coerced it to a slice), followed by <code>[capacity] - [len]</code>"},{"DocComment":" logically uninitialized, contiguous elements."},{"DocComment":""},{"DocComment":" A vector containing the elements `'a'` and `'b'` with capacity 4 can be"},{"DocComment":" visualized as below. The top part is the `Vec` struct, it contains a"},{"DocComment":" pointer to the head of the allocation in the heap, length and capacity."},{"DocComment":" The bottom part is the allocation on the heap, a contiguous memory block."},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":"             ptr      len  capacity"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"        | 0x0123 |      2 |      4 |"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"             |"},{"DocComment":"             v"},{"DocComment":" Heap   +--------+--------+--------+--------+"},{"DocComment":"        |    'a' |    'b' | uninit | uninit |"},{"DocComment":"        +--------+--------+--------+--------+"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" - **uninit** represents memory that is not initialized, see [`MaybeUninit`]."},{"DocComment":" - Note: the ABI is not stable and `Vec` makes no guarantees about its memory"},{"DocComment":"   layout (including the order of fields)."},{"DocComment":""},{"DocComment":" `Vec` will never perform a \"small optimization\" where elements are actually"},{"DocComment":" stored on the stack for two reasons:"},{"DocComment":""},{"DocComment":" * It would make it more difficult for unsafe code to correctly manipulate"},{"DocComment":"   a `Vec`. The contents of a `Vec` wouldn't have a stable address if it were"},{"DocComment":"   only moved, and it would be more difficult to determine if a `Vec` had"},{"DocComment":"   actually allocated memory."},{"DocComment":""},{"DocComment":" * It would penalize the general case, incurring an additional branch"},{"DocComment":"   on every access."},{"DocComment":""},{"DocComment":" `Vec` will never automatically shrink itself, even if completely empty. This"},{"DocComment":" ensures no unnecessary allocations or deallocations occur. Emptying a `Vec`"},{"DocComment":" and then filling it back up to the same [`len`] should incur no calls to"},{"DocComment":" the allocator. If you wish to free up unused memory, use"},{"DocComment":" [`shrink_to_fit`] or [`shrink_to`]."},{"DocComment":""},{"DocComment":" [`push`] and [`insert`] will never (re)allocate if the reported capacity is"},{"DocComment":" sufficient. [`push`] and [`insert`] *will* (re)allocate if"},{"DocComment":" <code>[len] == [capacity]</code>. That is, the reported capacity is completely"},{"DocComment":" accurate, and can be relied on. It can even be used to manually free the memory"},{"DocComment":" allocated by a `Vec` if desired. Bulk insertion methods *may* reallocate, even"},{"DocComment":" when not necessary."},{"DocComment":""},{"DocComment":" `Vec` does not guarantee any particular growth strategy when reallocating"},{"DocComment":" when full, nor when [`reserve`] is called. The current strategy is basic"},{"DocComment":" and it may prove desirable to use a non-constant growth factor. Whatever"},{"DocComment":" strategy is used will of course guarantee *O*(1) amortized [`push`]."},{"DocComment":""},{"DocComment":" It is guaranteed, in order to respect the intentions of the programmer, that"},{"DocComment":" all of `vec![e_1, e_2, ..., e_n]`, `vec![x; n]`, and [`Vec::with_capacity(n)`] produce a `Vec`"},{"DocComment":" that requests an allocation of the exact size needed for precisely `n` elements from the allocator,"},{"DocComment":" and no other size (such as, for example: a size rounded up to the nearest power of 2)."},{"DocComment":" The allocator will return an allocation that is at least as large as requested, but it may be larger."},{"DocComment":""},{"DocComment":" It is guaranteed that the [`Vec::capacity`] method returns a value that is at least the requested capacity"},{"DocComment":" and not more than the allocated capacity."},{"DocComment":""},{"DocComment":" The method [`Vec::shrink_to_fit`] will attempt to discard excess capacity an allocator has given to a `Vec`."},{"DocComment":" If <code>[len] == [capacity]</code>, then a `Vec<T>` can be converted"},{"DocComment":" to and from a [`Box<[T]>`][owned slice] without reallocating or moving the elements."},{"DocComment":" `Vec` exploits this fact as much as reasonable when implementing common conversions"},{"DocComment":" such as [`into_boxed_slice`]."},{"DocComment":""},{"DocComment":" `Vec` will not specifically overwrite any data that is removed from it,"},{"DocComment":" but also won't specifically preserve it. Its uninitialized memory is"},{"DocComment":" scratch space that it may use however it wants. It will generally just do"},{"DocComment":" whatever is most efficient or otherwise easy to implement. Do not rely on"},{"DocComment":" removed data to be erased for security purposes. Even if you drop a `Vec`, its"},{"DocComment":" buffer may simply be reused by another allocation. Even if you zero a `Vec`'s memory"},{"DocComment":" first, that might not actually happen because the optimizer does not consider"},{"DocComment":" this a side-effect that must be preserved. There is one case which we will"},{"DocComment":" not break, however: using `unsafe` code to write to the excess capacity,"},{"DocComment":" and then increasing the length to match, is always valid."},{"DocComment":""},{"DocComment":" Currently, `Vec` does not guarantee the order in which elements are dropped."},{"DocComment":" The order has changed in the past and may change again."},{"DocComment":""},{"DocComment":" [`get`]: slice::get"},{"DocComment":" [`get_mut`]: slice::get_mut"},{"DocComment":" [`String`]: crate::string::String"},{"DocComment":" [`&str`]: type@str"},{"DocComment":" [`shrink_to_fit`]: Vec::shrink_to_fit"},{"DocComment":" [`shrink_to`]: Vec::shrink_to"},{"DocComment":" [capacity]: Vec::capacity"},{"DocComment":" [`capacity`]: Vec::capacity"},{"DocComment":" [`Vec::capacity`]: Vec::capacity"},{"DocComment":" [size_of::\\<T>]: size_of"},{"DocComment":" [len]: Vec::len"},{"DocComment":" [`len`]: Vec::len"},{"DocComment":" [`push`]: Vec::push"},{"DocComment":" [`insert`]: Vec::insert"},{"DocComment":" [`reserve`]: Vec::reserve"},{"DocComment":" [`Vec::with_capacity(n)`]: Vec::with_capacity"},{"DocComment":" [`MaybeUninit`]: core::mem::MaybeUninit"},{"DocComment":" [owned slice]: Box"},{"DocComment":" [`into_boxed_slice`]: Vec::into_boxed_slice"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Vec"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":8,"item_meta":{"name":[{"Ident":["sandproof_internal",0]},{"Ident":["tls",0]},{"Ident":["CertificatePin",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":12,"col":0},"end":{"line":12,"col":36}},"generated_from_span":null}},"source_text":"pub struct CertificatePin([u8; 32]);","attr_info":{"attributes":[{"DocComment":" Public certificate digest, registered out of band for an exact service role."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":12,"col":26},"end":{"line":12,"col":34}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"_0","is_positional":true,"ty":{"Value":[14,{"Array":[{"Value":[15,{"Scalar":{"Integer":{"Unsigned":"U8"}}}]},{"Value":[1,[{"Integer":{"Unsigned":["Usize","32"]}},{"Deduplicated":0}]]},null]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"guarantee":null,"chosen":32},"align":{"guarantee":null,"chosen":1},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":598,"col":0},"end":{"line":598,"col":18}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `Option` type. See [the module level documentation](self) for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Option","diagnostic_item":"Option"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":602,"col":4},"end":{"line":602,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" No value."}],"inline":null,"rename":null,"public":true},"name":"None","fields":[],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":606,"col":4},"end":{"line":606,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Some value of type `T`."}],"inline":null,"rename":null,"public":true},"name":"Some","fields":[{"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":606,"col":55},"end":{"line":606,"col":56}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Deduplicated":13}}],"discriminant":{"Signed":["Isize","1"]}}]},"layout":[],"ptr_metadata":"None"},{"def_id":10,"item_meta":{"name":[{"Ident":["rustls_pki_types",0]},{"Ident":["CertificateDer",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":676,"col":0},"end":{"line":676,"col":29}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A DER-encoded X.509 certificate; as specified in RFC 5280"},{"DocComment":""},{"DocComment":" Certificates are identified in PEM context as `CERTIFICATE` and when stored in a"},{"DocComment":" file usually use a `.pem`, `.cer` or `.crt` extension. For more on PEM files, refer to the"},{"DocComment":" crate documentation."},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # #[cfg(all(feature = \"alloc\", feature = \"std\"))] {"},{"DocComment":" use rustls_pki_types::{CertificateDer, pem::PemObject};"},{"DocComment":""},{"DocComment":" // load several from a PEM file"},{"DocComment":" let certs: Vec<_> = CertificateDer::pem_file_iter(\"tests/data/certificate.chain.pem\")"},{"DocComment":"     .unwrap()"},{"DocComment":"     .collect();"},{"DocComment":" assert_eq!(certs.len(), 3);"},{"DocComment":""},{"DocComment":" // or one from a PEM byte slice..."},{"DocComment":" # let byte_slice = include_bytes!(\"../tests/data/certificate.chain.pem\");"},{"DocComment":" CertificateDer::from_pem_slice(byte_slice).unwrap();"},{"DocComment":""},{"DocComment":" // or several from a PEM byte slice"},{"DocComment":" let certs: Vec<_> = CertificateDer::pem_slice_iter(byte_slice)"},{"DocComment":"     .collect();"},{"DocComment":" assert_eq!(certs.len(), 3);"},{"DocComment":" # }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":"'a","variance":"Covariant","mutability":"Shared"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"sr