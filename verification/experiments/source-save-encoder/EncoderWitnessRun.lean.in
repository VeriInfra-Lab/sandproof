import EncoderWitness

open Aeneas Aeneas.Std SandproofSaveRetentionRows alloc.vec
open controller.lifecycle_inbox.source_work.codec
set_option autoImplicit false

namespace SandboxModel.Stage1Protocol.SaveEncoder.Witness

private theorem push_example (key : EncoderKey) :
    (Vec.new Encoded).push (key, recordBytes) = .ok (rows key) := by
  unfold Vec.push
  have fits : 1 ≤ U32.max := by scalar_tac
  simp [fits, rows]

theorem actual_encoder_returns_example :
    encodeCandidate ports sources = .ok (.Ok ([keyOf row], rows OUTPUT_KEY)) := by
  let start : Iter := ⟨sources.records.slice, 0⟩
  let finish : Iter := ⟨sources.records.slice, 1⟩
  have first : encodeStep ports 258048#u64 start [] (Vec.new Encoded) =
      .ok (.cont (finish, [keyOf row], rows OUTPUT_KEY)) := by
    have inside : start.i < start.slice.val.length := by decide
    have next : core.slice.iter.IteratorSliceIter.next start = .ok (some row, finish) := by
      simp only [core.slice.iter.IteratorSliceIter.next, Slice.len_val, inside, ↓reduceDIte]
      rfl
    simp only [encodeStep, encode_candidate_records_loop.body, next, bind_tc_ok,
      sandproof_protocol.lifecycle.digest.ContentDigest.as_bytes]
    simp [ports, has, keyOf, row, SourceWorkMatch.Values.changedKey, core.cmp.PartialEq.ne.trait_default,
      core.cmp.PartialEq.ne.default, SourcePreservation.digest_eq, lift, push_example, finish]
    simp [recordBytes]
  have stop : encodeStep ports 258048#u64 finish [keyOf row] (rows OUTPUT_KEY) =
      .ok (.done (.Ok ([keyOf row], rows OUTPUT_KEY))) := by
    have outside : ¬ finish.i < finish.slice.val.length := by decide
    simp only [encodeStep, encode_candidate_records_loop.body, core.slice.iter.IteratorSliceIter.next,
      Slice.len_val, outside, ↓reduceDIte, bind_tc_ok]
    rfl
  unfold encodeCandidate encode_candidate_records
  rw [reserve]
  simp only [ports, boxedIter, bind_tc_ok, encode_candidate_records_loop]
  let step (state : Iter × List EncoderKey × EncoderRows) :=
    encodeStep ports 258048#u64 state.1 state.2.1 state.2.2
  change loop step (start, [], Vec.new Encoded) = _
  rw [loop, show step (start, [], Vec.new Encoded) = _ from first]
  simp only [Aeneas.Std.bind_ok]
  rw [loop, show step (finish, [keyOf row], rows OUTPUT_KEY) = _ from stop]
  simp only [Aeneas.Std.bind_ok]

end SandboxModel.Stage1Protocol.SaveEncoder.Witness

#audit_controller_proof SandboxModel.Stage1Protocol.SaveEncoder.Witness.actual_encoder_returns_example
