+//! Synchronous decisions used by the original one-shot byte relay.
+//! A successful relay result is not a complete HTTP or subprocess receipt.
+pub(super) enum First<E> {
+    Upload(Result<(), E>),
+    Download(Result<(), E>),
+}
+
+pub(super) enum Action<E> {
+    AwaitDownload(Result<(), E>),
+    Finish(Result<(), E>),
+}
+
+pub(super) fn decide<E>(first: First<E>) -> Action<E> {
+    match first {
+        First::Upload(result) => Action::AwaitDownload(result),
+        First::Download(result) => Action::Finish(result),
+    }
+}
+
+pub(super) fn finish_upload<E>(upload: Result<(), E>, download: Result<(), E>) -> Result<(), E> {
+    download?;
+    upload
+}
