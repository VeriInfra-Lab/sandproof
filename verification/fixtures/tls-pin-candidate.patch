-        Self(Sha256::digest(certificate.as_ref()).into())
+        certificate_pin_bytes(certificate.as_ref())
     }
 }
 
@@ -95,10 +95,8 @@ impl ServerTls {
         certificates: Option<&[CertificateDer<'_>]>,
     ) -> Result<CertificatePin, TransportError> {
         self.verify_peer(certificates)?;
-        certificates
-            .and_then(|chain| chain.first())
-            .map(CertificatePin::from_certificate)
